{# Native dark palettes opt out of the legacy colour adapter. PDF/email documents
   are intentionally outside this include; Windows forced colours remains enabled. #}
<meta name="color-scheme" content="light dark">
<style>:root { color-scheme: light dark; } @media print { :root { color-scheme: light; } }</style>
{% if color_scheme|default('adaptive') != 'light dark' %}
<link rel="stylesheet" href="{{ asset('dist/css/color-scheme.css') }}?v=20261106">
<script defer src="{{ asset('dist/js/color-scheme.js') }}?v=20261106"></script>
{% endif %}
