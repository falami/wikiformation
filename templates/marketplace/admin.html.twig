{% extends 'marketplace/base.html.twig' %}{% block content %}<section class="mk-hero"><div><span class="mk-kicker">Super administration · I.T For You</span><h1>Le savoir partagé.<br><strong>Les revenus suivis.</strong></h1><p>Pilotez les commissions, les ventes et la diffusion des cours.</p></div><span class="mk-badge">{{ settings.enabled?'Ventes ouvertes':'Ventes désactivées' }}</span></section><p><a class="mk-button" href="{{ path('app_market_admin_studios') }}">Créer et gérer mes propres cours →</a></p><div class="mk-panel" style="margin-bottom:24px"><span class="mk-kicker">Revenus I.T For You</span><h2>{{ ((totals.ownSalesHt + totals.commission)/100)|number_format(2,',',' ') }} €</h2><p>Ventes propres HT : <strong>{{ (totals.ownSalesHt/100)|number_format(2,',',' ') }} €</strong> · Commissions sur les ventes des formateurs : <strong>{{ (totals.commission/100)|number_format(2,',',' ') }} €</strong>.</p><p class="mk-note">Hors litiges, net de remboursements, avant frais Stripe et fiscalité des commissions. Les remboursements partiels sont ventilés au prorata. Les ventes propres sont encaissées directement sur le compte Stripe de la plateforme, sans reversement Connect.</p></div><div class="mk-stats">{% for label,value in {'Ventes TTC encaissées':totals.gross,'Commissions hors litiges, nettes de remboursements':totals.commission,'Reversé aux vendeurs, net de reprises':totals.transferred,'Remboursements':totals.refunds} %}<div class="mk-panel"><span class="mk-note">{{ label }}</span><strong>{{ (value/100)|number_format(2,',',' ') }} €</strong></div>{% endfor %}</div><p class="mk-note">Frais Stripe enregistrés : {{ (totals.fees/100)|number_format(2,',',' ') }} €. Les commissions ne représentent pas un bénéfice net après fiscalité et autres frais de la plateforme.</p><details class="mk-panel"><summary>Configurer la commission et l’ouverture des ventes</summary><form method="post" style="margin-top:24px"><input type="hidden" name="_token" value="{{ csrf_token('market-settings') }}"><div class="mk-field"><label for="commission">Commission I.T For You (% du prix HT)</label><input id="commission" name="commission" value="{{ settings.commissionBps is not null ? settings.commissionBps/100 : '' }}" required inputmode="decimal"></div><div class="mk-field"><label for="fees">Frais Stripe</label><select id="fees" name="fees"><option value="seller" {{ settings.feesPayer=='seller'?'selected':'' }}>Déduits de la part du formateur</option><option value="platform" {{ settings.feesPayer=='platform'?'selected':'' }}>Pris en charge par I.T For You</option></select></div><div class="mk-field"><label for="terms">Conditions de vente et conditions vendeur validées</label><textarea id="terms" name="terms" rows="12">{{ settings.terms }}</textarea></div><div class="mk-field"><label for="privacy">Information sur la protection des données</label><textarea id="privacy" name="privacy" rows="8">{{ settings.privacy }}</textarea></div><div class="mk-check"><input type="checkbox" id="legal" name="legal" value="1" {{ settings.legalApproved?'checked':'' }}><label for="legal">Les conditions, les informations obligatoires, le traitement fiscal et le fonctionnement Stripe ont été validés pour cette activité.</label></div><div class="mk-check"><input type="checkbox" id="enabled" name="enabled" value="1" {{ settings.enabled?'checked':'' }}><label for="enabled">Ouvrir les paiements</label></div><button class="mk-button">Enregistrer les réglages</button></form></details><section class="mk-panel" style="margin-top:28px"><h2>100 dernières commandes</h2><p><a class="mk-button secondary" href="{{ path('app_market_invoices') }}">Journal des factures et avoirs</a></p><div class="mk-scroll"><table class="mk-table"><tr><th>Date</th><th>Vendeur</th><th>Référence</th><th>Total TTC</th><th>Commission</th><th>État</th></tr>{% for sale in sales %}<tr><td>{{ sale.createdAt|date('d/m/Y') }}</td><td>{{ sale.seller.legalName }}{% if sale.platformSale %}<br><span class="mk-badge">Vente directe I.T For You</span>{% endif %}</td><td>{{ sale.id }}</td><td>{{ (sale.totalCents/100)|number_format(2,',',' ') }} €</td><td>{{ (sale.commissionCents/100)|number_format(2,',',' ') }} €</td><td>{{ {'pending':'En attente','paid':'Payé','refunded':'Remboursé en tout ou partie','disputed':'En litige','expired':'Expiré'}[sale.status]|default(sale.status) }}</td></tr>{% else %}<tr><td colspan="6">Aucune vente pour le moment.</td></tr>{% endfor %}</table></div></section><section class="mk-panel" style="margin-top:28px"><h2>Offres au catalogue</h2>{% for offer in offers %}<div class="mk-row"><span>{{ offer.snapshot.title }} · {{ offer.seller.legalName }}</span><form method="post" action="{{ path('app_market_admin_unpublish',{id:offer.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('moderate_'~offer.id) }}"><button class="mk-button secondary">Retirer de la vente</button></form></div>{% else %}<p>Aucune offre publiée.</p>{% endfor %}</section>{% endblock %}
