{% extends 'marketplace/base.html.twig' %}{% block content %}<section class="mk-hero"><div><span class="mk-kicker">Votre parcours</span><h1>{{ access.snapshot.title }}</h1><p>Version conservée le {{ access.snapshot.capturedAt|date('d/m/Y') }} · {{ access.completed|length }} chapitre(s) terminé(s)</p></div></section><div class="mk-two"><div>{% for node in access.snapshot.nodes %}<article class="mk-lesson" id="chapitre-{{ node.id }}"><span class="mk-kicker">Chapitre {{ loop.index }} {{ node.id in access.completed?'· Terminé':'' }}</span><h2>{{ node.title }}</h2>{% for block in node.blocks %}<div style="margin:22px 0">{{ block.html|raw }}{% if block.file %}{% set url=path('app_market_media',{id:access.id,key:block.file.key}) %}{% if block.file.mime starts with 'image/' %}<img src="{{ url }}" alt="Support du cours" loading="lazy">{% elseif block.file.mime starts with 'video/' %}<video controls preload="metadata" src="{{ url }}">Votre navigateur ne prend pas en charge cette vidéo.</video>{% else %}<a class="mk-button secondary" href="{{ url }}" target="_blank" rel="noopener">Consulter {{ block.file.name }}</a>{% endif %}{% elseif block.url %}<a href="{{ block.url }}" target="_blank" rel="noopener noreferrer">Ouvrir la ressource externe (site tiers)</a>{% endif %}{% for question in block.quiz %}<div class="mk-panel"><h3>{{ question.text }}</h3><ul>{% for choice in question.choices %}<li>{{ choice.label }}</li>{% endfor %}</ul><details><summary>Vérifier ma réponse</summary>{% for choice in question.choices %}{% if choice.correct %}<p>{{ choice.label }}</p>{% endif %}{% endfor %}<p>{{ question.expected }} {{ question.explanation }}</p></details></div>{% endfor %}</div>{% endfor %}{% if node.id not in access.completed %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('progress_'~access.id) }}"><input type="hidden" name="node" value="{{ node.id }}"><button class="mk-button">Marquer ce chapitre comme terminé ✓</button></form>{% endif %}</article>{% endfor %}</div><aside class="mk-panel mk-sidebar"><h2>Sommaire</h2>{% for node in access.snapshot.nodes %}<a href="#chapitre-{{ node.id }}">{{ node.id in access.completed?'✓':'○' }} {{ node.title }}</a>{% endfor %}<p class="mk-note">La progression est personnelle. Elle ne constitue pas une certification de réussite.</p></aside></div>{% endblock %}
