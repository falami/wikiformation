{% extends 'marketplace/base.html.twig' %}
{% block content %}
<section class="mk-hero"><div><span class="mk-kicker">Un cadre clair pour apprendre et transmettre</span><h1>Conditions & confidentialité</h1><p>Version {{ settings.termsVersion }}</p></div></section>
<section class="mk-panel">
  <h2>Conditions de vente et d’utilisation du catalogue</h2>
  <div class="mk-break">{{ settings.terms ?: 'Le catalogue est en préparation. Les conditions définitives seront disponibles avant l’ouverture des paiements.' }}</div>
  <h2 style="margin-top:32px">Vos données personnelles</h2>
  <div class="mk-break">{{ settings.privacy ?: 'Les informations de protection des données seront complétées avant l’ouverture des ventes.' }}</div>
  <p style="margin-top:24px">Pour demander l’accès, la rectification ou l’effacement de vos données, consultez les <a href="{{ path('app_public_politique_confidentialite') }}">modalités d’exercice de vos droits</a>. Une demande d’effacement peut nécessiter de conserver certaines pièces pour respecter les obligations légales.</p>
  {% if app.user %}<p><a href="{{ path('app_market_data_export') }}">Télécharger mes données e-learning</a></p>{% endif %}
  <p><a href="{{ path('app_public_mentions_legales') }}">Mentions légales</a> · <a href="{{ path('app_public_cookies') }}">Politique de cookies</a> · <button type="button" class="btn btn-link p-0" data-manage-cookies>Modifier mes préférences de cookies</button></p>
</section>
{% endblock %}
