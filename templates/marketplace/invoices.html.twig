{% extends 'marketplace/base.html.twig' %}
{% block content %}
<section class="mk-hero"><div><span class="mk-kicker">Documents comptables</span><h1>Factures et avoirs.</h1><p>Retrouvez les documents émis automatiquement après paiement. Les originaux restent disponibles après un remboursement.</p></div></section>
<section class="mk-panel">{% for invoice in invoices %}<article style="padding:20px 0;border-bottom:1px solid #dce4ec"><div class="mk-row"><div><strong>{{ invoice.number }}</strong><p>{{ invoice.issuedAt|date('d/m/Y') }} · {{ {'sale':'Vente de cours','sale_credit':'Avoir sur cours','commission':'Commission','commission_credit':'Avoir sur commission'}[invoice.kind] }} · {{ (invoice.document.gross/100)|number_format(2,',',' ') }} € TTC</p><span>{{ invoice.document.issuer.name }} → {{ invoice.document.customer.name }}</span></div><a class="mk-button secondary" href="{{ path('app_market_invoice_pdf',{id:invoice.id}) }}">Télécharger le PDF</a></div>{% if invoice.contestedAt %}<p><strong>Contestation du {{ invoice.contestedAt|date('d/m/Y') }}</strong> : {{ invoice.contestation }}</p>{% elseif invoice.purchase.seller.user==app.user and invoice.document.mandated %}<p class="mk-note">{% if invoice.notifiedAt %}Notifié le {{ invoice.notifiedAt|date('d/m/Y') }}. Acceptation tacite après 30 jours sans contestation, conformément au mandat.{% else %}Notification en attente : le délai d’acceptation n’a pas commencé.{% endif %}</p><details><summary>Signaler une erreur sur ce document</summary><form method="post" action="{{ path('app_market_invoice_contest',{id:invoice.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('invoice_'~invoice.id) }}"><div class="mk-field"><label>Rectification demandée<textarea name="reason" minlength="10" maxlength="4000" required></textarea></label></div><button class="mk-button secondary">Enregistrer ma contestation</button></form></details>{% endif %}</article>{% else %}<p>Vos documents apparaîtront après votre premier paiement confirmé.</p>{% endfor %}<nav style="margin-top:24px">{% if page>1 %}<a href="{{ path('app_market_invoices',{page:page-1}) }}">← Précédent</a>{% endif %}{% if next %} <a href="{{ path('app_market_invoices',{page:page+1}) }}">Suivant →</a>{% endif %}</nav></section>
{% endblock %}
