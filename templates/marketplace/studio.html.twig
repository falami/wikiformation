{% extends 'marketplace/base.html.twig' %}{% block content %}
<section class="mk-hero"><div><span class="mk-kicker">Votre studio · {{ entite.nom }}</span><h1>Votre savoir.<br><strong>De nouvelles possibilités.</strong></h1><p>Créez vos cours, accompagnez vos stagiaires et partagez votre expertise avec de nouveaux apprenants.</p></div><div><a class="mk-button" href="{{ path('app_market_trainer_new',{entite:entite.id}) }}">+ Créer un cours</a><p class="mk-note" style="margin-top:18px">Création sans limite de nombre de cours.<br>Vous travaillez dans l’espace {{ entite.nom }}.</p></div></section>
<div class="mk-toolbar"><h2>Mes cours <span class="mk-badge">{{ courses|length }}</span></h2><a class="mk-anchor" href="{{ path('app_market_trainer_seller',{entite:entite.id}) }}">Profil vendeur et revenus →</a></div>
<div class="mk-grid">{% for course in courses %}<article class="mk-card"><span class="mk-kicker">{{ course.isPublished ? 'Prêt à être partagé' : 'Brouillon' }}</span><h2>{{ course.titre }}</h2><p>{{ course.description|striptags|slice(0,160) }}</p><div class="mk-spacer"><a class="mk-button" href="{{ path('app_administrateur_elearning_content_index',{entite:entite.id,course:course.id}) }}">Éditer le contenu</a><div class="mk-links" style="margin-top:18px"><a href="{{ path('app_market_trainer_edit',{entite:entite.id,id:course.id}) }}">Présentation</a><a href="{{ path('app_market_trainer_assign',{entite:entite.id,id:course.id}) }}">Offrir un accès</a><a href="{{ path('app_market_trainer_offer',{entite:entite.id,id:course.id}) }}">Mettre en vente</a></div></div></article>{% else %}<div class="mk-empty"><h2>Votre premier cours commence ici.</h2><p>Un titre, quelques chapitres et votre expertise : construisez à votre rythme.</p></div>{% endfor %}</div>{% endblock %}
