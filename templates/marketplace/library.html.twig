{% extends 'marketplace/base.html.twig' %}{% block content %}<section class="mk-hero"><div><span class="mk-kicker">Votre bibliothèque personnelle</span><h1>Vos cours.<br><strong>Toujours au même endroit.</strong></h1><p>Retrouvez vos achats et les cours offerts par vos formateurs, quel que soit votre espace de formation.</p></div></section><div class="mk-grid">{% for access in accesses %}<article class="mk-card"><span class="mk-badge">{{ access.purchase ? 'Acheté' : 'Accès offert' }}</span><h2>{{ access.snapshot.title }}</h2><p>{{ access.snapshot.description|slice(0,140) }}</p><div class="mk-progress"><span style="width:{{ access.snapshot.nodes|length ? access.completed|length/access.snapshot.nodes|length*100 : 0 }}%"></span></div><p class="mk-note">{{ access.completed|length }} / {{ access.snapshot.nodes|length }} chapitres terminés</p>{% if access.suspended %}<p>Accès suspendu à la suite d’un remboursement intégral ou d’un litige.</p>{% else %}<a class="mk-button" href="{{ path('app_market_learn',{id:access.id}) }}">Continuer à apprendre →</a>{% endif %}</article>{% else %}<div class="mk-empty"><h2>Votre prochaine compétence vous attend.</h2><a href="{{ path('app_market_catalogue') }}">Découvrir les cours →</a></div>{% endfor %}</div>{% if purchases %}<section class="mk-panel" style="margin-top:32px"><h2>Mes commandes</h2>{% for p in purchases %}<div class="mk-row"><span>{{ p.createdAt|date('d/m/Y') }} · {{ p.seller.legalName }}</span><span>{{ (p.totalCents/100)|number_format(2,',',' ') }} € · {{ p.status }}</span><a href="{{ path('app_market_purchase',{id:p.id}) }}">Voir le justificatif →</a></div>{% endfor %}</section>{% endif %}<p class="mk-note"><a href="{{ path('app_market_data_export') }}">Télécharger mes données e-learning</a> · <a href="{{ path('app_market_terms') }}">Confidentialité et exercice de mes droits</a></p>{% endblock %}
