{% extends 'marketplace/base.html.twig' %}{% block content %}<section class="mk-hero"><div><span class="mk-kicker">Votre activité de formateur</span><h1>Transmettez.<br><strong>Développez vos revenus.</strong></h1><p>Vous êtes le vendeur de vos cours. WikiFormation facilite leur diffusion et leur paiement.</p></div><div><span class="mk-badge">{{ platformSeller ? 'Encaissement direct · Stripe de la plateforme' : seller.accountId ? 'Compte Stripe créé — vérifier son activation sur Stripe' : 'Paiements à configurer' }}</span></div></section><div class="mk-two"><form class="mk-panel" method="post"><input type="hidden" name="_token" value="{{ csrf_token('seller') }}"><h2>Vos informations professionnelles</h2>{% for key,label in {legalName:'Nom ou raison sociale du vendeur',registration:'SIRET / identification professionnelle',address:'Adresse professionnelle',email:'E-mail de contact client',taxNumber:'Numéro de TVA (si applicable)',taxExemption:'Mention légale d’exonération de TVA (si applicable)',country:'Pays d’établissement (FR uniquement)',postalCode:'Code postal de l’établissement'} %}<div class="mk-field"><label for="{{ key }}">{{ label }}</label><input id="{{ key }}" name="{{ key }}" value="{{ attribute(seller,key) }}" maxlength="255" {{ key in ['legalName','registration','address','email']?'required':'' }}></div>{% endfor %}{% if not platformSeller %}<details><summary>Lire et conserver mon mandat de facturation</summary><div class="mk-break">{{ mandateText }}</div></details><div class="mk-check"><input id="mandate" name="mandate" type="checkbox" value="1" required><label for="mandate">Je mandate I.T. For You pour établir mes factures et avoirs, et j’accepte les modalités de contrôle et de contestation ci-dessus.</label></div>{% endif %}<div class="mk-check"><input id="accept" type="checkbox" name="accept" value="1" required><label for="accept">{% if platformSeller %}Je confirme les informations légales d’I.T For You, les conditions de vente et le maintien des versions achetées. Les ventes sont encaissées directement par la plateforme, sans commission interne.{% else %}J’accepte les conditions vendeur : responsabilité de mes contenus et de ma fiscalité, commission de la plateforme, frais Stripe, reversements après 14 jours et maintien des versions déjà achetées.{% endif %}</label></div><a href="{{ path('app_market_terms') }}">Lire les conditions</a><p></p><button class="mk-button">Enregistrer mon profil</button></form><aside class="mk-panel"><h2>Votre rémunération</h2>{% if platformSeller %}<span class="mk-badge">Ventes propres I.T For You</span><p>Le montant de vos cours est encaissé directement sur le compte Stripe déjà configuré pour la plateforme.</p><p><strong>Aucune commission interne, aucun second compte Stripe Connect et aucun reversement à vous-même.</strong> Les frais de paiement Stripe habituels restent applicables.</p><p>Vos ventes HT sont comptabilisées séparément des commissions dans le pilotage super admin. Renseignez ici les coordonnées professionnelles d’I.T For You.</p>{% else %}<p>Commission de la plateforme : <strong>{{ settings.commissionBps is not null ? (settings.commissionBps/100)|number_format(2,',',' ')~' % du prix HT' : 'à définir' }}</strong>.</p><p>Part vendeur = prix TTC payé − commission TTC (TVA de 20 % sur la commission HT) − {{ settings.feesPayer=='seller'?'frais Stripe réels':'0 € de frais Stripe à votre charge' }}.</p><p>La TVA collectée sur vos ventes reste à déclarer selon votre régime. Les remboursements et litiges peuvent réduire les sommes reversées.</p><form method="post" action="{{ path('app_market_trainer_connect',{entite:entite.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('connect') }}"><button class="mk-button" {{ not seller.termsAcceptedAt?'disabled':'' }}>{{ seller.accountId?'Compléter / vérifier mon compte Stripe':'Activer mes versements avec Stripe' }} →</button></form><p class="mk-note">Vos coordonnées bancaires et justificatifs d’identité sont recueillis par Stripe, pas par WikiFormation.</p>{% endif %}</aside></div><section class="mk-panel" style="margin-top:28px"><h2>Mes ventes récentes</h2><p><a class="mk-button secondary" href="{{ path('app_market_invoices') }}">Mes factures et avoirs</a></p>{% if not platformSeller and seller.mandates %}<details><summary>Mandats acceptés et révocation</summary>{% for mandate in seller.mandates %}<p>Accepté le {{ mandate.acceptedAt|date('d/m/Y H:i') }}{% if mandate.revokedAt %} · Révoqué le {{ mandate.revokedAt|date('d/m/Y H:i') }}{% endif %}</p><pre class="mk-break">{{ mandate.text }}</pre>{% endfor %}<form method="post" action="{{ path('app_market_trainer_revoke_mandate',{entite:entite.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('revoke_mandate') }}"><button class="mk-button secondary">Révoquer le mandat et suspendre mes offres</button></form></details>{% endif %}<div class="mk-scroll"><table class="mk-table"><thead><tr><th>Date</th><th>Cours</th><th>Vente TTC</th><th>Commission HT + TVA</th><th>Frais Stripe</th><th>Reversé net de reprises</th><th>État</th></tr></thead><tbody>{% for sale in sales %}<tr><td>{{ sale.createdAt|date('d/m/Y') }}</td><td>{% for item in sale.items %}{{ item.title }}<br>{% endfor %}</td><td>{{ (sale.totalCents/100)|number_format(2,',',' ') }} €</td><td>{{ (sale.commissionCents/100)|number_format(2,',',' ') }} € + {{ (sale.commissionTaxCents/100)|number_format(2,',',' ') }} €</td><td>{{ (sale.stripeFeeCents/100)|number_format(2,',',' ') }} €</td><td>{% if sale.platformSale %}Encaissement direct plateforme{% else %}{{ (sale.transferredCents/100)|number_format(2,',',' ') }} €{% endif %}</td><td>{{ {'pending':'En attente','paid':'Payé','refunded':'Remboursé en tout ou partie','disputed':'En litige','expired':'Expiré'}[sale.status]|default(sale.status) }}</td></tr>{% else %}<tr><td colspan="7">Votre première vente apparaîtra ici.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
