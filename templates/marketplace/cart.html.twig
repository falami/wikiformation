{% extends 'marketplace/base.html.twig' %}{% block content %}<section class="mk-hero"><div><span class="mk-kicker">Votre sélection</span><h1>Prêt à apprendre ?</h1><p>Vérifiez votre panier. Chaque formateur étant le vendeur de ses cours, le règlement s’effectue séparément par formateur.</p></div></section>{% for group in groups %}<section class="mk-panel" style="margin-bottom:24px"><span class="mk-kicker">Votre vendeur professionnel</span>
<h2>{{ group.seller.legalName }}</h2>
<div class="mk-note" aria-label="Coordonnées du vendeur">
  {% for label,value in {
    'Immatriculation': group.seller.registration,
    'Adresse professionnelle': group.seller.address,
    'E-mail de contact': group.seller.email,
    'Numéro de TVA': group.seller.taxNumber,
    'Mention d’exonération de TVA': group.seller.taxExemption
  } %}
    {% if value|trim %}<p><strong>{{ label }} :</strong><br><span class="mk-break">{{ value }}</span></p>{% endif %}
  {% endfor %}
</div>{% for offer in group.offers %}<div class="mk-row"><div><strong>{{ offer.snapshot.title }}</strong><p class="mk-note">{{ (offer.priceCents/100)|number_format(2,',',' ') }} € TTC</p></div><form method="post" action="{{ path('app_market_cart_remove',{id:offer.id}) }}"><input type="hidden" name="terms_version" value="{{ settings.termsVersion }}"><input type="hidden" name="_token" value="{{ csrf_token('cart') }}"><button class="mk-button secondary">Retirer</button></form></div>{% endfor %}<form method="post" action="{{ path('app_market_checkout',{seller:group.seller.id}) }}"><input type="hidden" name="terms_version" value="{{ settings.termsVersion }}"><input type="hidden" name="_token" value="{{ csrf_token('checkout') }}"><div class="mk-toolbar"><strong>Total TTC</strong><span class="mk-price">{{ (group.total/100)|number_format(2,',',' ') }} €</span></div>{% for name,label in {terms:'J’accepte les conditions de vente présentées avant le paiement.',immediate:'Je demande expressément l’accès immédiat aux contenus numériques avant la fin du délai de rétractation.',withdrawal:'Je reconnais perdre mon droit de rétractation lorsque la fourniture du contenu numérique commence avec mon accord.'} %}<div class="mk-check"><input type="checkbox" name="{{ name }}" id="{{ name }}-{{ group.seller.id }}" value="1" required><label for="{{ name }}-{{ group.seller.id }}">{{ label }}</label></div>{% endfor %}<p><a href="{{ path('app_market_terms') }}" target="_blank" rel="noopener">Lire les conditions de vente et la politique de confidentialité</a></p><button class="mk-button" {{ not settings.enabled?'disabled':'' }}>Payer {{ (group.total/100)|number_format(2,',',' ') }} € — commande avec obligation de paiement →</button><p class="mk-note">Paiement sécurisé sur Stripe. Aucune donnée de carte bancaire n’est enregistrée par WikiFormation. Les garanties légales restent applicables.</p>{% if not settings.enabled %}<p>Les paiements ne sont pas encore ouverts.</p>{% endif %}</form></section>{% else %}<div class="mk-empty"><h2>Votre panier est vide.</h2><a class="mk-button" href="{{ path('app_market_catalogue') }}">Explorer le catalogue</a></div>{% endfor %}{% endblock %}
