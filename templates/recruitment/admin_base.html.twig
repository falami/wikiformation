{% extends 'base_admin.html.twig' %}
{% block title %}Recrutement des formateurs{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/habilitation.css') }}"><link rel="stylesheet" href="{{ asset('dist/recruitment/tom-select.css') }}"><style>.recruit-admin{max-width:1500px;margin:auto;padding:28px}.recruit-admin .hab-hero h1{font-size:36px}.recruit-admin .filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.recruit-admin label{display:block;font-weight:600;font-size:13px}.recruit-admin input,.recruit-admin select,.recruit-admin textarea{width:100%;padding:10px;border:1px solid #dce2e9;border-radius:8px;margin-top:8px}.recruit-admin input[type=checkbox]{width:18px}.recruit-admin .detail-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:24px}.recruit-admin .tag{display:inline-block;background:#f2f5f8;border-radius:6px;padding:5px 8px;margin:3px;font-size:12px}.recruit-admin dt{color:#667085;font-size:12px;margin-top:16px}.recruit-admin dd{white-space:pre-wrap;overflow-wrap:anywhere}.recruit-admin .portrait{width:90px;height:90px;border-radius:16px;object-fit:cover}.recruit-admin .hab-table td{vertical-align:top}.recruit-admin .toolbar{display:flex;gap:12px;flex-wrap:wrap;margin-top:16px}@media(max-width:850px){.recruit-admin .filters,.recruit-admin .detail-grid{grid-template-columns:1fr}.recruit-admin{padding:15px}}</style>{% endblock %}
{% block body %}<div class="hab recruit-admin">{% include 'flagMessage.html.twig' %}{% block recruitment %}{% endblock %}</div>{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('dist/recruitment/tom-select.min.js') }}" defer></script><script>document.addEventListener('DOMContentLoaded',()=>{document.querySelectorAll('[data-recruit-select]').forEach(s=>{if(!window.TomSelect || s.tomselect)return;
const isSubject=s.hasAttribute('data-recruit-subject');
new TomSelect(s,{
  plugins:s.multiple?['remove_button']:(isSubject?['clear_button']:[]),
  maxOptions:100,
  ...(isSubject?{
    create:true,
    persist:false,
    render:{
      option_create:(data,escape)=>'<div class="create">Rechercher « '+escape(data.input)+' »</div>',
      no_results:()=>'<div class="no-results">Aucune matière correspondante. Vous pouvez saisir votre recherche.</div>'
    }
  }:{})
});});});</script>{% endblock %}
