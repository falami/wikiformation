{% extends 'formateur/profile/base.html.twig' %}
{% block title %}Disponibilités des formateurs{% endblock %}
{% block body %}
<div class="tp">
<div class="tp-hero"><div class="tp-kicker">FORMATEURS · PLANIFICATION</div><h1>La bonne expertise, au bon moment.</h1><p>Repérez les formateurs par matière et comparez leurs disponibilités, demi-journée par demi-journée.</p></div>
<div class="tp-card">
<form class="tp-filters" method="get"><div style="flex:1;min-width:230px"><label for="subject">Matière enseignée</label><select id="subject" name="subject"><option value="">Toutes les matières</option>{% for item in subjects %}<option {{ subject == item ? 'selected' : '' }}>{{ item }}</option>{% endfor %}</select></div><div><label for="week">Semaine du</label><input class="form-control" id="week" name="date" type="date" value="{{ start|date('Y-m-d') }}"></div><button class="btn btn-primary">Afficher</button><a class="btn btn-outline-secondary" href="{{ path('app_administrateur_planning_formateurs_index',{entite:entite.id}) }}">Planning des formations</a></form>
<div class="tp-nav"><a class="btn btn-outline-secondary" href="{{ path('app_admin_trainer_availability',{entite:entite.id,date:start|date_modify('-7 days')|date('Y-m-d'),subject:subject}) }}">← Semaine précédente</a><strong class="align-self-center">{{ start|date('d/m') }} — {{ start|date_modify('+6 days')|date('d/m/Y') }}</strong><a class="btn btn-outline-secondary" href="{{ path('app_admin_trainer_availability',{entite:entite.id,date:start|date_modify('+7 days')|date('Y-m-d'),subject:subject}) }}">Semaine suivante →</a></div>
<div class="tp-legend"><span class="tp-free">Disponible</span><span class="tp-busy">Occupé</span><span class="tp-unknown">À confirmer</span><span class="tp-off">Non travaillé</span></div>
<p class="tp-help">Matin : 8 h – 13 h · Après-midi : 13 h – 18 h · Tout chevauchement rend la demi-journée occupée. Les agendas connectés sont actualisés à l’ouverture, au maximum toutes les 15 minutes. Les informations personnelles des événements restent confidentielles.</p>
<div class="tp-matrix"><table><thead><tr><th scope="col">{{ total }} formateur{{ total > 1 ? 's' : '' }}</th>{% set names=['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'] %}{% for i in 0..6 %}<th scope="col">{{ names[i] }}<br>{{ start|date_modify('+'~i~' days')|date('d/m') }}</th>{% endfor %}</tr></thead><tbody>
{% for row in rows %}<tr {% if row.profile.calendarSecret %}data-sync="{{ path('app_admin_trainer_sync',{entite:entite.id,id:row.trainer.id,date:start|date('Y-m-d')}) }}"{% endif %}><td><strong>{{ row.trainer.utilisateur.prenom }} {{ row.trainer.utilisateur.nom }}</strong><div>{% for item in row.profile.subjects %}<span class="tp-pill">{{ item }}</span>{% else %}<span class="tp-help">Matières à renseigner</span>{% endfor %}</div><small class="tp-help" data-sync-status aria-live="polite">{{ row.profile.calendarSecret ? (row.profile.syncError ?: 'Agenda connecté · Actualisation…') : 'Disponibilités déclaratives' }}</small>{% if row.diplomas and is_granted('FORMATEUR_MANAGE',entite) %}<details><summary>{{ row.diplomas|length }} diplôme(s)</summary>{% for diploma in row.diplomas %}<a class="d-block mt-2" href="{{ path('app_trainer_diploma_download',{entite:entite.id,id:diploma.id}) }}">{{ diploma.title }}</a>{% endfor %}</details>{% endif %}</td>{% for day in row.days %}<td>{% for half,part in day.parts %}<span data-slot="{{ day.date }}-{{ half }}" class="tp-slot tp-{{ part.state }}" title="{{ part.label }}"><strong>{{ half == 'AM' ? 'Matin' : 'Après-midi' }}</strong><br><span>{{ part.label }}</span></span>{% endfor %}</td>{% endfor %}</tr>{% else %}<tr><td colspan="8"><div class="p-4 text-center"><strong>Aucun formateur pour cette sélection.</strong><p class="tp-help mb-0">Les formateurs peuvent renseigner leurs matières dans « Mon profil & diplômes ».</p></div></td></tr>{% endfor %}
</tbody></table></div>
{% if total > 25 %}<nav class="tp-nav" aria-label="Pages de formateurs">{% for n in 1..((total / 25)|round(0,'ceil')) %}<a class="btn {{ page == n ? 'btn-primary' : 'btn-outline-secondary' }}" href="{{ path('app_admin_trainer_availability',{entite:entite.id,date:start|date('Y-m-d'),subject:subject,page:n}) }}">{{ n }}</a>{% endfor %}</nav>{% endif %}
</div></div>
{% endblock %}
{% block javascripts %}{{ parent() }}<script>
document.addEventListener('DOMContentLoaded',()=>{
 new TomSelect('#subject',{allowEmptyOption:true,plugins:['clear_button']});
 const queue=Array.from(document.querySelectorAll('[data-sync]'));
 async function worker(){while(queue.length){const row=queue.shift(),status=row.querySelector('[data-sync-status]');try{const response=await fetch(row.dataset.sync,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({_token:{{ csrf_token('availability_'~entite.id)|json_encode|raw }}})});if(!response.ok)throw new Error();const result=await response.json();status.textContent=result.status;for(const day of result.days)for(const [half,part] of Object.entries(day.parts)){const slot=row.querySelector(`[data-slot="${day.date}-${half}"]`);if(slot && ['free','busy','unknown','off'].includes(part.state)){slot.className='tp-slot tp-'+part.state;slot.title=part.label;slot.querySelector('span').textContent=part.label;}}}catch(error){status.textContent='Actualisation indisponible · Vérifiez auprès du formateur.';row.querySelectorAll('.tp-free').forEach(slot=>{slot.className='tp-slot tp-unknown';slot.querySelector('span').textContent='À confirmer';});}}}
 worker();worker();
});
</script>{% endblock %}
