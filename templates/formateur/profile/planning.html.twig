@media(max-width:1100px){.availability-studio .tp-filters{align-items:stretch}.availability-studio .tp-filters>div:first-child{flex-basis:100%!important}.availability-studio .tp-hero{padding:26px}.availability-studio .availability-panel{padding:18px}.availability-studio .tp-matrix th:first-child{width:235px}.availability-studio .tp-matrix td:first-child{padding:18px}.availability-studio .tp-hero h1{font-size:1.5rem}}

.availability-studio .tp-slot{width:100%;display:flex;flex-direction:column;align-items:flex-start;gap:5px;min-height:68px;padding:12px;cursor:pointer;white-space:normal;text-align:left;border-left-width:3px;font-size:.75rem;font-weight:650}.availability-studio .tp-slot strong{font-size:.62rem;border:0;padding:0;opacity:.85;font-weight:500}.availability-studio .tp-slot:hover{transform:translateY(-1px);box-shadow:0 4px 12px #203b4a17}.availability-studio .tp-free{background:#e0f3e9;color:#176748;border-color:#74bda0}.availability-studio .tp-busy{background:#faeae7;color:#9d4235;border-color:#d49286}.availability-studio .tp-unknown{background:#fff5da;color:#816316;border-color:#d5b565}.availability-studio .tp-off{background:#f1f3f6;color:#6c7882;border-color:#cdd5dc}.planning-instruction{padding:12px 16px;background:#eef5f8;color:#456878;border-radius:10px;font-size:.8rem;margin-bottom:18px}.trainer-contact{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.trainer-contact button{border:0;background:#f0f5f7;color:#315568;border-radius:6px;font-size:.65rem;padding:7px 9px;font-weight:600}.trainer-contact button:hover{background:#dfeaf0}
.inquiry-dialog{width:min(840px,94vw);max-height:90vh;border:1px solid #dce5eb;border-radius:20px;padding:0;color:#203b4a;box-shadow:0 30px 100px #10253240}.inquiry-dialog::backdrop{background:#12253280;backdrop-filter:blur(4px)}.inquiry-dialog header{display:flex;justify-content:space-between;align-items:center;padding:26px 30px;background:#203e4f;color:white}.inquiry-dialog h2{font-size:1.4rem;font-weight:700;margin:6px 0}.inquiry-dialog header p{margin:0;color:#c6d8e2}.inquiry-dialog .trainer-eyebrow{color:#e1bd6e}.inquiry-tabs{display:flex;gap:24px;padding:0 30px;border-bottom:1px solid #e4ebef}.inquiry-tabs button{background:none;border:0;padding:17px 0;font-size:.85rem;color:#7b8f9c;border-bottom:3px solid transparent}.inquiry-tabs button.active{color:#234c62;border-bottom-color:#234c62;font-weight:650}.inquiry-body{padding:24px 30px}.inquiry-section+ .inquiry-section{border-top:1px solid #e4ebef;margin-top:24px;padding-top:24px}.inquiry-dialog h3{font-size:1rem;font-weight:700}.inquiry-dialog label{display:block;font-size:.8rem;font-weight:600;margin:12px 0 8px}.inquiry-dialog .form-control,.inquiry-dialog .form-select{border-radius:9px;border-color:#dce5eb;min-height:42px}.inquiry-add{display:flex;gap:12px;align-items:end;margin-bottom:16px}.inquiry-add label{flex:1;margin:0}.inquiry-chip{border:1px solid #ccdee8;background:#edf5f9;color:#305d76;border-radius:8px;font-size:.8rem;padding:9px 12px;margin:0 6px 8px 0}.inquiry-dialog footer{background:#f5f8fa;border-top:1px solid #e4ebef;padding:18px 30px;display:flex;align-items:center;justify-content:space-between;gap:12px}.inquiry-dialog footer span{font-size:.75rem;color:#8193a0}.inquiry-dialog .btn-primary{background:#234c62;border-color:#234c62}.inquiry-record{border:1px solid #e1e9ee;border-radius:12px;padding:20px;margin-bottom:18px}.inquiry-record h3{margin:12px 0}.inquiry-record p{font-size:.85rem;white-space:pre-wrap}.inquiry-event{padding:12px 15px;border-left:2px solid #b8cbd6;background:#f7f9fb;margin:8px 0}.inquiry-event small{color:#8193a0;font-size:.7rem}.inquiry-event p{margin:5px 0 0}.inquiry-update{display:grid;gap:10px;margin-top:14px}.inquiry-update .btn{justify-self:start}@media(max-width:600px){.inquiry-add{flex-wrap:wrap}.inquiry-dialog header,.inquiry-body{padding:20px}.inquiry-dialog footer{flex-wrap:wrap}.inquiry-tabs{gap:15px;padding:0 20px}}
