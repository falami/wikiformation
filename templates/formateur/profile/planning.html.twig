{% extends 'formateur/profile/base.html.twig' %}
{% block title %}Disponibilités des formateurs{% endblock %}
{% block body %}
<div class="tp availability-studio" data-inquiry-token="{{ csrf_token('inquiry_'~entite.id) }}">
<div class="tp-hero"><div class="tp-kicker">FORMATEURS · PLANIFICATION</div><h1>Disponibilités des formateurs</h1><p>Repérez les formateurs par matière et comparez leurs disponibilités, demi-journée par demi-journée.</p></div>
<div class="tp-card availability-panel">
<form class="tp-filters" method="get"><div style="flex:1;min-width:230px"><label for="subject">Matière enseignée</label><select id="subject" name="subject"><option value="">Toutes les matières</option>{% for item in subjects %}<option {{ subject == item ? 'selected' : '' }}>{{ item }}</option>{% endfor %}</select></div><div><label for="week">Semaine du</label><input class="form-control" id="week" name="date" type="date" value="{{ start|date('Y-m-d',false) }}"></div><button class="btn btn-primary">Afficher</button><a class="btn btn-outline-secondary" href="{{ path('app_administrateur_planning_formateurs_index',{entite:entite.id}) }}">Planning des formations</a></form>
<div class="tp-nav week-navigation"><a class="btn btn-outline-secondary" href="{{ path('app_admin_trainer_availability',{entite:entite.id,date:start|date_modify('-7 days')|date('Y-m-d',false),subject:subject}) }}"><i class="bi bi-chevron-left" aria-hidden="true"></i><span class="visually-hidden">Semaine précédente</span></a><strong class="align-self-center">{{ start|date('d/m',false) }} — {{ start|date_modify('+6 days')|date('d/m/Y',false) }}</strong><a class="btn btn-outline-secondary" href="{{ path('app_admin_trainer_availability',{entite:entite.id,date:start|date_modify('+7 days')|date('Y-m-d',false),subject:subject}) }}"><i class="bi bi-chevron-right" aria-hidden="true"></i><span class="visually-hidden">Semaine suivante</span></a><a class="btn btn-outline-secondary today-button" href="{{ path('app_admin_trainer_availability',{entite:entite.id,date:'now'|date('Y-m-d','Europe/Paris'),subject:subject}) }}"><i class="bi bi-calendar-check" aria-hidden="true"></i> Aujourd’hui</a></div>
<div class="tp-legend" aria-label="Légende des disponibilités"><span class="tp-free">Disponible</span><span class="tp-busy">Occupé</span><span class="tp-unknown">À confirmer</span><span class="tp-off">Non travaillé</span></div>
<div class="availability-caption"><span><i class="bi bi-clock"></i> Matin · 8 h–13 h <span class="mx-2">/</span> Après-midi · 13 h–18 h</span><details><summary><i class="bi bi-info-circle"></i> Comprendre les disponibilités</summary><p>Tout chevauchement rend la demi-journée occupée. Les agendas sont actualisés à l’ouverture, au maximum toutes les 15 minutes. Le détail des événements reste confidentiel.</p></details></div>
<p class="planning-instruction"><i class="bi bi-cursor"></i> Cliquez sur une demi-journée pour proposer une intervention et sélectionner d’autres dates.</p><div class="tp-matrix"><table><thead><tr><th scope="col">{{ total }} formateur{{ total > 1 ? 's' : '' }}</th>{% set names=['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'] %}{% for i in 0..6 %}{% set dayDate = start|date_modify('+'~i~' days') %}<th scope="col" class="{{ i > 4 ? 'is-weekend' : '' }} {{ dayDate|date('Y-m-d',false) == 'now'|date('Y-m-d','Europe/Paris') ? 'is-today' : '' }}"><span class="day-name">{{ names[i] }}</span><span class="day-number">{{ dayDate|date('d',false) }}</span><span class="day-month">{{ dayDate|date('m/Y',false) }}</span></th>{% endfor %}</tr></thead><tbody>
{% for row in rows %}<tr data-trainer-name="{{ row.trainer.utilisateur.prenom }} {{ row.trainer.utilisateur.nom }}" data-inquiry-url="{{ path('app_trainer_inquiries',{entite:entite.id,id:row.trainer.id}) }}" {% if row.profile.calendarSecret %}data-sync="{{ path('app_admin_trainer_sync',{entite:entite.id,id:row.trainer.id,date:start|date('Y-m-d',false)}) }}"{% endif %}><td><div class="trainer-identity"><span class="trainer-avatar" aria-hidden="true">{{ row.trainer.utilisateur.prenom|slice(0,1) }}{{ row.trainer.utilisateur.nom|slice(0,1) }}</span><div><span class="trainer-eyebrow">FORMATEUR</span><strong>{{ row.trainer.utilisateur.prenom }} {{ row.trainer.utilisateur.nom }}</strong></div></div><div class="trainer-subjects">{% for item in row.profile.subjects %}<span class="tp-pill">{{ item }}</span>{% else %}<span class="tp-help">Matières à renseigner</span>{% endfor %}</div><small class="tp-help" data-sync-status aria-live="polite">{{ row.profile.calendarSecret ? (row.profile.syncError ?: 'Agenda connecté · Actualisation…') : 'Disponibilités déclaratives' }}</small><div class="trainer-contact"><button type="button" data-inquiry-open="compose"><i class="bi bi-send"></i> Proposer une formation</button><button type="button" data-inquiry-open="history"><i class="bi bi-clock-history"></i> Échanges</button></div>{% if row.diplomas and is_granted('FORMATEUR_MANAGE',entite) %}<details><summary>{{ row.diplomas|length }} diplôme(s)</summary>{% for diploma in row.diplomas %}<a class="d-block mt-2" href="{{ path('app_trainer_diploma_download',{entite:entite.id,id:diploma.id}) }}">{{ diploma.title }}</a>{% endfor %}</details>{% endif %}</td>{% for day in row.days %}<td>{% for half,part in day.parts %}<button type="button" data-slot="{{ day.date }}-{{ half }}" class="tp-slot tp-{{ part.state }}" tabindex="0" aria-label="{{ half == 'AM' ? 'Matin' : 'Après-midi' }} : {{ part.label }}" title="{{ part.label }}"><strong>{{ half == 'AM' ? 'Matin' : 'Après-midi' }}</strong><span>{{ {free:"Disponible",busy:"Occupé",unknown:"À confirmer",off:"Repos"}[part.state] }}</span></button>{% endfor %}</td>{% endfor %}</tr>{% else %}<tr><td colspan="8"><div class="p-4 text-center"><strong>Aucun formateur pour cette sélection.</strong><p class="tp-help mb-0">Les formateurs peuvent renseigner leurs matières dans « Mon profil & diplômes ».</p></div></td></tr>{% endfor %}
</tbody></table></div>
{% if total > 25 %}<nav class="tp-nav" aria-label="Pages de formateurs">{% for n in 1..((total / 25)|round(0,'ceil')) %}<a class="btn {{ page == n ? 'btn-primary' : 'btn-outline-secondary' }}" href="{{ path('app_admin_trainer_availability',{entite:entite.id,date:start|date('Y-m-d',false),subject:subject,page:n}) }}">{{ n }}</a>{% endfor %}</nav>{% endif %}
</div></div>
{% include 'formateur/profile/_inquiry.html.twig' %}
{% endblock %}
{% block javascripts %}{{ parent() }}<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script><script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/fr.js"></script><script>
document.addEventListener('DOMContentLoaded',()=>{
 if(typeof flatpickr === 'function') {
  flatpickr('#week', {
   locale:'fr',dateFormat:'Y-m-d',altInput:true,altFormat:'d/m/Y',disableMobile:true,
   ariaDateFormat:'l j F Y',
   onReady:(_, __, picker)=>{
    picker.calendarContainer.classList.add('availability-datepicker');
    picker.altInput.id='week-display';
    document.querySelector('label[for="week"]').htmlFor='week-display';
   },
   onChange:(_, __, picker)=>{ if(picker.selectedDates.length) picker.input.form.requestSubmit(); }
  });
 }
 new TomSelect('#subject',{allowEmptyOption:true,plugins:['clear_button']});
 const queue=Array.from(document.querySelectorAll('[data-sync]'));
 async function worker(){while(queue.length){const row=queue.shift(),status=row.querySelector('[data-sync-status]');try{const response=await fetch(row.dataset.sync,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({_token:{{ csrf_token('availability_'~entite.id)|json_encode|raw }}})});if(!response.ok)throw new Error();const result=await response.json();status.textContent=result.status;for(const day of result.days)for(const [half,part] of Object.entries(day.parts)){const slot=row.querySelector(`[data-slot="${day.date}-${half}"]`);if(slot && ['free','busy','unknown','off'].includes(part.state)){slot.className='tp-slot tp-'+part.state;slot.title=part.label;slot.setAttribute('aria-label',(half==='AM'?'Matin':'Après-midi')+' : '+part.label);slot.querySelector('span').textContent={free:'Disponible',busy:'Occupé',unknown:'À confirmer',off:'Repos'}[part.state];}}}catch(error){status.textContent='Actualisation indisponible · Vérifiez auprès du formateur.';row.querySelectorAll('.tp-free').forEach(slot=>{slot.className='tp-slot tp-unknown';slot.title='À confirmer';slot.setAttribute('aria-label','Disponibilité à confirmer');slot.querySelector('span').textContent='À confirmer';});}}}
 worker();worker();
});
</script>{% endblock %}

