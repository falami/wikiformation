{% extends 'base_admin.html.twig' %}



{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }
    .tp{max-width:1440px;margin:auto;padding:28px 24px 64px;color:#203b4a}.tp-hero{background:linear-gradient(120deg,#1d3342,#365968);color:white;padding:32px;border-radius:22px;margin-bottom:24px}.tp-kicker{color:#e5bf67;font-size:.72rem;letter-spacing:.12em;font-weight:700;margin-bottom:12px}.tp-hero h1{font-size:2rem;font-weight:750;letter-spacing:-.035em}.tp-hero p{color:#d2dfe5;margin-bottom:0;max-width:800px;line-height:1.7}.tp-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:24px;align-items:start}.tp-card{padding:26px;border:1px solid #e0e8ed;border-radius:18px;background:white;margin-bottom:24px;box-shadow:0 6px 25px #203b4a04}.tp-card h2{font-size:1.2rem;font-weight:750;margin-bottom:10px}.tp-help{font-size:.85rem;color:#718592;line-height:1.7}.tp label{font-size:.85rem;font-weight:600;margin:12px 0 7px}.tp input.form-control,.tp select.form-select,.tp .ts-control{border-color:#dce5ec;border-radius:10px;min-height:46px}.tp .ts-control .item{background:#edf3f6!important;color:#234354!important;border:0!important;border-radius:6px;padding:5px 9px!important}.tp .ts-dropdown{border-radius:12px;box-shadow:0 15px 35px #203b4a20;overflow:hidden}.tp .btn-primary{background:#234353;border-color:#234353}.tp .btn{border-radius:10px}.tp-pill{display:inline-block;border-radius:7px;padding:5px 9px;background:#eef3f6;color:#456477;font-size:.75rem;margin:3px}.tp-file{padding:16px 0;border-top:1px solid #e7edf1;display:flex;align-items:center;justify-content:space-between;gap:12px}.tp-file strong{display:block;font-size:.9rem}.tp-file small{color:#82929d}.tp-days{display:flex;flex-wrap:wrap;gap:8px}.tp-days label{padding:8px 12px;background:#f4f7f9;border:1px solid #e0e8ed;border-radius:10px}.tp-days input{accent-color:#234353}.tp-status{padding:12px 15px;border-radius:10px;background:#f4f7f9;font-size:.83rem}.tp-filters{display:flex;flex-wrap:wrap;gap:14px;align-items:end;margin-bottom:20px}.tp-matrix{overflow:auto;border:1px solid #dfe7ed;border-radius:14px}.tp-matrix table{width:100%;min-width:1050px;border-collapse:collapse}.tp-matrix th{background:#f4f7fa;font-size:.8rem;color:#617987;padding:16px;text-align:center}.tp-matrix th:first-child{min-width:240px;text-align:left}.tp-matrix td{padding:14px;border-top:1px solid #e6edf2;vertical-align:top}.tp-matrix td:first-child{background:#fff;position:sticky;left:0;z-index:1}.tp-slot{display:block;padding:8px;border-radius:8px;font-size:.72rem;text-align:center;margin-bottom:6px;min-width:95px}.tp-free{background:#e6f4ed;color:#276a4d}.tp-busy{background:#fbe9e7;color:#a24c40}.tp-unknown{background:#fff4d8;color:#8d6b20}.tp-off{background:#eef1f4;color:#7d8993}.tp-legend{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0}.tp-legend span{padding:6px 10px;border-radius:7px;font-size:.8rem}details summary{cursor:pointer;color:#456477;font-size:.85rem}details{margin-top:12px}.tp-nav{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}@media(max-width:900px){.tp-grid{grid-template-columns:1fr}.tp{padding:20px 14px}.tp-card,.tp-hero{padding:22px}}
  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css">

{% endblock %}
{% block javascripts %}{{ parent() }}<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>{% endblock %}
