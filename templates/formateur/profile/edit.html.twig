{% extends 'formateur/profile/base.html.twig' %}
{% block title %}Mon profil professionnel{% endblock %}
{% block body %}
{% set token = csrf_token('trainer_profile_' ~ trainer.id) %}
<div class="tp"><header class="tp-hero"><div class="tp-kicker">ESPACE FORMATEUR · {{ entite.nom }}</div><h1>Mon profil professionnel</h1><p>Vos matières, vos diplômes et vos disponibilités, réunis pour faciliter l’organisation de vos prochaines interventions.</p></header>
{% for kind,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ kind }}">{{ message }}</div>{% endfor %}{% endfor %}
<div class="tp-card"><h2>Mon CV en ligne</h2><p class="tp-help">Présentez votre parcours, importez votre CV et partagez votre expertise avec vos stagiaires.</p><a class="btn btn-primary" href="{{ path('app_trainer_cv_edit',{entite:entite.id}) }}">Créer ou enrichir mon CV</a></div><div class="tp-grid"><div>
<form method="post" class="tp-card"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="save">
<h2><i class="bi bi-journal-bookmark me-2"></i>Mes matières</h2><p class="tp-help">Sélectionnez les matières que vous enseignez. Une matière manque ? Saisissez son nom puis validez pour l’ajouter.</p>
<label for="tp-subjects">Matières enseignées</label><select id="tp-subjects" multiple name="subjects[]" placeholder="Rechercher ou ajouter une matière…">{% for subject in subjects %}<option value="{{ subject }}" {{ subject in profile.subjects ? 'selected' : '' }}>{{ subject }}</option>{% endfor %}</select>
<hr class="my-4"><h2><i class="bi bi-calendar-week me-2"></i>Mon rythme de travail</h2><p class="tp-help">Le planning présente le matin (8 h–13 h) et l’après-midi (13 h–18 h), en heure de Paris.</p><div class="tp-days">{% for n,label in {1:'Lun',2:'Mar',3:'Mer',4:'Jeu',5:'Ven',6:'Sam',7:'Dim'} %}<label><input type="checkbox" name="days[]" value="{{ n }}" {{ n in profile.workingDays ? 'checked' : '' }}> {{ label }}</label>{% endfor %}</div>
<label class="d-flex gap-2 align-items-start"><input class="mt-1" type="checkbox" name="declaredAvailable" value="1" {{ profile.declaredAvailable ? 'checked' : '' }}>Sans agenda connecté, je déclare être disponible ces jours-là, sauf formations affectées et indisponibilités renseignées.</label>
<hr class="my-4"><h2><i class="bi bi-link-45deg me-2"></i>Mon agenda Google ou Microsoft</h2><p class="tp-help">Connectez un calendrier ICS en lecture seule. Seuls les horaires occupés sont conservés : aucun titre, lieu ni participant n’apparaît dans le planning.</p>
<div class="tp-status">{% if profile.calendarSecret %}<i class="bi bi-link-45deg"></i> Agenda connecté{% if profile.syncedAt %} · Mis à jour le {{ profile.syncedAt|date('d/m/Y à H:i','Europe/Paris') }}{% endif %}{% else %}Aucun agenda connecté · disponibilités à confirmer{% endif %}{% if profile.syncError %}<div class="text-danger mt-2">{{ profile.syncError }}</div>{% endif %}</div>
<label for="tp-calendar">{{ profile.calendarSecret ? 'Remplacer le lien ICS' : 'Lien ICS du calendrier' }}</label><input class="form-control" type="url" id="tp-calendar" name="calendarUrl" autocomplete="off" placeholder="https://calendar.google.com/… ou https://outlook…" maxlength="3000"><p class="tp-help mt-2">Le lien est chiffré et ne sera pas affiché aux administrateurs. Laissez ce champ vide pour conserver la connexion.</p>
{% if profile.calendarSecret %}<label><input type="checkbox" name="disconnect" value="1"> Déconnecter l’agenda et effacer les créneaux importés</label>{% endif %}
<details><summary>Où trouver mon lien de calendrier ?</summary><div class="tp-help mt-3"><p><strong>Google Agenda :</strong> paramètres du calendrier → Intégrer l’agenda → Adresse secrète au format iCal. Copiez ce lien ici, sans rendre votre agenda public. <a href="https://support.google.com/calendar/answer/37648" target="_blank" rel="noopener">Aide Google</a></p><p><strong>Outlook :</strong> Paramètres → Calendrier → Calendriers partagés → Publier un calendrier → lien ICS. Choisissez le niveau de détail « occupé » si proposé. Votre organisation peut désactiver la publication. <a href="https://support.microsoft.com/en-us/outlook/share-your-calendar-in-outlook-com" target="_blank" rel="noopener">Aide Microsoft</a></p><p>Ce lien permet d’accéder au calendrier : gardez-le confidentiel. Les modifications du fournisseur peuvent apparaître avec un délai. Connectez le calendrier qui regroupe toutes vos indisponibilités.</p></div></details>
<button class="btn btn-primary mt-4 px-4"><i class="bi bi-check2 me-2"></i>Enregistrer mon profil</button></form>
{% if profile.calendarSecret %}<form method="post" class="mb-4"><input type="hidden" name="_token" value="{{ token }}"><button class="btn btn-outline-secondary" name="action" value="sync"><i class="bi bi-arrow-repeat me-2"></i>Synchroniser maintenant</button></form>{% endif %}
<section class="tp-card"><h2>Mes indisponibilités</h2><p class="tp-help">Bloquez une demi-journée ou plusieurs jours, même sans agenda connecté.</p><form method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="block"><div class="row g-2"><div class="col-6"><label for="tp-from">Du</label><input class="form-control" type="date" id="tp-from" name="start" required></div><div class="col-6"><label for="tp-to">Au inclus</label><input class="form-control" type="date" id="tp-to" name="end" required></div></div><label for="tp-period">Période</label><select class="form-select" id="tp-period" name="period"><option value="DAY">Journée entière</option><option value="AM">Matin</option><option value="PM">Après-midi</option></select><button class="btn btn-outline-primary my-3">Ajouter l’indisponibilité</button></form>
{% for block in profile.unavailable %}<div class="tp-file"><div><strong>{{ block.start|date('d/m/Y') }} → {{ block.end|date('d/m/Y') }}</strong><small>{{ {DAY:'Journée',AM:'Matin',PM:'Après-midi'}[block.period] }}</small></div><form method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="block" value="{{ block.id }}"><button class="btn btn-sm btn-outline-secondary" name="action" value="unblock">Retirer</button></form></div>{% else %}<p class="tp-help">Aucune indisponibilité ajoutée.</p>{% endfor %}</section>
</div><section class="tp-card"><h2><i class="bi bi-award me-2"></i>Mes diplômes et certifications</h2><p class="tp-help">Valorisez vos qualifications avec vos justificatifs. Ils sont accessibles à vous et aux administrateurs de {{ entite.nom }}.</p><form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="upload"><label for="tp-diploma-title">Intitulé du diplôme</label><input class="form-control" id="tp-diploma-title" name="title" required maxlength="180" placeholder="Ex. : Certification de formateur professionnel"><label for="tp-file">Justificatif</label><input class="form-control" id="tp-file" name="diploma" type="file" accept="application/pdf,image/jpeg,image/png" required><p class="tp-help mt-2">PDF, JPG ou PNG · 10 Mo maximum</p><button class="btn btn-primary mb-4"><i class="bi bi-upload me-2"></i>Déposer mon diplôme</button></form>
{% for diploma in diplomas %}<div class="tp-file"><div><strong>{{ diploma.title }}</strong><small>Déposé le {{ diploma.uploadedAt|date('d/m/Y') }}</small><div><a class="btn btn-sm btn-light mt-2" href="{{ path('app_trainer_diploma_download',{entite:entite.id,id:diploma.id}) }}"><i class="bi bi-download me-1"></i>Télécharger</a></div></div><form method="post" onsubmit="return confirm('Supprimer ce diplôme de votre profil ?')"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="diplomaId" value="{{ diploma.id }}"><button class="btn btn-sm btn-outline-danger" name="action" value="deleteDiploma" aria-label="Supprimer {{ diploma.title }}"><i class="bi bi-trash"></i></button></form></div>{% else %}<div class="tp-status"><i class="bi bi-file-earmark-plus me-2"></i>Votre premier diplôme apparaîtra ici.</div>{% endfor %}</section></div></div>
<script>document.addEventListener('DOMContentLoaded',()=>{new TomSelect('#tp-subjects',{plugins:['remove_button'],maxItems:50,create:input=>input.trim().length<=100?{value:input.trim(),text:input.trim()}:false,persist:false,closeAfterSelect:true,placeholder:'Rechercher ou ajouter une matière…',render:{no_results:()=>'<div class="no-results">Aucune matière trouvée. Saisissez son nom pour l’ajouter.</div>'}});});</script>
{% endblock %}
