<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>Votre réponse · {{ item.subject }}</title><style>body{margin:0;background:#f2f6f8;color:#264352;font:16px/1.65 system-ui,sans-serif}main{max-width:620px;margin:40px auto;background:white;border:1px solid #e0e8ed;border-radius:18px;overflow:hidden}header{background:#213e50;color:white;padding:28px}h1{font-size:25px;margin:8px 0}section{padding:28px}label{display:block;padding:12px;background:#f5f8fa;border-radius:9px;margin:10px 0;cursor:pointer}textarea{box-sizing:border-box;width:100%;border:1px solid #d9e3ea;border-radius:9px;padding:12px;font:inherit}button{padding:15px 22px;background:#234c62;color:white;border:0;border-radius:9px;font:inherit;cursor:pointer;margin-top:15px}.success{padding:18px;background:#e7f6ef;color:#276e50;border-radius:10px}.muted{color:#7b909d;font-size:13px}@media(max-width:650px){main{margin:16px}}</style></head><body><main><header><small>{{ item.formateur.entite.nom }} · Proposition #{{ item.id }}</small><h1>{{ item.subject }}</h1><span>{{ item.formateur.utilisateur.prenom }} {{ item.formateur.utilisateur.nom }}</span></header><section>{% if saved %}<div class="success"><strong>Votre réponse est enregistrée : {{ choices[choice] }}.</strong><br>L’organisme peut maintenant la consulter.</div>{% else %}<h2 style="font-size:19px">Confirmez votre réponse</h2>{% endif %}<p>{% for slot in item.slots %}{{ slot|slice(8,2) }}/{{ slot|slice(5,2) }}/{{ slot|slice(0,4) }} · {{ slot ends with 'AM' ? 'Matin (8 h–13 h)' : 'Après-midi (13 h–18 h)' }}<br>{% endfor %}</p>{% if item.message %}<p>{{ item.message|nl2br }}</p>{% endif %}{% if error %}<p role="alert">{{ error }}</p>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('inquiry_response_'~item.id) }}">{% for value,label in choices %}<label><input type="radio" name="choice" value="{{ value }}" {{ choice == value ? 'checked' : '' }} required> {{ label }}</label>{% endfor %}<label for="note">Un commentaire ? <span class="muted">Facultatif</span></label><textarea id="note" name="note" maxlength="2000" rows="3" placeholder="Précisions, disponibilité partielle, autre date…"></textarea><button>{{ saved ? 'Mettre à jour ma réponse' : 'Confirmer ma réponse' }}</button></form><p class="muted">Heure de Paris. Votre réponse porte sur les créneaux proposés et ne réserve pas automatiquement votre agenda.</p></section></main></body></html>
