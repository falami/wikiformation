{# templates/formateur/emargements.html.twig #}
{% extends 'base_admin.html.twig' %}

{% block title %}
  Émargements - {{ session.code ?? ('Session #' ~ session.id) }}
  {% if session.formation %} - {{ session.formation.titre }}{% endif %}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/style-table.css') }}">

  <link rel="stylesheet" href="{{ asset('dist/css/formateur-emargements.css') }}?v=1">
{% endblock %}

{% block body %}

{% set dayNames = { 1:'Lundi',2:'Mardi',3:'Mercredi',4:'Jeudi',5:'Vendredi',6:'Samedi',7:'Dimanche' } %}

{# Totaux (sans hypothèse forte sur tes variables) #}
{% set totalSigned = 0 %}
{% set totalExpected = 0 %}
{% set totalMissing = 0 %}
{% for j in jours %}
  {% set c = j.count ?? 0 %}
  {% set e = j.expected ?? 0 %}
  {% set totalSigned = totalSigned + c %}
  {% if e > 0 %}{% set totalExpected = totalExpected + e %}{% endif %}
  {% if j.isMissing ?? false %}{% set totalMissing = totalMissing + 1 %}{% endif %}
{% endfor %}

{% set completion = totalExpected > 0 ? min(100, (totalSigned / totalExpected * 100))|round(0, 'floor') : 0 %}
<div class="attendance-page">
<header class="attendance-hero">
  <div class="attendance-heading">
    <span class="attendance-eyebrow">ESPACE FORMATEUR <span>/</span> SUIVI DES PRÉSENCES</span>
    <h1>Émargements</h1>
    <p class="attendance-course">{{ session.formation ? session.formation.titre : 'Votre session de formation' }}</p>
    <div class="attendance-meta">
      <span><i class="bi bi-hash" aria-hidden="true"></i>{{ session.code ?? ('Session ' ~ session.id) }}</span>
      {% if session.site %}<span><i class="bi bi-geo-alt" aria-hidden="true"></i>{{ session.site.nom }}</span>{% endif %}
      <span><i class="bi bi-building" aria-hidden="true"></i>{{ entite.nom }}</span>
    </div>
  </div>
  <div class="attendance-hero-actions">
    <a href="{{ path('app_formateur_emargement_pdf', {entite: entite.id}) ~ '?session=' ~ session.id }}" class="btn attendance-export" target="_blank" rel="noopener"><i class="bi bi-download" aria-hidden="true"></i> Exporter les émargements</a>
    <a href="{{ path('app_formateur_dashboard', { entite: entite.id }) }}" class="attendance-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> Retour au tableau de bord</a>
  </div>
</header>
<div class="attendance-context"><span><span class="attendance-dot"></span> Vue d’ensemble de la session</span><span id="hero-last-refresh"></span></div>

{% include 'flagMessage.html.twig' %}

{# ================= KPIs ================= #}
<div class="row g-4 mb-4 attendance-layout">
  <aside class="col-lg-4">
    <div class="cardx">
      <div class="cardx-h">
        <div>
          <h5 class="cardx-title">
            <i class="bi bi-check2-circle text-theme-secondaire"></i> Suivi des signatures
          </h5>
          <div class="cardx-sub">Matin et après-midi cumulés</div>
        </div>

      </div>

      <div class="p-3 p-md-4">
        <div class="attendance-completion" style="--completion: {{ completion }}%;">
          <div class="attendance-ring"><div><strong>{{ totalExpected > 0 ? completion ~ '%' : '—' }}</strong><span>{{ totalExpected > 0 ? 'complété' : 'non défini' }}</span></div></div>
          <p>{{ totalExpected > 0 ? totalSigned ~ ' signatures sur ' ~ totalExpected ~ ' attendues' : 'Le nombre de signatures attendues n’est pas défini.' }}</p>
        </div>
        <div class="kpi">
          <div class="d-flex align-items-center gap-3">
            <div class="kpi-ico"><i class="bi bi-pen"></i></div>
            <div>
              <div class="label">Signatures totales</div>
              <div class="value">{{ totalSigned }}</div>
            </div>
          </div>
          <div class="text-end">
            <div class="label">Journées</div>
            <div class="value" style="font-size:1.15rem">{{ jours|length }}</div>
          </div>
        </div>

        <div class="mt-3 d-flex flex-wrap gap-2">
          {% if totalExpected > 0 %}
            {% set pct = totalExpected > 0 ? (totalSigned / totalExpected * 100) : 0 %}
            <span class="pill {{ pct >= 100 ? 'pill-ok' : 'pill-wait' }}">
              <i class="bi {{ pct >= 100 ? 'bi-check2' : 'bi-hourglass-split' }}"></i>
              {{ totalSigned }}/{{ totalExpected }} ({{ pct|round(0,'floor') }}%)
            </span>
          {% else %}
            <span class="pill">
              <i class="bi bi-info-circle"></i> Attendu non défini
            </span>
          {% endif %}

          {% if totalMissing > 0 %}
            <span class="pill pill-danger">
              <i class="bi bi-exclamation-triangle"></i> {{ totalMissing }} jour(s) manquant(s)
            </span>
          {% else %}
            <span class="pill pill-ok">
              <i class="bi bi-shield-check"></i> Aucun jour manquant
            </span>
          {% endif %}
        </div>
      </div>
    </div>
  </aside>

  <div class="col-lg-8">
    <div class="cardx">
      <div class="cardx-h">
        <div>
          <h5 class="cardx-title">
            <i class="bi bi-calendar-week text-theme-secondaire"></i> Journées de session
          </h5>
          <div class="cardx-sub">Consultez les signatures et la progression de chaque journée.</div>
        </div>
        <span class="badge-soft">
          <i class="bi bi-calendar3"></i> {{ jours|length }} jour{{ jours|length > 1 ? 's' : '' }}
        </span>
      </div>

      <div class="p-3 p-md-4">
        {% if jours is empty %}
          <div class="alert alert-light border mb-0" role="alert">
            <div class="d-flex gap-2 align-items-start">
              <i class="bi bi-info-circle mt-1"></i>
              <div>
                <div class="fw-semibold">Aucune journée enregistrée</div>
                <div class="text-muted small">
                  Cette session ne contient pas encore de journées, ou elles n’ont pas été planifiées.
                </div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="timeline">
            {% for j in jours %}
              {% set c = j.count ?? 0 %}
              {% set exp = j.expected ?? 0 %}
              {% set isMissing = j.isMissing ?? false %}
              {% set dow = j.date|date('N') %}

              {# statut lisible (FIX exp=0) #}
              {% set label = 'En cours' %}
              {% set pillClass = 'pill-wait' %}
              {% set pillIcon = 'bi-hourglass-split' %}

              {% if isMissing %}
                {% set label = 'Manquant' %}
                {% set pillClass = 'pill-danger' %}
                {% set pillIcon = 'bi-exclamation-triangle' %}

              {% elseif exp > 0 and c >= exp %}
                {% set label = 'Complet' %}
                {% set pillClass = 'pill-ok' %}
                {% set pillIcon = 'bi-check2-circle' %}

              {% elseif exp == 0 and (j.isPast ?? false) and c > 0 %}
                {# si attendu non défini, mais journée passée et signatures présentes => complet #}
                {% set label = 'Complet' %}
                {% set pillClass = 'pill-ok' %}
                {% set pillIcon = 'bi-check2-circle' %}

              {% elseif (j.isPast ?? false) and c == 0 %}
                {% set label = 'Aucun' %}
                {% set pillClass = '' %}
                {% set pillIcon = 'bi-dash-circle' %}
              {% endif %}

              <div class="timeline-item {{ isMissing ? 'is-missing' : '' }}">
                <div class="t-head">
                  <div>
                    <p class="t-title">
                      <span class="badge-soft" style="
                        background: color-mix(in srgb, var(--theme-color-secondaire) 14%, rgba(255,255,255,.70));
                        border-color: color-mix(in srgb, var(--theme-color-secondaire) 22%, rgba(15,23,42,.10));
                      ">
                        <i class="bi bi-calendar3"></i>
                        Jour {{ loop.index }}
                      </span>
                      {{ j.date|date('d/m/Y') }}
                    </p>

                    <div class="t-meta">
                      <span>
                        <i class="bi bi-calendar-week"></i>
                        {{ dayNames[dow] ?? '' }}
                      </span>

                      {% if exp > 0 %}
                        <span>
                          <i class="bi bi-check2-square"></i>
                          {{ c }} / {{ exp }} signature(s)
                        </span>
                      {% else %}
                        <span>
                          <i class="bi bi-pen"></i>
                          {{ c }} signature{{ c > 1 ? 's' : '' }}
                        </span>
                      {% endif %}

                      {% if isMissing %}
                        <span class="text-danger fw-semibold">
                          <i class="bi bi-exclamation-triangle"></i> Incomplet
                        </span>
                      {% endif %}
                    </div>
                  </div>

                  <div class="t-actions">
                    <span class="pill {{ pillClass }}">
                      <i class="bi {{ pillIcon }}"></i> {{ label }}
                    </span>

                    {# si tu veux un lien “détail” plus tard : tu peux le brancher ici #}
                    {# <a class="btn btn-soft btn-sm" href="#" title="Voir le détail"><i class="bi bi-eye"></i></a> #}
                  </div>
                </div>

                {% if exp > 0 %}
                  {% set pctDay = min(100, max(0, c / exp * 100)) %}
                  <div class="mt-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                      <span>Progression</span>
                      <span class="fw-semibold">{{ pctDay|round(0,'floor') }}%</span>
                    </div>
                    <div class="progress" style="height:7px;">
                      <div class="progress-bar {{ c >= exp ? 'bg-success' : (isMissing ? 'bg-danger' : 'bg-warning') }}"
                          role="progressbar"
                          style="width: {{ pctDay|round(0,'floor') }}%;"
                          aria-valuenow="{{ pctDay|round(0,'floor') }}"
                          aria-label="Signatures du {{ j.date|date('d/m/Y') }}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          <details class="attendance-table mt-4">
            <summary><i class="bi bi-table" aria-hidden="true"></i> Afficher le récapitulatif détaillé <i class="bi bi-chevron-down" aria-hidden="true"></i></summary>

            <div class="table-responsive mt-2">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th style="min-width:180px;">Jour</th>
                    <th style="min-width:240px;">Signatures</th>
                    <th class="text-end" style="min-width:220px;">Statut</th>
                  </tr>
                </thead>
                <tbody>
                  {% for j in jours %}
                    {% set c = j.count ?? 0 %}
                    {% set exp = j.expected ?? 0 %}
                    {% set isMissing = j.isMissing ?? false %}
                    {% set dow = j.date|date('N') %}

                    <tr class="{{ isMissing ? 'table-danger' : '' }}">
                      <td>
                        <div class="fw-semibold">{{ j.date|date('d/m/Y') }}</div>
                        <div class="small text-muted">
                          <i class="bi bi-calendar3"></i> {{ dayNames[dow] ?? '' }}
                        </div>
                      </td>

                      <td>
                        {% if exp > 0 %}
                          {% if isMissing %}
                            <span class="chip" style="border-color: rgba(220,53,69,.35); background: rgba(220,53,69,.12); color:#dc3545;">
                              <i class="bi bi-exclamation-triangle"></i>
                              {{ c }} / {{ exp }} - incomplet
                            </span>
                          {% elseif c >= exp %}
                            <span class="chip" style="border-color: rgba(25,135,84,.25); background: rgba(25,135,84,.10); color:#198754;">
                              <i class="bi bi-check2-circle"></i>
                              {{ c }} / {{ exp }} - complet
                            </span>
                          {% else %}
                            <span class="chip" style="color: var(--muted);">
                              <i class="bi bi-hourglass-split"></i>
                              {{ c }} / {{ exp }} - en cours
                            </span>
                          {% endif %}
                        {% else %}
                          {% if (j.isPast ?? false) and c == 0 %}
                            <span class="chip" style="border-color: rgba(220,53,69,.35); background: rgba(220,53,69,.12); color:#dc3545;">
                              <i class="bi bi-exclamation-triangle"></i>
                              0 - aucun émargement
                            </span>
                          {% elseif c > 0 %}
                            <span class="chip" style="border-color: rgba(25,135,84,.25); background: rgba(25,135,84,.10); color:#198754;">
                              <i class="bi bi-check2-circle"></i>
                              {{ c }} signature{{ c > 1 ? 's' : '' }}
                            </span>
                          {% else %}
                            <span class="chip" style="color: var(--muted);">
                              <i class="bi bi-dash-circle"></i>
                              0 signature
                            </span>
                          {% endif %}
                        {% endif %}
                      </td>

                      <td class="text-end">
                        {% if isMissing %}
                          <span class="badge text-bg-danger-subtle text-danger-emphasis">Manquant</span>
                        {% elseif exp > 0 and c >= exp %}
                          <span class="badge text-bg-success-subtle text-success-emphasis">Complet</span>
                        {% elseif (j.isPast ?? false) and c == 0 %}
                          <span class="badge text-bg-secondary-subtle text-secondary-emphasis">Aucun</span>
                        {% else %}
                          <span class="badge text-bg-warning-subtle text-warning-emphasis">En cours</span>
                        {% endif %}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </details>

        {% endif %}
      </div>
    </div>
  </div>
</div>

</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      function nowLabel(){
        const d = new Date();
        return d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
      }
      const el = document.getElementById('hero-last-refresh');
      if (el) el.textContent = 'Consulté le ' + nowLabel();
    });
  </script>
{% endblock %}
