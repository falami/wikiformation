{% extends 'base_admin.html.twig' %}
{% block title %}Justificatifs · {{ session.code }}{% endblock %}
{% block stylesheets %}{{ parent() }}
<style>
.evidence{--ink:var(--theme-color-principal,#233342);--accent:var(--theme-color-secondaire,#ffc107);--line:color-mix(in srgb,var(--ink) 13%,white);--soft:color-mix(in srgb,var(--ink) 4%,white);max-width:1440px;margin:auto;padding:32px 26px 70px;color:var(--ink)}
.evidence *{box-sizing:border-box}.evidence-back{display:inline-flex;gap:9px;align-items:center;color:var(--ink);font-size:13px;font-weight:650;text-decoration:none;margin-bottom:24px}.evidence-hero{display:flex;justify-content:space-between;align-items:center;gap:30px;background:linear-gradient(120deg,var(--ink),color-mix(in srgb,var(--ink) 85%,var(--accent)));border-radius:24px;border-top:3px solid var(--accent);padding:34px 38px;color:white;margin-bottom:26px}.evidence-kicker{font-size:10px;letter-spacing:2px;font-weight:750;margin-bottom:12px;text-transform:uppercase}.evidence-hero .evidence-kicker{color:var(--accent)}.evidence h1{font-size:clamp(26px,2.6vw,38px);font-weight:750;letter-spacing:-1px;line-height:1.2;margin:0 0 14px}.evidence-hero p{margin:0;color:#ffffffc9;font-size:14px}.evidence-brand{display:flex;align-items:center;gap:12px;flex-shrink:0;padding:14px 18px;border:1px solid #ffffff25;border-radius:16px;background:#ffffff0a;max-width:320px}.evidence-brand img{width:54px;height:54px;object-fit:contain;background:white;padding:5px;border-radius:12px}.evidence-brand small{display:block;font-size:10px;color:#ffffffb0;margin-bottom:4px}.evidence-brand strong{font-size:14px}.evidence-note{display:flex;align-items:flex-start;gap:14px;padding:20px 24px;background:var(--soft);border:1px solid var(--line);border-radius:16px;margin-bottom:26px;font-size:13px;line-height:1.7}.evidence-note>i{font-size:22px}.evidence-note strong{display:block;margin-bottom:3px}.evidence-note p{margin:0;color:color-mix(in srgb,var(--ink) 72%,white)}.evidence-layout{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:24px;align-items:start}.evidence-card{border:1px solid var(--line);border-radius:20px;background:white;box-shadow:0 8px 28px #21354706;overflow:hidden}.evidence-heading{display:flex;align-items:center;gap:12px;padding:23px 26px;border-bottom:1px solid var(--line)}.evidence-heading>i{display:grid;place-items:center;width:40px;height:40px;background:var(--soft);border-radius:11px;font-size:20px}.evidence h2{font-size:19px;letter-spacing:-.3px;font-weight:700;margin:0}.evidence-heading small{display:block;color:#728393;font-size:12px;margin-top:4px}.evidence-count{margin-left:auto;background:var(--soft);border:1px solid var(--line);padding:4px 10px;border-radius:8px;font-size:12px;font-weight:700}.evidence-form{padding:26px}.evidence-label{display:block;font-size:13px;font-weight:650;margin-bottom:9px}.evidence-select{width:100%;padding:13px 16px;border-radius:11px;border:1px solid var(--line);color:var(--ink);background-color:white;margin-bottom:24px;font-size:14px}.evidence-upload{padding:26px 20px;text-align:center;background:var(--soft);border:1px dashed color-mix(in srgb,var(--ink) 28%,white);border-radius:15px;margin-bottom:22px}.evidence-upload>i{display:block;font-size:30px;color:var(--ink);margin-bottom:12px}.evidence-upload p{color:#718393;font-size:12px;margin:8px 0 20px}.evidence-upload input{display:block;width:100%;font-size:12px;color:var(--ink)}.evidence-upload input::file-selector-button{border:1px solid var(--line);border-radius:9px;padding:10px 13px;background:white;color:var(--ink);font:inherit;font-weight:650;margin-right:10px;cursor:pointer}.evidence-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid var(--line);border-radius:11px;padding:11px 16px;color:var(--ink);background:white;font-size:13px;font-weight:700;text-decoration:none}.evidence-button:hover{background:var(--soft);color:var(--ink)}.evidence-submit{width:100%;background:var(--accent);border-color:var(--accent);color:#17212b}.evidence-submit:hover{background:color-mix(in srgb,var(--accent) 85%,white);color:#17212b}.evidence :is(a,button,input,select):focus-visible{outline:3px solid var(--accent);outline-offset:3px}.evidence-footnote{display:flex;justify-content:center;gap:7px;color:#718393;font-size:11px;margin:16px 0 0}.evidence-list{list-style:none;margin:0;padding:0}.evidence-document{display:flex;align-items:center;gap:13px;padding:21px 25px;border-bottom:1px solid var(--line)}.evidence-document:last-child{border-bottom:0}.evidence-document>i{font-size:23px;color:#718393}.evidence-document-name{flex:1;font-size:13px;font-weight:650;overflow-wrap:anywhere}.evidence-document-name small{display:block;font-size:11px;color:#718393;font-weight:400;margin-top:4px}.evidence-empty{text-align:center;padding:52px 30px}.evidence-empty>i{display:grid;place-items:center;width:60px;height:60px;margin:0 auto 18px;border-radius:18px;background:var(--soft);font-size:27px;color:#718393}.evidence-empty strong{display:block;font-size:15px;margin-bottom:8px}.evidence-empty p{font-size:13px;color:#718393;max-width:300px;margin:0 auto;line-height:1.7}
@media(max-width:1100px){.evidence-layout{grid-template-columns:1fr}.evidence-hero{align-items:flex-start}.evidence-brand{max-width:240px}}@media(max-width:650px){.evidence{padding:20px 12px 50px}.evidence-hero{flex-direction:column;padding:26px 23px}.evidence-brand{max-width:100%;width:100%}.evidence-heading,.evidence-form{padding:20px}.evidence-document{flex-wrap:wrap;padding:20px}.evidence-document .evidence-button{margin-left:auto}.evidence-note{padding:18px}}
</style>
{% endblock %}
{% block body %}
<div class="evidence">
  <a class="evidence-back" href="{{ path('app_formateur_dashboard', {entite:entite.id}) }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Retour au tableau de bord</a>
  <header class="entity-hero evidence-hero"><div><div class="evidence-kicker">ESPACE FORMATEUR · DOSSIER DE SESSION</div><h1>Justificatifs de sous-traitance</h1><p>{{ session.code }} · {{ session.formationIntituleLibre ?: session.formation.titre|default('Formation') }}</p></div><div class="evidence-brand">{% if entite.logo %}<img src="{{ asset('uploads/photos/entite/logo/' ~ entite.logo) }}" alt="Logo {{ entite.nom }}">{% else %}<i class="bi bi-building fs-2" aria-hidden="true"></i>{% endif %}<div><small>VOTRE ORGANISME</small><strong>{{ entite.nom }}</strong></div></div></header>
  {% include 'flagMessage.html.twig' %}
  <div class="evidence-note"><i class="bi bi-info-circle" aria-hidden="true"></i><div><strong>Centralisez les documents de votre intervention.</strong><p>Les émargements et les appréciations sont gérés par le donneur d’ordre. Déposez les documents reçus pour les conserver dans le dossier de cette session.</p></div></div>
  <div class="evidence-layout">
    <section class="evidence-card" aria-labelledby="deposit-title"><header class="evidence-heading"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i><div><h2 id="deposit-title">Déposer un justificatif</h2><small>Ajoutez un document au dossier de la session.</small></div></header>
      <form class="evidence-form" method="post" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token('trainer_paper_' ~ session.id) }}"><input type="hidden" name="action" value="upload">
        <label class="evidence-label" for="evidenceType">Type de document</label><select class="evidence-select form-select" id="evidenceType" name="type" required><option value="emargement_signe">Émargements signés</option><option value="satisfaction_stagiaire">Appréciations stagiaires</option><option value="satisfaction_formateur">Appréciation formateur</option></select>
        <div class="evidence-upload"><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i><label class="evidence-label" for="evidenceFile">Sélectionnez votre document</label><p id="evidenceFileHelp">PDF, JPG ou PNG · 15 Mo maximum par document</p><input id="evidenceFile" type="file" name="file" accept="application/pdf,image/jpeg,image/png" aria-describedby="evidenceFileHelp" required></div>
        <button class="evidence-button evidence-submit" type="submit"><i class="bi bi-archive" aria-hidden="true"></i> Archiver le document</button><p class="evidence-footnote"><i class="bi bi-folder-check" aria-hidden="true"></i> Le document sera rattaché à cette session.</p>
      </form>
    </section>
    <section class="evidence-card" aria-labelledby="archive-title"><header class="evidence-heading"><i class="bi bi-folder2-open" aria-hidden="true"></i><div><h2 id="archive-title">Documents archivés</h2><small>Retrouvez les justificatifs déjà déposés.</small></div><span class="evidence-count">{{ pieces|length }}</span></header>
      <ul class="evidence-list">{% for piece in pieces %}<li class="evidence-document"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><div class="evidence-document-name">{{ piece.type.label }}<small>Justificatif de la session {{ session.code }}</small></div><a class="evidence-button" href="{{ path('app_formateur_paper_document',{entite:entite.id,id:session.id,piece:piece.id}) }}" aria-label="Consulter : {{ piece.type.label }}"><i class="bi bi-eye" aria-hidden="true"></i> Consulter</a></li>{% else %}<li class="evidence-empty"><i class="bi bi-folder2" aria-hidden="true"></i><strong>Votre dossier est prêt à être complété.</strong><p>Aucun justificatif pour le moment. Les documents déposés apparaîtront ici.</p></li>{% endfor %}</ul>
    </section>
  </div>
</div>
{% endblock %}
