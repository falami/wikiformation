{% extends 'formateur/profile/base.html.twig' %}
{% block title %}{{ trainer.utilisateur.prenom }} {{ trainer.utilisateur.nom }} · CV{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/trainer-cv.css') ~ '?v=2' }}">{% endblock %}
{% block body %}<div class="resume-shell">
<div class="resume-toolbar"><span>PROFIL PROFESSIONNEL · {{ entite.nom }}</span>{% if private %}<span>{{ cv.published ? 'Version publiée disponible' : 'Profil privé' }}</span>{% endif %}</div>
<article class="resume"><header class="resume-hero"><div class="resume-monogram">{% if photo %}<img src="{{ asset(photo) }}" alt="{{ trainer.utilisateur.prenom }} {{ trainer.utilisateur.nom }}">{% else %}{{ trainer.utilisateur.prenom|first }}{{ trainer.utilisateur.nom|first }}{% endif %}</div><div><div class="resume-eyebrow"><span></span> LE SAVOIR SE TRANSMET</div><h1>{{ trainer.utilisateur.prenom }}<br><strong>{{ trainer.utilisateur.nom }}</strong></h1><p class="resume-title">{{ content.headline|default('Formateur professionnel',true) }}</p></div><div class="resume-mark" aria-hidden="true">{{ trainer.utilisateur.prenom|first }}{{ trainer.utilisateur.nom|first }}<span>PARCOURS &amp; EXPERTISE</span></div></header>
<nav class="resume-index" aria-label="Rubriques du CV"><span>Explorer le parcours</span>{% for key in ['summary','experience','education','methods'] %}{% if content[key]|default('') %}<a href="#resume-{{ key }}">{{ fields[key] }}</a>{% endif %}{% endfor %}</nav><div class="resume-layout"><aside class="resume-sidebar"><section><h2>Domaines d’intervention</h2><div class="resume-tags">{% for subject in subjects %}<span>{{ subject }}</span>{% else %}<p class="resume-muted">Matières à compléter.</p>{% endfor %}</div></section>{% for key in ['skills','languages'] %}{% if content[key]|default('') %}<section><h2>{{ fields[key] }}</h2><p class="resume-text">{{ content[key] }}</p></section>{% endif %}{% endfor %}<div class="resume-signature">{{ trainer.utilisateur.prenom }} {{ trainer.utilisateur.nom }}<small>Un parcours au service de la formation.</small></div></aside>
<main class="resume-main">{% set number=0 %}{% for key in ['summary','experience','education','methods'] %}{% if content[key]|default('') %}{% set number=number+1 %}<section id="resume-{{ key }}" class="resume-section resume-section--{{ key }}"><div class="resume-section-heading"><span>0{{ number }}</span><h2>{{ fields[key] }}</h2></div>{% for paragraph in content[key]|split('\n\n') %}<div class="resume-entry"><p class="resume-text">{{ paragraph }}</p></div>{% endfor %}</section>{% endif %}{% endfor %}{% if not content %}<section><h2>Un parcours à découvrir</h2><p class="resume-muted">Le formateur n’a pas encore complété son CV en ligne. Ses matières et ses justificatifs disponibles sont présentés sur cette fiche.</p></section>{% endif %}</main></div><footer class="resume-footer"><span>{{ entite.nom }}</span><span>PROFIL FORMATEUR</span></footer></article>
{% if private %}<section class="tp-card resume-documents mt-4"><h2 class="h5">Documents professionnels · accès privé</h2>{% if cv.filename %}<a class="btn btn-light my-2" href="{{ path('app_trainer_cv_download',{entite:entite.id,id:trainer.id}) }}"><i class="bi bi-file-earmark-pdf me-2"></i>Télécharger le CV original</a>{% else %}<p class="text-muted">Aucun CV PDF déposé.</p>{% endif %}{% for diploma in diplomas %}<div class="tp-file"><strong>{{ diploma.title }}</strong><a class="btn btn-outline-secondary btn-sm" href="{{ path('app_trainer_diploma_download',{entite:entite.id,id:diploma.id}) }}">Télécharger le justificatif</a></div>{% else %}<p class="text-muted">Aucun justificatif de diplôme déposé.</p>{% endfor %}</section>{% endif %}</div>{% endblock %}
