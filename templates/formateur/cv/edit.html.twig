{% extends 'formateur/profile/base.html.twig' %}
{% block title %}Mon CV professionnel{% endblock %}
{% block body %}
{% set token = csrf_token('trainer_cv_' ~ trainer.id) %}
<div class="tp"><header class="tp-hero"><div class="tp-kicker">VOTRE PARCOURS · VOTRE EXPERTISE</div><h1>Mon CV professionnel</h1><p>Un profil à votre image, qui évolue avec vos expériences.</p><div class="mt-3 d-flex gap-2"><a class="btn btn-light" href="{{ path('app_trainer_cv_preview',{entite:entite.id}) }}">Voir mon CV</a><a class="btn btn-outline-light" href="{{ path('app_formateur_profile',{entite:entite.id}) }}">Matières et diplômes</a></div></header>
{% for kind,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ kind }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
<div class="tp-grid"><div><form method="post" class="tp-card"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="version" value="{{ cv.version }}"><h2>Composez votre profil</h2><p class="tp-help">Séparez vos expériences par une ligne vide. Indiquez les dates, votre rôle, l’organisme et vos réalisations.</p>
{% for key,label in fields %}<label for="cv-{{ key }}">{{ label }}</label>{% if key=='headline' %}<input id="cv-{{ key }}" class="form-control" name="cv[{{ key }}]" maxlength="180" value="{{ cv.content[key]|default('') }}" placeholder="Ex. Formateur en bureautique et outils collaboratifs">{% else %}<textarea id="cv-{{ key }}" class="form-control" name="cv[{{ key }}]" rows="{{ key in ['experience','education'] ? 7 : 4 }}" maxlength="12000">{{ cv.content[key]|default('') }}</textarea>{% endif %}{% endfor %}
<div class="mt-4 d-flex gap-2 flex-wrap"><button class="btn btn-primary" name="action" value="save">Enregistrer le brouillon</button><button class="btn btn-outline-primary" name="action" value="publish">Enregistrer et publier aux stagiaires</button></div><p class="tp-help mt-3">Seules les rubriques publiées et vos matières sont visibles aux stagiaires de vos sessions. Le PDF original et les justificatifs restent privés. Enregistrer un brouillon ne modifie pas la version publiée.</p></form></div>
<aside><section class="tp-card"><h2>Partir de votre CV existant</h2><p class="tp-help">Préremplissez gratuitement votre CV à partir du texte de votre PDF, sans envoi à un service externe. Relisez ensuite chaque rubrique. Les scans et les mises en page complexes peuvent nécessiter une saisie manuelle.</p>
{% if cv.filename %}<a class="btn btn-light mb-3" href="{{ path('app_trainer_cv_download',{entite:entite.id,id:trainer.id}) }}"><i class="bi bi-file-earmark-pdf me-2"></i>{{ cv.originalName }}</a>{% endif %}
<form method="post" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="version" value="{{ cv.version }}"><label for="cv-file">CV PDF · 10 Mo et 20 pages maximum</label><input id="cv-file" class="form-control" type="file" name="cvFile" accept="application/pdf" required>
<label class="d-flex gap-2 mt-3"><input type="checkbox" name="analyze" value="1" checked>Préparer une proposition gratuite depuis le texte du PDF.</label><button class="btn btn-primary mt-3" name="action" value="upload">Déposer mon CV</button></form>
{% if cv.filename %}<form method="post" class="mt-3"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="version" value="{{ cv.version }}"><button class="btn btn-outline-primary" name="action" value="analyze">Préremplir gratuitement depuis ce PDF</button></form>{% endif %}</section>
{% if cv.suggestion %}<section class="tp-card"><h2>Proposition à relire</h2><p class="tp-help">Extraction automatique sans IA : vérifiez les dates, les intitulés et retirez toute information personnelle. Les champs non reconnus restent vides. Reprendre cette proposition remplacera les rubriques du brouillon, sans modifier la version publiée.</p>{% for key,label in fields %}{% if cv.suggestion[key]|default('') %}<h3 class="h6 mt-3">{{ label }}</h3><p style="white-space:pre-line">{{ cv.suggestion[key] }}</p>{% endif %}{% endfor %}<form method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="version" value="{{ cv.version }}"><button class="btn btn-primary" name="action" value="accept">Reprendre dans mon brouillon</button><button class="btn btn-light mt-2" name="action" value="dismiss">Écarter la proposition</button></form></section>{% endif %}
<section class="tp-card"><h2>Visibilité</h2><p>{{ cv.published ? 'Une version est publiée pour les stagiaires de vos sessions.' : 'Votre CV est privé : vous et les administrateurs pouvez le consulter.' }}</p>{% if cv.published %}<form method="post"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="version" value="{{ cv.version }}"><button class="btn btn-outline-secondary" name="action" value="unpublish">Retirer la publication</button></form>{% endif %}</section></aside></div></div>
{% endblock %}
