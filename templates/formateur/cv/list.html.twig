{% extends 'formateur/profile/base.html.twig' %}{% block title %}Mes formateurs{% endblock %}{% block body %}<div class="tp"><header class="tp-hero"><div class="tp-kicker">VOTRE ÉQUIPE PÉDAGOGIQUE</div><h1>Découvrez vos formateurs</h1><p>{{ session.code }}</p></header><div class="tp-grid">{% for row in rows %}<section class="tp-card"><h2>{{ row.trainer.utilisateur.prenom }} {{ row.trainer.utilisateur.nom }}</h2><p>{{ row.cv.published.headline }}</p><a class="btn btn-primary" href="{{ path('app_learner_trainer_cv',{entite:entite.id,session:session.id,id:row.trainer.id}) }}">Découvrir le parcours</a></section>{% else %}<section class="tp-card">Les profils de vos formateurs ne sont pas encore publiés.</section>{% endfor %}</div></div>{% endblock %}
