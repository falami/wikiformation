{# Shared by training and success certificates. Keep long objectives pageable. #}
<section class="training-objectives" style="margin:18px 0; color:#253847; overflow-wrap:break-word; word-wrap:break-word;">
  <h3 style="font-size:13px; margin:0 0 8px; page-break-after:avoid;">Objectifs pédagogiques de la formation</h3>
  {% set objectiveText = objectives|default('')|trim %}
  {% if objectiveText %}
    <div style="font-size:11px; line-height:1.55;">{{ objectiveText|nl2br }}</div>
  {% else %}
    <p style="font-size:11px; color:#647787;">Objectifs non renseignés dans la fiche formation.</p>
  {% endif %}
</section>
