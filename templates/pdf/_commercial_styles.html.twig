<style>
  @page { margin: 15mm 15mm 12mm; size: A4 portrait; }
  body { font-family:'DejaVu Sans',sans-serif; color:#243746; font-size:10.5px; line-height:1.5; margin:0; }
  h1,h2,h3,p { margin:0; padding:0; }
  table { width:100%; border-collapse:collapse; }
  td,th { vertical-align:top; padding:6px 8px; }
  .header { margin-bottom:18px; }
  .header td { padding:0; }
  .header .left { width:53%; padding:5px 25px 0 0; }
  .header .right { width:47%; padding:14px 20px; background:#18313f; border-top:3px solid #b49b6d; text-align:left; }
  .brand-name { font-size:17px; font-weight:bold; color:#18313f; line-height:1.3; }
  .brand-meta { font-size:8.5px; color:#5c6f7c; line-height:1.6; margin-top:9px; }
  .brand-meta strong { color:#18313f; font-size:10px; }
  .logo { max-height:57px; max-width:150px; width:auto; }
  .issuer-header td { padding:0; }
  .issuer-header .issuer-logo { width:57px; padding-right:10px; }
  .issuer-header .logo { max-width:52px; max-height:57px; }
  .issuer-header .brand-meta { margin:0; }
  .issuer-header .brand-name { font-size:11px; }
  .doc-kicker { font-size:6.5px; letter-spacing:1.5px; font-weight:bold; color:#dbc8a5; margin-bottom:6px; }
  .doc-badge { font-family:'DejaVu Serif',serif; font-size:33px; font-weight:normal; line-height:1.2; color:#fff; letter-spacing:-1px; }
  .doc-meta { font-size:8px; color:#d6e0e5; line-height:1.65; margin-top:6px; }
  .doc-meta strong { font-weight:normal; }
  .doc-number { font-size:10px; font-weight:bold; color:#fff; margin-bottom:5px; letter-spacing:.3px; }
  .stamp { display:inline-block; font-size:6px; font-weight:bold; letter-spacing:1px; padding:3px 7px; margin-top:6px; color:#e6d2ac; border:1px solid #697973; }
  .stamp-paid { color:#c7e4d3; }.stamp-canceled { color:#ffd0c4; }
  .head { margin-bottom:12px; table-layout:fixed; }
  .head td { padding:11px 13px; font-size:9.5px; line-height:1.55; }
  .head .titre { text-align:left; font-size:6.5px; letter-spacing:1.25px; font-weight:bold; color:#697e8a; padding:0 0 8px; border-bottom:1px solid #dce4e9; }
  .head .information-cell { padding:12px 0 0; }
  .head .customer-cell { padding:12px 0 0; }
  .head strong,.customer-name { color:#18313f; font-weight:bold; }
  .customer-name { font-size:12px; line-height:1.4; margin-bottom:5px; }
  .rule { height:0; margin:0; }
  .section-caption { font-size:7px; font-weight:bold; letter-spacing:1.4px; color:#937b50; margin:14px 0 9px; text-transform:uppercase; }
  .lines-table { table-layout:fixed; }
  .lines-table thead { display:table-header-group; }
  .lines-table th { text-align:left; background:#fff; color:#697e8a; font-size:7px; font-weight:bold; text-transform:uppercase; letter-spacing:.45px; padding:8px; border-top:1px solid #dce4e9; border-bottom:2px solid #b49b6d; }
  .lines-table th.num { text-align:right; }
  .lines-table td { font-size:10.2px; }
  .lines-table tr { page-break-inside:avoid; }
  .lines-table .line-main { page-break-after:avoid; }
  .lines-table .line-main td,.lines-table .line-end td { padding:11px 8px 9px; border-top:1px solid #e2e8ec; background:#f3f6f8; }
  .line-title { font-weight:bold; color:#18313f; overflow-wrap:break-word; word-wrap:break-word; }
  .line-index { font-size:7px; color:#947b4c; font-weight:bold; }
  .line-discount { color:#617280; font-size:7.5px; font-weight:normal; margin-top:4px; }
  .num { text-align:right; white-space:nowrap; }
  .lines-table .detail-row td { padding:2px 16px 1px 12px; border-top:none; background:#fff; }
  .detail-text { word-wrap:break-word; color:#536875; font-size:10px; line-height:1.5; }
  .detail-bullet { color:#b49b6d; }
  .lines-table .detail-row.line-end td { padding:2px 16px 10px 12px; border-top:none; background:#fff; }
  .muted,.ref { color:#718592; font-size:8px; }
  .closing-layout { margin-top:23px; page-break-inside:avoid; }
  .closing-layout > tbody > tr > td,.closing-layout > tr > td { padding:0; }
  .closing-notes { width:42%; padding:0 22px 0 0 !important; }
  .closing-totals { width:58%; padding:0 !important; }
  .closing-caption { font-size:7px; font-weight:bold; letter-spacing:1px; color:#937b50; margin-bottom:8px; }
  .closing-copy { font-size:8.5px; line-height:1.65; color:#617280; }
  .closing-copy strong { color:#243746; }
  .totaux { width:100%; margin:0; page-break-inside:avoid; }
  .totaux td { font-size:9px; padding:7px 11px; border-bottom:1px solid #e3e9ed; }
  .totaux .label { text-align:left; color:#617280; width:56%; }
  .totaux .val { text-align:right; white-space:nowrap; width:44%; }
  .totaux .total { background:#18313f; color:#fff; padding:16px 11px; border-top:2px solid #b49b6d; border-bottom:0; vertical-align:middle; }
  .totaux .total.label { font-size:8px; font-weight:bold; letter-spacing:.4px; }
  .totaux .total.val { font-size:19px; font-weight:bold; letter-spacing:-.5px; }
  .end-block,.footer-wrapper { margin-top:16px; }
  .footer-note { color:#617280; font-size:8px; margin:8px 0; }
  .footer-panel,.footer-banque { border-top:1px solid #b49b6d; border-bottom:1px solid #dce5eb; padding:10px 0; background:#fff; page-break-inside:avoid; }
  .footer-grid td { padding:0 12px; font-size:7.5px; color:#536875; line-height:1.65; }
  .footer-grid .issuer-cell { padding-left:0; }
  .issuer-cell { width:43%; border-right:1px solid #dce5eb; }
  .bank-cell { width:57%; }
  .footer-caption,.footer-banque-title { font-size:6.5px; font-weight:bold; letter-spacing:1px; color:#937b50; margin-bottom:7px; }
  .footer-name { font-size:9px; font-weight:bold; color:#18313f; margin-bottom:5px; }
  .bank-iban { font-size:9px; color:#18313f; margin-bottom:4px; letter-spacing:.25px; }
  .footer-reference { border-top:1px solid #e3e9ed; padding-top:8px; margin-top:11px; font-size:7px; color:#617280; }
  .payment-terms { margin-top:22px; border-top:1px solid #dce5eb; padding-top:11px; font-size:7.5px; line-height:1.6; color:#617280; }
  .payment-terms-title { font-weight:bold; font-size:6.5px; color:#937b50; letter-spacing:1px; margin-bottom:7px; }
  .payment-terms p { margin-bottom:4px; }
  .note { font-size:7.5px; margin-top:9px; color:#617280; }
  .acceptance { padding:4px 0; }
  .acceptance-title { font-size:7px; font-weight:bold; letter-spacing:1px; color:#937b50; margin-bottom:8px; }
  .acceptance p { font-size:8px; color:#617280; line-height:1.7; }
  .signature-space { height:50px; border-bottom:1px solid #cdd8df; margin-top:8px; }
  .signature-label { margin-top:6px; font-size:6.5px; letter-spacing:.4px; color:#81919c; }
  .draft-watermark { position:fixed; top:42%; left:0; width:100%; text-align:center; font-size:34px; font-weight:bold; color:#e4e9ed; transform:rotate(-28deg); z-index:-1; }
  .draft-banner { border:1px solid #d5b976; background:#fff8e7; color:#6f5420; padding:9px 12px; text-align:center; font-size:9px; font-weight:bold; margin-bottom:15px; }
</style>
