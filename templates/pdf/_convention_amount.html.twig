            {% if convention and convention.montantHtCents is not null %}
              <div class="info-block mb-0">
                <span class="info-label">Montant de la convention</span>
                <div class="info-content">
                  HT : {{ (convention.montantHtCents / 100)|number_format(2, ',', ' ') }} {{ devis ? devis.devise : 'EUR' }}<br>
                  TVA ({{ convention.tauxTva }} %) : {{ (convention.montantTvaCents / 100)|number_format(2, ',', ' ') }} {{ devis ? devis.devise : 'EUR' }}<br>
                  TTC : {{ (convention.montantTtcCents / 100)|number_format(2, ',', ' ') }} {{ devis ? devis.devise : 'EUR' }}
                </div>
              </div>
            {% elseif devis %}
              <div class="info-block mb-0">
                <span class="info-label">Total du devis {{ devis.numero }}</span>
                <div class="info-content">
                  HT : {{ (devis.montantHtCents / 100)|number_format(2, ',', ' ') }} {{ devis.devise }}<br>
                  TVA : {{ (devis.montantTvaCents / 100)|number_format(2, ',', ' ') }} {{ devis.devise }}<br>
                  TTC : {{ (devis.montantTtcCents / 100)|number_format(2, ',', ' ') }} {{ devis.devise }}
                </div>
              </div>
            {% elseif session %}
              {% set sessionHt = session.estimatePriceForParticipants(convention ? convention.effectifTotal : 1) %}
              {% set sessionTva = (sessionHt * session.tauxTvaEffectif / 100)|round %}
              <div class="info-block mb-0">
                <span class="info-label">Montant de la convention — tarif de la session</span>
                <div class="info-content">
                  HT : {{ (sessionHt / 100)|number_format(2, ',', ' ') }} EUR<br>
                  TVA ({{ session.tauxTvaEffectif }} %) : {{ (sessionTva / 100)|number_format(2, ',', ' ') }} EUR<br>
                  TTC : {{ ((sessionHt + sessionTva) / 100)|number_format(2, ',', ' ') }} EUR
                </div>
              </div>
            {% endif %}