{% set brand = {
  primary:   entite.couleurPrincipal  |default('#1e3a5f'),
  secondary: entite.couleurSecondaire |default('#4ba3ff'),
  accent:    entite.couleurSecondaire |default('#c9903a'),
  ink:       '#0d1f30',
  text:      '#1c2b3a',
  muted:     '#5c6e7e',
  line:      '#dae2eb',
  soft:      '#f5f8fb',
  paper:     '#ffffff',
  canvas:    '#f0f5f9'
} %}

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>Programme — {{ formation.titre }}</title>

  <style>
    /* ── Page ──────────────────────────────────────────────── */
    @page {
      margin: 12mm 12mm 10mm 12mm;
      size: A4 portrait;
    }

    /* ── Base ──────────────────────────────────────────────── */
    * { box-sizing: border-box; }

    body {
      font-family: DejaVu Sans, Helvetica, Arial, sans-serif;
      color: {{ brand.text }};
      font-size: 10pt;
      line-height: 1.5;
      background: {{ brand.paper }};
    }

    p { margin: 0 0 7pt; }
    p:last-child { margin-bottom: 0; }
    strong { color: {{ brand.ink }}; font-weight: 700; }
    ul { margin: 3pt 0 7pt 14pt; padding: 0; }
    li { margin: 0 0 3pt; }

    /* ── Utilities ─────────────────────────────────────────── */
    .sr-only { display: none; }
    .text-muted { color: {{ brand.muted }}; }
    .text-small { font-size: 8.5pt; }
    .mb-0 { margin-bottom: 0 !important; }
    .mt-6  { margin-top: 6pt !important; }
    .mt-10 { margin-top: 10pt !important; }
    .mt-14 { margin-top: 14pt !important; }

    /* ── Layout ────────────────────────────────────────────── */
    .page { padding: 0; }

    .tbl { width: 100%; border-collapse: collapse; }
    .tbl td { vertical-align: top; }

    /* ── Header ────────────────────────────────────────────── */
    .header {
      width: 100%;
      padding-bottom: 12pt;
      margin-bottom: 14pt;
      border-bottom: 2pt solid {{ brand.primary }};
      page-break-inside: avoid;
    }

    .header-left  { width: 65%; padding-right: 14pt; }
    .header-right { width: 35%; text-align: right; padding-top: 6pt; }

    .logo {
      height: 64pt;
      width: auto;
      margin-bottom: 8pt;
      display: block;
    }

    .org-name {
      font-size: 16pt;
      font-weight: 800;
      color: {{ brand.primary }};
      letter-spacing: -.3pt;
      margin-bottom: 5pt;
    }

    .org-meta {
      font-size: 8.5pt;
      color: {{ brand.muted }};
      line-height: 1.5;
    }
    .org-meta p { margin: 0 0 2pt; }

    .doc-pill {
      display: inline-block;
      background: {{ brand.primary }};
      color: #fff;
      font-size: 9.5pt;
      font-weight: 800;
      letter-spacing: 1pt;
      text-transform: uppercase;
      padding: 6pt 11pt;
      border-radius: 4pt;
      margin-bottom: 10pt;
    }

    .doc-meta {
      font-size: 8.5pt;
      color: {{ brand.muted }};
      line-height: 1.6;
    }
    .doc-meta strong { color: {{ brand.ink }}; }

    /* ── Hero ──────────────────────────────────────────────── */
    .hero {
      background: {{ brand.primary }};
      border-radius: 8pt;
      padding: 18pt 20pt 16pt;
      margin-bottom: 12pt;
      page-break-inside: avoid;
    }

    .hero-label {
      font-size: 7.5pt;
      font-weight: 800;
      letter-spacing: 1.2pt;
      text-transform: uppercase;
      color: rgba(255,255,255,.6);
      margin-bottom: 6pt;
    }

    .hero-title {
      font-size: 18pt;
      font-weight: 900;
      line-height: 1.2;
      color: #fff;
      margin-bottom: 10pt;
    }

    .hero-desc {
      font-size: 9.5pt;
      line-height: 1.6;
      color: rgba(255,255,255,.88);
      margin-bottom: 12pt;
    }

    .hero-chips { line-height: 1; }

    .chip {
      display: inline-block;
      padding: 3pt 8pt;
      border-radius: 999pt;
      background: rgba(255,255,255,.12);
      border: .75pt solid rgba(255,255,255,.2);
      color: #fff;
      font-size: 8pt;
      font-weight: 700;
      margin: 0 4pt 5pt 0;
    }

    /* ── Section heading ───────────────────────────────────── */
    .section-label {
      font-size: 7.5pt;
      font-weight: 800;
      letter-spacing: 1pt;
      text-transform: uppercase;
      color: {{ brand.primary }};
      margin: 0 0 10pt;
      padding-bottom: 5pt;
      border-bottom: .75pt solid {{ brand.line }};
    }

    /* ── Cards ─────────────────────────────────────────────── */
    .card {
      background: {{ brand.paper }};
      border: .75pt solid {{ brand.line }};
      border-left: 3pt solid {{ brand.primary }};
      border-radius: 6pt;
      padding: 12pt 14pt;
      margin-bottom: 10pt;
      page-break-inside: avoid;
    }

    .card-warm {
      background: {{ brand.soft }};
      border-left-color: {{ brand.accent }};
    }

    /* ── Info blocks ───────────────────────────────────────── */
    .grid-2 { width: 100%; border-collapse: collapse; margin-bottom: 2pt; }
    .grid-2 td { width: 50%; vertical-align: top; }
    .grid-2 td:first-child { padding-right: 8pt; }
    .grid-2 td:last-child  { padding-left:  8pt; }

    .info-block { margin-bottom: 9pt; }
    .info-block.last { margin-bottom: 0; }

    .info-label {
      display: block;
      font-size: 7.5pt;
      font-weight: 800;
      color: {{ brand.ink }};
      text-transform: uppercase;
      letter-spacing: .5pt;
      margin-bottom: 2.5pt;
    }

    .info-value {
      font-size: 9.5pt;
      color: {{ brand.text }};
      line-height: 1.5;
    }

    .badge {
      display: inline-block;
      padding: 1.5pt 6pt;
      border-radius: 999pt;
      background: rgba(75,163,255,.09);
      border: .75pt solid {{ brand.line }};
      color: {{ brand.ink }};
      font-size: 8pt;
      font-weight: 700;
      white-space: nowrap;
    }

    /* ── Programme ─────────────────────────────────────────── */
    .chapter {
      border: .75pt solid {{ brand.line }};
      border-left: 3pt solid {{ brand.accent }};
      border-radius: 6pt;
      padding: 11pt 13pt;
      margin-bottom: 9pt;
      background: {{ brand.paper }};
      page-break-inside: avoid;
    }

    .chapter-title {
      font-size: 10.5pt;
      font-weight: 900;
      color: {{ brand.ink }};
      margin-bottom: 4pt;
    }

    .chapter-meta {
      font-size: 8.5pt;
      color: {{ brand.muted }};
      margin-bottom: 5pt;
    }

    .richtext {
      font-size: 9.2pt;
      color: {{ brand.text }};
      line-height: 1.55;
      margin-top: 4pt;
    }

    .subchapter {
      margin-top: 9pt;
      padding: 8pt 10pt;
      background: {{ brand.canvas }};
      border-left: 2.5pt solid {{ brand.primary }};
      border-radius: 5pt;
      page-break-inside: avoid;
    }

    .subchapter-title {
      font-size: 9.5pt;
      font-weight: 800;
      color: {{ brand.ink }};
      margin-bottom: 4pt;
    }

    /* ── Empty state ───────────────────────────────────────── */
    .empty {
      font-size: 9pt;
      color: {{ brand.muted }};
      font-style: italic;
    }

    /* ── Footer ────────────────────────────────────────────── */
    .footer {
      margin-top: 14pt;
      padding-top: 8pt;
      border-top: .75pt solid {{ brand.line }};
      font-size: 8pt;
      color: {{ brand.muted }};
      line-height: 1.5;
    }
  </style>
</head>
<body>
<div class="page">

  {# ── HEADER ─────────────────────────────────────────────── #}
  <div class="header">
    <table class="tbl">
      <tr>
        <td class="header-left">
          {% if entite.logo %}
            <img class="logo"
                 src="{{ absolute_url(asset('uploads/photos/entite/logo/' ~ entite.logo)) }}"
                 alt="Logo {{ entite.nom|default('') }}">
          {% endif %}

          <div class="org-name">{{ entite.nom|default('') }}</div>

          <div class="org-meta">
            {% if entite.adresse %}<p>{{ entite.adresse }}</p>{% endif %}
            <p>
              {{ entite.codePostal|default('') }} {{ entite.ville|default('') -}}
              {% if entite.pays %} · {{ entite.pays }}{% endif %}
            </p>
            {% if entite.telephone or entite.email %}
              <p>
                {{ entite.telephone|default('') -}}
                {% if entite.telephone and entite.email %} · {% endif -%}
                {{ entite.email|default('') }}
              </p>
            {% endif %}
            {% if entite.siret or (entite.numeroDeclarant is defined and entite.numeroDeclarant) %}
              <p>
                {% if entite.siret %}SIRET : {{ entite.siret }}{% endif %}
                {% if entite.siret and entite.numeroDeclarant is defined and entite.numeroDeclarant %} · {% endif %}
                {% if entite.numeroDeclarant is defined and entite.numeroDeclarant %}NDA : {{ entite.numeroDeclarant }}{% endif %}
              </p>
            {% endif %}
          </div>
        </td>

        <td class="header-right">
          <div class="doc-pill">Programme complet</div>
          <div class="doc-meta">
            <div><strong>Date :</strong> {{ "now"|date('d/m/Y') }}</div>
            <div><strong>Réf. :</strong> #{{ formation.id }}</div>
            {% if formation.slug %}
              <div><strong>Slug :</strong> {{ formation.slug }}</div>
            {% endif %}
          </div>
        </td>
      </tr>
    </table>
  </div>

  {# ── HERO ────────────────────────────────────────────────── #}
  <div class="hero">
    <div class="hero-label">Formation</div>
    <div class="hero-title">{{ formation.titre }}</div>

    <div class="hero-desc">
      {% if formation.description %}
        {{ formation.description|striptags|raw }}
      {% else %}
        Programme détaillé — objectifs, public visé, prérequis, modalités pédagogiques et contenu.
      {% endif %}
    </div>

    <div class="hero-chips">
      {% if formation.niveau %}
        <span class="chip">Niveau : {{ formation.niveau.label() }}</span>
      {% endif %}
      {% if formation.duree %}
        <span class="chip">{{ formation.duree }} jour{% if formation.duree > 1 %}s{% endif %}</span>
      {% endif %}
      {% if formation.prixBaseCents %}
        <span class="chip">{{ (formation.prixBaseCents / 100)|number_format(2, ',', ' ') }} €</span>
      {% endif %}
      {% if formation.categorie %}
        <span class="chip">
          {% if formation.categorie.parent %}
            {{ formation.categorie.parent.nom }} / {{ formation.categorie.nom }}
          {% else %}
            {{ formation.categorie.nom }}
          {% endif %}
        </span>
      {% endif %}
    </div>
  </div>

  {# ── FICHE FORMATION ─────────────────────────────────────── #}
  <div class="card">
    <div class="section-label">Fiche formation</div>

    <table class="grid-2">
      <tr>
        <td>
          <div class="info-block">
            <span class="info-label">Intitulé</span>
            <div class="info-value">{{ formation.titre ?: '—' }}</div>
          </div>

          <div class="info-block">
            <span class="info-label">Niveau</span>
            <div class="info-value">{{ formation.niveau ? formation.niveau.label() : '—' }}</div>
          </div>

          <div class="info-block">
            <span class="info-label">Durée</span>
            <div class="info-value">
              {% if formation.duree %}
                {{ formation.duree }} jour{% if formation.duree > 1 %}s{% endif %}
              {% else %}—{% endif %}
            </div>
          </div>

          <div class="info-block last">
            <span class="info-label">Prix de base</span>
            <div class="info-value">
              {% if formation.prixBaseCents %}
                {{ (formation.prixBaseCents / 100)|number_format(2, ',', ' ') }} €
              {% else %}—{% endif %}
            </div>
          </div>
        </td>

        <td>
          <div class="info-block">
            <span class="info-label">Lieu</span>
            <div class="info-value">
              {% if formation.site %}
                <strong>{{ formation.site.nom|default('—') }}</strong><br>
                {{ formation.site.adresse|default('') }}<br>
                {{ (formation.site.codePostal|default('') ~ ' ' ~ formation.site.ville|default(''))|trim }}
              {% elseif formation.adresse or formation.ville %}
                {{ formation.adresse|default('') }}<br>
                {{ (formation.codePostal|default('') ~ ' ' ~ formation.ville|default(''))|trim }}
              {% else %}—{% endif %}
            </div>
          </div>

          <div class="info-block">
            <span class="info-label">Formateur</span>
            <div class="info-value">
              {% if formation.formateur and formation.formateur.utilisateur %}
                {{ formation.formateur.utilisateur.prenom ~ ' ' ~ formation.formateur.utilisateur.nom }}
              {% else %}—{% endif %}
            </div>
          </div>

          <div class="info-block">
            <span class="info-label">Financements</span>
            <div class="info-value">
              {% set financements = [] %}
              {% if formation.financementIndividuel %}{% set financements = financements|merge(['Individuel']) %}{% endif %}
              {% if formation.financementCpf       %}{% set financements = financements|merge(['CPF'])        %}{% endif %}
              {% if formation.financementEntreprise %}{% set financements = financements|merge(['Entreprise']) %}{% endif %}
              {% if formation.financementOpco       %}{% set financements = financements|merge(['OPCO'])       %}{% endif %}
              {{ financements is not empty ? financements|join(' · ') : '—' }}
            </div>
          </div>

          <div class="info-block last">
            <span class="info-label">Référence / note</span>
            <div class="info-value">{{ formation.note ?: (formation.codeQualiopi ?: '—') }}</div>
          </div>
        </td>
      </tr>
    </table>
  </div>

  {# ── OBJECTIFS ───────────────────────────────────────────── #}
  <div class="card card-warm">
    <div class="section-label">Objectifs pédagogiques</div>
    <div class="info-value">
      {{ formation.objectifs ? formation.objectifs|nl2br : '—' }}
    </div>
  </div>

  {# ── PUBLIC / PRÉREQUIS ──────────────────────────────────── #}
  <table class="grid-2">
    <tr>
      <td>
        <div class="card">
          <div class="section-label">Public concerné</div>
          <div class="info-value">
            {{ formation.public ? formation.public|nl2br : '—' }}
          </div>
        </div>
      </td>
      <td>
        <div class="card">
          <div class="section-label">Prérequis</div>
          <div class="info-value">
            {{ formation.conditionPrealable ? formation.conditionPrealable|nl2br : '—' }}
          </div>
        </div>
      </td>
    </tr>
  </table>

  {# ── MÉTHODES ────────────────────────────────────────────── #}
  <div class="card">
    <div class="section-label">Méthodes et moyens pédagogiques</div>
    <div class="info-value">
      {{ formation.pedagogie ? formation.pedagogie|nl2br : '—' }}
    </div>
  </div>

  {# ── MODALITÉS PRATIQUES ─────────────────────────────────── #}
  <div class="card">
    <div class="section-label">Modalités pratiques</div>
    <div class="info-value">
      {{ formation.modalitesPratiques ? formation.modalitesPratiques|nl2br : '—' }}
    </div>
  </div>

  {# ── MODALITÉS D'ÉVALUATION ──────────────────────────────── #}
  <div class="card">
    <div class="section-label">Modalités d'évaluation</div>
    <div class="info-value">
      {{ formation.modalitesEvaluation ? formation.modalitesEvaluation|nl2br : '—' }}
    </div>
  </div>

  {# ── PROGRAMME DÉTAILLÉ ──────────────────────────────────── #}
  <div class="card card-warm">
    <div class="section-label">Programme détaillé</div>

    {% if chapitres is not empty %}
      {% for chapitre in chapitres %}
        <div class="chapter">

          {# Titre du chapitre #}
          <div class="chapter-title">
            <span style="color:{{ brand.accent }};">{{ loop.index }}.</span>
            {{ chapitre.titre }}
            {% if chapitre.dureeMinutes %}
              <span class="badge" style="margin-left:5pt;">{{ chapitre.dureeMinutes }} min</span>
            {% endif %}
          </div>

          {# Blocs richtext du chapitre #}
          {% if chapitre.blocks is defined and chapitre.blocks|length > 0 %}
            {% for b in chapitre.blocks %}
              {% if b.type is defined and (b.type.value ?? b.type) == 'richtext' and b.content %}
                <div class="richtext">{{ b.content|raw }}</div>
              {% endif %}
            {% endfor %}
          {% endif %}

          {# Sous-chapitres #}
          {% set enfants = chapitre.children is defined ? chapitre.children : [] %}
          {% if enfants|length > 0 %}
            {% for sub in enfants %}
              {% if sub.isPublished %}
                <div class="subchapter">
                  <div class="subchapter-title">
                    {{ loop.parent.loop.index }}.{{ loop.index }} {{ sub.titre }}
                    {% if sub.dureeMinutes %}
                      <span class="badge" style="margin-left:5pt;">{{ sub.dureeMinutes }} min</span>
                    {% endif %}
                  </div>

                  {% if sub.blocks is defined and sub.blocks|length > 0 %}
                    {% for b in sub.blocks %}
                      {% if b.type is defined and (b.type.value ?? b.type) == 'richtext' and b.content %}
                        <div class="richtext">{{ b.content|raw }}</div>
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}

        </div>
      {% endfor %}
    {% else %}
      <p class="empty">Aucun contenu pédagogique publié pour cette formation.</p>
    {% endif %}
  </div>

  {# ── FOOTER ──────────────────────────────────────────────── #}
  <div class="footer">
    Document généré le {{ "now"|date('d/m/Y') }} — {{ entite.nom|default('') }}
    {% if entite.siret %} · SIRET {{ entite.siret }}{% endif %}
    {% if entite.numeroDeclarant is defined and entite.numeroDeclarant %} · NDA {{ entite.numeroDeclarant }}{% endif %}
  </div>

</div>
</body>
</html>
