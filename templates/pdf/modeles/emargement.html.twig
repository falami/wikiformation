{% extends 'pdf/modeles/base.html.twig' %}

{% block body_class %}compact-header emargement-document{% endblock %}

{% block extra_styles %}

  @page{
    margin:7mm 8mm 8mm;
  }

  .emargement-document .document-header{
    margin-bottom:5pt;
  }

  .emargement-document .document-title{
    font-size:15pt;
    margin-bottom:2pt;
  }

  .emargement-document .document-intro{
    font-size:7.5pt;
    margin-bottom:5pt;
  }

  .emargement-document .field-table{
    margin-bottom:4pt;
  }

  .emargement-document .field-table td{
    padding:4pt 6pt;
  }

  .emargement-document .field-label{
    font-size:6.5pt;
    margin-bottom:2pt;
  }

  .emargement-document .field-hint{
    font-size:6pt;
  }

  .emargement-document .write-line{
    height:8pt;
  }

  .emargement-document .section-title{
    margin:5pt 0 3pt;
    padding-bottom:3pt;
    font-size:8pt;
  }

  .emargement-document .section-accent{
    width:28pt;
  }

  .attendance th{
    height:19pt;
    padding:2pt 4pt;
    font-size:6.3pt;
  }

  .attendance td{
    height:18pt;
    padding:1pt 4pt;
    font-size:7pt;
  }

  .attendance .number{
    width:4%;
    text-align:center;
    color:#7d8a96;
  }

  .attendance .participant{
    width:25%;
  }

  .attendance .company{
    width:21%;
  }

  .attendance .signature-col{
    width:25%;
  }

  .schedule{
    margin:4pt 0;
  }

  .schedule td{
    border:1pt solid {{ brand.line }};
    background:{{ brand.soft }};
    padding:4pt 6pt;
    font-size:7pt;
    font-weight:700;
  }

  .trainer-table{
    margin-top:3pt;
  }

  .trainer-table td{
    height:37pt;
    padding:4pt 6pt;
  }

  .trainer-table .field-label{
    font-size:6.3pt;
  }

  .legal-note{
    margin-top:4pt;
    padding:4pt 6pt;
    background:{{ brand.soft }};
    border:1pt solid {{ brand.line }};
    border-radius:4pt;
    font-size:6.5pt;
    color:{{ brand.muted }};
  }

{% endblock %}


{% block document %}

  <h1 class="document-title">
    Feuille d’émargement
  </h1>

  <p class="document-intro">
    Une feuille par journée. Chaque participant signe
    pour chaque demi-journée effectivement suivie.
  </p>


  <table class="field-table">

    <tr>

      <td colspan="3">
        <span class="field-label">
          Intitulé de la formation
        </span>
        <div class="write-line"></div>
      </td>

      <td>
        <span class="field-label">
          Référence session
        </span>
        <div class="write-line"></div>
      </td>

    </tr>

    <tr>

      <td colspan="2">
        <span class="field-label">
          Lieu
        </span>
        <div class="write-line"></div>
      </td>

      <td>
        <span class="field-label">
          Date
        </span>
        <div class="write-line"></div>
      </td>

      <td>
        <span class="field-label">
          Durée du jour
        </span>
        <span class="field-hint">Hors pauses</span>
        <div class="write-line"></div>
      </td>

    </tr>

  </table>


  <table class="schedule">

    <tr>

      <td style="width:50%">
        Matin :
        de ........ h ........
        à ........ h ........
      </td>

      <td style="width:50%">
        Après-midi :
        de ........ h ........
        à ........ h ........
      </td>

    </tr>

  </table>


  <div class="section-title">
    <span class="section-number">01</span>
    Participants
  </div>

  <div class="section-accent"></div>


  <table class="grid attendance">

    <thead>

      <tr>

        <th class="number">
          N°
        </th>

        <th class="participant">
          Nom et prénom
        </th>

        <th class="company">
          Entreprise
        </th>

        <th class="center signature-col">
          Signature matin
        </th>

        <th class="center signature-col">
          Signature après-midi
        </th>

      </tr>

    </thead>

    <tbody>

      {% for i in 1..8 %}

        <tr>
          <td class="number">{{ i }}</td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>

      {% endfor %}

    </tbody>

  </table>


  <div class="section-title">
    <span class="section-number">02</span>
    Validation du formateur
  </div>

  <div class="section-accent"></div>


  <table class="field-table trainer-table">

    <tr>

      <td style="width:34%">
        <span class="field-label">
          Nom et prénom du formateur
        </span>
        <div class="write-line"></div>
      </td>

      <td style="width:33%">
        <span class="field-label">
          Signature matin
        </span>
      </td>

      <td style="width:33%">
        <span class="field-label">
          Signature après-midi
        </span>
      </td>

    </tr>

  </table>


  <div class="legal-note">
    <strong>Traçabilité :</strong>
    les signatures doivent correspondre aux périodes
    de formation réellement suivies.
  </div>

{% endblock %}