{% extends 'pdf/modeles/base.html.twig' %}

{% block body_class %}compact-one-page{% endblock %}

{% block extra_styles %}

  @page{
    margin:7mm 8mm 8mm;
  }


  /* =====================================================
     TITRE DU DOCUMENT
     ===================================================== */

  .document-title{
    font-size:17pt;
    margin-bottom:3pt;
    line-height:1.15;
  }

  .document-intro{
    font-size:8.2pt;
    margin-bottom:7pt;
    line-height:1.4;
  }


  /* =====================================================
     BANDEAU INTRO
     ===================================================== */

  .intro-card{
    padding:7pt 9pt;
    margin-bottom:7pt;
  }

  .intro-card .intro-main{
    font-size:8.7pt;
    margin-bottom:1.5pt;
  }

  .intro-card .intro-sub{
    font-size:7.4pt;
    line-height:1.35;
  }


  /* =====================================================
     CHAMPS HAUT DE PAGE
     ===================================================== */

  .field-table{
    margin-bottom:7pt;
  }

  .field-table td{
    padding:6pt 7pt;
  }

  .field-label{
    font-size:7.2pt;
    margin-bottom:0pt;
  }

  .write-line{
    height:11pt;
  }


  /* =====================================================
     TITRES DES SECTIONS
     ===================================================== */

  .section-title{
    margin:8pt 0 4pt;
    padding-bottom:4pt;
    font-size:8.8pt;
  }

  .section-number{
    min-width:19pt;
  }

  .section-accent{
    width:30pt;
    height:1.8pt;
  }


  /* =====================================================
     TABLEAU ÉVALUATION
     ===================================================== */

  .grid th,
  .grid td{
    padding:5pt 5pt;
    font-size:7.7pt;
  }

  .grid th{
    font-size:7pt;
  }

  .check{
    width:9pt;
    height:9pt;
  }


  /* =====================================================
     BLOCS DE RÉPONSE
     ===================================================== */

  .response{
    min-height:0;
    margin-top:5pt;
    padding:7pt 8pt;
  }

  .response-title{
    font-size:7.6pt;
    margin-bottom:2pt;
    line-height:1.3;
  }

  .response-sub{
    font-size:6.8pt;
    margin-bottom:2pt;
    line-height:1.3;
  }

  .two-cols td:first-child{
    padding-right:4pt;
  }

  .two-cols td:last-child{
    padding-left:4pt;
  }


  /* =====================================================
     SIGNATURE
     ===================================================== */

  .signature{
    height:34pt;
  }


  /* =====================================================
     HAUTEURS SPÉCIFIQUES
     ===================================================== */

  .followup-box{
    min-height:50pt;
  }

  .improvement-box{
    min-height:40pt;
  }

  .special-info-box{
    min-height:40pt;
  }

{% endblock %}

{% block document %}

  <h1 class="document-title">
    Compte rendu du formateur
  </h1>

  <p class="document-intro">
    Bilan de l’intervention, suivi pédagogique du groupe et remontée
    des informations utiles à l’amélioration continue de la formation.
  </p>


  <div class="intro-card">

    <div class="intro-main">
      Document de suivi pédagogique
    </div>

    <div class="intro-sub">
      À compléter par le formateur à l’issue de l’action de formation
      et à transmettre à l’organisme.
    </div>

  </div>


  <table class="field-table">

    <tr>

      <td colspan="2">
        <span class="field-label">
          Intitulé de la formation / référence de la session
        </span>
        <div class="write-line"></div>
      </td>

    </tr>

    <tr>

      <td>
        <span class="field-label">
          Nom et prénom du formateur
        </span>
        <div class="write-line"></div>
      </td>

      <td>
        <span class="field-label">
          Dates de formation / lieu
        </span>
        <div class="write-line"></div>
      </td>

    </tr>

  </table>


  <div class="section-title">
    <span class="section-number">01</span>
    Déroulement de la formation
  </div>

  <div class="section-accent"></div>


  <table class="grid">

    <thead>

      <tr>

        <th style="width:64%">
          Point évalué
        </th>

        <th class="center" style="width:12%">
          Oui
        </th>

        <th class="center" style="width:12%">
          En partie
        </th>

        <th class="center" style="width:12%">
          Non
        </th>

      </tr>

    </thead>

    <tbody>

      {% for label in [
        'Le programme annoncé a pu être réalisé dans les conditions prévues.',
        'Les objectifs pédagogiques ont été atteints.',
        'Les moyens pédagogiques et les locaux étaient adaptés.',
        'Le rythme était adapté au niveau et aux besoins du groupe.'
      ] %}

        <tr>

          <td>{{ label }}</td>

          <td class="center">
            <span class="check"></span>
          </td>

          <td class="center">
            <span class="check"></span>
          </td>

          <td class="center">
            <span class="check"></span>
          </td>

        </tr>

      {% endfor %}

    </tbody>

  </table>


  <div class="section-title">
    <span class="section-number">02</span>
    Suivi des participants
  </div>

  <div class="section-accent"></div>


  <table class="two-cols">

    <tr>

      <td>

        <div class="response followup-box">

          <div class="response-title">
            Absences / retards
          </div>

          <div class="response-sub">
            Nom, date et période concernée.
          </div>

          {% for i in 1..2 %}
            <div class="write-line"></div>
          {% endfor %}

        </div>

      </td>


      <td>

        <div class="response followup-box">

          <div class="response-title">
            Participation et progression du groupe
          </div>

          <div class="response-sub">
            Implication, niveau général, dynamique de groupe.
          </div>

          {% for i in 1..2 %}
            <div class="write-line"></div>
          {% endfor %}

        </div>

      </td>

    </tr>

  </table>


  <div class="response followup-box">

    <div class="response-title">
      Objectifs restant à travailler / accompagnement proposé
    </div>

    <div class="response-sub">
      Compétences nécessitant un suivi ou un complément.
    </div>

    {% for i in 1..2 %}
      <div class="write-line"></div>
    {% endfor %}

  </div>


  <div class="section-title">
    <span class="section-number">03</span>
    Amélioration et suites à donner
  </div>

  <div class="section-accent"></div>


  <table class="two-cols">

    <tr>

      <td>

        <div class="response improvement-box">

          <div class="response-title">
            Difficultés / incidents / adaptations
          </div>

          <div class="response-sub">
            Difficultés techniques, pédagogiques ou organisationnelles.
          </div>

          {% for i in 1..2 %}
            <div class="write-line"></div>
          {% endfor %}

        </div>

      </td>


      <td>

        <div class="response improvement-box">

          <div class="response-title">
            Suggestions d’amélioration
          </div>

          <div class="response-sub">
            Programme, durée, moyens, supports ou organisation.
          </div>

          {% for i in 1..2 %}
            <div class="write-line"></div>
          {% endfor %}

        </div>

      </td>

    </tr>

  </table>


  <div class="response special-info-box">

    <div class="response-title">
      Informations particulières à transmettre à l’organisme
    </div>

    <div class="response-sub">
      Situation individuelle, demande ou besoin de suivi.
    </div>

    {% for i in 1..2 %}
      <div class="write-line"></div>
    {% endfor %}

  </div>


  <table
    class="field-table avoid-break"
    style="margin-top:7pt"
  >

    <tr>

      <td style="width:35%">

        <span class="field-label">
          Date du compte rendu
        </span>

        <div class="write-line"></div>

      </td>

      <td>

        <span class="field-label">
          Nom et signature du formateur
        </span>

        <div class="signature"></div>

      </td>

    </tr>

  </table>

{% endblock %}