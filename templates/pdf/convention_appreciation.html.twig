<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>body{font-family:DejaVu Sans,sans-serif;font-size:11px;color:#233d4b}h1{font-size:23px}.document-header{border-bottom:3px solid #dab24d;padding-bottom:18px;margin-bottom:24px}.question{margin:0 0 18px;page-break-inside:avoid}.answer{padding:10px;background:#f3f6f9;white-space:pre-wrap}small{color:#607586}</style></head><body>
<div class="document-header"><small>{{ convention.entite.nom }} · {{ convention.numero }}</small><h1>Appréciation stagiaire</h1><strong>{{ name }}</strong><p>{{ convention.intituleFormationEffectif }} · {{ convention.session.code }}</p><small>Soumise le {{ assignment.attempt.submittedAt|date('d/m/Y à H:i', 'Europe/Paris') }}</small></div>
{% set lastChapter = null %}
{% for answer in answers %}{% if answer.chapter != lastChapter %}<h2>{{ answer.chapter }}</h2>{% set lastChapter = answer.chapter %}{% endif %}
<div class="question"><strong>{{ answer.question }}</strong><div class="answer">{{ answer.value }}</div></div>
{% endfor %}</body></html>
