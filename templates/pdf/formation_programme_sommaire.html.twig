{% set brand = {
  primary:   entite.couleurPrincipal  |default('#1e3a5f'),
  secondary: entite.couleurSecondaire |default('#4ba3ff'),
  accent:    entite.couleurSecondaire |default('#d4a574'),
  ink:       '#0f2336',
  text:      '#1e2d3d',
  muted:     '#5a6b7d',
  line:      '#dce4ed',
  soft:      '#f8fafc',
  paper:     '#ffffff'
} %}

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>Programme de formation - {{ formation.titre }}</title>
  <style>
    @page { margin: 12mm 10mm; size: A4 portrait; }

    body{
      font-family: DejaVu Sans, Helvetica, Arial, sans-serif;
      color: {{ brand.text }};
      font-size: 11pt;
      line-height: 1.45;
    }

    .page{ padding: 0 1mm; }

    .header{
      width:100%;
      padding-bottom: 10pt;
      margin-bottom: 14pt;
      border-bottom: 1.5pt solid {{ brand.primary }};
    }

    .header-table{
      width:100%;
      border-collapse: collapse;
    }

    .header-left{
      width:70%;
      vertical-align: top;
    }

    .header-right{
      width:30%;
      vertical-align: top;
      text-align:right;
      padding-top: 8pt;
    }

    .logo{
      height: 70pt;
      width:auto;
      margin-bottom: 6pt;
    }

    .brand-name{
      font-size: 18pt;
      font-weight: 800;
      color: {{ brand.primary }};
      margin-bottom: 4pt;
    }

    .brand-meta{
      font-size: 9pt;
      color: {{ brand.muted }};
      line-height: 1.4;
    }

    .brand-meta p{ margin:0 0 2pt; }

    .doc-badge{
      display:inline-block;
      background: {{ brand.primary }};
      color:#fff;
      font-weight: 900;
      font-size: 12pt;
      letter-spacing: .8pt;
      padding: 7pt 12pt;
      border-radius: 5pt;
      text-transform: uppercase;
    }

    .doc-meta{
      margin-top: 8pt;
      font-size: 9.5pt;
      color: {{ brand.muted }};
      line-height: 1.45;
    }

    .card{
      background: {{ brand.paper }};
      border: 1pt solid {{ brand.line }};
      border-left: 4pt solid {{ brand.primary }};
      border-radius: 7pt;
      padding: 12pt 14pt;
      margin-bottom: 12pt;
    }

    .section-title{
      font-size: 10.5pt;
      font-weight: 900;
      color: {{ brand.primary }};
      text-transform: uppercase;
      letter-spacing: .7pt;
      margin: 0 0 10pt;
      padding-bottom: 6pt;
      border-bottom: 1pt solid #eef2f6;
    }

    .formation-title{
      font-size: 18pt;
      font-weight: 800;
      color: {{ brand.ink }};
      margin-bottom: 6pt;
    }

    .formation-meta{
      font-size: 10pt;
      color: {{ brand.muted }};
      margin-top: 4pt;
    }

    .chapter-list{
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .chapter-item{
      padding: 10pt 12pt;
      margin-bottom: 8pt;
      border: 1pt solid {{ brand.line }};
      border-left: 4pt solid {{ brand.accent }};
      border-radius: 7pt;
      background: {{ brand.soft }};
    }

    .chapter-index{
      font-weight: 900;
      color: {{ brand.primary }};
      margin-right: 6pt;
    }

    .chapter-title{
      font-weight: 700;
      color: {{ brand.ink }};
      font-size: 11pt;
    }

    .empty{
      color: {{ brand.muted }};
      font-style: italic;
    }
  </style>
</head>
<body>
  <div class="page">

    <div class="header">
      <table class="header-table">
        <tr>
          <td class="header-left">
            {% if entite.logo %}
              <img class="logo"
                   src="{{ absolute_url(asset('uploads/photos/entite/logo/' ~ entite.logo)) }}"
                   alt="Logo {{ entite.nom|default('') }}">
            {% endif %}

            <div class="brand-name">{{ entite.nom|default('') }}</div>

            <div class="brand-meta">
              {% if entite.adresse %}<p>{{ entite.adresse }}</p>{% endif %}
              <p>
                {{ entite.codePostal|default('') }} {{ entite.ville|default('') }}
                {% if entite.pays %} · {{ entite.pays }}{% endif %}
              </p>
              {% if entite.email or entite.telephone %}
                <p>
                  {{ entite.telephone|default('') }}
                  {% if entite.telephone and entite.email %} · {% endif %}
                  {{ entite.email|default('') }}
                </p>
              {% endif %}
            </div>
          </td>

          <td class="header-right">
            <div class="doc-badge">Programme</div>
            <div class="doc-meta">
              <div><strong>Date :</strong> {{ "now"|date('d/m/Y') }}</div>
              <div><strong>Formation :</strong> #{{ formation.id }}</div>
            </div>
          </td>
        </tr>
      </table>
    </div>

    <div class="card">
      <div class="section-title">Formation</div>
      <div class="formation-title">{{ formation.titre }}</div>

      <div class="formation-meta">
        {% if formation.niveau %}
          Niveau : {{ formation.niveau.label() }}
        {% endif %}
        {% if formation.duree %}
          {% if formation.niveau %} · {% endif %}
          Durée : {{ formation.duree }} jour{% if formation.duree > 1 %}s{% endif %}
        {% endif %}
      </div>
    </div>

    <div class="card">
      <div class="section-title">Chapitres du programme</div>

      {% if chapitres is not empty %}
        <ul class="chapter-list">
          {% for chapitre in chapitres %}
            <li class="chapter-item">
              <span class="chapter-index">{{ loop.index }}.</span>
              <span class="chapter-title">{{ chapitre.titre }}</span>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="empty">Aucun chapitre publié n’est disponible pour cette formation.</div>
      {% endif %}
    </div>

  </div>
</body>
</html>