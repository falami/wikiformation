{% set studioSource = _context %}{% apply document_studio('facture', studioSource) %}{# templates/pdf/facture.html.twig #}
{% import _self as m %}
{% set invoiceDraft = invoiceDraft|default(false) %}
{% set issued = invoiceDraft ? draftSnapshot|default(null) : invoice_snapshot(facture) %}
{% if issued %}
  {% set invoiceTotals = issued.totals %}
  {% set entite = issued.issuer %}
  {% set facture = issued.invoice|merge({lignes: issued.lines}) %}
{% endif %}
{# Newly issued invoices retain their monetary calculation; historical PDF behavior is preserved. #}
{% if invoiceTotals is not defined and (facture.issuedTotals is not null or facture.meta.workflow_billing is defined) %}
  {% set invoiceTotals = invoice_totals(facture) %}
{% endif %}

{% macro eur(cents) %}{{ ((cents ?? 0) / 100)|number_format(2, ',', ' ') }} €{% endmacro %}
{% macro pct(v) %}{{ (v ?? 0)|number_format(2, ',', ' ') }} %{% endmacro %}

{% set brand = {
  primary: entite.couleurPrincipal ?? '#1e3a5f',
  secondary: entite.couleurSecondaire ?? '#4ba3ff',
  ink: '#0f2336',
  line: '#e6eef5',
  bg: '#f7fafc',
  dark: '#0f1b28'
} %}

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <title>{{ invoiceDraft ? 'Brouillon de facture — Non émis' : 'Facture ' ~ facture.numero }}</title>

  {% include 'pdf/_commercial_styles.html.twig' %}
{% include 'pdf/_document_footer.html.twig' %}
</head>

<body>
{% if invoiceDraft %}<div class="draft-watermark">BROUILLON — NON ÉMIS</div>{% endif %}
<div class="wrap">

  <div class="content">
    {% if invoiceDraft %}<div class="draft-banner">BROUILLON — NON ÉMIS · Document de relecture, sans numéro définitif · Ne pas régler</div>{% endif %}
    <!-- HEADER -->
    <table class="header" cellspacing="0" cellpadding="0">
      <tr>
        <td class="left">
          <table class="issuer-header"><tr>
            {% if entite.logo or (issued and entite.logoDataUri) %}<td class="issuer-logo">
            {% if issued and entite.logoDataUri %}
              <img class="logo" src="{{ entite.logoDataUri }}" alt="Logo {{ entite.nom }}">
            {% elseif entite.logo %}
              <img class="logo" src="{{ absolute_url(asset('uploads/photos/entite/logo/' ~ entite.logo)) }}" alt="Logo {{ entite.nom }}">
            {% endif %}
            </td>{% endif %}<td class="issuer-address"><div class="brand-meta">
              {% if entite.nom %}<p><strong>{{ entite.nom }}</strong></p>{% endif %}
              {% if entite.adresse %}<p>{{ entite.adresse }}</p>{% endif %}

              {% set entite_l2 = [] %}
              {% if entite.codePostal %}{% set entite_l2 = entite_l2|merge([entite.codePostal]) %}{% endif %}
              {% if entite.ville %}{% set entite_l2 = entite_l2|merge([entite.ville]) %}{% endif %}
              {% if entite_l2 is not empty or entite.pays %}
                <p>{{ entite_l2|join(' ') }}{% if entite.pays %} - {{ entite.pays }}{% endif %}</p>
              {% endif %}

              {% if entite.telephone %}<p>{{ entite.telephone }}</p>{% endif %}
              {% if entite.email %}<p>{{ entite.email }}</p>{% endif %}
              {% if entite.siret %}<p>SIRET : {{ entite.siret }}</p>{% endif %}
              {% if entite.numeroTva %}<p>TVA : {{ entite.numeroTva }}</p>{% endif %}
            </div>
          </td></tr></table>
        </td>

        <td class="right">
          <div class="doc-right">
            <div class="doc-kicker">{{ invoiceDraft ? 'DOCUMENT DE RELECTURE' : 'DOCUMENT DE FACTURATION' }}</div><div class="doc-badge">{{ invoiceDraft ? 'Brouillon' : 'Facture' }}</div>
            <div class="doc-meta">
              {% if invoiceDraft %}
              <div>Facture en préparation</div>
              <div><strong>Émission prévue le</strong> {{ facture.dateEmission|date('d/m/Y') }}</div>
              <div class="stamp stamp-due">NON ÉMIS</div>
              {% else %}
              <div class="doc-number">{{ facture.numero }}</div>
              <div><strong>Émise le</strong> {{ facture.dateEmission|date('d/m/Y') }}</div>

              {% set st = facture.status.value ?? facture.status %}
              {% if st == 'paid' %}
                <div class="stamp stamp-paid">PAYÉ</div>
              {% elseif st == 'canceled' %}
                <div class="stamp stamp-canceled">ANNULÉE</div>
              {% else %}
                <div class="stamp stamp-due">MONTANT DÛ</div>
              {% endif %}
              {% endif %}
            </div>
          </div>
        </td>
      </tr>
    </table>

    {% set meta = facture.meta ?? {} %}
    {% set u = facture.destinataire %}
    {% set e = facture.entrepriseDestinataire %}

    <table class="head" cellspacing="0" cellpadding="0">
      <tr>
        <td class="titre" style="width:48%"><b>Règlement & références</b></td>
        <td style="width:4%; border:none;"></td>
        <td class="titre" style="width:48%"><b>Destinataire</b></td>
      </tr>
      <tr>
        <td class="information-cell">
          <p>
            N° client :
            {% if e %}ENT-{{ e.id ?? '-' }}{% elseif u %}CLI-{{ u.id ?? '-' }}{% else %}-{% endif %}
            <br>

            {{ invoiceDraft ? 'Échéance prévue' : 'Paiement dû' }} :
            {% if issued %}{{ issued.terms.dueDate ? issued.terms.dueDate|date('d/m/Y') : 'Non renseigné' }}{% else %}{{ facture.dateEmission|date_modify(meta.echeance ?? '+30 days')|date('d/m/Y') }}{% endif %}<br>

            Modalité paiement : {{ issued ? (issued.terms.paymentMeans ?: 'Non renseigné') : (meta.modalite ?? 'Virement') }}<br>
            {% set datePresta = issued ? issued.terms.serviceDate : meta.datePrestation|default(null) %}
            {% if datePresta %}
              Date prestation : {{ datePresta|date('d/m/Y') }}<br>
            {% endif %}

            {% if facture.inscriptions is defined and facture.inscriptions|length > 0 %}
              <span style="margin-top:6px; display:inline-block;">
                Réf. inscriptions :
                {% for ins in facture.inscriptions %}
                  #{{ ins.id }}{% if not loop.last %}, {% endif %}
                {% endfor %}
              </span>
            {% elseif facture.inscription is defined and facture.inscription %}
              <span style="margin-top:6px; display:inline-block;">
                Réf. inscription : #{{ facture.inscription.id }}
              </span>
            {% endif %}
          </p>
        </td>



        <td style="border:none;"></td>
        <td class="customer-cell">
          {% if e %}
            <div class="customer-name">{{ e.raisonSociale ?? 'Entreprise' }}</div>
            {% if e.adresse is defined and e.adresse %}{{ e.adresse }}<br>{% endif %}
            {% if e.complement is defined and e.complement %}{{ e.complement }}<br>{% endif %}
            {% set cp_ville = [] %}
            {% if e.codePostal is defined and e.codePostal %}{% set cp_ville = cp_ville|merge([e.codePostal]) %}{% endif %}
            {% if e.ville is defined and e.ville %}{% set cp_ville = cp_ville|merge([e.ville]) %}{% endif %}
            {% if cp_ville is not empty %}{{ cp_ville|join(' ') }}<br>{% endif %}
            {% if e.pays is defined and e.pays %}{{ e.pays }}<br>{% endif %}
            {% if e.siret is defined and e.siret %}SIRET : {{ e.siret }}<br>{% endif %}
            {% if e.numeroTva is defined and e.numeroTva %}TVA : {{ e.numeroTva }}<br>{% endif %}
            {% if e.emailFacturation is defined and e.emailFacturation %}{{ e.emailFacturation }}{% elseif e.email is defined and e.email %}{{ e.email }}{% endif %}
          {% elseif u %}
            {% set nom_aff = (u.civilite is defined ? u.civilite : '') ~ ' ' ~ (u.prenom is defined ? u.prenom : '') ~ ' ' ~ (u.nom is defined ? u.nom : '') %}
            <div class="customer-name">{{ nom_aff|trim ?: (u.email ?? '-') }}</div>
            {% if u.adresse is defined and u.adresse %}{{ u.adresse }}<br>{% endif %}
            {% if u.complement is defined and u.complement %}{{ u.complement }}<br>{% endif %}
            {% set cp_ville = [] %}
            {% if u.codePostal is defined and u.codePostal %}{% set cp_ville = cp_ville|merge([u.codePostal]) %}{% endif %}
            {% if u.ville is defined and u.ville %}{% set cp_ville = cp_ville|merge([u.ville]) %}{% endif %}
            {% if cp_ville is not empty %}{{ cp_ville|join(' ') }}<br>{% endif %}
            {% if u.pays is defined and u.pays %}{{ u.pays }}<br>{% endif %}
            {% if u.email is defined and u.email %}{{ u.email }}{% endif %}
          {% else %}
            -
          {% endif %}
        </td>
      </tr>
    </table>

    <div class="rule"></div>

    {# ===== LIGNES + REMISES ===== #}
    <div class="section-caption">Détail des prestations</div>
  <table class="lines-table">
    <thead><tr>
      <th style="width:52%">Désignation</th>
      <th style="width:7%" class="num">Qté</th>
      <th style="width:15%" class="num">P.U. HT</th>
      <th style="width:10%" class="num">TVA</th>
      <th style="width:16%" class="num">Montant HT</th>
    </tr></thead>
    <tbody>
        {% set total_ht_brut = 0 %}
        {% set total_remises_lignes = 0 %}
        {% set total_ht_net = 0 %}
        {% set bases_by_rate = {} %}

        {% for l in facture.lignes %}
          {% set qte = l.qte ?? 0 %}
          {% set pu  = l.puHtCents ?? 0 %}
          {% set line_ht = l.totalHtBrutCents ?? (qte * pu) %}
          {% set line_remise = l.remiseCents ?? 0 %}
          {% set line_ht_net = l.totalHtNetCents ?? (line_ht - line_remise) %}

          {% set tva_rate = l.tva ?? 0 %}
          {% set line_tva = (line_ht_net * tva_rate / 100)|round(0, 'floor') %}
          {% if invoiceTotals is defined %}{% set line_tva = invoiceTotals.lines[loop.index0].tvaCents ?? l.totalTvaCents %}{% endif %}

          {% set total_ht_brut = total_ht_brut + line_ht %}
          {% set total_remises_lignes = total_remises_lignes + line_remise %}
          {% set total_ht_net = total_ht_net + line_ht_net %}

          {% set rate_key = (tva_rate|number_format(2, '.', '')) %}
          {% set bases_by_rate = bases_by_rate|merge({
            (rate_key): (bases_by_rate[rate_key]|default(0) + line_ht_net)
          }) %}

          {# Normalize the description and bound rows for safe pagination. #}
          {% set description = (l.label ?? '')|document_description %}
        {% set titleChunks = description.main|document_text_chunks(180) %}
        {% set main = titleChunks|first|default('') %}
        {% set details = description.details %}

          <tr class="{% if details|length == 0 and titleChunks|length < 2 %}line-end{% else %}line-main{% endif %}">
          <td class="line-title"><span class="line-index">{{ loop.index < 10 ? '0' ~ loop.index : loop.index }} / </span>{{ main }}
            {% if line_remise > 0 %}<div class="line-discount">Remise : -{{ m.eur(line_remise) }}{% if l.remisePourcent ?? 0 %} ({{ m.pct(l.remisePourcent) }}){% endif %}</div>{% endif %}
            {% if l.debours|default(l.isDebours|default(false)) %}<div class="line-discount">Débours</div>{% endif %}
          </td>
          <td class="num">{{ qte }}</td>
          <td class="num">{{ m.eur(pu) }}</td>
          <td class="num">{{ tva_rate|number_format(2, ',', ' ') }} %</td>
          <td class="num"><strong>{{ m.eur(line_ht_net) }}</strong></td>
        </tr>

          {% for continuation in titleChunks|slice(1) %}
          <tr class="detail-row"><td colspan="5" class="line-title">{{ continuation }}</td></tr>
        {% endfor %}
        {% for d in details %}
          {% set lastDetail = loop.last %}
          {% for chunk in d|document_text_chunks %}
            <tr class="detail-row {% if lastDetail and loop.last %}line-end{% endif %}">
              <td colspan="5" class="detail-text">{% if loop.first %}<span class="detail-bullet">-</span> {% endif %}{{ chunk }}</td>
            </tr>
          {% endfor %}
        {% endfor %}

        {% else %}
          <tr><td colspan="5" class="muted">Aucune ligne de facture</td></tr>
        {% endfor %}
      </tbody>

    </table>

    {# ===== REMISE GLOBALE ===== #}
    {% set rg_pct   = facture.remiseGlobalePourcent ?? null %}
    {% set rg_cents = facture.remiseGlobaleMontantCents ?? null %}

    {% set remise_globale = 0 %}
    {% if rg_cents is not null and rg_cents > 0 %}
      {% set remise_globale = rg_cents %}
    {% elseif rg_pct is not null and rg_pct > 0 %}
      {% set remise_globale = (total_ht_net * rg_pct / 100)|round(0, 'floor') %}
    {% endif %}

    {% if remise_globale > total_ht_net %}{% set remise_globale = total_ht_net %}{% endif %}

    {% set total_ht_apres_rg = total_ht_net - remise_globale %}

    {# ===== TVA APRÈS REMISE GLOBALE (prorata par taux) ===== #}
    {% set total_tva_after_rg = 0 %}
    {% for rate_key, base_ht_net in bases_by_rate %}
      {% set rate = rate_key + 0 %}

      {% set base_after = base_ht_net %}
      {% if remise_globale > 0 and total_ht_net > 0 %}
        {% set share = (remise_globale * base_ht_net / total_ht_net)|round(0, 'floor') %}
        {% set base_after = base_ht_net - share %}
        {% if base_after < 0 %}{% set base_after = 0 %}{% endif %}
      {% endif %}

      {% set tva_rate_amount = (base_after * rate / 100)|round(0, 'floor') %}
      {% set total_tva_after_rg = total_tva_after_rg + tva_rate_amount %}
    {% endfor %}

    {# ===== DÉBOURS ===== #}
    {# Garde uniquement le champ qui existe réellement dans ton entité #}
    {% set debours_cents =
      facture.deboursCents
        ?? facture.montantDeboursCents
        ?? meta.deboursCents
        ?? 0
    %}

    {% set total_ttc_calc = total_ht_apres_rg + total_tva_after_rg %}
    {% set total_a_payer_calc = total_ttc_calc + debours_cents %}

    {# Ici on force l'affichage à partir du recalcul des lignes #}
    {% set ht_display = total_ht_apres_rg %}
    {% set tva_display = total_tva_after_rg %}
    {% set ttc_display = total_ttc_calc %}

    {# Si les débours sont déjà une ligne de facture, ne pas les rajouter une seconde fois #}
    {% set total_a_payer_display = ttc_display %}

    {% if invoiceTotals is defined %}
      {% set total_ht_brut = invoiceTotals.brutHtCents %}
      {% set total_remises_lignes = invoiceTotals.lineDiscountCents %}
      {% set remise_globale = invoiceTotals.globalDiscountCents %}
      {% set ht_display = invoiceTotals.htCents %}
      {% set tva_display = invoiceTotals.tvaCents %}
      {% set ttc_display = invoiceTotals.ttcCents %}
      {% set total_a_payer_display = invoiceTotals.ttcCents %}
    {% endif %}

    {% if invoiceTotals is defined and remise_globale > 0 %}
      <p class="note">La remise globale est répartie sur les lignes. Les montants de TVA tiennent compte de cette remise.</p>
    {% endif %}

    {# ===== TOTAUX ===== #}
    <table class="closing-layout"><tr><td class="closing-notes">
      <div class="closing-caption">{{ invoiceDraft ? 'POUR RELECTURE' : 'VOTRE RÈGLEMENT' }}</div>
      <div class="closing-copy">{% if invoiceDraft %}Document de travail.<br>Aucun règlement demandé.{% else %}
      {{ issued ? (issued.terms.paymentMeans ?: 'Modalité non renseignée') : (meta.modalite ?? 'Virement') }}<br>
      Échéance : <strong>{% if issued %}{{ issued.terms.dueDate ? issued.terms.dueDate|date('d/m/Y') : 'Non renseignée' }}{% else %}{{ facture.dateEmission|date_modify(meta.echeance ?? '+30 days')|date('d/m/Y') }}{% endif %}</strong><br><br>
      Référence à rappeler :<br><strong>{{ facture.numero }}</strong>{% endif %}</div>
    </td><td class="closing-totals">
    <table class="totaux" cellspacing="0" cellpadding="0">
      {% if total_remises_lignes > 0 or remise_globale > 0 %}<tr>

        <td class="label" >Sous-total HT</td>
        <td class="val" >{{ m.eur(total_ht_brut) }}</td>
      </tr>{% endif %}

      {% if total_remises_lignes > 0 %}
        <tr>

          <td class="label">Remises lignes</td>
          <td class="val">-{{ m.eur(total_remises_lignes) }}</td>
        </tr>
      {% endif %}

      {% if remise_globale > 0 %}
        <tr>

          <td class="label">
            Remise globale
            {% if rg_pct is not null and rg_pct > 0 %}
              <span class="muted">({{ m.pct(rg_pct) }})</span>
            {% endif %}
          </td>
          <td class="val">-{{ m.eur(remise_globale) }}</td>
        </tr>
      {% endif %}

      <tr>

        <td class="label">Total HT</td>
        <td class="val">{{ m.eur(ht_display) }}</td>
      </tr>

      {% if bases_by_rate|length > 1 %}
        {% for rate_key, base_ht_net in bases_by_rate %}
          {% set rate = rate_key + 0 %}
          {% set base_after = base_ht_net %}
          {% if remise_globale > 0 and total_ht_net > 0 %}
            {% set share = (remise_globale * base_ht_net / total_ht_net)|round(0, 'floor') %}
            {% set base_after = base_ht_net - share %}
            {% if base_after < 0 %}{% set base_after = 0 %}{% endif %}
          {% endif %}
          {% set tva_rate_amount = (base_after * rate / 100)|round(0, 'floor') %}
          {% if invoiceTotals is defined %}{% set tva_rate_amount = invoiceTotals.rates[rate_key].tvaCents %}{% endif %}

          <tr>

            <td class="label">TVA {{ rate|number_format(2, ',', ' ') }}%</td>
            <td class="val">{{ m.eur(tva_rate_amount) }}</td>
          </tr>
        {% endfor %}
      {% else %}
        <tr>

          <td class="label">Montant TVA</td>
          <td class="val">{{ m.eur(tva_display) }}</td>
        </tr>
      {% endif %}



      <tr>

        <td class="label total titre">{{ invoiceDraft ? 'Total TTC prévisionnel' : 'Total à payer' }}</td>
        <td class="val total titre">{{ m.eur(total_a_payer_display) }}</td>
      </tr>
    </table>
    </td></tr></table>
    {% if issued %}
      <div class="payment-terms">
        <div class="payment-terms-title">CONDITIONS DE RÈGLEMENT</div>
        {% if issued.terms.purchaseOrderReference %}<p>Bon de commande : {{ issued.terms.purchaseOrderReference }}</p>{% endif %}
        {% if issued.terms.vatExemptionReason %}<p>{{ issued.terms.vatExemptionReason|nl2br }}</p>{% endif %}
        {% if issued.terms.vatOnDebits %}<p>TVA acquittée d’après les débits.</p>{% endif %}
        {% if issued.terms.earlyPaymentDiscount %}<p>{{ issued.terms.earlyPaymentDiscount }}</p>{% endif %}
        {% if issued.customer.type == 'company' %}
          {% if issued.terms.latePaymentPenalty %}<p>Pénalités de retard : {{ issued.terms.latePaymentPenalty }}</p>{% endif %}
          {% if issued.terms.recoveryCompensationCents is not null %}<p>Indemnité forfaitaire de recouvrement : {{ m.eur(issued.terms.recoveryCompensationCents) }}.</p>{% endif %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>




{% set meta = facture.meta ?? {} %}
{% set noteText = (meta.note is defined and meta.note) ? meta.note : 'Merci pour votre confiance.' %}

<div class="footer-wrapper">
  <div class="footer-note">{{ noteText }}</div>
  <div class="footer-panel">
    <table class="footer-grid"><tr>
      <td class="issuer-cell">
        <div class="footer-caption">VOTRE ORGANISME DE FORMATION</div>
        <div class="footer-name">{{ entite.nom }}</div>
        {% if issued and issued.terms.legalIdentity %}
          <div>{{ issued.terms.legalIdentity|nl2br }}</div>
        {% else %}
          {% if entite.siret %}<div>SIRET : {{ entite.siret }}</div>{% endif %}
        {% endif %}
      </td>
      <td class="bank-cell">
        <div class="footer-caption">COORDONNÉES BANCAIRES</div>
        {% if entite.banque %}<div class="footer-name">{{ entite.banque }}</div>{% endif %}
        {% if entite.iban %}<div>IBAN</div><div class="bank-iban">{{ entite.iban }}</div>{% endif %}
        {% if entite.bic %}<div><strong>BIC</strong> &nbsp; {{ entite.bic }}</div>{% endif %}
        {% if entite.codeBanque or entite.numeroCompte %}<div>{% if entite.codeBanque %}Code banque : {{ entite.codeBanque }}{% endif %}{% if entite.numeroCompte %} &nbsp; · &nbsp; Compte : {{ entite.numeroCompte }}{% endif %}</div>{% endif %}
      </td>
    </tr></table>
    <div class="footer-reference">{% if invoiceDraft %}<strong>BROUILLON — NON ÉMIS</strong> · Document de travail, sans valeur de facture. Aucun règlement demandé.{% else %}Référence à rappeler lors du règlement : <strong>{{ facture.numero }}</strong>{% endif %}</div>
  </div>
</div>

</body>
</html>
{% endapply %}
