{% extends 'participant_qr/public_base.html.twig' %}
{% block title %}Émargement{% endblock %}
{% block extra_head %}
<link rel="stylesheet" href="{{ asset('dist/vendors/flatpickr/flatpickr.min.css') }}">
<link rel="stylesheet" href="{{ asset('dist/css/participant-attendance-calendar.css') }}?v=20261006-2">
<script src="{{ asset('dist/vendors/flatpickr/flatpickr.min.js') }}" defer></script>
<script src="{{ asset('dist/js/participant-attendance-calendar.js') }}" defer></script>
{% endblock %}
{% block content %}
  <span class="eyebrow">{% if selectedDay %}Émargement du {{ selectedDay|date('d/m/Y', false) }}{% else %}Émargement de la formation{% endif %}</span>
  <h1>Bonjour {{ access.displayName }}</h1>
  <p class="lead">Confirmez votre présence à la formation pour chaque demi-journée.</p>
  {% if days is not empty %}
    <form method="get" class="attendance-day-picker" data-attendance-calendar data-calendar-states="{{ calendarStates|json_encode|e('html_attr') }}">
      <div class="calendar-heading"><span class="eyebrow">VOTRE PLANNING</span><h2>Choisissez votre journée</h2><p>Cliquez sur une date de formation pour consulter et compléter vos émargements.</p></div>
      <div class="calendar-progress"><div><strong>{{ completeDays }}<small> / {{ days|length }}</small></strong><span>journées complètes</span></div><span class="calendar-remaining {{ completeDays == days|length ? 'all-complete' : '' }}">{{ completeDays == days|length ? 'Tout est émargé' : (days|length - completeDays) ~ ' à compléter' }}</span></div>
      <div data-calendar-host></div>
      <div class="calendar-legend" hidden data-calendar-legend><span><i class="is-pending"></i> À compléter</span><span><i class="is-complete"></i> Émargée</span><span><i class="is-selected"></i> Journée affichée</span></div>
      <label for="attendance-date" data-calendar-fallback>Journée de formation à émarger</label>
      <select id="attendance-date" name="date">{% for key, day in days %}<option value="{{ key }}" {{ selectedDay and key == selectedDay|date('Y-m-d', false) ? 'selected' : '' }}>{{ day|date('d/m/Y', false) }}</option>{% endfor %}</select>
      <button class="button secondary small" type="submit" data-calendar-fallback>Afficher cette journée</button>
    </form>
  {% endif %}
  {% if selectedDay and selectedDay < today %}<div class="notice">Régularisation de présence du <strong>{{ selectedDay|date('d/m/Y', false) }}</strong>. Votre signature sera datée du moment où vous la validez.</div>{% endif %}
  {% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
  {% if periods is empty %}
    <div class="notice">Aucune demi-journée passée ou prévue aujourd’hui n’est disponible pour cette sélection. Choisissez une journée de la formation ci-dessus, ou revenez le jour de votre formation.</div>
  {% else %}
    <div class="attendance-status" aria-label="État des signatures">
      {% for value, label in periods %}<div><strong>{{ label }}</strong><span class="{{ signed[value] is defined ? 'success-text' : '' }}">{{ signed[value] is defined ? '✓ Présence enregistrée' : 'À signer' }}</span></div>{% endfor %}
    </div>
    {% if signed|length == periods|length %}<div class="notice success" role="status">Vos signatures pour cette journée sont enregistrées. Merci !</div>
    {% else %}
    <form method="post" data-attendance-form>
      <input type="hidden" name="_token" value="{{ csrf_token('participant_attendance_' ~ access.id) }}">
      <input type="hidden" name="date" value="{{ selectedDay|date('Y-m-d', false) }}">
      <input type="hidden" name="signature" data-signature-value>
      <fieldset><legend>Demi-journée à signer</legend><div class="period-choices">
        {% for value, label in periods %}{% if signed[value] is not defined %}<label><input type="radio" name="periode" value="{{ value }}" required> <span>{{ label }}</span></label>{% endif %}{% endfor %}
      </div></fieldset>
      <div class="signature-heading"><label for="participant-signature">Votre signature</label><button class="button secondary small" type="button" data-clear-signature>Effacer</button></div>
      <canvas id="participant-signature" data-signature-canvas width="900" height="320" aria-label="Dessinez votre signature avec la souris ou le doigt"></canvas>
      <p class="help">Signez dans le cadre avec votre doigt ou votre souris.</p>
      <label class="confirmation"><input type="checkbox" name="confirmation" value="1" required><span>Je suis {{ access.displayName }} et je confirme ma présence pour la demi-journée sélectionnée du {{ selectedDay|date('d/m/Y', false) }}.</span></label>
      <p class="error-text" data-signature-error role="alert" hidden>Veuillez dessiner votre signature.</p>
      <button class="button primary" type="submit">Valider ma présence <span aria-hidden="true">→</span></button>
    </form>
    {% endif %}
  {% endif %}
{% endblock %}
