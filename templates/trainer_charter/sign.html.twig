{% extends 'trainer_charter/base.html.twig' %}
{% block charter %}<header class="charter-hero"><div><div class="charter-eyebrow">{{ v.issuer.name }} · Version {{ v.number }}</div><h1>{{ v.title }}</h1><p>Applicable le {{ v.effectiveAt|date('d/m/Y') }} · Prenez connaissance de chaque engagement avant de signer.</p></div><a class="btn btn-light" href="{{ path('app_charter_mine',{entite:entite.id}) }}">Mes chartes</a></header>
<div class="charter-layout"><nav class="charter-toc" aria-label="Sommaire de la charte"><strong>Votre lecture</strong>{% for chapter in v.chapters %}<a href="#chapter-{{ loop.index }}">{{ loop.index }}. {{ chapter.title }}</a>{% endfor %}<a href="#charterSignature">Mon engagement</a></nav><article class="charter-document">{% for chapter in v.chapters %}{% set n=loop.index %}<section id="chapter-{{ n }}"><h2><span class="chapter-number">{{ '%02d'|format(n) }}</span>{{ chapter.title }}</h2><p>{{ chapter.body }}</p>{% for sub in chapter.children %}<h3>{{ n }}.{{ loop.index }} · {{ sub.title }}</h3><p>{{ sub.body }}</p>{% endfor %}</section>{% endfor %}
<section id="charterSignature" class="charter-signature"><h2 class="mt-0">Mon engagement</h2>{% if s.signedAt %}<span class="charter-badge signed">Signée le {{ s.signedAt|date('d/m/Y à H:i') }}</span><p class="mt-3">{{ s.evidence.name }} · {{ s.evidence.email }}</p><a class="btn btn-charter" href="{{ path('app_charter_signed_pdf',{entite:entite.id,id:s.id}) }}">Télécharger mon exemplaire signé</a>{% elseif not current %}<p>Cette version a été remplacée. Retrouvez la demande actuelle dans « Mes chartes ».</p>{% else %}{% if error %}<p class="alert alert-danger">{{ error }}</p>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('charter_sign_' ~ s.id) }}"><input type="hidden" name="digest" value="{{ v.digest }}"><label for="signerName">Votre prénom et votre nom</label><input class="form-control mb-3" id="signerName" name="signerName" autocomplete="name" maxlength="180" required placeholder="Saisissez votre identité pour signer"><label class="d-flex gap-2"><input class="form-check-input" type="checkbox" name="consent" value="1" required><span>J’ai lu cette version et je m’engage à respecter ses dispositions.</span></label><p class="charter-muted mt-3">Votre signature est enregistrée depuis votre compte connecté, avec la date, l’identité du compte et l’empreinte du document. Un exemplaire PDF est conservé.</p><button class="btn btn-charter">Signer la charte · version {{ v.number }}</button></form>{% endif %}<div class="charter-hash mt-4">Empreinte du texte : {{ v.digest }}</div></section></article></div>{% endblock %}
