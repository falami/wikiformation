{% extends 'trainer_charter/base.html.twig' %}
{% block charter %}<header class="charter-hero"><div><div class="charter-eyebrow">Atelier de rédaction · Version {{ v.number }}</div><h1>Des engagements clairs.</h1><p>Structurez votre charte en chapitres et sous-chapitres. La publication fige le texte ; une évolution crée une nouvelle version.</p></div><a class="btn btn-light" href="{{ path('app_charter_admin',{entite:entite.id}) }}">Toutes les chartes</a></header>
{% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
<form method="post" id="charterEditor"><input type="hidden" name="_token" value="{{ csrf_token('charter_edit_' ~ v.id) }}"><input type="hidden" name="revision" value="{{ v.revision }}"><input type="hidden" name="chapters" id="chaptersValue">
<section class="charter-panel"><div class="row g-4"><div class="col-md-8"><label for="charterTitle">Titre de la charte</label><input class="form-control" id="charterTitle" name="title" value="{{ v.title }}" maxlength="180" required></div><div class="col-md-4"><label for="charterDate">Date d’application</label><input class="form-control" type="date" id="charterDate" name="effectiveAt" value="{{ v.effectiveAt ? v.effectiveAt|date('Y-m-d') : '' }}" required></div><div class="col-12"><label for="charterNote">Note de version</label><input class="form-control" id="charterNote" name="changeNote" maxlength="1000" value="{{ v.changeNote }}" placeholder="Ex. Précisions sur les évaluations et la confidentialité"></div></div></section>
<div id="chapterEditor" data-content="{{ v.chapters|json_encode|e('html_attr') }}"></div><button type="button" class="btn btn-outline-secondary mb-4" id="addChapter"><i class="bi bi-plus-lg me-2"></i>Ajouter un chapitre</button>
<div class="charter-editor-footer charter-actions"><span class="charter-muted me-auto">Version {{ v.number }} · Brouillon modifiable</span><button class="btn btn-outline-secondary" name="action" value="save">Enregistrer le brouillon</button><button class="btn btn-charter" name="action" value="publish">Publier cette version</button></div></form>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script><script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script><script src="{{ asset('dist/js/trainer-charter-editor.js') }}?v=1"></script>
{% endblock %}
