{% extends 'trainer_charter/base.html.twig' %}
{% block charter %}
<header class="charter-hero"><div><div class="charter-eyebrow">Suivi des engagements · Version {{ v.number }}</div><h1>{{ v.title }}</h1><p>Applicable le {{ v.effectiveAt|date('d/m/Y') }} · Publiée le {{ v.publishedAt|date('d/m/Y') }}. {{ current ? 'Dernière version publiée.' : 'Version historique : consultez la dernière version pour demander une signature à jour.' }}</p></div><div class="charter-actions"><a class="btn btn-light" href="{{ path('app_charter_version_pdf',{entite:entite.id,id:v.id}) }}">Lire le PDF</a><a class="btn btn-outline-light" href="{{ path('app_charter_admin',{entite:entite.id}) }}">Les versions</a></div></header>
<div class="charter-stats"><div class="charter-stat"><span>Signatures de cette version</span><strong>{{ signed }}</strong></div><div class="charter-stat"><span>Demandes en attente</span><strong>{{ pending }}</strong></div><div class="charter-stat"><span>Formateurs non sollicités pour cette version</span><strong>{{ rows|length - signed - pending }}</strong></div></div>
{% if current %}<form method="post" class="charter-panel"><h2>Demander la signature</h2><p class="charter-muted">Sélectionnez vos formateurs sous-traitants. La demande apparaît dans leur espace et sur leur tableau de bord. Une signature d’une ancienne version ne vaut pas acceptation de celle-ci.</p><input type="hidden" name="_token" value="{{ csrf_token('charter_request_' ~ v.id) }}"><label for="charterTrainers">Formateurs concernés</label><select name="trainers[]" id="charterTrainers" multiple required>{% for row in rows %}{% if row.trainer.utilisateur and not row.signature %}<option value="{{ row.trainer.id }}">{{ row.name }} · {{ row.trainer.utilisateur.email }}</option>{% endif %}{% endfor %}</select><div class="charter-actions mt-3"><button class="btn btn-outline-secondary" type="button" id="selectAllTrainers">Sélectionner tous les formateurs disponibles</button><button class="btn btn-charter"><i class="bi bi-send me-2"></i>Demander la signature</button></div></form>{% endif %}
<section class="charter-panel"><div class="charter-actions mb-4"><h2 class="me-auto mb-0">État des signatures</h2><label for="signatureFilter" class="visually-hidden">Filtrer les signatures</label><select id="signatureFilter" class="form-select w-auto"><option value="">Tous les formateurs</option><option value="signed">Signés</option><option value="pending">À signer</option><option value="outdated">Ancienne version signée</option><option value="missing">Non demandés</option></select><a class="btn btn-outline-secondary" href="{{ path('app_charter_export',{entite:entite.id,id:v.id}) }}">Télécharger le dossier ZIP</a></div><div class="table-responsive"><table class="charter-table"><thead><tr><th>Formateur</th><th>État de cette version</th><th>Demandée le</th><th>Signée le</th><th>Documents</th></tr></thead><tbody>{% for row in rows %}<tr data-signature-state="{{ row.status }}"><td><strong>{{ row.name }}</strong><br><span class="charter-muted">{{ row.trainer.utilisateur ? row.trainer.utilisateur.email : 'Compte à associer' }}</span></td><td><span class="charter-badge {{ row.status }}">{{ {signed:'Signée',pending:'À signer',outdated:'Ancienne version signée',missing:'Non demandée'}[row.status] }}</span>{% if row.older %}<div class="charter-muted">Dernière signature antérieure : v{{ row.older.version.number }}</div>{% endif %}</td><td>{{ row.signature ? row.signature.requestedAt|date('d/m/Y H:i') : '—' }}</td><td>{{ row.signature and row.signature.signedAt ? row.signature.signedAt|date('d/m/Y H:i') : '—' }}</td><td>{% if row.signature and row.signature.signedAt %}<a class="btn btn-outline-secondary" href="{{ path('app_charter_signed_pdf',{entite:entite.id,id:row.signature.id}) }}">PDF signé</a>{% elseif row.older %}<a href="{{ path('app_charter_signed_pdf',{entite:entite.id,id:row.older.id}) }}">Ancien PDF signé</a>{% else %}—{% endif %}</td></tr>{% else %}<tr><td colspan="5">Aucun formateur enregistré.</td></tr>{% endfor %}</tbody></table></div></section>
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script><script>
(()=>{const el=document.getElementById('charterTrainers');let select=el?.tomselect||null;if(el&&window.TomSelect&&!select)select=new TomSelect(el,{plugins:['remove_button'],placeholder:'Rechercher un formateur…',maxOptions:null});document.getElementById('selectAllTrainers')?.addEventListener('click',()=>{if(select)select.setValue(Object.keys(select.options));else if(el)[...el.options].forEach(o=>o.selected=true);});document.getElementById('signatureFilter').addEventListener('change',e=>document.querySelectorAll('[data-signature-state]').forEach(row=>row.hidden=!!e.target.value&&row.dataset.signatureState!==e.target.value));})();
</script>
{% endblock %}
