{% extends 'security/auth_base.html.twig' %}
{% block title %}{{ 'auth.register.meta.title'|trans }}{% endblock %}
{% block intro %}<h1>Un nouvel espace.<br><span>De nouvelles possibilités.</span></h1><p>Créez votre compte et retrouvez les outils pour organiser, accompagner et développer votre activité de formation.</p><ol class="auth-steps"><li><span class="step-current">1</span><div><strong>Créez votre compte</strong><small>Quelques informations pour faire connaissance</small></div></li><li><span class="step-check">2</span><div><strong>Validez votre e-mail</strong><small>Un lien de confirmation dans votre messagerie</small></div></li><li><span class="step-check">3</span><div><strong>Rejoignez votre espace</strong><small>Retrouvez les services adaptés à votre activité</small></div></li></ol>{% endblock %}
{% block account_form %}<span class="eyebrow">BIENVENUE SUR WIKIFORMATION</span><h2 id="auth-title">Créez votre compte</h2><p class="form-description">Votre première étape vers une formation mieux organisée.</p>
            {{ form_start(registrationForm, {attr: {'data-turbo': 'false'}}) }}
                {% if registrationForm.vars.submitted and not registrationForm.vars.valid %}
                    <div class="alert alert-danger" role="alert" tabindex="-1" id="registration-errors">
                        <strong>L’inscription n’a pas pu être enregistrée.</strong>
                        <p class="mb-0">Vérifiez les messages sous les champs. Si vous possédez déjà un compte, connectez-vous ou réinitialisez votre mot de passe.</p>
                        {{ form_errors(registrationForm) }}
                    </div>
                {% endif %}
                {{ form_row(registrationForm.prenom) }}
                {{ form_row(registrationForm.nom) }}
                {{ form_row(registrationForm.email) }}

                {{ form_errors(registrationForm.password) }}
                <div class="mb-3 position-relative">
                    {{ form_label(registrationForm.password.first) }}
                    <div class="input-group">
                        {{ form_widget(registrationForm.password.first, {
                            'attr': {
                                'class': 'form-control password-first' ~ (registrationForm.password.first.vars.errors|length > 0 ? ' is-invalid' : '')
                            }
                        }) }}
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target=".password-first" aria-label="{{ 'auth.register.show_password'|trans }}">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    {% for error in registrationForm.password.first.vars.errors %}
                        <div class="invalid-feedback">{{ error.message }}</div>
                    {% endfor %}
                </div>

                <div class="mb-3 position-relative">
                    {{ form_label(registrationForm.password.second) }}
                    <div class="input-group">
                        {{ form_widget(registrationForm.password.second, {
                            'attr': {
                                'class': 'form-control password-second' ~ (registrationForm.password.second.vars.errors|length > 0 ? ' is-invalid' : '')
                            }
                        }) }}
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target=".password-second" aria-label="{{ 'auth.register.show_password'|trans }}">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    {% for error in registrationForm.password.second.vars.errors %}
                        <div class="invalid-feedback">{{ error.message }}</div>
                    {% endfor %}
                </div>

                <p class="small text-muted" data-privacy-notice="account">IT FOR YOU utilise votre identité et votre e-mail pour créer et sécuriser votre compte et fournir le service demandé. Ces données sont nécessaires à la relation contractuelle ; la prise de connaissance de la notice n’est pas une autorisation de prospection. La newsletter est facultative et peut être désactivée dans votre espace de confidentialité ou auprès de contact@wikiformation.fr. Pour les destinataires, la conservation et vos droits, consultez la politique ci-dessous.</p>
                <div class="mb-3">
                    {% for consent in [registrationForm.consentementRgpd, registrationForm.newsletter] %}
                        <div class="auth-consent">
                            <div class="auth-consent-line">
                                {{ form_widget(consent) }}
                                {% if consent.vars.name == 'consentementRgpd' %}
                                    {{ form_label(consent, null, {label_translation_parameters: {'%policy_url%': (public_branding().hasCustomHost ? 'https://wikiformation.fr' : '') ~ path('app_public_politique_confidentialite')}}) }}
                                {% else %}
                                    {{ form_label(consent) }}
                                {% endif %}
                            </div>
                            {{ form_errors(consent) }}
                        </div>
                    {% endfor %}
                </div>

                <button type="submit" class="verify-button mt-3">{{ 'auth.register.submit'|trans }}</button>
            {{ form_end(registrationForm) }}<div class="resend-box"><p>{{ 'auth.register.already_account.title'|trans }}</p><a class="resend-button" href="{{ path('app_login') }}">{{ 'auth.register.login'|trans }} →</a></div>
{% endblock %}
{% block account_scripts %}<script>
document.getElementById('registration-errors')?.focus();
// Afficher/masquer les mots de passe (identique visuel)
document.querySelectorAll('.toggle-password').forEach(button => {
  button.addEventListener('click', function () {
    const input = document.querySelector(this.dataset.target);
    const icon = this.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.remove('bi-eye');
      icon.classList.add('bi-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.remove('bi-eye-slash');
      icon.classList.add('bi-eye');
    }
  });
});

// Aides de complexité (identique visuel, textes traduits côté Twig)
const passwordInput = document.querySelector('.password-first');
const confirmPasswordInput = document.querySelector('.password-second'); // <-- correction discrète

if (passwordInput) {
  const passwordCriteria = document.createElement('div');
  passwordCriteria.classList.add('text-muted', 'small', 'mt-2');
  passwordCriteria.innerHTML = `
    <ul class="mb-0">
      <li id="length" class="text-danger">{{ 'auth.register.criteria.length'|trans }}</li>
      <li id="uppercase" class="text-danger">{{ 'auth.register.criteria.uppercase'|trans }}</li>
      <li id="number" class="text-danger">{{ 'auth.register.criteria.number'|trans }}</li>
    </ul>
  `;
  passwordInput.parentNode.parentNode.appendChild(passwordCriteria);

  passwordInput.addEventListener('input', () => {
    const value = passwordInput.value;
    document.getElementById('length').className = value.length >= 8 ? 'text-success' : 'text-danger';
    document.getElementById('uppercase').className = /[A-Z]/.test(value) ? 'text-success' : 'text-danger';
    document.getElementById('number').className = /\d/.test(value) ? 'text-success' : 'text-danger';
  });
}

if (confirmPasswordInput && passwordInput) {
  confirmPasswordInput.addEventListener('input', () => {
    if (confirmPasswordInput.value !== passwordInput.value) {
      confirmPasswordInput.classList.add('is-invalid');
    } else {
      confirmPasswordInput.classList.remove('is-invalid');
    }
  });
}
</script>{% endblock %}
