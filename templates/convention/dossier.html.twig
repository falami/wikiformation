{% extends 'base_admin.html.twig' %}
{% block title %}Dossier · {{ c.numero }}{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }



    .dossier-page{max-width:1380px;margin:auto;padding:30px 26px 48px;color:#233b4c;font-size:14px}
    .dossier-breadcrumb{display:flex;gap:12px;align-items:center;color:#718293;font-size:12px;margin-bottom:20px}.dossier-breadcrumb span{color:#bdc8d0}
    .dossier-hero{padding:34px 36px 0;border-radius:24px;background:linear-gradient(115deg,#1c3243,#304f60);color:#fff;border-top:3px solid #d9b45a;margin-bottom:28px;box-shadow:0 14px 36px #20374712}
    .dossier-eyebrow{font-size:10px;letter-spacing:2px;color:#ebce84;font-weight:700}.dossier-hero h1{font-size:clamp(23px,2.3vw,34px);font-weight:750;line-height:1.3;max-width:1000px;margin:14px 0 23px;overflow-wrap:anywhere}
    .dossier-meta{display:flex;gap:12px 24px;flex-wrap:wrap;color:#d6e2e9;font-size:12px}.dossier-meta span{display:flex;align-items:center;gap:8px}.dossier-hero-bottom{display:flex;justify-content:space-between;align-items:center;gap:16px;border-top:1px solid #ffffff20;margin-top:26px;padding:17px 0;color:#c5d5df;font-size:12px}.dossier-hero-bottom i{margin-right:8px}.dossier-hero-status{color:#f0d892;white-space:nowrap}
    .dossier-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:24px;align-items:start}.dossier-main,.dossier-aside{display:grid;gap:22px;min-width:0}
    .dossier-panel{background:#fff;border:1px solid #e1e8ee;border-radius:20px;padding:25px;box-shadow:0 5px 20px #233b4c04}.dossier-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:20px}.dossier-kicker{display:block;font-size:9px;font-weight:750;letter-spacing:1.5px;color:#8795a2;margin-bottom:8px}.dossier-page h2{font-size:20px;line-height:1.3;font-weight:750;margin:0}.dossier-page h3{font-size:14px;font-weight:700;margin:0 0 5px}.dossier-page p{line-height:1.65}
    .dossier-doc{display:flex;align-items:center;gap:15px;border-top:1px solid #edf1f4;padding:19px 0}.dossier-doc:last-child{padding-bottom:0}.dossier-doc>div{flex:1;min-width:0}.dossier-doc p{font-size:12px;color:#758696;margin:0}.dossier-icon{display:grid;place-items:center;flex-shrink:0;width:43px;height:48px;background:#f1f5f8;color:#557185;border-radius:12px;font-size:21px}
    .dossier-tag,.dossier-state{display:inline-block;border-radius:7px;padding:5px 9px;font-size:10px;font-weight:650;white-space:nowrap}.dossier-tag{background:#f3f6f8;color:#708392}.is-ready{background:#eaf6f0;color:#29755e}.is-pending{background:#fff3d9;color:#93671b}.dossier-count{background:#eff3f6;border-radius:9px;padding:6px 11px;font-size:13px;font-weight:700}
    .dossier-people{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.dossier-person{display:flex;align-items:center;gap:12px;padding:15px;background:#f8fafb;border:1px solid #edf1f4;border-radius:12px}.dossier-avatar{width:38px;height:38px;display:grid;place-items:center;flex-shrink:0;background:#e9eff4;color:#4c6980;border-radius:50%;font-weight:750}.dossier-person p{font-size:11px;margin:0}.dossier-person h3{overflow-wrap:anywhere}.dossier-ready{color:#327f68}.dossier-pending{color:#9a7638}
    .dossier-attention{padding:24px;border:1px solid #eee0be;background:#fffcf5;border-radius:20px}.dossier-attention h2{font-size:17px}.dossier-attention .dossier-kicker{color:#a08445}.dossier-attention ul{margin:0;padding-left:20px;color:#826631;font-size:12px;line-height:1.7}.dossier-attention li+li{margin-top:8px}
    .dossier-download{padding:27px;background:#f2f6f8;border:1px solid #dfe8ed;border-radius:20px}.dossier-download-icon{display:grid;place-items:center;width:55px;height:55px;background:#fff;border-radius:16px;font-size:28px;color:#385e74;margin-bottom:25px;box-shadow:0 6px 16px #233b4c08}.dossier-download h2{font-size:25px;letter-spacing:-.6px;margin-bottom:14px}.dossier-download p{font-size:12px;color:#718492;margin-bottom:23px}.dossier-download-button{display:flex;align-items:center;justify-content:center;gap:9px;padding:14px 10px;border-radius:11px;background:#233e50;color:#fff;text-decoration:none;font-weight:650;font-size:13px;box-shadow:0 6px 14px #233e5020}.dossier-download-button:hover{background:#31566d;color:#fff}.dossier-download-button:focus-visible{outline:3px solid #d9b45a;outline-offset:4px}.dossier-download-meta{text-align:center;font-size:10px;color:#7b8e9b;margin-top:13px}.dossier-help h2{font-size:15px;margin-bottom:14px}.dossier-help p{font-size:12px;color:#7a8b98}.dossier-help p:last-child{margin-bottom:0}
    @media(max-width:1100px){.dossier-layout{grid-template-columns:minmax(0,1fr) 290px}.dossier-people{grid-template-columns:1fr}.dossier-doc{flex-wrap:wrap}.dossier-doc>.dossier-tag,.dossier-doc>.dossier-state{margin-left:58px}}
    @media(max-width:800px){.dossier-page{padding:20px 12px}.dossier-layout{grid-template-columns:1fr}.dossier-hero{padding:25px 22px 0}.dossier-hero-bottom{align-items:start;flex-direction:column}.dossier-panel{padding:20px}.dossier-heading{flex-wrap:wrap}.dossier-aside{grid-row:1}.dossier-download-icon{display:none}.dossier-download h2 br{display:none}.dossier-breadcrumb{flex-wrap:wrap}}
  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
{% endblock %}
{% block body %}
{% set downloadUrl = path(admin ? 'app_administrateur_convention_dossier' : 'app_entreprise_documents_convention_dossier', {entite:entite.id,id:c.id,download:1}|merge(admin ? {} : {entreprise:c.entreprise.id})) %}
<div class="dossier-page">
  <div class="dossier-breadcrumb"><i class="bi bi-folder2-open"></i> Documents de formation <span>/</span> {{ c.numero }}</div>
  <header class="dossier-hero">
    <div class="dossier-eyebrow">VOTRE DOSSIER DE FORMATION</div>
    <h1>{{ c.intituleFormationEffectif }}</h1>
    <div class="dossier-meta"><span><i class="bi bi-building"></i>{{ c.entreprise.raisonSociale }}</span><span><i class="bi bi-calendar3"></i>{{ c.session.code }}</span><span><i class="bi bi-file-earmark-text"></i>{{ c.numero }}</span></div>
    <div class="dossier-hero-bottom"><span><i class="bi bi-collection"></i> Les documents de votre convention, réunis dans un dossier.</span><span class="dossier-hero-status">{{ inventory.warnings|length ? 'Points à vérifier' : 'Documents disponibles' }}</span></div>
  </header>
  {% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
  <div class="dossier-layout">
    <main class="dossier-main">
      <section class="dossier-panel">
        <div class="dossier-heading"><div><span class="dossier-kicker">CONTENU DU DOSSIER</span><h2>Vos documents</h2></div><span class="dossier-tag">Archive ZIP · PDF</span></div>
        <div class="dossier-doc"><span class="dossier-icon"><i class="bi bi-file-earmark-pdf"></i></span><div><h3>Convention de formation</h3><p>Le document contractuel rattaché à votre entreprise.</p></div><span class="dossier-state {{ c.signed ? 'is-ready' : 'is-pending' }}">{{ c.signed ? 'Signée' : 'Non signée' }}</span></div>
        {% if not c.session.sousTraitance %}
        <div class="dossier-doc"><span class="dossier-icon"><i class="bi bi-pen"></i></span><div><h3>Émargements individuels</h3><p>Un PDF par participant, avec les signatures des formateurs.</p></div><span class="dossier-tag">Par stagiaire</span></div>
        <div class="dossier-doc"><span class="dossier-icon"><i class="bi bi-chat-square-text"></i></span><div><h3>Appréciations des stagiaires</h3><p>Les questionnaires soumis par les participants.</p></div><span class="dossier-state is-ready">{{ inventory.assignments|length }} / {{ inventory.people|length }} participants</span></div>
        {% endif %}
        <div class="dossier-doc"><span class="dossier-icon"><i class="bi bi-file-earmark-check"></i></span><div><h3>Documents de fin de formation et factures</h3><p>Attestations délivrées, avis post-formation, titres d’habilitation signés et factures rattachées, selon disponibilité.</p></div></div>
        <div class="dossier-doc"><span class="dossier-icon"><i class="bi bi-list-check"></i></span><div><h3>Inventaire du dossier</h3><p>La liste des documents et les points restant à vérifier.</p></div><span class="dossier-tag">Inclus</span></div>
      </section>
      <section class="dossier-panel">
        <div class="dossier-heading"><div><span class="dossier-kicker">SUIVI INDIVIDUEL</span><h2>Participants rattachés</h2></div><span class="dossier-count">{{ inventory.people|length }}</span></div>
        <div class="dossier-people">{% for key, name in inventory.people %}<div class="dossier-person"><span class="dossier-avatar">{{ name|slice(0,1)|upper }}</span><div><h3>{{ name }}</h3><p>{% if c.session.sousTraitance %}Suivi géré par le donneur d’ordre{% elseif inventory.assignments[key] is defined %}<span class="dossier-ready"><i class="bi bi-check-circle-fill"></i> Appréciation disponible</span>{% else %}<span class="dossier-pending"><i class="bi bi-clock"></i> Appréciation non disponible</span>{% endif %}</p></div></div>{% else %}<p class="dossier-note">Aucun participant identifié dans cette convention.</p>{% endfor %}</div>
      </section>
      {% if not admin %}
      <section class="dossier-panel"><h2 class="mb-3">Télécharger les dossiers des participants</h2>
      {% for inscription in c.inscriptions %}
        <p><a href="{{ path('app_entreprise_documents_inscription_archive', {entite:entite.id, entreprise:c.entreprise.id, id:inscription.id, scope:'stagiaire'}) }}"><i class="bi bi-download"></i> {{ inscription.stagiaire.prenom }} {{ inscription.stagiaire.nom }} — dossier complet</a></p>
      {% endfor %}
      {% if c.inscriptions|length %}
        <a class="dossier-download-button" href="{{ path('app_entreprise_documents_inscription_archive', {entite:entite.id, entreprise:c.entreprise.id, id:(c.inscriptions|first).id, scope:'session'}) }}">Télécharger toute la session (ZIP)</a>
        <p class="mt-2 small">Tous les participants et documents rattachés à votre entreprise dans cette session.</p>
      {% endif %}
      </section>
      {% endif %}
      {% if inventory.warnings|length %}<section class="dossier-attention"><div class="dossier-heading"><div><span class="dossier-kicker">AVANT DE PARTAGER LE DOSSIER</span><h2><i class="bi bi-info-circle"></i> Points à vérifier</h2></div><span class="dossier-count">{{ inventory.warnings|length }}</span></div><ul>{% for warning in inventory.warnings %}<li>{{ warning }}</li>{% endfor %}</ul></section>{% endif %}
    </main>
    <aside class="dossier-aside">
      <section class="dossier-download"><span class="dossier-download-icon"><i class="bi bi-cloud-arrow-down"></i></span><span class="dossier-kicker">TOUT EN UN SEUL FICHIER</span><h2>Votre dossier,<br>prêt à télécharger.</h2><p>Retrouvez les documents actuellement disponibles dans une archive organisée.</p><a class="dossier-download-button" href="{{ downloadUrl }}"><i class="bi bi-download"></i> Télécharger le dossier</a><div class="dossier-download-meta">Format ZIP · Documents PDF</div></section>
      <section class="dossier-panel dossier-help"><h2><i class="bi bi-info-circle"></i> À savoir</h2><p>Le dossier reflète les signatures et appréciations actuellement enregistrées.</p>{% if c.session.sousTraitance %}<p>Session en sous-traitance : émargements et appréciations gérés par le donneur d’ordre.</p>{% else %}<p>Les signatures absentes restent visibles sous forme de cases vides. Les appréciations non soumises ne sont pas ajoutées.</p>{% endif %}</section>
      {% if admin %}<section class="dossier-panel dossier-help"><h2 class="h5">Transmettre à l’entreprise</h2><p class="text-muted small">Le destinataire est l’adresse enregistrée sur l’entreprise de cette convention.</p><strong class="text-break mb-3">{{ recipient ?: 'Adresse email non renseignée' }}</strong>
      {% if not inventory.finished %}<div class="alert alert-info small">L’envoi sera disponible à l’issue de la session.</div>{% endif %}
      <form method="post"><input type="hidden" name="_token" value="{{ csrf_token('send_dossier_' ~ c.id) }}"><div class="form-check my-3"><input id="reviewed" class="form-check-input" type="checkbox" name="reviewed" value="1" required {{ not canSend ? 'disabled' : '' }}><label class="form-check-label small" for="reviewed">J’ai vérifié le dossier et le destinataire.</label></div><button class="btn btn-warning w-100" {{ not canSend ? 'disabled' : '' }}><i class="bi bi-send me-2"></i>Envoyer par email</button></form>
      <p class="small text-muted mt-3 mb-0">L’email contient l’archive et un lien vers l’espace entreprise. Chaque envoi est journalisé.</p>
</section>{% endif %}
    </aside>
  </div>
</div>
{% endblock %}
