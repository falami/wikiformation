{% extends 'base_admin.html.twig' %}
{% block title %}Mes QCM{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.2.2/datatables.min.css">
  {% include 'stagiaire/partials/_questionnaire_list_styles.html.twig' %}
  <link rel="stylesheet" href="{{ asset('dist/css/premium-lists.css') }}?v=20261107-accent-2">
{% endblock %}

{% block body %}
  {% set todo = 0 %}
  {% set done = 0 %}
  {% set review = 0 %}
  {% for a in assignments %}
    {% if a.isSubmitted %}{% set done = done + 1 %}{% else %}{% set todo = todo + 1 %}{% endif %}
    {% if a.status.value == 'review_required' %}{% set review = review + 1 %}{% endif %}
  {% endfor %}

  <div class="entity-hero hero qcm-list-hero p-3 mb-4">

    <div class="w-100">
      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
          <div class="entity-hero-label"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i> Questionnaires de niveau</div>
          <h2 class="m-0 fw-bold"><i class="bi bi-ui-checks-grid me-2" style="color:var(--theme-color-secondaire)"></i>Mes QCM</h2>
          <div class="opacity-75 mt-1">Retrouvez vos questionnaires de niveau et suivez vos résultats en début et en fin de formation.</div>
          <div class="d-flex flex-wrap gap-2 mt-3">
            <span class="chip"><i class="bi bi-building"></i> {{ entite.nom ?? '—' }}</span>
            <span class="chip"><i class="bi bi-mortarboard"></i> Stagiaire</span>
            <span class="chip"><i class="bi bi-ui-checks"></i> QCM</span>
            <span class="chip chip--pill"><i class="bi bi-clock-history"></i> <span id="hero-last-refresh">—</span></span>
          </div>
        </div>
        <a href="{{ path('app_stagiaire_qcm_index', {entite: entite.id}) }}" class="btn btn-outline-theme btn-sm fw-semibold">
          <i class="bi bi-arrow-repeat me-1"></i> Actualiser
        </a>
      </div>
    </div>
  </div>

  {% include 'flagMessage.html.twig' %}

  <div class="row g-3 mb-4">
    {% for metric in [
      {label: 'Questionnaires', value: assignments|length, icon: 'files'},
      {label: 'À faire', value: todo, icon: 'hourglass-split'},
      {label: 'Soumis', value: done, icon: 'check2-circle'},
      {label: 'À revoir par l’équipe', value: review, icon: 'exclamation-triangle'}
    ] %}
      <div class="col-12 col-md-6 col-xl-3">
        <div class="kpi h-100">
          <div class="kpi-ico"><i class="bi bi-{{ metric.icon }}"></i></div>
          <div><div class="label">{{ metric.label }}</div><div class="value">{{ metric.value }}</div></div>
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="toolbar d-flex flex-wrap gap-2 align-items-center mb-4 catalogue-filters wf-filters-theme">
    <div class="me-auto d-flex flex-wrap gap-2 align-items-center">
      <label for="qcmStatusFilter" class="pill"><i class="bi bi-funnel"></i> Statut</label>
      <select id="qcmStatusFilter" class="form-select form-select-sm" style="max-width:220px;">
        <option value="all">Tous</option>
        <option value="todo">À faire</option>
        <option value="started">En cours</option>
        <option value="done">Soumis</option>
        <option value="validated">Validés</option>
        <option value="review_required">À revoir par l’équipe</option>
      </select>
      <span class="soft-badge ms-1"><i class="bi bi-search"></i> Recherche dans la table</span>
    </div>
    <button id="qcmReset" class="btn btn-outline-secondary btn-sm fw-semibold" type="button"><i class="bi bi-arrow-counterclockwise"></i> Réinitialiser</button>
  </div>

  <div class="table-card premium-list mb-4">
    {% include 'components/_premium_list_heading.html.twig' with {
      title: 'Mes questionnaires de niveau', subtitle: 'Retrouvez vos QCM, consultez vos scores et poursuivez les questionnaires à compléter.', mark: 'QCM'
    } only %}
    <div class="table-responsive">
      <table id="table-qcm" class="premium-table table table-hover align-middle mb-0 w-100">
        <thead><tr>
          <th>Session</th><th>Questionnaire</th><th>Phase</th><th>Statut</th><th>Score</th><th>Soumis le</th><th class="text-end">Action</th>
        </tr></thead>
        <tbody>
          {% for a in assignments %}
            {% set status = a.status.value %}
            {% set comp = a.session ? comparisons[a.session.id]|default(null) : null %}
            {% set submitted = a.isSubmitted %}
            {% set badge = status == 'validated' ? 'badge-success' : (status in ['started', 'review_required'] ? 'badge-warn' : 'badge-muted') %}
            <tr data-status="{{ status }}" data-done="{{ submitted ? '1' : '0' }}">
              <td>{{ a.session ? a.session.label : 'Hors session' }}</td>
              <td class="fw-semibold">{{ a.qcm.titre }}</td>
              <td>{{ a.phase.label }}</td>
              <td><span class="badge-pill {{ badge }}">{{ status == 'assigned' ? 'À faire' : (status == 'review_required' ? 'À revoir par l’équipe' : a.status.label) }}</span></td>
              <td data-order="{{ a.attempt ? a.attempt.scorePercent|default(0) : -1 }}">
                {% if a.attempt %}
                  <strong>{{ a.attempt.scorePoints }}/{{ a.attempt.maxPoints }}</strong>
                  <span class="text-muted">({{ a.attempt.scorePercent }} %)</span>
                {% else %}
                  <span class="text-muted">Après soumission</span>
                {% endif %}
                {% if comp and comp.ready and a.phase.value == 'post' %}
                  <div class="small mt-1 {{ comp.trend == 'up' ? 'text-success' : (comp.trend == 'down' ? 'text-danger' : 'text-muted') }}">
                    <i class="bi bi-{{ comp.trend == 'up' ? 'arrow-up-right' : (comp.trend == 'down' ? 'arrow-down-right' : 'dash') }}"></i>
                    {{ comp.delta > 0 ? '+' : '' }}{{ comp.delta }} points par rapport au début
                  </div>
                {% endif %}
                {% if comp and comp.actionRequired and a.phase.value == 'post' %}
                  <div class="small text-danger mt-1"><i class="bi bi-exclamation-triangle"></i> Plan d’action requis</div>
                {% endif %}
              </td>
              {% set submittedAt = a.attempt ? a.attempt.submittedAt : null %}
              <td data-order="{{ submittedAt ? submittedAt|date('U') : 0 }}">{{ submittedAt ? submittedAt|date('d/m/Y H:i') : '—' }}</td>
              <td class="text-end">
                <a class="btn btn-action btn-sm" href="{{ path('app_stagiaire_qcm_show', {id: a.id, entite: entite.id}) }}">
                  <i class="bi bi-{{ submitted ? 'eye' : (status == 'started' ? 'play-circle' : 'box-arrow-in-right') }}"></i>
                  {{ submitted ? 'Voir' : (status == 'started' ? 'Reprendre' : 'Commencer') }}
                </a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/v/bs5/dt-2.2.2/datatables.min.js"></script>
  <script src="{{ asset('dist/js/trainee-qcm-list.js') }}" defer></script>
  <script src="{{ asset('dist/js/premium-lists.js') }}" defer></script>
{% endblock %}
