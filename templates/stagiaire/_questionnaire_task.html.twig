<article class="learner-task">
  <div class="learner-task-top"><span class="learner-task-type">{{ task.type }}</span><span class="learner-task-status{{ task.started ? ' is-started' : '' }}">{{ task.started ? 'En cours' : 'À compléter' }}</span></div>
  <h3>{{ task.title }}</h3>
  <p class="learner-task-context">{{ task.phase }}{% if task.session %}<span>{{ task.session }}</span>{% endif %}</p>
  <div class="learner-task-bottom"><span class="learner-task-requirement">{{ task.required ? 'Requis' : 'Facultatif' }}</span><a href="{{ task.url }}" aria-label="{{ task.started ? 'Reprendre' : 'Commencer' }} : {{ task.title }}">{{ task.started ? 'Reprendre' : 'Commencer' }} <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
</article>
