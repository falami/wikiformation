
{# templates/stagiaire/supports.html.twig #}
{% extends 'base_admin.html.twig' %}
{% block title %}Mes supports — Stagiaire{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('dist/css/learner-supports.css') }}">
{% endblock %}

{% block body %}
<div class="container-fluid py-4 learner-supports">
  <header class="entity-hero supports-hero">
    <div>
      <span class="supports-eyebrow">VOTRE BIBLIOTHÈQUE DE FORMATION</span>
      <h1>Mes supports</h1>
      <p>Les ressources pour apprendre, pratiquer et aller plus loin.</p>
      <span class="supports-session"><i class="bi bi-book" aria-hidden="true"></i> {{ session.code }}</span>
    </div>
    <a class="supports-back" href="{{ path('app_stagiaire_dashboard', { entite: entite.id }) }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Tableau de bord</a>
  </header>

  <section class="supports-library" aria-labelledby="library-title">
    <div class="supports-library-heading">
      <div><span class="supports-eyebrow">RESSOURCES PÉDAGOGIQUES</span><h2 id="library-title">Vos documents, à portée de main</h2><p>Retrouvez les supports partagés pour votre session.</p></div>
      <span class="supports-count" aria-live="polite"><i class="bi bi-files" aria-hidden="true"></i> <span id="count">—</span> document(s)</span>
    </div>
    <div class="supports-toolbar">
      <label class="supports-search" for="q"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Rechercher un support</span><input id="q" type="search" placeholder="Rechercher un titre, une session…" autocomplete="off"></label>
      <span class="supports-hint"><i class="bi bi-download" aria-hidden="true"></i> Consultez vos supports à tout moment</span>
    </div>
    <div id="assets" class="supports-grid" aria-live="polite" aria-busy="true">
      <div class="supports-empty"><span class="spinner-border spinner-border-sm" role="status"></span><p>Chargement de vos supports…</p></div>
    </div>
  </section>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function(){
  function initSupports(){
    const wrap  = document.getElementById('assets');
    const q     = document.getElementById('q');
    const count = document.getElementById('count');

    // ✅ si on n'est pas sur la bonne page, on sort sans crash
    if (!wrap || !q || !count) return;

    // évite double init (Turbo)
    if (wrap.dataset.init === '1') return;
    wrap.dataset.init = '1';

    let rows = [], filtered = [];

    function render(list){
      wrap.innerHTML = '';
      if(!list.length){
        const searching = q.value.trim().length > 0;
        wrap.innerHTML = searching
          ? '<div class="supports-empty"><div class="supports-empty-icon"><i class="bi bi-search"></i></div><h3>Aucun résultat pour cette recherche</h3><p>Essayez un autre titre ou effacez votre recherche pour retrouver tous vos supports.</p><button type="button" class="supports-reset">Effacer la recherche</button></div>'
          : '<div class="supports-empty"><div class="supports-empty-icon"><i class="bi bi-journal-bookmark"></i></div><span class="supports-eyebrow">VOTRE ESPACE EST PRÊT</span><h3>Vos prochains supports vous attendront ici</h3><p>Aucun document n’a encore été partagé pour cette session.<br>Vous retrouverez ici les ressources mises à votre disposition par votre organisme.</p></div>';
        wrap.querySelector('.supports-reset')?.addEventListener('click', () => { q.value = ''; applyFilter(); q.focus(); });
        return;
      }

      list.forEach(a=>{
        const col = document.createElement('div');
        col.className = 'support-card';

        const name = a.titre || a.originalName || 'Document';
        const meta = [a.mimeType||'', a.sessionCode?('Session '+a.sessionCode):'', a.sessionTitle||'']
          .filter(Boolean).join(' · ');

        col.innerHTML = `
            <div class="support-card-top"><div class="support-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></div><span>SUPPORT DE FORMATION</span></div>
            <h3 class="name"></h3>
            <p class="support-meta"></p>
            <a class="support-open" target="_blank" rel="noopener noreferrer">
              Consulter le document <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
            </a>`;
        col.querySelector('.name').textContent = name;
        col.querySelector('.name').title = name;
        col.querySelector('.support-meta').textContent = meta;
        col.querySelector('a').href = a.url;
        col.querySelector('a').setAttribute('aria-label', 'Consulter ' + name + ' (nouvel onglet)');
        wrap.appendChild(col);
      });
    }

    function applyFilter(){
      const s = q.value.trim().toLowerCase();
      filtered = !s ? rows : rows.filter(a=>{
        const t  = (a.titre||a.originalName||'').toLowerCase();
        const sc = (a.sessionCode||'').toLowerCase();
        const st = (a.sessionTitle||'').toLowerCase();
        return t.includes(s) || sc.includes(s) || st.includes(s);
      });
      count.textContent = filtered.length;
      render(filtered);
    }

    // ✅ si tu es bien sur /session/{id}/supports, session existe
    const feedUrl = "{{ path('app_stagiaire_session_supports_feed', { entite: entite.id, id: session.id }) }}";

    function loadSupports(){
    wrap.setAttribute('aria-busy', 'true');
    fetch(feedUrl, { headers: { 'Accept': 'application/json' } })
      .then(r => r.ok ? r.json() : Promise.reject(r))
      .then(p => {
        rows = Array.isArray(p?.data) ? p.data : [];
        count.textContent = rows.length;
        applyFilter();
      })
      .catch(() => {
        count.textContent = '—';
        wrap.innerHTML = '<div class="supports-empty"><div class="supports-empty-icon"><i class="bi bi-cloud-slash"></i></div><h3>Vos supports n’ont pas pu être chargés</h3><p>Réessayez dans un instant pour accéder à vos documents.</p><button type="button" class="supports-reset">Réessayer</button></div>';
        wrap.querySelector('button').addEventListener('click', loadSupports);
      }).finally(() => wrap.setAttribute('aria-busy', 'false'));
    }
    loadSupports();

    q.addEventListener('input', applyFilter);
  }

  document.addEventListener('DOMContentLoaded', initSupports);
  document.addEventListener('turbo:load', initSupports); // ✅ si Symfony UX Turbo
})();
</script>
{% endblock %}

