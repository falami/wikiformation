<section class="ev-card"><div class="ev-card-head"><h2>Test théorique</h2></div><div class="ev-card-body">{% for q in template.schema.theory|default([]) %}<article class="ev-question"><h3>{{ loop.index }}. {{ q.label }}</h3><p class="ev-muted">{{ q.points }} points · {{ q.type == 'text' ? 'Réponse libre' : (q.type == 'order' ? 'Classement' : 'Choix de réponses') }}</p>{% for option in q.options|default([]) %}<p>{{ option.label }} {% if option.id in q.correct|default([]) %}<span class="ev-badge ev-badge-success">{{ q.type == 'order' ? 'Ordre : ' ~ (q.correct|keys|filter(k => q.correct[k] == option.id)|first + 1) : 'Réponse attendue' }}</span>{% endif %}</p>{% endfor %}</article>{% endfor %}</div></section>
<section class="ev-card"><div class="ev-card-head"><h2>Grille pratique</h2></div><div class="ev-card-body">{% for item in template.schema.practice|default([]) %}<article class="ev-question"><h3>{{ loop.index }}. {{ item.label }}</h3><p>{{ item.points }} points {% if item.critical %}· Critère éliminatoire{% endif %} {% if item.allowNa %}· Non applicable autorisé{% endif %}</p></article>{% endfor %}</div></section>
