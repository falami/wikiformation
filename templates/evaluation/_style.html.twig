r-bottom:0}.ev-table tbody tr:hover{background:color-mix(in srgb,var(--ev-accent) 5%,#fff)}.ev-table a:not(.ev-btn){color:var(--ev-ink);font-weight:700;text-decoration:none}.ev-table td small{display:block;color:#647787;margin-top:3px}.ev-empty{padding:50px 25px;text-align:center;color:#687988}.ev-empty i{font-size:30px;display:block;color:var(--ev-ink);margin-bottom:15px}.ev-field{margin-bottom:19px}.ev-label{display:block;font-size:13px;font-weight:700;margin-bottom:7px}.ev-input,.ev-shell input:not([type=checkbox]):not([type=radio]):not([type=hidden]),.ev-shell select,.ev-shell textarea{width:100%;border:1px solid var(--ev-line);border-radius:11px;padding:11px 13px;color:var(--ev-ink);background:#fff;font:inherit;min-height:44px}.ev-shell input[type=checkbox],.ev-shell input[type=radio]{accent-color:var(--ev-ink);width:18px;height:18px;vertical-align:middle;flex-shrink:0}.ev-shell textarea{min-height:95px;resize:vertical}.ev-shell input:focus,.ev-shell select:focus,.ev-shell textarea:focus{outline:2px solid color-mix(in srgb,var(--ev-accent) 65%,transparent);outline-offset:2px}.ev-alert{border:1px solid var(--ev-line);background:var(--ev-soft);border-radius:13px;padding:16px 20px;margin:18px 0;font-size:14px}.ev-section-title{margin:30px 0 16px;display:flex;justify-content:space-between;align-items:center;gap:15px}.ev-shell .alert{border-radius:13px}.ev-shell details>summary{cursor:pointer;font-weight:700}.ev-shell [hidden]{display:none!important}
