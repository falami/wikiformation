{% extends 'base_admin.html.twig' %}
{% block title %}Mes évaluations · Théorie et pratique{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">{% include 'evaluation/_style.html.twig' %}{% include 'evaluation/formateur/_form_style.html.twig' %}{% endblock %}
{% block body %}
<div class="ev-shell">
  <section class="ev-hero"><div class="ev-kicker">MON PARCOURS · VALIDATION DES ACQUIS</div><h1>Mes évaluations</h1><p>Votre test théorique, votre mise en pratique et vos résultats réunis au même endroit.</p><span class="ev-chip"><i class="bi bi-clipboard-check"></i> {{ dossiers|length }} évaluation{{ dossiers|length > 1 ? 's' : '' }}</span></section>
  <div class="ev-grid mt-4">
    {% for dossier in dossiers %}
      <article class="ev-card"><div class="ev-card-body">
        <div class="ev-dossier-title"><div><div class="ev-kicker">{{ dossier.session }}</div><h2>{{ dossier.title }}</h2></div><span class="ev-badge">{{ dossier.state == 'published' ? 'Résultats disponibles' : (dossier.state == 'to_review' ? 'En cours de validation' : 'À compléter') }}</span></div>
        <p class="ev-muted mt-3">{{ dossier.formation }}</p>
        <div class="ev-dossier-meta"><span><i class="bi bi-person-check"></i> {{ dossier.evaluator }}</span>{% if dossier.publishedAt %}<span><i class="bi bi-calendar-check"></i> {{ dossier.publishedAt|date('d/m/Y') }}</span>{% endif %}</div>
        <a class="ev-btn ev-btn-primary" href="{{ path('app_stagiaire_evaluation_show', {entite: entite.id, id: dossier.id}) }}">{{ dossier.state == 'published' ? 'Consulter mes résultats' : (dossier.state == 'to_review' ? 'Suivre mon évaluation' : 'Commencer le test') }} <i class="bi bi-arrow-right"></i></a>
      </div></article>
    {% else %}<div class="ev-card ev-empty ev-full"><i class="bi bi-mortarboard fs-1"></i><h2>Votre parcours se prépare</h2><p>Les évaluations théorie et pratique affectées par votre organisme apparaîtront ici.</p></div>{% endfor %}
  </div>
</div>
{% endblock %}
