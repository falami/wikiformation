{% extends 'base_admin.html.twig' %}
{% block title %}{{ dossier.title }} · Mon évaluation{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">{% include 'evaluation/_style.html.twig' %}{% include 'evaluation/formateur/_form_style.html.twig' %}{% endblock %}
{% block body %}
<div class="ev-shell">
  <div class="ev-toolbar mb-3"><a class="ev-tab-link" href="{{ path('app_stagiaire_evaluation_index', {entite: entite.id}) }}"><i class="bi bi-arrow-left"></i> Mes évaluations</a></div>
  <section class="ev-hero"><div class="ev-kicker">MON ÉVALUATION · {{ dossier.session }}</div><h1>{{ dossier.title }}</h1><p>{{ dossier.formation }}</p><div class="ev-toolbar"><span class="ev-chip"><i class="bi bi-person-check"></i> {{ dossier.evaluator }}</span><span class="ev-chip"><i class="bi bi-clipboard-check"></i> Théorie + pratique</span></div></section>
  {% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }} mt-3" role="status">{{ message }}</div>{% endfor %}{% endfor %}
  {% if error %}<div class="alert alert-danger mt-3" role="alert">{{ error }}{% if conflict %} <a href="{{ path('app_stagiaire_evaluation_show', {entite: entite.id, id: dossier.id}) }}">Recharger mon évaluation</a>{% endif %}</div>{% endif %}
  <div class="ev-steps"><div class="ev-step {{ dossier.state == 'assigned' ? 'active' : '' }}"><span class="ev-muted">01 · Mon test</span><strong>{{ dossier.submittedAt ? 'Transmis au formateur' : 'À compléter' }}</strong></div><div class="ev-step {{ dossier.state == 'to_review' ? 'active' : '' }}"><span class="ev-muted">02 · Avec mon formateur</span><strong>{{ dossier.state == 'published' ? 'Évaluation terminée' : 'Correction et pratique' }}</strong></div><div class="ev-step {{ dossier.state == 'published' ? 'active' : '' }}"><span class="ev-muted">03 · Mes résultats</span><strong>{{ dossier.state == 'published' ? 'Disponibles' : 'Après validation' }}</strong></div></div>

  {% if dossier.state == 'assigned' %}
    <form method="post" id="learner-evaluation"><input type="hidden" name="_token" value="{{ csrf_token('evaluation_submit_' ~ dossier.id) }}"><input type="hidden" name="version" value="{{ dossier.version }}">
      <div class="ev-workspace"><section class="ev-card"><div class="ev-card-head"><div><div class="ev-kicker">01 · À VOUS DE JOUER</div><h2>Votre test théorique</h2></div><span class="ev-badge">{{ dossier.questions|length }} questions</span></div><div class="ev-card-body"><p class="ev-muted mb-4">Prenez le temps de lire chaque question. Vos réponses seront transmises à votre formateur pour correction et validation.</p><fieldset {{ conflict ? 'disabled' : '' }}>
        {% for question in dossier.questions %}
          {% set selected = answers[question.id]|default(question.type == 'text' ? '' : []) %}
          <article class="ev-question" id="question-{{ question.id }}"><div class="ev-question-title"><h3 id="question-label-{{ question.id }}"><span class="ev-number">{{ '%02d'|format(loop.index) }}</span>{{ question.label }}</h3><span class="ev-points">{{ question.points }} point{{ question.points > 1 ? 's' : '' }}</span></div>
            {% if question.type == 'text' %}<label class="ev-field" for="answer-{{ question.id }}">Votre réponse</label><textarea id="answer-{{ question.id }}" class="ev-textarea" name="answers[{{ question.id }}]" rows="4" maxlength="10000">{{ selected is iterable ? '' : selected }}</textarea>
            {% elseif question.type == 'order' %}<p class="ev-muted">Classez les propositions de la première à la dernière étape, sans répétition.</p><div data-order-question>{% for option in question.options %}{% set position = loop.index0 %}<label class="ev-order-row"><span>{{ loop.index }}</span><select class="ev-select" name="answers[{{ question.id }}][]" aria-label="{{ question.label }} · Étape {{ loop.index }}" required><option value="">Choisir l’étape {{ loop.index }}</option>{% for choice in question.options %}<option value="{{ choice.id }}" {{ selected[position]|default('') == choice.id ? 'selected' : '' }}>{{ choice.label }}</option>{% endfor %}</select></label>{% endfor %}</div>
            {% else %}<p class="ev-muted">{{ question.type == 'multiple' ? 'Plusieurs réponses peuvent être sélectionnées.' : 'Une seule réponse possible.' }}</p><div role="group" aria-labelledby="question-label-{{ question.id }}">{% for option in question.options %}<label class="ev-choice"><input type="{{ question.type == 'single' ? 'radio' : 'checkbox' }}" name="answers[{{ question.id }}][]" value="{{ option.id }}" {{ selected is iterable and option.id in selected ? 'checked' : '' }}><span>{{ option.label }}</span></label>{% endfor %}</div>{% endif %}
          </article>
        {% endfor %}
      </fieldset></div></section>
      <aside class="ev-review-aside"><section class="ev-card"><div class="ev-card-head"><div><div class="ev-kicker">AVANT L’ENVOI</div><h2>Vérifier mes réponses</h2></div></div><div class="ev-card-body"><p class="ev-muted">Après l’envoi, votre test ne pourra plus être modifié. Les résultats de théorie et de pratique seront publiés ensemble par votre formateur.</p><fieldset {{ conflict ? 'disabled' : '' }}><label class="ev-check"><input type="checkbox" name="submission_confirmed" value="1" required>J’ai relu mon test et je souhaite transmettre mes réponses au formateur.</label><button class="ev-btn ev-btn-primary w-100 mt-3" type="submit"><i class="bi bi-send-check"></i> Transmettre mon test</button></fieldset><p class="ev-readonly-note">Restez sur cette page jusqu’à la confirmation de l’envoi.</p></div></section></aside></div>
    </form>
  {% elseif dossier.state == 'to_review' %}
    <section class="ev-card"><div class="ev-card-body ev-empty"><div class="ev-badge mb-3"><i class="bi bi-check2-circle"></i> Test reçu</div><h2>Votre évaluation est entre les mains de votre formateur</h2><p>Votre test a été transmis le {{ dossier.submittedAt|date('d/m/Y à H:i') }}.<br>{{ dossier.evaluator }} va corriger vos réponses et finaliser votre évaluation pratique.</p><p class="ev-muted">Vous retrouverez ici les deux notes et les avis dès leur publication.</p></div></section>
  {% else %}
    <section class="ev-card mb-4"><div class="ev-card-body"><div class="ev-dossier-title"><div><div class="ev-kicker">MON BILAN FINAL</div><h2>{{ dossier.successful ? 'Votre évaluation est réussie' : 'Votre évaluation est terminée' }}</h2><p class="ev-muted mt-2">Validée par {{ dossier.evaluator }} le {{ dossier.publishedAt|date('d/m/Y à H:i') }}.</p></div>{% if dossier.successful %}<a class="ev-btn ev-btn-primary" href="{{ path('app_evaluation_attestation', {entite: entite.id, id: dossier.id}) }}"><i class="bi bi-file-earmark-pdf"></i> Mon attestation de réussite</a>{% endif %}</div><div class="ev-verdict-grid mt-3"><div><span class="ev-muted">Test théorique</span><div class="ev-result-score">{{ summary.theory.on20|number_format(2, ',', ' ') }} <small>/ 20</small></div><span class="ev-badge ev-status-{{ dossier.theoryVerdict }}">Avis {{ dossier.theoryVerdict == 'favorable' ? 'favorable' : 'défavorable' }}</span></div><div><span class="ev-muted">Évaluation pratique</span><div class="ev-result-score">{{ summary.practice.on20|number_format(2, ',', ' ') }} <small>/ 20</small></div><span class="ev-badge ev-status-{{ dossier.practiceVerdict }}">Avis {{ dossier.practiceVerdict == 'favorable' ? 'favorable' : 'défavorable' }}</span></div></div>{% if not dossier.successful %}<div class="ev-answer mt-4">La réussite exige deux avis favorables. Contactez votre formateur pour connaître les points à retravailler et les suites de votre parcours.</div>{% endif %}</div></section>
    <div class="ev-toolbar"><a class="ev-btn" href="{{ path('app_evaluation_results_pdf', {entite: entite.id, id: dossier.id}) }}"><i class="bi bi-file-earmark-pdf"></i> Télécharger mon bilan complet</a></div>
    <div class="ev-grid">
      <section class="ev-card"><div class="ev-card-head"><div><div class="ev-kicker">01 · RETOUR DÉTAILLÉ</div><h2>Votre test théorique</h2></div></div><div class="ev-card-body">
        {% for question in dossier.questions %}{% set answer = answers[question.id]|default(question.type == 'text' ? '' : []) %}{% set grade = dossier.theoryGrading[question.id] %}<article class="ev-question"><div class="ev-question-title"><h3><span class="ev-number">{{ '%02d'|format(loop.index) }}</span>{{ question.label }}</h3><strong class="ev-points">{{ grade.points }} / {{ question.points }}</strong></div><div class="ev-answer"><span class="ev-answer-label">Votre réponse</span>{% if question.type == 'text' %}<div class="ev-long-text">{{ answer ?: 'Sans réponse' }}</div>{% elseif answer is empty %}Sans réponse{% elseif question.type == 'order' %}<ol class="mb-0">{% for selected in answer %}{% for option in question.options %}{% if option.id == selected %}<li>{{ option.label }}</li>{% endif %}{% endfor %}{% endfor %}</ol>{% else %}<ul class="mb-0">{% for option in question.options %}{% if option.id in answer %}<li>{{ option.label }}</li>{% endif %}{% endfor %}</ul>{% endif %}</div>{% if question.type != 'text' %}<details class="ev-answer ev-correction"><summary>Consulter le corrigé</summary>{% if question.type == 'order' %}<ol class="mb-0 mt-2">{% for expected in question.correct %}{% for option in question.options %}{% if option.id == expected %}<li>{{ option.label }}</li>{% endif %}{% endfor %}{% endfor %}</ol>{% else %}<ul class="mb-0 mt-2">{% for option in question.options %}{% if option.id in question.correct %}<li>{{ option.label }}</li>{% endif %}{% endfor %}</ul>{% endif %}</details>{% endif %}{% if grade.comment %}<p class="ev-muted ev-long-text"><strong>Votre formateur :</strong> {{ grade.comment }}</p>{% endif %}</article>{% endfor %}
      </div></section>
      <section class="ev-card"><div class="ev-card-head"><div><div class="ev-kicker">02 · EN SITUATION</div><h2>Votre évaluation pratique</h2></div></div><div class="ev-card-body">
        {% for criterion in dossier.practice %}{% set grade = dossier.practiceGrading[criterion.id] %}<article class="ev-question"><div class="ev-question-title"><h3><span class="ev-number">{{ '%02d'|format(loop.index) }}</span>{{ criterion.label }}</h3><strong class="ev-points">{{ grade.na ? 'Non applicable' : grade.points ~ ' / ' ~ criterion.points }}</strong></div>{% if grade.failed %}<span class="ev-badge ev-status-defavorable mb-2">Critère éliminatoire non maîtrisé</span>{% endif %}{% if grade.comment %}<p class="ev-muted ev-long-text">{{ grade.comment }}</p>{% endif %}</article>{% endfor %}<p class="ev-readonly-note mt-3">Barème applicable : {{ summary.practice.points }} / {{ summary.practice.max }} points. La note finale est ramenée sur 20.</p>
      </div></section>
    </div>
  {% endif %}
</div>
{% endblock %}
{% block javascripts_bottom %}{{ parent() }}<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('[data-order-question]').forEach(group => {
    const selects = [...group.querySelectorAll('select')];
    const validate = () => selects.forEach(select => select.setCustomValidity(select.value && selects.some(other => other !== select && other.value === select.value) ? 'Chaque proposition doit être utilisée une seule fois.' : ''));
    selects.forEach(select => select.addEventListener('change', validate)); validate();
  });
  document.getElementById('learner-evaluation')?.addEventListener('submit', event => {if(!window.confirm('Transmettre définitivement vos réponses au formateur ?')) event.preventDefault();});
});
</script>{% endblock %}
