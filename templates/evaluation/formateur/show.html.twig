{% extends 'base_admin.html.twig' %}
{% block title %}Évaluation · {{ dossier.stagiaire.prenom }} {{ dossier.stagiaire.nom }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">{% include 'evaluation/_style.html.twig' %}{% include 'evaluation/formateur/_form_style.html.twig' %}{% endblock %}
{% block body %}
{% set published = dossier.publishedAt is not null %}
{% set schema = dossier.snapshot.schema %}
{% set record = dossier.publicationRecord %}
{% set learnerName = published ? record.learnerName : dossier.stagiaire.prenom ~ ' ' ~ dossier.stagiaire.nom %}
{% set evaluatorName = published ? record.evaluatorName : dossier.evaluator.prenom ~ ' ' ~ dossier.evaluator.nom %}
<div class="ev-shell">
  {% if dossier.snapshot.owner is defined %}<p class="ev-muted">Modèle pédagogique · Propriété : <strong>{{ dossier.snapshot.owner }}</strong> · Version {{ dossier.snapshot.version }}</p>{% endif %}
  <div class="ev-toolbar mb-3"><a class="ev-tab-link" href="{{ path('app_formateur_evaluation_index', {entite: entite.id}) }}"><i class="bi bi-arrow-left"></i> Mes évaluations</a></div>
  <section class="ev-hero"><div class="ev-kicker">{{ published ? 'RÉSULTATS VALIDÉS' : 'ESPACE ÉVALUATEUR' }} · {{ dossier.session.code }}</div><h1>{{ learnerName }}</h1><p>{{ dossier.snapshot.title }}</p><div class="ev-toolbar"><span class="ev-chip"><i class="bi bi-book"></i> {{ dossier.session.formation.titre|default('Formation') }}</span><span class="ev-chip"><i class="bi bi-person-check"></i> {{ evaluatorName }}</span>{% if published %}<span class="ev-chip">Publié le {{ dossier.publishedAt|date('d/m/Y à H:i') }}</span>{% endif %}</div></section>
  {% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }} mt-3" role="status">{{ message }}</div>{% endfor %}{% endfor %}
  {% if error %}<div class="alert alert-danger mt-3" role="alert">{{ error }}{% if conflict %} <a href="{{ path('app_formateur_evaluation_show', {entite: entite.id, id: dossier.id}) }}">Recharger le dossier</a>{% endif %}</div>{% endif %}
  <div class="ev-steps"><div class="ev-step {{ dossier.theorySubmittedAt ? '' : 'active' }}"><span class="ev-muted">01 · Théorie</span><strong>{{ dossier.theorySubmittedAt ? 'Test reçu le ' ~ dossier.theorySubmittedAt|date('d/m/Y') : 'En attente du stagiaire' }}</strong></div><div class="ev-step {{ dossier.theorySubmittedAt and not published ? 'active' : '' }}"><span class="ev-muted">02 · Évaluation</span><strong>{{ published ? 'Correction et pratique validées' : 'Correction et mise en pratique' }}</strong></div><div class="ev-step {{ published ? 'active' : '' }}"><span class="ev-muted">03 · Résultats</span><strong>{{ published ? 'Publiés au stagiaire' : 'À valider et publier' }}</strong></div></div>
  {% if published %}
    <section class="ev-card mb-4"><div class="ev-card-body"><div class="ev-dossier-title"><div><div class="ev-kicker">DÉCISION FINALE</div><h2>{{ dossier.successful ? 'Réussite de l’évaluation' : 'Réussite non acquise' }}</h2><p class="ev-muted mt-2">Validation nominative horodatée · Les résultats publiés sont conservés.</p></div>{% if dossier.successful %}<a class="ev-btn ev-btn-primary" href="{{ path('app_evaluation_attestation', {entite: entite.id, id: dossier.id}) }}"><i class="bi bi-file-earmark-pdf"></i> Attestation de réussite</a>{% endif %}</div><div class="ev-verdict-grid"><div><span class="ev-muted">Théorie</span><div class="ev-result-score">{{ summary.theory.on20|number_format(2, ',', ' ') }} <small>/ 20</small></div><span class="ev-badge ev-status-{{ dossier.theoryVerdict }}">Avis {{ dossier.theoryVerdict == 'favorable' ? 'favorable' : 'défavorable' }}</span></div><div><span class="ev-muted">Pratique</span><div class="ev-result-score">{{ summary.practice.on20|number_format(2, ',', ' ') }} <small>/ 20</small></div><span class="ev-badge ev-status-{{ dossier.practiceVerdict }}">Avis {{ dossier.practiceVerdict == 'favorable' ? 'favorable' : 'défavorable' }}</span></div></div></div></section>
  {% endif %}
  {% if published %}<div class="ev-toolbar"><a class="ev-btn" href="{{ path('app_evaluation_results_pdf', {entite: entite.id, id: dossier.id}) }}"><i class="bi bi-file-earmark-pdf"></i> Télécharger le bilan complet</a>{% if not dossier.notificationSentAt %}<form method="post" action="{{ path('app_evaluation_notify', {entite: entite.id, id: dossier.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('evaluation_notify_' ~ dossier.id) }}"><button class="ev-btn" type="submit"><i class="bi bi-envelope-arrow-up"></i> Réessayer l’envoi des résultats</button></form>{% endif %}</div>{% endif %}
  <form method="post" class="ev-review-form" id="evaluation-review">
    <input type="hidden" name="_token" value="{{ csrf_token('evaluation_review_' ~ dossier.id) }}"><input type="hidden" name="version" value="{{ dossier.version }}">
    <div class="ev-workspace">
      <div>
        <nav class="ev-toolbar mb-3" aria-label="Sections de l’évaluation"><a href="#theorie" class="ev-tab-link">01 · Théorie</a><a href="#pratique" class="ev-tab-link">02 · Pratique</a>{% if not published %}<a href="#avis" class="ev-tab-link">03 · Avis</a>{% endif %}</nav>
        <section class="ev-card mb-4" id="theorie">
          <div class="ev-card-head"><div><div class="ev-kicker">01 · CORRECTION</div><h2>Le test théorique</h2></div><span class="ev-badge">{{ schema.theory|length }} questions</span></div>
          <div class="ev-card-body">
          {% if not dossier.theorySubmittedAt %}<div class="ev-empty"><i class="bi bi-hourglass-split fs-2"></i><h3>Le test n’a pas encore été transmis</h3><p>Vous pouvez déjà renseigner la pratique. La correction sera disponible après l’envoi du stagiaire.</p></div>
          {% else %}
            {% if not published %}<p class="ev-muted mb-4">Les notes proposées pour les questions à choix et à ordonner sont à vérifier. Ajustez-les si nécessaire et complétez les réponses libres.</p>{% endif %}
            {% for question in schema.theory %}
              {% set answer = dossier.theoryAnswers[question.id]|default(question.type == 'text' ? '' : []) %}
              {% set grade = theory[question.id]|default(suggestions[question.id]|default({})) %}
              <article class="ev-question"><div class="ev-question-title"><h3><span class="ev-number">{{ '%02d'|format(loop.index) }}</span>{{ question.label }}</h3><span class="ev-points">{{ question.points }} point{{ question.points > 1 ? 's' : '' }}</span></div>
                <div class="ev-answer"><span class="ev-answer-label">Réponse du stagiaire</span>{% if question.type == 'text' %}<div class="ev-long-text">{{ answer ?: 'Sans réponse' }}</div>{% elseif answer is empty %}<span class="ev-muted">Sans réponse</span>{% else %}{% if question.type == 'order' %}<ol class="mb-0">{% for selected in answer %}{% for option in question.options %}{% if option.id == selected %}<li>{{ option.label }}</li>{% endif %}{% endfor %}{% endfor %}</ol>{% else %}<ul class="mb-0">{% for option in question.options %}{% if option.id in answer %}<li>{{ option.label }}</li>{% endif %}{% endfor %}</ul>{% endif %}{% endif %}</div>
                {% if question.type != 'text' %}<details class="ev-answer ev-correction"><summary>Corrigé de référence</summary>{% if question.type == 'order' %}<ol class="mt-2 mb-0">{% for expected in question.correct %}{% for option in question.options %}{% if option.id == expected %}<li>{{ option.label }}</li>{% endif %}{% endfor %}{% endfor %}</ol>{% else %}<ul class="mt-2 mb-0">{% for option in question.options %}{% if option.id in question.correct %}<li>{{ option.label }}</li>{% endif %}{% endfor %}</ul>{% endif %}</details>{% endif %}
                {% if published %}<div class="ev-result-line"><span>Note attribuée</span><strong>{{ grade.points }} / {{ question.points }}</strong></div>{% if grade.comment|default('') %}<p class="ev-muted ev-long-text mt-2">{{ grade.comment }}</p>{% endif %}
                {% else %}<fieldset {{ conflict ? 'disabled' : '' }}><div class="ev-grade-fields"><div><label class="ev-field" for="theory-points-{{ question.id }}">Note / {{ question.points }}</label><input class="ev-input" type="number" min="0" max="{{ question.points }}" step="0.01" name="theory[{{ question.id }}][points]" id="theory-points-{{ question.id }}" value="{{ grade.points ?? '' }}" inputmode="decimal"></div><div><label class="ev-field" for="theory-comment-{{ question.id }}">Observation du formateur</label><textarea class="ev-textarea" name="theory[{{ question.id }}][comment]" id="theory-comment-{{ question.id }}" maxlength="4000" rows="2">{{ grade.comment|default('') }}</textarea></div></div></fieldset>{% endif %}
              </article>
            {% endfor %}
          {% endif %}
          </div>
        </section>
        <section class="ev-card mb-4" id="pratique"><div class="ev-card-head"><div><div class="ev-kicker">02 · MISE EN SITUATION</div><h2>L’évaluation pratique</h2></div><span class="ev-badge">{{ schema.practice|length }} critères</span></div><div class="ev-card-body">
          {% for criterion in schema.practice %}{% set grade = practice[criterion.id]|default({}) %}
            <article class="ev-question" data-practice-item><div class="ev-question-title"><h3><span class="ev-number">{{ '%02d'|format(loop.index) }}</span>{{ criterion.label }}</h3><span class="ev-points">{{ criterion.points }} points</span></div>
              {% if criterion.critical %}<span class="ev-badge ev-status-defavorable mb-2">Critère éliminatoire</span>{% endif %}
              {% if published %}<div class="ev-result-line"><span>{{ grade.na|default(false) ? 'Critère non applicable' : (grade.failed|default(false) ? 'Critère non maîtrisé' : 'Note attribuée') }}</span><strong>{{ grade.na|default(false) ? 'Non évalué' : grade.points ~ ' / ' ~ criterion.points }}</strong></div>{% if grade.comment|default('') %}<p class="ev-muted ev-long-text mt-2">{{ grade.comment }}</p>{% endif %}
              {% else %}<fieldset {{ conflict ? 'disabled' : '' }}>{% if criterion.allowNa %}<label class="ev-check"><input type="checkbox" data-practice-na name="practice[{{ criterion.id }}][na]" value="1" {{ grade.na|default(false) ? 'checked' : '' }}>Non applicable · retirer ce critère du barème</label>{% endif %}
                <div class="ev-grade-fields"><div><label class="ev-field" for="practice-points-{{ criterion.id }}">Note / {{ criterion.points }}</label><input class="ev-input" type="number" data-practice-points min="0" max="{{ criterion.points }}" step="0.01" name="practice[{{ criterion.id }}][points]" id="practice-points-{{ criterion.id }}" value="{{ grade.points ?? '' }}" inputmode="decimal"></div><div><label class="ev-field" for="practice-comment-{{ criterion.id }}">Observation en situation</label><textarea class="ev-textarea" name="practice[{{ criterion.id }}][comment]" id="practice-comment-{{ criterion.id }}" maxlength="4000" rows="2">{{ grade.comment|default('') }}</textarea></div></div>
                {% if criterion.critical %}<label class="ev-check"><input type="checkbox" data-practice-failed name="practice[{{ criterion.id }}][failed]" value="1" {{ grade.failed|default(false) ? 'checked' : '' }}>Critère non maîtrisé : avis pratique favorable impossible.</label>{% endif %}</fieldset>
              {% endif %}
            </article>
          {% endfor %}
        </div></section>
        {% if not published %}<section class="ev-card" id="avis"><div class="ev-card-head"><div><div class="ev-kicker">03 · DÉCISION PÉDAGOGIQUE</div><h2>Vos deux avis</h2></div></div><div class="ev-card-body"><p class="ev-muted">La réussite exige un avis favorable en théorie et en pratique. Les seuils du modèle et les critères éliminatoires sont également contrôlés.</p><fieldset {{ conflict ? 'disabled' : '' }}><div class="ev-verdict-grid"><div><label class="ev-field" for="theory-verdict">Avis théorique</label><select class="ev-select" id="theory-verdict" name="theory_verdict"><option value="">En attente de décision</option value="favorable" {{ theoryVerdict == 'favorable' ? 'selected' : '' }}>Favorable</option><option value="defavorable" {{ theoryVerdict == 'defavorable' ? 'selected' : '' }}>Défavorable</option></select><p class="ev-readonly-note">{{ schema.theoryThreshold is not null ? 'Seuil requis : ' ~ schema.theoryThreshold ~ ' / 20' : 'Aucun seuil chiffré · votre avis est requis.' }}</p></div><div><label class="ev-field" for="practice-verdict">Avis pratique</label><select class="ev-select" id="practice-verdict" name="practice_verdict"><option value="">En attente de décision</option><option value="favorable" {{ practiceVerdict == 'favorable' ? 'selected' : '' }}>Favorable</option><option value="defavorable" {{ practiceVerdict == 'defavorable' ? 'selected' : '' }}>Défavorable</option></select><p class="ev-readonly-note">{{ schema.practiceThreshold is not null ? 'Seuil requis : ' ~ schema.practiceThreshold ~ ' / 20' : 'Aucun seuil chiffré · votre avis est requis.' }}</p></div></div></fieldset></div></section>{% endif %}
      </div>
      <aside class="ev-review-aside"><section class="ev-card"><div class="ev-card-head"><div><div class="ev-kicker">SYNTHÈSE</div><h2>{{ published ? 'Résultats' : 'Votre évaluation' }}</h2></div></div><div class="ev-card-body"><div class="ev-side-score"><span>Théorie</span><strong>{{ summary.theory.on20 is not null ? summary.theory.on20|number_format(2, ',', ' ') ~ ' / 20' : 'À compléter' }}</strong></div><div class="ev-side-score"><span>Pratique</span><strong>{{ summary.practice.on20 is not null ? summary.practice.on20|number_format(2, ',', ' ') ~ ' / 20' : 'À compléter' }}</strong></div><p class="ev-readonly-note">{% if not published %}Notes du dernier enregistrement. {% endif %}La pratique est ramenée sur 20 selon les critères applicables.</p>{% if not published %}<div class="ev-validation"><fieldset {{ conflict ? 'disabled' : '' }}><button class="ev-btn" type="submit" name="action" value="save"><i class="bi bi-cloud-check"></i> Enregistrer le brouillon</button><label class="ev-check"><input type="checkbox" name="validation_confirmed" value="1" id="validation-confirmed">Je confirme avoir vérifié les réponses et réalisé l’évaluation pratique de ce stagiaire.</label><button class="ev-btn ev-btn-primary" type="submit" name="action" value="publish" {{ not dossier.theorySubmittedAt ? 'disabled' : '' }}><i class="bi bi-check2-circle"></i> Valider et publier</button></fieldset><p class="ev-readonly-note">La publication fige les résultats et les rend accessibles au stagiaire. En cas de double avis favorable, son attestation est disponible.</p></div>{% endif %}</div></section></aside>
    </div>
  </form>
</div>
{% endblock %}
{% block javascripts_bottom %}{{ parent() }}<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('[data-practice-item]').forEach(row => {const na = row.querySelector('[data-practice-na]'); if(!na) return; const update = () => {row.querySelectorAll('[data-practice-points], [data-practice-failed]').forEach(input => input.disabled = na.checked);}; na.addEventListener('change', update); update();});
  const form = document.getElementById('evaluation-review'), confirmed = document.getElementById('validation-confirmed');
  form?.querySelectorAll('button[name=action]').forEach(button => button.addEventListener('click', () => {if(confirmed) confirmed.required = button.value === 'publish';}));
  form?.addEventListener('submit', event => {if(event.submitter?.value === 'publish' && !window.confirm('Publier définitivement ces résultats au stagiaire ?')) event.preventDefault();});
});
</script>{% endblock %}
