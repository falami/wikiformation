{% extends 'base_admin.html.twig' %}
{% block title %}Mes modèles · Théorie & pratique{% endblock %}
{% block stylesheets %}{{ parent() }}{% include 'evaluation/_style.html.twig' %}{% endblock %}
{% block body %}
<div class="ev-shell">
{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
<header class="ev-hero"><span class="ev-eyebrow">VOTRE EXPERTISE · VOTRE BIBLIOTHÈQUE</span><h1>Des modèles qui vous appartiennent.</h1><p class="ev-lead">Concevez vos tests théoriques et pratiques. Publiez vos modèles puis choisissez, pour chacun, les organismes autorisés à les utiliser. Aucun accès n’est accordé automatiquement.</p><div class="ev-actions"><a class="ev-btn ev-btn-primary" href="{{ path('app_formateur_evaluation_template_new',{entite:entite.id}) }}">Créer un modèle</a><a class="ev-btn ev-btn-secondary" href="{{ path('app_formateur_evaluation_index',{entite:entite.id}) }}">Mes évaluations</a></div></header>
<div class="ev-stats"><div class="ev-stat"><span>Votre patrimoine</span><strong>{{ templates|length }}</strong><span>modèles personnels</span></div><div class="ev-stat"><span>Publication</span><strong>Vous décidez</strong><span>Aucune cession de propriété</span></div><div class="ev-stat"><span>Après attribution</span><strong>Version figée</strong><span>Dupliquer pour faire évoluer</span></div></div>
<div class="ev-grid">{% for template in templates %}{% include 'evaluation/_model_card.html.twig' with {trainerMode:true} %}{% else %}<div class="ev-empty"><h2>Votre premier modèle commence ici.</h2><p>Créez votre questionnaire et sa grille pratique dans le studio.</p></div>{% endfor %}</div>
</div>
{% endblock %}
