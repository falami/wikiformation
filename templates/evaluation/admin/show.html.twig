{% extends 'base_admin.html.twig' %}
{% block title %}Évaluation · {{ dossier.stagiaire.prenom }} {{ dossier.stagiaire.nom }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">{% include 'evaluation/_style.html.twig' %}{% endblock %}
{% block body %}
{% set schema = dossier.snapshot.schema %}
{% set verdicts = {'favorable':'Favorable','defavorable':'Défavorable'} %}
<div class="ev-shell">
{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
<header class="ev-hero"><span class="ev-eyebrow">Dossier d’évaluation · Théorie & pratique</span><h1>{{ dossier.stagiaire.prenom }} {{ dossier.stagiaire.nom }}</h1><p class="ev-lead">{{ dossier.snapshot.title }}</p><div class="ev-actions mb-4"><span class="ev-chip">{{ dossier.session.code }}</span><span class="ev-chip">Évaluateur : {{ dossier.publicationRecord.evaluatorName|default(dossier.evaluator.prenom ~ ' ' ~ dossier.evaluator.nom) }}</span><span class="ev-chip">Modèle v{{ dossier.snapshot.version }}</span></div><a class="ev-btn ev-btn-secondary" href="{{ path('app_administrateur_evaluation_index',{entite:entite.id}) }}">← Tous les dossiers</a></header>
<div class="ev-stats"><div class="ev-stat"><span>Théorie · {{ verdicts[dossier.theoryVerdict]|default('Avis en attente') }}</span><strong>{{ summary.theory.on20 is not null ? summary.theory.on20|number_format(2,',',' ') ~ ' / 20' : 'À corriger' }}</strong><span>{{ dossier.theorySubmittedAt ? 'Test soumis le ' ~ dossier.theorySubmittedAt|date('d/m/Y à H:i') : 'Le stagiaire doit compléter son test' }}</span></div><div class="ev-stat"><span>Pratique · {{ verdicts[dossier.practiceVerdict]|default('Avis en attente') }}</span><strong>{{ summary.practice.on20 is not null ? summary.practice.on20|number_format(2,',',' ') ~ ' / 20' : 'À évaluer' }}</strong><span>Critères non applicables exclus du barème</span></div><div class="ev-stat"><span>Résultat final</span><strong>{{ dossier.successful ? 'Réussite' : (dossier.publishedAt ? 'Non acquis' : 'En cours') }}</strong><span>{{ dossier.publishedAt ? 'Publié le ' ~ dossier.publishedAt|date('d/m/Y à H:i') : 'Les notes seront visibles après publication' }}</span></div></div>
{% if dossier.publishedAt %}<section class="ev-card"><div class="ev-card-body ev-actions"><a class="ev-btn" href="{{ path('app_evaluation_results_pdf',{entite:entite.id,id:dossier.id}) }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Télécharger les résultats</a>{% if dossier.successful %}<a class="ev-btn ev-btn-primary" href="{{ path('app_evaluation_attestation',{entite:entite.id,id:dossier.id}) }}"><i class="bi bi-award" aria-hidden="true"></i> Attestation de réussite</a>{% endif %}{% if not dossier.notificationSentAt %}<form method="post" action="{{ path('app_evaluation_notify',{entite:entite.id,id:dossier.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('evaluation_notify_' ~ dossier.id) }}"><button type="submit" class="ev-btn"><i class="bi bi-envelope" aria-hidden="true"></i> Envoyer la notification de résultats</button></form>{% else %}<span class="ev-muted">Notification transmise le {{ dossier.notificationSentAt|date('d/m/Y à H:i') }}</span>{% endif %}</div></section>{% endif %}
{% if dossier.previousDossier %}<div class="ev-alert">Cette évaluation est une nouvelle tentative. <a href="{{ path('app_administrateur_evaluation_show',{entite:entite.id,id:dossier.previousDossier.id}) }}">Consulter le dossier précédent</a>.</div>{% endif %}
<section class="ev-card"><div class="ev-card-head"><div><span class="ev-eyebrow">01 · Les connaissances</span><h2>Test théorique</h2></div><span class="ev-badge">{{ schema.theory|length }} questions</span></div><div class="ev-card-body">
{% for question in schema.theory %}{% set answer = dossier.theoryAnswers[question.id]|default(question.type == 'text' ? '' : []) %}{% set grade = dossier.theoryGrading[question.id]|default({}) %}<article style="padding:20px 0;{{ not loop.last ? 'border-bottom:1px solid var(--ev-line)' : '' }}"><div class="ev-actions" style="justify-content:space-between;align-items:flex-start"><h3 style="max-width:85%"><span class="ev-muted">{{ '%02d'|format(loop.index) }}.</span> {{ question.label }}</h3><span class="ev-badge">{{ grade.points is defined and grade.points is not null ? grade.points : '—' }} / {{ question.points }}</span></div><p class="ev-muted mb-2">Réponse du stagiaire</p>{% if question.type == 'text' %}<p style="white-space:pre-wrap">{{ answer ?: 'Aucune réponse' }}</p>{% elseif answer|length %}<ol>{% for selectedId in answer %}{% for option in question.options %}{% if option.id == selectedId %}<li>{{ option.label }}</li>{% endif %}{% endfor %}{% endfor %}</ol>{% else %}<p class="ev-muted">Aucune réponse</p>{% endif %}{% if question.type != 'text' %}<details class="ev-alert"><summary>Corrigé de référence{{ question.type == 'order' ? ' · ordre attendu' : '' }}</summary><ol class="mt-3 mb-0">{% for correctId in question.correct %}{% for option in question.options %}{% if option.id == correctId %}<li>{{ option.label }}</li>{% endif %}{% endfor %}{% endfor %}</ol></details>{% endif %}{% if grade.comment|default('') %}<div class="ev-alert"><strong>Observation du formateur</strong><p class="mb-0" style="white-space:pre-wrap">{{ grade.comment }}</p></div>{% endif %}</article>{% endfor %}
</div></section>
<section class="ev-card"><div class="ev-card-head"><div><span class="ev-eyebrow">02 · Les gestes professionnels</span><h2>Évaluation pratique</h2></div><span class="ev-badge">{{ schema.practice|length }} critères</span></div><div class="ev-card-body">
{% for criterion in schema.practice %}{% set grade = dossier.practiceGrading[criterion.id]|default({}) %}<article style="padding:20px 0;{{ not loop.last ? 'border-bottom:1px solid var(--ev-line)' : '' }}"><div class="ev-actions" style="justify-content:space-between;align-items:flex-start"><h3 style="max-width:85%"><span class="ev-muted">{{ '%02d'|format(loop.index) }}.</span> {{ criterion.label }}</h3><span class="ev-badge">{{ grade.na|default(false) ? 'Non applicable' : ((grade.points is defined and grade.points is not null ? grade.points : '—') ~ ' / ' ~ criterion.points) }}</span></div>{% if criterion.critical %}<span class="ev-badge {{ grade.failed|default(false) ? 'ev-badge-danger' : '' }}">{{ grade.failed|default(false) ? 'Critère éliminatoire non acquis' : 'Critère éliminatoire' }}</span>{% endif %}{% if grade.comment|default('') %}<p class="mt-3 mb-0" style="white-space:pre-wrap">{{ grade.comment }}</p>{% endif %}</article>{% endfor %}
</div></section>
{% if not dossier.publishedAt and dossier.theoryGrading is empty and dossier.practiceGrading is empty %}<section class="ev-card"><div class="ev-card-head"><h2>Formateur évaluateur</h2><span class="ev-badge">Avant notation</span></div><form method="post" action="{{ path('app_administrateur_evaluation_evaluator',{entite:entite.id,id:dossier.id}) }}" class="ev-card-body"><p class="ev-muted">Vous pouvez remplacer l’évaluateur avant toute notation. Le nouveau formateur doit intervenir sur cette session.</p><input type="hidden" name="_token" value="{{ csrf_token('evaluation_evaluator_' ~ dossier.id) }}"><div class="ev-actions"><select name="evaluator" required aria-label="Nouvel évaluateur" style="flex:1"><option value="">Choisissez un intervenant…</option>{% for evaluator in evaluators %}<option value="{{ evaluator.id }}" {{ evaluator.id == dossier.evaluator.id ? 'selected' : '' }}>{{ evaluator.prenom }} {{ evaluator.nom }}</option>{% endfor %}</select><button type="submit" class="ev-btn">Mettre à jour l’évaluateur</button></div></form></section>{% endif %}
{% if dossier.publishedAt %}<section class="ev-card"><div class="ev-card-head"><h2>Historique & nouvelle tentative</h2><span class="ev-badge">Résultats conservés</span></div><div class="ev-card-body">{% if nextDossier %}<a class="ev-btn" href="{{ path('app_administrateur_evaluation_show',{entite:entite.id,id:nextDossier.id}) }}">Consulter la tentative suivante <i class="bi bi-arrow-right" aria-hidden="true"></i></a>{% else %}<p class="ev-muted">Ouvrez une nouvelle évaluation avec le même modèle et le même barème. Les réponses et résultats de ce dossier resteront consultables.</p><form method="post" action="{{ path('app_administrateur_evaluation_retake',{entite:entite.id,id:dossier.id}) }}" class="ev-actions"><input type="hidden" name="_token" value="{{ csrf_token('evaluation_retake_' ~ dossier.id) }}"><select name="evaluator" required aria-label="Évaluateur de la nouvelle tentative" style="flex:1"><option value="">Choisissez un intervenant…</option>{% for evaluator in evaluators %}<option value="{{ evaluator.id }}" {{ evaluator.id == dossier.evaluator.id ? 'selected' : '' }}>{{ evaluator.prenom }} {{ evaluator.nom }}</option>{% endfor %}</select><button class="ev-btn" type="submit"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Créer une nouvelle tentative</button></form>{% endif %}</div></section>{% endif %}
</div>
{% endblock %}
