{% extends 'base_admin.html.twig' %}
{% block title %}Évaluations théorie & pratique · {{ entite.nom }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">{% include 'evaluation/_style.html.twig' %}{% endblock %}
{% block body %}
<div class="ev-shell">
  {% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
  <header class="entity-hero ev-hero">
    <span class="ev-eyebrow">Évaluer les acquis · Accompagner la réussite</span>
    <h1 class="ev-title">La théorie rencontre la pratique.</h1>
    <p class="ev-lead">Un parcours complet pour chaque stagiaire : test théorique, observation sur le terrain et validation du formateur.</p>
    <div class="ev-actions"><a class="ev-btn ev-btn-primary" href="{{ path('app_administrateur_evaluation_assign',{entite:entite.id}) }}"><i class="bi bi-person-plus" aria-hidden="true"></i> Affecter une évaluation</a><a class="ev-btn ev-btn-secondary" href="{{ path('app_administrateur_evaluation_template_new',{entite:entite.id}) }}"><i class="bi bi-plus-lg" aria-hidden="true"></i> Créer un modèle</a><a class="ev-btn ev-btn-secondary" href="{{ path('app_administrateur_qcm_index',{entite:entite.id}) }}">Mes questionnaires début / fin <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div>
  </header>
  <div class="ev-stats"><div class="ev-stat"><span>Bibliothèque</span><strong>{{ templates|length }}</strong><span>modèle{{ templates|length > 1 ? 's' : '' }} réutilisable{{ templates|length > 1 ? 's' : '' }}</span></div><div class="ev-stat"><span>Parcours</span><strong>2 évaluations</strong><span>théorie & pratique dans un même dossier</span></div><div class="ev-stat"><span>Réussite</span><strong>2 avis favorables</strong><span>pour accéder à l’attestation</span></div></div>
  <section class="ev-card">
    <div class="ev-card-head"><div><span class="ev-eyebrow">Votre bibliothèque</span><h2>Des modèles prêts à accompagner vos formations</h2></div><span class="ev-badge">Versions conservées</span></div>
    <div class="ev-card-body">
      <div class="ev-actions mb-4"><a class="ev-btn" href="{{ path('app_administrateur_evaluation_template_new',{entite:entite.id,preset:'height'}) }}"><i class="bi bi-stars" aria-hidden="true"></i> Préparer le modèle Travail en hauteur</a>
      {% if qcms|length %}<form method="get" action="{{ path('app_administrateur_evaluation_template_new',{entite:entite.id}) }}" class="ev-actions"><select name="qcm" required aria-label="Questionnaire à copier" style="width:auto;max-width:330px"><option value="">Partir d’un questionnaire existant…</option>{% for qcm in qcms %}<option value="{{ qcm.id }}">{{ qcm.titre }}</option>{% endfor %}</select><button class="ev-btn" type="submit">Copier la théorie</button></form>{% endif %}</div>
      <div class="ev-grid">{% for template in templates %}{% include 'evaluation/_model_card.html.twig' %}{% else %}<div class="ev-empty"><h3>Votre bibliothèque est prête.</h3><p>Créez un modèle ou retrouvez ici les modèles publiés par vos formateurs.</p></div>{% endfor %}</div>
    </div>
  </section>
  <section class="ev-card" id="dossiers">
    <div class="ev-card-head"><div><span class="ev-eyebrow">Suivi individuel</span><h2>Les dossiers d’évaluation</h2></div><span class="ev-badge">{{ total }} résultat{{ total > 1 ? 's' : '' }}</span></div>
    <form method="get" class="ev-card-body ev-actions" role="search"><input type="search" name="q" value="{{ search }}" placeholder="Stagiaire, formateur ou session…" aria-label="Rechercher des évaluations" style="flex:1;min-width:220px"><select name="state" aria-label="État du dossier" style="width:auto"><option value="">Tous les états</option><option value="assigned" {{ state == 'assigned' ? 'selected' : '' }}>Test à compléter</option><option value="to_review" {{ state == 'to_review' ? 'selected' : '' }}>À évaluer</option><option value="published" {{ state == 'published' ? 'selected' : '' }}>Résultats publiés</option></select><button type="submit" class="ev-btn ev-btn-primary">Filtrer</button>{% if search or state %}<a class="ev-btn" href="{{ path('app_administrateur_evaluation_index',{entite:entite.id}) }}#dossiers">Réinitialiser</a>{% endif %}</form>
    <div class="ev-table-wrap"><table class="ev-table"><thead><tr><th>Stagiaire & session</th><th>Parcours</th><th>Évaluateur</th><th>Progression</th><th>Action</th></tr></thead><tbody>{% for dossier in dossiers %}<tr><td><strong>{{ dossier.stagiaire.prenom }} {{ dossier.stagiaire.nom }}</strong><small>{{ dossier.session.code }} · {{ dossier.session.formationLabel }}</small></td><td>{{ dossier.snapshot.title }}<small>Version {{ dossier.snapshot.version }}{% if dossier.previousDossier %} · Nouvelle tentative{% endif %}</small></td><td>{{ dossier.evaluator.prenom }} {{ dossier.evaluator.nom }}</td><td><span class="ev-badge {{ dossier.successful ? 'ev-badge-success' : (dossier.state == 'to_review' ? 'ev-badge-warning' : '') }}">{{ dossier.successful ? 'Réussite validée' : (dossier.state == 'published' ? 'Résultats publiés' : (dossier.state == 'to_review' ? 'À évaluer' : 'Test à compléter')) }}</span><small>{{ dossier.createdAt|date('d/m/Y') }}</small></td><td><a class="ev-btn" href="{{ path('app_administrateur_evaluation_show',{entite:entite.id,id:dossier.id}) }}" aria-label="Consulter le dossier de {{ dossier.stagiaire.prenom }} {{ dossier.stagiaire.nom }}">Consulter <i class="bi bi-arrow-right" aria-hidden="true"></i></a></td></tr>{% else %}<tr><td colspan="5"><div class="ev-empty"><i class="bi bi-person-check" aria-hidden="true"></i><h3>{{ search or state ? 'Aucun dossier ne correspond à votre recherche.' : 'Aucune évaluation affectée pour le moment.' }}</h3><p>Les dossiers apparaissent ici dès leur affectation à une session.</p></div></td></tr>{% endfor %}</tbody></table></div>
    {% if pages > 1 %}<nav class="ev-card-body ev-actions" aria-label="Pagination des dossiers">{% if page > 1 %}<a class="ev-btn" href="{{ path('app_administrateur_evaluation_index',{entite:entite.id,q:search,state:state,page:page-1}) }}#dossiers">Précédente</a>{% endif %}<span class="ev-muted">Page {{ page }} / {{ pages }}</span>{% if page < pages %}<a class="ev-btn" href="{{ path('app_administrateur_evaluation_index',{entite:entite.id,q:search,state:state,page:page+1}) }}#dossiers">Suivante</a>{% endif %}</nav>{% endif %}
  </section>
</div>
{% endblock %}
