{% extends 'base_admin.html.twig' %}
{% block title %}{{ template.title }} · Consultation{% endblock %}
{% block stylesheets %}{{ parent() }}{% include 'evaluation/_style.html.twig' %}{% include 'evaluation/_preview_style.html.twig' %}{% endblock %}
{% block body %}
{% set theory = template.schema.theory|default([]) %}
{% set practice = template.schema.practice|default([]) %}
<div class="ev-shell ev-preview">
  <div class="ev-preview-breadcrumb"><a href="{{ path('app_administrateur_evaluation_index',{entite:entite.id}) }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Bibliothèque des modèles</a><span>Consultation · Version {{ template.version }}</span></div>
  <header class="ev-preview-header">
    <div><span class="ev-kicker">RÉFÉRENTIEL D’ÉVALUATION</span><h1>{{ template.title }}</h1><p>Le questionnaire, son corrigé et la grille d’observation réunis dans un même parcours.</p>
      <div class="ev-actions"><span class="ev-badge {{ template.archivedAt ? '' : (template.active ? 'ev-badge-success' : 'ev-badge-warning') }}">{{ template.archivedAt ? 'Archivé' : (template.active ? 'Disponible' : 'Brouillon privé') }}</span><span class="ev-badge"><i class="bi bi-eye" aria-hidden="true"></i> Lecture seule</span>{% if template.assignedAt %}<span class="ev-badge"><i class="bi bi-lock" aria-hidden="true"></i> Version protégée</span>{% endif %}</div>
    </div><div class="ev-preview-emblem" aria-hidden="true"><i class="bi bi-journal-check"></i></div>
  </header>
  <div class="ev-preview-layout">
    <main class="ev-preview-main">
      <nav class="ev-preview-nav" aria-label="Sections du modèle"><a href="#ev-theory"><span>01</span> Test théorique <b>{{ theory|length }}</b></a><a href="#ev-practice"><span>02</span> Grille pratique <b>{{ practice|length }}</b></a></nav>
      {% include 'evaluation/_model_content.html.twig' %}
    </main>
    <aside class="ev-preview-sidebar" aria-label="Informations et actions du modèle">
      <section class="ev-preview-summary"><span class="ev-kicker">FICHE DU MODÈLE</span><h2>Un parcours, deux regards.</h2><p class="ev-muted">Les connaissances du stagiaire et les gestes observés par le formateur.</p>
        <div class="ev-preview-metrics"><div><strong>{{ theory|length }}</strong><span>question{{ theory|length > 1 ? 's' : '' }}</span></div><div><strong>{{ practice|length }}</strong><span>critère{{ practice|length > 1 ? 's' : '' }}</span></div></div>
        <dl class="ev-preview-facts"><dt>Propriétaire du modèle</dt><dd><i class="bi {{ template.trainerOwner ? 'bi-person-badge' : 'bi-building' }}" aria-hidden="true"></i> {{ template.ownerLabel }}</dd><dt>Version</dt><dd>{{ template.version }}{% if template.sourceTemplate %} · Issue d’une duplication{% endif %}</dd><dt>Seuil théorique</dt><dd>{{ template.schema.theoryThreshold is defined and template.schema.theoryThreshold is not null ? template.schema.theoryThreshold ~ ' / 20' : 'Non défini' }}</dd><dt>Seuil pratique</dt><dd>{{ template.schema.practiceThreshold is defined and template.schema.practiceThreshold is not null ? template.schema.practiceThreshold ~ ' / 20' : 'Non défini' }}</dd></dl>
        {% include 'evaluation/_model_actions.html.twig' with {canManage:not template.trainerOwner, locked:template.assignedAt is not null, hideConsult:true} %}
        <p class="ev-preview-footnote"><i class="bi bi-shield-check" aria-hidden="true"></i> {{ template.assignedAt ? 'Cette version est protégée pour préserver les évaluations déjà attribuées.' : 'Le contenu sera protégé dès sa première attribution.' }}</p>
      </section>
    </aside>
  </div>
</div>
{% endblock %}
