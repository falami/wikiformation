<style>
/* Isolated studio styles: other evaluation screens keep their existing layout. */
.ev-studio{--studio-tint:color-mix(in srgb,var(--ev-accent) 10%,white)}
.ev-studio-topline{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:22px;font-size:12px;color:#687988}.ev-studio-topline a{color:var(--ev-ink);text-decoration:none;font-weight:650;display:flex;gap:9px;align-items:center}
.ev-studio .ev-studio-hero{display:flex;align-items:center;justify-content:space-between;padding:34px 38px;border-top:0;border-left:4px solid var(--ev-accent);border-radius:22px;margin-bottom:18px}.ev-studio-hero h1{font-size:clamp(25px,2.5vw,36px);margin-bottom:12px}.ev-studio-hero .ev-lead{font-size:15px;margin-bottom:22px}.ev-studio-steps{display:flex;flex-wrap:wrap;align-items:center;gap:15px;font-size:11px;color:#e1e8eb}.ev-studio-steps span{display:flex;align-items:center;gap:7px}.ev-studio-steps>i{opacity:.5}.ev-studio-emblem{width:92px;height:92px;flex-shrink:0;margin-left:25px;border:1px solid #ffffff25;border-radius:24px;display:grid;place-items:center;transform:rotate(-7deg);background:#ffffff08;color:var(--ev-accent);font-size:40px}
.ev-studio-nav{display:flex;flex-wrap:wrap;gap:8px;border-bottom:1px solid var(--ev-line);padding:0 0 17px;margin-bottom:24px}.ev-studio-nav a{display:flex;align-items:center;gap:8px;padding:9px 14px;color:var(--ev-ink);font-size:13px;font-weight:650;text-decoration:none;border-radius:10px;background:white;border:1px solid var(--ev-line)}.ev-studio-nav a:hover{background:var(--studio-tint)}.ev-studio-nav span{font-size:10px;color:#687988}.ev-studio-nav a:last-child{margin-left:auto}
.ev-builder-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:24px;align-items:start}.ev-builder-layout>div{min-width:0}.ev-builder-aside{position:sticky;top:110px;scroll-margin-top:115px;max-height:calc(100dvh - 135px);overflow:auto;scrollbar-width:thin;border-radius:18px}.ev-studio-section{scroll-margin-top:115px}.ev-studio .ev-card{border-radius:18px;box-shadow:0 8px 24px #18304105}.ev-studio .ev-card-head{padding:24px;background:white}.ev-studio .ev-card-head h2{font-size:21px}.ev-studio .ev-card-head .ev-eyebrow{font-size:10px;margin-bottom:7px}.ev-studio .ev-card-body{padding:24px}.ev-studio .ev-studio-section>.ev-card-body{background:var(--ev-soft);padding:20px}.ev-studio-identity #model-title{font-size:18px;font-weight:650;letter-spacing:-.3px}.ev-studio-identity .ev-muted{font-size:12px}
.ev-studio-guidance{display:flex;align-items:flex-start;gap:12px;margin:0 0 20px;padding:4px 3px;font-size:12px;line-height:1.7}.ev-studio-guidance>i{margin-top:1px;font-size:18px}.ev-studio-guidance strong{display:block;margin-bottom:3px;font-size:13px}.ev-studio-guidance p{margin:0;color:#617080}
.ev-builder-item{border:1px solid var(--ev-line);border-radius:15px;margin-bottom:20px;background:white;padding:24px;box-shadow:0 3px 10px #18304103;transition:border-color .15s,box-shadow .15s}.ev-builder-item:focus-within{border-color:color-mix(in srgb,var(--ev-accent) 65%,var(--ev-line));box-shadow:0 0 0 3px color-mix(in srgb,var(--ev-accent) 10%,transparent)}.ev-builder-item-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:-24px -24px 22px;padding:16px 24px;border-bottom:1px solid var(--ev-line)}.ev-item-index{display:inline-flex;align-items:center;gap:9px;font-size:12px;font-weight:750;letter-spacing:.2px}.ev-item-index::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--ev-accent)}.ev-builder-small-actions{display:flex;gap:6px}.ev-builder-small-actions .ev-btn{width:30px;height:30px;padding:0;border-radius:8px;font-size:15px;background:var(--ev-soft);border-color:transparent}.ev-builder-small-actions .ev-btn:last-child:hover{color:#a12b39;background:#fff0f1}
/* Labels must be block-level: inline labels were shrinking the statement field. */
.ev-studio .ev-field{display:block;width:100%;min-width:0;margin-bottom:18px}.ev-studio .ev-label{font-size:12px;margin-bottom:8px}.ev-studio .ev-item-label{display:block;width:100%;min-height:84px;font-size:17px;font-weight:550;line-height:1.6;padding:14px 16px;background:var(--ev-soft);resize:vertical}.ev-studio input:not([type=checkbox]):not([type=radio]):not([type=hidden]),.ev-studio select{font-size:14px;min-height:44px}.ev-builder-meta{display:grid;grid-template-columns:minmax(0,1fr) 110px;gap:16px}.ev-builder-meta .ev-field{margin-bottom:14px}.ev-builder-meta .ev-item-points{font-variant-numeric:tabular-nums;font-weight:700;text-align:center}
.ev-correct-hint{display:flex;align-items:center;gap:7px;border-top:1px solid var(--ev-line);padding-top:16px;margin:4px 0 12px;font-size:12px}.ev-builder-options{display:grid;gap:8px;margin:0 0 14px}.ev-builder-option{display:grid;grid-template-columns:24px minmax(0,1fr) 30px;gap:10px;align-items:center;border:1px solid var(--ev-line);border-radius:11px;padding:9px 12px;transition:background .15s,border-color .15s}.ev-builder-option.is-selected{background:var(--studio-tint);border-color:color-mix(in srgb,var(--ev-accent) 65%,var(--ev-line))}.ev-builder-option label{display:flex;align-items:center;justify-content:center;margin:0}.ev-studio .ev-builder-option .ev-option-label{display:block;min-height:28px;height:28px;padding:2px 4px;border:0;border-radius:4px;background:transparent;font-size:14px;line-height:24px;font-weight:450;resize:vertical;overflow:hidden;box-shadow:none}.ev-builder-option.is-selected .ev-option-label{font-weight:650}.ev-builder-option .ev-btn{width:28px;height:28px;padding:0;border:0;background:transparent;color:#687988;font-size:18px}.ev-builder-option .ev-btn:hover{background:#ffffffa0;color:#a12b39}.ev-builder-option.is-order{grid-template-columns:52px minmax(0,1fr) 30px}.ev-studio .ev-builder-option .ev-option-rank{padding:5px;min-height:32px;text-align:center;background:var(--ev-soft)}.ev-studio .ev-add-option{padding:8px 0;border:0;background:none;font-size:12px;box-shadow:none}.ev-studio .ev-studio-add{width:100%;background:white;border:1px dashed color-mix(in srgb,var(--ev-ink) 28%,white);padding:15px;font-size:13px}.ev-studio-add:hover{background:var(--studio-tint)}
.ev-builder-check{display:flex;align-items:flex-start;gap:10px;margin-top:12px;font-size:12px;line-height:1.7}.ev-builder-check input{margin-top:3px}.ev-builder-item[data-kind=practice]>.ev-builder-check{background:var(--ev-soft);padding:12px;border-radius:10px}.ev-builder-aside>.ev-card{border-top:3px solid var(--ev-accent)}.ev-studio .ev-builder-aside .ev-card-head{padding:21px}.ev-studio .ev-builder-aside .ev-card-head h2{font-size:19px}.ev-studio .ev-builder-aside .ev-card-body{padding:20px}.ev-builder-totals{display:grid;grid-template-columns:1fr 1fr;gap:10px}.ev-builder-total{display:flex;flex-direction:column;gap:7px;align-items:flex-start;background:var(--ev-soft);padding:13px 12px;border:1px solid var(--ev-line);border-radius:12px}.ev-builder-total span{font-size:11px;color:#617080}.ev-builder-total strong{font-size:19px;letter-spacing:-.4px}.ev-studio .ev-builder-aside .ev-muted{font-size:12px;line-height:1.7}.ev-score-note{margin:12px 0 0}.ev-builder-aside hr{border-color:var(--ev-line);margin:18px 0}.ev-builder-aside .ev-alert{font-size:12px;line-height:1.7;padding:13px;background:var(--studio-tint)}.ev-builder-aside .ev-builder-check{padding-top:14px;border-top:1px solid var(--ev-line)}.ev-builder-aside button[type=submit]{background:var(--ev-ink);border-color:var(--ev-ink);color:white;min-height:48px}.ev-builder-empty{padding:30px;background:white;border:1px dashed var(--ev-line);border-radius:12px;text-align:center;margin-bottom:18px;color:#687988}
@media(max-width:1100px){.ev-builder-layout{grid-template-columns:1fr}.ev-builder-aside{position:static;max-height:none;overflow:visible}.ev-builder-totals{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.ev-studio-topline{align-items:flex-start;flex-direction:column;gap:7px}.ev-studio .ev-studio-hero{padding:24px}.ev-studio-emblem{display:none}.ev-studio-steps{gap:9px}.ev-studio-steps>i{display:none}.ev-studio-nav{gap:7px}.ev-studio-nav a{font-size:12px;padding:8px 10px}.ev-studio-nav a:last-child{margin-left:0}.ev-studio .ev-studio-section>.ev-card-body{padding:12px}.ev-builder-item{padding:16px}.ev-builder-item-head{margin:-16px -16px 17px;padding:13px 16px}.ev-builder-meta{grid-template-columns:minmax(0,1fr) 85px;gap:10px}.ev-studio .ev-item-label{font-size:15px}.ev-builder-option{padding:8px;gap:6px;grid-template-columns:20px minmax(0,1fr) 26px}.ev-builder-option.is-order{grid-template-columns:45px minmax(0,1fr) 26px}.ev-builder-option .ev-btn{width:26px}.ev-studio-guidance{padding:7px}.ev-studio .ev-card-head{padding:20px}}
</style>
