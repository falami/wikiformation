{% extends 'base_admin.html.twig' %}
{% block title %}Affecter une évaluation · {{ entite.nom }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}"><link rel="stylesheet" href="{{ asset('dist/recruitment/tom-select.css') }}">{% include 'evaluation/_style.html.twig' %}{% include 'evaluation/admin/_assign_selects_style.html.twig' %}{% endblock %}
{% block body %}
<div class="ev-shell ev-assignment">
  <header class="entity-hero ev-hero"><span class="ev-eyebrow">De votre modèle à leurs acquis</span><h1>Un parcours pour chaque stagiaire.</h1><p class="ev-lead">Choisissez la session, le modèle et l’évaluateur. Chaque stagiaire sélectionné disposera de son propre dossier.</p><a class="ev-btn ev-btn-secondary" href="{{ path('app_administrateur_evaluation_index',{entite:entite.id}) }}">← Retour aux évaluations</a></header>
  {% for error in errors %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endfor %}
  <section class="ev-card"><div class="ev-card-head"><div><span class="ev-eyebrow">Étape 01</span><h2>Choisir la session</h2></div></div><form method="get" class="ev-card-body ev-actions"><input type="hidden" name="template" value="{{ templateId }}"><label class="ev-label mb-0" for="session-picker">Session de formation</label><select name="session" id="session-picker" required style="flex:1;min-width:220px"><option value="">Sélectionnez une session…</option>{% for item in sessions %}<option value="{{ item.id }}" {{ session and session.id == item.id ? 'selected' : '' }}>{{ item.code }} · {{ item.formationLabel }}</option>{% endfor %}</select><button type="submit" class="ev-btn ev-btn-primary">Afficher les stagiaires <i class="bi bi-arrow-right" aria-hidden="true"></i></button></form></section>
  {% if session %}
  <form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('evaluation_assign_' ~ entite.id) }}"><input type="hidden" name="session" value="{{ session.id }}">
    <div class="ev-grid"><section class="ev-card"><div class="ev-card-head"><div><span class="ev-eyebrow">Étape 02</span><h2>Le modèle et son évaluateur</h2></div></div><div class="ev-card-body"><div class="ev-field"><label class="ev-label" for="template">Modèle d’évaluation</label><select name="template" id="template" required><option value="">Sélectionnez un modèle actif…</option>{% for template in templates %}<option value="{{ template.id }}" {{ template.id == templateId ? 'selected' : '' }}>{{ template.title }} · v{{ template.version }} · {{ template.ownerLabel }}</option>{% endfor %}</select>{% if templates is empty %}<p class="ev-muted mt-3">Aucun modèle actif. <a href="{{ path('app_administrateur_evaluation_template_new',{entite:entite.id}) }}">Créez puis activez votre modèle.</a></p>{% endif %}</div><div class="ev-field"><label class="ev-label" for="evaluator">Formateur évaluateur</label><select name="evaluator" id="evaluator" required><option value="">Sélectionnez un intervenant…</option>{% for evaluator in evaluators %}<option value="{{ evaluator.id }}" {{ evaluator.id == evaluatorId or (evaluators|length == 1 and not evaluatorId) ? 'selected' : '' }}>{{ evaluator.prenom }} {{ evaluator.nom }}</option>{% endfor %}</select><p class="ev-muted mt-3">Les formateurs proposés sont les intervenants de la session disposant d’un accès actif à l’espace formateur.</p>{% if evaluators is empty %}<div class="ev-alert">Aucun intervenant éligible. Ajoutez le formateur aux créneaux de la session et vérifiez son accès à l’organisme.</div>{% endif %}</div><div class="ev-alert"><i class="bi bi-layers" aria-hidden="true"></i> Une version du modèle est conservée dans chaque dossier. Dès l’attribution, le modèle est verrouillé. Dupliquez-le pour créer une nouvelle version.</div></div></section>
    <section class="ev-card"><div class="ev-card-head"><div><span class="ev-eyebrow">Étape 03</span><h2>Les stagiaires concernés</h2></div><span class="ev-badge">{{ inscriptions|length }} inscrit{{ inscriptions|length > 1 ? 's' : '' }}</span></div><div class="ev-card-body">
    {% if inscriptions|length %}<div class="ev-actions mb-3"><button type="button" class="ev-btn" data-evaluation-check="true">Tout sélectionner</button><button type="button" class="ev-btn" data-evaluation-check="false">Tout désélectionner</button></div><div style="max-height:430px;overflow:auto">{% for inscription in inscriptions %}<label style="display:flex;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--ev-line)"><input type="checkbox" name="inscriptions[]" value="{{ inscription.id }}" {{ inscription.id in selected ? 'checked' : '' }}><span><strong>{{ inscription.stagiaire.prenom }} {{ inscription.stagiaire.nom }}</strong><small class="ev-muted d-block">{{ inscription.stagiaire.email }}</small></span></label>{% endfor %}</div><p class="ev-muted mt-3">Les inscriptions annulées ou absentes ne sont pas proposées. Une affectation déjà existante pour ce modèle est conservée.</p>{% else %}<div class="ev-empty"><i class="bi bi-people" aria-hidden="true"></i>Aucun stagiaire éligible dans cette session.</div>{% endif %}
    </div></section></div>
    <div class="ev-actions" style="justify-content:flex-end"><a class="ev-btn" href="{{ path('app_administrateur_evaluation_index',{entite:entite.id}) }}">Annuler</a><button class="ev-btn ev-btn-primary" type="submit" {{ inscriptions is empty or evaluators is empty or templates is empty ? 'disabled' : '' }}><i class="bi bi-person-check" aria-hidden="true"></i> Créer les dossiers sélectionnés</button></div>
  </form>
  {% endif %}
</div>
{% endblock %}
{% block javascripts_bottom %}{{ parent() }}<script src="{{ asset('dist/recruitment/tom-select.min.js') }}"></script>{% include 'evaluation/admin/_assign_selects_script.html.twig' %}<script>document.querySelectorAll('[data-evaluation-check]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('input[name="inscriptions[]"]').forEach(input=>{input.checked=button.dataset.evaluationCheck==='true';});}));</script>{% endblock %}
