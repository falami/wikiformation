<!doctype html>
<html lang="fr"><head><meta charset="UTF-8"><style>
@page{margin:42px 44px 55px}body{font-family:DejaVu Sans,sans-serif;font-size:11px;color:#253847;line-height:1.65}.masthead{border-bottom:3px solid {{ branding.accent }};padding-bottom:22px;margin-bottom:35px}.logo{height:45px;max-width:150px;float:right}.eyebrow{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:#647787}.hero{background:{{ branding.primary }};color:white;padding:28px;border-radius:8px}h1{font-size:27px;line-height:1.25;margin:8px 0 14px}h2{font-size:23px;margin:28px 0 8px}.session{margin:20px 0 30px;padding:16px 20px;background:#f3f6f8}.results{width:100%;border-collapse:collapse;margin:24px 0}.results th,.results td{text-align:left;padding:16px;border-bottom:1px solid #dde4ea}.results th{font-size:10px;background:#f3f6f8}.score{font-size:19px;font-weight:bold}.favorable{color:#17724e}.defavorable{color:#963e44}.validation{margin-top:35px;border-left:3px solid {{ branding.accent }};padding:10px 20px}.footer{margin-top:28px;font-size:9px;color:#687988}.name{font-size:26px;font-weight:bold}.detail{page-break-inside:avoid;border-bottom:1px solid #e4e8ed;padding:12px 0}.detail p{margin:4px 0}.muted{color:#647787}
</style></head><body>
<div class="masthead">{% if branding.logo %}<img class="logo" src="{{ branding.logo }}" alt="">{% endif %}<strong>{{ record.entityName }}</strong><br><span class="eyebrow">Formation · Évaluation des acquis</span></div>
<div class="hero"><div class="eyebrow" style="color:white">Théorie & pratique</div><h1>{{ attestation ? 'Attestation de réussite' : 'Bilan individuel d’évaluation' }}</h1><div>{{ record.title }}</div></div>
<p style="margin-top:30px">{{ attestation ? 'Nous attestons que' : 'Résultats de' }}</p><div class="name">{{ record.learnerName }}</div>
<div class="session"><strong>{{ record.formationTitle }}</strong><br>Session {{ record.sessionCode }}{% if record.sessionStart %}<br>Du {{ record.sessionStart|date('d/m/Y') }}{% if record.sessionEnd %} au {{ record.sessionEnd|date('d/m/Y') }}{% endif %}{% endif %}</div>
{% if attestation %}<p>a obtenu un avis favorable à chacune des deux évaluations ci-dessous.</p>{% endif %}
<table class="results"><thead><tr><th>Évaluation</th><th>Note sur 20</th><th>Avis du formateur</th></tr></thead><tbody>{% for key,label in {theory:'Théorique',practice:'Pratique'} %}{% set verdict = key == 'theory' ? record.theoryVerdict : record.practiceVerdict %}<tr><td>{{ label }}</td><td class="score">{{ record.scores[key].on20|number_format(2, ',', ' ') }} <span style="font-size:11px">/ 20</span></td><td class="{{ verdict }}">{{ verdict == 'favorable' ? 'Favorable' : 'Défavorable' }}</td></tr>{% endfor %}</tbody></table>
<div class="validation"><strong>Validation du formateur évaluateur</strong><br>{{ record.evaluatorName }}<br>Le {{ record.publishedAt|date('d/m/Y à H:i', 'Europe/Paris') }}<br><span class="muted">Validation nominative enregistrée dans la plateforme.</span></div>
<div class="footer">{% if dossier.snapshot.owner is defined %}Propriété du modèle : {{ dossier.snapshot.owner }}<br>{% endif %}Référence EV-{{ dossier.entite.id }}-{{ dossier.id }} · Modèle version {{ record.templateVersion }}<br>Les notes sont ramenées sur 20. Les critères pratiques non applicables sont exclus du barème.</div>
{% if not attestation %}
<div style="page-break-before:always"><h2>Détail de l’évaluation pratique</h2>
{% for item in dossier.snapshot.schema.practice %}{% set grade = dossier.practiceGrading[item.id] %}<div class="detail"><strong>{{ loop.index }}. {{ item.label }}</strong><p>{% if grade.na %}Non applicable{% else %}{{ grade.points|number_format(2, ',', ' ') }} / {{ item.points }}{% if grade.failed %} · Critère non satisfait{% endif %}{% endif %}</p>{% if grade.comment %}<p class="muted">{{ grade.comment }}</p>{% endif %}</div>{% endfor %}
<h2>Correction théorique</h2>{% for item in dossier.snapshot.schema.theory %}{% set grade = dossier.theoryGrading[item.id] %}<div class="detail"><strong>{{ loop.index }}. {{ item.label }}</strong><p>{{ grade.points|number_format(2, ',', ' ') }} / {{ item.points }}</p>{% if grade.comment %}<p class="muted">{{ grade.comment }}</p>{% endif %}</div>{% endfor %}</div>
{% endif %}
</body></html>
