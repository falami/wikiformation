{% extends 'commercial/layout.html.twig' %}
{% block title %}Espace commercial — {{ entite.nom }}{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }

 
  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/preferences.css') }}">
{% endblock %}
{% block portal %}
<header class="rp-hero"><div><div class="rp-eyebrow">{{ entite.nom }} · Développement & gestion</div><h1>Votre portefeuille commercial</h1><p>De la première prise de contact au suivi administratif, retrouvez les dossiers qui vous sont confiés.</p></div><a class="rp-button primary" href="{{ path('app_commercial_new',{entite:entite.id,espace:espace,module:'prospects'}) }}"><i class="bi bi-plus-lg"></i> Nouveau prospect</a></header>
<div class="rp-meta"><span><i class="bi bi-person-check me-2"></i>{{ app.user.prenom }} {{ app.user.nom }}</span><span><i class="bi bi-shield-check me-2"></i>Portefeuille attribué uniquement</span><span>Accès hérité de vos entreprises clientes</span></div>

<div class="rp-kpis"><div class="rp-kpi"><span>ENTREPRISES CLIENTES</span><strong>{{ companies|length }}</strong><span>Dans votre portefeuille</span></div><div class="rp-kpi"><span>DEVIS EN COURS · HT</span><strong>{{ (quotesTotal/100)|number_format(0,',',' ') }} €</strong><span>Brouillons et devis envoyés</span></div><div class="rp-kpi"><span>FACTURATION · HT</span><strong>{{ (invoiceTotal/100)|number_format(0,',',' ') }} €</strong><span>Hors factures annulées</span></div><div class="rp-kpi"><span>ACTIONS PLANIFIÉES</span><strong>{{ reminders|length }}</strong><span>Relances et rendez-vous à effectuer</span></div></div>
<div class="rp-workspace"><section class="rp-panel"><div class="rp-section-heading"><span class="rp-icon"><i class="bi bi-buildings"></i></span><div><h2>Mes entreprises</h2><span class="rp-muted">Tous les projets d’un client, au même endroit</span></div><a class="rp-button" href="{{ path('app_commercial_new',{entite:entite.id,espace:espace,module:'entreprises'}) }}"><i class="bi bi-plus-lg"></i> Ajouter</a></div>{% for company in companies|slice(0,6) %}<a class="rp-client-row" href="{{ path('app_commercial_show',{entite:entite.id,espace:espace,module:'entreprises',id:company.id}) }}"><div><strong>{{ company.raisonSociale }}</strong><div class="rp-muted">{{ company.ville|default('') }}</div></div><i class="bi bi-arrow-up-right"></i></a>{% else %}<div class="rp-empty"><p>Votre portefeuille est prêt à accueillir ses premiers clients.</p><p class="rp-muted">L’administrateur peut vous attribuer une entreprise existante.</p></div>{% endfor %}{% if companies|length>6 %}<a class="rp-back mt-3" href="{{ path('app_commercial_list',{entite:entite.id,espace:espace,module:'entreprises'}) }}">Toutes mes entreprises →</a>{% endif %}</section><section class="rp-panel"><div class="rp-eyebrow">VOTRE AGENDA COMMERCIAL</div><h2 class="mt-2 mb-4">Prochaines actions</h2>{% for reminder in reminders|slice(0,6) %}<a class="rp-reminder" href="{{ path('app_commercial_show',{entite:entite.id,espace:espace,module:reminder.module,id:reminder.recordId}) }}#historique"><time>{{ reminder.dueAt|date('d/m/Y') }}<br>{{ reminder.dueAt|date('H:i') }}</time><strong>{{ reminder.title }}</strong><i class="bi bi-arrow-right ms-auto"></i></a>{% else %}<div class="rp-empty"><i class="bi bi-calendar-check"></i><p>Aucune action planifiée.</p><p class="rp-muted">Programmez une relance depuis une fiche entreprise ou prospect.</p></div>{% endfor %}</section></div>
<h2 class="mb-4">Gérer mon activité</h2>
{% include 'shared/portail/_module_cards.html.twig' %}
<div class="rp-notice"><i class="bi bi-info-circle me-2"></i>Votre administrateur attribue les entreprises du portefeuille. Leurs dossiers deviennent accessibles automatiquement. Les formations, sites et formateurs partagés restent consultables pour préparer vos projets.</div>
{% endblock %}
