{# URLs are data only: no request is made until the visitor explicitly opens the map. #}
<div class="external-map" data-external-map data-map-src="{{ map_src|default('') }}">
  <div class="external-map__placeholder" data-map-placeholder>
    <span class="external-map__icon" aria-hidden="true">⌖</span>
    <strong>Votre lieu de formation</strong>
    <p>Afficher cette carte charge le service externe Google Maps. Google reçoit alors votre adresse IP et les lieux de la carte.</p>
    <button type="button" class="btn btn-outline-dark" data-load-google-map>Afficher la carte Google Maps</button>
    <span class="small text-danger" data-map-error role="status"></span>
  </div>
  <div class="external-map__canvas" data-map-canvas></div>
  <div class="external-map__footer">
    <a href="{{ map_url|default('https://www.google.com/maps') }}" data-map-link target="_blank" rel="noopener noreferrer">Ouvrir dans Google Maps ↗</a>
    <a href="https://policies.google.com/privacy?hl=fr" target="_blank" rel="noopener noreferrer">Confidentialité Google</a>
  </div>
</div>
