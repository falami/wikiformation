{# A URL in a data attribute causes no request. The player is created on click only. #}
<div data-external-video data-video-src="{{ video_src }}" class="external-video bg-light text-dark rounded p-3" style="position:relative;min-height:180px;width:100%;height:100%">
  <div data-video-placeholder>
    <strong>Vidéo externe</strong>
    <p class="small">En chargeant cette vidéo, le fournisseur reçoit votre adresse IP et peut déposer des traceurs. Le lecteur reste désactivé tant que vous ne l’ouvrez pas.</p>
    <button type="button" class="btn btn-outline-dark" data-load-external-video>Charger la vidéo</button>
    <a data-video-policy hidden target="_blank" rel="noopener noreferrer">Confidentialité du fournisseur</a>
    <span data-video-error role="status" class="small text-danger"></span>
  </div>
  <div data-video-canvas></div>
  <button type="button" class="btn btn-sm btn-outline-dark mt-2" data-close-external-video hidden>Fermer la vidéo</button>
</div>
