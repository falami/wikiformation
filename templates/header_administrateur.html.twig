{# Le contexte suit la page consultée, et non le rôle principal du compte. #}
{% set workspaceRoute = app.request.attributes.get('_route')|default('') %}
{% set workspaceLabel = 'Espace de travail' %}
{% if workspaceRoute starts with 'app_formateur_' or workspaceRoute starts with 'app_habilitation_trainer_' or workspaceRoute starts with 'app_market_trainer_' or workspaceRoute == 'app_charter_mine' %}
  {% set workspaceLabel = 'Espace formateur' %}
{% elseif workspaceRoute starts with 'app_stagiaire_' or workspaceRoute starts with 'app_habilitation_student_' %}
  {% set workspaceLabel = 'Espace stagiaire' %}
{% elseif workspaceRoute starts with 'app_entreprise_' or workspaceRoute == 'app_habilitation_company_title' %}
  {% set workspaceLabel = 'Espace entreprise' %}
{% elseif workspaceRoute starts with 'app_of_' %}
  {% set workspaceLabel = 'Espace organisme partenaire' %}
{% elseif workspaceRoute starts with 'app_commercial_' or workspaceRoute starts with 'app_partner_' %}
  {% set workspaceLabel = 'Espace commercial' %}
{% elseif workspaceRoute starts with 'app_opco_' %}
  {% set workspaceLabel = 'Espace OPCO' %}
{% elseif workspaceRoute starts with 'app_super_' %}
  {% set workspaceLabel = 'Espace super administrateur' %}
{% elseif workspaceRoute starts with 'app_administrateur_' or workspaceRoute starts with 'app_habilitation_' or workspaceRoute starts with 'app_charter_admin' or workspaceRoute starts with 'app_premium_entite_' %}
  {% set workspaceLabel = 'Espace administrateur' %}
{% elseif workspaceRoute starts with 'app_account_' %}
  {% set workspaceLabel = 'Mon compte' %}
{% endif %}
{# Navigation métier commune sur ordinateur et mobile dans workspaceSidebar. #}
<nav class="navbar adminTopNav wn-topbar" aria-label="Barre d’outils de votre espace">
  <div class="container-fluid wn-topbar-inner">
    <div class="wn-topbar-leading">
      <button type="button" class="wn-menu-toggle" data-navigation-toggle
              aria-controls="workspaceSidebar" aria-expanded="false" aria-label="Ouvrir le menu de navigation">
        <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
      </button>
      <div class="wn-page-context">
        <span class="wn-context-kicker">{{ workspaceLabel }}</span>
        <span class="wn-page-title" id="workspacePageTitle">Vue d’ensemble</span>
      </div>
    </div>

    <div class="adminTopNav-tools wn-topbar-tools">
      <div class="dropdown wn-language">
        {% include '_locale_switcher_admin.html.twig' %}
      </div>

      {% include 'notification/_bell.html.twig' %}

      {% if is_granted('ENTITE_ADMIN', entite) %}
        <div class="dropdown wn-settings">
          <button type="button" class="wn-tool-button dropdown-toggle" id="dropdownUser3"
                  data-bs-toggle="dropdown" aria-expanded="false" aria-label="Paramètres de votre espace">
            <i class="bi bi-sliders2" aria-hidden="true"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end wn-utility-menu" aria-labelledby="dropdownUser3">
            <li><h6 class="dropdown-header">Votre espace</h6></li>
            <li>
              <a class="dropdown-item" href="{{ path('app_account_preferences') }}">
                <i class="bi bi-sliders2" aria-hidden="true"></i><span>{{ 'navbar.settings'|trans }}</span>
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="{{ path('app_premium_entite_index', {'id': entite.id, 'entite': entite.id}) }}">
                <i class="bi bi-building-gear" aria-hidden="true"></i><span>{{ 'navbar.club.settings'|trans }}</span>
              </a>
            </li>
            {% if is_granted('ROLE_SUPER_ADMIN', entite) %}
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item" href="{{ path('app_super_public_host_index') }}">
                  <i class="bi bi-globe2" aria-hidden="true"></i><span>{{ 'navbar.publicHost'|trans }}</span>
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      <div class="dropdown wn-account">
        <button type="button" class="wn-profile-toggle dropdown-toggle" id="dropdownUser5"
                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Ouvrir le menu de mon compte">
          {% if app.user.photo %}
            <img src="{{ asset('uploads/photos/utilisateur/' ~ app.user.photo) }}" alt=""
                 width="36" height="36" class="wn-avatar rounded-circle object-fit-cover">
          {% else %}
            <span class="wn-avatar wn-avatar-initials" aria-hidden="true">{{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}</span>
          {% endif %}
        </button>
        <ul class="dropdown-menu dropdown-menu-end wn-utility-menu" aria-labelledby="dropdownUser5">
          <li class="wn-profile-heading">
            <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong>
            <span>{{ entite.nom }}</span>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <a class="dropdown-item" href="{{ path('app_account_preferences') }}">
              <i class="bi bi-person-gear" aria-hidden="true"></i><span>Mon compte et préférences</span>
            </a>
          </li>
          <li>
            <a class="dropdown-item" href="{{ path('app_workspace') }}">
              <i class="bi bi-buildings" aria-hidden="true"></i><span>{{ 'navbar.entite.switch'|trans }}</span>
            </a>
          </li>
          {% if is_granted('ENTITE_ADMIN', entite) %}
            <li>
              <a class="dropdown-item" href="{{ path('app_administrateur_billing', {'entite': entite.id}) }}">
                <i class="bi bi-credit-card-2-front" aria-hidden="true"></i><span>{{ 'navbar.user.subscription'|trans }}</span>
              </a>
            </li>
          {% endif %}
          <li><hr class="dropdown-divider"></li>
          <li>
            <a class="dropdown-item wn-logout" href="{{ path('app_logout', {'entite': entite.id}) }}">
              <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>{{ 'navbar.user.logout'|trans }}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>

<div class="modal fade" id="workspaceConfirmModal" tabindex="-1" aria-labelledby="workspaceConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="workspaceConfirmModalLabel">{{ 'modal.confirm.title'|trans }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'modal.actions.close'|trans }}"></button>
      </div>
      <div class="modal-body">
        {{ 'modal.confirm.body'|trans({'%club%': '<strong id="clubName"></strong>'})|raw }}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'modal.actions.cancel'|trans }}</button>
        <a href="#" id="confirmChange" class="btn btn-primary">{{ 'modal.actions.confirm'|trans }}</a>
      </div>
    </div>
  </div>
</div>
