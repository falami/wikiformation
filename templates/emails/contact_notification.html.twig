<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Nouveau message de contact</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f5f8;font-family:Arial,Helvetica,sans-serif;color:#243746;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">{{ contactName }} vous contacte depuis {{ sourceHost }}.</div>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f2f5f8;">
    <tr><td align="center" style="padding:32px 12px;">
      <table role="presentation" width="640" cellspacing="0" cellpadding="0" style="width:100%;max-width:640px;background-color:{{ theme.onPrimary }};border:1px solid #e1e7ed;border-radius:16px;overflow:hidden;">
        <tr><td style="height:5px;background-color:{{ theme.accent }};font-size:0;line-height:0;">&nbsp;</td></tr>
        <tr><td style="padding:32px 28px;background-color:{{ theme.primary }};">
          <p style="margin:0 0 20px;color:{{ theme.onPrimary }};font-size:13px;font-weight:bold;letter-spacing:2px;">{{ organisation }}</p>
          <h1 style="margin:0 0 12px;color:{{ theme.onPrimary }};font-size:28px;line-height:1.25;">Un nouveau contact<br>pour votre organisme</h1>
          <p style="margin:0;color:{{ theme.onPrimary }};font-size:15px;line-height:1.6;">Une demande vous attend depuis votre formulaire en ligne.</p>
        </td></tr>
        <tr><td style="padding:28px;">
          <p style="margin:0 0 8px;color:#718292;font-size:12px;font-weight:bold;letter-spacing:1px;">VOTRE INTERLOCUTEUR</p>
          <h2 style="margin:0 0 8px;font-size:22px;line-height:1.4;color:#142b39;overflow-wrap:anywhere;">{{ contactName }}</h2>
          <p style="margin:0 0 24px;font-size:15px;line-height:1.6;word-break:break-word;"><a href="mailto:{{ contactEmail }}" style="color:#245b79;text-decoration:underline;">{{ contactEmail }}</a></p>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f5f7fa;border:1px solid #e1e7ed;border-radius:10px;">
            <tr><td style="padding:22px;">
              <p style="margin:0 0 14px;font-size:12px;font-weight:bold;letter-spacing:1px;color:#718292;">SON MESSAGE</p>
              <div style="font-size:16px;line-height:1.75;color:#243746;word-break:break-word;overflow-wrap:anywhere;">{{ message|nl2br }}</div>
            </td></tr>
          </table>
          <table role="presentation" cellspacing="0" cellpadding="0" style="margin-top:26px;">
            <tr><td bgcolor="{{ theme.accent }}" style="border-radius:8px;text-align:center;"><a href="mailto:{{ contactEmail }}" style="display:inline-block;padding:15px 24px;border:1px solid {{ theme.accent }};border-radius:8px;color:{{ theme.onAccent }};font-size:15px;font-weight:bold;text-decoration:none;">Répondre au contact &rarr;</a></td></tr>
          </table>
          <p style="margin:14px 0 0;font-size:13px;line-height:1.6;color:#718292;">Vous pouvez également utiliser « Répondre » dans votre messagerie : votre réponse sera adressée directement à cette personne.</p>
        </td></tr>
        <tr><td style="padding:20px 28px;border-top:1px solid #e1e7ed;background-color:#fafbfd;">
          <p style="margin:0 0 5px;font-size:12px;line-height:1.6;color:#718292;">Formulaire de contact · {{ sourceHost }}</p>
          <p style="margin:0;font-size:12px;line-height:1.6;color:#718292;">Reçu le {{ receivedAt|date('d/m/Y à H:i', 'Europe/Paris') }} (heure de Paris)</p>
        </td></tr>
      </table>
      <p style="margin:20px 0 0;font-size:12px;line-height:1.6;color:#718292;">Notification transmise par WikiFormation pour {{ organisation }}.</p>
    </td></tr>
  </table>
</body>
</html>
