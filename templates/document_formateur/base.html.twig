{% extends 'base_admin.html.twig' %}
{% block title %}Documents formateurs{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="{{ asset('dist/css/documents-formateurs.css') }}">
  <style>:root{--theme-color-principal:{{ entite.couleurPrincipal|default('#233342') }};--theme-color-secondaire:{{ entite.couleurSecondaire|default('#ffc107') }};}</style>
{% endblock %}
{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
  <script defer src="{{ asset('dist/js/documents-formateurs.js') }}"></script>
{% endblock %}
