  <script>
    document.addEventListener('DOMContentLoaded', function () {

      /* =========================
       * TomSelect helper
       * ========================= */

      function initTomSelectOn(el, opts) {

        if (!el) {
          return null;
        }

        if (el.tomselect) {
          return el.tomselect;
        }

        return new TomSelect(
          el,
          Object.assign(
            {
              dropdownParent: 'body',
              create: false,
              allowEmptyOption: true
            },
            opts || {}
          )
        );
      }


      /* =========================
       * DOM
       * ========================= */

      const userEl =
        document.querySelector('.user-select');

      const rolesEl =
        document.querySelector('.roles-select');

      const fonctionEl =
        document.getElementById('{{ form.fonction.vars.id }}');

      const couleurEl =
        document.getElementById('{{ form.couleur.vars.id }}');

      const colorPreview =
        document.getElementById('colorPreview');

      const resumeUtilisateur =
        document.getElementById('resumeUtilisateur');

      const resumeRoles =
        document.getElementById('resumeRoles');

      const resumeFonction =
        document.getElementById('resumeFonction');

      const resumeCouleur =
        document.getElementById('resumeCouleur');

      const resumeColorDot =
        document.getElementById('resumeColorDot');

      const resumeValidPill =
        document.getElementById('resumeValidPill');


      /* =========================
       * TomSelect utilisateur
       * ========================= */

      const userTS = initTomSelectOn(userEl, {

        placeholder:
          'Rechercher par nom, prénom ou email…',

        plugins: ['clear_button'],

        searchField: ['text'],

        sortField: {
          field: 'text',
          direction: 'asc'
        },

        maxOptions: 500
      });


      /* =========================
       * TomSelect rôles
       * ========================= */

      const rolesTS = initTomSelectOn(rolesEl, {

        placeholder:
          'Sélectionner un ou plusieurs rôles…',

        plugins: ['remove_button'],

        maxItems: null,

        closeAfterSelect: false,

        hideSelected: true
      });


      /* =========================
       * Helpers
       * ========================= */

      function selectedTexts(el) {

        if (!el) {
          return [];
        }

        if (el.tomselect) {

          return (el.tomselect.items || [])
            .map(value =>
              el.tomselect.options[value]?.text || ''
            )
            .filter(Boolean);
        }

        return Array
          .from(el.selectedOptions || [])
          .map(option =>
            option.textContent.trim()
          );
      }


      function getSelectedUserText() {

        if (!userEl) {
          return '';
        }

        if (userEl.tomselect) {

          const selected =
            userEl.tomselect.items?.[0];

          if (!selected) {
            return '';
          }

          return (
            userEl.tomselect.options[selected]?.text || ''
          );
        }

        const option =
          userEl.selectedOptions?.[0];

        return option
          ? option.textContent.trim()
          : '';
      }


      function isValidHex(value) {

        return /^#[0-9a-fA-F]{6}$/.test(value);
      }


      /* =========================
       * Color preview
       * ========================= */

      function refreshColor() {

        const value =
          (couleurEl?.value || '').trim();

        const valid =
          isValidHex(value);

        const displayColor =
          valid ? value : '#e5e7eb';

        if (colorPreview) {
          colorPreview.style.background =
            displayColor;
        }

        if (resumeColorDot) {
          resumeColorDot.style.background =
            displayColor;
        }

        if (resumeCouleur) {
          resumeCouleur.textContent =
            valid ? value : 'Auto';
        }
      }


      /* =========================
       * Resume
       * ========================= */

      function refreshResume() {

        const roles =
          selectedTexts(rolesEl);

        const fonction =
          (fonctionEl?.value || '').trim();

        if (resumeUtilisateur && userEl) {

          resumeUtilisateur.textContent =
            getSelectedUserText() || '-';
        }

        if (resumeRoles) {

          resumeRoles.textContent =
            roles.length
              ? roles.join(', ')
              : '-';
        }

        if (resumeFonction) {

          resumeFonction.textContent =
            fonction || 'Non renseignée';
        }

        refreshColor();


        /* Validation visuelle */

        const hasRoles =
          roles.length > 0;

        const hasUser =
          userEl
            ? !!getSelectedUserText()
            : true;

        const ok =
          hasRoles && hasUser;

        if (resumeValidPill) {

          resumeValidPill.textContent =
            ok
              ? '✅ Complet'
              : '⚠️ Incomplet';

          resumeValidPill.style.background =
            ok
              ? 'rgba(25,135,84,.15)'
              : 'rgba(255,193,7,.15)';

          resumeValidPill.style.borderColor =
            ok
              ? 'rgba(25,135,84,.35)'
              : 'rgba(255,193,7,.35)';
        }
      }


      /* =========================
       * Events
       * ========================= */

      userTS?.on(
        'change',
        refreshResume
      );

      rolesTS?.on(
        'change',
        refreshResume
      );

      fonctionEl?.addEventListener(
        'input',
        refreshResume
      );

      couleurEl?.addEventListener(
        'input',
        refreshResume
      );

      couleurEl?.addEventListener(
        'change',
        refreshResume
      );


      /* =========================
       * Init
       * ========================= */

      refreshResume();

    });
  </script>

{% endblock %}