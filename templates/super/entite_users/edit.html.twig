{% extends 'base_admin.html.twig' %}

{% block title %}
  Super — {{ isNew ? 'Ajouter' : 'Modifier' }} un rattachement — {{ entite.nom }}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

      --bg:#f5f7fb;
      --panel:#fff;
      --ink:#0f172a;
      --muted:#64748b;
      --stroke:rgba(15,23,42,.10);
      --shadow:0 18px 55px rgba(15,23,42,.10);
      --radius:18px;
    }

    body{
      background:var(--bg);
    }

    /* ================= HERO ================= */

    .hero{
      border-radius:22px;
      padding:1.2rem;
      position:relative;
      overflow:hidden;
      color:#fff;
      box-shadow:0 18px 50px rgba(0,0,0,.14);

      background:
        radial-gradient(
          1200px 420px at 12% -10%,
          color-mix(in srgb, var(--theme-color-tertiaire) 35%, transparent),
          transparent 58%
        ),
        radial-gradient(
          900px 380px at 92% 0%,
          color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent),
          transparent 60%
        ),
        radial-gradient(
          700px 260px at 55% 115%,
          color-mix(in srgb, var(--theme-color-quaternaire) 18%, transparent),
          transparent 62%
        ),
        linear-gradient(
          135deg,
          color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
          color-mix(in srgb, var(--theme-color-principal) 70%, #fff 30%)
        );
    }

    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background:linear-gradient(
        180deg,
        rgba(255,255,255,.10),
        rgba(255,255,255,0) 55%
      );
      opacity:.85;
    }

    .hero > *{
      position:relative;
      z-index:1;
    }

    .hero .accent{
      width:12px;
      border-radius:999px;
      background:var(--theme-color-secondaire);
      box-shadow:
        0 0 0 6px
        color-mix(
          in srgb,
          var(--theme-color-secondaire) 18%,
          transparent
        );
      flex:0 0 auto;
    }

    .chip{
      display:inline-flex;
      align-items:center;
      gap:.45rem;
      padding:.28rem .65rem;
      border-radius:999px;
      font-size:.82rem;
      background:rgba(255,255,255,.10);
      border:1px solid rgba(255,255,255,.14);
      color:rgba(255,255,255,.92);
      white-space:nowrap;
    }

    .chip i{
      color:var(--theme-color-secondaire);
    }

    .hero .btn{
      border-radius:14px;
      font-weight:800;
    }

    .btn-outline-theme{
      border-color:rgba(255,255,255,.35);
      color:#fff;
    }

    .btn-outline-theme:hover{
      background:rgba(255,255,255,.10);
      border-color:rgba(255,255,255,.55);
      color:#fff;
    }

    /* ================= CARDS ================= */

    .cardx{
      background:var(--panel);
      border:1px solid var(--stroke);
      border-radius:var(--radius);
      box-shadow:0 10px 28px rgba(15,23,42,.08);
      overflow:hidden;
    }

    .cardx-h{
      padding:.95rem 1.05rem;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:1rem;
      background:linear-gradient(
        180deg,
        rgba(0,0,0,.015),
        transparent
      );
      border-bottom:1px solid var(--stroke);
    }

    .cardx-title{
      margin:0;
      font-weight:800;
      letter-spacing:-.01em;
      color:var(--ink);
      display:flex;
      align-items:center;
      gap:.6rem;
    }

    /* ================= FORM ================= */

    label.form-label{
      font-weight:700;
      color:var(--ink);
    }

    .form-text,
    .text-muted,
    .small{
      color:var(--muted) !important;
    }

    .form-control,
    .form-select{
      border-radius:14px;
      border:1px solid var(--stroke);
      padding:.65rem .85rem;
      min-height:44px;
    }

    .form-control:focus,
    .form-select:focus{
      border-color:
        color-mix(
          in srgb,
          var(--theme-color-principal) 55%,
          var(--stroke)
        );

      box-shadow:
        0 0 0 .2rem
        color-mix(
          in srgb,
          var(--theme-color-principal) 18%,
          transparent
        );
    }

    /* ================= SOFT BOX ================= */

    .soft-box{
      border-radius:16px;
      border:1px dashed rgba(15,35,54,.18);
      background:rgba(248,251,254,.75);
      padding:1rem;
    }

    /* ================= TOM SELECT ================= */

    .ts-wrapper{
      position:relative;
      width:100%;
    }

    .ts-wrapper .ts-control{
      border-radius:14px !important;
      min-height:44px !important;
      padding:.55rem .75rem !important;
      border-color:var(--stroke) !important;
      box-shadow:none !important;
    }

    .ts-wrapper.focus .ts-control{
      border-color:
        color-mix(
          in srgb,
          var(--theme-color-principal) 55%,
          var(--stroke)
        ) !important;

      box-shadow:
        0 0 0 .2rem
        color-mix(
          in srgb,
          var(--theme-color-principal) 18%,
          transparent
        ) !important;
    }

    .ts-dropdown{
      z-index:10000 !important;
      border-radius:14px !important;
      border:1px solid var(--stroke) !important;
      box-shadow:0 16px 35px rgba(15,23,42,.14);
      overflow:hidden;
    }

    .ts-dropdown .option{
      padding:.7rem .85rem;
    }

    .ts-dropdown .active{
      background:
        color-mix(
          in srgb,
          var(--theme-color-secondaire) 13%,
          transparent
        );
      color:var(--ink);
    }

    .roles-select + .ts-wrapper .item{
      border-radius:999px !important;
      padding:.28rem .65rem !important;
      font-weight:700;
      background:
        color-mix(
          in srgb,
          var(--theme-color-secondaire) 16%,
          #fff
        ) !important;
      border:
        1px solid
        color-mix(
          in srgb,
          var(--theme-color-secondaire) 45%,
          transparent
        ) !important;
      color:var(--ink) !important;
    }

    /* ================= COLOR ================= */

    .color-preview{
      width:42px;
      height:42px;
      border-radius:12px;
      border:1px solid var(--stroke);
      flex:0 0 auto;
      background:#e5e7eb;
      box-shadow:inset 0 0 0 3px rgba(255,255,255,.65);
    }

    /* ================= SUMMARY ================= */

    .summary-box{
      border:1px solid var(--stroke);
      border-radius:16px;
      padding:1rem;
      background:
        linear-gradient(
          180deg,
          color-mix(
            in srgb,
            var(--theme-color-principal) 8%,
            transparent
          ),
          transparent
        );
    }

    .summary-line{
      display:flex;
      justify-content:space-between;
      gap:1rem;
      padding:.45rem 0;
      font-size:.92rem;
    }

    .summary-line + .summary-line{
      border-top:1px solid rgba(15,23,42,.06);
    }

    .summary-value{
      font-weight:700;
      text-align:right;
      word-break:break-word;
    }

    /* ================= ACTIONS ================= */

    .sticky-actions{
      position:sticky;
      bottom:14px;
      z-index:5;
      background:
        color-mix(
          in srgb,
          var(--panel) 82%,
          transparent
        );
      backdrop-filter:blur(10px);
      border:1px solid var(--stroke);
      border-radius:var(--radius);
      padding:.75rem;
      box-shadow:var(--shadow);
    }

    .btn-gradient{
      border:0;
      color:#fff;
      font-weight:800;
      border-radius:12px;

      background:
        linear-gradient(
          135deg,
          var(--theme-color-principal),
          color-mix(
            in srgb,
            var(--theme-color-principal) 70%,
            #fff
          )
        );
    }

    .btn-gradient:hover{
      color:#fff;
      filter:brightness(.96);
    }

    @media (max-width:768px){
      .hero{
        border-radius:16px;
      }
    }
  </style>
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
{% endblock %}

