{% extends 'base_admin.html.twig' %}

{% block title %}
  Super — Comptes — {{ entite.nom }}
{% endblock %}


{% block stylesheets %}
  {{ parent() }}

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/style-table.css') }}">

  <link
    rel="stylesheet"
    href="https://cdn.datatables.net/v/bs5/dt-2.2.2/b-3.0.2/b-html5-3.0.2/b-print-3.0.2/datatables.min.css"
  >

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css"
  >

  <style>
    :root{
      --theme-color-principal:
        {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};

      --theme-color-secondaire:
        {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};

      --theme-color-tertiaire:
        {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};

      --theme-color-quaternaire:
        {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }


    /* =========================================================
       HERO
       ========================================================= */

    .hero{
      border-radius:22px;
      position:relative;
      overflow:hidden;
      color:#fff;

      box-shadow:0 18px 50px rgba(0,0,0,.14);

      background:
        radial-gradient(
          1200px 420px at 12% -10%,
          color-mix(
            in srgb,
            var(--theme-color-tertiaire) 35%,
            transparent
          ),
          transparent 58%
        ),

        radial-gradient(
          900px 380px at 92% 0%,
          color-mix(
            in srgb,
            var(--theme-color-secondaire) 32%,
            transparent
          ),
          transparent 60%
        ),

        radial-gradient(
          700px 260px at 55% 115%,
          color-mix(
            in srgb,
            var(--theme-color-quaternaire) 18%,
            transparent
          ),
          transparent 62%
        ),

        linear-gradient(
          135deg,
          color-mix(
            in srgb,
            var(--theme-color-principal) 92%,
            #000 8%
          ),
          color-mix(
            in srgb,
            var(--theme-color-principal) 70%,
            #fff 30%
          )
        );
    }

    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;

      background:
        linear-gradient(
          180deg,
          rgba(255,255,255,.10),
          rgba(255,255,255,0) 55%
        );

      opacity:.85;
    }

    .hero .accent{
      width:12px;
      border-radius:999px;
      background:var(--theme-color-secondaire);

      box-shadow:
        0 0 0 6px
        color-mix(
          in srgb,
          var(--theme-color-secondaire) 18%,
          transparent
        );
    }

    .chip{
      display:inline-flex;
      align-items:center;
      gap:.45rem;

      padding:.28rem .65rem;

      border-radius:999px;

      font-size:.82rem;

      background:rgba(255,255,255,.10);

      border:1px solid rgba(255,255,255,.14);

      color:rgba(255,255,255,.92);

      white-space:nowrap;
    }

    .chip i{
      color:var(--theme-color-secondaire);
    }

    .hero .btn{
      border-radius:14px;
      font-weight:800;
    }


    /* =========================================================
       FILTER BAR
       ========================================================= */

    .filterbar{
      background:#fff;

      border-radius:18px;

      border:1px solid rgba(0,0,0,.06);

      box-shadow:
        0 10px 24px rgba(0,0,0,.05);

      overflow:visible;
    }

    .filterbar__top{
      padding:.9rem 1rem;

      border-bottom:
        1px solid rgba(0,0,0,.06);

      background:
        linear-gradient(
          180deg,
          rgba(0,0,0,.015),
          transparent
        );

      display:flex;
      align-items:center;
      gap:.75rem;
    }

    .filterbar__title{
      font-weight:800;
      letter-spacing:-.01em;
      margin:0;
      font-size:1rem;
    }

    .filterbar__hint{
      color:rgba(0,0,0,.55);
      font-size:.85rem;
      margin-left:.25rem;
    }

    .filterbar__body{
      padding:1rem;
    }

    .filtergrid{
      display:grid;

      grid-template-columns:
        repeat(12,minmax(0,1fr));

      gap:.75rem;
      align-items:end;
    }

    .fcol-role{
      grid-column:span 3;
    }

    .fcol-function{
      grid-column:span 3;
    }

    .fcol-search{
      grid-column:span 5;
    }

    .fcol-actions{
      grid-column:span 1;
    }

    @media (max-width:1200px){
      .fcol-role{
        grid-column:span 4;
      }

      .fcol-function{
        grid-column:span 4;
      }

      .fcol-search{
        grid-column:span 4;
      }

      .fcol-actions{
        grid-column:span 12;
      }
    }

    @media (max-width:768px){
      .fcol-role,
      .fcol-function,
      .fcol-search,
      .fcol-actions{
        grid-column:span 12;
      }

      .hero{
        border-radius:16px;
      }
    }

    .filter-control .form-label{
      font-size:.78rem;
      font-weight:700;

      color:rgba(0,0,0,.55);

      text-transform:uppercase;

      letter-spacing:.06em;

      margin-bottom:.25rem;
    }

    .filterbox{
      border:
        1px solid rgba(0,0,0,.08);

      border-radius:14px;

      padding:.55rem .6rem;

      background:#fff;

      box-shadow:
        0 8px 18px rgba(0,0,0,.04);
    }

    .filterbox:focus-within{
      border-color:
        rgba(255,193,7,.55);

      box-shadow:
        0 0 0 .2rem rgba(255,193,7,.18),
        0 10px 18px rgba(0,0,0,.06);
    }

    .filterrow{
      display:flex;
      gap:.6rem;
      align-items:center;
    }

    .filter-icon{
      width:38px;
      height:38px;

      border-radius:14px;

      display:grid;
      place-items:center;

      background:
        color-mix(
          in srgb,
          var(--theme-color-principal) 10%,
          transparent
        );

      border:
        1px solid
        color-mix(
          in srgb,
          var(--theme-color-principal) 18%,
          transparent
        );

      color:
        color-mix(
          in srgb,
          var(--theme-color-principal) 75%,
          #000 25%
        );

      flex:0 0 auto;
    }

    .filterbox .form-select,
    .filterbox .form-control{
      border:0 !important;

      box-shadow:none !important;

      padding-left:0 !important;

      padding-right:0 !important;

      background:transparent !important;
    }


    /* =========================================================
       RESET
       ========================================================= */

    .resetbox{
      border:
        1px solid rgba(0,0,0,.08);

      border-radius:14px;

      padding:.55rem .6rem;

      background:#fff;

      box-shadow:
        0 8px 18px rgba(0,0,0,.04);

      cursor:pointer;

      width:100%;

      display:flex;
      align-items:center;
      justify-content:center;

      transition:all .16s ease;
    }

    .resetbox:hover{
      border-color:
        rgba(0,0,0,.14);

      box-shadow:
        0 10px 20px rgba(0,0,0,.06);

      transform:
        translateY(-1px);
    }

    .resetbox.is-active{
      border-color:
        rgba(255,193,7,.35);

      background:
        rgba(255,193,7,.06);
    }

    .resetbox:disabled{
      cursor:default;

      opacity:.55;

      transform:none;
    }

    .resetbox__text{
      font-size:.9rem;

      font-weight:800;

      color:
        rgba(0,0,0,.65);
    }

    .resetbox__badge{
      min-width:28px;
      height:22px;

      padding:0 .5rem;

      border-radius:999px;

      display:inline-flex;

      align-items:center;
      justify-content:center;

      font-size:.78rem;

      font-weight:800;

      background:
        rgba(0,0,0,.06);

      color:
        rgba(0,0,0,.65);

      border:
        1px solid rgba(0,0,0,.08);

      margin-left:.5rem;
    }

    .resetbox.is-active .resetbox__badge{
      background:
        rgba(255,193,7,.22);

      border-color:
        rgba(255,193,7,.30);
    }


    /* =========================================================
       ACTIVE FILTERS
       ========================================================= */

    .active-filters{
      padding:.65rem 1rem;

      border-top:
        1px solid rgba(0,0,0,.06);

      background:#fff;

      display:flex;

      align-items:center;

      gap:.5rem;

      flex-wrap:wrap;
    }

    .active-filters .label{
      font-size:.8rem;

      color:
        rgba(0,0,0,.55);

      font-weight:800;

      margin-right:.25rem;
    }

    .af-badge{
      display:inline-flex;

      align-items:center;

      gap:.35rem;

      border-radius:999px;

      padding:.35rem .6rem;

      border:
        1px solid rgba(0,0,0,.08);

      background:
        rgba(0,0,0,.03);

      font-size:.82rem;

      cursor:pointer;
    }

    .af-badge:hover{
      background:
        rgba(255,193,7,.12);

      border-color:
        rgba(255,193,7,.25);
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .table-card{
      background:#fff;

      border-radius:18px;

      border:
        1px solid rgba(0,0,0,.06);

      box-shadow:
        0 12px 30px rgba(0,0,0,.06);

      overflow:visible;
    }

    table.dataTable{
      margin:0 !important;
    }

    table.dataTable thead th{
      background:
        #f7f8fa !important;

      border-bottom:
        1px solid rgba(0,0,0,.08) !important;

      font-size:.78rem;

      text-transform:uppercase;

      letter-spacing:.05em;

      color:
        rgba(0,0,0,.55);

      text-align:center !important;

      vertical-align:middle;
    }

    #tableauEntiteUsers tbody td{
      padding-top:.65rem !important;

      padding-bottom:.65rem !important;

      vertical-align:middle;

      text-align:center !important;
    }

    #tableauEntiteUsers tbody tr:nth-child(even) > *{
      background:
        rgba(35,51,66,.035) !important;
    }

    #tableauEntiteUsers tbody tr:hover > *{
      background:
        rgba(255,193,7,.08) !important;
    }

    #tableauEntiteUsers_wrapper .dataTables_scrollBody{
      overflow-x:auto !important;

      -webkit-overflow-scrolling:touch;

      scrollbar-gutter:
        stable both-edges;
    }


    /* =========================================================
       USER
       ========================================================= */

    .user-cell{
      display:flex;

      align-items:center;

      gap:.65rem;

      text-align:left;
    }

    .avatar{
      width:40px;
      height:40px;

      border-radius:14px;

      display:grid;
      place-items:center;

      flex:0 0 auto;

      border:
        1px solid rgba(0,0,0,.08);

      background:
        rgba(0,0,0,.03);

      font-weight:900;

      color:#0f2336;

      position:relative;

      overflow:hidden;
    }

    .avatar::after{
      content:"";

      position:absolute;

      inset:-40px;

      background:
        radial-gradient(
          circle at 30% 30%,
          rgba(255,193,7,.22),
          transparent 50%
        );

      pointer-events:none;
    }

    .avatar span{
      position:relative;
      z-index:1;
    }

    .user-name{
      font-weight:800;

      color:#0f2336;

      line-height:1.15;
    }

    .user-email{
      font-size:.78rem;

      color:
        rgba(0,0,0,.55);

      margin-top:.2rem;
    }


    /* =========================================================
       ROLES
       ========================================================= */

    .role-badges{
      display:flex;

      flex-wrap:wrap;

      gap:.35rem;

      justify-content:center;
    }

    .role-badge{
      display:inline-flex;

      align-items:center;

      gap:.35rem;

      padding:.28rem .55rem;

      border-radius:999px;

      font-size:.78rem;

      font-weight:700;

      letter-spacing:.2px;

      border:
        1px solid rgba(0,0,0,.08);

      background:
        rgba(0,0,0,.04);

      color:#0f2336;

      white-space:nowrap;
    }

    .rb-stagiaire{
      background:
        rgba(13,110,253,.10);

      border-color:
        rgba(13,110,253,.18);

      color:#0b3b8a;
    }

    .rb-formateur{
      background:
        rgba(25,135,84,.12);

      border-color:
        rgba(25,135,84,.20);

      color:#0a4b2e;
    }

    .rb-admin{
      background:
        rgba(255,193,7,.16);

      border-color:
        rgba(255,193,7,.26);

      color:#6a4a00;
    }

    .rb-entreprise{
      background:
        rgba(108,117,125,.14);

      border-color:
        rgba(108,117,125,.25);

      color:#2c3338;
    }

    .rb-commercial{
      background:
        rgba(13,202,240,.14);

      border-color:
        rgba(13,202,240,.26);

      color:#035d6f;
    }


    /* =========================================================
      ACTIONS UTILISATEURS — CORRECTION AFFICHAGE
      ========================================================= */

    #tableauEntiteUsers td.action-column{
      text-align:right !important;
      white-space:nowrap !important;
      padding:.45rem .55rem !important;
      vertical-align:middle !important;
      width:1% !important;
    }

    .user-actions{
      display:inline-flex !important;
      align-items:stretch;
      vertical-align:middle;
      white-space:nowrap;
      border-radius:14px;
      overflow:hidden;
      box-shadow:0 8px 18px rgba(15,23,42,.05);
    }

    /* bouton principal */
    .user-actions .user-main{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.45rem;

      min-height:38px;
      padding:.42rem .75rem !important;

      border:1px solid rgba(15,23,42,.12) !important;
      border-right:0 !important;

      border-radius:14px 0 0 14px !important;

      background:#fff !important;
      color:#243447 !important;

      font-weight:700;
      line-height:1;

      box-shadow:none !important;
    }

    /* bouton flèche */
    .user-actions .user-split{
      display:inline-flex;
      align-items:center;
      justify-content:center;

      width:42px;
      min-width:42px;
      min-height:38px;

      padding:0 !important;

      border:1px solid rgba(15,23,42,.12) !important;

      border-radius:0 14px 14px 0 !important;

      background:#fff !important;
      color:#243447 !important;

      box-shadow:none !important;
    }

    /* retire la séparation artificielle */
    .user-actions.btn-group .user-split::before{
      display:none !important;
    }

    /* évite les doubles bordures */
    .user-actions.btn-group .user-main{
      margin-right:-1px;
    }

    /* hover cohérent */
    .user-actions .user-main:hover,
    .user-actions .user-split:hover{
      background:rgba(255,193,7,.08) !important;
      border-color:rgba(255,193,7,.35) !important;
      color:#243447 !important;
    }

    /* icône */
    .user-actions .user-main i{
      font-size:.95rem;
    }

    /* petite flèche Bootstrap mieux centrée */
    .user-actions .dropdown-toggle::after{
      margin-left:0 !important;
      vertical-align:middle !important;
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width:768px){

      #tableauEntiteUsers td.action-column,
      #tableauEntiteUsers th.action-column{
        position:sticky;

        right:0;

        z-index:5;

        background:#fff;

        box-shadow:
          -12px 0 18px -14px rgba(0,0,0,.22);
      }

      #tableauEntiteUsers
      tbody tr:nth-child(even)
      > td.action-column{
        background:
          rgba(35,51,66,.035) !important;
      }

      #tableauEntiteUsers
      tbody tr:hover
      > td.action-column{
        background:
          rgba(255,193,7,.08) !important;
      }
    }

    .filterbar .ts-dropdown{
      z-index:2000 !important;
    }
  </style>
{% endblock %}


{% block javascripts %}
  {{ parent() }}

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

  <script src="https://cdn.datatables.net/v/bs5/dt-2.2.2/b-3.0.2/b-html5-3.0.2/b-print-3.0.2/datatables.min.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
{% endblock %}


{% block body %}

  {# =========================================================
     HERO
     ========================================================= #}

  <div class="hero p-3 mb-4 d-flex gap-3">

    <div class="accent"></div>

    <div class="flex-grow-1">

      <div
        class="
          d-flex
          align-items-start
          justify-content-between
          gap-3
          flex-wrap
        "
      >

        <div>

          <h2 class="m-0 fw-bold">

            <i
              class="bi bi-people me-2"
              style="color:var(--theme-color-secondaire)"
            ></i>

            Comptes rattachés

          </h2>

          <div class="opacity-75 mt-1">

            Gérer les utilisateurs rattachés à l’entité,
            leurs rôles et leurs fonctions.

          </div>

          <div class="d-flex gap-2 flex-wrap mt-3">

            <span class="chip">

              <i class="bi bi-building"></i>

              {{ entite.nom }}

            </span>

            <span class="chip">

              <i class="bi bi-shield-lock"></i>

              Super

            </span>

            <span class="chip">

              <i class="bi bi-people"></i>

              {{ items|length }}
              compte{{ items|length > 1 ? 's' : '' }}

            </span>

            <span class="chip">

              <i class="bi bi-clock-history"></i>

              <span id="hero-last-refresh">
                —
              </span>

            </span>

          </div>

        </div>


        <div class="d-flex gap-2">

          <a
            class="
              btn
              btn-light
              btn-sm
              fw-semibold
            "
            href="{{ path(
              'app_super_entite_users_new',
              {
                entite: entite.id
              }
            ) }}"
          >

            <i class="bi bi-person-plus me-1"></i>

            Ajouter un compte

          </a>

          <button
            type="button"
            class="
              btn
              btn-outline-light
              btn-sm
              fw-semibold
            "
            onclick="
              document
                .getElementById('filtersCollapse')
                ?.scrollIntoView({
                  behavior:'smooth'
                })
            "
          >

            <i class="bi bi-funnel me-1"></i>

            Filtres

          </button>

        </div>

      </div>

    </div>

  </div>


  {% include 'flagMessage.html.twig' %}


  {# =========================================================
     FILTER BAR
     ========================================================= #}

  <div class="filterbar mb-3">

    <div class="filterbar__top">

      <div
        class="
          d-flex
          align-items-center
          gap-2
          flex-wrap
        "
      >

        <div class="filter-icon">

          <i class="bi bi-funnel"></i>

        </div>

        <div>

          <div class="filterbar__title">

            Filtres

          </div>

          <div class="filterbar__hint">

            Affiner par rôle, fonction ou utilisateur.

          </div>

        </div>

      </div>


      <div
        class="
          ms-auto
          d-flex
          gap-2
          align-items-center
        "
      >

        <button
          class="
            btn
            btn-outline-secondary
            btn-sm
            fw-semibold
            d-md-none
          "
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#filtersCollapse"
        >

          <i class="bi bi-sliders"></i>

          Filtres

        </button>


        <div class="dropdown">

          <button
            class="
              btn
              btn-warning
              btn-sm
              fw-semibold
              dropdown-toggle
            "
            data-bs-toggle="dropdown"
          >

            <i class="bi bi-download"></i>

            Export

          </button>

          <ul
            class="
              dropdown-menu
              dropdown-menu-end
            "
            id="exportMenu"
          ></ul>

        </div>

      </div>

    </div>


    <div
      class="collapse d-md-block"
      id="filtersCollapse"
    >

      <div class="filterbar__body">

        <div class="filtergrid">


          {# ROLE #}

          <div
            class="
              filter-control
              fcol-role
            "
          >

            <div class="form-label">

              Rôle

            </div>

            <div class="filterbox">

              <div class="filterrow">

                <div class="filter-icon">

                  <i class="bi bi-person-badge"></i>

                </div>

                <select
                  id="rolesFilter"
                  class="
                    form-select
                    form-select-sm
                  "
                >

                  <option value="all">
                    Tous
                  </option>

                  <option value="Stagiaire">
                    Stagiaire
                  </option>

                  <option value="Formateur">
                    Formateur
                  </option>

                  <option value="Administrateur">
                    Administrateur
                  </option>

                  <option value="Entreprise">
                    Entreprise
                  </option>

                  <option value="Organisme">
                    Organisme
                  </option>

                  <option value="OPCO">
                    OPCO
                  </option>

                  <option value="Commercial">
                    Commercial
                  </option>

                  <option value="Dirigeant">
                    Dirigeant
                  </option>

                </select>

              </div>

            </div>

          </div>


          {# FONCTION #}

          <div
            class="
              filter-control
              fcol-function
            "
          >

            <div class="form-label">

              Fonction

            </div>

            <div class="filterbox">

              <div class="filterrow">

                <div class="filter-icon">

                  <i class="bi bi-briefcase"></i>

                </div>

                <input
                  type="text"
                  id="functionFilter"
                  class="
                    form-control
                    form-control-sm
                  "
                  placeholder="Responsable..."
                >

              </div>

            </div>

          </div>


          {# SEARCH #}

          <div
            class="
              filter-control
              fcol-search
            "
          >

            <div class="form-label">

              Recherche

            </div>

            <div class="filterbox">

              <div class="filterrow">

                <div class="filter-icon">

                  <i class="bi bi-search"></i>

                </div>

                <input
                  type="text"
                  id="searchName"
                  class="
                    form-control
                    form-control-sm
                  "
                  placeholder="
                    Nom / prénom / email
                  "
                >

              </div>

            </div>

          </div>


          {# RESET #}

          <div
            class="
              filter-control
              fcol-actions
            "
          >

            <div class="form-label">
              &nbsp;
            </div>

            <button
              id="btnReset"
              type="button"
              class="resetbox"
              title="Réinitialiser les filtres"
            >

              <i
                class="
                  bi
                  bi-arrow-counterclockwise
                  me-2
                "
              ></i>

              <span class="resetbox__text">

                Reset

              </span>

              <span
                class="resetbox__badge"
                id="resetCount"
                style="display:none;"
              >
                0
              </span>

            </button>

          </div>

        </div>

      </div>


      <div
        class="active-filters"
        id="activeFilters"
      >

        <span class="label">

          <i class="bi bi-lightning-charge"></i>

          Actifs :

        </span>

        <span
          class="text-muted small"
          id="activeFiltersEmpty"
        >

          Aucun

        </span>

      </div>

    </div>

  </div>


  {# =========================================================
     TABLE
     ========================================================= #}

  <div class="table-card mb-4 p-3">

    <table
      id="tableauEntiteUsers"
      class="
        table
        table-hover
        align-middle
        mb-0
        w-100
      "
    >

      <thead>

        <tr>

          <th>
            #
          </th>

          <th>
            Utilisateur
          </th>

          <th>
            Email
          </th>

          <th>
            Rôles
          </th>

          <th>
            Fonction
          </th>

          <th>
            Date d’ajout
          </th>

          <th
            class="
              action-column
              text-end
            "
          ></th>

        </tr>

      </thead>


      <tbody>

        {% for ue in items %}

          {% set u = ue.utilisateur %}

          {% set initials =
            (
              u.prenom|default('')|slice(0,1)
              ~
              u.nom|default('')|slice(0,1)
            )|upper
          %}

          {% set labels =
            ue.rolesLabels
          %}


          <tr>

            {# ID #}

            <td>

              {{ ue.id }}

            </td>


            {# USER #}

            <td
              data-search="
                {{ u.prenom }}
                {{ u.nom }}
                {{ u.email }}
              "
              data-order="
                {{ u.nom }}
                {{ u.prenom }}
              "
            >

              <div class="user-cell">

                <div
                  class="avatar"
                  style="
                    border-color:
                    {{ ue.couleur ?: '#e5e7eb' }};
                  "
                >

                  <span>

                    {{ initials ?: 'U' }}

                  </span>

                </div>

                <div>

                  <div class="user-name">

                    {{ u.prenom }}
                    {{ u.nom }}

                  </div>

                  <div class="user-email">

                    <i class="bi bi-person"></i>

                    Compte utilisateur

                  </div>

                </div>

              </div>

            </td>


            {# EMAIL #}

            <td>

              <a
                href="mailto:{{ u.email }}"
                class="
                  text-decoration-none
                  text-dark
                "
              >

                <i
                  class="
                    bi
                    bi-envelope
                    me-1
                    text-muted
                  "
                ></i>

                {{ u.email }}

              </a>

            </td>


            {# ROLES #}

            <td
              data-search="
                {{ labels|join(' ') }}
              "
            >

              <div class="role-badges">

                {% for label in labels %}

                  {% set roleClass =
                    label == 'Stagiaire'
                      ? 'rb-stagiaire'
                      :
                    label == 'Formateur'
                      ? 'rb-formateur'
                      :
                    label in [
                      'Administrateur',
                      'Dirigeant'
                    ]
                      ? 'rb-admin'
                      :
                    label == 'Commercial'
                      ? 'rb-commercial'
                      :
                    'rb-entreprise'
                  %}

                  {% set roleIcon =
                    label == 'Stagiaire'
                      ? 'bi-mortarboard'
                      :
                    label == 'Formateur'
                      ? 'bi-easel2'
                      :
                    label == 'Administrateur'
                      ? 'bi-shield-check'
                      :
                    label == 'Dirigeant'
                      ? 'bi-award'
                      :
                    label == 'Commercial'
                      ? 'bi-graph-up-arrow'
                      :
                    'bi-building'
                  %}

                  <span
                    class="
                      role-badge
                      {{ roleClass }}
                    "
                  >

                    <i
                      class="
                        bi
                        {{ roleIcon }}
                      "
                    ></i>

                    {{ label }}

                  </span>

                {% else %}

                  <span class="text-muted">

                    —

                  </span>

                {% endfor %}

              </div>

            </td>


            {# FONCTION #}

            <td>

              {% if ue.fonction %}

                {{ ue.fonction }}

              {% else %}

                <span class="text-muted">

                  —

                </span>

              {% endif %}

            </td>


            {# DATE #}

            <td
              data-order="
                {{ ue.dateCreation
                  ? ue.dateCreation|date('Y-m-d H:i:s')
                  : ''
                }}
              "
            >

              <span
                class="
                  d-inline-flex
                  align-items-center
                  gap-1
                "
              >

                <i
                  class="
                    bi
                    bi-calendar3
                    text-muted
                  "
                ></i>

                {{ ue.dateCreation
                  ? ue.dateCreation|date('d/m/Y')
                  : '—'
                }}

              </span>

            </td>


            {# ACTIONS #}

            <td
              class="
                action-column
                text-end
              "
            >

              <div
                class="
                  btn-group
                  user-actions
                "
              >

                <a
                  class="
                    btn
                    btn-sm
                    user-main
                  "
                  href="{{ path(
                    'app_super_entite_users_edit',
                    {
                      entite: entite.id,
                      id: ue.id
                    }
                  ) }}"
                >

                  <i
                    class="
                      bi
                      bi-pencil
                      me-1
                    "
                  ></i>

                </a>


                <button
                  type="button"
                  class="
                    btn
                    btn-sm
                    dropdown-toggle
                    dropdown-toggle-split
                    user-split
                  "
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                >

                  <span class="visually-hidden">

                    Actions

                  </span>

                </button>


                <ul
                  class="
                    dropdown-menu
                    dropdown-menu-end
                    user-menu
                  "
                >

                  <li>

                    <a
                      class="
                        dropdown-item
                      "
                      href="{{ path(
                        'app_super_entite_users_edit',
                        {
                          entite: entite.id,
                          id: ue.id
                        }
                      ) }}"
                    >

                      <i
                        class="
                          bi
                          bi-pencil-square
                          me-2
                        "
                      ></i>

                      Modifier

                    </a>

                  </li>


                  <li>

                    <hr
                      class="
                        dropdown-divider
                      "
                    >

                  </li>


                  <li>

                    <form
                      method="post"
                      action="{{ path(
                        'app_super_entite_users_delete',
                        {
                          entite: entite.id,
                          id: ue.id
                        }
                      ) }}"
                      onsubmit="
                        return confirm(
                          'Retirer cet utilisateur de l’entité ?'
                        );
                      "
                    >

                      <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                          'ue_del_' ~ ue.id
                        ) }}"
                      >

                      <button
                        class="
                          dropdown-item
                          text-danger
                          w-100
                          text-start
                        "
                        type="submit"
                      >

                        <i
                          class="
                            bi
                            bi-trash
                            me-2
                          "
                        ></i>

                        Retirer de l’entité

                      </button>

                    </form>

                  </li>

                </ul>

              </div>

            </td>

          </tr>

        {% endfor %}

      </tbody>

    </table>

  </div>


  <script>
    $(function(){

      const $roles =
        $('#rolesFilter');

      const $function =
        $('#functionFilter');

      const $search =
        $('#searchName');


      /* =====================================================
         HELPERS
         ===================================================== */

      function nowLabel(){

        const d =
          new Date();

        return (
          d.toLocaleDateString(
            'fr-FR'
          )
          +
          ' '
          +
          d.toLocaleTimeString(
            'fr-FR',
            {
              hour:'2-digit',
              minute:'2-digit'
            }
          )
        );
      }


      function escapeHtml(str){

        return String(str).replace(
          /[&<>"']/g,
          s => ({
            '&':'&amp;',
            '<':'&lt;',
            '>':'&gt;',
            '"':'&quot;',
            "'":'&#039;'
          }[s])
        );
      }


      /* =====================================================
         TOM SELECT
         ===================================================== */

      let tsRoles = null;

      function initTomSelect(){

        const common = {

          create:false,

          allowEmptyOption:true,

          maxItems:1,

          plugins:[
            'clear_button'
          ],

          render:{
            no_results:() =>
              '<div class="px-2 py-1 text-muted">Aucun résultat</div>'
          }

        };


        tsRoles?.destroy();


        tsRoles =
          new TomSelect(
            '#rolesFilter',
            {
              ...common,
              placeholder:'Tous'
            }
          );


        tsRoles.on(
          'change',
          () => applyFilters()
        );
      }


      /* =====================================================
         DATATABLE
         ===================================================== */

      const table =
        $('#tableauEntiteUsers')
          .DataTable({

            processing:true,

            autoWidth:false,

            scrollX:true,

            scrollCollapse:true,

            responsive:false,


            dom:
              '<"dt-top d-flex flex-wrap gap-2 align-items-center justify-content-between"'
                +
                '<"dt-actions d-flex gap-2 align-items-center"B>'
                +
                '<"dt-search"f>'
              +
              '>'
              +
              'rt'
              +
              '<"dt-bottom-internal d-flex flex-wrap gap-2 align-items-center justify-content-between"lip>',


            buttons:[
              'copy',
              'csv',
              'excel',
              'pdf',
              'print'
            ],


            lengthMenu:[
              [10,25,50,100,500],
              [10,25,50,100,500]
            ],


            pageLength:50,


            order:[
              [0,'desc']
            ],


            columnDefs:[

              {
                targets:6,
                className:
                  'action-column text-end',

                orderable:false,

                searchable:false
              },

              {
                targets:[
                  1,
                  2,
                  3,
                  4,
                  5
                ],

                className:
                  'text-center'
              }

            ],


            language:{
              url:
                'https://cdn.datatables.net/plug-ins/2.2.2/i18n/fr-FR.json'
            },


            initComplete:function(){

              const api =
                this.api();


              const $btns =
                $(
                  api
                    .buttons()
                    .container()
                )
                .find('button');


              $('#exportMenu')
                .empty();


              $btns.each(
                function(){

                  const $b =
                    $(this);


                  $('<li><a class="dropdown-item" href="#">'
                    +
                    $b.text()
                    +
                    '</a></li>')
                    .on(
                      'click',
                      e => {

                        e.preventDefault();

                        $b.click();
                      }
                    )
                    .appendTo(
                      '#exportMenu'
                    );
                }
              );


              $(
                api
                  .buttons()
                  .container()
              )
              .hide();


              api
                .columns
                .adjust();
            }

          });


      /* =====================================================
         CUSTOM FILTERING
         ===================================================== */

      $.fn.dataTable.ext.search.push(

        function(
          settings,
          data,
          dataIndex
        ){

          if (
            settings.nTable.id
            !==
            'tableauEntiteUsers'
          ){
            return true;
          }


          const selectedRole =
            $roles.val();


          const functionValue =
            ($function.val() || '')
              .trim()
              .toLowerCase();


          const rowRoles =
            (data[3] || '')
              .toLowerCase();


          const rowFunction =
            (data[4] || '')
              .toLowerCase();


          if (
            selectedRole
            &&
            selectedRole !== 'all'
          ){

            if (
              !rowRoles.includes(
                selectedRole
                  .toLowerCase()
              )
            ){
              return false;
            }
          }


          if (
            functionValue
            &&
            !rowFunction.includes(
              functionValue
            )
          ){
            return false;
          }


          return true;
        }
      );


      /* =====================================================
         ACTIVE FILTERS
         ===================================================== */

      function updateResetUi(
        count
      ){

        const btn =
          document.getElementById(
            'btnReset'
          );

        const badge =
          document.getElementById(
            'resetCount'
          );


        if(
          !btn
          ||
          !badge
        ){
          return;
        }


        if(count > 0){

          btn.disabled =
            false;

          btn.classList.add(
            'is-active'
          );

          badge.style.display =
            'inline-flex';

          badge.textContent =
            String(count);

        }
        else{

          btn.disabled =
            true;

          btn.classList.remove(
            'is-active'
          );

          badge.style.display =
            'none';

          badge.textContent =
            '0';

        }
      }


      function buildActiveFilters(){

        const filters =
          [];


        const role =
          $roles.val();


        if(
          role
          &&
          role !== 'all'
        ){

          filters.push({
            key:'role',
            label:'Rôle',
            value:
              $('#rolesFilter option:selected')
                .text()
          });
        }


        const func =
          ($function.val() || '')
            .trim();


        if(func){

          filters.push({
            key:'function',
            label:'Fonction',
            value:func
          });
        }


        const search =
          ($search.val() || '')
            .trim();


        if(search){

          filters.push({
            key:'search',
            label:'Recherche',
            value:search
          });
        }


        const $wrap =
          $('#activeFilters');


        $wrap
          .find('.af-badge')
          .remove();


        if(
          filters.length === 0
        ){

          $('#activeFiltersEmpty')
            .show();

          updateResetUi(0);

          return;
        }


        $('#activeFiltersEmpty')
          .hide();


        updateResetUi(
          filters.length
        );


        filters.forEach(
          item => {

            const $badge =
              $(`
                <span
                  class="af-badge"
                  data-key="${item.key}"
                >
                  <strong>
                    ${item.label} :
                  </strong>

                  ${escapeHtml(item.value)}

                  <i
                    class="
                      bi
                      bi-x-lg
                      ms-1
                    "
                  ></i>
                </span>
              `);


            $badge.on(
              'click',
              () => {

                switch(item.key){

                  case 'role':

                    tsRoles.setValue(
                      'all',
                      true
                    );

                    break;


                  case 'function':

                    $function.val('');

                    break;


                  case 'search':

                    $search.val('');

                    table.search('');

                    break;
                }


                applyFilters();
              }
            );


            $wrap.append(
              $badge
            );
          }
        );
      }


      /* =====================================================
         APPLY
         ===================================================== */

      function applyFilters(){

        table.search(
          $search.val()
          ||
          ''
        );


        table.draw();


        buildActiveFilters();


        $('#hero-last-refresh')
          .text(
            'Maj : '
            +
            nowLabel()
          );
      }


      /* =====================================================
         EVENTS
         ===================================================== */

      let searchTimer =
        null;


      $search.on(
        'input',
        function(){

          clearTimeout(
            searchTimer
          );


          searchTimer =
            setTimeout(
              applyFilters,
              250
            );
        }
      );


      let functionTimer =
        null;


      $function.on(
        'input',
        function(){

          clearTimeout(
            functionTimer
          );


          functionTimer =
            setTimeout(
              applyFilters,
              250
            );
        }
      );


      $('#btnReset').on(
        'click',
        function(){

          tsRoles.setValue(
            'all',
            true
          );

          $function.val('');

          $search.val('');

          table.search('');

          applyFilters();
        }
      );


      /* =====================================================
         FLOATING DROPDOWN
         ===================================================== */

      (function enableFloatingDropdown(){

        document.addEventListener(
          'show.bs.dropdown',
          function(e){

            const toggle =
              e.target;


            if(
              !toggle.closest(
                '.user-actions'
              )
            ){
              return;
            }


            const dd =
              toggle.closest(
                '.dropdown, .btn-group'
              );


            if(!dd){
              return;
            }


            const menu =
              dd.querySelector(
                '.dropdown-menu'
              );


            if(!menu){
              return;
            }


            if(
              !menu.__originalParent
            ){
              menu.__originalParent =
                dd;
            }


            document.body
              .appendChild(menu);


            menu.classList.add(
              'user-floating-dropdown'
            );


            const rect =
              toggle
                .getBoundingClientRect();


            menu.style.position =
              'absolute';

            menu.style.top =
              '0px';

            menu.style.left =
              '0px';

            menu.style.display =
              'block';


            const menuRect =
              menu
                .getBoundingClientRect();


            let left =
              rect.right
              +
              window.scrollX
              -
              menuRect.width;


            left =
              Math.max(
                8,
                Math.min(
                  left,
                  window.scrollX
                  +
                  window.innerWidth
                  -
                  menuRect.width
                  -
                  8
                )
              );


            menu.style.top =
              `${
                rect.bottom
                +
                window.scrollY
                +
                6
              }px`;


            menu.style.left =
              `${left}px`;

          },
          true
        );


        document.addEventListener(
          'hidden.bs.dropdown',
          function(e){

            const toggle =
              e.target;


            if(
              !toggle.closest(
                '.user-actions'
              )
            ){
              return;
            }


            document
              .querySelectorAll(
                'body .user-floating-dropdown'
              )
              .forEach(
                menu => {

                  const parent =
                    menu.__originalParent;


                  if(parent){

                    parent
                      .appendChild(menu);


                    menu.classList.remove(
                      'user-floating-dropdown'
                    );


                    menu.style.position =
                      '';

                    menu.style.top =
                      '';

                    menu.style.left =
                      '';

                    menu.style.display =
                      '';
                  }
                }
              );

          },
          true
        );

      })();


      /* =====================================================
         INIT
         ===================================================== */

      initTomSelect();

      buildActiveFilters();

      $('#hero-last-refresh')
        .text(
          'Maj : '
          +
          nowLabel()
        );


      window.addEventListener(
        'resize',
        () => {

          setTimeout(
            () =>
              table
                .columns
                .adjust(),
            150
          );
        }
      );

    });
  </script>

{% endblock %}