{% extends 'base_admin.html.twig' %}
{% block title %}Abonnement — {{ entite.nom }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <style>
    .subscription-workspace{--sub-ink:#203747;--sub-muted:#667789;--sub-line:#e3e9ef;color:var(--sub-ink);max-width:1500px;margin:0 auto;padding:8px 0 32px}
    .subscription-workspace .sub-back{display:inline-flex;align-items:center;gap:8px;color:var(--sub-muted);font-size:.88rem;text-decoration:none;margin-bottom:20px}
    .subscription-workspace .sub-hero{background:linear-gradient(115deg,#1d3343,#304b5c);border-radius:22px;padding:32px 36px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:24px;border-top:3px solid #edbd49}
    .subscription-workspace .sub-eyebrow{font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;font-weight:700;color:#e9c776;margin-bottom:12px}
    .subscription-workspace h1{font-size:clamp(1.7rem,3vw,2.3rem);font-weight:750;letter-spacing:-.035em;margin:0 0 10px}
    .subscription-workspace .sub-hero p{color:#cad6df;margin:0;line-height:1.6}
    .subscription-workspace .sub-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:12px 18px;border-radius:11px;font-weight:650;text-decoration:none;white-space:normal}
    .subscription-workspace .sub-btn-primary{background:#f4c34e;border:1px solid #f4c34e;color:#243746}
    .subscription-workspace .sub-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:24px 0}
    .subscription-workspace .sub-metric,.subscription-workspace .sub-panel{background:#fff;border:1px solid var(--sub-line);border-radius:18px;box-shadow:0 5px 20px rgba(26,48,66,.035)}
    .subscription-workspace .sub-metric{padding:23px;display:flex;align-items:flex-start;gap:15px}
    .subscription-workspace .sub-icon{width:44px;height:44px;display:grid;place-items:center;flex-shrink:0;border-radius:12px;background:#f0f4f7;color:#466478;font-size:1.15rem}
    .subscription-workspace .sub-label{color:var(--sub-muted);font-size:.82rem;margin-bottom:8px;display:block}
    .subscription-workspace .sub-value{font-size:1.25rem;font-weight:750;line-height:1.4;overflow-wrap:anywhere}
    .subscription-workspace .sub-help{color:var(--sub-muted);font-size:.84rem;line-height:1.6;margin:8px 0 0}
    .subscription-workspace .sub-layout{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);align-items:start;gap:24px}
    .subscription-workspace .sub-panel-head{padding:23px 26px;border-bottom:1px solid var(--sub-line);display:flex;align-items:center;gap:12px}
    .subscription-workspace h2{font-size:1.08rem;font-weight:750;margin:0;letter-spacing:-.015em}
    .subscription-workspace .sub-panel-body{padding:26px}
    .subscription-workspace .sub-status{display:inline-flex;align-items:center;gap:7px;border-radius:999px;font-size:.8rem;font-weight:650;padding:7px 12px;background:#eef3f7;color:#40586c}
    .subscription-workspace .sub-status.good{background:#eaf6ef;color:#217449}
    .subscription-workspace .sub-status.attention{background:#fff4da;color:#8b610b}
    .subscription-workspace .sub-status.bad{background:#fbeeed;color:#a14040}
    .subscription-workspace .sub-details{margin:0}
    .subscription-workspace .sub-detail{display:flex;justify-content:space-between;gap:24px;padding:18px 0;border-bottom:1px solid #edf1f5}
    .subscription-workspace .sub-detail:first-child{padding-top:0}
    .subscription-workspace .sub-detail:last-child{border-bottom:0;padding-bottom:0}
    .subscription-workspace dt{font-weight:400;color:var(--sub-muted);font-size:.9rem}
    .subscription-workspace dd{margin:0;text-align:right;font-weight:650;overflow-wrap:anywhere;min-width:0}
    .subscription-workspace dd small{display:block;font-weight:400;color:var(--sub-muted);margin-top:4px}
    .subscription-workspace .sub-trial-icon{background:#fff5dc;color:#967020}
    .subscription-workspace .sub-trial-form{display:flex;align-items:end;gap:12px;margin-top:22px}
    .subscription-workspace .sub-trial-field{flex:1;min-width:100px}
    .subscription-workspace .form-label{font-size:.85rem;font-weight:650}
    .subscription-workspace .form-control{border-color:#dbe3eb;border-radius:10px;min-height:47px}
    .subscription-workspace .sub-notice{background:#f5f8fa;border:1px solid #e8edf2;border-radius:11px;padding:13px 15px;margin-top:18px;color:var(--sub-muted);font-size:.83rem;line-height:1.6}
    .subscription-workspace .sub-tech{margin-top:20px;background:#fff;border:1px solid var(--sub-line);border-radius:14px;padding:18px 24px}
    .subscription-workspace .sub-tech summary{cursor:pointer;font-size:.87rem;font-weight:650;color:var(--sub-muted)}
    .subscription-workspace .sub-tech dl{margin-top:22px}
    .subscription-workspace .sub-tech code{font-size:.8rem;color:#425b70;overflow-wrap:anywhere}
    .subscription-workspace .sub-cancel{margin-top:20px;border-top:1px solid var(--sub-line);padding:22px 4px}
    .subscription-workspace .sub-cancel h2{font-size:.95rem}
    .subscription-workspace .sub-cancel button{margin-top:14px;font-size:.85rem}
    .subscription-workspace .sub-empty{text-align:center;margin-top:24px;padding:55px 24px}
    .subscription-workspace .sub-empty .sub-icon{margin:0 auto 20px;width:64px;height:64px;font-size:1.7rem}
    @media(max-width:991px){.subscription-workspace .sub-layout{grid-template-columns:1fr}.subscription-workspace .sub-metric{padding:18px;gap:10px}.subscription-workspace .sub-metric .sub-icon{display:none}}
    @media(max-width:575px){.subscription-workspace .sub-hero{padding:26px 22px;align-items:start;flex-direction:column}.subscription-workspace .sub-metrics{grid-template-columns:1fr;gap:10px}.subscription-workspace .sub-metric .sub-icon{display:grid}.subscription-workspace .sub-panel-body,.subscription-workspace .sub-panel-head{padding:20px}.subscription-workspace .sub-trial-form{flex-direction:column;align-items:stretch}.subscription-workspace .sub-detail{gap:14px}}
  </style>
{% endblock %}

{% block body %}
  {% set statuses = {trialing: 'Période d’essai', active: 'Actif', incomplete: 'À finaliser', incomplete_expired: 'Activation expirée', past_due: 'Paiement en retard', unpaid: 'Impayé', canceled: 'Annulé', paused: 'Suspendu'} %}
  {% set expiredTrial = sub and sub.status == 'trialing' and sub.trialEndsAt and sub.trialEndsAt < date() %}
  {% set statusLabel = sub ? (expiredTrial ? 'Essai expiré' : statuses[sub.status]|default(sub.status)) : 'Aucun abonnement' %}
  {% set statusTone = sub ? (sub.status == 'active' ? 'good' : (sub.status in ['canceled', 'unpaid'] ? 'bad' : 'attention')) : '' %}
  <div class="subscription-workspace">
    <a class="sub-back" href="{{ path('app_super_admin_console', {entite: entite.id}) }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Console des organismes</a>
    <header class="sub-hero">
      <div>
        <div class="sub-eyebrow">Administration · Abonnement</div>
        <h1>{{ entite.nom }}</h1>
        <p>Gérez le forfait, les échéances et la période d’essai de cet organisme.</p>
      </div>
      <a class="sub-btn sub-btn-primary" href="{{ sub ? path('app_super_billing_subscription_edit', {entite: entite.id, id: sub.id}) : path('app_super_billing_subscription_new', {entite: entite.id}) }}">
        <i class="bi {{ sub ? 'bi-sliders' : 'bi-plus-circle' }}" aria-hidden="true"></i>{{ sub ? 'Modifier l’abonnement' : 'Créer un abonnement' }}
      </a>
    </header>
    <div class="mt-3">{% include 'flagMessage.html.twig' %}</div>
    {% if sub %}
      <div class="sub-metrics">
        <div class="sub-metric"><span class="sub-icon"><i class="bi bi-layers" aria-hidden="true"></i></span><div><span class="sub-label">Forfait actuel</span><div class="sub-value">{{ sub.plan ? sub.plan.name : 'Non défini' }}</div><p class="sub-help">{{ sub.intervale == 'year' ? 'Périodicité annuelle' : (sub.intervale == 'month' ? 'Périodicité mensuelle' : 'Périodicité non définie') }}</p></div></div>
        <div class="sub-metric"><span class="sub-icon"><i class="bi bi-activity" aria-hidden="true"></i></span><div><span class="sub-label">État de l’abonnement</span><span class="sub-status {{ statusTone }}"><i class="bi bi-circle-fill" aria-hidden="true" style="font-size:.4rem"></i>{{ statusLabel }}</span><p class="sub-help">{{ expiredTrial ? 'La date de fin d’essai est dépassée.' : 'Situation enregistrée pour cet organisme.' }}</p></div></div>
        <div class="sub-metric"><span class="sub-icon"><i class="bi bi-calendar3" aria-hidden="true"></i></span><div><span class="sub-label">Fin de période</span><div class="sub-value">{{ sub.currentPeriodEnd ? sub.currentPeriodEnd|date('d/m/Y') : 'Non renseignée' }}</div><p class="sub-help">{{ sub.currentPeriodEnd ? 'À ' ~ sub.currentPeriodEnd|date('H:i') : 'À définir dans l’abonnement' }}</p></div></div>
      </div>
      <div class="sub-layout">
        <div>
          <section class="sub-panel" aria-labelledby="subscription-details-title">
            <div class="sub-panel-head"><span class="sub-icon"><i class="bi bi-credit-card" aria-hidden="true"></i></span><h2 id="subscription-details-title">Détails de l’abonnement</h2></div>
            <div class="sub-panel-body"><dl class="sub-details">
              <div class="sub-detail"><dt>Organisme</dt><dd>{{ entite.nom }}<small>Entité n° {{ entite.id }}</small></dd></div>
              <div class="sub-detail"><dt>Forfait</dt><dd>{{ sub.plan ? sub.plan.name : 'Non défini' }}</dd></div>
              <div class="sub-detail"><dt>Périodicité</dt><dd>{{ sub.intervale == 'year' ? 'Annuelle' : (sub.intervale == 'month' ? 'Mensuelle' : sub.intervale) }}</dd></div>
              <div class="sub-detail"><dt>Fin de période</dt><dd>{{ sub.currentPeriodEnd ? sub.currentPeriodEnd|date('d/m/Y à H:i') : 'Non renseignée' }}</dd></div>
              <div class="sub-detail"><dt>Fin de l’essai</dt><dd>{{ sub.trialEndsAt ? sub.trialEndsAt|date('d/m/Y à H:i') : 'Aucune date définie' }}{% if expiredTrial %}<small>Essai arrivé à échéance</small>{% endif %}</dd></div>
            </dl></div>
          </section>
          <details class="sub-tech"><summary>Références de facturation · Stripe</summary><dl class="sub-details">
            <div class="sub-detail"><dt>Client</dt><dd><code>{{ sub.stripeCustomerId ?: 'Non associé' }}</code></dd></div>
            <div class="sub-detail"><dt>Abonnement</dt><dd><code>{{ sub.stripeSubscriptionId ?: 'Non associé' }}</code></dd></div>
          </dl></details>
        </div>
        <div>
          <section class="sub-panel" aria-labelledby="subscription-trial-title">
            <div class="sub-panel-head"><span class="sub-icon sub-trial-icon"><i class="bi bi-gift" aria-hidden="true"></i></span><h2 id="subscription-trial-title">Offrir une période d’essai</h2></div>
            <div class="sub-panel-body">
              <p class="sub-help mt-0">Accordez à <strong>{{ entite.nom }}</strong> une période d’essai à compter d’aujourd’hui.</p>
              <form method="post" action="{{ path('app_super_billing_subscription_grant_trial', {entite: entite.id, id: sub.id}) }}" class="sub-trial-form">
                <input type="hidden" name="_token" value="{{ csrf_token('grant_trial_' ~ sub.id) }}">
                <div class="sub-trial-field"><label class="form-label" for="subscription-trial-days">Durée en jours</label><input class="form-control" id="subscription-trial-days" type="number" min="1" max="365" name="days" value="14" required aria-describedby="subscription-trial-help"></div>
                <button class="sub-btn sub-btn-primary" type="submit"><i class="bi bi-gift" aria-hidden="true"></i> Offrir l’essai</button>
              </form>
              <div class="sub-notice" id="subscription-trial-help">De 1 à 365 jours. Cette action passe l’abonnement en période d’essai et remplace les dates de fin d’essai et de fin de période. Pour choisir une date précise, utilisez « Modifier l’abonnement ».</div>
            </div>
          </section>
          <section class="sub-cancel" aria-labelledby="subscription-cancel-title">
            <h2 id="subscription-cancel-title">Annulation de l’abonnement</h2>
            <p class="sub-help">Marque l’abonnement comme annulé sur la plateforme. Une éventuelle facturation Stripe doit être arrêtée séparément.</p>
            {% if sub.status != 'canceled' %}
              <form method="post" action="{{ path('app_super_billing_subscription_cancel_local', {entite: entite.id, id: sub.id}) }}" onsubmit="return confirm('Annuler cet abonnement sur la plateforme ? Cette action ne résilie pas la facturation Stripe.');">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_local_' ~ sub.id) }}">
                <button class="btn btn-outline-danger sub-btn" type="submit"><i class="bi bi-x-circle" aria-hidden="true"></i> Annuler sur la plateforme</button>
              </form>
            {% else %}<p class="sub-help"><i class="bi bi-check-circle" aria-hidden="true"></i> Cet abonnement est déjà annulé.</p>{% endif %}
          </section>
        </div>
      </div>
    {% else %}
      <section class="sub-panel sub-empty"><span class="sub-icon"><i class="bi bi-credit-card" aria-hidden="true"></i></span><h2>Aucun abonnement pour {{ entite.nom }}</h2><p class="sub-help">Créez un abonnement pour définir un forfait et proposer une période d’essai.</p><a class="sub-btn sub-btn-primary mt-4" href="{{ path('app_super_billing_subscription_new', {entite: entite.id}) }}"><i class="bi bi-plus-circle" aria-hidden="true"></i> Créer un abonnement</a></section>
    {% endif %}
  </div>
{% endblock %}
