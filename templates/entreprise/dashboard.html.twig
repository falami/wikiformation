{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/locales/fr.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.2.0/dist/signature_pad.umd.min.js"></script>
<script>
(function(){
  const escapeHtml = s => String(s||'').replace(/[&<>"']/g, m=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m]));
  const stripHtml = html => String(html||'').replace(/<[^>]+>/g,'').trim();

  function nowLabel(){
    const d = new Date();
    return d.toLocaleDateString('fr-FR') + ' ' +
      d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
  }

  const refreshEl = document.getElementById('hero-last-refresh');
  if(refreshEl) refreshEl.textContent = 'Maj : ' + nowLabel();

  const urls = {
    dt: "{{ path('app_entreprise_inscriptions_ajax', { entite: entite.id, entreprise: entreprise.id }) }}",
    cal: "{{ path('app_entreprise_calendar_feed', { entite: entite.id, entreprise: entreprise.id }) }}",
    docs: "{{ path('app_entreprise_documents_feed', { entite: entite.id, entreprise: entreprise.id }) }}",
    sessionDetailBase: "{{ path('app_entreprise_session_detail_ajax', { entite: entite.id, entreprise: entreprise.id, session: '__ID__' }) }}",
  };

  let DT = null;
  let CURRENT_SIGN = { signUrl:null, label:'' };

  function sessionDetailUrl(sessionId){
    return urls.sessionDetailBase.replace('__ID__', String(sessionId));
  }

  function computeKpis(rows){
    const now = new Date();
    const trainees = new Set();
    let upcoming=0, live=0;
    const sessions = new Set();

    rows.forEach(r=>{
      trainees.add(r.salarié || '');
      if(sessions.has(r.sessionId)) return;
      sessions.add(r.sessionId);
      const start = r.firstStartIso ? new Date(r.firstStartIso) : null;
      const end   = r.lastEndIso ? new Date(r.lastEndIso) : null;
      if(!start || !end) return;
      if(now < start) upcoming++;
      else if(now >= start && now <= end) live++;
    });

    document.getElementById('kpi-trainees').textContent = trainees.size || 0;
    document.getElementById('kpi-upcoming').textContent = upcoming;
    document.getElementById('kpi-live').textContent = live;
  }

  function refreshSessionFilter(rows){
    const sel = document.getElementById('filterSession');
    const map = new Map();
    rows.forEach(r=>{
      if(r.sessionId) map.set(r.sessionId, `${stripHtml(r.formation)} · ${r.code}`);
    });
    const current = sel.value;
    sel.innerHTML = `<option value="">— Toutes les sessions —</option>`;
    [...map.entries()].sort((a,b)=>String(a[1]).localeCompare(String(b[1]))).forEach(([id,label])=>{
      const opt = document.createElement('option');
      opt.value = String(id);
      opt.textContent = label;
      sel.appendChild(opt);
    });
    sel.value = map.has(Number(current)) ? current : '';
  }

  function docCard(d){
    const signed = !d.reviewUrl && !d.signUrl ? '<span class="badge bg-light text-secondary">Disponible</span>' : d.signedAt
      ? `<span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Signé</span>`
      : `<span class="badge bg-secondary">Non signé</span>`;

    const signBtn = d.reviewUrl ? `<a class="btn btn-sm btn-primary" href="${escapeHtml(d.reviewUrl)}"><i class="bi bi-pen"></i> ${d.signedAt ? 'Convention signée' : 'Consulter et signer'}</a>` : d.signUrl ? `
      <button class="btn btn-sm btn-outline-success js-sign-doc" data-url="${escapeHtml(d.signUrl)}" data-label="${escapeHtml(d.label)}">
        <i class="bi bi-pen"></i> Signer
      </button>
    ` : ``;

    return `
      <div class="col-12 col-md-6 col-xxl-4">
        <div class="section-card document-card p-3 h-100">
          <div class="d-flex justify-content-between gap-2">
            <div>
              <div class="document-icon"><i class="bi bi-file-earmark-text"></i></div><div class="fw-bold">${escapeHtml(d.label)}</div>
              <div class="small text-muted text-truncate" title="${escapeHtml(d.name)}">${escapeHtml(d.name)}</div>
              <div class="small text-muted mt-1"><i class="bi bi-clock"></i> ${escapeHtml(d.uploadedAt||'')}</div>
            </div>
            <div class="text-end">${signed}</div>
          </div>
          <div class="d-flex flex-wrap gap-2 mt-3 justify-content-end">
            <a class="btn btn-sm btn-outline-secondary" href="${escapeHtml(d.url)}" target="_blank">
              <i class="bi bi-download"></i> Ouvrir
            </a>
            ${signBtn}
          </div>
        </div>
      </div>
    `;
  }

  let documentsRequest;
  async function loadDocs(){
    documentsRequest?.abort();
    const controller = new AbortController();
    documentsRequest = controller;
    const sid = document.getElementById('filterSession').value || '';
    const url = new URL(urls.docs, window.location.origin);
    if (sid) url.searchParams.set('session', sid);
    const wrap = document.getElementById('docsList');
    const button = document.getElementById('btnLoadDocs');
    button.disabled = true;
    wrap.setAttribute('aria-busy', 'true');
    wrap.innerHTML = '<div class="col-12 document-empty">Chargement des documents…</div>';
    try {
      const response = await fetch(url, {signal:controller.signal, headers:{'Accept':'application/json'}});
      if (!response.ok) throw new Error('Les documents ne peuvent pas être chargés. Veuillez réessayer.');
      const result = await response.json();
      const rows = result.data || [];
      if (!sid) document.getElementById('kpi-docs').textContent = rows.length;
      document.getElementById('documents-count').textContent = rows.length+' document'+(rows.length>1?'s':'');
      wrap.innerHTML = rows.length ? rows.map(docCard).join('') : '<div class="col-12 document-empty"><i class="bi bi-folder2-open"></i><p>Aucun document disponible pour cette sélection.</p></div>';
    } catch(error) {
      if (error.name !== 'AbortError') {
        document.getElementById('documents-count').textContent = '';
        wrap.innerHTML = '<div class="col-12"><div class="alert alert-warning" role="alert">'+escapeHtml(error.message)+'</div></div>';
      }
    } finally {
      if(documentsRequest === controller){button.disabled=false;wrap.setAttribute('aria-busy','false');}
    }
  }

  function badgePresence(participant){
    if (participant.present) {
      return `<span class="badge bg-success-subtle text-success"><i class="bi bi-check2-circle me-1"></i>Présent</span>`;
    }
    if (participant.absent) {
      return `<span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-circle me-1"></i>Absent</span>`;
    }
    return `<span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-dash-circle me-1"></i>Non renseigné</span>`;
  }

  function renderJour(j){
    return `
      <div class="d-flex justify-content-between align-items-center border rounded-3 px-3 py-2 flex-wrap gap-2">
        <div>
          <div class="fw-semibold">${escapeHtml(j.dateLabel || '-')}</div>
          ${j.formateur ? `<div class="small text-muted"><i class="bi bi-person-badge me-1"></i>${escapeHtml(j.formateur)}</div>` : ``}
        </div>
        <div class="text-muted">${escapeHtml(j.heureDebut || '--:--')} → ${escapeHtml(j.heureFin || '--:--')}</div>
      </div>
    `;
  }

  function renderParticipant(p){
    return `
      <tr>
        <td class="fw-semibold">${escapeHtml(p.nom || '-')}</td>
        <td>${escapeHtml(p.email || '-')}</td>
        <td>${escapeHtml(p.telephone || '-')}</td>
        <td class="text-center">${escapeHtml(p.statut || '-')}</td>
        <td class="text-center">${badgePresence(p)}</td>
        <td class="text-end">${escapeHtml(p.montantDu || '-')}</td>
        <td class="text-end">${escapeHtml(p.montantRegle || '-')}</td>
      </tr>
    `;
  }

  function setSessionDetailLoadingState(state){
    document.getElementById('sessionDetailLoading').classList.toggle('d-none', state !== 'loading');
    document.getElementById('sessionDetailError').classList.toggle('d-none', state !== 'error');
    document.getElementById('sessionDetailContent').classList.toggle('d-none', state !== 'content');
  }

  let sessionDetailRequest;
  let activeDetailSession;
  async function loadSessionDocuments(sessionId, signal){
    const wrap = document.getElementById('detail-documents');
    const retry = document.getElementById('detail-documents-retry');
    retry.classList.add('d-none');
    wrap.setAttribute('aria-busy', 'true');
    wrap.innerHTML = '<div class="col-12 text-muted">Chargement des documents…</div>';
    try {
      const url = new URL(urls.docs, window.location.origin);
      url.searchParams.set('session', sessionId);
      const response = await fetch(url, {signal, headers: {'Accept':'application/json'}});
      if (!response.ok) throw new Error('Impossible de charger les documents.');
      const result = await response.json();
      if (signal.aborted) return;
      wrap.innerHTML = result.data?.length ? result.data.map(docCard).join('') : '<div class="col-12 text-muted">Aucun document disponible pour cette session.</div>';
    } catch (error) {
      if (signal.aborted) return;
      wrap.innerHTML = '<div class="col-12 text-danger" role="alert">'+escapeHtml(error.message)+'</div>';
      retry.classList.remove('d-none');
    } finally {
      if (!signal.aborted) wrap.setAttribute('aria-busy', 'false');
    }
  }


  async function openSessionDetail(sessionId){
    sessionDetailRequest?.abort();
    const controller = new AbortController();
    sessionDetailRequest = controller;
    activeDetailSession = sessionId;
    const archive = document.getElementById('detail-documents-archive');
    archive.classList.add('d-none');
    archive.removeAttribute('href');
    document.getElementById('detail-documents').replaceChildren();
    const modalEl = document.getElementById('sessionDetailModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

    document.getElementById('sessionDetailSubtitle').textContent = 'Chargement...';
    document.getElementById('sessionDetailError').textContent = '';
    document.getElementById('detail-map-wrap').replaceChildren();
    setSessionDetailLoadingState('loading');
    modal.show();

    try {
      const res = await fetch(sessionDetailUrl(sessionId), {
        signal: controller.signal,
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      });

      const json = await res.json();

      if (!res.ok || !json.success) {
        throw new Error(json.message || 'Impossible de charger le détail de la session.');
      }

      if (controller.signal.aborted) return;
      const s = json.session;
      if (s.documentsArchiveUrl) {
        archive.href = s.documentsArchiveUrl;
        archive.classList.remove('d-none');
      }
      loadSessionDocuments(sessionId, controller.signal);

      document.getElementById('sessionDetailSubtitle').textContent = `${s.formation || '-'} · ${s.code || '-'}`;
      document.getElementById('detail-code').textContent = s.code || '-';
      document.getElementById('detail-montant').textContent = s.montant || '-';
      document.getElementById('detail-presents').textContent = s.presentCount ?? 0;
      document.getElementById('detail-absents').textContent = s.absentCount ?? 0;

      document.getElementById('detail-formation').textContent = s.formation || '-';
      document.getElementById('detail-statut').textContent = s.statut || '-';
      document.getElementById('detail-formateur').textContent = s.formateur || '-';
      document.getElementById('detail-capacite').textContent = s.capacite ?? '-';
      document.getElementById('detail-site').textContent = s.siteNom || '-';
      document.getElementById('detail-adresse').textContent = s.adresse || '-';

      document.getElementById('detail-jours').innerHTML =
        (s.jours || []).length
          ? s.jours.map(renderJour).join('')
          : `<div class="text-muted">Aucun horaire défini.</div>`;

      const participants = s.participants || [];
      document.getElementById('detail-participants-count').textContent =
        `${participants.length} ${participants.length > 1 ? 'participants' : 'participant'}`;

      document.getElementById('detail-participants-body').innerHTML =
        participants.length
          ? participants.map(renderParticipant).join('')
          : `<tr><td colspan="7" class="text-muted text-center py-4">Aucun participant.</td></tr>`;

      const mapWrap = document.getElementById('detail-map-wrap');
      if (s.mapQuery) {
        const q = encodeURIComponent(s.mapQuery);
        mapWrap.replaceChildren(document.getElementById('detail-map-template').content.cloneNode(true));
        mapWrap.querySelector('[data-external-map]').dataset.mapSrc = `https://www.google.com/maps?q=${q}&output=embed`;
        mapWrap.querySelector('[data-map-link]').href = `https://www.google.com/maps/search/?api=1&query=${q}`;
        mapWrap.querySelector('[data-external-map]').dispatchEvent(new CustomEvent('wiki:load-session-map', { bubbles: true }));
      } else {
        mapWrap.innerHTML = `<div class="text-muted">Aucune localisation disponible.</div>`;
      }

      setSessionDetailLoadingState('content');
    } catch (e) {
      if (controller.signal.aborted) return;
      document.getElementById('sessionDetailError').textContent = e.message || 'Erreur de chargement.';
      setSessionDetailLoadingState('error');
    }
  }

  $(function(){
    // The scripts are loaded in <head>; bind modal controls only after DOM readiness.
  document.getElementById('detail-documents-retry').addEventListener('click', () => {
    if (activeDetailSession && sessionDetailRequest) loadSessionDocuments(activeDetailSession, sessionDetailRequest.signal);
  });
  document.getElementById('sessionDetailModal').addEventListener('hidden.bs.modal', () => sessionDetailRequest?.abort());

    DT = $('#table-ent').DataTable({
      ajax:{ url: urls.dt, type:'POST' },
      columns:[
        {data:'salarié'},
        {data:'formation', render:(d,type) => type === 'display' ? '<div class="dt-formation"><div class="dt-formation-title"><i class="bi bi-mortarboard me-2" aria-hidden="true"></i>'+ (d || '—') +'</div></div>' : d},
        {data:'code', className:'session-reference'},
        {data:'dates', render:(d,type) => type === 'display' ? '<div class="dt-dates"><span class="dt-chip dt-chip-primary"><i class="bi bi-calendar-week" aria-hidden="true"></i>'+ (d || 'Dates à définir') +'</span></div>' : d},
        {data:'statut', className:'session-status'},
        {data:'actions', className:'text-center'},
        {data:'firstStartIso', visible:false, searchable:false},
        {data:'lastEndIso', visible:false, searchable:false},
        {data:'sessionId', visible:false, searchable:false},
      ],
      order:[[6,'desc']],
      pageLength:10,
      language: { url:'https://cdn.datatables.net/plug-ins/2.3.4/i18n/fr-FR.json' },
      drawCallback:function(){
        const rows = this.api().rows().data().toArray();
        computeKpis(rows);
        refreshSessionFilter(rows);
      }
    });

    $('#btnLoadDocs').on('click', loadDocs);

    $('#btnRefresh').on('click', ()=>{
      DT.ajax.reload();
      loadDocs();
      const el = document.getElementById('hero-last-refresh');
      if(el) el.textContent = 'Maj : ' + nowLabel();
    });

    const cal = new FullCalendar.Calendar(document.getElementById('calendar'), {
      locale: 'fr',
      timeZone: 'Europe/Paris',
      firstDay: 1,
      height: 'auto',
      initialView: 'dayGridMonth',
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,listWeek'
      },
      buttonText: {
        today: "Aujourd'hui",
        month: "Mois",
        week: "Semaine",
        day: "Jour",
        list: "Liste"
      },
      titleFormat: { year: 'numeric', month: 'long' },
      dayHeaderFormat: { weekday: 'short' },
      events: urls.cal,
      eventClick: (info) => {
        info.jsEvent?.preventDefault();
        const sid = info.event.extendedProps?.sessionId || info.event.id;
        if (!sid) return;
        openSessionDetail(sid);
      }
    });
    cal.render();

    let pad = null;
    function initPad(){
      const canvas = document.getElementById('signatureCanvas');
      const wrap = canvas.parentElement;
      const cssWidth = wrap ? wrap.clientWidth : 600;
      const cssHeight = 200;

      canvas.style.width = cssWidth+'px';
      canvas.style.height = cssHeight+'px';

      const ratio = Math.max(window.devicePixelRatio || 1, 1);
      canvas.width = Math.floor(cssWidth * ratio);
      canvas.height = Math.floor(cssHeight * ratio);

      const ctx = canvas.getContext('2d');
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

      pad = new SignaturePad(canvas, {
        throttle:16,
        minWidth:.5,
        maxWidth:2.5,
        backgroundColor:'rgb(255,255,255)'
      });
    }

    $(document).on('click', '.js-open-docs', function(){
      const id = this.dataset.inscription;
      if (!id) return;
      const base = {{ path('app_entreprise_documents_inscription_archive', {entite:entite.id, entreprise:entreprise.id, id:999999, scope:'stagiaire'})|json_encode|raw }};
      document.getElementById('downloadLearnerDocs').href = base.replace('999999', id);
      document.getElementById('downloadSessionDocs').href = base.replace('999999', id).replace('/stagiaire', '/session');
      bootstrap.Modal.getOrCreateInstance(document.getElementById('documentDownloadModal')).show();
    });

    const notificationSession = new URLSearchParams(window.location.search).get('session');
  if (notificationSession && /^\d+$/.test(notificationSession)) openSessionDetail(notificationSession);
  $(document).on('click', '.js-open-session-detail', function(){
      const sid = this.dataset.session || '';
      if (!sid) return;
      openSessionDetail(sid);
    });

    $(document).on('click', '.js-sign-doc', function(){
      CURRENT_SIGN.signUrl = this.dataset.url;
      CURRENT_SIGN.label = this.dataset.label || 'Document';
      $('#sigMeta').text('Document : '+CURRENT_SIGN.label);

      const el = document.getElementById('signatureModal');
      el.addEventListener('shown.bs.modal', ()=>{
        initPad();
        pad.clear();
      }, { once:true });

      bootstrap.Modal.getOrCreateInstance(el, { backdrop:'static', focus:false }).show();
    });

    $('#btnClearSig').on('click', ()=> pad?.clear());

    $('#btnSaveSig').on('click', async ()=>{
      if(!pad || pad.isEmpty()){
        alert('Veuillez signer.');
        return;
      }
      if(!CURRENT_SIGN.signUrl){
        alert('URL manquante');
        return;
      }

      const dataUrl = pad.toDataURL('image/png');
      const fd = new FormData();
      fd.append('signatureData', dataUrl);

      const res = await fetch(CURRENT_SIGN.signUrl, {
        method:'POST',
        headers:{'X-Requested-With':'XMLHttpRequest'},
        body: fd
      });

      const json = await res.json().catch(()=>null);
      if(!res.ok || !json || json.success!==true){
        alert((json && (json.message||json.error)) || ('HTTP '+res.status));
        return;
      }

      bootstrap.Modal.getOrCreateInstance(document.getElementById('signatureModal')).hide();
      await loadDocs();
    });

    loadDocs();
  });
})();
</script>
{% endblock %}
