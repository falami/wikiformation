{% block body %}
<div class="enterprise-dashboard">
  {% include 'entreprise/_company_selector.html.twig' %}


  {# ===== HERO (copie stagiaire) ===== #}
  <div class="hero p-3 mb-4 d-flex gap-3">
    <div class="accent"></div>

    <div class="flex-grow-1">
      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
          <h2 class="m-0 fw-bold">
            <i class="bi bi-briefcase me-2" style="color:var(--theme-color-secondaire)"></i>
            Espace entreprise
          </h2>

          <div class="opacity-75 mt-1">
            RH · Sessions, salariés & documents
            {% if entreprise is defined and entreprise %}
              · <strong>{{ entreprise.raisonSociale }}</strong>
            {% endif %}
          </div>

          <div class="d-flex flex-wrap gap-2 mt-3">
            <span class="chip"><i class="bi bi-speedometer2"></i> Tableau de bord</span>
            <span class="chip"><i class="bi bi-building"></i> {{ entite.nom ?? '—' }}</span>

            <span class="chip chip--pill"><i class="bi bi-clock-history"></i> <span id="hero-last-refresh">À jour</span></span>
          </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <a class="btn btn-outline-theme btn-sm fw-semibold" href="{{ path('app_entreprise_documents_index', {entite:entite.id, entreprise:entreprise.id}) }}#pane-devis"><i class="bi bi-pen me-1"></i>Devis à signer</a>
          <a class="btn btn-outline-theme btn-sm fw-semibold" href="{{ path('app_entreprise_documents_index', {entite:entite.id, entreprise:entreprise.id}) }}#pane-conventions"><i class="bi bi-pen me-1"></i>Conventions à signer</a>
          <button class="btn btn-outline-theme btn-sm fw-semibold"
                  data-bs-toggle="modal"
                  data-bs-target="#uploadDocModal">
            <i class="bi bi-upload me-1"></i> Déposer un document
          </button>

          <button class="btn btn-outline-theme btn-sm fw-semibold" id="btnRefresh">
            <i class="bi bi-arrow-repeat me-1"></i> Actualiser
          </button>
        </div>
      </div>
    </div>
  </div>


  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3"><div class="kpi h-100"><div class="label">Salariés accompagnés</div><div class="value" id="kpi-trainees">—</div></div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="kpi h-100"><div class="label">Sessions à venir</div><div class="value" id="kpi-upcoming">—</div></div></div>
