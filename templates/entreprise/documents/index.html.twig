{# templates/entreprise/documents/index.html.twig #}
{% extends 'base_admin.html.twig' %}
{% block title %}Espace entreprise — Documents{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.2.2/datatables.min.css"/>

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

      --ink:#0f2336;
      --muted:#6b7b8a;
      --line:rgba(15,35,54,.10);
      --radius:20px;
      --shadow: 0 18px 50px rgba(0,0,0,.10);
      --shadow-soft: 0 12px 28px rgba(0,0,0,.06);
    }


    .pageWrap{width:100%;padding-top:0!important;color:var(--ink);padding-bottom:32px}
    .pageWrap .stickyHero{position:static;margin:0 0 24px;border-radius:22px;color:#fff;background:linear-gradient(120deg,#1b3040,#2e4d5d);border:1px solid #ffffff18;box-shadow:0 12px 30px #152c4012;overflow:hidden}
    .pageWrap .stickyRow{display:flex;align-items:center;flex-wrap:wrap;gap:20px;padding:30px}
    .pageWrap .avatar{display:grid;place-items:center;flex:0 0 54px;height:54px;border-radius:16px;background:#ffffff10;border:1px solid #ffffff24;font-size:23px;font-weight:600;color:#edca73}
    .pageWrap .hero-title{font-size:clamp(24px,2.2vw,34px);font-weight:700;letter-spacing:-.035em;margin:3px 0 12px}
    .pageWrap .chip{display:inline-flex;align-items:center;gap:8px;padding:6px 11px;border:1px solid #ffffff24;border-radius:8px;font-size:12px;color:#e0e9ef}
    .pageWrap .hint{font-size:13px;color:#c7d5de;line-height:1.6}
    .pageWrap .hero-foot{border-top:1px solid #ffffff20;padding-top:18px;margin-top:4px}
    .pageWrap .btn-ghost{background:#ffffff0d;color:#fff;border:1px solid #ffffff45;border-radius:10px;padding:11px 15px;font-weight:600;box-shadow:none}
    .pageWrap .btn-ghost:hover{background:#ffffff20;color:#fff}
    .pageWrap .tabsWrap{background:#fff;border:1px solid #e2e8ee;border-radius:20px;box-shadow:0 8px 30px #18334508;overflow:hidden}
    .pageWrap .tabsHead{position:static;padding:14px;background:#f7f9fb;border-bottom:1px solid #e2e8ee}
    .pageWrap .tabsScroller{overflow-x:auto;scrollbar-width:thin}
    .pageWrap #docsTabs{display:flex;flex-wrap:nowrap;gap:4px!important;min-width:max-content}
    .pageWrap .nav-link{border-radius:9px!important;font-size:13px!important;padding:12px 14px!important;font-weight:600;color:#536879;white-space:nowrap;transition:background .15s}
    .pageWrap .nav-link:hover{background:#e9eef3;color:#1d3749}
    .pageWrap .nav-link.active{background:#243e50;color:#fff;box-shadow:0 3px 7px #18334515}
    .pageWrap .tab-content{padding:26px!important}
    .pageWrap .cardX{background:#fff;border:0;border-radius:0;box-shadow:none}
    .pageWrap .cardX-h{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 0 22px;border-bottom:1px solid #edf0f4}
    .pageWrap .titleX{display:flex;align-items:center;gap:12px;font-size:20px;font-weight:650;letter-spacing:-.025em;margin:0}
    .pageWrap .titleX i{display:grid;place-items:center;width:38px;height:38px;background:#faf3df;color:#94701e;border-radius:10px}
    .pageWrap .cardX-b{padding:22px 0 0}
    .pageWrap .actionsRight,.pageWrap .toolbarRight{display:flex;gap:8px;align-items:center}
    .pageWrap .toolbarX{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:16px;background:#f7f9fb;border:1px solid #e7edf2;border-radius:12px}
    .pageWrap .toolbarLeft{display:flex;align-items:center;flex-wrap:wrap;gap:12px;flex:1;min-width:0}
    .pageWrap .toolbarLeft .form-select{width:auto;flex:0 1 250px;min-width:180px!important;max-width:100%;height:42px;padding:8px 36px 8px 13px;border:1px solid #dbe4ec;border-radius:9px;font-size:13px;font-weight:500;color:#334e61;background-color:#fff}
    .pageWrap .btn-outline-secondary{color:#536b7b;border:1px solid #dbe4ec;background:#fff;border-radius:9px;padding:9px 12px;font-size:13px;box-shadow:none}
    .pageWrap .btn-outline-secondary:hover{background:#edf2f6;color:#243e50}
    .pageWrap .table-responsive{overflow-x:auto}
    .pageWrap table.dataTable{border-collapse:separate!important;border-spacing:0!important;font-size:13px;width:100%!important}
    .pageWrap table.dataTable thead th{padding:15px 12px;background:#f7f9fb;color:#6a7f8e;font-size:11px;font-weight:650;text-transform:uppercase;letter-spacing:.055em;border-bottom:1px solid #e4ebf0!important;white-space:nowrap}
    .pageWrap table.dataTable tbody tr{box-shadow:none;background:#fff}
    .pageWrap table.dataTable tbody td{padding:18px 12px;vertical-align:middle;line-height:1.65;border-bottom:1px solid #edf1f5!important;border-top:0!important;color:#294356;overflow-wrap:break-word}
    .pageWrap table.dataTable tbody tr:hover td{background:#fafcfd}
    .pageWrap table .badge{font-weight:600;line-height:1.5;white-space:normal;text-align:left;border-radius:6px;padding:4px 7px}
    .pageWrap table td:last-child .btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-width:86px;margin:3px 0;padding:8px 12px;border-radius:8px!important;font-size:12px;font-weight:600!important;box-shadow:none;background:#f4f7fa;border:1px solid #dae4eb;color:#36586f;white-space:nowrap}
    .pageWrap table td:last-child .btn-primary{background:#243f52;color:#fff;border-color:#243f52}
    .pageWrap table td:last-child .btn:hover{background:#e6eef4;color:#233e50}
    .pageWrap :is(button,a,select,input):focus-visible{outline:3px solid #d9b65b;outline-offset:3px}
    .pageWrap .dt-container .dt-layout-row{margin:16px 0;gap:12px;font-size:12px;color:#718491}
    .pageWrap .dt-container .form-control,.pageWrap .dt-container .form-select{border:1px solid #dbe4ec;border-radius:8px;min-height:36px;font-size:13px;box-shadow:none}
    .pageWrap .dt-container .page-link{color:#486174;border-color:#e1e8ef;padding:7px 12px;box-shadow:none}
    .pageWrap .dt-container .active>.page-link{background:#243e50;color:#fff;border-color:#243e50}
    .pageWrap .dt-empty{padding:42px 16px!important;color:#718491!important;text-align:center}
    .documents-company .card{box-shadow:none!important;border:1px solid #e2e8ee!important;border-radius:14px;margin-bottom:22px!important}
    .documents-company form{font-size:13px}
    .documents-company .btn,.documents-company .form-select{font-size:13px;border-radius:9px;min-height:40px}
    .documents-company .btn-outline-primary{border-color:#29485d;color:#29485d}
    @media(max-width:767px){
      .pageWrap .stickyRow{padding:22px;gap:14px}
      .pageWrap .tab-content{padding:16px!important}
      .pageWrap .toolbarLeft{flex-basis:100%}
      .pageWrap .toolbarLeft .form-select{flex:1 1 100%;min-width:0!important}
      .pageWrap table.dataTable{min-width:620px}
      .documents-company .ms-auto{margin-left:0!important;width:100%}
    }
</style>
{% endblock %}

{% block body %}
  <div class="documents-company">{% include 'entreprise/_company_selector.html.twig' %}</div>
<div class="container-fluid px-3 px-lg-4 pageWrap">

  {% set rs = entreprise.raisonSociale|default('Entreprise') %}
  {% set initials = (rs|slice(0,1))|upper %}

  <div class="stickyHero">
    <div class="stickyRow">
      <div class="avatar">{{ initials ?: 'E' }}</div>

      <div class="flex-grow-1">
        <div class="small opacity-75">Espace entreprise</div>
        <h1 class="hero-title">Documents & suivis</h1>

        <div class="d-flex flex-wrap gap-2 mt-1">
          <span class="chip"><i class="bi bi-building"></i> {{ entreprise.raisonSociale }}</span>
          <span class="chip"><i class="bi bi-diagram-3"></i> {{ entite.nom ?? '—' }}</span>
        </div>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-ghost btn-sm" type="button" id="btnGlobalReload">
          <i class="bi bi-arrow-repeat"></i> Tout actualiser
        </button>
      </div>

      <div class="hero-foot w-100 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="hint">
          <i class="bi bi-shield-check"></i>
          Retrouvez les documents de vos salariés, les signatures et le suivi des formations.
        </div>

      </div>
    </div>
  </div>

  {% include 'flagMessage.html.twig' %}

  <div class="tabsWrap mb-3">
    <div class="tabsHead">
      <div class="tabsScroller">
        <ul class="nav nav-pills gap-2 m-0" role="tablist" id="docsTabs">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-devis" data-bs-toggle="pill" data-bs-target="#pane-devis" type="button" role="tab">
              <i class="bi bi-receipt me-1"></i> Devis
            </button>
          </li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="tab-convocations" data-bs-toggle="pill" data-bs-target="#pane-convocations" type="button" role="tab"><i class="bi bi-calendar2-check me-1"></i> Convocations</button></li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-factures" data-bs-toggle="pill" data-bs-target="#pane-factures" type="button" role="tab">
              <i class="bi bi-file-earmark-text me-1"></i> Factures
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-conventions" data-bs-toggle="pill" data-bs-target="#pane-conventions" type="button" role="tab">
              <i class="bi bi-file-earmark-lock me-1"></i> Conventions
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-emargements" data-bs-toggle="pill" data-bs-target="#pane-emargements" type="button" role="tab">
              <i class="bi bi-pen me-1"></i> Émargements
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-positionnement" data-bs-toggle="pill" data-bs-target="#pane-positionnement" type="button" role="tab">
              <i class="bi bi-signpost-split me-1"></i> Positionnement
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-qcm" data-bs-toggle="pill" data-bs-target="#pane-qcm" type="button" role="tab">
              <i class="bi bi-ui-checks-grid me-1"></i> QCM niveau
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-satis-stag" data-bs-toggle="pill" data-bs-target="#pane-satis-stag" type="button" role="tab">
              <i class="bi bi-emoji-smile me-1"></i> Stagiaires
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-satis-form" data-bs-toggle="pill" data-bs-target="#pane-satis-form" type="button" role="tab">
              <i class="bi bi-person-badge me-1"></i> Formateur
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-assiduite" data-bs-toggle="pill" data-bs-target="#pane-assiduite" type="button" role="tab">
              <i class="bi bi-clipboard-data me-1"></i> Assiduité
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div class="tab-content p-3">
      <div class="tab-pane fade" id="pane-convocations" role="tabpanel" aria-labelledby="tab-convocations">
        <h5 class="titleX"><i class="bi bi-calendar2-check"></i> Convocations des stagiaires</h5>
        <p class="text-muted mt-2 mb-4">Retrouvez les informations pratiques de chaque formation et téléchargez la convocation individuelle de vos salariés.</p>
        <div class="row g-3">
        {% for inscription in convocations %}
          {% if inscription.stagiaire and inscription.session and inscription.session.entite.id == entite.id %}
          <div class="col-12 col-xl-6"><article class="border rounded-4 p-4 h-100 d-flex flex-column gap-3" style="background:linear-gradient(145deg,#fff,#f7fafc)">
            <div class="d-flex align-items-center gap-3"><span class="rounded-3 p-3" style="background:#fff4d8;color:#926c1f"><i class="bi bi-calendar2-check fs-4"></i></span><div><h6 class="fw-bold mb-1">{{ inscription.stagiaire.prenom }} {{ inscription.stagiaire.nom }}</h6><span class="small text-muted">{{ inscription.session.code }}</span></div></div>
            <div class="fw-semibold">{{ inscription.session.formationLabel }}</div>
            <div class="small text-muted">{% for jour in inscription.session.jours %}<div><i class="bi bi-clock me-1"></i>{{ jour.dateDebut|date('d/m/Y') }} · {{ jour.dateDebut|date('H:i') }} – {{ jour.dateFin|date('H:i') }}</div>{% else %}Planning à confirmer{% endfor %}</div>
            <a class="btn btn-outline-primary rounded-3 mt-auto align-self-start" target="_blank" rel="noopener" href="{{ path('app_entreprise_documents_convocation_pdf',{entite:entite.id,entreprise:entreprise.id,id:inscription.id}) }}"><i class="bi bi-file-earmark-pdf me-2"></i>Consulter la convocation</a>
          </article></div>
          {% endif %}
        {% else %}<div class="col-12"><p class="text-muted p-4 border rounded-4">Aucune convocation disponible pour cette entreprise.</p></div>{% endfor %}
        </div>
      </div>

      {# ===================== DEVIS ===================== #}
      <div class="tab-pane fade show active" id="pane-devis" role="tabpanel" aria-labelledby="tab-devis">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-receipt"></i> Devis</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadDevis" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>

          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="devisStatus" style="min-width:240px;">
                  <option value="all">Tous statuts</option>
                  <option value="sent">Envoyé</option>
                  <option value="accepted">Accepté</option>
                  <option value="invoiced">Facturé</option>
                  <option value="canceled">Annulé</option>
                </select>
                <span class="text-muted small d-none d-md-inline"><i class="bi bi-search"></i> Recherche par numéro (champ DataTables)</span>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnDevisClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-devis" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th style="width:140px;">Date</th>
                    <th>Numéro</th>
                    <th class="text-end" style="width:140px;">TTC</th>
                    <th style="width:160px;">Statut</th>
                    <th class="text-end" style="width:120px;">PDF</th>
                  </tr>
                </thead>
              </table>
            </div>
          </div>
        </div>
      </div>

      {# ===================== FACTURES ===================== #}
      <div class="tab-pane fade" id="pane-factures" role="tabpanel" aria-labelledby="tab-factures">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-file-earmark-text"></i> Factures</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadFactures" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>

          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="factureStatus" style="min-width:240px;">
                  <option value="all">Tous statuts</option>
                  <option value="due">À payer</option>
                  <option value="paid">Payée</option>
                  <option value="canceled">Annulée</option>
                </select>
                <span class="text-muted small d-none d-md-inline"><i class="bi bi-lock"></i> Accès contrôlé (entreprise destinataire)</span>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnFactClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-factures" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th style="width:140px;">Date</th>
                    <th>Numéro</th>
                    <th class="text-end" style="width:140px;">TTC</th>
                    <th style="width:160px;">Statut</th>
                    <th class="text-end" style="width:120px;">PDF</th>
                  </tr>
                </thead>
              </table>
            </div>

          </div>
        </div>
      </div>

      {# ===================== CONVENTIONS / CONTRATS ===================== #}
      <div class="tab-pane fade" id="pane-conventions" role="tabpanel" aria-labelledby="tab-conventions">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-file-earmark-lock"></i> Conventions / Contrats</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadConventions" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>
          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="convSign" style="min-width:240px;">
                  <option value="all">Toutes</option>
                  <option value="signed">Signées</option>
                  <option value="pending">En attente</option>
                </select>
                <span class="text-muted small d-none d-md-inline"><i class="bi bi-pen"></i> Statut = signatures (entreprise/stagiaire/OF)</span>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnConvClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-conventions" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th style="width:140px;">Créée</th>
                    <th style="width:170px;">Numéro</th>
                    <th>Session</th>
                    <th>Stagiaire(s)</th>
                    <th style="width:160px;">Signatures</th>
                    <th class="text-end" style="width:120px;">PDF</th>
                  </tr>
                </thead>
              </table>
            </div>
          </div>
        </div>
      </div>

      {# ===================== EMARGEMENTS ===================== #}
      <div class="tab-pane fade" id="pane-emargements" role="tabpanel" aria-labelledby="tab-emargements">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-pen"></i> Émargements</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadEmargements" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>
          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="emarSigned" style="min-width:240px;">
                  <option value="all">Tous</option>
                  <option value="signed">Signés</option>
                  <option value="missing">Manquants</option>
                </select>
                <span class="text-muted small d-none d-md-inline"><i class="bi bi-calendar3"></i> Signatures enregistrées des salariés de votre entreprise et du formateur</span>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnEmarClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-emargements" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th>Session</th>
                    <th style="width:260px;">Période</th>
                    <th style="width:160px;">Signatures</th>
                    <th style="width:160px;">Statut</th>
                    <th class="text-end" style="width:140px;">PDF</th>
                  </tr>
                </thead>
              </table>
            </div>
            <div class="small text-muted mt-2">
              Consultez le PDF pour retrouver le détail des signatures par journée.
            </div>
          </div>
        </div>
      </div>

      {# ===================== POSITIONNEMENT ===================== #}
      <div class="tab-pane fade" id="pane-positionnement" role="tabpanel" aria-labelledby="tab-positionnement">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-signpost-split"></i> Questionnaires de positionnement</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadPos" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>
          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="posState" style="min-width:240px;">
                  <option value="all">Tous</option>
                  <option value="submitted">Soumis</option>
                  <option value="started">Démarrés</option>
                  <option value="pending">Non commencés</option>
                </select>
                <span class="text-muted small d-none d-md-inline"><i class="bi bi-info-circle"></i> Le “résumé” peut inclure niveau suggéré / conclusion</span>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnPosClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-positionnement" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th style="width:140px;">Démarré</th>
                    <th>Session</th>
                    <th>Stagiaire(s)</th>
                    <th style="width:160px;">Soumis</th>
                    <th style="width:200px;">Synthèse</th>
                    <th class="text-end" style="width:140px;">Détails</th>
                  </tr>
                </thead>
              </table>
            </div>
          </div>
        </div>
      </div>

      {# ===================== QCM NIVEAU ===================== #}
      <div class="tab-pane fade" id="pane-qcm" role="tabpanel" aria-labelledby="tab-qcm">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-ui-checks-grid"></i> Questionnaires de niveau (QCM)</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadQcm" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>
          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="qcmPhase" style="min-width:240px;">
                  <option value="all">Toutes phases</option>
                  <option value="pre">Pré</option>
                  <option value="post">Post</option>
                </select>
                <select class="form-select form-select-sm" id="qcmState" style="min-width:240px;">
                  <option value="all">Tous statuts</option>
                  <option value="assigned">Assigné</option>
                  <option value="submitted">Soumis</option>
                </select>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnQcmClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-qcm" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th style="width:140px;">Assigné</th>
                    <th>Session</th>
                    <th>Stagiaire(s)</th>
                    <th style="width:140px;">Phase</th>
                    <th style="width:160px;">Score</th>
                    <th class="text-end" style="width:140px;">Détails</th>
                  </tr>
                </thead>
              </table>
            </div>
          </div>
        </div>
      </div>

      {# ===================== SATISFACTION STAGIAIRES ===================== #}
      <div class="tab-pane fade" id="pane-satis-stag" role="tabpanel" aria-labelledby="tab-satis-stag">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-emoji-smile"></i> Appréciations stagiaires</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadSatisStag" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>
          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="satisStagState" style="min-width:240px;">
                  <option value="all">Tous</option>
                  <option value="submitted">Soumis</option>
                  <option value="pending">En attente</option>
                </select>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnSatisStagClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-satis-stag" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th style="width:140px;">Créé</th>
                    <th>Session</th>
                    <th>Stagiaire(s)</th>
                    <th style="width:200px;">Notes</th>
                    <th style="width:160px;">Statut</th>
                    <th class="text-end" style="width:140px;">Détails</th>
                  </tr>
                </thead>
              </table>
            </div>
          </div>
        </div>
      </div>

      {# ===================== SATISFACTION FORMATEUR ===================== #}
      <div class="tab-pane fade" id="pane-satis-form" role="tabpanel" aria-labelledby="tab-satis-form">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-person-badge"></i> Appréciations formateur</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadSatisForm" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>
          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="satisFormState" style="min-width:240px;">
                  <option value="all">Tous</option>
                  <option value="submitted">Soumis</option>
                  <option value="pending">En attente</option>
                </select>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnSatisFormClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-satis-form" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th style="width:140px;">Créé</th>
                    <th>Session</th>
                    <th style="width:220px;">Formateur</th>
                    <th style="width:200px;">Synthèse</th>
                    <th style="width:160px;">Statut</th>
                    <th class="text-end" style="width:140px;">Détails</th>
                  </tr>
                </thead>
              </table>
            </div>
          </div>
        </div>
      </div>

      {# ===================== ASSIDUITE ===================== #}
      <div class="tab-pane fade" id="pane-assiduite" role="tabpanel" aria-labelledby="tab-assiduite">
        <div class="cardX">
          <div class="cardX-h">
            <h5 class="titleX"><i class="bi bi-clipboard-data"></i> Fiches d’assiduité</h5>
            <div class="actionsRight">
              <button class="btn btn-sm btn-outline-secondary" id="btnReloadAssiduite" type="button" aria-label="Actualiser le tableau" title="Actualiser le tableau"><i class="bi bi-arrow-repeat"></i></button>
            </div>
          </div>
          <div class="cardX-b">
            <div class="toolbarX mb-3">
              <div class="toolbarLeft">
                <select class="form-select form-select-sm" id="assiduiteState" style="min-width:240px;">
                  <option value="all">Toutes</option>
                  <option value="ok">OK</option>
                  <option value="low">Assiduité faible</option>
                  <option value="missing">Incomplète</option>
                </select>
              </div>
              <div class="toolbarRight">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnAssiduiteClear"><i class="bi bi-eraser"></i> Réinitialiser</button>
              </div>
            </div>

            <div class="table-responsive">
              <table id="dt-assiduite" class="table align-middle w-100 mb-0">
                <thead>
                  <tr>
                    <th>Session</th>
                    <th>Stagiaire(s)</th>
                    <th style="width:170px;">Taux</th>
                    <th style="width:160px;">Statut</th>
                    <th class="text-end" style="width:140px;">PDF</th>
                  </tr>
                </thead>
              </table>
            </div>
            <div class="small text-muted mt-2">
              Cette table peut être alimentée depuis <code>Inscription.tauxAssiduite</code> + génération PDF “fiche assiduité”.
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>
{% include 'entreprise/documents/_invitation_modal.html.twig' %}
