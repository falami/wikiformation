{% extends 'base_admin.html.twig' %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }
  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
{% endblock %}
{% block title %}Appréciation {{ trainer ? 'formateur' : 'stagiaire' }}{% endblock %}
{% block body %}<div class="container py-4" style="max-width:1000px"><a class="btn btn-outline-secondary mb-4" href="{{ path('app_entreprise_documents_index',{entite:entite.id,entreprise:entreprise.id}) }}">Retour aux documents</a><header class="p-4 rounded-4 text-white mb-4" style="background:#233e50;border-top:3px solid #dfba58"><h1 class="h3">Appréciation {{ trainer ? 'formateur' : 'stagiaire' }}</h1><p>{{ person.prenom }} {{ person.nom }} · {{ session.code }}</p><small>Soumise le {{ attempt.submittedAt|date('d/m/Y à H:i', 'Europe/Paris') }}</small></header>
{% set chapter = null %}{% for answer in answers %}{% if chapter != answer.chapter %}<h2 class="h5 mt-4 mb-3">{{ answer.chapter }}</h2>{% set chapter = answer.chapter %}{% endif %}<article class="card border-light rounded-3 p-3 mb-2"><h3 class="h6">{{ answer.question }}</h3><div class="text-secondary" style="white-space:pre-wrap;overflow-wrap:anywhere">{{ answer.value }}</div></article>{% else %}<p>Aucune réponse disponible.</p>{% endfor %}</div>{% endblock %}
