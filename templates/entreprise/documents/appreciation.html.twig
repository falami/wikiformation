{% extends 'base_admin.html.twig' %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }
  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
{% endblock %}
{% block title %}Appréciation {{ trainer ? 'formateur' : 'stagiaire' }}{% endblock %}
{% block body %}
{% set sections = {} %}
{% for answer in answers %}
  {% set key = answer.chapter|default('Appréciation') %}
  {% set sections = sections|merge({(key): (sections[key]|default([]))|merge([answer])}) %}
{% endfor %}
<div class="appreciation-report">
  <a class="ar-back" href="{{ path('app_entreprise_documents_index',{entite:entite.id,entreprise:entreprise.id}) }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Retour aux documents</a>
  <header class="ar-hero">
    <div class="ar-eyebrow">SUIVI QUALITÉ · {{ entreprise.raisonSociale }}</div>
    <div class="ar-heading"><div><h1>Appréciation {{ trainer ? 'formateur' : 'stagiaire' }}</h1><p>{{ session.formationLabel }}</p></div><span class="ar-status"><i class="bi bi-check-circle" aria-hidden="true"></i> Soumise</span></div>
    <div class="ar-meta">
      <div><span> {{ trainer ? 'Formateur' : 'Stagiaire' }}</span><strong><i class="bi bi-person" aria-hidden="true"></i> {{ person.prenom }} {{ person.nom }}</strong></div>
      <div><span>Session</span><strong>{{ session.code }}</strong></div>
      <div><span>Date de soumission</span><strong>{{ attempt.submittedAt|date('d/m/Y à H:i', 'Europe/Paris') }}</strong></div>
    </div>
  </header>
  <div class="ar-layout">
    <aside class="ar-outline" aria-label="Rubriques du questionnaire"><div class="ar-eyebrow">DANS CETTE APPRÉCIATION</div><h2>{{ sections|length }} rubrique{{ sections|length > 1 ? 's' : '' }}</h2><nav>{% for title, rows in sections %}<a href="#ar-section-{{ loop.index }}"><span>{{ '%02d'|format(loop.index) }}</span>{{ title }}<i class="bi bi-chevron-right" aria-hidden="true"></i></a>{% endfor %}</nav><p><i class="bi bi-shield-check" aria-hidden="true"></i> Réponses du questionnaire soumis<br>Consultation en lecture seule</p></aside>
    <main class="ar-answers" aria-label="Réponses du questionnaire">
    {% for title, rows in sections %}
      <section class="ar-section" id="ar-section-{{ loop.index }}" aria-labelledby="ar-title-{{ loop.index }}">
        <header><span class="ar-number">{{ '%02d'|format(loop.index) }}</span><h2 id="ar-title-{{ loop.index }}">{{ title }}</h2><span class="ar-question-count">{{ rows|length }} question{{ rows|length > 1 ? 's' : '' }}</span></header>
        {% for answer in rows %}
          {% set compact = answer.value matches '~^[0-9]+(?:[.,][0-9]+)?(?: / [0-9]+)?$~' %}
          <article class="ar-answer {{ compact ? 'ar-answer-score' : '' }}"><h3>{{ answer.question }}</h3><div class="{{ compact ? 'ar-score' : 'ar-response' }} {{ answer.value == 'Non renseigné' ? 'ar-empty' : '' }}">{{ answer.value }}</div></article>
        {% endfor %}
      </section>
    {% else %}<section class="ar-section ar-no-answers"><i class="bi bi-chat-square-text" aria-hidden="true"></i><h2>Aucune réponse disponible</h2><p>Les réponses de cette appréciation ne sont pas disponibles.</p></section>{% endfor %}
    </main>
  </div>
</div>
<style>
.appreciation-report{max-width:1320px;margin:0 auto;padding:28px 28px 64px;color:#243d4d}.ar-back{display:inline-flex;align-items:center;gap:10px;color:#617788;text-decoration:none;font-size:.9rem;font-weight:600;margin-bottom:22px}.ar-back:hover{color:#203b4a}.ar-hero{background:linear-gradient(115deg,#1d3342,#305363);border-radius:22px;padding:32px 36px;color:#fff;box-shadow:0 12px 32px #2037460c}.ar-eyebrow{font-size:.69rem;letter-spacing:.13em;font-weight:700;line-height:1.8}.ar-hero>.ar-eyebrow{color:#e1bd65}.ar-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;margin:14px 0 26px}.ar-heading h1{font-size:clamp(1.65rem,2.3vw,2.25rem);font-weight:750;letter-spacing:-.035em;margin:0 0 10px}.ar-heading p{color:#d3e0e6;max-width:750px;line-height:1.6;margin:0}.ar-status{display:inline-flex;gap:8px;align-items:center;white-space:nowrap;border:1px solid #ffffff30;background:#ffffff10;border-radius:30px;padding:8px 14px;font-size:.8rem}.ar-status i{color:#a4dfcb}.ar-meta{display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;border-top:1px solid #ffffff26;padding-top:22px}.ar-meta span{display:block;font-size:.74rem;color:#bacdd7;margin-bottom:7px}.ar-meta strong{font-size:.9rem;font-weight:600;overflow-wrap:anywhere}.ar-layout{display:grid;grid-template-columns:265px minmax(0,1fr);gap:28px;margin-top:28px;align-items:start}.ar-outline{background:#f6f8fa;border:1px solid #e4ebef;border-radius:18px;padding:24px}.ar-outline .ar-eyebrow{color:#738797}.ar-outline h2{font-size:1.2rem;font-weight:700;margin:8px 0 22px}.ar-outline nav{display:grid;gap:6px}.ar-outline nav a{display:flex;align-items:center;gap:10px;padding:12px 8px;text-decoration:none;color:#3c5666;font-size:.85rem;border-radius:8px}.ar-outline nav a:hover{background:#e9eff3}.ar-outline nav span{color:#9b7c32;font-size:.72rem}.ar-outline nav i{margin-left:auto;font-size:.65rem}.ar-outline p{margin:22px 0 0;padding-top:20px;border-top:1px solid #e0e7ec;color:#768996;font-size:.73rem;line-height:1.8}.ar-section{border:1px solid #e1e8ed;border-radius:18px;background:#fff;overflow:hidden;margin-bottom:22px;scroll-margin-top:18px;box-shadow:0 4px 18px #20374603}.ar-section>header{display:flex;align-items:center;gap:14px;padding:22px 26px;background:#fafbfc;border-bottom:1px solid #e7edf1}.ar-number{display:grid;place-items:center;width:36px;height:36px;flex-shrink:0;background:#fbf3df;color:#98752b;border-radius:10px;font-size:.8rem;font-weight:700}.ar-section h2{font-size:1.05rem;font-weight:700;margin:0;line-height:1.4}.ar-question-count{font-size:.73rem;color:#7a8d99;margin-left:auto;white-space:nowrap}.ar-answer{padding:20px 26px;border-bottom:1px solid #edf1f4}.ar-answer:last-child{border-bottom:0}.ar-answer h3{font-size:.92rem;line-height:1.5;font-weight:600;margin:0 0 10px}.ar-answer-score{display:flex;align-items:center;justify-content:space-between;gap:24px}.ar-answer-score h3{margin:0}.ar-score{background:#edf4f7;color:#23495b;border:1px solid #dce8ee;border-radius:12px;min-width:58px;padding:9px 14px;text-align:center;font-size:1.15rem;font-weight:750;white-space:nowrap}.ar-response{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8;color:#607582;font-size:.9rem}.ar-empty{font-style:italic;color:#8a98a2}.ar-no-answers{padding:40px;text-align:center}.ar-no-answers>i{font-size:2rem;color:#9aafba;display:block;margin-bottom:16px}.ar-no-answers p{color:#768996;margin-top:12px}.ar-back:focus-visible,.ar-outline a:focus-visible{outline:3px solid #d9b451;outline-offset:4px}
@media(max-width:1000px){.ar-layout{grid-template-columns:1fr}.ar-outline{display:none}}
@media(max-width:600px){.appreciation-report{padding:20px 14px 40px}.ar-hero{padding:24px}.ar-heading{flex-direction:column;gap:14px}.ar-meta{grid-template-columns:1fr;gap:16px}.ar-section>header,.ar-answer{padding:18px}.ar-question-count{display:none}.ar-layout{margin-top:20px}}
@media print{.ar-back,.ar-outline{display:none}.ar-layout{display:block}.ar-section{break-inside:avoid;box-shadow:none}.ar-hero{background:#fff;color:#203b4a;border:1px solid #ccd5dc}.ar-hero p,.ar-meta span{color:#536a79}}
</style>
{% endblock %}
