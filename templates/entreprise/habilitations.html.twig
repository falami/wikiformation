{% extends 'base_admin.html.twig' %}
{% block title %}Habilitations · {{ entreprise.raisonSociale }}{% endblock %}
{% block stylesheets %}{{ parent() }}
<link rel="stylesheet" href="{{ asset('dist/css/entreprise-habilitations.css') }}">
{% endblock %}
{% block body %}
<div class="eh-page">
<header class="eh-hero">
<div class="eh-eyebrow">ESPACE ENTREPRISE · HABILITATIONS ÉLECTRIQUES</div>
<div class="eh-hero-row"><div><h1>Avis & titres d’habilitation</h1>
<p>Les compétences évaluées, les documents réunis.<br>Accompagnez vos salariés jusqu’à la délivrance de leur titre.</p></div>
<div class="eh-hero-icon" aria-hidden="true"><i class="bi bi-lightning-charge"></i></div></div>
<div class="eh-hero-foot"><span><i class="bi bi-building" aria-hidden="true"></i> {{ entreprise.raisonSociale }}</span><span><i class="bi bi-mortarboard" aria-hidden="true"></i> {{ entite.nom }}</span><span><i class="bi bi-shield-check" aria-hidden="true"></i> Documents de l’entreprise sélectionnée</span></div>
</header>
<div class="eh-company">{% include 'entreprise/_company_selector.html.twig' %}</div>
<div class="eh-overview">
<div class="eh-total"><span class="eh-symbol"><i class="bi bi-folder2-open" aria-hidden="true"></i></span><div><strong>{{ results.total }}</strong><span>Dossier{{ results.total != 1 ? 's' : '' }} disponible{{ results.total != 1 ? 's' : '' }}</span></div></div>
<div class="eh-guidance"><span class="eh-symbol"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span><div><strong>{{ canManage ? 'De l’avis au titre signé' : 'Vos documents à portée de main' }}</strong><p>{{ canManage ? 'Consultez l’avis du formateur, préparez le titre et signez-le pour votre salarié.' : 'Votre compte dispose d’un accès en consultation. Pour préparer et signer un titre, il doit avoir un accès actif à cet organisme et être désigné dans le champ « Représentant » de la fiche de cette société.' }}</p></div></div>
</div>
<section class="eh-panel" aria-labelledby="eh-list-title">
<div class="eh-panel-head"><div><div class="eh-eyebrow">LE SUIVI DE VOS SALARIÉS</div><h2 id="eh-list-title">Dossiers d’habilitation</h2><p>Avis post-formation et titres signés, réunis dans un même espace.</p></div><span class="eh-count">{{ results.filtered }} résultat{{ results.filtered != 1 ? 's' : '' }}</span></div>
<form method="get" class="eh-search">
<label class="eh-search-field"><i class="bi bi-search" aria-hidden="true"></i>
<span class="visually-hidden">Rechercher un salarié ou une session</span>
<input type="search" name="q" value="{{ q }}" placeholder="Rechercher un salarié ou une session…">
</label>
<button class="btn btn-primary" type="submit">Rechercher</button>
{% if q %}<a class="btn btn-outline-secondary" href="{{ path('app_entreprise_documents_habilitation_index', {entite:entite.id, entreprise:entreprise.id}) }}">Réinitialiser</a>{% endif %}
<input type="hidden" name="entreprise" value="{{ entreprise.id }}">

</form>
<div class="table-responsive"><table class="table align-middle">
<thead><tr><th>Salarié</th><th>Formation / session</th><th>Documents et habilitation</th></tr></thead>
<tbody>
{% for revision in results.rows %}
{% set dossier = revision.dossier %}
{% set params = {entite: entite.id, entreprise: entreprise.id, id: dossier.id} %}
<tr>
<td><div class="eh-person"><span class="eh-avatar" aria-hidden="true">{{ dossier.inscription.stagiaire.prenom|slice(0,1)|upper }}{{ dossier.inscription.stagiaire.nom|slice(0,1)|upper }}</span><strong>{{ dossier.inscription.stagiaire.prenom }} {{ dossier.inscription.stagiaire.nom }}</strong></div></td>
<td>{{ dossier.inscription.session.formationLabel }}<br><small>{{ dossier.inscription.session.code }}</small></td>
<td><div class="d-flex flex-wrap gap-2">
<a class="btn btn-outline-secondary" href="{{ path('app_entreprise_documents_habilitation_pdf', params|merge({kind:'avis'})) }}">Avis post-formation PDF</a>
{% if canManage %}<a class="btn btn-primary" href="{{ path('app_habilitation_company_title', params) }}">Préparer / modifier le titre employeur</a>{% endif %}
{% if results.titles[dossier.id] is defined %}
<a class="btn btn-outline-secondary" href="{{ path('app_entreprise_documents_habilitation_pdf', params|merge({kind:'titre'})) }}">Titre signé PDF</a>
{% endif %}
</div></td></tr>
{% else %}<tr><td colspan="3"><div class="eh-empty"><span class="eh-empty-icon"><i class="bi bi-folder2-open" aria-hidden="true"></i></span><h3>{{ q ? 'Aucun dossier ne correspond à votre recherche' : 'Vos prochains avis apparaîtront ici' }}</h3><p>{{ q ? 'Essayez un autre nom de salarié ou une référence de session.' : 'Dès qu’un avis post-formation est transmis par l’organisme, retrouvez-le ici avec les documents de votre salarié.' }}</p><span class="eh-count"><i class="bi bi-building" aria-hidden="true"></i> {{ entreprise.raisonSociale }}</span></div></td></tr>{% endfor %}
</tbody></table></div>
<nav class="eh-pagination" aria-label="Pagination">
{% if page > 1 %}<a class="btn btn-outline-secondary" href="{{ path('app_entreprise_documents_habilitation_index', {entite:entite.id, entreprise:entreprise.id, q:q, page:page-1}) }}">Précédent</a>{% endif %}
<span>Page {{ page }}</span>
{% if page * 30 < results.filtered %}<a class="btn btn-outline-secondary" href="{{ path('app_entreprise_documents_habilitation_index', {entite:entite.id, entreprise:entreprise.id, q:q, page:page+1}) }}">Suivant</a>{% endif %}
</nav>
</section></div>
{% endblock %}
