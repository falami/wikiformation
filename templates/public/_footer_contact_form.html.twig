{% if contactCustomHost|default(false) and not contactRecipient %}
  <p class="small">Le formulaire de contact sera disponible dès que les coordonnées de l’organisme seront renseignées.</p>
{% else %}
{{ form_start(contactForm, {
  action: path('app_public_contact'),
  method: 'POST',
  attr: { class: 'footer-form', novalidate: 'novalidate' }
}) }}

<div class="form-floating mb-2">
  {{ form_widget(contactForm.nom, { attr: {
    class: 'form-control form-control-sm',
    placeholder: 'Nom',
    autocomplete: 'name'
  }}) }}
  <label for="{{ contactForm.nom.vars.id }}">Nom</label>
</div>

<div class="form-floating mb-2">
  {{ form_widget(contactForm.email, { attr: {
    class: 'form-control form-control-sm',
    placeholder: 'Email',
    autocomplete: 'email'
  }}) }}
  <label for="{{ contactForm.email.vars.id }}">Email</label>
</div>

<div class="form-floating mb-2">
  {{ form_widget(contactForm.message, { attr: {
    class: 'form-control form-control-sm',
    placeholder: 'Message',
    style: 'height:70px'
  }}) }}
  <label for="{{ contactForm.message.vars.id }}">Message</label>
</div>

{# champs techniques #}
{% include 'public/_contact_captcha.html.twig' with {contactCaptchaForm: contactForm, captchaPrefix: 'footer_'} only %}
{{ form_row(contactForm.website) }}
{{ form_widget(contactForm.startedAt) }}
{{ form_rest(contactForm) }}

{% if contactCustomHost|default(false) %}
  <p class="small mt-3">Votre nom, votre e-mail et votre message seront transmis à {{ contactOrganisation }} pour répondre à votre demande. Tous les champs sont obligatoires. Ce formulaire ne vous inscrit pas à des communications commerciales. Pour vos questions sur vos données, contactez <a href="mailto:{{ contactRecipient }}">{{ contactRecipient }}</a>.</p>
{% else %}
  {% include 'public/_contact_privacy_notice.html.twig' %}
{% endif %}

<button type="submit" class="btn btn-theme w-100 mt-2">
  <i class="bi bi-send me-1"></i> Envoyer
</button>

{{ form_end(contactForm) }}
{% endif %}
