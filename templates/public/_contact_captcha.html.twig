<div class="contact-captcha mb-3" data-contact-captcha>
  {{ form_widget(contactCaptchaForm.captchaToken, {id: captchaPrefix|default('') ~ contactCaptchaForm.captchaToken.vars.id}) }}
  <div data-contact-challenge></div>
  <p class="small mb-2" data-contact-captcha-status role="status" aria-live="polite">Vérification de sécurité à l’ouverture du formulaire.</p>
  <button type="button" class="btn btn-outline-secondary btn-sm mb-2" data-contact-captcha-retry hidden>Réessayer la vérification</button>
  {{ form_errors(contactCaptchaForm.captchaToken) }}
  <noscript><p class="small">Activez JavaScript pour vérifier et envoyer ce formulaire.</p></noscript>
  <p class="small mb-0">Protection anti-spam par Cloudflare Turnstile.
    <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">Confidentialité</a>.
  </p>
</div>
