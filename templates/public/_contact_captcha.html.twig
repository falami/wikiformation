{% set captchaInputId = captchaPrefix|default('') ~ contactCaptchaForm.captchaAnswer.vars.id %}
<div class="contact-captcha mb-3">
  {{ form_label(contactCaptchaForm.captchaAnswer, null, {label_attr: {class: 'form-label fw-semibold', for: captchaInputId}}) }}
  {{ form_widget(contactCaptchaForm.captchaAnswer, {id: captchaInputId, attr: {class: 'form-control', 'aria-describedby': captchaInputId ~ '_help'}}) }}
  <div id="{{ captchaInputId }}_help" class="small mt-1">{{ contactCaptchaForm.captchaAnswer.vars.help }}</div>
  {{ form_errors(contactCaptchaForm.captchaAnswer) }}
  {{ form_widget(contactCaptchaForm.captchaId) }}
</div>
