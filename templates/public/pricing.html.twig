{% extends 'base_public.html.twig' %}
{% block title %}Tarifs · WikiFormation{% endblock %}
{% block body %}
  {% include 'header_public.html.twig' %}
  <main class="wf-pricing-page">
    <div class="wf-pricing-content">
      <header class="wf-pricing-hero">
        <span class="wf-pricing-eyebrow">Plus de temps pour transmettre</span>
        <h1>Votre expertise mérite<br>un quotidien plus simple.</h1>
        <p>De votre première session à un organisme qui grandit, choisissez l’espace dont vous avez besoin. Wikiformation rassemble votre administratif, dès 29 € HT par mois.</p>
      </header>
      <section class="wf-einvoice-offer" aria-labelledby="einvoice-title">
        <div><span class="wf-pricing-eyebrow">Facturation électronique</span><h2 id="einvoice-title">Connectée à une plateforme agréée</h2><p>WikiFormation vous permet d’émettre vos factures électroniques via <strong>SUPER PDP, plateforme agréée</strong>, après activation du service.</p></div>
        <div class="wf-einvoice-price"><strong>0,02 € <small>HT</small></strong><span>par facture électronique émise</span><small>En complément de votre abonnement</small></div>
      </section>
      {% include 'public/_pricing_plans.html.twig' %}
    </div>
  </main>
  <style>
  .wf-einvoice-offer{display:flex;align-items:center;justify-content:space-between;gap:32px;background:#fff;border:1px solid #e0e6ed;border-left:4px solid #c7a04d;border-radius:18px;padding:28px 32px;margin:0 0 32px}.wf-einvoice-offer h2{font-size:22px;color:#193142;margin:10px 0}.wf-einvoice-offer p{font-size:14px;line-height:1.7;color:#657789;margin:0;max-width:680px}.wf-einvoice-price{flex-shrink:0;display:grid;gap:5px;color:#193142}.wf-einvoice-price strong{font-size:34px;letter-spacing:-1px}.wf-einvoice-price strong small{font-size:13px;letter-spacing:0}.wf-einvoice-price span{font-size:13px;font-weight:600}.wf-einvoice-price>small{font-size:11px;color:#657789}@media(max-width:700px){.wf-einvoice-offer{flex-direction:column;align-items:flex-start;padding:24px;gap:18px}}
  </style>
{% endblock %}
