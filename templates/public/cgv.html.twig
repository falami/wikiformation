            <div class="container hero-shell">
                <div class="hero-grid">
                    <div>
                        <span class="hero-badge">
                            <i class="bi bi-shield-check"></i>
                            Conditions contractuelles · WikiFormation
                        </span>

                        <h1 class="hero-title">
