{# templates/base_admin.html.twig #}
<!DOCTYPE html>
<html class="workspace-shell" lang="{{ app.request.locale|default('fr') }}">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta charset="UTF-8">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <title>{% block title %}Bienvenue!{% endblock %}</title>
        {#<link rel="icon" type="image/x-icon" href="{{ asset('uploads/photos/entite/logo/')}}{{ entite.logo }}">#}
        <link rel="icon" type="image/x-icon" href="{{ asset('uploads/photos/entite/favicon/favicon-wikiformation.png')}}">
        <!-- à mettre en haut du head -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

        <link rel="alternate" hreflang="fr" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale':'fr'})) }}">
        <link rel="alternate" hreflang="en" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale':'en'})) }}">
        <link rel="alternate" hreflang="x-default" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': app.request.locale == 'fr' ? 'en' : 'fr'})) }}">
        <meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_GB' : 'fr_FR' }}">
            
        <script src="{{ asset('dist/js/cookie-consent.js') }}?v=2"></script>
        <link rel="stylesheet" href="{{ asset('dist/css/external-map.css') }}?v=1">
        <script src="{{ asset('dist/js/external-map.js') }}?v=1" defer></script>
        <script defer data-user="{{ app.user ? app.user.id : 'anonymous' }}" src="{{ asset('dist/js/map-preferences.js') }}"></script>
        <script defer data-google-user="{{ app.user ? app.user.id : 'anonymous' }}" data-google-preferences-url="{{ path('app_account_preferences', {section:'services'}) }}" src="{{ asset('dist/js/google-services.js') }}?v=2"></script>
        <script defer data-video-user="{{ app.user ? app.user.id : 'anonymous' }}" src="{{ asset('dist/js/external-video.js') }}?v=2"></script>
        <script defer src="{{ asset('dist/js/datatables-actions.js') }}?v=3"></script>

        <style>
          .video-wrap:has(> [data-external-video]), .video-embed:has(> [data-external-video]) { padding: 0 !important; height: auto !important; }
          .ratio:has(> [data-external-video])::before { display: none; }
          .ratio > [data-external-video] { position: relative; height: auto; }
        </style>
        {% block stylesheets %}

        {% endblock %}

        <link rel="stylesheet" href="{{ asset('dist/css/datatables-actions.css') }}?v=4">

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

        {% block javascripts %}
        {% endblock %}

        {# No audience tracking on authentication, account or administration pages. #}

        
    <link rel="stylesheet" href="{{ asset('dist/css/notifications.css') }}?v=2">
    <script src="{{ asset('dist/js/notifications.js') }}?v=3" defer></script>
    <link rel="stylesheet" href="{{ asset('dist/css/admin-header.css') }}?v=3">
    <style>
      :root {
        --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
        --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
        --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
        --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
      }
    </style>
    <link rel="stylesheet" href="{{ asset('dist/css/workspace-navigation.css') }}?v=2">
    <script src="{{ asset('dist/js/workspace-navigation.js') }}?v=1" defer></script>
    </head>
    <body {% block body_attributes %}{% endblock %}>

        {% include '_cookie_consent.html.twig' %}


        {% include 'header_administrateur.html.twig' %}
        {% include 'sidebar_administrateur.html.twig' %}

        <div class="content">
            {% block body %}
            {% endblock %}
        </div>

        <footer class="footer">
            &copy; 2026 - Wiki Formation - <a href="#" id="manage-cookies" class="text-body text-decoration-none">Gérer les cookies</a>
        </footer>

        <button id="scrollToTopBtn" class="btn btn-warning rounded-circle shadow" title="Remonter">
            ↑
        </button>
        <script>
            const scrollBtn = document.getElementById("scrollToTopBtn");

            window.addEventListener("scroll", () => {
                if (window.scrollY > 200) {
                    scrollBtn.style.display = "block";
                } else {
                    scrollBtn.style.display = "none";
                }
            });

            scrollBtn.addEventListener("click", () => {
                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });
            });
            
        </script>
        <link rel="stylesheet" href="{{ asset('dist/css/list-filters.css') }}?v=9">
        <script defer src="{{ asset('dist/js/list-filters.js') }}?v=12"></script>
        {% block javascripts_bottom %}{% endblock %}
        <link rel="stylesheet" href="{{ asset('dist/css/client-address.css') }}">
        <script defer src="{{ asset('dist/js/address-assistant.js') }}" data-address-assistant-key="{{ address_google_browser_key }}"></script>
        {% include '_partials/_billing_limit_modal.html.twig' %}
    </body>
</html>
