<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}Partenaires · WikiFormation{% endblock %}</title>
<link rel="stylesheet" href="{{ asset('dist/css/partners.css') }}"><style>body{margin:0;background:#f6f8fa;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}</style></head><body><header class="pa-top"><a class="pa-brand" href="{{ path('app_public_pricing') }}">Wiki<span>Formation</span></a><nav>{% if is_granted('ROLE_SUPER_ADMIN') %}<a href="{{ path('app_super_partners') }}">Gestion des partenaires</a>{% endif %}<a href="{{ path('app_workspace') }}">Mes espaces</a><a href="{{ path('app_logout') }}">Déconnexion</a></nav></header><main class="pa-shell">
{% for type,messages in app.flashes %}{% for message in messages %}<div class="pa-alert {{ type == 'success' ? 'pa-alert-success' : '' }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
{% if error|default(null) %}<div class="pa-alert pa-alert-error" role="alert">{{ error }}</div>{% endif %}
{% block content %}{% endblock %}</main><script>document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const input=document.getElementById(button.dataset.copy);try{await navigator.clipboard.writeText(input.value);button.textContent='Lien copié';}catch(e){input.focus();input.select();button.textContent='Sélectionné : copiez le lien';}}));</script></body></html>
