<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}Partenaires · WikiFormation{% endblock %}</title>
<link rel="stylesheet" href="{{ asset('dist/css/partners.css') }}"><style>body{margin:0;background:#f6f8fa;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}</style></head><body class="pa-portal"><header class="pa-top">
<a class="pa-brand" href="{{ path('app_public') }}"><img src="{{ asset('uploads/photos/entite/logo/logo-wikiformation.png') }}" alt="WikiFormation"><span class="pa-brand-label">PROGRAMME PARTENAIRES</span></a>
<nav aria-label="Navigation partenaire">{% if is_granted('ROLE_SUPER_ADMIN') %}<a href="{{ path('app_super_partners') }}">Gestion des partenaires</a>{% endif %}<a href="{{ path('app_workspace') }}">Mes espaces</a><a class="pa-signout" href="{{ path('app_logout') }}">Déconnexion</a></nav>
</header>
<div class="pa-subnav"><span>Espace partenaire</span><nav aria-label="Sections du tableau de bord"><a href="#pa-overview">Vue d’ensemble</a><a href="#pa-clients">Clients</a><a href="#pa-commissions">Commissions</a><a href="#pa-invitation">Mon lien</a></nav></div>
<main class="pa-shell">
{% for type,messages in app.flashes %}{% for message in messages %}<div class="pa-alert {{ type == 'success' ? 'pa-alert-success' : '' }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
{% if error|default(null) %}<div class="pa-alert pa-alert-error" role="alert">{{ error }}</div>{% endif %}
{% block content %}{% endblock %}</main><footer class="pa-portal-footer"><span>WikiFormation · Programme partenaires</span><a href="{{ path('app_public') }}">Découvrir la plateforme ↗</a></footer><script>document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const input=document.getElementById(button.dataset.copy);try{await navigator.clipboard.writeText(input.value);button.textContent='Lien copié';}catch(e){input.focus();input.select();button.textContent='Sélectionné : copiez le lien';}}));</script></body></html>
