{% extends admin and entite is defined and entite ? 'partner/admin_base.html.twig' : 'partner/base.html.twig' %}
{% block title %}{{ partner.name }} · Espace partenaire{% endblock %}
{% block content %}
{% set labels={pending:'En attente · J+30',transferring:'Transfert en cours',transferred:'Fonds transférés',paying:'Virement en cours',paid:'Virement confirmé',held:'Suspendue',review:'À rapprocher',uncertain:'À rapprocher',payout_failed:'Virement échoué',cancelled:'Annulée',zero:'Sans commission'} %}
{% set pending=0 %}{% set paid=0 %}{% set inFlight=0 %}{% for total in totals %}{% if total.status=='paid' %}{% set paid=paid+total.net %}{% elseif total.status in ['paying','transferred','transferring'] %}{% set inFlight=inFlight+total.net %}{% elseif total.status=='pending' %}{% set pending=pending+total.net %}{% endif %}{% endfor %}
<header class="pa-hero"><div><div class="pa-eyebrow">{{ admin ? 'SUPER ADMIN · FICHE PARTENAIRE' : 'VOTRE ESPACE PARTENAIRE' }}</div><h1>{{ partner.name }}</h1><p>{{ admin ? partner.user.email : 'Vos recommandations ont de la valeur. Retrouvez vos clients, vos commissions et vos versements.' }}</p></div><div class="pa-hero-mark"><b>{{ ((terms.rateBps|default(0))/100)|number_format(2,',',' ') }} %</b><small>sur l’abonnement HT encaissé</small></div></header>
{% if not partner.active %}<div class="pa-alert">Ce partenariat est suspendu : les nouveaux parrainages et versements sont arrêtés. L’historique reste disponible.</div>{% endif %}
{% if not enabled %}<div class="pa-alert">Les virements automatiques ne sont pas encore activés sur la plateforme.</div>{% elseif not partner.automaticPayouts %}<div class="pa-alert">Les virements de ce partenariat sont en attente d’activation par la plateforme.</div>{% endif %}
<div class="pa-kpis"><div class="pa-kpi"><span>CLIENTS APPORTÉS</span><strong>{{ clients|length }}</strong><small>Organismes rattachés</small></div><div class="pa-kpi"><span>COMMISSIONS EN ATTENTE</span><strong>{{ (pending/100)|number_format(2,',',' ') }} €</strong><small>Net prévu, après frais convenus</small></div><div class="pa-kpi"><span>EN COURS DE VERSEMENT</span><strong>{{ (inFlight/100)|number_format(2,',',' ') }} €</strong><small>Transfert ou virement en cours</small></div><div class="pa-kpi"><span>VIREMENTS CONFIRMÉS</span><strong>{{ (paid/100)|number_format(2,',',' ') }} €</strong><small>Net des reprises enregistrées</small></div></div>
<div class="pa-grid"><div>
<section class="pa-card"><div class="pa-head"><h2>Clients & abonnements</h2><span class="pa-badge">{{ clients|length }} organismes</span></div><div class="pa-table-wrap"><table class="pa-table"><thead><tr><th>Organisme</th><th>Abonnement</th><th>État</th><th>Rattachement</th></tr></thead><tbody>{% for row in clients %}<tr><td><strong>{{ row.referral.entite.nom }}</strong></td><td>{{ row.subscription ? row.subscription.plan.name : 'Aucun abonnement' }}{% if row.subscription %}<small>{{ row.subscription.intervale == 'year' ? 'Annuel' : 'Mensuel' }}</small>{% endif %}</td><td><span class="pa-badge {{ row.subscription and row.subscription.status=='active' ? '' : 'pa-badge-muted' }}">{{ row.subscription ? {active:'Actif',trialing:'En essai',canceled:'Résilié',past_due:'Paiement en retard',unpaid:'Impayé',incomplete:'À finaliser',incomplete_expired:'Expiré',paused:'En pause'}[row.subscription.status]|default(row.subscription.status) : 'À souscrire' }}</span></td><td>{{ row.referral.createdAt|date('d/m/Y') }}</td></tr>{% else %}<tr><td colspan="4"><div class="pa-empty"><strong>Votre prochain client commence par un lien.</strong>Partagez votre code pour rattacher les nouveaux organismes à votre compte.</div></td></tr>{% endfor %}</tbody></table></div></section>
<section class="pa-card"><div class="pa-head"><div><h2>Journal des commissions</h2><div class="pa-small">Chaque paiement client, du calcul au virement.</div></div></div><div class="pa-table-wrap"><table class="pa-table"><thead><tr><th>Client / paiement</th><th>Base HT</th><th>Commission</th><th>Net prévu</th><th>Versement</th></tr></thead><tbody>{% for c in commissions %}<tr><td><strong>{{ c.referral.entite.nom }}</strong><small>{{ c.planName }} · {{ c.paidAt|date('d/m/Y') }}</small><small class="pa-break">{{ c.invoiceId }}</small></td><td class="pa-money">{{ (c.baseCents/100)|number_format(2,',',' ') }} €<small>{% if c.refundedCents %}Remboursement : {{ (c.refundedCents/100)|number_format(2,',',' ') }} € TTC{% endif %}</small></td><td class="pa-money">{{ (c.grossCents/100)|number_format(2,',',' ') }} €<small>{{ (c.terms.rateBps/100)|number_format(2,',',' ') }} % · avant reprises</small></td><td class="pa-money">{{ ((c.netCents-c.reversedCents)/100)|number_format(2,',',' ') }} €<small>Frais : {{ (c.feeCents/100)|number_format(2,',',' ') }} €</small></td><td><span class="pa-badge {{ c.status in ['review','uncertain','payout_failed','held'] ? 'pa-badge-error' : (c.status == 'paid' ? '' : 'pa-badge-warn') }}">{{ labels[c.status]|default(c.status) }}</span><small>Éligible le {{ c.availableAt|date('d/m/Y') }}</small>{% if c.arrivalAt %}<small>Arrivée Stripe : {{ c.arrivalAt|date('d/m/Y') }}</small>{% endif %}{% if c.issue %}<small class="pa-form-error">{{ c.issue }}</small>{% endif %}{% if admin and c.payoutId %}<small class="pa-break">{{ c.payoutId }}</small>{% endif %}</td></tr>{% else %}<tr><td colspan="5"><div class="pa-empty"><strong>Aucune commission pour le moment.</strong>Les périodes d’essai et les factures impayées ne génèrent pas de commission.</div></td></tr>{% endfor %}</tbody></table></div><div class="pa-foot"><span>Page {{ page }}</span><div>{% if page>1 %}<a href="{{ admin ? path('app_super_partner',{id:partner.id,page:page-1}) : path('app_partner_dashboard',{page:page-1}) }}">← Précédente</a>{% endif %}{% if more %} <a href="{{ admin ? path('app_super_partner',{id:partner.id,page:page+1}) : path('app_partner_dashboard',{page:page+1}) }}">Suivante →</a>{% endif %}</div></div></section>
{% if admin %}<section class="pa-card pa-pad"><h2>Historique des conditions</h2><p class="pa-note">Les nouvelles conditions s’appliquent aux paiements suivants. Les commissions antérieures restent inchangées.</p>{% for t in termsHistory %}<div class="pa-summary"><span>{{ t.effectiveAt|date('d/m/Y H:i:s') }}<br>{{ t.author.prenom }} {{ t.author.nom }}</span><b>{{ (t.rateBps/100)|number_format(2,',',' ') }} %<br><span>Frais : {{ (t.feeFixedCents/100)|number_format(2,',',' ') }} € + {{ (t.feeBps/100)|number_format(2,',',' ') }} %</span></b></div>{% endfor %}</section>{% endif %}
</div><aside><section class="pa-card pa-pad"><div class="pa-eyebrow">VOTRE INVITATION</div><h2 style="margin-top:10px">Un lien. De nouvelles opportunités.</h2><p>Le client utilise ce lien ou saisit ce code lors de la création de son organisme.</p><div class="pa-linkbox"><div class="pa-code">{{ partner.code }}</div><label class="pa-small" for="referral-link">Lien de recommandation</label><input id="referral-link" readonly value="{{ referralUrl }}"><button class="pa-btn pa-wide" type="button" data-copy="referral-link">Copier le lien</button></div><p class="pa-note">Un organisme est rattaché à un seul apporteur, avant son premier abonnement Stripe.</p></section>
{% if not admin %}<section class="pa-card pa-pad"><h2>Vos versements</h2><span class="pa-badge {{ partner.payoutsEnabled ? '' : 'pa-badge-warn' }}">{{ partner.payoutsEnabled ? 'Compte bancaire prêt' : 'Configuration à compléter' }}</span><p>Vos coordonnées bancaires et justificatifs sont recueillis directement par Stripe.</p><form method="post" action="{{ path('app_partner_bank') }}"><input type="hidden" name="_token" value="{{ csrf_token('partner_bank') }}"><button class="pa-btn pa-btn-dark pa-wide">{{ partner.stripeAccountId ? 'Compléter les informations bancaires' : 'Configurer mes versements' }}</button></form>{% if partner.stripeAccountId %}<form method="post" action="{{ path('app_partner_bank_dashboard') }}" style="margin-top:12px"><input type="hidden" name="_token" value="{{ csrf_token('partner_bank') }}"><button class="pa-btn pa-wide">Ouvrir mon espace Stripe ↗</button></form>{% endif %}</section>{% endif %}
{% if admin %}<section class="pa-card pa-pad"><h2>Conditions du partenariat</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('partner_' ~ partner.id) }}"><input type="hidden" name="action" value="terms"><label class="pa-field">Commission (%)<input name="rate" type="number" min="0" max="100" step="0.01" required value="{{ (terms.rateBps|default(0))/100 }}"></label><div class="pa-fields"><label class="pa-field">Frais fixes / versement (€)<input name="feeFixed" type="number" min="0" max="9999.99" step="0.01" required value="{{ (terms.feeFixedCents|default(0))/100 }}"></label><label class="pa-field">Frais variables (%)<input name="feeRate" type="number" min="0" max="100" step="0.01" required value="{{ (terms.feeBps|default(0))/100 }}"></label></div><p class="pa-note">Frais convenus déduits de la commission. Renseignez les frais de votre contrat Stripe ; aucun tarif n’est présumé. Les coûts supplémentaires non couverts restent à rapprocher.</p><label class="pa-check"><input type="checkbox" name="active" value="1" {{ partner.active ? 'checked' }}>Partenariat actif</label><label class="pa-check"><input type="checkbox" name="automatic" value="1" {{ partner.automaticPayouts ? 'checked' }}>Autoriser les versements automatiques à J+30</label><label class="pa-check"><input type="checkbox" name="feesConfirmed" value="1">J’ai vérifié et convenu des frais de versement avec le partenaire.</label><button class="pa-btn pa-btn-primary pa-wide">Enregistrer les conditions</button></form><p class="pa-note">Banque : {{ partner.payoutsEnabled ? 'prête' : 'à configurer par le partenaire' }}.</p></section><section class="pa-card pa-pad"><h2>Rattachement manuel</h2><p>Pour un organisme déjà créé, avant son premier abonnement Stripe.</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('partner_' ~ partner.id) }}"><input type="hidden" name="action" value="attach"><label class="pa-field">Organisme<select required name="entite"><option value="">Choisir un organisme</option>{% for e in entities %}<option value="{{ e.id }}">{{ e.nom }} · #{{ e.id }}</option>{% endfor %}</select></label><button class="pa-btn pa-wide">Rattacher au partenaire</button></form></section>{% endif %}
<section class="pa-card pa-pad"><h2>Comment ça fonctionne</h2><ol class="pa-timeline"><li><div><b>Vous recommandez la plateforme</b>L’organisme confirme votre code à sa création.</div></li><li><div><b>L’abonnement est payé</b>Votre pourcentage s’applique au montant HT encaissé, après remises, hors options.</div></li><li><div><b>30 jours de délai</b>Les remboursements et litiges sont contrôlés avant le versement.</div></li><li><div><b>Un virement bancaire</b>Le net après frais convenus est versé via Stripe. Le délai bancaire s’ajoute à J+30.</div></li></ol><p class="pa-note">Frais actuels : {{ (terms.feeFixedCents|default(0)/100)|number_format(2,',',' ') }} € + {{ (terms.feeBps|default(0)/100)|number_format(2,',',' ') }} % par versement. Les remboursements non ventilés sont répartis au prorata du paiement.</p></section></aside></div>
{% endblock %}
