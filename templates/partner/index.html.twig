{% extends entite is defined and entite ? 'partner/admin_base.html.twig' : 'partner/base.html.twig' %}
{% block content %}
<header class="pa-hero"><div><div class="pa-eyebrow">SUPER ADMIN · PROGRAMME PARTENAIRES</div><h1>Grandir, ensemble.</h1><p>Pilotez vos apporteurs d’affaires, leurs clients et leurs commissions récurrentes, depuis un espace dédié.</p></div><div class="pa-hero-mark"><b>J+30</b><small>après chaque paiement client</small></div></header>
{% if not enabled %}<div class="pa-alert">Les versements réels sont désactivés. Configurez Stripe Connect et les frais avant d’activer le traitement automatique sur le serveur.</div>{% endif %}
<div class="pa-grid"><section class="pa-card"><div class="pa-head"><h2>Vos apporteurs d’affaires</h2><span class="pa-badge">Commissions récurrentes</span></div><div class="pa-table-wrap"><table class="pa-table"><thead><tr><th>Partenaire</th><th>Taux</th><th>Clients</th><th>Statut</th><th></th></tr></thead><tbody>{% for row in rows %}<tr><td><strong>{{ row.partner.name }}</strong><small>{{ row.partner.user.email }}</small><small>{{ row.partner.code }}</small></td><td class="pa-money">{{ ((row.terms.rateBps|default(0))/100)|number_format(2,',',' ') }} %</td><td>{{ row.clients }}</td><td><span class="pa-badge {{ row.partner.active ? '' : 'pa-badge-muted' }}">{{ row.partner.active ? 'Actif' : 'Suspendu' }}</span></td><td><a class="pa-btn" href="{{ path('app_super_partner',{id:row.partner.id}) }}">Ouvrir ↗</a></td></tr>{% else %}<tr><td colspan="5"><div class="pa-empty"><strong>Votre réseau commence ici.</strong>Créez un partenaire pour lui attribuer son code et son espace personnel.</div></td></tr>{% endfor %}</tbody></table></div><div class="pa-foot"><span>Page {{ page }}</span><div>{% if page > 1 %}<a href="{{ path('app_super_partners',{page:page-1}) }}">← Précédente</a>{% endif %}{% if more %} <a href="{{ path('app_super_partners',{page:page+1}) }}">Suivante →</a>{% endif %}</div></div></section>
<aside><section class="pa-card pa-pad"><div class="pa-eyebrow">NOUVELLE COLLABORATION</div><h2 style="margin-top:10px">Ajouter un partenaire</h2><p>Un code unique, un accès personnel et un taux de commission défini par vous.</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('partner_create') }}"><label class="pa-field">Nom commercial / structure<input name="name" required maxlength="100" value="{{ values.name|default('') }}"></label><div class="pa-fields"><label class="pa-field">Prénom<input name="firstName" required maxlength="50" value="{{ values.firstName|default('') }}"></label><label class="pa-field">Nom<input name="lastName" required maxlength="50" value="{{ values.lastName|default('') }}"></label></div><label class="pa-field">Adresse e-mail du compte<input type="email" name="email" required maxlength="180" value="{{ values.email|default('') }}"></label><label class="pa-field">Commission sur l’abonnement HT (%)<input type="number" name="rate" required min="0" max="100" step="0.01" placeholder="Ex. 15" value="{{ values.rate|default('') }}"></label><label class="pa-check"><input type="checkbox" name="confirmExisting" value="1">Si ce compte existe, je confirme qu’il appartient à cet apporteur.</label><button class="pa-btn pa-btn-primary pa-wide">Créer l’espace partenaire</button><p class="pa-note">Aucun e-mail n’est envoyé automatiquement. Le partenaire pourra définir son mot de passe avec « Mot de passe oublié ».</p></form></section></aside></div>
{% endblock %}
