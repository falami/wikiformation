{# templates/workspace/index.html.twig #}
{% extends 'base_public.html.twig' %}
{% block title %}Mon espace - WikiFormation{% endblock %}

{% block body %}
  {% include 'header_public.html.twig' %}

  <link rel="stylesheet" href="{{ asset('dist/css/workspace.css') }}">
  <div class="container pb-5 wf-workspace">
    
    {# SECTION HERO ULTRA-CLEAN #}
    <div class="wf-hero-section">
      <div class="wf-hero-badge">
        <i class="bi bi-grid"></i> VOTRE ESPACE WIKIFORMATION
      </div>
      <h1 class="display-5 fw-extrabold mb-3" style="letter-spacing: -1.5px;">
        Bonjour {{ user.prenom }}.<br><span>Bienvenue dans votre espace.</span>
      </h1>
      <p class="lead text-muted mx-auto" style="max-width: 600px;">
        Retrouvez vos activités et choisissez l’espace auquel vous souhaitez accéder.
      </p>
    </div>

    {% if is_granted('ROLE_PARTNER') %}
    <a class="wf-partner-access" href="{{ path('app_partner_dashboard') }}">
      <span class="wf-icon-plus"><i class="bi bi-person-heart" aria-hidden="true"></i></span>
      <span><strong>Votre espace partenaire</strong><small>Clients recommandés, commissions et versements : retrouvez votre suivi.</small></span>
      <span class="wf-partner-arrow" aria-hidden="true">→</span>
    </a>
    {% endif %}
    <div class="wf-section-heading"><h2>Vos organismes</h2><span>{{ memberships|length }} accès{{ memberships|length > 1 ? ' disponibles' : ' disponible' }}</span></div>
    {# GRID #}
    <div class="row g-4 mt-1">

      {% for m in memberships %}
        {% set e = m.entite %}
        {% set logoUrl = e.logo ? asset('uploads/photos/entite/logo/' ~ e.logo) : null %}
        {% set monogram = (e.nom|default('O'))|slice(0,1)|upper %}

        <div class="col-12 col-md-6 col-lg-4">
          <div class="wf-card-wrapper">
            <div class="wf-glass-card">
              
              <div class="wf-brand-container">
                {% if logoUrl %}
                  <img src="{{ logoUrl }}" alt="Logo {{ e.nom }}">
                {% else %}
                  <span>{{ monogram }}</span>
                {% endif %}
                <div class="wf-status-dot"></div>
              </div>

              <h2 class="wf-card-title">{{ e.nom }}</h2>
              <p class="wf-card-meta">
                <i class="far fa-calendar-alt me-1"></i>
                {{ e.lastActivityAt ? e.lastActivityAt|format_datetime('medium', 'short', locale='fr') : '—' }}
              </p>

              <div class="wf-tag-group">
                {% if m.hasRole('TENANT_DIRIGEANT') %}
                  <span class="wf-tag wf-tag--dirigeant"><i class="fa fa-crown me-1"></i> Dirigeant</span>
                {% endif %}

                {% if m.hasRole('TENANT_ADMIN') %}
                  <span class="wf-tag wf-tag--admin"><i class="fa fa-shield-halved me-1"></i> Administrateur</span>
                {% endif %}

                {% if m.hasRole('TENANT_OF') %}
                  <span class="wf-tag wf-tag--of"><i class="fa fa-building-columns me-1"></i> Organisme</span>
                {% endif %}

                {% if m.hasRole('TENANT_COMMERCIAL') %}
                  <span class="wf-tag wf-tag--commercial"><i class="fa fa-bullseye me-1"></i> Commercial</span>
                {% endif %}

                {% if m.hasRole('TENANT_ENTREPRISE') %}
                  <span class="wf-tag wf-tag--entreprise"><i class="fa fa-briefcase me-1"></i> Entreprise</span>
                {% endif %}

                {% if m.hasRole('TENANT_OPCO') %}
                  <span class="wf-tag wf-tag--opco"><i class="fa fa-handshake me-1"></i> OPCO</span>
                {% endif %}

                {% if m.hasRole('TENANT_FORMATEUR') %}
                  <span class="wf-tag wf-tag--formateur"><i class="fa fa-chalkboard-user me-1"></i> Formateur</span>
                {% endif %}

                {% if m.hasRole('TENANT_STAGIAIRE') %}
                  <span class="wf-tag wf-tag--stagiaire"><i class="fa fa-user-graduate me-1"></i> Stagiaire</span>
                {% endif %}

                {% if e.id == platformEntiteId and isTenantDirigeant %}
                  <span class="wf-tag wf-tag--platform"><i class="bi bi-stars"></i> Propriétaire</span>
                {% endif %}
              </div>

              {% if homeRoutes[m.id]|default(null) %}
              <form method="post" action="{{ path('app_workspace_switch', {id: e.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('switch_entite_' ~ e.id) }}">
                <button type="submit" class="wf-btn-premium w-100">
                  Accéder à mon espace
                  <i class="fa fa-chevron-right" style="font-size: 0.8rem;"></i>
                </button>
              </form>
              {% else %}
                <p class="small text-muted mt-auto mb-0" role="status">
                  {% if not m.isActive %}Cet accès est inactif.{% else %}Aucun espace dédié n’est disponible pour vos rôles actuels.{% endif %}
                  Contactez l’administrateur de cet organisme pour vérifier vos accès.
                </p>
              {% endif %}
              
            </div>
          </div>
        </div>
      {% endfor %}

      {# CARTE DE CRÉATION #}
      <div class="col-12 col-md-6 col-lg-4">
        <div class="wf-card-wrapper">
          <div class="wf-glass-card wf-card-create">
            <div class="wf-icon-plus">
              <i class="fa fa-plus"></i>
            </div>

            <h2 class="wf-card-title">Nouvel Organisme</h2>
            <p class="wf-card-meta">
              Créez votre structure et réunissez vos collaborateurs dans un espace dédié.
            </p>

            <div class="wf-tag-group">
              <span class="wf-tag" >
                <i class="fa fa-rocket me-1"></i> Essai gratuit ({{ billing_trial_days }} jours)
              </span>
            </div>

            <a href="{{ path('app_onboarding') }}" class="wf-btn-premium w-100" >
              Créer maintenant
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

{% endblock %}
