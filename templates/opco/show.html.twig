{% extends 'opco/layout.html.twig' %}
{% block title %}{{ title }} — {{ entite.nom }}{% endblock %}
{% block portal %}
<a class="rp-back" href="{{ path('app_opco_list',{entite:entite.id,module:module}) }}"><i class="bi bi-arrow-left"></i> {{ config[1] }}</a>
<header class="rp-hero"><div><div class="rp-eyebrow">{{ entite.nom }} · {{ config[1] }} · N° {{ id }}</div><h1>{{ title }}</h1><p>Les informations du dossier partagé par votre organisme partenaire.</p></div><span class="rp-badge"><i class="bi bi-shield-check"></i> Consultation</span></header>
{% if module in ['factures','conventions'] %}<div class="rp-actions"><a class="rp-button primary" href="{{ path('app_opco_pdf',{entite:entite.id,module:module,id:id}) }}"><i class="bi bi-file-earmark-pdf"></i> Télécharger le PDF</a></div>{% endif %}
<section class="rp-panel"><h2 class="mb-4">Informations du dossier</h2>{% include 'shared/portail/_details.html.twig' %}</section>
{% endblock %}
