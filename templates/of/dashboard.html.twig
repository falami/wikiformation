<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

<script>
(function(){
  const FC=(window.FullCalendar=window.FullCalendar||{});
  FC.globalLocales=FC.globalLocales||[];
  if(!FC.globalLocales.some(l=>l.code==='fr')){
    FC.globalLocales.push({
      code:'fr',
      buttonText:{prev:'Préc.',next:'Suiv.',today:'Aujourd’hui',year:'Année',month:'Mois',week:'Semaine',day:'Jour',list:'Liste'},
      weekText:'Sem.',allDayText:'Toute la journée',moreLinkText:'en plus',noEventsText:'Aucun évènement à afficher',
      week:{dow:1,doy:4}
    });
  }
})();
</script>

<script>
$(function(){

  function escapeHtml(s){
    return String(s || '').replace(/[&<>"']/g, m => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[m]));
  }

  function stripHtml(html){
    return String(html || '').replace(/<[^>]+>/g,'').trim();
  }

  function formatStatusBadgeFromHtml(html){
    const txt = stripHtml(html).toLowerCase();
    if(txt.includes('à venir')){
      return '<span class="status-pill info"><i class="bi bi-clock-history"></i> À venir</span>';
    }
    if(txt.includes('en cours')){
      return '<span class="status-pill success"><i class="bi bi-lightning-charge"></i> En cours</span>';
    }
    if(txt.includes('terminée')){
      return '<span class="status-pill secondary"><i class="bi bi-check2-circle"></i> Terminée</span>';
    }
    return '<span class="status-pill secondary"><i class="bi bi-dash-circle"></i> —</span>';
  }

  let currentSessionPayload = null;

  const dt = $('#table-of-inscriptions').DataTable({
    scrollX: true,
    autoWidth: false,
    responsive: false,
    ajax:{
      url:"{{ path('app_of_inscriptions_ajax', { entite: entite.id }) }}",
      type:'POST'
    },
    columns:[
      {data:'stagiaire'},
      {data:'formation'},
      {data:'code'},
      {data:'dates'},
      {
        data:'statut',
        render: function(d){
          return formatStatusBadgeFromHtml(d);
        }
      },
      {
        data:'actions',
        className:'text-center',
        orderable:false,
        searchable:false,
        render:function(d, type, row){
          const raw = (d || '').trim();
          const key = String(row.sessionId || row.inscriptionId || row.code || Math.random()).replace(/\W+/g,'_');
          const menuId = 'act_of_' + key;

          return `
            <div class="actions-wrap">
              <div class="dropdown action-dd">
                <button class="btn btn-action btn-sm dropdown-toggle" type="button"
                        id="${menuId}"
                        data-bs-toggle="dropdown"
                        data-bs-boundary="viewport"
                        data-bs-display="static"
                        aria-expanded="false">
                  <i class="bi bi-three-dots-vertical"></i> Actions
                </button>
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="${menuId}">
                  <div class="dd-head">
                    <div class="t"><i class="bi bi-lightning-charge me-1"></i> Actions</div>
                  </div>
                  ${raw}
                </div>
              </div>
            </div>
          `;
        }
      },
      {data:'firstStartIso', visible:false, searchable:false},
      {data:'lastEndIso', visible:false, searchable:false},
      {data:'sessionId', visible:false, searchable:false}
    ],
    order:[[6,'desc']],
    pageLength:10,
    language:{ url:'https://cdn.datatables.net/plug-ins/2.3.4/i18n/fr-FR.json' },
    drawCallback:function(){
      computeKpisFromTable(this.api());
      buildTimelineFromTable(this.api(), '#upcoming-timeline', 7);
    }
  });

  $('#searchAll').on('input', function(){
    dt.search(this.value).draw();
  });

  $('#btnReloadTable').on('click', function(){
    dt.ajax.reload(null, false);
    calendar.refetchEvents();
  });

  $('#btnExportTable').on('click', function(){
    const rows = dt.rows({search:'applied'}).data().toArray();
    const header = ['Stagiaire','Formation','Code','Dates','Statut'];
    const lines = [header.join(';')].concat(
      rows.map(r => [
        r.stagiaire,
        stripHtml(r.formation),
        r.code,
        stripHtml(r.dates),
        stripHtml(r.statut)
      ].map(v => '"' + String(v ?? '').replaceAll('"','""') + '"').join(';'))
    );

    const blob = new Blob([lines.join('\n')], {type:'text/csv;charset=utf-8;'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'inscriptions_of.csv';
    a.click();
    URL.revokeObjectURL(url);
  });

  function computeKpisFromTable(api){
    const data = api.rows({search:'applied'}).data().toArray();
    const now = new Date();

    let upcoming = 0;
    let live = 0;
    let trainees = data.length;
    let sessionsDocs = new Set();

    data.forEach(row => {
      if(row.firstStartIso && row.lastEndIso){
        const start = new Date(row.firstStartIso);
        const end = new Date(row.lastEndIso);

        if(now < start) upcoming++;
        else if(now >= start && now <= end) live++;
      }
    });

    $('#kpi-upcoming').text(upcoming);
    $('#kpi-live').text(live);
    $('#kpi-trainees').text(trainees);

    // On calcule les docs sur la dernière session ouverte quand dispo,
    // sinon on garde une valeur informative légère.
    if(currentSessionPayload?.session?.documents){
      $('#kpi-docs').text(currentSessionPayload.session.documents.length || 0);
    } else {
      $('#kpi-docs').text('—');
    }
  }

  function buildTimelineFromTable(api, selector, maxItems){
    const data = api.rows().data().toArray();
    const now = new Date();

    const items = data
      .filter(r => r.firstStartIso)
      .map(r => {
        const start = new Date(r.firstStartIso);
        return {
          whenDate: start,
          when: start.toLocaleString('fr-FR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }),
          what: `${stripHtml(r.formation)} (${r.code || ''})`
        };
      })
      .filter(it => it.whenDate > now)
      .sort((a,b)=> a.whenDate - b.whenDate);

    const ul = document.querySelector(selector);
    ul.innerHTML = '';

    if(items.length === 0){
      ul.innerHTML = '<li><span class="dot"></span><span class="when">-</span><span class="what">Aucune session à venir.</span></li>';
      return;
    }

    items.slice(0, maxItems || 6).forEach(it => {
      const li = document.createElement('li');
      li.innerHTML = `<span class="dot"></span><span class="when">${it.when}</span><span class="what">${escapeHtml(it.what)}</span>`;
      ul.appendChild(li);
    });
  }

  const calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
    locale:'fr',
    height:'auto',
    initialView:'dayGridMonth',
    headerToolbar:{
      left:'prev,next today',
      center:'title',
      right:'dayGridMonth,timeGridWeek,listWeek'
    },
    events:"{{ path('app_of_calendar_feed', { entite: entite.id }) }}",
    eventDidMount:(info)=>{
      info.el.style.borderRadius = '.6rem';
      info.el.style.boxShadow = '0 8px 20px rgba(0,0,0,.08)';
    },
    eventClick:(info)=>{
      info.jsEvent?.preventDefault();
      const sid = info.event.extendedProps?.sessionId || info.event.id;
      if(sid){
        openSessionDetail(sid);
      }
    }
  });
  calendar.render();

  async function fetchSessionDetail(sessionId){
    const url = "{{ path('app_of_session_detail_ajax', { entite: entite.id, session: '__SESSION__' }) }}".replace('__SESSION__', sessionId);
    const res = await fetch(url, { headers:{ 'X-Requested-With':'XMLHttpRequest', 'Accept':'application/json' }});
    const json = await res.json();
    if(!res.ok || !json || json.success !== true){
      throw new Error(json?.message || 'Impossible de charger le détail de la session.');
    }
    return json;
  }

  function renderDocumentsPreview(documents, containerSelector, emptyText){
    const wrap = document.querySelector(containerSelector);
    if(!wrap) return;

    const docs = documents || [];
    if(docs.length === 0){
      wrap.innerHTML = `<div class="empty-state"><i class="bi bi-folder-x me-1"></i> ${escapeHtml(emptyText || 'Aucun document disponible.')}</div>`;
      return;
    }

    wrap.innerHTML = docs.map(doc => `
      <div class="asset-item mb-2">
        <div class="asset-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
        <div class="flex-grow-1 text-truncate">
          <div class="asset-name" title="${escapeHtml(doc.type || 'Document')}">${escapeHtml(doc.type || 'Document')}</div>
          <div class="asset-meta">
            ${doc.uploadedAt ? escapeHtml(doc.uploadedAt) : ''}
            ${doc.mimeType ? ' · ' +  escapeHtml(doc.mimeType) : ''}
          </div>
        </div>
        <div class="d-flex gap-2">
          <a class="btn btn-sm btn-outline-secondary" href="${doc.viewUrl}" target="_blank" title="Voir">
            <i class="bi bi-eye"></i>
          </a>
          <a class="btn btn-sm btn-outline-primary" href="${doc.downloadUrl}" title="Télécharger">
            <i class="bi bi-download"></i>
          </a>
        </div>
      </div>
    `).join('');
  }

  function renderParticipants(participants){
    const tbody = document.getElementById('detail-participants-body');
    if(!tbody) return;

    if(!participants || participants.length === 0){
      tbody.innerHTML = `<tr><td colspan="8" class="text-center text-muted py-4">Aucun participant trouvé.</td></tr>`;
      return;
    }

    tbody.innerHTML = participants.map(p => `
      <tr>
        <td class="fw-bold">${escapeHtml(p.nom || '—')}</td>
        <td>${p.email ? escapeHtml(p.email) : '<span class="text-muted">—</span>'}</td>
        <td>${p.telephone ? escapeHtml(p.telephone) : '<span class="text-muted">—</span>'}</td>
        <td>
          <span class="status-pill ${p.absent ? 'secondary' : (p.present ? 'success' : 'info')}">
            <i class="bi ${p.absent ? 'bi-x-circle' : (p.present ? 'bi-check2-circle' : 'bi-info-circle')}"></i>
            ${escapeHtml(p.statut || '—')}
          </span>
        </td>
        <td>${p.montantDu ? escapeHtml(p.montantDu) : '<span class="text-muted">—</span>'}</td>
        <td>${p.montantRegle ? escapeHtml(p.montantRegle) : '<span class="text-muted">—</span>'}</td>
        <td class="text-center">${p.assiduite !== null && p.assiduite !== undefined ? escapeHtml(p.assiduite) + '%' : '<span class="text-muted">—</span>'}</td>
        <td class="text-center">
          ${p.reussi === true
            ? '<span class="badge bg-success">Oui</span>'
            : (p.reussi === false ? '<span class="badge bg-secondary">Non</span>' : '<span class="text-muted">—</span>')
          }
        </td>
      </tr>
    `).join('');
  }

  function renderJours(jours){
    const wrap = document.getElementById('detail-jours');
    if(!wrap) return;

    if(!jours || jours.length === 0){
      wrap.innerHTML = `<div class="empty-state">Aucun jour de session.</div>`;
      return;
    }

    wrap.innerHTML = jours.map(j => `
      <div class="asset-item">
        <div class="asset-icon"><i class="bi bi-calendar-event"></i></div>
        <div class="flex-grow-1">
          <div class="asset-name">${escapeHtml(j.dateLabel || '—')}</div>
          <div class="asset-meta">
            ${escapeHtml(j.heureDebut || '--:--')} → ${escapeHtml(j.heureFin || '--:--')}
            ${j.formateur ? ' · ' + escapeHtml(j.formateur) : ''}
          </div>
        </div>
      </div>
    `).join('');
  }

  function fillDetailModal(payload){
    currentSessionPayload = payload;
    const s = payload.session || {};

    $('#detail-subtitle').text(`${s.formation || 'Session'} · ${s.code || ''}`);
    $('#detail-participants-count').text(s.participantsCount ?? 0);
    $('#detail-present-count').text(s.presentCount ?? 0);
    $('#detail-absent-count').text(s.absentCount ?? 0);
    $('#detail-montant').text(s.montant || '—');

    $('#detail-code').text(s.code || '—');
    $('#detail-formation').text(s.formation || '—');
    $('#detail-statut').text(s.statut || '—');
    $('#detail-capacite').text(s.capacite ?? '—');
    $('#detail-formateur').text(s.formateur || '—');
    $('#detail-site').text(s.siteNom || '—');
    $('#detail-adresse').text(s.adresse || '—');

    renderJours(s.jours || []);
    renderParticipants(s.participants || []);
    renderDocumentsPreview(s.documents || [], '#detail-documents-preview', 'Aucun document lié à cette session.');

    $('#kpi-docs').text((s.documents || []).length || 0);
  }

  async function openSessionDetail(sessionId){
    try{
      $('#detail-subtitle').text('Chargement…');
      $('#detail-participants-body').html('<tr><td colspan="8" class="text-center text-muted py-4">Chargement…</td></tr>');
      bootstrap.Modal.getOrCreateInstance(document.getElementById('sessionDetailModal')).show();

      const payload = await fetchSessionDetail(sessionId);
      fillDetailModal(payload);
    }catch(e){
      $('#detail-subtitle').text('Erreur');
      $('#detail-participants-body').html(`<tr><td colspan="8" class="text-center text-danger py-4">${escapeHtml(e.message || 'Erreur')}</td></tr>`);
    }
  }

  function openDocsModalFromCurrentSession(){
    const s = currentSessionPayload?.session || null;
    const wrap = document.getElementById('docs-list');
    if(!wrap) return;

    if(!s){
      $('#docs-subtitle').text('Session : -');
      renderDocumentsPreview([], '#docs-list', 'Aucune session sélectionnée.');
      bootstrap.Modal.getOrCreateInstance(document.getElementById('docsModal')).show();
      return;
    }

    $('#docs-subtitle').text(`Session : ${s.formation || '—'} · ${s.code || ''}`);
    renderDocumentsPreview(s.documents || [], '#docs-list', 'Aucun document sur cette session.');
    bootstrap.Modal.getOrCreateInstance(document.getElementById('docsModal')).show();
  }

  $(document).on('click', '.js-open-session-detail', function(e){
    e.preventDefault();
    const sessionId = this.dataset.session;
    if(sessionId) openSessionDetail(sessionId);
  });

  $(document).on('click', '.js-open-docs', async function(e){
    e.preventDefault();
    const sessionId = this.dataset.session;
    if(!sessionId) return;

    try{
      const payload = await fetchSessionDetail(sessionId);
      currentSessionPayload = payload;
      openDocsModalFromCurrentSession();
    }catch(err){
      $('#docs-subtitle').text('Erreur');
      renderDocumentsPreview([], '#docs-list', err.message || 'Impossible de charger les documents.');
      bootstrap.Modal.getOrCreateInstance(document.getElementById('docsModal')).show();
    }
  });

  $('#btn-open-docs-from-detail').on('click', function(){
    openDocsModalFromCurrentSession();
  });

});
</script>
{% endblock %}