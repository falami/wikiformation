{# templates/of/dashboard.html.twig #}
{% extends 'base_admin.html.twig' %}
{% block title %}Espace OF - Tableau de bord{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.css"/>
<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css">

<style>
:root{
  --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
  --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
  --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
  --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

  --teal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#1e3a5f')) }};
  --amber: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffb703')) }};
  --sand: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#eef3f7')) }};
  --ink:#0f2336;
  --ink-2:#28435a;
  --muted:#6f8897;
  --card:#ffffff;
  --card-2:#f8fbfe;
  --line:#e6eef5;
  --radius:1.15rem;
  --ring:0 14px 48px rgba(15,35,54,.12);
}

html, body{
  max-width:100%;
  overflow-x:hidden;
}

body{ color:var(--ink); }

.round{ border-radius: var(--radius); }
.shadow-premium{ box-shadow: var(--ring); }

.section-card{
  position:relative;
  z-index:1;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  box-shadow: var(--ring);
}
.section-card .card-header{
  background: linear-gradient(180deg, var(--card-2), var(--card));
  border-bottom:1px solid var(--line);
  border-top-left-radius:var(--radius);
  border-top-right-radius:var(--radius);
}
.section-title{
  font-weight:900;
  letter-spacing:.2px;
}

/* ================= HERO ================= */
.hero{
  border-radius: 22px;
  position: relative;
  overflow: hidden;
  color: #fff;
  box-shadow: 0 18px 50px rgba(0,0,0,.14);
  background:
    radial-gradient(1200px 420px at 12% -10%,
      color-mix(in srgb, var(--theme-color-tertiaire) 35%, transparent),
      transparent 58%
    ),
    radial-gradient(900px 380px at 92% 0%,
      color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent),
      transparent 60%
    ),
    radial-gradient(700px 260px at 55% 115%,
      color-mix(in srgb, var(--theme-color-quaternaire) 18%, transparent),
      transparent 62%
    ),
    linear-gradient(135deg,
      color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
      color-mix(in srgb, var(--theme-color-principal) 70%, #fff 30%)
    );
}
.hero::after{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0) 55%);
  opacity:.85;
}
.hero .accent{
  width: 12px;
  border-radius: 999px;
  background: var(--theme-color-secondaire);
  box-shadow: 0 0 0 6px color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
}
.hero .meta-chip{
  display:inline-flex;
  align-items:center;
  gap:.45rem;
  padding:.28rem .65rem;
  border-radius:999px;
  font-size:.82rem;
  background: rgba(255,255,255,.10);
  border: 1px solid rgba(255,255,255,.14);
  color: rgba(255,255,255,.92);
  white-space: nowrap;
}
.hero .meta-chip i{ color: var(--theme-color-secondaire); }
.hero .btn{
  border-radius: 14px;
  font-weight: 800;
}
.hero .btn-outline-hero{
  border-color: rgba(255,255,255,.35);
  color:#fff;
}
.hero .btn-outline-hero:hover{
  background: rgba(255,255,255,.10);
  border-color: rgba(255,255,255,.55);
  color:#fff;
}
.hero .btn.btn-light{
  background: rgba(255,255,255,.90);
  border-color: rgba(0,0,0,.10);
  box-shadow: 0 10px 22px rgba(0,0,0,.08);
}
.hero .btn.btn-light:hover{
  background: rgba(255,255,255,.96);
  box-shadow: 0 14px 28px rgba(0,0,0,.12);
}

/* ================= KPI ================= */
.kpi{
  position:relative;
  border: 1px solid color-mix(in oklab, var(--theme-color-principal) 10%, var(--line) 90%);
  border-radius: 1.15rem;
  padding: 1.05rem 1.15rem;
  box-shadow: 0 16px 50px rgba(15,35,54,.10);
  overflow:hidden;
  background:#fff;
}
.kpi::after{
  content:"";
  position:absolute;
  inset:0;
  background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0) 55%);
  pointer-events:none;
  opacity:.75;
}
.kpi .kpi-top{
  position:relative;
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:.85rem;
  z-index:1;
}
.kpi .kpi-ico{
  width:44px;
  height:44px;
  border-radius: 1rem;
  display:grid;
  place-items:center;
  flex:0 0 auto;
  background:
    radial-gradient(120px 60px at 30% 20%, rgba(255,255,255,.22), transparent 60%),
    linear-gradient(135deg,
      color-mix(in oklab, var(--theme-color-principal) 88%, black 12%),
      color-mix(in oklab, var(--theme-color-principal) 55%, var(--theme-color-secondaire) 45%)
    );
  border: 1px solid rgba(255,255,255,.22);
  box-shadow:
    0 16px 30px rgba(15,35,54,.16),
    0 0 0 6px color-mix(in oklab, var(--theme-color-secondaire) 16%, transparent 84%);
}
.kpi .kpi-ico i{
  color:#fff;
  font-size: 1.25rem;
}
.kpi .kpi-main{
  position:relative;
  z-index:1;
  flex:1 1 auto;
  min-width:0;
}
.kpi .label{
  color: var(--muted);
  font-size: .82rem;
  font-weight: 900;
  letter-spacing: .2px;
  margin-top: .55rem;
}
.kpi .value{
  font-weight: 950;
  font-size: 1.85rem;
  line-height: 1;
  letter-spacing: .2px;
  color: var(--ink);
}
.kpi .sub{
  margin-top: .35rem;
  font-size: .82rem;
  color: color-mix(in oklab, var(--muted) 82%, var(--ink) 18%);
  font-weight: 800;
}
.kpi:hover{
  transform: translateY(-2px);
  transition: transform .14s ease, box-shadow .14s ease;
  box-shadow: 0 22px 70px rgba(15,35,54,.14);
}

/* ================= TOOLBAR ================= */
.toolbar{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:.8rem;
  box-shadow: var(--ring);
}
.toolbar .form-control,
.toolbar .input-group-text{
  border-color: var(--line);
  background: var(--card);
}

/* ================= DATATABLES ================= */
.dt-scroll{
  width:100%;
  overflow-x:auto !important;
  -webkit-overflow-scrolling:touch;
}
.dt-scroll .dataTables_wrapper{ width:100%; }
.dt-scroll table.dataTable{
  width:100% !important;
  min-width:880px;
}
.table thead th{
  font-weight:900;
  color:var(--ink-2);
  border-bottom:1px solid var(--line) !important;
}
table.dataTable tbody tr{
  transition: background .15s ease;
}
table.dataTable tbody tr:hover{
  background: color-mix(in oklab, var(--sand) 35%, white 65%);
}
.dataTables_wrapper .dataTables_filter input{
  border:1px solid var(--line);
  border-radius:.65rem;
  padding:.45rem .75rem;
  background:var(--card-2);
  color:var(--ink);
}
.compact td, .compact th{ padding:.75rem .8rem !important; }

.status-pill{
  display:inline-flex;
  align-items:center;
  gap:.35rem;
  background: color-mix(in oklab, var(--amber) 12%, white 88%);
  color: color-mix(in oklab, var(--amber) 60%, black 40%);
  border:1px solid color-mix(in oklab, var(--amber) 35%, white 65%);
  border-radius:999px;
  padding:.25rem .55rem;
  font-weight:800;
  font-size:.8rem;
}
.status-pill.info{
  background: color-mix(in oklab, #0ea5e9 10%, white 90%);
  color: color-mix(in oklab, #0284c7 70%, black 30%);
  border-color: color-mix(in oklab, #38bdf8 25%, white 75%);
}
.status-pill.success{
  background: color-mix(in oklab, #22c55e 12%, white 88%);
  color: color-mix(in oklab, #16a34a 70%, black 30%);
  border-color: color-mix(in oklab, #22c55e 25%, white 75%);
}
.status-pill.secondary{
  background: color-mix(in oklab, #64748b 12%, white 88%);
  color: color-mix(in oklab, #475569 72%, black 28%);
  border-color: color-mix(in oklab, #94a3b8 22%, white 78%);
}

.actions-wrap{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:.4rem;
  flex-wrap:wrap;
}
.btn-mini{
  padding:.25rem .5rem;
  border-radius:.55rem;
  font-weight:800;
}

/* ================= DROPDOWN ACTIONS ================= */
.action-dd .btn-action{
  display:inline-flex;
  align-items:center;
  gap:.45rem;
  border-radius:.85rem;
  font-weight:900;
  border:1px solid color-mix(in oklab, var(--theme-color-secondaire) 45%, white 55%);
  background: color-mix(in oklab, var(--theme-color-secondaire) 16%, white 84%);
  color: color-mix(in oklab, var(--theme-color-secondaire) 55%, black 45%);
}
.action-dd .btn-action:hover,
.action-dd .btn-action:focus{
  background: color-mix(in oklab, var(--theme-color-secondaire) 22%, white 78%);
  box-shadow: 0 0 0 .2rem color-mix(in oklab, var(--theme-color-secondaire) 22%, transparent 78%);
}
.action-dd .dropdown-menu{
  border-radius: 1rem;
  border:1px solid var(--line);
  box-shadow: var(--ring);
  overflow:hidden;
  padding:.35rem;
}
.action-dd .dropdown-menu .dd-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding: .55rem .65rem .5rem;
  margin: -.35rem -.35rem .35rem;
  background: linear-gradient(135deg,
    color-mix(in oklab, var(--theme-color-principal) 92%, black 8%),
    color-mix(in oklab, var(--theme-color-principal) 72%, var(--theme-color-secondaire) 28%)
  );
  color:#fff;
}
.action-dd .dropdown-menu .dd-head .t{
  font-weight: 950;
  letter-spacing:.2px;
}
.action-dd .dropdown-menu :is(a, button){
  width: 100%;
  display:flex !important;
  align-items:center;
  gap:.6rem;
  padding:.55rem .65rem !important;
  margin: .18rem 0 !important;
  border-radius:.9rem !important;
  border: 1px solid transparent !important;
  background: transparent !important;
  font-weight: 900 !important;
  text-decoration: none !important;
  line-height: 1.15;
  color: var(--ink) !important;
  box-shadow: none !important;
}
.action-dd .dropdown-menu :is(a, button):hover{
  background: color-mix(in oklab, var(--sand) 45%, white 55%) !important;
  border-color: color-mix(in oklab, var(--theme-color-principal) 14%, transparent 86%) !important;
  transform: translateY(-1px);
}
.action-dd .dropdown-menu :is(a, button) i{
  width: 1.25rem;
  text-align:center;
  font-size: 1.05rem;
  opacity: .95;
}

/* ================= CALENDAR ================= */
#calendar{
  min-height: 520px;
  border-radius: 18px;
  overflow: hidden;
  background: var(--card, #fff);
  border: 1px solid var(--line, rgba(0,0,0,.08));
  box-shadow: var(--ring, 0 14px 48px rgba(15,35,54,.12));
}
.fc{
  --fc-page-bg-color: transparent;
  --fc-neutral-bg-color: color-mix(in oklab, var(--theme-color-tertiaire) 70%, transparent 30%);
  --fc-border-color: color-mix(in oklab, var(--theme-color-principal) 12%, transparent 88%);
  --fc-today-bg-color: color-mix(in oklab, var(--theme-color-secondaire) 18%, transparent 82%);
  --fc-event-bg-color: color-mix(in oklab, var(--theme-color-principal) 92%, black 8%);
  --fc-event-border-color: transparent;
  --fc-event-text-color: #fff;
  --fc-list-event-hover-bg-color: color-mix(in oklab, var(--theme-color-tertiaire) 65%, white 35%);
}
.fc .fc-header-toolbar{
  padding: 1rem 1rem .75rem;
  margin: 0 !important;
  background:
    radial-gradient(900px 260px at 10% -40%, color-mix(in oklab, var(--theme-color-secondaire) 18%, transparent 82%), transparent 60%),
    linear-gradient(135deg,
      color-mix(in oklab, var(--theme-color-principal) 92%, black 8%),
      color-mix(in oklab, var(--theme-color-principal) 72%, var(--theme-color-secondaire) 28%)
    );
  border-bottom: 1px solid rgba(255,255,255,.14);
}
.fc .fc-toolbar-title{
  color:#fff;
  font-weight:900;
  letter-spacing:.2px;
}
.fc .fc-button{
  border: 1px solid rgba(255,255,255,.18) !important;
  background: rgba(255,255,255,.10) !important;
  color: #fff !important;
  border-radius: .75rem !important;
  box-shadow: none !important;
  padding: .45rem .7rem !important;
  font-weight: 800 !important;
}
.fc .fc-button:hover{ background: rgba(255,255,255,.16) !important; }
.fc .fc-button.fc-button-active{
  background: color-mix(in oklab, var(--theme-color-secondaire) 72%, black 0%) !important;
  border-color: color-mix(in oklab, var(--theme-color-secondaire) 55%, white 45%) !important;
  color: color-mix(in oklab, var(--theme-color-principal) 25%, black 75%) !important;
}
.fc .fc-col-header-cell{
  background: color-mix(in oklab, var(--theme-color-tertiaire) 70%, white 30%);
}
.fc .fc-col-header-cell-cushion{
  padding: .75rem .25rem !important;
  color: var(--theme-color-quaternaire);
  font-weight: 900;
  text-decoration: none !important;
}
.fc .fc-daygrid-day-number{
  padding: .45rem .55rem !important;
  color: color-mix(in oklab, var(--theme-color-principal) 82%, black 18%);
  font-weight: 800;
  text-decoration: none !important;
}
.fc .fc-day-today{
  background: var(--fc-today-bg-color) !important;
}
.fc .fc-day-today .fc-daygrid-day-number{
  background: color-mix(in oklab, var(--theme-color-secondaire) 55%, white 45%);
  color: color-mix(in oklab, var(--theme-color-principal) 25%, black 75%);
  border-radius: 999px;
  padding: .25rem .6rem !important;
}
.fc .fc-event{
  border-radius: .75rem !important;
  padding: .2rem .35rem !important;
  box-shadow: 0 10px 22px rgba(0,0,0,.10);
}
.fc .fc-event .fc-event-title{ font-weight: 800; }
.fc .fc-event .fc-event-time{ font-weight: 800; opacity: .92; }

/* ================= TIMELINE ================= */
.timeline{
  list-style:none;
  margin:0;
  padding:0;
}
.timeline li{
  display:flex;
  align-items:flex-start;
  gap:.8rem;
  padding:.65rem .2rem;
  border-bottom:1px dashed var(--line);
}
.timeline .dot{
  width:.7rem;
  height:.7rem;
  border-radius:999px;
  background: color-mix(in oklab, var(--teal) 94%, white 0%);
  margin-top:.25rem;
  flex:0 0 .7rem;
}
.timeline .when{
  font-weight:900;
  min-width: 110px;
}
.timeline .what{
  color:var(--muted);
}

/* ================= DETAIL / DOCS ================= */
.detail-stat{
  border:1px solid var(--line);
  background:var(--card-2);
  border-radius:1rem;
  padding:.9rem 1rem;
  height:100%;
}
.detail-stat .label{
  font-size:.8rem;
  color:var(--muted);
  font-weight:800;
}
.detail-stat .value{
  font-size:1.15rem;
  font-weight:900;
  color:var(--ink);
}

.pill{
  display:inline-flex;
  align-items:center;
  gap:.4rem;
  border:1px solid var(--line);
  background: var(--card);
  border-radius:999px;
  padding:.35rem .65rem;
  font-weight:900;
  font-size:.85rem;
}
.soft-chip{
  display:inline-flex;
  align-items:center;
  gap:.4rem;
  border-radius:999px;
  padding:.3rem .65rem;
  font-size:.82rem;
  font-weight:900;
  border:1px solid color-mix(in oklab, var(--theme-color-secondaire) 30%, var(--line) 70%);
  background: color-mix(in oklab, var(--theme-color-secondaire) 10%, white 90%);
  color: color-mix(in oklab, var(--theme-color-secondaire) 62%, black 38%);
}

.asset-item{
  display:flex;
  align-items:center;
  gap:.75rem;
  padding:.7rem .8rem;
  border:1px solid var(--line);
  border-radius:.85rem;
  background:#fff;
}
.asset-icon{
  width:38px;
  height:38px;
  display:grid;
  place-items:center;
  border-radius:.75rem;
  background: color-mix(in oklab, var(--teal) 10%, white 90%);
  color: color-mix(in oklab, var(--teal) 85%, black 15%);
}
.asset-name{
  font-weight:800;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.asset-meta{
  font-size:.8rem;
  color:var(--muted);
}
.empty-state{
  border:1px dashed var(--line);
  border-radius:1rem;
  padding:1.25rem;
  background:var(--card-2);
  color:var(--muted);
  text-align:center;
}

/* ================= MODALS ================= */
.modal .modal-content.section-card{
  border-radius: calc(var(--radius) + .2rem);
  overflow:hidden;
}
.modal-header-premium{
  background:
    radial-gradient(900px 280px at 10% -40%, rgba(255,255,255,.14), transparent 60%),
    linear-gradient(135deg, color-mix(in oklab, var(--teal) 92%, black 8%), color-mix(in oklab, var(--amber) 55%, white 10%));
  color:#fff;
  border-bottom: 1px solid rgba(255,255,255,.18);
}
.modal-header-premium .btn-close{
  filter: invert(1) grayscale(100%);
  opacity:.85;
}
.modal-subtitle{
  opacity:.9;
  font-size:.9rem;
}

/* ================= MOBILE ================= */
@media (max-width: 576px){
  .fc .fc-header-toolbar{
    flex-wrap: wrap !important;
    gap: .6rem !important;
    padding: .9rem .85rem .75rem !important;
  }
  .fc .fc-toolbar-chunk{
    flex: 1 1 100% !important;
    display: flex !important;
    justify-content: center !important;
  }
  .fc .fc-toolbar-chunk:first-child{ order: 1; justify-content: space-between !important; }
  .fc .fc-toolbar-chunk:nth-child(2){ order: 2; }
  .fc .fc-toolbar-chunk:last-child{ order: 3; }
  .fc .fc-button-group{
    flex-wrap: wrap !important;
    gap: .35rem !important;
    justify-content: center !important;
  }
  .fc .fc-button{
    padding: .35rem .55rem !important;
    font-size: .9rem !important;
  }
  .fc .fc-toolbar-title{
    font-size: 1.2rem !important;
    text-align: center;
    white-space: normal;
  }

  .dt-scroll table.dataTable{
    min-width:760px;
  }

  .timeline .when{
    min-width: 86px;
    font-size:.85rem;
  }
}
</style>
{% endblock %}

{% block body %}

<div class="hero p-3 mb-4 d-flex gap-3">
  <div class="accent"></div>

  <div class="flex-grow-1">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
      <div>
        <h2 class="m-0 fw-bold">
          <i class="bi bi-mortarboard-fill me-2" style="color:var(--theme-color-secondaire)"></i>
          Tableau de bord OF
        </h2>

        <div class="opacity-75 mt-1">
          Pilotez vos inscriptions, visualisez vos sessions et centralisez vos documents pédagogiques.
        </div>

        <div class="d-flex gap-2 flex-wrap mt-3">
          <span class="meta-chip"><i class="bi bi-building"></i> {{ organismeFormation.nom ?? organismeFormation.raisonSociale ?? 'Organisme de formation' }}</span>
          <span class="meta-chip"><i class="bi bi-diagram-3"></i> {{ entite.nom ?? '—' }}</span>
          <span class="meta-chip"><i class="bi bi-clock-history"></i> <strong>{{ 'now'|date('d/m/Y H:i') }}</strong></span>
        </div>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <a href="{{ path('app_of_dashboard', { entite: entite.id }) }}"
           class="btn btn-light btn-sm fw-semibold">
          <i class="bi bi-arrow-repeat me-1"></i> Actualiser
        </a>

        <a href="{{ path('app_of_formations', { entite: entite.id }) }}"
           class="btn btn-outline-hero btn-sm fw-semibold">
          <i class="bi bi-journal-bookmark me-1"></i> Formations
        </a>

        <button type="button"
                class="btn btn-outline-hero btn-sm fw-semibold"
                data-bs-toggle="modal"
                data-bs-target="#uploadDocModal">
          <i class="bi bi-cloud-arrow-up me-1"></i> Ajouter un document
        </button>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-12 col-sm-6 col-xl-3">
    <div class="kpi h-100">
      <div class="kpi-top">
        <div class="kpi-ico"><i class="bi bi-calendar2-week-fill"></i></div>
        <div class="kpi-main">
          <div class="value" id="kpi-upcoming">-</div>
          <div class="label">Sessions à venir</div>
          <div class="sub"><i class="bi bi-clock-history me-1"></i>Prochaines dates</div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-xl-3">
    <div class="kpi h-100">
      <div class="kpi-top">
        <div class="kpi-ico"><i class="bi bi-broadcast-pin"></i></div>
        <div class="kpi-main">
          <div class="value" id="kpi-live">-</div>
          <div class="label">Sessions en cours</div>
