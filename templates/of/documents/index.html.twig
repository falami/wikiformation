{% extends 'base_admin.html.twig' %}
{% block title %}Espace OF — Documents{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.2.2/datatables.min.css"/>

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

      --ink:#0f2336;
      --muted:#6b7b8a;
      --line:rgba(15,35,54,.10);
      --radius:20px;
      --shadow: 0 18px 50px rgba(0,0,0,.10);
      --shadow-soft: 0 12px 28px rgba(0,0,0,.06);
    }

    .pageWrap{ width:100%; padding-top:0 !important; }

    .stickyHero{
      position: sticky;
      top: 12px;
      z-index: 20;
      border-radius: 24px;
      overflow: hidden;
      color: #fff;
      box-shadow: var(--shadow);
      border: 1px solid rgba(255,255,255,.08);
      background:
        radial-gradient(1200px 420px at 12% -10%, color-mix(in srgb, var(--theme-color-tertiaire) 35%, transparent), transparent 58%),
        radial-gradient(900px 380px at 92% 0%, color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent), transparent 60%),
        radial-gradient(700px 260px at 55% 115%, color-mix(in srgb, var(--theme-color-quaternaire) 18%, transparent), transparent 62%),
        linear-gradient(135deg, color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%), color-mix(in srgb, var(--theme-color-principal) 70%, #fff 30%));
      margin: 10px 0 16px;
      backdrop-filter: blur(10px);
    }

    .stickyHero::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0) 55%);
      opacity:.85;
    }

    .stickyRow{
      display:flex;
      gap:14px;
      padding:14px 16px;
      align-items:center;
      flex-wrap: wrap;
    }

    .avatar{
      width:44px; height:44px; border-radius:14px;
      background: rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.14);
      display:flex; align-items:center; justify-content:center;
      font-weight:900;
      box-shadow: 0 10px 26px rgba(0,0,0,.18);
      backdrop-filter: blur(8px);
      flex: 0 0 auto;
    }

    .chip{
      display:inline-flex; align-items:center; gap:8px;
      padding:6px 10px; border-radius:999px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.08);
      font-size:12px; white-space:nowrap;
      backdrop-filter: blur(8px);
    }

    .btn-ghost{
      background: rgba(255,255,255,.10) !important;
      border: 1px solid rgba(255,255,255,.14) !important;
      color: #fff !important;
      border-radius: 14px !important;
      font-weight: 800;
      box-shadow: 0 10px 24px rgba(0,0,0,.12);
    }

    .cardX{
      background: var(--bs-body-bg);
      border:1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
    }
    .cardX-h{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:14px 16px;
      border-bottom:1px solid var(--line);
    }
    .cardX-b{ padding:16px; }
    .titleX{ display:flex; align-items:center; gap:10px; font-weight:900; margin:0; }
    .titleX i{ color: var(--theme-color-secondaire); }

    .toolbarX{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      justify-content:space-between;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: rgba(15,35,54,.03);
      margin-bottom: 16px;
    }

    table.dataTable{ border-collapse: separate !important; border-spacing: 0 10px !important; }
    table.dataTable thead th{
      border-bottom: 0 !important;
      color: var(--muted);
      font-size:12px;
      text-transform:uppercase;
      letter-spacing:.04em;
    }
    table.dataTable tbody tr{
      background: var(--bs-body-bg);
      border: 1px solid var(--line);
      box-shadow: 0 10px 18px rgba(0,0,0,.04);
    }
    table.dataTable tbody td{
      border-top: 1px solid rgba(0,0,0,0) !important;
      border-bottom: 1px solid rgba(0,0,0,0) !important;
      vertical-align: middle;
    }
  </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-lg-4 pageWrap">

  {% set rs = organismeFormation.raisonSociale|default('OF') %}
  {% set initials = (rs|slice(0,1))|upper %}

  <div class="stickyHero">
    <div class="stickyRow">
      <div class="avatar">{{ initials ?: 'O' }}</div>

      <div class="flex-grow-1">
        <div class="small opacity-75">Espace organisme de formation</div>
        <div class="fw-bold" style="font-size:18px;">Documents OF</div>

        <div class="d-flex flex-wrap gap-2 mt-1">
          <span class="chip"><i class="bi bi-building"></i> {{ organismeFormation.raisonSociale }}</span>
          <span class="chip"><i class="bi bi-diagram-3"></i> {{ entite.nom ?? '—' }}</span>
        </div>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-ghost btn-sm" href="{{ path('app_of_dashboard', { entite: entite.id }) }}">
          <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a class="btn btn-ghost btn-sm" href="{{ path('app_of_formations', { entite: entite.id }) }}">
          <i class="bi bi-book"></i> Formations
        </a>
        <button class="btn btn-ghost btn-sm" type="button" id="btnGlobalReload">
          <i class="bi bi-arrow-repeat"></i> Tout actualiser
        </button>
      </div>
    </div>
  </div>

  <div class="cardX">
    <div class="cardX-h">
      <h5 class="titleX"><i class="bi bi-folder2-open"></i> Pièces de session</h5>
      <div class="small text-muted">Documents internes OF</div>
    </div>

    <div class="cardX-b">
      <div class="toolbarX">
        <div class="d-flex gap-2 flex-wrap">
          <select class="form-select form-select-sm" id="typeFilter" style="min-width:240px;">
            <option value="all">Tous types</option>
            <option value="CONVENTION">Convention</option>
            <option value="CONVOCATION">Convocation</option>
            <option value="EMARGEMENT">Émargement</option>
            <option value="FACTURE">Facture</option>
            <option value="AUTRE">Autre</option>
          </select>

          <select class="form-select form-select-sm" id="validFilter" style="min-width:240px;">
            <option value="all">Tous statuts</option>
            <option value="valid">Validés</option>
            <option value="pending">En attente</option>
          </select>
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-sm btn-outline-secondary" id="btnReloadPieces"><i class="bi bi-arrow-repeat"></i></button>
          <button class="btn btn-sm btn-outline-secondary" id="btnClearPieces"><i class="bi bi-eraser"></i> Reset</button>
        </div>
      </div>

      <div class="table-responsive">
        <table id="dt-pieces" class="table align-middle w-100 mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Session</th>
              <th>Formation</th>
              <th>Type</th>
              <th>Fichier</th>
              <th>Statut</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
        </table>
      </div>
    </div>
  </div>

</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/v/bs5/dt-2.2.2/datatables.min.js"></script>

  <script>
  $(function(){
    const dt = $('#dt-pieces').DataTable({
      serverSide:true,
      processing:true,
      pageLength:10,
      lengthMenu:[10,25,50],
      language:{ url:'https://cdn.datatables.net/plug-ins/2.3.4/i18n/fr-FR.json' },
      ajax:{
        url: "{{ path('app_of_documents_session_pieces_ajax', { entite: entite.id }) }}",
        type:'POST',
        data: d => {
          d.typeFilter = $('#typeFilter').val() || 'all';
          d.validFilter = $('#validFilter').val() || 'all';
        }
      },
      columns:[
        {data:'date'},
        {data:'session'},
        {data:'formation'},
        {data:'type', orderable:false},
        {data:'fichier'},
        {data:'statut', orderable:false},
        {data:'actions', orderable:false, searchable:false, className:'text-end'},
      ]
    });

    $('#typeFilter,#validFilter').on('change', ()=> dt.ajax.reload());
    $('#btnReloadPieces').on('click', ()=> dt.ajax.reload(null,false));
    $('#btnClearPieces').on('click', ()=>{
      $('#typeFilter').val('all');
      $('#validFilter').val('all');
      dt.search('').draw();
      dt.ajax.reload();
    });
    $('#btnGlobalReload').on('click', ()=> dt.ajax.reload(null,false));
  });
  </script>
{% endblock %}