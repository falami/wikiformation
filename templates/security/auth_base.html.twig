{% extends 'base.html.twig' %}
{% set brand = public_branding() %}
{% block body_attributes %}class="auth-account-page"{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
<link rel="stylesheet" href="{{ asset('dist/css/two-factor.css') }}">
<link rel="stylesheet" href="{{ asset('dist/css/auth-pages.css') }}?v=2">
{% endblock %}
{% block body %}
<main class="auth-shell auth-account">
<section class="auth-intro" aria-label="WikiFormation">
<a class="auth-brand" href="{{ brand.homeUrl ?: path('app_public') }}"><img src="{{ asset(brand.logo) }}" alt="{{ brand.name }}"></a>
<div class="intro-copy"><span class="eyebrow">VOTRE ESPACE DE FORMATION</span>
{% block intro %}{% endblock %}
</div><p class="auth-footnote">{{ brand.name }} · La formation, simplement.</p>
</section>
<section class="auth-form-panel" aria-labelledby="auth-title">
<div class="shield" aria-hidden="true"><svg width="30" height="34" viewBox="0 0 24 28" fill="none"><path d="M12 2 22 6v8c0 6-10 12-10 12S2 20 2 14V6L12 2Z" stroke="currentColor" stroke-width="1.7"/><path d="m7 14 3 3 7-7" stroke="currentColor" stroke-width="1.7"/></svg></div>
{% block account_form %}{% endblock %}
<a class="cancel-link" href="{{ brand.homeUrl ?: path('app_public') }}">← {{ 'login.signup.home'|trans }}</a>
</section></main>
{% block account_scripts %}{% endblock %}
{% endblock %}
