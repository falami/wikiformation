{% extends 'security/auth_base.html.twig' %}
{% block title %}{{ 'login.meta.title'|trans }}{% endblock %}
{% block intro %}<h1>Heureux de vous retrouver.<br><span>Tout commence ici.</span></h1><p>Retrouvez vos formations, vos documents et votre équipe dans un espace unique.</p><ol class="auth-steps"><li><span class="step-current">1</span><div><strong>Connectez-vous</strong><small>Votre adresse e-mail et votre mot de passe</small></div></li><li><span class="step-check">2</span><div><strong>Confirmez votre identité</strong><small>Un code personnel envoyé par e-mail</small></div></li></ol>{% endblock %}
{% block account_form %}<span class="eyebrow">ÉTAPE 1 SUR 2</span><h2 id="auth-title">Connexion à votre espace</h2><p class="form-description">Renseignez vos identifiants pour continuer.</p>
            {% if error %}
                <div class="alert alert-danger text-center">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% if app.user %}
                <div class="alert alert-info text-center">
                    {{ 'login.already_connected'|trans({'%user%': app.user.userIdentifier})|raw }}
                    <a href="{{ path('app_logout') }}" class="text-danger">{{ 'login.logout'|trans }}</a>
                    <a href="{{ path('app_workspace') }}" class="text-primary"><br>
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-speedometer2" viewBox="0 0 16 16">
                            <path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4M3.732 5.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707M2 10a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 10m9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5m.754-4.246a.39.39 0 0 0-.527-.02L7.547 9.31a.91.91 0 1 0 1.302 1.258l3.434-4.297a.39.39 0 0 0-.029-.518z"/>
                            <path fill-rule="evenodd" d="M0 10a8 8 0 1 1 15.547 2.661c-.442 1.253-1.845 1.602-2.932 1.25C11.309 13.488 9.475 13 8 13c-1.474 0-3.31.488-4.615.911-1.087.352-2.49.003-2.932-1.25A8 8 0 0 1 0 10m8-7a7 7 0 0 0-6.603 9.329c.203.575.923.876 1.68.63C4.397 12.533 6.358 12 8 12s3.604.532 4.923.96c.757.245 1.477-.056 1.68-.631A7 7 0 0 0 8 3"/>
                        </svg>
                    </a>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" data-turbo="false">


                <div class="mb-3">
                    <label for="username" class="form-label">{{ 'login.form.email'|trans }}</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">{{ 'login.form.password'|trans }}</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" name="_password" id="password" class="form-control password-login-field" autocomplete="current-password" required>
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target=".password-login-field" aria-label="Afficher ou masquer le mot de passe">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <p class="small text-muted mb-3"><i class="bi bi-shield-lock me-1"></i> Après votre mot de passe, un code de vérification sera envoyé à votre adresse e-mail.</p>

                <button class="verify-button" type="submit">{{ 'login.form.submit'|trans }}</button>

                <div class="text-center mt-3">
                    <small><a href="{{ path('app_forgot_password_request') }}" class="text-muted">{{ 'login.form.forgot'|trans }}</a></small>
                </div>
            </form>
<div class="resend-box"><p>{{ 'login.signup.title'|trans }}</p><a class="resend-button" href="{{ path('app_register') }}">{{ 'login.signup.create'|trans }} →</a></div>
{% endblock %}
{% block account_scripts %}<script>
    document.querySelectorAll('.toggle-password').forEach(button => {
        button.addEventListener('click', function () {
            const input = document.querySelector(this.dataset.target);
            const icon = this.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });
    });
</script>{% endblock %}
