{% macro field(field) %}
  <div class="{{ 'textarea' in field.vars.block_prefixes ? 'col-12' : 'col-12 col-md-6' }} pf-field">
    {{ form_row(field) }}
  </div>
{% endmacro %}
{% macro line(line) %}
  <article class="pf-line document-line">
    <div class="pf-line-heading"><h3><i class="bi bi-list-ul" aria-hidden="true"></i> Prestation <span data-line-number></span></h3><button type="button" class="btn btn-outline-danger btn-sm" data-remove-line><i class="bi bi-trash3" aria-hidden="true"></i> Retirer cette ligne</button></div>
    {{ form_errors(line) }}
    <div class="row g-3">{% for field in line %}<div class="{{ field.vars.name == 'label' ? 'col-12' : 'col-12 col-sm-6 col-xl-4' }} pf-field">{{ form_row(field) }}</div>{% endfor %}</div>
  </article>
{% endmacro %}
