<div class="rp-grid">{% for key,config in modules %}<a class="rp-module" href="{{ path('app_' ~ espace ~ '_list',{entite:entite.id,espace:espace,module:key}) }}"><div class="rp-module-top"><span class="rp-icon"><i class="bi bi-{{ config[2] }}"></i></span><span class="rp-count">{{ counts[key] }}</span></div><h2>{{ config[1] }}</h2><div class="d-flex justify-content-between rp-muted"><span>{{ counts[key] == 0 ? 'Aucun dossier attribué' : 'Ouvrir mes dossiers' }}</span><i class="bi bi-arrow-right"></i></div></a>{% endfor %}</div>
