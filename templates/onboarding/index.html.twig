{# templates/onboarding/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Démarrage — WikiFormation{% endblock %}

{% set brand = public_branding() %}
{% block body_attributes %}class="onboarding-page"{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('dist/css/onboarding.css') }}">{% endblock %}
{% block body %}


<main class="wk-wrap">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12">

        <div class="wk-shell">
          <header class="wk-head">
            <div class="wk-topline">
              <a class="wk-brand-link" href="{{ brand.homeUrl ?: path('app_public') }}"><img src="{{ asset(brand.logo) }}" alt="{{ brand.name }}"></a>
              <span class="wk-security"><i class="bi bi-shield-check" aria-hidden="true"></i> Votre espace sécurisé</span>
            </div>
            <div class="wk-hero">
              <div><span class="wk-eyebrow">BIENVENUE DANS VOTRE NOUVEL ESPACE</span>
                <h1 class="wk-title">Votre expertise.<br><span>Un espace à sa hauteur.</span></h1>
                <p class="wk-sub">Créez votre organisme et donnez une nouvelle dimension à vos formations.</p>
              </div>
              <div class="wk-trial"><span class="wk-trial-number">{{ trialDays }}<small>jours</small></span><strong>Pour découvrir tout le potentiel.</strong><span>Essai gratuit · Sans carte bancaire</span></div>
            </div>
            <nav class="wk-steps" aria-label="Configuration de votre organisme">
              <a href="#offers"><span>01</span> Votre offre</a><a href="#identity"><span>02</span> Votre identité</a><a href="#details"><span>03</span> Votre organisme</a>
            </nav>
          </header>

          <div class="wk-body">
            {{ form_start(form, {
              attr: {
                class: 'wk-form',
                id: 'onboardingForm',
                novalidate: 'novalidate'
              }
            }) }}



            {% set hasErrors = form.vars.submitted and not form.vars.valid %}

            {% if hasErrors %}
              <div class="wk-error-summary mb-4" id="formErrorSummary">
                <div class="wk-error-summary-title">
                  <i class="bi bi-exclamation-octagon-fill"></i>
                  <span>Le formulaire contient des informations à corriger</span>
                </div>

                <div class="small text-muted mb-2">
                  Vérifiez les champs signalés ci-dessous puis réessayez.
                </div>

                <ul class="mb-0">
                  {% for child in form %}
                    {% if child.vars.errors|length > 0 %}
                      <li>
                        <strong>{{ child.vars.label|default(child.vars.name) }}</strong> :
                        {{ form_errors(child) }}
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

              <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                  <span class="wk-eyebrow" id="offers">01 / UNE OFFRE À VOTRE MESURE</span><h2 class="wk-section-title">Choisissez votre point de départ.</h2>
                  <div class="text-muted" style="max-width: 62ch;">
                    Une offre pour chaque ambition. Vous pourrez en changer depuis votre espace facturation.
                  </div>
                </div>

                <span class="wk-pill"><i class="bi bi-calendar3"></i> Abonnement mensuel</span>
              </div>

              <div class="mt-3 wk-plan-grid" id="planGrid">
                {% for plan in plans %}



                  <button type="button"
                          class="wk-plan{{ form.planCode.vars.value|trim|upper == plan.code|trim|upper ? ' is-selected' : '' }}"
                          aria-pressed="{{ form.planCode.vars.value|trim|upper == plan.code|trim|upper ? 'true' : 'false' }}"
                          data-plan="{{ plan.code }}"
                          data-month="{{ plan.priceMonthlyCents ?? '' }}">
                      <div class="wk-badge-slot">
                        {% if plan.badge %}
                          <div class="wk-badge"><span class="b-dot"></span>{{ plan.badge }}</div>
                        {% endif %}
                      </div>

                    <div class="wk-plan-inner">
                      <div>
                        <div class="name">{{ plan.name }}</div>
                        <div class="desc">{{ plan.tagline ?: ('Accès complet au plan ' ~ plan.code ~ ' pendant l’essai.') }}</div>
                      </div>

                      <div class="wk-price mt-2">
                        <div class="wk-price-stack">
                          <div class="wk-amount" data-price>{{ plan.priceMonthlyCents ? (plan.priceMonthlyCents / 100)|number_format(0, ",", " ") ~ " €" : "Sur devis" }}</div>
                          <div class="wk-per" data-per>HT/mois</div>
                        </div>

                      </div>
                    </div>

                    <div class="wk-divider-mini"></div>

                    <div class="wk-features">
                      <div class="wk-feature"><i class="bi bi-people"></i> {{ plan.maxUtilisateursLabel }}</div>
                      <div class="wk-feature"><i class="bi bi-mortarboard"></i> {{ plan.maxApprenantsLabel }}</div>
                      <div class="wk-feature"><i class="bi bi-person-badge"></i> {{ plan.maxFormateursLabel }}</div>
                      <div class="wk-feature"><i class="bi bi-briefcase"></i> {{ plan.maxCommerciauxLabel }}</div>
                      <div class="wk-feature"><i class="bi bi-building"></i><span>{{ plan.maxEntreprisesLabel }}</span></div>
                      <div class="wk-feature"><i class="bi bi-person"></i><span>{{ plan.maxProspectsLabel }}</span></div>
                      {% if plan.supportPrioritaire %}
                        <div class="wk-feature"><i class="bi bi-lightning-charge"></i> Support prioritaire</div>
                      {% endif %}
                    </div>

                    <div class="wk-meta">
                      <span class="wk-pill"><i class="bi bi-calendar3"></i> Essai {{ trialDays }} j</span>
                      <span class="wk-pill"><i class="bi bi-stars"></i> Sans CB</span>
                    </div>
                    <span class="wk-plan-choice">
                      <span class="wk-plan-choice-default">Choisir cette offre</span>
                      <span class="wk-plan-choice-selected"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Offre sélectionnée</span>
                    </span>
                  </button>
                {% else %}
                  <div class="alert alert-warning mb-0">
                    Aucun plan n’est disponible pour le moment. Contactez le support.
                  </div>
                {% endfor %}
              </div>

              {{ form_widget(form.planCode) }}
              {{ form_widget(form.interval) }}

              {% if form.planCode.vars.errors|length %}
                <div class="wk-error mt-3">{{ form_errors(form.planCode) }}</div>
              {% endif %}

              <div class="wk-divider"></div>

              <span class="wk-eyebrow" id="identity">02 / VOTRE SIGNATURE</span><h2 class="wk-section-title mb-2">Un espace qui vous ressemble.</h2>
              <div class="text-muted mb-3" style="max-width: 62ch;">
                Ajoutez votre logo et vos couleurs. Cette personnalisation est facultative et reste modifiable à tout moment.
              </div>

              <div class="wk-brand">

                  {# --------- LOGO UPLOADER --------- #}
                  <div>
                    <div class="fw-bold mb-2" style="color:var(--wk-ink);">Logo de l’organisme</div>

                    {# champ file Symfony (masqué) #}
                    {{ form_widget(form.logoFile) }}

                    <div class="wk-drop" id="logoDrop">
                      <div class="wk-logo-preview" id="logoPreview">
                        <span class="text-muted small" id="logoEmpty">SVG / PNG</span>
                      </div>

                      <div class="flex-grow-1">
                        <div class="fw-bold" style="color:var(--wk-ink);">Glissez-déposez votre logo</div>
                        <div class="small text-muted">ou cliquez pour sélectionner un fichier (max 2 Mo)</div>

                        <div class="wk-logo-actions mt-2">
                          <button type="button" class="wk-ghostbtn" id="logoPickBtn">
                            <i class="bi bi-upload me-1"></i> Choisir un fichier
                          </button>

                          <button type="button" class="wk-ghostbtn danger d-none" id="logoRemoveBtn">
                            <i class="bi bi-trash3 me-1"></i> Supprimer
                          </button>

                          <span class="small text-muted" id="logoFileName"></span>
                        </div>
                      </div>
                    </div>

                    {% if form.logoFile.vars.errors|length %}
                      <div class="wk-error mt-3">{{ form_errors(form.logoFile) }}</div>
                    {% endif %}
                  </div>

                  {# --------- COLORS --------- #}
                  <div class="row mt-2">
                    <div class="fw-bold mb-2" style="color:var(--wk-ink);">Couleurs</div>

                    <div class="mb-3 col-12 col-lg-3">
                      {{ form_row(form.couleurPrincipal) }}

                      <div class="mt-2 wk-colorrow"
                          data-color-bind
                          data-select-id="{{ form.couleurPrincipal.vars.id }}">
                        <div class="wk-colorchip" data-chip></div>
                        <input type="color" value="#0d6efd" aria-label="Sélecteur couleur principale" data-picker>
                        <input type="text"
                              class="form-control form-control-sm wk-hex"
                              placeholder="#RRGGBB"
                              inputmode="text"
                              autocomplete="off"
                              spellcheck="false"
                              aria-label="Code hexadécimal de la couleur" data-hex>
                      </div>
                    </div>

                    <div class="mb-3 col-12 col-lg-3">
                      {{ form_row(form.couleurSecondaire) }}

                      <div class="mt-2 wk-colorrow"
                          data-color-bind
                          data-select-id="{{ form.couleurSecondaire.vars.id }}">
                        <div class="wk-colorchip" data-chip></div>
                        <input type="color" value="#6610f2" aria-label="Sélecteur couleur secondaire" data-picker>
                        <input type="text" class="form-control form-control-sm wk-hex"
                              placeholder="#RRGGBB" autocomplete="off" spellcheck="false" aria-label="Code hexadécimal de la couleur" data-hex>
                      </div>
                    </div>

                    <div class="mb-3 col-12 col-lg-3">
                      {{ form_row(form.couleurTertiaire) }}

                      <div class="mt-2 wk-colorrow"
                          data-color-bind
                          data-select-id="{{ form.couleurTertiaire.vars.id }}">
                        <div class="wk-colorchip" data-chip></div>
                        <input type="color" value="#198754" aria-label="Sélecteur couleur tertiaire" data-picker>
                        <input type="text" class="form-control form-control-sm wk-hex"
                              placeholder="#RRGGBB" autocomplete="off" spellcheck="false" aria-label="Code hexadécimal de la couleur" data-hex>
                      </div>
                    </div>

                    <div class="mb-0 col-12 col-lg-3">
                      {{ form_row(form.couleurQuaternaire) }}

                      <div class="mt-2 wk-colorrow"
                          data-color-bind
                          data-select-id="{{ form.couleurQuaternaire.vars.id }}">
                        <div class="wk-colorchip" data-chip></div>
                        <input type="color" value="#ffc107" aria-label="Sélecteur couleur quaternaire" data-picker>
                        <input type="text" class="form-control form-control-sm wk-hex"
                              placeholder="#RRGGBB" autocomplete="off" spellcheck="false" aria-label="Code hexadécimal de la couleur" data-hex>
                      </div>
                    </div>

                    <div class="small text-muted mt-2">
                      Astuce : laissez “Automatique” si vous voulez démarrer vite. Vous pourrez personnaliser votre espace plus tard.
                    </div>
                  </div>
              </div>



              <div class="wk-divider"></div>

              <span class="wk-eyebrow" id="details">03 / LES ESSENTIELS</span><h2 class="wk-section-title mb-1">Faisons connaissance.</h2>
              <div class="wk-section-note mb-3">
                Renseignez les informations principales de votre organisme. Les champs obligatoires sont indiqués clairement.
              </div>

              <div class="wk-form-card">
                <div class="row g-3">

                  <div class="col-12">
                    <div class="wk-field">
                      <div class="wk-label">
                        <label for="{{ form.nom.vars.id }}">{{ form.nom.vars.label }}</label>
                        <span class="wk-required"><i class="bi bi-asterisk"></i> Obligatoire</span>
                      </div>
                      <div class="wk-input-wrap">
                        {{ form_widget(form.nom, {
                          attr: {
                            class: 'form-control form-control-lg' ~ (form.nom.vars.errors|length ? ' is-invalid' : ''),
                            'data-required': 'true'
                          }
                        }) }}
                        <i class="bi bi-buildings wk-field-icon"></i>
                      </div>
                      {% if form.nom.vars.help %}
                        <div class="wk-help">{{ form.nom.vars.help }}</div>
                      {% endif %}
                      {% for error in form.nom.vars.errors %}
                        <div class="wk-invalid"><i class="bi bi-exclamation-circle-fill"></i><span>{{ error.message }}</span></div>
                      {% endfor %}
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="wk-field">
                      <div class="wk-label">
                        <label for="{{ form.email.vars.id }}">{{ form.email.vars.label }}</label>
                        <span class="wk-required"><i class="bi bi-asterisk"></i> Obligatoire</span>
                      </div>
                      <div class="wk-input-wrap">
                        {{ form_widget(form.email, {
                          attr: {
                            class: 'form-control' ~ (form.email.vars.errors|length ? ' is-invalid' : ''),
                            'data-required': 'true'
                          }
                        }) }}
                        <i class="bi bi-envelope wk-field-icon"></i>
                      </div>
                      {% for error in form.email.vars.errors %}
                        <div class="wk-invalid"><i class="bi bi-exclamation-circle-fill"></i><span>{{ error.message }}</span></div>
                      {% endfor %}
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="wk-field">
                      <div class="wk-label">
                        <label for="{{ form.telephone.vars.id }}">{{ form.telephone.vars.label }}</label>
                        <span class="wk-required"><i class="bi bi-asterisk"></i> Obligatoire</span>
                      </div>
                      <div class="wk-input-wrap">
                        {{ form_widget(form.telephone, {
                          attr: {
                            class: 'form-control' ~ (form.telephone.vars.errors|length ? ' is-invalid' : ''),
                            'data-required': 'true'
                          }
                        }) }}
                        <i class="bi bi-telephone wk-field-icon"></i>
                      </div>
                      <div class="wk-help">
                        Exemple : 0606060606 sera automatiquement converti en +33606060606.
                      </div>
                      {% for error in form.telephone.vars.errors %}
                        <div class="wk-invalid"><i class="bi bi-exclamation-circle-fill"></i><span>{{ error.message }}</span></div>
                      {% endfor %}
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="wk-field">
                      <div class="wk-label">
                        <label for="{{ form.siret.vars.id }}">{{ form.siret.vars.label }}</label>
                      </div>
                      <div class="wk-input-wrap">
                        {{ form_widget(form.siret, {
                          attr: {
                            class: 'form-control' ~ (form.siret.vars.errors|length ? ' is-invalid' : '')
                          }
                        }) }}
                        <i class="bi bi-hash wk-field-icon"></i>
                      </div>
                      <div class="wk-help">
                        Optionnel. S’il est renseigné, il doit contenir exactement 14 chiffres.
                      </div>
                      {% for error in form.siret.vars.errors %}
                        <div class="wk-invalid"><i class="bi bi-exclamation-circle-fill"></i><span>{{ error.message }}</span></div>
                      {% endfor %}
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="wk-field">
                      <div class="wk-label">
                        <label for="{{ form.ville.vars.id }}">{{ form.ville.vars.label }}</label>
                        <span class="wk-required"><i class="bi bi-asterisk"></i> Obligatoire</span>
                      </div>
                      <div class="wk-input-wrap">
                        {{ form_widget(form.ville, {
                          attr: {
                            class: 'form-control' ~ (form.ville.vars.errors|length ? ' is-invalid' : ''),
                            'data-required': 'true'
                          }
                        }) }}
                        <i class="bi bi-geo-alt wk-field-icon"></i>
                      </div>
                      {% for error in form.ville.vars.errors %}
                        <div class="wk-invalid"><i class="bi bi-exclamation-circle-fill"></i><span>{{ error.message }}</span></div>
                      {% endfor %}
                    </div>
                  </div>

                </div>
              </div>

              <div class="wk-form-card mt-4">
                <div class="row">
                  <div class="col-12 col-lg-8">
                    {{ form_label(form.referralCode, 'Code apporteur d’affaires (facultatif)', {label_attr: {class: 'form-label'}}) }}
                    <div class="input-group has-validation">
                      <span class="input-group-text" aria-hidden="true"><i class="bi bi-person-badge"></i></span>
                      {{ form_widget(form.referralCode, {attr: {
                        class: 'form-control' ~ (form.referralCode.vars.errors|length ? ' is-invalid' : ''),
                        'aria-describedby': form.referralCode.vars.id ~ '_help' ~ (form.referralCode.vars.errors|length ? ' ' ~ form.referralCode.vars.id ~ '_errors' : ''),
                        'aria-invalid': form.referralCode.vars.errors|length ? 'true' : 'false'
                      }}) }}
                      {% if form.referralCode.vars.errors|length %}
                        <div class="invalid-feedback" id="{{ form.referralCode.vars.id }}_errors">
                          {% for error in form.referralCode.vars.errors %}{{ error.message }}{% if not loop.last %}<br>{% endif %}{% endfor %}
                        </div>
                      {% endif %}
                    </div>
                    <div class="form-text wk-help" id="{{ form.referralCode.vars.id }}_help">
                      Un partenaire vous a recommandé WikiFormation ? Saisissez son code pour lui rattacher votre inscription. Sinon, laissez ce champ vide.
                    </div>
                  </div>
                </div>
              </div>
              <button class="btn btn-primary btn-lg mt-4 w-100 wk-cta" id="submitBtn" type="submit">
                Créer mon espace et démarrer mes {{ trialDays }} jours d’essai <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
              </button>

              <div class="wk-footnote small mt-3">
                En continuant, vous acceptez la politique de confidentialité.
              </div>

            {{ form_end(form) }}
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<script>
(function () {
  // ============================================================
  // 1) Monthly plans
  // ============================================================
  const form = document.getElementById('onboardingForm');
  const planInput = document.getElementById('{{ form.planCode.vars.id }}');
  const intervalInput = document.getElementById('{{ form.interval.vars.id }}');
  const planButtons = Array.from(document.querySelectorAll('#planGrid .wk-plan'));
  const submitBtn = document.getElementById('submitBtn');

  function parseIntSafe(v){
    const n = parseInt((v ?? '').toString(), 10);
    return Number.isFinite(n) ? n : 0;
  }

  function formatEURFromCents(cents, { maximumFractionDigits = 0 } = {}) {
    const n = parseIntSafe(cents);
    if (!n || n <= 0) return 'Sur devis';
    const value = n / 100;
    return value.toLocaleString('fr-FR', {
      style: 'currency',
      currency: 'EUR',
      maximumFractionDigits
    });
  }

  function refreshPrices() {
    planButtons.forEach(btn => {
      const amount = btn.querySelector('[data-price]');
      if (amount) amount.textContent = formatEURFromCents(btn.dataset.month);
    });
  }

  function selectPlan(btn) {
    planButtons.forEach(b => {
      const selected = b === btn;
      b.classList.toggle('is-selected', selected);
      b.setAttribute('aria-pressed', String(selected));
    });
    if (planInput) planInput.value = btn.dataset.plan || '';
  }

  if (intervalInput) intervalInput.value = 'month';

  planButtons.forEach(btn => {
    btn.addEventListener('click', () => selectPlan(btn));
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectPlan(btn);
      }
    });
  });

  refreshPrices();

  if (planInput?.value) {
    const found = planButtons.find(b => (b.dataset.plan || '').trim().toUpperCase() === planInput.value.trim().toUpperCase());
    if (found) selectPlan(found);
  }

  // ============================================================
  // 2) Logo upload (drop + preview)
  // ============================================================
  const logoInput = document.getElementById('{{ form.logoFile.vars.id }}');
  const drop = document.getElementById('logoDrop');
  const pickBtn = document.getElementById('logoPickBtn');
  const removeBtn = document.getElementById('logoRemoveBtn');
  const preview = document.getElementById('logoPreview');
  const fileName = document.getElementById('logoFileName');

  function renderLogo(file){
    if (!preview) return;

    if (!file) {
      preview.innerHTML = '<span class="text-muted small" id="logoEmpty">SVG / PNG</span>';
      if (fileName) fileName.textContent = '';
      removeBtn?.classList.add('d-none');
      return;
    }

    if (fileName) fileName.textContent = file.name;
    removeBtn?.classList.remove('d-none');

    const url = URL.createObjectURL(file);
    preview.innerHTML = `<img alt="Logo" src="${url}">`;
    setTimeout(() => URL.revokeObjectURL(url), 2000);
  }

  function setFileFromDrop(file){
    if (!logoInput) return;
    const dt = new DataTransfer();
    dt.items.add(file);
    logoInput.files = dt.files;
    renderLogo(file);
  }

  pickBtn?.addEventListener('click', () => logoInput?.click());

  drop?.addEventListener('click', (e) => {
    const isButton = e.target.closest('button');
    if (!isButton) logoInput?.click();
  });

  logoInput?.addEventListener('change', () => {
    const f = logoInput.files && logoInput.files[0] ? logoInput.files[0] : null;
    renderLogo(f);
  });

  removeBtn?.addEventListener('click', () => {
    if (logoInput) logoInput.value = '';
    renderLogo(null);
  });

  ['dragenter','dragover'].forEach(evt => {
    drop?.addEventListener(evt, (e) => {
      e.preventDefault();
      e.stopPropagation();
      drop.classList.add('is-dragover');
    });
  });

  ['dragleave','drop'].forEach(evt => {
    drop?.addEventListener(evt, (e) => {
      e.preventDefault();
      e.stopPropagation();
      drop.classList.remove('is-dragover');
    });
  });

  drop?.addEventListener('drop', (e) => {
    const files = e.dataTransfer?.files;
    if (!files || !files.length) return;
    const file = files[0];
    if (!file.type.startsWith('image/')) return;
    setFileFromDrop(file);
  });

  // ============================================================
  // 3) Couleurs (TextType) : picker + hex + chip
  //    - data-color-bind + data-select-id = ID de l'input Symfony
  // ============================================================
  function normalizeHex(v){
    v = (v || '').trim();
    if (!v) return null;
    if (v[0] !== '#') v = '#' + v;
    if (!/^#[0-9a-fA-F]{6}$/.test(v)) return null;
    return v.toLowerCase();
  }

  function syncColorRow(row){
    const inputId = row.getAttribute('data-select-id'); // on garde ton attribut
    const input = inputId ? document.getElementById(inputId) : null;

    const picker = row.querySelector('[data-picker]');
    const hexInput = row.querySelector('[data-hex]');
    const chip = row.querySelector('[data-chip]');

    if (!input) return;

    function setDisabledState(disabled){
      row.style.opacity = disabled ? '.65' : '1';
    }

    function applyHex(hex, {fromInput=false} = {}){
      if (!hex) {
        // vide => "automatique"
        setDisabledState(true);
        if (chip) chip.style.background = '#ffffff';
        if (hexInput && document.activeElement !== hexInput) hexInput.value = '';
        return;
      }

      setDisabledState(false);
      if (chip) chip.style.background = hex;
      if (picker) picker.value = hex;

      // ne pas écraser en live si l’utilisateur tape encore des caractères non valides
      if (hexInput && document.activeElement !== hexInput) {
        hexInput.value = hex.toUpperCase();
      }

      if (!fromInput) {
        input.value = hex.toUpperCase();
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    // init depuis l'input Symfony (TextType)
    const current = normalizeHex(input.value);
    applyHex(current, {fromInput:true});

    // input Symfony -> UI (cas: back validation, setData, etc.)
    input.addEventListener('input', () => {
      const v = normalizeHex(input.value);
      applyHex(v, {fromInput:true});
    });

    // picker -> input + UI
    picker?.addEventListener('input', () => {
      const hex = normalizeHex(picker.value);
      applyHex(hex);
    });

    // saisie hex -> (quand valide) input + UI
    hexInput?.addEventListener('input', () => {
      const hex = normalizeHex(hexInput.value);
      if (!hex) return; // on attend que ce soit valide
      applyHex(hex);
    });

    // blur: si invalide, on revient à la valeur actuelle (ou vide)
    hexInput?.addEventListener('blur', () => {
      const typed = normalizeHex(hexInput.value);
      if (typed) return;
      const back = normalizeHex(input.value);
      applyHex(back, {fromInput:true});
    });
  }

  document.querySelectorAll('[data-color-bind]').forEach(syncColorRow);

  // ============================================================
  // 4) (Optionnel) Swatches -> cible un input TextType
  //    Si tu remets une palette, mets: data-target="ID_DU_CHAMP"
  // ============================================================
  document.querySelectorAll('.wk-palette').forEach(palette => {
    const targetId = palette.getAttribute('data-target');
    const input = targetId ? document.getElementById(targetId) : null;
    if (!input) return;

    function syncPressed(){
      const v = (normalizeHex(input.value) || '').toLowerCase();
      palette.querySelectorAll('.wk-swatch').forEach(b => {
        const c = (b.getAttribute('data-color') || '').toLowerCase();
        b.setAttribute('aria-pressed', (v && c === v) ? 'true' : 'false');
      });
    }

    palette.addEventListener('click', (e) => {
      const btn = e.target.closest('.wk-swatch');
      if (!btn) return;

      const color = normalizeHex(btn.getAttribute('data-color'));
      if (!color) return;

      input.value = color.toUpperCase();
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
      syncPressed();
    });

    input.addEventListener('input', syncPressed);
    syncPressed();
  });





    // ============================================================
  // 5) Validation premium côté front
  // ============================================================
  const requiredFields = Array.from(form.querySelectorAll('[data-required="true"]'));

  function isEmailValid(value) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test((value || '').trim());
  }

  function markInvalid(input, message) {
    input.classList.remove('is-valid');
    input.classList.add('is-invalid');

    let feedback = input.closest('.wk-field')?.querySelector('.wk-invalid.js-inline-invalid');
    if (!feedback) {
      feedback = document.createElement('div');
      feedback.className = 'wk-invalid js-inline-invalid';
      feedback.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i><span></span>';
      input.closest('.wk-field')?.appendChild(feedback);
    }

    const span = feedback.querySelector('span');
    if (span) span.textContent = message;
  }

  function clearInvalid(input) {
    input.classList.remove('is-invalid');

    const value = (input.value || '').trim();
    if (value !== '') {
      input.classList.add('is-valid');
    } else {
      input.classList.remove('is-valid');
    }

    const feedback = input.closest('.wk-field')?.querySelector('.wk-invalid.js-inline-invalid');
    if (feedback) feedback.remove();
  }

  function validateField(input) {
    const name = input.getAttribute('name') || '';
    const value = (input.value || '').trim();

    if (input.dataset.required === 'true' && value === '') {
      markInvalid(input, 'Ce champ est obligatoire.');
      return false;
    }

    if (name.includes('[email]') && value !== '' && !isEmailValid(value)) {
      markInvalid(input, 'Veuillez saisir une adresse email valide.');
      return false;
    }

    if (name.includes('[telephone]') && value !== '') {
      const digits = value.replace(/[^\d+]/g, '');
      if (digits.length < 10) {
        markInvalid(input, 'Veuillez saisir un numéro de téléphone valide.');
        return false;
      }
    }

    if (name.includes('[siret]') && value !== '') {
      const siret = value.replace(/\s+/g, '');
      if (!/^\d{14}$/.test(siret)) {
        markInvalid(input, 'Le SIRET doit contenir exactement 14 chiffres.');
        return false;
      }
    }

    clearInvalid(input);
    return true;
  }

  requiredFields.forEach(input => {
    input.addEventListener('input', () => validateField(input));
    input.addEventListener('blur', () => validateField(input));
  });

  const extraFields = [
    document.getElementById('{{ form.email.vars.id }}'),
    document.getElementById('{{ form.telephone.vars.id }}'),
    document.getElementById('{{ form.siret.vars.id }}'),
    document.getElementById('{{ form.ville.vars.id }}')
  ].filter(Boolean);

  extraFields.forEach(input => {
    input.addEventListener('input', () => validateField(input));
    input.addEventListener('blur', () => validateField(input));
  });

  form?.addEventListener('submit', (e) => {
    let ok = true;

    // validation plan
    if (planInput && !planInput.value) {
      ok = false;
      document.getElementById('planGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      planButtons[0]?.focus();
    }

    // validation champs
    const fieldsToValidate = [...new Set([...requiredFields, ...extraFields])];
    let firstInvalid = null;

    fieldsToValidate.forEach(input => {
      const valid = validateField(input);
      if (!valid && !firstInvalid) {
        firstInvalid = input;
      }
      ok = ok && valid;
    });

    if (!ok) {
      e.preventDefault();

      if (firstInvalid) {
        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => firstInvalid.focus(), 220);
      } else {
        document.getElementById('formErrorSummary')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      return;
    }

    submitBtn?.setAttribute('disabled', 'disabled');
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Création en cours...';
  });

})();
</script>
{% endblock %}
