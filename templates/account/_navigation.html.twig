<nav class="pref-nav" aria-label="Rubriques des préférences">
<div class="nav-label">Espace personnel</div>
{% for key, label in {'profil':'Mes coordonnées','securite':'Connexion et sécurité','signature':'Ma signature','services':'Services Google'} %}
<a href="{{ path('app_account_preferences', {section:key}) }}" class="{{ section == key ? 'active' : '' }}" {% if section == key %}aria-current="page"{% endif %}><i class="bi bi-{{ key == 'profil' ? 'person' : (key == 'securite' ? 'shield-lock' : 'pen') }}"></i>{{ label }}</a>
{% endfor %}
<a href="{{ path('app_account_privacy') }}" class="{{ section == 'confidentialite' ? 'active' : '' }}" {% if section == 'confidentialite' %}aria-current="page"{% endif %}><i class="bi bi-shield-check"></i>Mes données personnelles</a>
{% if entite and is_granted('ENTITE_PREFERENCE_MANAGE', entite) %}
<div class="nav-label">{{ entite.nom }}</div>
<a href="{{ path('app_administrateur_document_studio_index', {entite:entite.id}) }}" class="{{ section == 'documents' ? 'active' : '' }}"><i class="bi bi-journal-richtext"></i>Atelier de documents</a>
<a href="{{ path('app_administrateur_preferences_formateurs_contrat', {entite:entite.id}) }}" class="{{ section == 'organisme' ? 'active' : '' }}"><i class="bi bi-building"></i>Contrats et organisme</a>
<a href="{{ path('app_administrateur_preferences_formateurs_relances', {entite:entite.id}) }}" class="{{ section == 'relances' ? 'active' : '' }}"><i class="bi bi-envelope"></i>Relances formateurs</a>
<a href="{{ path('app_administrateur_preferences_formateurs_deplacements', {entite:entite.id}) }}" class="{{ section == 'deplacements' ? 'active' : '' }}"><i class="bi bi-car-front"></i>Déplacements formateurs</a>
<a href="{{ path('app_administrateur_preferences_facturation', {entite:entite.id}) }}" class="{{ section == 'facturation' ? 'active' : '' }}"><i class="bi bi-receipt"></i>Mentions de facturation</a>
<a href="{{ path('app_administrateur_einvoice', {entite:entite.id}) }}" class="{{ section == 'einvoice' ? 'active' : '' }}"><i class="bi bi-send-check"></i>Facturation électronique</a>
{% endif %}
</nav>
