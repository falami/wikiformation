<style>
.sr-survey,.sr-rating{--sr-ink:var(--theme-color-principal,#203647);--sr-accent:var(--theme-color-secondaire,#d9b257);--sr-line:color-mix(in srgb,var(--sr-ink) 13%,white);--sr-tint:color-mix(in srgb,var(--sr-accent) 12%,white);color:var(--sr-ink)}
.sr-survey{max-width:1120px;margin:28px auto 65px;padding:0 24px;font-size:15px;line-height:1.6}.sr-survey *,.sr-rating *{box-sizing:border-box}.sr-survey .sr-back{display:inline-flex;gap:9px;align-items:center;color:var(--sr-ink);font-size:12px;font-weight:650;text-decoration:none;margin-bottom:18px}.sr-survey .sr-hero{border-radius:24px;background:linear-gradient(120deg,var(--sr-ink),color-mix(in srgb,var(--sr-ink) 85%,var(--sr-accent)));color:white;padding:36px 38px;margin-bottom:22px;display:flex;justify-content:space-between;gap:24px;align-items:center;position:relative;overflow:hidden}.sr-hero::after{content:'';position:absolute;right:-70px;top:-130px;width:300px;height:300px;border:1px solid #ffffff15;border-radius:50%;pointer-events:none}.sr-survey h1{font-size:clamp(25px,2.7vw,36px);letter-spacing:-1px;line-height:1.2;margin:12px 0 16px;font-weight:750}.sr-survey .sr-eyebrow{font-size:10px;letter-spacing:2px;text-transform:uppercase;font-weight:750;color:var(--sr-accent)}.sr-hero p{color:#e3e8ed;max-width:650px;font-size:14px;margin:0}.sr-hero .sr-hero-symbol{flex-shrink:0;width:84px;height:84px;display:grid;place-items:center;border:1px solid #ffffff25;border-radius:22px;background:#ffffff08;color:var(--sr-accent);font-size:36px}.sr-survey .sr-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:20px 0}.sr-survey .sr-meta{display:flex;gap:15px;font-size:12px;color:#647787}.sr-survey .sr-edit{border:1px solid var(--sr-line);padding:10px 16px;border-radius:10px;font-weight:650;font-size:12px;color:var(--sr-ink);text-decoration:none;background:white}.sr-edit:hover{background:var(--sr-tint)}.sr-survey .sr-notice{display:flex;gap:12px;align-items:flex-start;padding:16px 20px;background:var(--sr-tint);border:1px solid color-mix(in srgb,var(--sr-accent) 45%,white);border-radius:12px;margin-bottom:30px;font-size:12px}.sr-notice i{font-size:18px}.sr-notice strong{display:block}.sr-notice p{margin:2px 0 0;color:#596d7c}
.sr-survey .sr-chapter{background:white;border:1px solid var(--sr-line);border-radius:20px;margin:0 0 26px;box-shadow:0 8px 30px #20364705;overflow:hidden}.sr-survey .sr-chapter-head{padding:24px 28px;display:flex;align-items:center;gap:16px;border-bottom:1px solid var(--sr-line);background:linear-gradient(110deg,color-mix(in srgb,var(--sr-ink) 4%,white),white)}.sr-chapter-number{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--sr-line);background:white;border-radius:12px;font-size:13px;font-weight:750;flex-shrink:0}.sr-survey h2{font-size:19px;letter-spacing:-.4px;font-weight:700;margin:0}.sr-chapter-head small{display:block;color:#6b7c89;font-size:11px;margin-bottom:3px}.sr-survey .preview-question{padding:28px;border-bottom:1px solid var(--sr-line)}.sr-survey .preview-question:last-child{border-bottom:0}.sr-question-meta{display:flex;gap:8px;align-items:center;font-size:10px;text-transform:uppercase;letter-spacing:1.4px;color:#74838e;margin-bottom:12px}.sr-survey .form-label,.sr-survey legend{font-size:15px;line-height:1.65;font-weight:650;margin-bottom:16px;float:none}.sr-survey .form-control,.sr-survey .form-select{border-radius:12px;border-color:var(--sr-line);padding:12px 14px;background:#fbfcfd}.sr-survey textarea{min-height:110px}.sr-survey .form-check:not(:has(.sr-native)){display:inline-flex;align-items:center;gap:9px;margin:4px 10px 4px 0;border:1px solid var(--sr-line);padding:10px 15px;border-radius:10px}.sr-survey .form-check .form-check-input{margin:0;float:none}.sr-survey .form-check:has(:checked){background:var(--sr-tint);border-color:var(--sr-accent)}.sr-survey .form-text{font-size:12px;color:#687988}.sr-survey .sr-end{display:flex;align-items:center;justify-content:center;gap:8px;text-align:center;font-size:12px;color:#687988;margin-top:30px}
.sr-rating{border:0;padding:0;margin:0;min-width:0}.sr-rating legend{display:flex;flex-wrap:wrap;align-items:center;gap:12px;float:none;width:100%;font-size:15px;font-weight:650;line-height:1.6;padding:0;margin:0 0 16px}.sr-required{font-size:9px;letter-spacing:.6px;text-transform:uppercase;background:color-mix(in srgb,var(--sr-ink) 5%,white);border:1px solid var(--sr-line);padding:3px 7px;border-radius:5px;font-weight:600}.sr-rating-caption{display:flex;gap:12px;justify-content:space-between;max-width:650px;font-size:11px;color:#6a7c8a;margin-bottom:10px}.sr-rating-options{position:relative;display:flex;gap:7px;flex-wrap:wrap;padding-bottom:32px;max-width:700px}.sr-rating-choice{position:relative;display:block!important;margin:0!important;padding:0!important;cursor:pointer;width:49px;flex:0 0 49px}.sr-rating .sr-native{position:absolute!important;opacity:0!important;width:1px!important;height:1px!important;margin:0!important;pointer-events:none}.sr-rating-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:65px;border:1px solid var(--sr-line);border-radius:11px;background:#fff;transition:background .15s,border-color .15s,transform .15s}.sr-star{font-size:23px;line-height:1;color:#a8b4be}.sr-number{font-size:12px;color:var(--sr-ink);font-variant-numeric:tabular-nums}.sr-rating-zero{margin-right:5px!important}.sr-rating-zero .sr-star{font-size:20px}.sr-rating-choice:has(input:checked) .sr-rating-tile{border-color:var(--sr-ink);background:var(--sr-ink);box-shadow:0 4px 10px #20364718}.sr-rating-choice:has(input:checked) .sr-number{color:white;font-weight:750}.sr-rating-choice:has(input:checked) .sr-star{color:var(--sr-accent)}.sr-rating-choice:not(.sr-rating-zero):has(~ .sr-rating-choice input:checked) .sr-star{color:var(--sr-accent)}.sr-rating-choice:has(input:focus-visible) .sr-rating-tile{outline:3px solid var(--sr-accent);outline-offset:3px}.sr-rating-choice:has(input:disabled){cursor:default;opacity:.65}.sr-selected{display:none;position:absolute;bottom:3px;left:0;white-space:nowrap;font-size:11px;color:var(--sr-ink);font-weight:650}.sr-rating-choice:has(input:checked){position:static}.sr-rating-choice input:checked~.sr-selected{display:block}.sr-rating .invalid-feedback{display:block}.sr-rating .form-text{margin-top:0;margin-bottom:10px;font-size:12px}
@media(hover:hover){.sr-rating-choice:not(:has(input:disabled)):hover .sr-rating-tile{transform:translateY(-3px);border-color:var(--sr-accent)}.sr-rating-options:has(.sr-rating-choice:hover) .sr-rating-choice:not(.sr-rating-zero):has(~ .sr-rating-choice:hover) .sr-star,.sr-rating-choice:not(.sr-rating-zero):hover .sr-star{color:var(--sr-accent)}}
@media(max-width:767px){.sr-survey{padding:0 12px;margin-top:16px}.sr-survey .sr-hero{padding:25px;border-radius:18px}.sr-hero-symbol{display:none!important}.sr-survey .sr-chapter-head{padding:19px;gap:12px}.sr-survey .preview-question{padding:22px 18px}.sr-survey h2{font-size:17px}.sr-rating-options{gap:6px}.sr-rating-choice{width:42px;flex-basis:42px}.sr-rating-tile{min-height:59px}.sr-rating legend{font-size:14px}.sr-survey .sr-meta{gap:8px;flex-wrap:wrap}}
@media(prefers-reduced-motion:reduce){.sr-rating-tile{transition:none}}
.sr-clear{border:0;background:transparent;color:#607686;font-size:12px;padding:5px 0;margin:0 0 10px;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.sr-clear:focus-visible{outline:2px solid var(--sr-accent);outline-offset:4px;border-radius:3px}
.sr-rating-choice:has(input:disabled){opacity:1}
</style>
