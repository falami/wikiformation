{% extends 'caces/base.html.twig' %}{% block caces %}
<a class="cx-muted" href="{{ path('app_caces_index',{entite:entite.id}) }}">← Espace CACES</a><h1>Préparer une session de tests.</h1><p class="cx-muted">Un tirage au sort commun aux candidats, des testeurs clairement identifiés.</p>
<form method="post" class="cx-card" data-caces-assign><input type="hidden" name="_token" value="{{ csrf_token('caces_assign_'~entite.id) }}"><div class="cx-form-grid">
<div><label for="session">Session de formation</label><select id="session" name="session" required><option value="">Choisir une session</option>{% for s in sessions %}<option value="{{ s.id }}" {{ app.request.query.get('session') == s.id ? 'selected' : '' }}>{{ s.code }} · {{ s.formationLabel }}{% if s.dateDebut %} · {{ s.dateDebut|date('d/m/Y') }}{% endif %}</option>{% endfor %}</select></div>
<div><label for="location">Lieu du test</label><input id="location" name="location" required maxlength="255" placeholder="Centre, site client, adresse…"></div>
<div><label for="recommendation">Recommandation</label><select id="recommendation" name="recommendation">{% for rec,label in families %}<option value="{{ rec }}" {{ rec == 489 ? 'selected' : '' }}>R.{{ rec }} · {{ label }}</option>{% endfor %}</select></div><div><label for="category">Catégorie</label><select id="category" name="category" data-categories="{{ categories|json_encode|e('html_attr') }}"></select></div>
<div><label for="theoryTester">Testeur théorique</label><select id="theoryTester" name="theoryTester" required><option value="">Choisir un testeur</option>{% for id,u in trainers %}<option value="{{ id }}">{{ u.prenom }} {{ u.nom }}</option>{% endfor %}</select></div><div><label for="practiceTester">Testeur pratique</label><select id="practiceTester" name="practiceTester" required><option value="">Choisir un testeur</option>{% for id,u in trainers %}<option value="{{ id }}">{{ u.prenom }} {{ u.nom }}</option>{% endfor %}</select></div>
<div><label for="pool">Bibliothèque théorique pour le tirage au sort</label><select id="pool" name="pool"><option value="official">Grilles communes · V1 12/2024</option><option value="custom">Modèles actifs de mon organisme</option></select></div>
<div><label for="practice">Grille pratique</label><select id="practice" name="practice" required><option value="">Choisir un modèle pratique</option>{% for t in catalog|filter(t=>t.kind == 'practice' and t.status|default('active') == 'active') %}<option value="{{ t.key }}" data-rec="{{ t.recommendation }}" data-category="{{ t.category }}">{{ t.title }} · {{ t.versionLabel }}</option>{% endfor %}</select></div></div>
<div class="cx-note">Les testeurs peuvent être différents du formateur de la session. L’affectation ne vérifie pas leur habilitation CACES : l’organisme reste responsable de sélectionner des testeurs qualifiés. Tous les stagiaires inscrits, hors absents et annulés, recevront un dossier.</div><div class="cx-actions"><button class="cx-btn primary" type="submit">Tirer la grille et créer les dossiers <i class="bi bi-arrow-right"></i></button><a class="cx-btn" href="{{ path('app_caces_model',{entite:entite.id}) }}">Créer une grille pratique</a></div></form>{% endblock %}
