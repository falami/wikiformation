{% extends 'caces/base.html.twig' %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/caces-assign.css') }}?v=1">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('dist/js/caces-assign.js') }}?v=1" defer></script>{% endblock %}
{% block caces %}
<a class="cx-muted" href="{{ path('app_caces_index',{entite:entite.id}) }}">← Espace CACES</a>
<header class="ca-hero"><div><span class="cx-eyebrow">ORGANISATION DES ÉPREUVES</span><h1>Une session.<br>Plusieurs compétences.</h1><p>Une théorie commune, des parcours pratiques sur mesure.<br>Préparez les catégories et confiez chaque épreuve au bon testeur.</p></div><div class="ca-seal"><i class="bi bi-shield-check" aria-hidden="true"></i><strong>CACES®</strong><span>Un parcours · Une synthèse</span></div></header>
<form method="post" data-caces-multi data-category-map="{{ categories|json_encode|e('html_attr') }}" data-registrations="{{ registrationsBySession|json_encode|e('html_attr') }}" data-rows="{{ values.practices|default([])|json_encode|e('html_attr') }}">
<input type="hidden" name="_token" value="{{ csrf_token('caces_assign_'~entite.id) }}">
<section class="cx-card ca-section"><header><span class="ca-step">01</span><div><h2>Le cadre de la session</h2><p class="cx-muted">Les informations partagées par tous les candidats.</p></div></header><div class="cx-form-grid">
<div><label for="session">Session de formation</label><select id="session" name="session" required><option value="">Choisir une session</option>{% for s in sessions %}<option value="{{ s.id }}" {{ values.session|default('') == s.id ? 'selected' : '' }}>{{ s.code }} · {{ s.formationLabel }}{% if s.dateDebut %} · {{ s.dateDebut|date('d/m/Y') }}{% endif %}</option>{% endfor %}</select></div>
<div><label for="location">Lieu du test</label><input id="location" name="location" value="{{ values.location|default('') }}" required maxlength="255" placeholder="Centre, site client, adresse…"></div>
<div><label for="recommendation">Recommandation</label><select id="recommendation" name="recommendation" required>{% for rec,label in families %}<option value="{{ rec }}" {{ values.recommendation|default('489') == rec ? 'selected' : '' }}>R.{{ rec }} · {{ label }}</option>{% endfor %}</select></div>
<div><label for="theoryTester">Testeur théorique commun</label><select id="theoryTester" name="theoryTester" required><option value="">Choisir un testeur</option>{% for id,u in trainers %}<option value="{{ id }}" {{ values.theoryTester|default('') == id ? 'selected' : '' }}>{{ u.prenom }} {{ u.nom }}</option>{% endfor %}</select></div>
<div><label for="pool">Bibliothèque théorique</label><select id="pool" name="pool"><option value="official">Grilles communes · 5 questionnaires par recommandation</option><option value="custom" {{ values.pool|default('') == 'custom' ? 'selected' : '' }}>Modèles actifs de mon organisme</option></select></div>
<div class="ca-theory-note"><i class="bi bi-shuffle" aria-hidden="true"></i><div><strong>Un seul tirage au sort</strong><p>Le même questionnaire pour toute la session et cette recommandation. Chaque stagiaire le passe une seule fois, pour toutes ses catégories.</p></div></div>
</div></section>
<section class="cx-card ca-section"><header><span class="ca-step">02</span><div><h2>Les épreuves pratiques</h2><p class="cx-muted">Une catégorie, une grille et un testeur par épreuve. Les testeurs peuvent être différents.</p></div><span class="ca-counter" data-practice-count aria-live="polite"></span></header>
<div data-practice-rows></div><button type="button" class="cx-btn ca-add" data-add-practice><i class="bi bi-plus-circle" aria-hidden="true"></i> Ajouter une catégorie</button>
<noscript><p>Activez JavaScript pour préparer les catégories et sélectionner leurs grilles.</p></noscript>
</section>
<div class="ca-submit"><div><strong>Prêt à ouvrir le parcours ?</strong><p data-assignment-summary aria-live="polite">Configurez vos épreuves pratiques.</p></div><button class="cx-btn primary" type="submit">Créer les épreuves <i class="bi bi-arrow-right" aria-hidden="true"></i></button></div>
<p class="ca-footnote">Les absents et les inscriptions annulées sont exclus. L’organisme reste responsable de choisir des testeurs habilités.</p>
<template data-practice-template><article class="ca-practice"><div class="ca-practice-heading"><h3 data-row-title></h3><button class="ca-remove" type="button" data-remove-practice aria-label="Supprimer cette épreuve">Retirer <i class="bi bi-x-lg" aria-hidden="true"></i></button></div><div class="cx-form-grid">
<div><label data-label="category">Catégorie à évaluer</label><select data-field="category" required></select></div>
<div><label data-label="tester">Testeur pratique</label><select data-field="tester" required><option value="">Choisir un testeur</option>{% for id,u in trainers %}<option value="{{ id }}">{{ u.prenom }} {{ u.nom }}</option>{% endfor %}</select></div>
<div><label data-label="template">Grille pratique</label><select data-field="template" required><option value="">Choisir une grille</option>{% for t in catalog|filter(t=>t.kind == 'practice' and t.status|default('active') == 'active') %}<option value="{{ t.key }}" data-rec="{{ t.recommendation }}" data-category="{{ t.category }}">{{ t.title }} · {{ t.versionLabel }}</option>{% endfor %}</select><p class="cx-muted" data-empty hidden>Aucune grille publiée pour cette catégorie.</p><a data-create href="{{ path('app_caces_model',{entite:entite.id,kind:'practice'}) }}" target="_blank" rel="noopener">Créer une grille pour cette catégorie ↗</a></div>
<div><label data-label="learners">Stagiaires concernés</label><select data-field="learners" multiple></select><p class="cx-muted">Aucune sélection : tous les inscrits éligibles. Sélectionnez des noms pour personnaliser ce parcours.</p></div>
</div></article></template>
</form>
{% endblock %}
