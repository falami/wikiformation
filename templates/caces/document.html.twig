{% extends 'caces/base.html.twig' %}{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/caces-document.css') }}?v=4">{% endblock %}{% block caces %}{% set e=dossier.exam %}{% set c=dossier.certificate %}<div class="cx-print cx-document"><div class="cx-actions cx-no-print mb-4"><a class="cx-btn" href="{{ path('app_caces_index',{entite:entite.id}) }}">← Espace CACES</a><button class="cx-btn primary" data-print>Imprimer / Enregistrer en PDF</button></div>{% if type == 'echec' %}{% include 'caces/_failure_document.html.twig' %}{% else %}<section class="cx-card cx-document-sheet"><div class="cx-document-heading"><span class="cx-eyebrow">{{ entite.nom }} · CACES®</span><h1>{{ {synthese:'Feuille de synthèse',attestation:'Attestation provisoire',carte:'Carte CACES®',echec:'Attestation d’échec interne'}[type] }}</h1><p class="cx-muted">Dossier n°{{ dossier.id }} · Session {{ e.session.code }} · {{ e.location }}</p></div><div class="cx-document-identity"><span class="cx-eyebrow">Identité du candidat</span><h2>{{ c.learner|default(dossier.learner.prenom~' '~dossier.learner.nom) }}</h2><p>Né(e) le {{ dossier.profile.birthDate|default('') ? dossier.profile.birthDate|date('d/m/Y') : 'Non renseigné' }} à {{ dossier.profile.birthPlace|default('Non renseigné') }}<br>{{ dossier.profile.company|default('') }}</p><div class="cx-document-category">R.{{ e.recommendation }} <span>Catégorie {{ e.category }}</span></div></div>
{% if type in ['attestation','carte'] %}<p>Théorie et pratique réussies.</p><div class="cx-form-grid"><div><span class="cx-muted">N° CACES</span><h2>{{ c.number }}</h2></div><div><span class="cx-muted">Testeur pratique</span><h2>{{ c.practiceTester }}</h2></div><div><span class="cx-muted">Date d’obtention</span><h2>{{ c.obtainedAt|date('d/m/Y') }}</h2></div><div><span class="cx-muted">Fin de validité</span><h2>{{ c.expiresAt|date('d/m/Y') }}</h2></div></div><p class="cx-muted">Émis le {{ c.issuedAt|date('d/m/Y') }} par {{ c.issuedBy }}.</p>{% endif %}
{% if type in ['synthese','echec'] %}<p>{{ dossier.profile.address|default('') }}<br>{{ dossier.profile.phone|default('') }}</p>{% if type == 'synthese' %}<h3>Expérience de conduite</h3><p>{{ dossier.profile.drivingExperience|default('Non renseignée') }}</p><h3>Formation antérieure</h3><p>{{ dossier.profile.trainingExperience|default('Non renseignée') }}</p>{% endif %}
{% for kind,label in {theory:'Théorie',practice:'Pratique'} %}{% set result=kind == 'theory' ? dossier.theoryResult : dossier.practiceResult %}<section class="cx-document-result"><h2><span>{{ loop.index < 10 ? '0' : '' }}{{ loop.index }}</span> {{ label }}</h2><p>{{ kind == 'theory' ? e.theoryTester.prenom~' '~e.theoryTester.nom : dossier.signatures.practiceTester.name|default(e.practiceTester.prenom~' '~e.practiceTester.nom) }} · {% set date=kind == 'theory' ? dossier.submittedAt : dossier.practiceAt %}{% if kind == 'theory' and result.externalEvidence|default(null) %}Dispense sur CACES initial du {{ result.anchorAt|date('d/m/Y') }}{% else %}{{ date ? date|date('d/m/Y') : 'Non passé' }}{% endif %}</p>{% if result %}<strong class="cx-document-verdict">{{ result.score is null ? 'Dispense théorique' : result.score~'/100' }} · {{ result.passed ? 'Reçu' : 'Ajourné' }}</strong>{% if result.assessments|default([])|length > 1 %}<p>Score global : moyenne des engins, avec réussite exigée pour chacun.</p>{% for assessment in result.assessments %}<p>{{ assessment.title }} : {{ assessment.score }}/{{ assessment.max }}</p>{% endfor %}{% endif %}<table><thead><tr><th>Thème</th><th>Note</th><th>Seuil du thème</th></tr></thead><tbody>{% for t in result.themes %}<tr><td>{{ t.title }}</td><td>{{ t.score }}/{{ t.max }}</td><td>{{ t.passed ? 'Atteint' : 'Non atteint' }}</td></tr>{% endfor %}</tbody></table>{% for reason in result.reasons %}<p class="cx-document-reason">{{ reason }}</p>{% endfor %}{% endif %}</section>{% endfor %}<p class="cx-document-equipment">Engin : {{ dossier.practiceResult.equipment|default('Non renseigné') }}<br>Durée pratique : {% set duration=dossier.practiceResult.durationSeconds|default(0) %}{{ '%02d:%02d:%02d'|format(duration // 3600, (duration // 60) % 60, duration % 60) }} (hh:mm:ss).</p>{% if type == 'echec' %}<h3>Complément de formation préconisé</h3><p>{{ dossier.practiceResult.remediation|default('À compléter par le formateur') }} · {{ dossier.practiceResult.remediationHours|default(0) }} heures</p>{% endif %}{% endif %}
<div class="cx-document-signatures">{% for role,label in {theoryTester:'Testeur théorique',practiceTester:'Testeur pratique',learner:'Stagiaire'} %}{% if dossier.signatures[role]|default(null) %}<div><h3>{{ label }}</h3><p>{{ dossier.signatures[role].name }} · {{ dossier.signatures[role].at|date('d/m/Y H:i') }}</p><img class="cx-signature-output" src="{{ dossier.signatures[role].image }}" alt="Signature {{ label }}"></div>{% endif %}{% endfor %}</div><div class="cx-document-footer">{{ entite.nom }} · Dossier n°{{ dossier.id }} <span>Session {{ e.session.code }}</span></div></section>{% endif %}</div>{% endblock %}
