{% extends 'caces/base.html.twig' %}{% block caces %}{% set e=dossier.exam %}{% set c=dossier.certificate %}<div class="cx-print"><div class="cx-actions cx-no-print mb-4"><a class="cx-btn" href="{{ path('app_caces_index',{entite:entite.id}) }}">← Espace CACES</a><button class="cx-btn primary" data-print>Imprimer / Enregistrer en PDF</button></div><section class="cx-card"><span class="cx-eyebrow">{{ entite.nom }} · CACES®</span><h1>{{ {synthese:'Feuille de synthèse',attestation:'Attestation provisoire',carte:'Carte CACES®',echec:'Attestation d’échec interne'}[type] }}</h1><p class="cx-muted">Dossier n°{{ dossier.id }} · Session {{ e.session.code }} · {{ e.location }}</p><h2>{{ c.learner|default(dossier.learner.prenom~' '~dossier.learner.nom) }}</h2><p>Né(e) le {{ dossier.profile.birthDate|default('') ? dossier.profile.birthDate|date('d/m/Y') : 'Non renseigné' }} à {{ dossier.profile.birthPlace|default('Non renseigné') }}<br>{{ dossier.profile.company|default('') }}</p><h3>R.{{ e.recommendation }} · Catégorie {{ e.category }}</h3>
{% if type in ['attestation','carte'] %}<p>Théorie et pratique réussies.</p><div class="cx-form-grid"><div><span class="cx-muted">N° CACES</span><h2>{{ c.number }}</h2></div><div><span class="cx-muted">Testeur pratique</span><h2>{{ c.practiceTester }}</h2></div><div><span class="cx-muted">Date d’obtention</span><h2>{{ c.obtainedAt|date('d/m/Y') }}</h2></div><div><span class="cx-muted">Fin de validité</span><h2>{{ c.expiresAt|date('d/m/Y') }}</h2></div></div><p class="cx-muted">Émis le {{ c.issuedAt|date('d/m/Y') }} par {{ c.issuedBy }}.</p>{% endif %}
{% if type in ['synthese','echec'] %}<p>{{ dossier.profile.address|default('') }}<br>{{ dossier.profile.phone|default('') }}</p>{% if type == 'synthese' %}<h3>Expérience de conduite</h3><p>{{ dossier.profile.drivingExperience|default('Non renseignée') }}</p><h3>Formation antérieure</h3><p>{{ dossier.profile.trainingExperience|default('Non renseignée') }}</p>{% endif %}
{% for kind,label in {theory:'Théorie',practice:'Pratique'} %}{% set result=kind == 'theory' ? dossier.theoryResult : dossier.practiceResult %}<h2>{{ label }}</h2><p>{{ kind == 'theory' ? e.theoryTester.prenom~' '~e.theoryTester.nom : e.practiceTester.prenom~' '~e.practiceTester.nom }} · {% set date=kind == 'theory' ? dossier.submittedAt : dossier.practiceAt %}{% if kind == 'theory' and result.externalEvidence|default(null) %}Dispense sur CACES initial du {{ result.anchorAt|date('d/m/Y') }}{% else %}{{ date ? date|date('d/m/Y') : 'Non passé' }}{% endif %}</p>{% if result %}<strong>{{ result.score is null ? 'Dispense théorique' : result.score~'/100' }} · {{ result.passed ? 'Reçu' : 'Ajourné' }}</strong><table><thead><tr><th>Thème</th><th>Note</th><th>Acquis</th></tr></thead><tbody>{% for t in result.themes %}<tr><td>{{ t.title }}</td><td>{{ t.score }}/{{ t.max }}</td><td>{{ t.passed ? 'Oui' : 'Non' }}</td></tr>{% endfor %}</tbody></table>{% for reason in result.reasons %}<p>{{ reason }}</p>{% endfor %}{% endif %}{% endfor %}<p>Engin : {{ dossier.practiceResult.equipment|default('Non renseigné') }}<br>Durée pratique : {{ dossier.practiceResult.durationSeconds|default(0) }} secondes.</p>{% if type == 'echec' %}<h3>Complément de formation préconisé</h3><p>{{ dossier.practiceResult.remediation|default('À compléter par le formateur') }} · {{ dossier.practiceResult.remediationHours|default(0) }} heures</p>{% endif %}{% endif %}
<div class="cx-form-grid mt-4">{% for role,label in {theoryTester:'Testeur théorique',practiceTester:'Testeur pratique',learner:'Stagiaire'} %}{% if dossier.signatures[role]|default(null) %}<div><h3>{{ label }}</h3><p>{{ dossier.signatures[role].name }} · {{ dossier.signatures[role].at|date('d/m/Y H:i') }}</p><img class="cx-signature-output" src="{{ dossier.signatures[role].image }}" alt="Signature {{ label }}"></div>{% endif %}{% endfor %}</div></section></div>{% endblock %}
