{% extends 'caces/base.html.twig' %}{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/caces-dossier.css') }}?v=2">{% endblock %}{% block caces %}{% set exam=dossier.exam %}<div class="cx-dossier">
<a class="cx-muted" href="{{ path('app_caces_index',{entite:entite.id}) }}">← Suivi des candidats</a><header class="entity-hero cx-hero mt-3"><div><span class="cx-dossier-badge"><i class="bi bi-shield-check" aria-hidden="true"></i> Dossier de certification</span><span class="cx-eyebrow">{{ exam.session.code }} · R.{{ exam.recommendation }} · Catégorie {{ exam.category }}</span><h1><i class="bi bi-person-badge" aria-hidden="true"></i> {{ dossier.learner.prenom }} {{ dossier.learner.nom }}</h1><p>{{ exam.location }} · {{ exam.theorySnapshot.title }} · {{ exam.theorySnapshot.versionLabel }}</p></div><div class="cx-actions"><a class="cx-btn" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'synthese'}) }}"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Feuille de synthèse</a></div></header>
{% if sessionAttempts|length > 1 %}<section class="cx-card"><span class="cx-eyebrow">Parcours du stagiaire · Cette session</span><div class="cx-actions mt-3">{% for a in sessionAttempts %}{% if isAdmin or a.exam.practiceTester.id == app.user.id or a.exam.theoryTester.id == app.user.id %}<a class="cx-btn {{ a.id == dossier.id ? 'primary' : '' }}" href="{{ path('app_caces_show',{entite:entite.id,id:a.id}) }}" {{ a.id == dossier.id ? 'aria-current="page"' : '' }}>R.{{ a.exam.recommendation }} · {{ a.exam.category }} · {{ a.certificate ? 'Obtenue' : (a.practiceAt ? (a.practiceResult.passed ? 'Pratique réussie' : 'Ajourné') : 'À évaluer') }}</a>{% else %}<span class="cx-badge">R.{{ a.exam.recommendation }} · {{ a.exam.category }} · Autre testeur</span>{% endif %}{% endfor %}</div>{% if dossier.theorySource %}<p class="cx-muted mt-3">La théorie et la fiche candidat sont communes aux catégories de cette recommandation. Les notes et la signature pratique restent propres à chaque épreuve.</p>{% endif %}</section>{% endif %}
<div class="cx-stats"><div class="cx-stat"><small>Théorie</small><strong>{{ dossier.theoryResult ? (dossier.theoryResult.score is null ? 'Dispense' : dossier.theoryResult.score~'/100') : 'À passer' }}</strong><span>{{ exam.theoryTester.prenom }} {{ exam.theoryTester.nom }}</span></div><div class="cx-stat"><small>Pratique</small><strong>{{ dossier.practiceResult ? dossier.practiceResult.score~'/100' : 'À évaluer' }}</strong><span>{{ dossier.signatures.practiceTester.name|default(exam.practiceTester.prenom~' '~exam.practiceTester.nom) }}</span></div><div class="cx-stat"><small>Signatures</small><strong>{{ dossier.signatures|length }} / 3</strong><span>Stagiaire et testeurs</span></div><div class="cx-stat"><small>Certification</small><strong>{{ dossier.certificate ? 'Obtenue' : 'En cours' }}</strong><span>{{ dossier.certificate.number|default('Dossier à finaliser') }}</span></div></div>

{% include 'caces/_questionnaire_review.html.twig' %}
<div class="cx-form-grid cx-dossier-results">{% for kind,title in {theory:'Épreuve théorique',practice:'Épreuve pratique'} %}{% set result=kind == 'theory' ? dossier.theoryResult : dossier.practiceResult %}<section class="cx-card mt-0"><h2><i class="bi {{ kind == 'theory' ? 'bi-journal-check' : 'bi-tools' }}" aria-hidden="true"></i> {{ title }}</h2>{% if result %}<div class="cx-result-headline"><strong>{{ result.score is null ? 'Dispense' : result.score~' / 100' }}</strong><span class="cx-badge {{ result.passed ? 'success' : 'danger' }}">{{ result.passed ? 'Reçu' : 'Ajourné' }}</span></div>{% if result.assessments|default([])|length > 1 %}<p class="cx-muted">Le score global est la moyenne des engins. Chaque engin doit réussir séparément.</p>{% for assessment in result.assessments %}<div class="cx-model"><span>{{ assessment.title }}</span><strong>{{ assessment.score }}/{{ assessment.max }}</strong></div>{% endfor %}{% endif %}{% for t in result.themes %}<div class="cx-model"><span>{{ t.title }}</span><strong>{{ t.score }}/{{ t.max }}</strong></div>{% endfor %}{% for reason in result.reasons %}<p class="cx-muted mt-2">{{ reason }}</p>{% endfor %}{% if result.externalEvidence|default(null) %}<p class="cx-muted">Dispense sur certificat {{ result.externalEvidence.reference }} · {{ result.externalEvidence.issuer }} · Contrôle : {{ result.externalEvidence.checkedBy }}.</p>{% endif %}{% if result.reusedFrom|default(null) %}<p class="cx-muted">Théorie reprise du dossier n°{{ result.reusedFrom }}{{ result.extension ? ' · Extension CACES' : ' · Même session' }}.</p>{% endif %}{% else %}<p class="cx-muted">{{ kind == 'theory' ? 'Le candidat retrouve ce test dans son espace CACES.' : 'Le testeur pratique affecté peut renseigner la grille ci-dessous.' }}</p>{% endif %}</section>{% endfor %}</div>
{% if dossier.theoryResult and not dossier.signatures.theoryTester|default(null) and exam.theoryTester.id == app.user.id %}<form method="post" class="cx-card"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="theorySign"><h2>Valider le relevé théorique</h2><fieldset class="cx-remediation"><legend>Thèmes à revoir · Théorie</legend><p class="cx-help">Sélectionnez les thèmes à retravailler. Si la note globale est inférieure à 70/100, tous les thèmes peuvent être cochés. Sinon, seuls les thèmes dont le seuil n’est pas atteint sont sélectionnables.</p>{% for theme in dossier.theoryResult.themes|default([]) %}<label class="cx-remediation-choice"><input type="checkbox" name="remediationThemes[]" value="{{ loop.index0 }}" {% if theme.passed and dossier.theoryResult.score >= 70 %}disabled{% endif %}><span><strong>{{ theme.title }}</strong><small>{{ theme.score }}/{{ theme.max }} · {{ dossier.theoryResult.score < 70 ? 'Note globale inférieure à 70/100 · sélection possible' : (theme.passed ? 'Seuil atteint' : 'Seuil non atteint · sélection possible') }}</small></span></label>{% else %}<p>Aucun thème à revoir.</p>{% endfor %}</fieldset><label for="theory-remediation-duration">Durée de formation préconisée (heures)</label><input id="theory-remediation-duration" name="remediationHours" type="number" value="0" min="0" max="500" step="0.5" required aria-describedby="theory-duration-help"><p id="theory-duration-help" class="cx-help">Saisissez 7 pour 7 heures de formation complémentaire.</p>{% include 'caces/_signature.html.twig' with {signatureLabel:'du testeur théorique'} %}<button class="cx-btn primary">Signer le relevé</button></form>{% endif %}
{% if not dossier.practiceAt and exam.practiceTester.id == app.user.id %}<form method="post" class="cx-card" data-practice-save-url="{{ path('app_caces_practice_draft', {entite:entite.id,id:dossier.id}) }}" data-practice-saved="{{ dossier.practiceDraft|json_encode|e('html_attr') }}" data-practice-clock="{{ entite.id }}-{{ dossier.id }}-{{ app.user.id }}" data-practice-schema="{{ exam.practiceSnapshot.schema|json_encode|e('html_attr') }}"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="practice"><span class="cx-eyebrow">Observation sur le terrain</span><h2>{{ exam.practiceSnapshot.title }}</h2>{% if exam.practiceSnapshot.schema.reference|default(null) %}<p class="cx-muted">{% if exam.practiceSnapshot.schema.reference.note %}{{ exam.practiceSnapshot.schema.reference.note }} · {% endif %}{{ exam.practiceSnapshot.schema.reference.file }}, pages {{ exam.practiceSnapshot.schema.reference.pages|join(', ') }}.</p>{% endif %}<p class="cx-muted">Notez chaque critère observé. La validation calcule le résultat : 70/100 minimum pour chaque engin évalué séparément, au moins la moitié des points par thème (arrondie au supérieur), aucun critère à zéro et durée maximale respectée.</p><section class="cx-practice-clock" aria-label="Chronométrage du test pratique"><div><span class="cx-eyebrow">Temps de pratique</span><h3>Mesurez le temps sur le terrain</h3><p data-clock-status>Prêt à démarrer · les pauses ne sont pas comptées</p></div><output data-clock-display aria-label="Durée mesurée">00:00:00</output><div class="cx-actions"><button type="button" class="cx-btn primary" data-clock-toggle><i class="bi bi-play-fill" aria-hidden="true"></i> Démarrer le test</button><button type="button" class="cx-btn" data-clock-finish disabled>Terminer le chronométrage</button></div><small>Le chrono démarre aussi à la première note saisie. Il continue si vous quittez la page ; mettez-le en pause pour interrompre le test. Reprise possible sur ce navigateur.</small></section><div class="cx-form-grid"><div><label for="practiceDate">Date du test</label><input id="practiceDate" name="practiceDate" type="date" value="{{ 'now'|date('Y-m-d') }}" required></div><div><label for="equipment">Engin utilisé · marque et modèle</label><input id="equipment" name="equipment" maxlength="255" required></div><div><label for="durationSeconds">Durée réelle du test (secondes)</label><input data-practice-duration id="durationSeconds" name="durationSeconds" type="number" min="1" max="86400" required><small class="cx-muted">{{ exam.practiceSnapshot.schema.durationMinutes }} minutes maximum, soit {{ exam.practiceSnapshot.schema.durationMinutes*60 }} secondes. Un dépassement est éliminatoire mais n’empêche pas de saisir le test.</small></div></div>
<aside class="cx-live-score" aria-label="Notes provisoires"><div class="cx-live-score-top"><div><small>NOTE PROVISOIRE · EN DIRECT</small><strong data-live-total>0 / 100</strong></div><div><b data-live-status role="status"></b><small data-live-progress></small></div></div><details><summary>Détail par thème et conditions de réussite</summary><div data-live-details></div><p class="cx-muted">Estimation avant signature. Chaque engin doit réussir séparément ; le résultat définitif sera calculé à la validation.</p></details></aside>
{% for theme in exam.practiceSnapshot.schema.themes %}<section class="cx-editor-theme" data-score-theme="{{ loop.index0 }}">{% if theme.assessment|default(null) %}<span class="cx-eyebrow">{{ theme.assessmentLabel|default(theme.assessment) }}</span>{% endif %}<h3>{{ theme.title }}</h3><p class="cx-theme-live" data-theme-score></p>{% set themeMax=0 %}{% for criterion in theme.questions %}{% set themeMax=themeMax+criterion.points %}{% endfor %}<p class="cx-muted">{{ themeMax }} points · minimum requis : {{ (themeMax/2)|round(0,'ceil') }}</p>{% set previousPoint='' %}{% for q in theme.questions %}{% if q.instructions|default(null) and q.evaluationPoint != previousPoint %}<section class="cx-note cx-practice-instructions" aria-label="Consignes du point d’évaluation {{ q.evaluationPoint }}"><h4><i class="bi bi-clipboard-check" aria-hidden="true"></i> Consignes · point d’évaluation {{ q.evaluationPoint }}</h4><p>{{ q.instructions }}</p></section>{% set previousPoint=q.evaluationPoint %}{% endif %}<div class="cx-model"><label for="score_{{ q.id }}">{{ q.label }}{% if q.image|default(null) %}<img class="cx-source" style="max-width:320px" src="{{ q.image }}" alt="Illustration du critère">{% endif %}</label><select id="score_{{ q.id }}" name="scores[{{ q.id }}]" required style="width:95px;flex-shrink:0"><option value="">—</option>{% for point in 0..q.points %}<option value="{{ point }}">{{ point }}/{{ q.points }}</option>{% endfor %}</select></div>{% endfor %}<div class="cx-theme-score-footer cx-chapter-result" data-chapter-result data-state="pending"><div class="cx-chapter-result-top"><div><span class="cx-chapter-kicker"><i class="bi bi-bar-chart" aria-hidden="true"></i> Bilan du chapitre</span><div class="cx-chapter-number"><strong data-chapter-points>0</strong><span>/ {{ themeMax }} points</span></div></div><span class="cx-chapter-status" data-chapter-status>À compléter</span></div><div class="cx-chapter-meter" role="progressbar" aria-label="Note du chapitre {{ theme.title }}" aria-valuemin="0" aria-valuemax="{{ themeMax }}" aria-valuenow="0" data-chapter-meter><span data-chapter-fill></span><i style="left:{{ themeMax > 0 ? ((themeMax/2)|round(0,'ceil') / themeMax * 100) : 0 }}%" aria-hidden="true"></i></div><div class="cx-chapter-caption"><span>Minimum requis <strong>{{ (themeMax/2)|round(0,'ceil') }} points</strong></span><span data-chapter-message>Notation en cours</span></div></div></section>{% endfor %}
<fieldset class="cx-remediation"><legend>Thèmes à revoir</legend><p class="cx-muted">Cochez les thèmes à retravailler. Une fois toutes les notes renseignées, une note globale inférieure à 70/100 permet de sélectionner tous les thèmes. Sinon, seuls les thèmes sous le minimum ou comportant un critère à zéro sont sélectionnables.</p>{% for theme in exam.practiceSnapshot.schema.themes %}<label class="cx-remediation-choice"><input type="checkbox" name="remediationThemes[]" value="{{ loop.index0 }}" data-remediation-theme="{{ loop.index0 }}" disabled><span><strong>{% if theme.assessment|default(null) %}{{ theme.assessmentLabel|default(theme.assessment) }} · {% endif %}{{ theme.title }}</strong><small data-remediation-status>Notation à compléter</small></span></label>{% endfor %}</fieldset><label for="remediationHours">Durée préconisée (heures)</label><input id="remediationHours" name="remediationHours" type="number" min="0" max="500" value="0">{% include 'caces/_signature.html.twig' with {signatureLabel:'du testeur pratique'} %}<button class="cx-btn primary mt-3">Signer et finaliser la pratique</button></form>{% endif %}
{% if isAdmin and not dossier.startedAt and not dossier.submittedAt %}<details class="cx-card"><summary>Reprendre une théorie réussie · catégorie supplémentaire ou extension</summary><p class="cx-muted">Indiquez un dossier de ce stagiaire pour la même recommandation. Pour une autre session, le dossier source doit avoir un CACES obtenu depuis moins d’un an.</p><form method="post" class="cx-inline"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="reuse"><input type="number" min="1" name="previous" required aria-label="Numéro du dossier source" placeholder="N° du dossier source"><button class="cx-btn">Reprendre la théorie</button></form></details>{% endif %}
{% if isAdmin and not dossier.startedAt and not dossier.submittedAt %}<details class="cx-card"><summary>Extension à partir d’un CACES obtenu hors de Wikiformation</summary><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="externalReuse"><div class="cx-form-grid"><div><label>Date d’obtention du premier CACES de cette recommandation<input type="date" name="initialDate" required></label></div><div><label>Numéro du certificat initial<input name="certificateReference" required maxlength="180"></label></div><div><label>Organisme émetteur<input name="certificateIssuer" required maxlength="180"></label></div></div><label><input type="checkbox" name="evidenceChecked" value="1" required> J’ai vérifié le certificat initial, la même recommandation et le délai de dispense ; le justificatif est conservé dans le dossier du stagiaire.</label><p class="cx-muted">La date initiale détermine la fin de validité de l’extension. Le testeur théorique affecté signera la vérification de cette dispense. Aucune note théorique ne sera inventée.</p><button class="cx-btn primary">Enregistrer la dispense théorique</button></form></details>{% endif %}
<section class="cx-card"><span class="cx-eyebrow">Documents et archivage</span><h2>Finaliser le parcours</h2><div class="cx-actions"><a class="cx-btn" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'global'}) }}">Bilan global · R.{{ exam.recommendation }}</a>{% if dossier.certificate %}<a class="cx-btn primary" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'attestation'}) }}">Attestation provisoire</a><a class="cx-btn" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'carte'}) }}">Carte CACES</a><span class="cx-badge success">Valable jusqu’au {{ dossier.certificate.expiresAt|date('d/m/Y') }}</span>{% elseif isAdmin and dossier.theoryResult.passed|default(false) and dossier.practiceResult.passed|default(false) %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="certify"><button class="cx-btn primary">Émettre l’attestation et la carte</button></form><p class="cx-muted">La fiche stagiaire et les trois signatures sont nécessaires.</p>{% endif %}{% if (dossier.theoryResult and not dossier.theoryResult.passed) or (dossier.practiceResult and not dossier.practiceResult.passed) %}<a class="cx-btn" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'echec'}) }}">Attestation d’échec interne</a>{% endif %}</div><p class="cx-muted mt-3">Dossier n°{{ dossier.id }} · Créé le {{ dossier.createdAt|date('d/m/Y H:i') }} · Organisateur : {{ exam.createur.prenom }} {{ exam.createur.nom }}</p></section>{% if isAdmin %}<details class="cx-card"><summary>Affectation du testeur pratique · catégorie {{ exam.category }}</summary><p>Le testeur reçoit les grilles de tous les candidats dans son espace formateur. Les évaluations déjà signées conservent leur signataire.</p><form method="post" action="{{ path('app_caces_practice_tester',{entite:entite.id,id:exam.session.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('caces_tester_'~exam.session.id) }}"><input type="hidden" name="exam" value="{{ exam.id }}"><label for="assignedTester">Testeur pratique de cette catégorie</label><select id="assignedTester" name="practiceTester" required>{% for id,u in trainers %}<option value="{{ id }}" {{ id == exam.practiceTester.id ? 'selected' : '' }}>{{ u.prenom }} {{ u.nom }}</option>{% endfor %}</select><button class="cx-btn mt-3">Modifier pour cette catégorie</button></form></details>{% endif %}<dialog class="cx-submit-dialog cx-practice-duration-dialog" data-duration-dialog aria-labelledby="duration-title"><div class="cx-confirm-heading"><span class="cx-confirm-icon"><i class="bi bi-stopwatch" aria-hidden="true"></i></span><span class="cx-eyebrow">Validation du temps</span><h2 id="duration-title">Confirmez la durée du test</h2><p>Les pauses sont exclues. Vérifiez le temps proposé et corrigez-le si nécessaire avant de le valider.</p></div><div class="cx-confirm-body"><p data-duration-measured></p><label for="confirmed-duration">Durée retenue (minutes)</label><input id="confirmed-duration" type="number" min="0.02" max="1440" step="0.01" placeholder="45" inputmode="decimal" autocomplete="off" aria-describedby="confirmed-duration-help" required><p class="cx-muted" id="confirmed-duration-help">Saisissez 120 pour 2 heures ou 45 pour 45 minutes. La durée retenue sera utilisée pour calculer le résultat.</p></div><div class="cx-confirm-footer"><button type="button" class="cx-btn" data-duration-cancel>Revenir au test</button><button type="button" class="cx-btn primary" data-duration-accept>Valider la durée</button></div></dialog></div>{% endblock %}
