{% extends 'caces/base.html.twig' %}{% block caces %}{% set exam=dossier.exam %}
<a class="cx-muted" href="{{ path('app_caces_index',{entite:entite.id}) }}">← Suivi des candidats</a><header class="entity-hero cx-hero mt-3"><div><span class="cx-eyebrow">{{ exam.session.code }} · R.{{ exam.recommendation }} · Catégorie {{ exam.category }}</span><h1>{{ dossier.learner.prenom }} {{ dossier.learner.nom }}</h1><p>{{ exam.location }} · {{ exam.theorySnapshot.title }} · {{ exam.theorySnapshot.versionLabel }}</p></div><div class="cx-actions"><a class="cx-btn" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'synthese'}) }}">Feuille de synthèse ↗</a></div></header>
<div class="cx-stats"><div class="cx-stat"><small>Théorie</small><strong>{{ dossier.theoryResult ? (dossier.theoryResult.score is null ? 'Dispense' : dossier.theoryResult.score~'/100') : 'À passer' }}</strong><span>{{ exam.theoryTester.prenom }} {{ exam.theoryTester.nom }}</span></div><div class="cx-stat"><small>Pratique</small><strong>{{ dossier.practiceResult ? dossier.practiceResult.score~'/100' : 'À évaluer' }}</strong><span>{{ dossier.signatures.practiceTester.name|default(exam.practiceTester.prenom~' '~exam.practiceTester.nom) }}</span></div><div class="cx-stat"><small>Signatures</small><strong>{{ dossier.signatures|length }} / 3</strong><span>Stagiaire et testeurs</span></div><div class="cx-stat"><small>Certification</small><strong>{{ dossier.certificate ? 'Obtenue' : 'En cours' }}</strong><span>{{ dossier.certificate.number|default('Dossier à finaliser') }}</span></div></div>

<div class="cx-form-grid">{% for kind,title in {theory:'Épreuve théorique',practice:'Épreuve pratique'} %}{% set result=kind == 'theory' ? dossier.theoryResult : dossier.practiceResult %}<section class="cx-card mt-0"><h2>{{ title }}</h2>{% if result %}<span class="cx-badge {{ result.passed ? 'success' : 'danger' }}">{{ result.passed ? 'Reçu' : 'Ajourné' }}</span>{% if result.assessments|default([])|length > 1 %}<p class="cx-muted">Le score global est la moyenne des engins. Chaque engin doit réussir séparément.</p>{% for assessment in result.assessments %}<div class="cx-model"><span>{{ assessment.title }}</span><strong>{{ assessment.score }}/{{ assessment.max }}</strong></div>{% endfor %}{% endif %}{% for t in result.themes %}<div class="cx-model"><span>{{ t.title }}</span><strong>{{ t.score }}/{{ t.max }}</strong></div>{% endfor %}{% for reason in result.reasons %}<p class="cx-muted mt-2">{{ reason }}</p>{% endfor %}{% if result.externalEvidence|default(null) %}<p class="cx-muted">Dispense sur certificat {{ result.externalEvidence.reference }} · {{ result.externalEvidence.issuer }} · Contrôle : {{ result.externalEvidence.checkedBy }}.</p>{% endif %}{% if result.reusedFrom|default(null) %}<p class="cx-muted">Théorie reprise du dossier n°{{ result.reusedFrom }}{{ result.extension ? ' · Extension CACES' : ' · Même session' }}.</p>{% endif %}{% else %}<p class="cx-muted">{{ kind == 'theory' ? 'Le candidat retrouve ce test dans son espace CACES.' : 'Le testeur pratique affecté peut renseigner la grille ci-dessous.' }}</p>{% endif %}</section>{% endfor %}</div>
{% if dossier.theoryResult and not dossier.signatures.theoryTester|default(null) and exam.theoryTester.id == app.user.id %}<form method="post" class="cx-card"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="theorySign"><h2>Valider le relevé théorique</h2>{% include 'caces/_signature.html.twig' with {signatureLabel:'du testeur théorique'} %}<button class="cx-btn primary">Signer le relevé</button></form>{% endif %}
{% if not dossier.practiceAt and exam.practiceTester.id == app.user.id %}<form method="post" class="cx-card"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="practice"><span class="cx-eyebrow">Observation sur le terrain</span><h2>{{ exam.practiceSnapshot.title }}</h2>{% if exam.practiceSnapshot.schema.reference|default(null) %}<p class="cx-muted">{% if exam.practiceSnapshot.schema.reference.note %}{{ exam.practiceSnapshot.schema.reference.note }} · {% endif %}{{ exam.practiceSnapshot.schema.reference.file }}, pages {{ exam.practiceSnapshot.schema.reference.pages|join(', ') }}.</p>{% endif %}<p class="cx-muted">Notez chaque critère observé. La validation calcule le résultat : 70/100 minimum pour chaque engin évalué séparément, au moins la moitié des points par thème (arrondie au supérieur), aucun critère à zéro et durée maximale respectée.</p><div class="cx-form-grid"><div><label for="practiceDate">Date du test</label><input id="practiceDate" name="practiceDate" type="date" value="{{ 'now'|date('Y-m-d') }}" required></div><div><label for="equipment">Engin utilisé · marque et modèle</label><input id="equipment" name="equipment" maxlength="255" required></div><div><label for="durationSeconds">Durée réelle du test (secondes)</label><input id="durationSeconds" name="durationSeconds" type="number" min="1" max="86400" required><small class="cx-muted">{{ exam.practiceSnapshot.schema.durationMinutes }} minutes maximum, soit {{ exam.practiceSnapshot.schema.durationMinutes*60 }} secondes. Un dépassement est éliminatoire mais n’empêche pas de saisir le test.</small></div></div>
{% for theme in exam.practiceSnapshot.schema.themes %}<section class="cx-editor-theme">{% if theme.assessment|default(null) %}<span class="cx-eyebrow">{{ theme.assessmentLabel|default(theme.assessment) }}</span>{% endif %}<h3>{{ theme.title }}</h3>{% set themeMax=0 %}{% for criterion in theme.questions %}{% set themeMax=themeMax+criterion.points %}{% endfor %}<p class="cx-muted">{{ themeMax }} points · minimum requis : {{ (themeMax/2)|round(0,'ceil') }}</p>{% set previousPoint='' %}{% for q in theme.questions %}{% if q.instructions|default(null) and q.evaluationPoint != previousPoint %}<details class="cx-note"><summary>Consignes · point d’évaluation {{ q.evaluationPoint }}</summary><p>{{ q.instructions }}</p></details>{% set previousPoint=q.evaluationPoint %}{% endif %}<div class="cx-model"><label for="score_{{ q.id }}">{{ q.label }}{% if q.image|default(null) %}<img class="cx-source" style="max-width:320px" src="{{ q.image }}" alt="Illustration du critère">{% endif %}</label><select id="score_{{ q.id }}" name="scores[{{ q.id }}]" required style="width:95px;flex-shrink:0"><option value="">—</option>{% for point in 0..q.points %}<option value="{{ point }}">{{ point }}/{{ q.points }}</option>{% endfor %}</select></div>{% endfor %}</section>{% endfor %}
<label for="remediation">Complément de formation préconisé en cas d’échec</label><textarea id="remediation" name="remediation" maxlength="4000"></textarea><label for="remediationHours">Durée préconisée (heures)</label><input id="remediationHours" name="remediationHours" type="number" min="0" max="500" value="0">{% include 'caces/_signature.html.twig' with {signatureLabel:'du testeur pratique'} %}<button class="cx-btn primary mt-3">Signer et finaliser la pratique</button></form>{% endif %}
{% if isAdmin and not dossier.startedAt and not dossier.submittedAt %}<details class="cx-card"><summary>Reprendre une théorie réussie · catégorie supplémentaire ou extension</summary><p class="cx-muted">Indiquez un dossier de ce stagiaire pour la même recommandation. Pour une autre session, le dossier source doit avoir un CACES obtenu depuis moins d’un an.</p><form method="post" class="cx-inline"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="reuse"><input type="number" min="1" name="previous" required aria-label="Numéro du dossier source" placeholder="N° du dossier source"><button class="cx-btn">Reprendre la théorie</button></form></details>{% endif %}
{% if isAdmin and not dossier.startedAt and not dossier.submittedAt %}<details class="cx-card"><summary>Extension à partir d’un CACES obtenu hors de Wikiformation</summary><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="externalReuse"><div class="cx-form-grid"><div><label>Date d’obtention du premier CACES de cette recommandation<input type="date" name="initialDate" required></label></div><div><label>Numéro du certificat initial<input name="certificateReference" required maxlength="180"></label></div><div><label>Organisme émetteur<input name="certificateIssuer" required maxlength="180"></label></div></div><label><input type="checkbox" name="evidenceChecked" value="1" required> J’ai vérifié le certificat initial, la même recommandation et le délai de dispense ; le justificatif est conservé dans le dossier du stagiaire.</label><p class="cx-muted">La date initiale détermine la fin de validité de l’extension. Le testeur théorique affecté signera la vérification de cette dispense. Aucune note théorique ne sera inventée.</p><button class="cx-btn primary">Enregistrer la dispense théorique</button></form></details>{% endif %}
<section class="cx-card"><span class="cx-eyebrow">Documents et archivage</span><h2>Finaliser le parcours</h2><div class="cx-actions">{% if dossier.certificate %}<a class="cx-btn primary" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'attestation'}) }}">Attestation provisoire</a><a class="cx-btn" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'carte'}) }}">Carte CACES</a><span class="cx-badge success">Valable jusqu’au {{ dossier.certificate.expiresAt|date('d/m/Y') }}</span>{% elseif isAdmin and dossier.theoryResult.passed|default(false) and dossier.practiceResult.passed|default(false) %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('caces_dossier_'~dossier.id) }}"><input type="hidden" name="action" value="certify"><button class="cx-btn primary">Émettre l’attestation et la carte</button></form><p class="cx-muted">La fiche stagiaire et les trois signatures sont nécessaires.</p>{% endif %}{% if (dossier.theoryResult and not dossier.theoryResult.passed) or (dossier.practiceResult and not dossier.practiceResult.passed) %}<a class="cx-btn" href="{{ path('app_caces_document',{entite:entite.id,id:dossier.id,type:'echec'}) }}">Attestation d’échec interne</a>{% endif %}</div><p class="cx-muted mt-3">Dossier n°{{ dossier.id }} · Créé le {{ dossier.createdAt|date('d/m/Y H:i') }} · Organisateur : {{ exam.createur.prenom }} {{ exam.createur.nom }}</p></section>{% if isAdmin %}<details class="cx-card"><summary>Affectation du testeur pratique · toute la session</summary><p>Le testeur reçoit les grilles de tous les candidats dans son espace formateur. Les évaluations déjà signées conservent leur signataire.</p><form method="post" action="{{ path('app_caces_practice_tester',{entite:entite.id,id:exam.session.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('caces_tester_'~exam.session.id) }}"><label for="assignedTester">Testeur pratique de la session</label><select id="assignedTester" name="practiceTester" required>{% for id,u in trainers %}<option value="{{ id }}" {{ id == exam.practiceTester.id ? 'selected' : '' }}>{{ u.prenom }} {{ u.nom }}</option>{% endfor %}</select><button class="cx-btn mt-3">Modifier pour toute la session</button></form></details>{% endif %}{% endblock %}
