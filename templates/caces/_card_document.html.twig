{% set learner = c.learner|default(dossier.learner.prenom ~ ' ' ~ dossier.learner.nom) %}
{% set types489 = {
 '1A':'Transpalettes à conducteur porté · Préparateurs de commandes ≤ 1,20 m',
 '1B':'Gerbeurs à conducteur porté · Levée > 1,20 m',
 '2A':'Chariots à plateau porteur · Capacité ≤ 2 t',
 '2B':'Chariots tracteurs industriels · Traction ≤ 25 t',
 '3':'Chariots élévateurs frontaux · Capacité ≤ 6 t',
 '4':'Chariots élévateurs frontaux · Capacité > 6 t',
 '5':'Chariots élévateurs à mât rétractable',
 '6':'Chariots à poste de conduite élevable · Hauteur > 1,20 m',
 '7':'Conduite hors production'
} %}
<div class="cc-intro cx-no-print">
  <div><span>DOCUMENT DU TITULAIRE</span><h1>Carte CACES®</h1><p>{{ learner }} · R.{{ e.recommendation }} · {{ cardCertificates|length }} certificat(s) émis</p></div>
  <p>Deux faces à conserver ensemble.<br>Impression A4 paysage, recto-verso, retournement sur le bord court.</p>
</div>
<div class="cc-face-label cx-no-print">01 — Recto · Titulaire et organisme</div>
<section class="cc-page cc-front" aria-label="Recto de la carte CACES">
  <div class="cc-holder">
    <div><p class="cc-label">Titulaire</p><h2 class="cc-value">{{ learner }}</h2></div>
    <div class="cc-numbers"><p class="cc-label">CACES® numéro(s)</p>
      <ul>{% for a in cardCertificates %}<li><strong>{{ a.certificate.number }}</strong><span>R.{{ a.exam.recommendation }} · Catégorie {{ a.exam.category }}</span></li>{% endfor %}</ul>
    </div>
    <div class="cc-issued"><p class="cc-label">Délivré par</p><h3>{{ entite.nom }}</h3><p>{{ entite.adresse }}<br>{{ entite.codePostal }} {{ entite.ville }}</p>{% if entite.siret %}<p class="cc-small">SIRET {{ entite.siret }}</p>{% endif %}</div>
    <div class="cc-verification">Pour toute demande de vérification, contactez l’organisme émetteur en précisant le numéro du certificat.<br><strong>{{ entite.email ?: entite.telephone ?: entite.nom }}</strong></div>
  </div>
  <div class="cc-cover">
    <div class="cc-brand">
      {% if entite.logo %}<img src="{{ asset('uploads/photos/entite/logo/' ~ entite.logo) }}" alt="Logo {{ entite.nom }}">{% else %}<div class="cc-brand-symbol" aria-hidden="true">CACES<sup>®</sup></div>{% endif %}
      <h2>{{ entite.nom }}</h2>
      <p>{{ entite.adresse }}<br>{{ entite.codePostal }} {{ entite.ville }}</p>
      {% if entite.telephone %}<p>Tél. {{ entite.telephone }}</p>{% endif %}
      {% if entite.email %}<p>{{ entite.email }}</p>{% endif %}
      {% if entite.siteInternet %}<p>{{ entite.siteInternet }}</p>{% endif %}
    </div>
    <div class="cc-cover-title"><strong>CACES<sup>®</sup></strong><p>Certificat d’aptitude à la conduite en sécurité</p><span>R.{{ e.recommendation }} · {{ cardFamily }}</span></div>
    <p class="cc-small cc-copy">Document recto-verso · Toute copie doit comporter les deux faces.</p>
  </div>
</section>
<div class="cc-face-label cx-no-print">02 — Verso · Identité et catégories</div>
<section class="cc-page cc-back {{ cardCategories|length > 9 ? 'cc-many-rows' : '' }}" aria-label="Verso de la carte CACES">
  <div class="cc-identity">
    <div class="cc-photo">{% if dossier.learner.photo %}<img src="{{ asset('uploads/photos/utilisateur/' ~ dossier.learner.photo) }}" alt="Photo de {{ learner }}">{% else %}<span class="cc-photo-head"></span><span class="cc-photo-body"></span><span class="cc-photo-caption">Photo du titulaire</span>{% endif %}</div>
    <p class="cc-label">Titulaire</p><h2 class="cc-value">{{ learner }}</h2>
    <p class="cc-label">Date de naissance</p><p class="cc-value">{{ dossier.profile.birthDate|default('') ? dossier.profile.birthDate|date('d/m/Y') : 'Non renseignée' }}</p>
    {% if dossier.profile.birthPlace|default('') %}<p class="cc-small">À {{ dossier.profile.birthPlace }}</p>{% endif %}
    <p class="cc-label">Émis par</p><p class="cc-value">{{ c.issuedBy }}</p><p class="cc-small">Le {{ c.issuedAt|date('d/m/Y') }}</p>
    {% if dossier.signatures.learner|default(null) %}<div class="cc-signature"><p class="cc-label">Signature du titulaire</p><img src="{{ dossier.signatures.learner.image }}" alt="Signature du titulaire"></div>{% endif %}
  </div>
  <div class="cc-register">
    <h2>CACES® R.{{ e.recommendation }} <span>{{ cardFamily }}</span></h2>
    <table class="cc-table">
      <colgroup><col style="width:6%"><col style="width:25%"><col style="width:25%"><col style="width:25%"><col style="width:19%"></colgroup>
      <thead><tr><th scope="col">Cat.</th><th scope="col">Type</th><th scope="col">N° du CACES®</th><th scope="col">Testeur des épreuves pratiques</th><th scope="col">Obtention<br><strong>Échéance</strong></th></tr></thead>
      <tbody>
      {% for category in cardCategories %}
        {% set certificates = cardCertificates|filter(a => a.exam.category == category) %}
        {% if certificates|length %}
          {% for a in certificates %}<tr data-card-certified="{{ category }}"><th scope="row">{{ category }}</th><td class="cc-type">{{ e.recommendation == '489' ? types489[category]|default('Catégorie ' ~ category) : 'Catégorie ' ~ category }}</td><td class="cc-value">{{ a.certificate.number }}</td><td class="cc-value">{{ a.certificate.practiceTester }}</td><td class="cc-dates"><span>{{ a.certificate.obtainedAt|date('d/m/Y') }}</span><strong>{{ a.certificate.expiresAt|date('d/m/Y') }}</strong></td></tr>{% endfor %}
        {% else %}
          <tr><th scope="row">{{ category }}</th><td class="cc-type">{{ e.recommendation == '489' ? types489[category]|default('Catégorie ' ~ category) : 'Catégorie ' ~ category }}</td>{% for i in 1..3 %}<td class="cc-crossed"><span class="cc-sr-only">Non délivré dans cette session</span><svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0L100 100M100 0L0 100" fill="none" stroke="#777" stroke-width="1" vector-effect="non-scaling-stroke"/></svg></td>{% endfor %}</tr>
        {% endif %}
      {% endfor %}
      </tbody>
    </table>
    <p class="cc-register-note">Seules les catégories renseignées correspondent à un certificat émis dans cette session. Les cases barrées ne valent pas certification.</p>
  </div>
  <div class="cc-back-footer">Document recto-verso · Toute copie doit comporter les deux faces.<span>Session {{ e.session.code }} · Dossier n°{{ dossier.id }}</span></div>
</section>
