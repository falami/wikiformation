{% extends 'base_admin.html.twig' %}
{% block title %}CACES® · {{ entite.nom }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}"><link rel="stylesheet" href="{{ asset('dist/recruitment/tom-select.css') }}"><link rel="stylesheet" href="{{ asset('dist/css/caces.css') }}?v=20261111-review-3"><link rel="stylesheet" href="{{ asset('dist/vendors/flatpickr/flatpickr.min.css') }}"><link rel="stylesheet" href="{{ asset('dist/css/caces-mobile.css') }}?v=9">{% endblock %}
{% block javascripts %}{{ parent() }}<script src="{{ asset('dist/recruitment/tom-select.min.js') }}" defer></script><script src="{{ asset('dist/vendors/flatpickr/flatpickr.min.js') }}" defer></script><script src="{{ asset('dist/js/caces.js') }}?v=20261111-review-4" defer></script><script src="{{ asset('dist/js/caces-practice-draft.js') }}?v=1" defer></script><script src="{{ asset('dist/js/caces-practice-clock.js') }}?v=3" defer></script><script src="{{ asset('dist/js/caces-practice-score.js') }}?v=5" defer></script>{% endblock %}
{% block body %}<main class="cx">{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}{% if error|default(null) %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}{% for message in errors|default([]) %}<div class="alert alert-danger" role="alert">{{ message }}</div>{% endfor %}{% block caces %}{% endblock %}</main>{% endblock %}
