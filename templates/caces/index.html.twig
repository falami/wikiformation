{% extends 'caces/base.html.twig' %}
{% block caces %}
<header class="entity-hero cx-hero"><div><span class="cx-eyebrow">Wikiformation · Espace certification</span><h1>Vos CACES, de bout en bout.</h1><p>Préparez les tests, accompagnez les candidats et retrouvez les preuves de chaque parcours dans un dossier unique.</p></div>{% if isAdmin %}<div class="cx-actions"><a class="cx-btn primary" href="{{ path('app_caces_assign',{entite:entite.id}) }}"><i class="bi bi-plus-lg"></i> Organiser des tests</a></div>{% endif %}</header>
{% set passed=0 %}{% set pending=0 %}{% for a in attempts %}{% if a.certificate %}{% set passed=passed+1 %}{% endif %}{% if not a.submittedAt %}{% set pending=pending+1 %}{% endif %}{% endfor %}
<div class="cx-stats"><div class="cx-stat"><small>Parcours candidats</small><strong>{{ attempts|length }}</strong><span>Dossiers affichés</span></div><div class="cx-stat"><small>Théorie à passer</small><strong>{{ pending }}</strong><span>Tests disponibles ou en cours</span></div><div class="cx-stat"><small>CACES obtenus</small><strong>{{ passed }}</strong><span>Dossiers finalisés et signés</span></div><div class="cx-stat"><small>Bibliothèque nationale</small><strong>8 <span>recommandations</span></strong><span>40 grilles théoriques · V1 12/2024</span></div></div>
<nav class="cx-tabs"><a class="active" href="#dossiers">Suivi des candidats</a>{% if isAdmin %}<a href="#bibliotheque">Bibliothèque de tests</a><a href="{{ path('app_caces_model',{entite:entite.id}) }}">Créer un modèle</a>{% endif %}</nav>
<section class="cx-card" id="dossiers"><div class="cx-heading"><div><span class="cx-eyebrow">Pilotage des sessions</span><h2>Chaque candidat, chaque étape.</h2></div>{% if isAdmin %}<a class="cx-btn" href="{{ path('app_caces_export',{entite:entite.id}) }}"><i class="bi bi-download"></i> Exporter le registre</a>{% endif %}</div>
<form method="get" class="cx-inline"><input type="search" name="q" value="{{ search }}" placeholder="Rechercher un candidat ou une session…" aria-label="Rechercher"><button class="cx-btn">Rechercher</button></form>
<div class="cx-table-wrap"><table><thead><tr><th>Candidat / session</th><th>Certification</th><th>Théorie</th><th>Pratique</th><th>Dossier</th><th></th></tr></thead><tbody>{% for a in attempts %}<tr><td><strong>{{ a.learner.prenom }} {{ a.learner.nom }}</strong><small>{{ a.exam.session.code }}</small></td><td>R.{{ a.exam.recommendation }}<small>Catégorie {{ a.exam.category }}</small></td><td>{% if a.theoryResult %}<span class="cx-badge {{ a.theoryResult.passed ? 'success' : 'danger' }}">{{ a.theoryResult.score is null ? 'Dispense' : a.theoryResult.score~'/100' }} · {{ a.theoryResult.passed ? 'Reçu' : 'Ajourné' }}</span>{% else %}<span class="cx-badge {{ a.startedAt ? 'warning' : '' }}">{{ a.startedAt ? 'En cours' : 'À passer' }}</span>{% endif %}</td><td>{% if a.practiceResult %}<span class="cx-badge {{ a.practiceResult.passed ? 'success' : 'danger' }}">{{ a.practiceResult.score }}/100 · {{ a.practiceResult.passed ? 'Reçu' : 'Ajourné' }}</span>{% else %}<span class="cx-badge">À évaluer</span>{% endif %}</td><td><span class="cx-badge {{ a.certificate ? 'success' : '' }}">{{ a.certificate ? 'Finalisé' : 'À compléter' }}</span></td><td><a class="cx-btn" href="{{ path(a.learner.id == app.user.id and not isAdmin ? 'app_caces_theory' : 'app_caces_show',{entite:entite.id,id:a.id}) }}">{{ a.learner.id == app.user.id and not isAdmin ? 'Mon test' : 'Ouvrir' }} <i class="bi bi-arrow-up-right"></i></a></td></tr>{% else %}<tr><td colspan="6"><div class="cx-empty"><i class="bi bi-clipboard-check fs-2"></i><h3 class="mt-3">{{ search ? 'Aucun dossier ne correspond à cette recherche.' : 'Votre prochain parcours commence ici.' }}</h3><p>{{ isAdmin ? 'Affectez une recommandation à une session pour préparer les dossiers de vos stagiaires.' : 'Vos tests apparaîtront ici dès leur affectation par votre organisme.' }}</p></div></td></tr>{% endfor %}</tbody></table></div><p class="cx-muted mt-3">Les 200 dossiers les plus récents sont affichés. Le registre exporté contient tous les dossiers.</p></section>
{% if isAdmin %}<section id="bibliotheque"><div class="cx-heading"><div><span class="cx-eyebrow">Des versions traçables</span><h2>La bibliothèque CACES®</h2><p class="cx-muted">Grilles originales, corrigés protégés et modèles propres à votre organisme.</p></div><a class="cx-btn" href="{{ path('app_caces_model',{entite:entite.id}) }}"><i class="bi bi-plus-lg"></i> Créer un modèle</a></div><div class="cx-grid">{% for rec,label in families %}{% set models=catalog|filter(t=>t.recommendation == rec) %}<article class="cx-family"><span class="cx-icon"><i class="bi {{ rec == 489 ? 'bi-box-seam' : (rec == 486 ? 'bi-arrows-vertical' : 'bi-truck') }}"></i></span><span class="cx-badge float-end">{{ models|filter(t=>t.kind == 'theory')|length }} grilles théorie</span><h3>R.{{ rec }}</h3><p>{{ label }}</p><details><summary>Consulter les modèles <i class="bi bi-chevron-down float-end"></i></summary>{% for model in models %}<div class="cx-model"><div><strong>{{ model.title }}</strong><br><span class="cx-muted">{{ model.versionLabel }} · {{ model.kind == 'theory' ? 'Théorie' : 'Pratique' }}{% if model.status|default('active') == 'archived' %} · Archivé{% elseif model.status|default('active') == 'draft' %} · Brouillon{% endif %}</span></div><a href="{{ path('app_caces_model',{entite:entite.id,copy:model.key}) }}" title="Consulter et créer une nouvelle version">Ouvrir ↗</a>{% if model.key starts with 'custom-' and model.status != 'archived' and (not model.global|default(false) or is_granted('ROLE_SUPER_ADMIN')) %}<form method="post" action="{{ path('app_caces_archive',{entite:entite.id,id:model.key|replace({'custom-':''})}) }}"><input type="hidden" name="_token" value="{{ csrf_token('caces_archive_'~model.key|replace({'custom-':''})) }}"><button class="cx-btn" title="Archiver ce modèle">Archiver</button></form>{% endif %}</div>{% endfor %}</details></article>{% endfor %}</div><div class="cx-note"><strong>Une bibliothèque qui conserve votre historique.</strong> Chaque nouvelle version est indépendante. Les sessions déjà créées conservent leur grille, leur corrigé et leurs barèmes. La pratique R.489 catégorie 3 est préconfigurée ; créez les modèles des autres catégories à partir de vos procédures de test.</div></section>{% endif %}
{% endblock %}
