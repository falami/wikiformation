{% if sessionAttempts|length > 1 %}
<article class="cx-document-sheet cx-synthesis">
<header class="syn-header"><div class="syn-masthead"><strong>{{ entite.nom }}</strong><span>CACES® · Synthèse du parcours</span></div><div class="syn-title"><div><span class="syn-label">Toutes les catégories · Une session</span><h1>Feuille de synthèse</h1><p>{{ dossier.learner.prenom }} {{ dossier.learner.nom }}</p></div><div class="syn-category"><strong>{{ sessionAttempts|length }}</strong><span>catégories évaluées</span></div></div><div class="syn-session"><span>Session <strong>{{ e.session.code }}</strong></span><span>Lieu <strong>{{ e.location }}</strong></span></div></header>
<section class="syn-exam syn-overview"><h2>Résultats par catégorie</h2><table class="syn-table"><thead><tr><th>Catégorie</th><th>Théorie</th><th>Pratique / Testeur</th><th>Obtention</th></tr></thead><tbody>
{% for a in sessionAttempts %}<tr><th>R.{{ a.exam.recommendation }}<br>Cat. {{ a.exam.category }}</th><td>{{ a.theoryResult ? (a.theoryResult.score is null ? 'Dispense' : a.theoryResult.score~'/100') : 'À passer' }}</td><td>{{ a.practiceResult ? a.practiceResult.score~'/100' : 'À passer' }}<br><small>{{ a.signatures.practiceTester.name|default(a.exam.practiceTester.prenom~' '~a.exam.practiceTester.nom) }}</small></td><td>{% if a.certificate %}<strong>Obtenue</strong><br>{{ a.certificate.obtainedAt|date('d/m/Y') }}<br><small>Valable au {{ a.certificate.expiresAt|date('d/m/Y') }}<br>{{ a.certificate.number }}</small>{% elseif (a.theoryResult and not a.theoryResult.passed) or (a.practiceResult and not a.practiceResult.passed) %}Ajourné{% elseif a.theoryResult.passed|default(false) and a.practiceResult.passed|default(false) %}Épreuves réussies<br><small>Certification à émettre</small>{% else %}En cours{% endif %}</td></tr>{% endfor %}
</tbody></table><p class="syn-empty">Les relevés détaillés et les signatures de chaque catégorie figurent dans les pages suivantes. La réussite des épreuves est distinguée de l’émission du certificat.</p></section>
<footer class="syn-footer"><strong>{{ entite.nom }}</strong><span>{{ e.session.code }} · {{ dossier.learner.prenom }} {{ dossier.learner.nom }}</span></footer>
</article>
{% endif %}
{% for a in sessionAttempts %}{% include 'caces/_synthesis_category.html.twig' with {dossier:a,e:a.exam,c:a.certificate} %}{% endfor %}
