{% extends 'caces/base.html.twig' %}{% block caces %}<div class="cx-theory">
<a class="cx-muted" href="{{ path('app_caces_index',{entite:entite.id}) }}">← Mes tests</a>
{% if not test.startedAt and not test.submittedAt %}<section class="entity-hero cx-hero mt-3"><div><span class="cx-eyebrow">Votre épreuve théorique</span><h1>R.{{ test.recommendation }} · Prêt à commencer ?</h1><p>Installez-vous dans un endroit calme. Le chronomètre démarre lorsque vous lancez le test et continue si vous quittez cette page.</p></div></section><div class="cx-stats"><div class="cx-stat"><small>Questions</small><strong>100</strong><span>Une réponse A ou B par question</span></div><div class="cx-stat"><small>Temps disponible</small><strong>60 min</strong><span>Fin automatique à l’échéance</span></div><div class="cx-stat"><small>Seuil global</small><strong>70 / 100</strong><span>Minimum pour réussir</span></div><div class="cx-stat"><small>Chaque thème</small><strong>50 %</strong><span>Arrondi à l’entier supérieur</span></div></div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('caces_theory_'~test.id) }}"><input type="hidden" name="action" value="start"><button class="cx-btn primary">Commencer mon test <i class="bi bi-arrow-right"></i></button></form>
{% elseif not test.submittedAt %}
<form method="post" data-caces-exam data-deadline="{{ test.deadline }}" data-server-now="{{ test.serverNow }}"><input type="hidden" name="_token" value="{{ csrf_token('caces_theory_'~test.id) }}"><input type="hidden" name="action" value="submit">
<div class="cx-exam-header"><div><span class="cx-eyebrow">R.{{ test.recommendation }} · Test théorique</span><h2>Restez concentré, avancez à votre rythme.</h2><span class="cx-muted" data-save-status role="status">Réponses enregistrées automatiquement</span></div><div><div class="cx-timer" data-timer aria-label="Temps restant">60:00</div><small class="cx-muted">Temps restant</small></div></div><div class="cx-progress"><div data-progress style="width:0"></div></div><div class="cx-heading"><span class="cx-muted" data-count></span><span class="cx-badge">A = Vrai · B = Faux</span></div>
<details class="cx-missing-panel" data-missing-panel><summary><i class="bi bi-list-check" aria-hidden="true"></i> Questions sans réponse <span data-missing-count></span></summary><p class="cx-muted">Touchez une question pour la retrouver directement.</p><div class="cx-missing-links" data-missing-links></div></details>
{% set sourcePages=[] %}{% for theme in test.schema.themes %}{% for q in theme.questions %}{% if q.sourcePage is defined and q.sourcePage not in sourcePages %}{% set sourcePages=sourcePages|merge([q.sourcePage]) %}{% endif %}{% endfor %}{% endfor %}
{% if sourcePages %}{% for p in sourcePages %}<section tabindex="-1" data-exam-page="{{ p }}" {{ not loop.first ? 'hidden' : '' }}><div class="cx-exam-grid"><details class="cx-reference" open><summary><i class="bi bi-file-earmark-richtext" aria-hidden="true"></i> Grille et illustrations · Page {{ p }}<span>Afficher / masquer</span></summary><div class="cx-reference-body"><a class="cx-source-link" target="_blank" rel="noopener" href="{{ path('app_caces_source',{entite:entite.id,id:test.id,page:p}) }}">Agrandir la page et ses illustrations ↗</a><img class="cx-source" src="{{ path('app_caces_source',{entite:entite.id,id:test.id,page:p}) }}" alt="Grille originale R.{{ test.recommendation }}, page {{ p }} : énoncés et illustrations" loading="lazy"></div></details><div class="cx-card cx-questions mt-0">{% for theme in test.schema.themes %}{% set qs=theme.questions|filter(q=>q.sourcePage|default(0) == p) %}{% if qs %}<h3>{{ theme.title }}</h3>{% for q in qs %}{% include 'caces/_answer.html.twig' %}{% endfor %}{% endif %}{% endfor %}</div></div></section>{% endfor %}
{% else %}{% for theme in test.schema.themes %}<section class="cx-card"><h2>{{ theme.title }}</h2>{% for q in theme.questions %}{% include 'caces/_answer.html.twig' %}{% endfor %}</section>{% endfor %}{% endif %}
{% if sourcePages %}<nav class="cx-pagination" aria-label="Pages du questionnaire">{% for p in sourcePages %}<button type="button" class="cx-btn {{ loop.first ? 'active' : '' }}" data-page-target="{{ p }}">Page {{ p }}</button>{% endfor %}</nav>{% endif %}<div class="cx-actions cx-exam-actions mt-4"><button type="button" class="cx-btn" data-save-now>Enregistrer maintenant</button><button class="cx-btn primary" type="submit">Terminer et transmettre mon test</button></div></form>
<dialog class="cx-submit-dialog" data-exam-confirm aria-labelledby="cx-confirm-title" aria-describedby="cx-confirm-description">
<div class="cx-confirm-heading"><span class="cx-confirm-icon"><i class="bi bi-send-check" aria-hidden="true"></i></span><button type="button" class="cx-confirm-close" data-confirm-close aria-label="Fermer">×</button><span class="cx-eyebrow">Dernière vérification</span><h2 id="cx-confirm-title">Transmettre votre test ?</h2><p id="cx-confirm-description">Une fois transmis, vos réponses seront définitives et ne pourront plus être modifiées.</p></div>
<div class="cx-confirm-body"><div class="cx-confirm-stats"><div><strong data-confirm-answered>0</strong><span>réponses renseignées</span></div><div><strong data-confirm-missing>0</strong><span>sans réponse</span></div></div><p class="cx-confirm-notice" data-confirm-notice></p><p role="alert" data-confirm-error hidden></p><button type="button" class="cx-btn cx-review-button" data-confirm-review><i class="bi bi-search" aria-hidden="true"></i> Compléter les questions manquantes</button></div>
<div class="cx-confirm-footer"><button type="button" class="cx-btn" data-confirm-close autofocus>Continuer mon test</button><button type="button" class="cx-btn primary" data-confirm-send>Transmettre définitivement</button></div>
</dialog>
{% else %}<section class="entity-hero cx-hero mt-3"><div><span class="cx-eyebrow">Épreuve terminée</span><h1>Votre test a été enregistré.</h1><p>Vos réponses sont figées. Complétez votre fiche de synthèse pour permettre à votre organisme de finaliser votre dossier.</p></div><div class="cx-score">{{ test.result.score is null ? 'Dispense' : test.result.score~'/100' }}</div></section><div class="cx-card cx-results"><h2>Vos résultats par thème</h2><span class="cx-badge {{ test.result.passed ? 'success' : 'danger' }}">{{ test.result.passed ? 'Reçu à la théorie' : 'Ajourné à la théorie' }}</span>{% for t in test.result.themes %}<div class="cx-model"><span>{{ t.title }}</span><strong>{{ t.score }}/{{ t.max }} · minimum {{ t.threshold }}</strong></div>{% endfor %}</div>
<form method="post" class="cx-card cx-profile"><input type="hidden" name="_token" value="{{ csrf_token('caces_theory_'~test.id) }}"><input type="hidden" name="action" value="profile"><span class="cx-eyebrow">Dernière étape</span><h2>Votre fiche de synthèse</h2><p class="cx-muted">{% if test.prefilled and test.profile is not empty %}Vos informations déjà connues sont préremplies. Vérifiez vos coordonnées, votre entreprise et votre expérience pour le matériel évalué, puis signez pour valider cette fiche.{% else %}Vérifiez ou complétez vos coordonnées et votre expérience, puis signez votre fiche.{% endif %}</p><div class="cx-form-grid">{% for field,label in {birthDate:'Date de naissance',birthPlace:'Lieu de naissance',address:'Adresse postale',phone:'Téléphone',company:'Entreprise / CPF / demandeur d’emploi'} %}<div><label for="{{ field }}">{{ label }}</label><input id="{{ field }}" name="{{ field }}" type="{{ field == 'birthDate' ? 'date' : (field == 'phone' ? 'tel' : 'text') }}" value="{{ test.profile[field]|default('') }}" required></div>{% endfor %}</div><label for="drivingExperience">Avez-vous déjà conduit ce type de matériel ? Durée et situation.</label><textarea id="drivingExperience" name="drivingExperience" required>{{ test.profile.drivingExperience|default('') }}</textarea><label for="trainingExperience">Avez-vous déjà reçu une formation théorique et pratique ? Durée et situation.</label><textarea id="trainingExperience" name="trainingExperience" required>{{ test.profile.trainingExperience|default('') }}</textarea>{% include 'caces/_signature.html.twig' with {signatureLabel:'du stagiaire'} %}<button class="cx-btn primary mt-3">Signer et enregistrer ma fiche</button>{% if test.signed %}<span class="cx-badge success">Une fiche signée est déjà enregistrée</span>{% endif %}</form>{% endif %}</div>{% endblock %}
