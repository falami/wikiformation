{% extends 'caces/base.html.twig' %}{% block caces %}
<a class="cx-muted" href="{{ path('app_caces_index',{entite:entite.id}) }}">← Mes tests</a>
{% if not test.startedAt and not test.submittedAt %}<section class="entity-hero cx-hero mt-3"><div><span class="cx-eyebrow">Votre épreuve théorique</span><h1>R.{{ test.recommendation }} · Prêt à commencer ?</h1><p>Installez-vous dans un endroit calme. Le chronomètre démarre lorsque vous lancez le test et continue si vous quittez cette page.</p></div></section><div class="cx-stats"><div class="cx-stat"><small>Questions</small><strong>100</strong><span>Une réponse A ou B par question</span></div><div class="cx-stat"><small>Temps disponible</small><strong>60 min</strong><span>Fin automatique à l’échéance</span></div><div class="cx-stat"><small>Seuil global</small><strong>70 / 100</strong><span>Minimum pour réussir</span></div><div class="cx-stat"><small>Chaque thème</small><strong>50 %</strong><span>Arrondi à l’entier supérieur</span></div></div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('caces_theory_'~test.id) }}"><input type="hidden" name="action" value="start"><button class="cx-btn primary">Commencer mon test <i class="bi bi-arrow-right"></i></button></form>
{% elseif not test.submittedAt %}
<form method="post" data-caces-exam data-deadline="{{ test.deadline }}" data-server-now="{{ test.serverNow }}"><input type="hidden" name="_token" value="{{ csrf_token('caces_theory_'~test.id) }}"><input type="hidden" name="action" value="submit">
<div class="cx-exam-header"><div><span class="cx-eyebrow">R.{{ test.recommendation }} · Test théorique</span><h2>Restez concentré, avancez à votre rythme.</h2><span class="cx-muted" data-save-status role="status">Réponses enregistrées automatiquement</span></div><div><div class="cx-timer" data-timer aria-label="Temps restant">60:00</div><small class="cx-muted">Temps restant</small></div></div><div class="cx-progress"><div data-progress style="width:0"></div></div><div class="cx-heading"><span class="cx-muted" data-count></span><span class="cx-badge">A = Vrai · B = Faux</span></div>
{% set sourcePages=[] %}{% for theme in test.schema.themes %}{% for q in theme.questions %}{% if q.sourcePage is defined and q.sourcePage not in sourcePages %}{% set sourcePages=sourcePages|merge([q.sourcePage]) %}{% endif %}{% endfor %}{% endfor %}
{% if sourcePages %}<nav class="cx-pagination" aria-label="Pages du questionnaire">{% for p in sourcePages %}<button type="button" class="cx-btn {{ loop.first ? 'active' : '' }}" data-page-target="{{ p }}">Page {{ p }}</button>{% endfor %}</nav>{% for p in sourcePages %}<section data-exam-page="{{ p }}" {{ not loop.first ? 'hidden' : '' }}><div class="cx-exam-grid"><div><a class="cx-source-link" target="_blank" rel="noopener" href="{{ path('app_caces_source',{entite:entite.id,id:test.id,page:p}) }}">Agrandir la page et ses illustrations ↗</a><img class="cx-source" src="{{ path('app_caces_source',{entite:entite.id,id:test.id,page:p}) }}" alt="Grille originale R.{{ test.recommendation }}, page {{ p }} : énoncés et illustrations"></div><div class="cx-card mt-0">{% for theme in test.schema.themes %}{% set qs=theme.questions|filter(q=>q.sourcePage|default(0) == p) %}{% if qs %}<h3>{{ theme.title }}</h3>{% for q in qs %}{% include 'caces/_answer.html.twig' %}{% endfor %}{% endif %}{% endfor %}</div></div></section>{% endfor %}
{% else %}{% for theme in test.schema.themes %}<section class="cx-card"><h2>{{ theme.title }}</h2>{% for q in theme.questions %}{% include 'caces/_answer.html.twig' %}{% endfor %}</section>{% endfor %}{% endif %}
<div class="cx-actions mt-4"><button type="button" class="cx-btn" data-save-now>Enregistrer maintenant</button><button class="cx-btn primary" type="submit">Terminer et transmettre mon test</button></div></form>
{% else %}<section class="entity-hero cx-hero mt-3"><div><span class="cx-eyebrow">Épreuve terminée</span><h1>Votre test a été enregistré.</h1><p>Vos réponses sont figées. Complétez votre fiche de synthèse pour permettre à votre organisme de finaliser votre dossier.</p></div><div class="cx-score">{{ test.result.score is null ? 'Dispense' : test.result.score~'/100' }}</div></section><div class="cx-card"><span class="cx-badge {{ test.result.passed ? 'success' : 'danger' }}">{{ test.result.passed ? 'Reçu à la théorie' : 'Ajourné à la théorie' }}</span>{% for t in test.result.themes %}<div class="cx-model"><span>{{ t.title }}</span><strong>{{ t.score }}/{{ t.max }} · minimum {{ t.threshold }}</strong></div>{% endfor %}</div>
<form method="post" class="cx-card"><input type="hidden" name="_token" value="{{ csrf_token('caces_theory_'~test.id) }}"><input type="hidden" name="action" value="profile"><h2>Votre fiche de synthèse</h2><div class="cx-form-grid">{% for field,label in {birthDate:'Date de naissance',birthPlace:'Lieu de naissance',address:'Adresse postale',phone:'Téléphone',company:'Entreprise / CPF / demandeur d’emploi'} %}<div><label for="{{ field }}">{{ label }}</label><input id="{{ field }}" name="{{ field }}" type="{{ field == 'birthDate' ? 'date' : 'text' }}" value="{{ test.profile[field]|default('') }}" required></div>{% endfor %}</div><label for="drivingExperience">Avez-vous déjà conduit ce type de matériel ? Durée et situation.</label><textarea id="drivingExperience" name="drivingExperience" required>{{ test.profile.drivingExperience|default('') }}</textarea><label for="trainingExperience">Avez-vous déjà reçu une formation théorique et pratique ? Durée et situation.</label><textarea id="trainingExperience" name="trainingExperience" required>{{ test.profile.trainingExperience|default('') }}</textarea>{% include 'caces/_signature.html.twig' with {signatureLabel:'du stagiaire'} %}<button class="cx-btn primary mt-3">Signer et enregistrer ma fiche</button>{% if test.signed %}<span class="cx-badge success">Une fiche signée est déjà enregistrée</span>{% endif %}</form>{% endif %}{% endblock %}
