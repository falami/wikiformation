<div class="cx-answer"><p><strong>{{ q.sourceNumber is defined ? 'Affirmation '~q.sourceNumber : loop.index~'.' }}</strong>{% if q.printedNumber|default(q.sourceNumber|default(0)) != q.sourceNumber|default(0) %}<small class="cx-muted"> (repère {{ q.printedNumber }} sur le PDF)</small>{% endif %}{% if q.sourceNumber is not defined or not (q.label starts with 'Affirmation ') %} {{ q.label }}{% endif %}</p>{% if q.image|default(null) %}<img class="cx-source mb-2" src="{{ q.image }}" alt="Illustration de la question">{% endif %}<label><input type="radio" name="answers[{{ q.id }}]" value="A" {{ test.answers[q.id]|default('') == 'A' ? 'checked' : '' }}> A · Vrai</label><label><input type="radio" name="answers[{{ q.id }}]" value="B" {{ test.answers[q.id]|default('') == 'B' ? 'checked' : '' }}> B · Faux</label></div>
