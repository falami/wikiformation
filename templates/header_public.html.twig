{# templates/header_public.html.twig #}
{% set brand = public_branding() %}

<nav class="navbar fixed-top navbar-expand-xl navbar-dark public-navbar" style="background-color:#0f1b28; z-index:1100;">
  <div class="container">
    <a class="navbar-brand p-0 m-0"
       href="{% if brand.homeUrl %}{{ brand.homeUrl }}{% else %}{{ path('app_public') }}{% endif %}">
      <img
        class="mb-1"
        src="{{ asset(brand.logo) }}"
        alt="Logo {{ brand.name }}"
        style="max-height:44px; width:auto;"
      >
    </a>

    <a class="public-login-button" href="{{ path('app_login') }}">
      <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
      <span>{{ app.request.locale == 'en' ? 'Log in' : 'Se connecter' }}</span>
    </a>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavPublic"
            aria-controls="navbarNavPublic"
            aria-expanded="false"
            aria-label="{{ app.request.locale == 'en' ? 'Open menu' : 'Ouvrir le menu' }}">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavPublic">
      <ul class="navbar-nav ms-auto">

        <li class="nav-item">
          {% if brand.homeUrl %}
            <a class="nav-link" href="{{ brand.homeUrl }}">Accueil</a>
          {% else %}
            <a class="nav-link" href="{{ path('app_public') }}">{{ 'menu.home'|trans }}</a>
          {% endif %}
        </li>

        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_public_formation') }}">{{ 'menu.training'|trans }}</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_public_catalogue') }}">{{ 'menu.catalog'|trans }}</a>
        </li>

        {% if not brand.hasCustomHost %}
          <li class="nav-item"><a class="nav-link" href="{{ path('app_market_catalogue') }}">Cours en ligne</a></li>
          <li class="nav-item">
            <a class="nav-link" href="{{ path('app_public_pricing') }}">{{ 'menu.price'|trans }}</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ path('app_public_contact') }}">{{ 'menu.contact'|trans }}</a>
          </li>
        {% endif %}

        <li class="nav-item"><a class="nav-link" href="{{ path('app_recruitment') }}">Recrutement</a></li>
        <li class="nav-item dropdown">
          {% include '_locale_switcher.html.twig' %}
        </li>


      </ul>
    </div>
  </div>
</nav>