{% extends 'base_admin.html.twig' %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }

 
  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/dossier-portail.css') }}">
{% endblock %}
{% block body %}<div class="role-portal">{% include 'flagMessage.html.twig' %}{% if espace|default('') in ['commercial','opco'] %}<nav class="rp-section-nav rp-main-nav" aria-label="Navigation du portail"><a href="{{ path('app_portail_dashboard',{entite:entite.id,espace:espace}) }}"><i class="bi bi-grid"></i> Vue d’ensemble</a>{% for key,cfg in constant('App\\Service\\Delegation\\DossierRegistry::MODULES') %}{% if espace=='commercial' or key in constant('App\\Service\\Delegation\\DossierRegistry::PARTNER_MODULES') %}<a {{ module|default('')==key?'aria-current="page"':'' }} href="{{ path('app_portail_list',{entite:entite.id,espace:espace,module:key}) }}">{{ cfg[1] }}</a>{% endif %}{% endfor %}</nav>{% endif %}{% block portal %}{% endblock %}</div>{% endblock %}
