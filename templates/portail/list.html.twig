{% extends 'portail/layout.html.twig' %}
{% block title %}{{ config[1] }} — {{ entite.nom }}{% endblock %}

{% block portal %}
<a class="rp-back" href="{{ path('app_portail_dashboard',{entite:entite.id,espace:espace}) }}"><i class="bi bi-arrow-left"></i> Mon espace {{ espace }}</a>
<header class="rp-hero"><div><div class="rp-eyebrow">{{ entite.nom }} · Mon portefeuille</div><h1>{{ config[1] }}</h1><p>Consultez et suivez les dossiers qui vous sont attribués.</p></div>{% if canCreate %}<a class="rp-button primary" href="{{ path('app_portail_new',{entite:entite.id,espace:espace,module:module}) }}"><i class="bi bi-plus-lg"></i> Nouveau dossier</a>{% endif %}</header>
<form class="rp-panel rp-filter" method="get"><div><label for="dossier-search" class="form-label">Rechercher dans mes dossiers</label><input id="dossier-search" class="form-control" name="q" value="{{ query }}" placeholder="Nom, référence ou information du dossier…" maxlength="150"></div>{% if companies and module!='entreprises' %}<div><label class="form-label" for="company-filter">Entreprise cliente</label><select class="form-select" id="company-filter" name="company"><option value="">Tout mon portefeuille</option>{% for company in companies %}<option value="{{ company.id }}" {{ companyId==company.id?'selected':'' }}>{{ company.raisonSociale }}</option>{% endfor %}</select></div>{% endif %}<button class="rp-button primary">Rechercher</button><a class="rp-button" href="{{ path('app_portail_list',{entite:entite.id,espace:espace,module:module}) }}">Effacer</a></form>
<section class="rp-panel"><div class="d-flex justify-content-between mb-3"><h2>Mes {{ config[1]|lower }}</h2><span class="rp-badge">{{ total }} résultat(s)</span></div>{% if rows %}<div class="table-responsive"><table class="rp-table"><thead><tr><th>Dossier</th><th>Statut</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>{% for row in rows %}<tr><td><a href="{{ path('app_portail_show',{entite:entite.id,espace:espace,module:module,id:row.id}) }}">{{ row.title }}</a><div class="rp-muted">Dossier n° {{ row.id }}</div></td><td><span class="rp-badge">{{ row.status }}</span></td><td class="text-end"><a href="{{ path('app_portail_show',{entite:entite.id,espace:espace,module:module,id:row.id}) }}" aria-label="Ouvrir {{ row.title }}">Consulter <i class="bi bi-arrow-right ms-2"></i></a></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="rp-empty"><span class="rp-icon"><i class="bi bi-inbox"></i></span><h2>Aucun dossier à afficher</h2><p class="rp-muted">{{ query ? 'Essayez une autre recherche ou effacez le filtre.' : 'Les dossiers confiés par votre administrateur apparaîtront ici.' }}</p></div>{% endif %}<div class="rp-pagination">{% if page > 1 %}<a class="rp-button" href="{{ path('app_portail_list',{entite:entite.id,espace:espace,module:module,q:query,company:companyId,page:page-1}) }}">Précédent</a>{% endif %}<span class="rp-muted">Page {{ page }}</span>{% if page*25 < total %}<a class="rp-button" href="{{ path('app_portail_list',{entite:entite.id,espace:espace,module:module,q:query,company:companyId,page:page+1}) }}">Suivant</a>{% endif %}</div></section>
{% endblock %}
