{% extends 'portail/layout.html.twig' %}
{% block title %}{{ title }} — {{ entite.nom }}{% endblock %}
{% block portal %}
{% set route = {entite:entite.id,espace:espace,module:module,id:id} %}
<a class="rp-back" href="{{ path('app_portail_list',route) }}"><i class="bi bi-arrow-left"></i> {{ config[1] }}</a>
<header class="rp-hero"><div><div class="rp-eyebrow">{{ entite.nom }} · {{ config[1] }} · N° {{ id }}</div><h1>{{ title }}</h1><p>{{ module == 'entreprises' ? 'Votre espace client : projets, documents et relation commerciale réunis.' : 'Toutes les informations utiles au suivi de ce dossier.' }}</p></div><span class="rp-button"><i class="bi bi-shield-check"></i>{{ canManage ? 'Gestion du portefeuille' : 'Consultation' }}</span></header>
<div class="rp-actions">
{% if module in ['devis','factures','conventions','contrats-formateurs'] %}<a class="rp-button primary" href="{{ path('app_portail_pdf',route) }}"><i class="bi bi-file-earmark-pdf"></i> Télécharger le PDF</a>{% endif %}
{% if canManage %}
  {% if module in ['entreprises','prospects','factures','devis'] %}<a class="rp-button primary" href="{{ path('app_portail_compose',route) }}"><i class="bi bi-send"></i> {{ module=='factures' ? 'Envoyer la facture' : 'Écrire au client' }}</a>{% endif %}
  {% if module in ['entreprises','prospects'] %}<a class="rp-button" href="{{ path('app_portail_activity',route) }}"><i class="bi bi-calendar-plus"></i> Ajouter un suivi / une relance</a>{% endif %}
  {% if module=='entreprises' %}<a class="rp-button" href="{{ path('app_portail_company_learners',{entite:entite.id,espace:espace,id:id}) }}"><i class="bi bi-people"></i> Rattacher / retirer un stagiaire</a>{% endif %}
  {% if module in ['devis','conventions','contrats-formateurs'] and not editBlock %}<a class="rp-button" href="{{ path('app_portail_edit_document',route) }}"><i class="bi bi-pencil"></i> Modifier</a>{% endif %}
  {% if not deleteBlock %}<button type="button" class="rp-button danger" onclick="document.getElementById('delete-dossier').showModal()"><i class="bi bi-trash"></i> Supprimer</button>{% endif %}
{% endif %}
</div>
{% if related %}
<nav class="rp-section-nav" aria-label="Rubriques client">{% for key,items in related %}<a href="#client-{{ key }}">{{ modules[key][1] }} <span>{{ items|length }}</span></a>{% endfor %}<a href="#historique">Historique</a></nav>
<div class="rp-grid rp-client-grid">{% for key,items in related %}<section class="rp-panel" id="client-{{ key }}"><div class="rp-section-heading"><span class="rp-icon"><i class="bi bi-{{ modules[key][2] }}"></i></span><div><h2>{{ modules[key][1] }}</h2><span class="rp-muted">{{ items|length }} dossier(s)</span></div>{% if canManage %}<a class="rp-button" aria-label="Créer : {{ modules[key][1] }}" href="{{ path('app_portail_new',{entite:entite.id,espace:espace,module:key,company:id}) }}"><i class="bi bi-plus-lg"></i></a>{% endif %}</div>{% for item in items|slice(0,5) %}<a class="rp-client-row" href="{{ path('app_portail_show',{entite:entite.id,espace:espace,module:key,id:item.id}) }}"><span>{{ item.title }}</span><i class="bi bi-arrow-up-right"></i></a>{% else %}<p class="rp-muted py-3">Aucun dossier pour cette entreprise.</p>{% endfor %}{% if items|length>5 %}<a class="rp-back mt-3" href="{{ path('app_portail_list',{entite:entite.id,espace:espace,module:key,company:id}) }}">Voir les {{ items|length }} dossiers <i class="bi bi-arrow-right"></i></a>{% endif %}</section>{% endfor %}</div>
{% endif %}
<div class="rp-workspace"><section class="rp-panel"><div class="rp-eyebrow">FICHE {{ module=='entreprises' ? 'CLIENT' : 'DOSSIER' }}</div><h2 class="mt-2 mb-4">Informations essentielles</h2><dl class="rp-details">{% for label,value in details %}<div><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>{% if canManage and editBlock %}<div class="rp-notice"><i class="bi bi-lock"></i> {{ editBlock }}</div>{% endif %}</section>
<section class="rp-panel" id="historique"><div class="rp-eyebrow">RELATION COMMERCIALE</div><h2 class="mt-2 mb-4">Historique & prochaines actions</h2><div class="rp-timeline">{% for activity in activities %}<article><span class="rp-timeline-dot"></span><div class="rp-muted">{{ activity.createdAt|date('d/m/Y · H:i') }} · {{ activity.author.prenom }}</div><h3>{{ activity.title }}</h3><p>{{ activity.content|nl2br }}</p>{% if activity.dueAt %}<span class="rp-badge">{{ activity.completedAt ? 'Effectué' : 'À faire le ' ~ activity.dueAt|date('d/m/Y H:i') }}</span>{% if canManage and not activity.completedAt %}<form class="mt-3" method="post" action="{{ path('app_portail_activity_done',{entite:entite.id,espace:espace,id:activity.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('activity_done_' ~ activity.id) }}"><button class="rp-button"><i class="bi bi-check2"></i> Marquer comme effectué</button></form>{% endif %}{% endif %}</article>{% else %}<div class="rp-empty"><i class="bi bi-chat-square-text"></i><p>Les notes, relances et e-mails envoyés apparaîtront ici.</p></div>{% endfor %}</div></section></div>
{% if module == 'sessions' and canEdit and not deleteBlock and days|length %}<section class="rp-panel"><h2>Planning de la session</h2>{% for day in days %}<a class="rp-client-row" href="{{ path('app_portail_schedule_edit',{entite:entite.id,espace:espace,id:id,dayId:day.id}) }}"><span>{{ day.dateDebut|date('d/m/Y H:i') }} → {{ day.dateFin|date('H:i') }}</span><span><i class="bi bi-pencil"></i> Modifier</span></a>{% endfor %}</section>{% endif %}
{% if module == 'sessions' and canEdit %}<a class="rp-button mb-4" href="{{ path('app_portail_schedule',{entite:entite.id,espace:espace,id:id}) }}"><i class="bi bi-calendar-plus"></i> Ajouter un créneau</a>{% endif %}
{% if form %}<details class="rp-panel rp-edit-details" open><summary><i class="bi bi-pencil-square"></i> Modifier les informations</summary>{{ form_start(form) }}{{ form_errors(form) }}<div class="rp-form-grid mt-4">{% for field in form %}{% if field.vars.name != '_token' %}{{ form_row(field) }}{% endif %}{% endfor %}</div><button class="rp-button primary mt-4">Enregistrer les modifications</button>{{ form_end(form) }}</details>{% endif %}
{% if canManage and not deleteBlock %}<dialog id="delete-dossier" class="rp-dialog"><form method="post" action="{{ path('app_portail_delete',route) }}"><div class="rp-eyebrow">CONFIRMATION</div><h2>Supprimer ce dossier ?</h2><p>{{ title }}</p><p class="rp-muted">Cette action retire définitivement ce dossier. Les dossiers possédant un historique ou des documents liés sont protégés.</p><input type="hidden" name="_token" value="{{ csrf_token('portal_delete_' ~ module ~ '_' ~ id) }}"><div class="rp-actions"><button class="rp-button" type="button" onclick="this.closest('dialog').close()">Annuler</button><button class="rp-button danger" type="submit">Confirmer la suppression</button></div></form></dialog>{% elseif canManage and deleteBlock and not editBlock %}<p class="rp-muted"><i class="bi bi-info-circle"></i> {{ deleteBlock }}</p>{% endif %}
{% endblock %}
