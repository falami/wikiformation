<!doctype html><html lang="fr"><head><meta charset="utf-8"></head><body style="margin:0;background:#f3f5f8;font-family:Arial,sans-serif;color:#223242;padding:32px 12px"><main style="max-width:600px;margin:auto;background:#fff;border-radius:16px;padding:32px;border-top:5px solid #ffc107"><p style="color:#64748b">{{ entite.nom }}</p><h1 style="font-size:24px">{{ heading }}</h1><p style="line-height:1.7;white-space:pre-line">{{ message }}</p>{% if url is defined %}<p style="margin:28px 0"><a href="{{ url }}" style="background:#223242;color:white;border-radius:8px;padding:14px 22px;text-decoration:none">{{ button|default('Consulter mon dossier') }}</a></p>{% endif %}<p style="font-size:13px;color:#64748b">Une question ? Répondez à ce message pour contacter votre organisme de formation.</p></main></body></html>
