{% extends 'automation/base.html.twig' %}
{% block javascripts %}<script src="{{ asset('vendor/qrcodejs/qrcode.min.js') }}"></script>{{ parent() }}{% endblock %}
{% block body %}<div class="wf-page"><a class="wf-back" href="{{ path('app_administrateur_workflow_show',{entite:entite.id,id:workflow.id}) }}">← Retour au dossier</a><section class="wf-panel wf-empty wf-print"><span class="wf-eyebrow">{{ entite.nom }}</span><h1>Votre présence compte.</h1><h2>{{ workflow.convention.intituleFormationEffectif }}</h2>{% if workflow.session.emargementRequis %}<p>Scannez le QR code, connectez-vous à votre compte<br>puis signez votre présence pour la demi-journée.</p><div class="wf-qr"><div data-workflow-qr="{{ attendanceUrl }}" aria-label="QR code vers votre espace d’émargement"></div></div><p class="mt-4">{{ workflow.session.code }}</p><p><a href="{{ attendanceUrl }}">Ouvrir l’accès stagiaire</a></p><button type="button" class="btn btn-warning" data-workflow-print><i class="bi bi-printer me-2"></i>Imprimer la feuille d’accueil</button>{% else %}<p>Les émargements de cette session sont gérés par le donneur d’ordre.</p>{% endif %}</section></div>{% endblock %}
