<li class="cb-node" id="course-node-{{ n.id }}" data-id="{{ n.id }}" data-title="{{ n.titre }}" data-published="{{ n.isPublished ? '1' : '0' }}">
<div class="cb-node-head"><span class="cb-grip" title="Glisser pour réordonner" aria-hidden="true"><i class="bi bi-grip-vertical"></i></span><div class="cb-node-title"><span class="cb-kind">{{ n.parent ? 'Sous-chapitre' : 'Chapitre' }}</span><h2>{{ n.titre }}</h2><div class="cb-meta"><span class="cb-badge {{ n.isPublished ? 'published' : 'draft' }}">{{ n.isPublished ? 'Publié' : 'Brouillon' }}</span>{% if n.dureeMinutes %}<span><i class="bi bi-clock"></i> {{ n.dureeMinutes }} min</span>{% endif %}<span>{{ n.blocks|length }} ressource(s)</span><span>{{ n.children|length }} sous-chapitre(s)</span></div></div><div class="cb-node-controls"><button type="button" data-move="up" title="Monter" aria-label="Monter {{ n.titre }}"><i class="bi bi-arrow-up"></i></button><button type="button" data-move="down" title="Descendre" aria-label="Descendre {{ n.titre }}"><i class="bi bi-arrow-down"></i></button><button type="button" data-toggle-node aria-expanded="true" aria-controls="course-body-{{ n.id }}" aria-label="Replier ou déplier {{ n.titre }}"><i class="bi bi-chevron-down"></i></button></div></div>
<div class="cb-node-body" id="course-body-{{ n.id }}">
<div class="cb-node-actions"><a href="{{ path('app_administrateur_elearning_content_node_edit',{entite:entite.id,course:course.id,node:n.id}) }}"><i class="bi bi-pencil"></i> Modifier</a><a href="{{ path('app_administrateur_elearning_content_node_add',{entite:entite.id,course:course.id,parentId:n.id}) }}"><i class="bi bi-diagram-3"></i> Sous-chapitre</a><a class="cb-add-resource" href="{{ path('app_administrateur_elearning_content_block_add',{entite:entite.id,course:course.id,node:n.id}) }}"><i class="bi bi-plus-lg"></i> Ajouter une ressource</a></div>
{% if n.blocks|length %}<ul class="cb-blocks" data-order-kind="blocks" data-parent-id="{{ n.id }}">{% for b in n.blocks %}{% set types = {texte:['Texte','file-text'],video:['Vidéo','play-btn'],image:['Image','image'],fichier:['Document','file-earmark'],quiz:['Quiz','patch-question'],code:['Code','code-slash'],checklist:['Liste de contrôle','list-check']} %}{% set kind=types[b.type.value]|default([b.type.value,'file-earmark']) %}<li class="cb-block" data-id="{{ b.id }}"><span class="cb-grip" aria-hidden="true"><i class="bi bi-grip-vertical"></i></span><span class="cb-block-icon"><i class="bi bi-{{ kind[1] }}"></i></span><div class="cb-block-content"><strong>{{ kind[0] }}</strong>{% if b.content %}<p>{{ b.content|striptags|slice(0,160) }}</p>{% endif %}</div><div class="cb-node-controls"><button type="button" data-move="up" aria-label="Monter la ressource" title="Monter"><i class="bi bi-arrow-up"></i></button><button type="button" data-move="down" aria-label="Descendre la ressource" title="Descendre"><i class="bi bi-arrow-down"></i></button><a href="{{ path('app_administrateur_elearning_content_block_edit',{entite:entite.id,course:course.id,block:b.id}) }}" aria-label="Modifier la ressource {{ kind[0] }}" title="Modifier"><i class="bi bi-pencil"></i></a></div></li>{% endfor %}</ul>{% elseif n.children is empty %}<p class="cb-hint cb-placeholder">Ce chapitre attend sa première ressource.</p>{% endif %}
{% if n.children|length %}<ul class="cb-children" data-order-kind="nodes" data-parent-id="{{ n.id }}">{% for c in n.children %}{% include 'administrateur/elearning/content/_node_item.html.twig' with {n:c} %}{% endfor %}</ul>{% endif %}
</div></li>
