{# templates/administrateur/elearning/content/index.html.twig #}
{% extends 'base_admin.html.twig' %}

{% block title %}Contenu - {{ course.titre }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }
  </style>
<link rel="stylesheet" href="{{ asset('dist/css/course-builder.css') }}?v=1">
{% endblock %}

{% block body %}
<div class="course-builder" id="courseBuilder" data-url="{{ path('app_administrateur_elearning_content_order_siblings',{entite:entite.id,course:course.id}) }}" data-token="{{ csrf_token('course_order_' ~ course.id) }}">
<header class="cb-hero"><div><div class="cb-eyebrow">STUDIO PÉDAGOGIQUE · E-LEARNING</div><h1>{{ course.titre }}</h1><p>Composez un parcours clair, du premier chapitre au dernier exercice.</p><a class="cb-back" href="{{ path('app_administrateur_elearning_index',{entite:entite.id}) }}"><i class="bi bi-arrow-left"></i> Tous les cours</a></div><a class="btn btn-light" href="{{ path('app_administrateur_elearning_content_node_add',{entite:entite.id,course:course.id}) }}"><i class="bi bi-plus-lg"></i> Ajouter un chapitre</a></header>
{% include 'flagMessage.html.twig' %}
<div class="cb-stats"><div><span>Structure du parcours</span><strong>{{ roots|length }} <small>chapitre(s)</small></strong></div><div><span>Chapitres et sous-chapitres</span><strong id="nodeCount">—</strong></div><div><span>Ressources pédagogiques</span><strong id="blockCount">—</strong></div><div><span>À préparer</span><strong id="draftCount">—</strong></div></div>
<div class="cb-workspace"><aside class="cb-outline"><div class="cb-eyebrow">LE PARCOURS</div><h2>Plan du cours</h2><nav aria-label="Chapitres du cours">{% for n in roots %}<a href="#course-node-{{ n.id }}"><span>{{ '%02d'|format(loop.index) }}</span>{{ n.titre }}</a>{% else %}<p>Votre plan apparaîtra ici.</p>{% endfor %}</nav><p class="cb-hint">Déplacez les éléments au sein d’un même niveau. Chaque changement d’ordre est enregistré.</p></aside>
<main class="cb-main"><div class="cb-toolbar"><div><label class="visually-hidden" for="courseSearch">Rechercher dans le contenu</label><input id="courseSearch" type="search" class="form-control" placeholder="Rechercher un chapitre, une ressource…"></div><div class="cb-tools"><button type="button" data-expand="true">Tout déplier</button><button type="button" data-expand="false">Tout replier</button></div></div>
<div class="cb-status" id="courseSaveStatus" role="status" aria-live="polite">Organisation du contenu</div><p id="courseNoResults" hidden>Aucun contenu ne correspond à votre recherche.</p>
{% if roots is empty %}<div class="cb-empty"><i class="bi bi-journal-plus"></i><h2>Votre parcours commence ici.</h2><p>Créez un chapitre, puis ajoutez vos textes, vidéos et activités.</p><a class="btn btn-dark" href="{{ path('app_administrateur_elearning_content_node_add',{entite:entite.id,course:course.id}) }}">Créer le premier chapitre</a></div>{% else %}<ul class="cb-list" data-order-kind="nodes" data-parent-id="0">{% for n in roots %}{% include 'administrateur/elearning/content/_node_item.html.twig' with {n:n} %}{% endfor %}</ul>{% endif %}
</main></div></div>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script><script src="{{ asset('dist/js/course-builder.js') }}?v=1"></script>
{% endblock %}
