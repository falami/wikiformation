<style>
.session-planning{--ink:#203746;--muted:#718599;--line:#e0e8ef;--card:#fff;--card2:#f7f9fc;color:var(--ink);padding-bottom:24px}
.session-planning .planning-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:30px 32px;margin-bottom:22px;border-radius:22px;border-top:3px solid #c8a456;background:linear-gradient(115deg,#172e3d,#284954);color:#fff}
.session-planning .planning-eyebrow{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#e6ca87;margin-bottom:12px}
.session-planning h1{font-size:clamp(24px,2.3vw,34px);letter-spacing:-.035em;font-weight:700;margin:0 0 10px;color:#fff}
.session-planning .planning-heading p{margin:0;color:#cbd9e1;font-size:14px}
.session-planning .planning-sync{display:flex;align-items:center;gap:9px;color:#cbd9e1;font-size:12px;white-space:nowrap}
.session-planning .filterbar{background:white;border:1px solid var(--line);border-radius:18px;margin-bottom:22px;position:relative;z-index:2}
.session-planning .filterbar__top{display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid #eef2f6}
.session-planning .filterbar__title{font-size:14px;font-weight:700}
.session-planning .filterbar__hint{font-size:12px;color:var(--muted)}
.session-planning .filterbar__body{padding:18px 20px 20px}
.session-planning .filtergrid{display:grid;grid-template-columns:1.3fr 1.3fr 1fr 1.1fr 1fr auto;gap:14px;align-items:end}
.session-planning .filter-control{min-width:0}
.session-planning .form-label{display:block;font-size:12px;font-weight:600;color:#60758a;margin-bottom:7px}
.session-planning .filterbox{border:1px solid #dce5ed;border-radius:10px;background:#f8fafc;padding:8px 10px;min-height:44px}
.session-planning .filterrow{display:flex;align-items:center;gap:9px;min-width:0}
.session-planning .filter-icon{color:#8294a5;flex:0 0 auto;font-size:16px}
.session-planning .filterbox .form-control,.session-planning .filterbox .form-select{border:0;background:transparent;box-shadow:none;padding:2px 0;font-size:13px;color:var(--ink);min-width:0}
.session-planning .filterbox:focus-within{outline:2px solid #c8a456;outline-offset:2px}
.session-planning .resetbox{min-height:44px;padding:9px 12px;border:1px solid #dce5ed;border-radius:10px;background:white;color:#536c80;font-size:12px;font-weight:600;cursor:pointer}
.session-planning .resetbox:hover{background:#f2f6fa}
.session-planning button:focus-visible{outline:3px solid #c8a456;outline-offset:3px}
.session-planning .ts-wrapper{flex:1;min-width:0}
.session-planning .ts-control{border:0!important;background:transparent!important;box-shadow:none!important;padding:2px 20px 2px 0!important;font-size:13px;color:var(--ink)}
.session-planning .ts-control .item{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.session-planning .ts-dropdown{border:1px solid var(--line);border-radius:10px;box-shadow:0 12px 30px #20374616;overflow:hidden;z-index:2500}
.session-planning .ts-dropdown .option{padding:9px 12px;font-size:13px}
.session-planning .ts-dropdown .active{background:#eef3f7;color:var(--ink)}
.session-planning .calendar-card{border:1px solid var(--line);border-radius:18px;background:white;overflow:hidden;box-shadow:0 6px 24px #20374605}
.session-planning .planning-calendar-caption{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:18px 22px;border-bottom:1px solid var(--line)}
.session-planning .planning-calendar-caption span{font-size:14px;font-weight:700;display:flex;gap:10px;align-items:center}
.session-planning .planning-calendar-caption i{color:#ac8944}
.session-planning .planning-calendar-caption small{font-size:12px;color:var(--muted)}
.session-planning #calendar{padding:0;border:0;box-shadow:none}
.session-planning .fc{--fc-border-color:#e5ebf1;--fc-today-bg-color:#fff9e9;--fc-neutral-bg-color:#f7f9fc;--fc-button-bg-color:#203746;--fc-button-border-color:#203746;font-size:13px}
.session-planning .fc .fc-header-toolbar{padding:18px 22px;margin:0;background:white;gap:14px;border-bottom:1px solid var(--line)}
.session-planning .fc .fc-toolbar-title{font-size:22px;font-weight:700;letter-spacing:-.025em;color:var(--ink);text-shadow:none}
.session-planning .fc .fc-button{background:white!important;color:#536b7e!important;border:1px solid #dce5ed!important;box-shadow:none!important;border-radius:8px!important;min-height:38px;padding:7px 12px!important;font-size:12px!important;font-weight:600!important}
.session-planning .fc .fc-button-group{gap:5px}
.session-planning .fc .fc-button-group>.fc-button{margin-left:0}
.session-planning .fc .fc-button:hover{background:#f2f6fa!important}
.session-planning .fc .fc-button.fc-button-active{background:#203746!important;color:white!important;border-color:#203746!important}
.session-planning .fc .fc-button:disabled{opacity:.45}
.session-planning .fc .fc-datagrid-header,.session-planning .fc .fc-timeline-header-row{background:#f7f9fc}
.session-planning .fc .fc-timeline-slot-cushion,.session-planning .fc .fc-col-header-cell-cushion{padding:14px 6px;color:#60758a;text-decoration:none;font-size:12px;font-weight:600}
.session-planning .fc .fc-datagrid-cell-cushion{padding:14px 12px;color:var(--ink);font-weight:500;font-size:12px}
.session-planning .fc .fc-datagrid-header .fc-datagrid-cell-cushion{font-weight:600;color:#60758a}
.session-planning .fc .fc-event{background:#2c5365!important;color:white!important;border:0!important;border-left:3px solid #d1b36d!important;border-radius:6px!important;box-shadow:0 2px 4px #2037460a;cursor:pointer}
.session-planning .fc .fc-event-main{padding:5px 8px;color:white}
.session-planning .fc .fc-event-title{font-weight:600;font-size:12px}
.session-planning .fc .fc-event:hover{filter:brightness(1.12)}
.session-planning .fc .fc-view-harness{min-height:460px}
.session-planning .modal-header{background:#203746!important;padding:22px 24px}
.session-planning .modal-content{border:1px solid var(--line);box-shadow:0 24px 70px #152c3a30}
.session-planning .modal-body{padding:24px}
@media(min-width:1800px){.session-planning .filtergrid{grid-template-columns:1.4fr 1.5fr 1fr 1.2fr 1fr auto}}
@media(max-width:1250px){.session-planning .filtergrid{grid-template-columns:repeat(3,minmax(0,1fr))}.session-planning .planning-heading{align-items:flex-start;flex-direction:column;gap:16px}.session-planning .planning-calendar-caption small{max-width:45%}}
@media(max-width:767px){.session-planning .filtergrid{grid-template-columns:repeat(2,minmax(0,1fr))}.session-planning .planning-heading{padding:24px}.session-planning .planning-calendar-caption{align-items:flex-start;flex-direction:column}.session-planning .planning-calendar-caption small{max-width:none}.session-planning .fc .fc-header-toolbar{flex-wrap:wrap;justify-content:center}.session-planning .fc .fc-toolbar-chunk:nth-child(2){order:-1;flex:0 0 100%;text-align:center}}
@media(max-width:450px){.session-planning .filtergrid{grid-template-columns:1fr}.session-planning .fc .fc-header-toolbar{padding:14px 10px}.session-planning .fc .fc-toolbar-title{font-size:20px}}
.session-planning .fc .fc-datagrid-cell-cushion{max-width:100%;box-sizing:border-box;white-space:normal}
.session-planning .fc .fc-datagrid-cell-main{white-space:normal;overflow-wrap:anywhere;text-overflow:clip}
</style>
