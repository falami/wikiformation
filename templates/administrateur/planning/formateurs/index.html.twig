{# templates/administrateur/planning/formateurs/index.html.twig #}
{% extends 'base_admin.html.twig' %}
{% block title %}Planning formateurs{% endblock %}

{# stylesheets + javascripts : identiques au planning sessions (TomSelect, Flatpickr, FullCalendar Scheduler) #}
{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

  <style>
  :root{
    --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
    --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
    --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
    --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

    /* tokens premium */
    --bg: #f6f8fb;
    --card: #ffffff;
    --card2: #fbfcfe;
    --ink: #0f2336;
    --muted: rgba(15,35,54,.58);
    --line: rgba(15,35,54,.10);
    --shadow: 0 18px 55px rgba(15,35,54,.10);
    --shadow2: 0 10px 25px rgba(15,35,54,.08);
    --radius: 20px;
    --radius-lg: 26px;
    --ring: 0 0 0 .22rem rgba(255,193,7,.18);
  }


  </style>
  <link rel="stylesheet" href="{{ asset('dist/css/trainee-planning.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/trainer-planning.css') }}?v=1">
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  {# FullCalendar Scheduler (Premium bundle) en globals #}
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar-scheduler/index.global.min.js"></script>
  {# locales : depuis @fullcalendar/core (v6) #}
  <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.20/locales/fr.global.min.js"></script>

  {# UI #}
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
{% endblock %}

{% block body %}
<div class="trainer-planning">


  {# ✅ HERO (unifié Sessions-like) #}
  <div class="hero p-3 mb-4 d-flex gap-3">
    <div class="accent"></div>

    <div class="flex-grow-1">
      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
          <h2 class="m-0 fw-bold">
            <i class="bi bi-person-workspace me-2" style="color:var(--theme-color-secondaire)"></i>
            Planning formateurs
          </h2>
          <div class="opacity-75 mt-1">Une vision claire des interventions, des sessions et des disponibilités.</div>

          <div class="d-flex flex-wrap gap-2 mt-3">
            <span class="chip"><i class="bi bi-calendar3"></i> Planning</span>
            <span class="chip"><i class="bi bi-person-workspace"></i> Formateurs × Jours</span>
            <span class="chip"><i class="bi bi-building"></i> {{ entite.nom }}</span>
            <span class="chip chip--pill"><i class="bi bi-clock-history"></i> <span id="hero-last-refresh">—</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% include 'flagMessage.html.twig' %}

  <div class="filterbar planning-filters wf-filters-theme">
    <div class="filterbar__top">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="filter-icon"><i class="bi bi-funnel"></i></div>
        <div>
          <div class="filterbar__title">Filtres</div>
          <div class="filterbar__hint">Période, formation, site, statut…</div>
        </div>
      </div>

      <div class="ms-auto d-flex gap-2 align-items-center">
        <button class="btn btn-outline-secondary btn-sm fw-semibold d-md-none"
                type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse">
          <i class="bi bi-sliders"></i> Filtres
        </button>
      </div>
    </div>

    <div class="collapse d-md-block" id="filtersCollapse">
      <div class="filterbar__body">
        <div class="filtergrid">

          <div class="filter-control fcol-period">
            <div class="form-label">Période</div>
            <div class="filterbox">
              <div class="filterrow">
                <div class="filter-icon"><i class="bi bi-calendar-range"></i></div>
                <input id="periodFilter" class="form-control form-control-sm" placeholder="Période" aria-label="Filtrer par période" />
              </div>
            </div>
          </div>

          <div class="filter-control fcol-formation">
            <div class="form-label">Formation</div>
            <div class="filterbox">
              <div class="filterrow">
                <div class="filter-icon"><i class="bi bi-journal-bookmark"></i></div>
                <select id="formationFilter" class="form-select form-select-sm">
                  <option value="">Toutes</option>
                  {% for f in formations %}
                    <option value="{{ f.id }}">{{ f.titre }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>

          <div class="filter-control fcol-site">
            <div class="form-label">Site</div>
            <div class="filterbox">
              <div class="filterrow">
                <div class="filter-icon"><i class="bi bi-geo-alt"></i></div>
                <select id="siteFilter" class="form-select form-select-sm">
                  <option value="">Tous</option>
                  {% for s in sites %}
                    <option value="{{ s.id }}">{{ s.nom }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>

          <div class="filter-control fcol-status">
            <div class="form-label">Statut</div>
            <div class="filterbox">
              <div class="filterrow">
                <div class="filter-icon"><i class="bi bi-flag"></i></div>
                <select id="statusFilter" class="form-select form-select-sm">
                  <option value="">Tous</option>
                  {% for st in statusSessions %}
                    <option value="{{ st.value }}">{{ st.label }}</option>
                  {% endfor %}

                </select>
              </div>
            </div>
          </div>

          <div class="filter-control fcol-actions">
            <div class="form-label">&nbsp;</div>
            <button id="btnReset" type="button" class="resetbox" title="Réinitialiser">
              <i class="bi bi-arrow-counterclockwise me-2"></i>
              <span class="fw-bold">Reset</span>
            </button>
          </div>

        </div>
      </div>
    </div>
    <div class="planning-active" id="planningActive" aria-live="polite">Filtres actifs : Aucun</div>
  </div>

  <div class="planning-summary">Consultez les interventions de vos formateurs sur la période affichée.</div>
  <div class="calendar-card">
    <div class="planning-heading">
      <div><span class="planning-eyebrow">ORGANISATION & SUIVI</span><h3>Les interventions en un coup d’œil</h3><p>Retrouvez les sessions de chaque formateur et consultez le détail d’un créneau.</p></div>
      <div class="planning-legend"><i aria-hidden="true"></i> Journée de formation</div>
    </div>
    <div id="calendar"></div>
  </div>

</div>

<div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content" style="border-radius:18px; overflow:hidden;">
      <div class="modal-header" style="background: linear-gradient(135deg, var(--theme-color-principal), var(--theme-color-secondaire)); color:#fff;">
        <div>
          <h5 class="modal-title mb-0 fw-bold">Détails créneau</h5>
          <div class="small opacity-75" id="eventDetailsModalSub">—</div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>

      <div class="modal-body">
        <div id="eventDetailsBody">
          <div class="text-muted small">Chargement…</div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>


<script>
/**
 * Planning formateurs — script robuste & “premium”
 * - évite TDZ (calendar avant init)
 * - 1 seule source de vérité: loadData(range) renvoie {resources, events}
 * - debounce + cache clé (range + filtres)
 * - forcedRange via flatpickr (visibleRange) + end exclusive
 * - refreshAll safe: purge events + refetchResources + addEventSource
 */
(function(){
  const $period      = document.getElementById('periodFilter');
  const $formation   = document.getElementById('formationFilter');
  const $site        = document.getElementById('siteFilter');
  const $status      = document.getElementById('statusFilter');
  const $lastRefresh = document.getElementById('hero-last-refresh');
  const $btnReset    = document.getElementById('btnReset');

  // ---------------------------
  // Utils
  // ---------------------------
  function nowLabel(){
    const d = new Date();
    return d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
  }
  function isMobile(){ return window.matchMedia('(max-width: 576px)').matches; }
  function isTablet(){ return window.matchMedia('(max-width: 992px)').matches; }

  function ensureDate(v){
    if (!v) return null;
    if (v instanceof Date) return isNaN(v.getTime()) ? null : v;
    const d = new Date(v);
    return isNaN(d.getTime()) ? null : d;
  }
  function iso(v){
    const d = ensureDate(v);
    return d ? d.toISOString() : '';
  }

  // ---------------------------
  // Debounce
  // ---------------------------
  let refetchTimer = null;
  function refetchDebounced(ms = 150){
    clearTimeout(refetchTimer);
    refetchTimer = setTimeout(refreshAll, ms);
  }

  // ---------------------------
  // TomSelect
  // ---------------------------
  let tsFormation=null, tsSite=null, tsStatus=null;

  function initTomSelect(){
    const common = { create:false, allowEmptyOption:true, maxItems:1, plugins:['clear_button'] };
    try{ tsFormation?.destroy(); tsSite?.destroy(); tsStatus?.destroy(); }catch(e){}

    tsFormation = new TomSelect('#formationFilter', {...common, placeholder:'Toutes'});
    tsSite      = new TomSelect('#siteFilter',      {...common, placeholder:'Tous'});
    tsStatus    = new TomSelect('#statusFilter',    {...common, placeholder:'Tous'});

    tsFormation.on('change', () => refetchDebounced());
    tsSite.on('change',      () => refetchDebounced());
    tsStatus.on('change',    () => refetchDebounced());
  }

  // fallback si TomSelect absent
  $formation?.addEventListener('change', () => refetchDebounced());
  $site?.addEventListener('change',      () => refetchDebounced());
  $status?.addEventListener('change',    () => refetchDebounced());

  function getFilters(){
    const rawF = (tsFormation ? tsFormation.getValue() : $formation?.value) ?? '';
    const rawS = (tsSite      ? tsSite.getValue()      : $site?.value)      ?? '';
    const rawT = (tsStatus    ? tsStatus.getValue()    : $status?.value)    ?? '';
    return {
      fid: rawF === '' ? 0 : Number(rawF),
      sid: rawS === '' ? 0 : Number(rawS),
      st:  String(rawT || ''),
    };
  }

  // ---------------------------
  // Range forcé (flatpickr)
  // ---------------------------
  let forcedRange = null; // { start: Date, end: Date(exclusive) } | null
  let fp = null;

  function getRangeFromFetchInfo(fetchInfo){
    // 1) forcedRange prioritaire
    if (forcedRange?.start && forcedRange?.end){
      return { start: forcedRange.start, end: forcedRange.end };
    }

    // 2) sinon ce que FullCalendar donne (toujours safe, pas besoin de calendar ici)
    const s = ensureDate(fetchInfo?.start) || ensureDate(fetchInfo?.startStr);
    const e = ensureDate(fetchInfo?.end)   || ensureDate(fetchInfo?.endStr);
    if (s && e) return { start: s, end: e };

    // 3) fallback ultime
    const d = new Date();
    return { start: new Date(d.getFullYear(), d.getMonth(), 1), end: new Date(d.getFullYear(), d.getMonth() + 1, 1) };
  }

  function initPeriodPicker(calendar){
    fp = flatpickr($period, {
      mode: 'range',
      dateFormat: 'Y-m-d',
      locale: 'fr',
      allowInput: true,

      onClose: function(selectedDates){
        // rien choisi => on enlève le range forcé
        if (!selectedDates || !selectedDates.length){
          forcedRange = null;
          calendar.setOption('visibleRange', null);
          refetchDebounced();
          return;
        }

        // 1 seule date => on navigue dessus sans imposer un range
        if (selectedDates.length === 1){
          forcedRange = null;
          calendar.setOption('visibleRange', null);
          calendar.gotoDate(selectedDates[0]);
          refetchDebounced();
          return;
        }

        // 2 dates => range réel
        const start = new Date(selectedDates[0]);
        const end   = new Date(selectedDates[1]);

        // FullCalendar veut un end EXCLUSIVE => +1 jour
        const endExclusive = new Date(end);
        endExclusive.setDate(endExclusive.getDate() + 1);

        forcedRange = { start, end: endExclusive };

        calendar.setOption('visibleRange', { start, end: endExclusive });
        calendar.gotoDate(start);
        refetchDebounced();
      }
    });

    // “change” manuel (si l’utilisateur tape)
    $period?.addEventListener('change', () => refetchDebounced());
  }

  // ---------------------------
  // URL + Cache
  // ---------------------------
  let lastKey = null;
  let lastPromise = null;

  function buildUrl(range){
    const { fid, sid, st } = getFilters();
    const base = "{{ path('app_administrateur_planning_formateurs_data', { entite: entite.id }) }}";
    const url = new URL(base, window.location.href);

    url.searchParams.set('start', iso(range.start));
    url.searchParams.set('end',   iso(range.end));

    if (fid > 0) url.searchParams.set('formation', String(fid)); else url.searchParams.delete('formation');
    if (sid > 0) url.searchParams.set('site', String(sid));      else url.searchParams.delete('site');
    if (st)      url.searchParams.set('status', st);             else url.searchParams.delete('status');

    return url.toString();
  }

  function keyFor(range){
    const { fid, sid, st } = getFilters();
    return [iso(range.start), iso(range.end), fid, sid, st].join('|');
  }

  async function loadData(range){
    const key = keyFor(range);
    if (key === lastKey && lastPromise) return lastPromise;

    lastKey = key;
    lastPromise = (async () => {
      const url = buildUrl(range);
      console.log('[planning formateurs] url=', url);

      const r = await fetch(url, { headers: { 'Accept': 'application/json' } });
      if(!r.ok) throw new Error('HTTP ' + r.status);
      const payload = await r.json();

      // Normalisation
      const resources = (Array.isArray(payload.resources) ? payload.resources : [])
        .map(rr => ({ ...rr, id: String(rr.id) }));

      const resourceIdSet = new Set(resources.map(rr => rr.id));

      const eventsRaw = (Array.isArray(payload.events) ? payload.events : []).map(e => {
        const rid = (e.resourceId != null) ? e.resourceId : (e.resource_id != null ? e.resource_id : null);
        return { ...e, resourceId: (rid != null ? String(rid) : null) };
      });

      // IMPORTANT: un event scheduler doit avoir un resourceId existant
      const events = eventsRaw.filter(e => !e.resourceId || resourceIdSet.has(e.resourceId));

      const orphanCount = eventsRaw.length - events.length;
      if (orphanCount > 0){
        console.warn('[planning formateurs] events orphelins filtrés =', orphanCount);
      }

      $lastRefresh.textContent = 'Maj : ' + nowLabel();
      return { resources, events };
    })();

    return lastPromise;
  }

  // ---------------------------
  // Modal (inchangé)
  // ---------------------------
  const modalEl  = document.getElementById('eventDetailsModal');
  const modalSub = document.getElementById('eventDetailsModalSub');
  const modalBody= document.getElementById('eventDetailsBody');
  const modal    = modalEl ? new bootstrap.Modal(modalEl) : null;

  function esc(s){
    return (s ?? '').toString().replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
  }

  function money(cents){
    const n = (parseInt(cents || 0, 10) || 0) / 100;
    return n.toLocaleString('fr-FR', { style:'currency', currency:'EUR' });
  }
  function fmtDT(iso){
    if(!iso) return '—';
    const d = new Date(iso);
    return d.toLocaleString('fr-FR', { dateStyle:'full', timeStyle:'short' });
  }
  function badge(txt, cls){
    return `<span class="badge ${cls}">${esc(txt)}</span>`;
  }

  function renderDetailsFormateur(data){
    const s  = data.session || {};
    const j  = data.jour || {};
    const st = data.stats || {};
    const form = s.formation || {};
    const site = s.site || {};
    const fo = data.formateur || {};
    const stagiaires = Array.isArray(data.stagiaires) ? data.stagiaires : [];

    // Sous-titre identique (formation — code • date)
    modalSub.textContent =
      `${(form.titre || '')}${s.code ? ' — ' + s.code : ''} • ${(j.date || '')}`;

    // Pièces obligatoires (si tu renvoies un tableau côté API)
    const pieces = Array.isArray(s.piecesObligatoires) && s.piecesObligatoires.length
      ? `
        <div class="d-flex flex-wrap gap-1">
          ${s.piecesObligatoires.map(label => `
            <span class="badge d-inline-flex align-items-center gap-1"
                  style="
                    background: var(--card2);
                    color: var(--ink);
                    border:1px solid var(--line);
                    padding:.45rem .6rem;
                    border-radius:999px;
                    font-weight:600;
                  ">
              <i class="bi bi-file-earmark-text opacity-75"></i>
              ${esc(label)}
            </span>
          `).join('')}
        </div>
      `
      : `<div class="text-muted">—</div>`;

    // Table stagiaires (même esprit que sessions)
    const list = stagiaires.length ? `
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Stagiaire</th>
              <th>Société</th>
              <th>Statut</th>
              <th>Financement</th>
            </tr>
          </thead>
          <tbody>
            ${stagiaires.map(u => `
              <tr>
                <td class="fw-semibold">${esc((u.nom||'') + ' ' + (u.prenom||''))}</td>
                <td>${esc(u.entreprise || '—')}</td>
                <td>${badge(u.statusLabel || u.status || '—', 'bg-primary')}</td>
                <td>${badge(u.modeFinancement || '—', 'bg-dark')}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    ` : `<div class="text-muted">Aucun inscrit sur cette session.</div>`;

    // Rendu final = même layout que "planning sessions"
    modalBody.innerHTML = `
      <div class="row g-3">

        <!-- Colonne gauche -->
        <div class="col-lg-6">
          <div class="p-3 rounded-4 border" style="background: var(--card2); border-color: var(--line)!important;">
            <div class="fw-bold mb-2"><i class="bi bi-person-workspace"></i> Créneau formateur</div>

            <div class="small text-muted">Formateur</div>
            <div class="fw-semibold">${esc((fo.prenom||'') + ' ' + (fo.nom||''))}</div>
            <div class="text-muted small">${esc(fo.email || '')}</div>

            <div class="small text-muted mt-3">Formation hors pauses</div>
            <div class="fw-semibold">${esc(String(data.dureeHeures ?? 0))} h</div>
            ${data.pauseMinutes > 0 ? `<div class="small text-muted">Pause déduite : ${esc(String(data.pauseMinutes))} min</div>` : ''}

            <hr class="my-3"/>

            <div class="small text-muted">Session</div>
            <div class="fw-semibold">${esc(s.code || '—')}</div>

            <div class="small text-muted mt-2">Statut</div>
            <div class="fw-semibold">${esc(s.statusLabel || s.status || '—')}</div>

            <div class="small text-muted mt-2">Créneau</div>
            <div class="fw-semibold">${esc(fmtDT(j.start))} → ${esc(fmtDT(j.end))}</div>

            <div class="small text-muted mt-2">Formation</div>
            <div class="fw-semibold">${esc(form.titre || '—')}</div>

            <div class="small text-muted mt-2">Site</div>
            <div class="fw-semibold">${esc(site.nom || '—')}</div>

            <div class="small text-muted mt-2">Engin</div>
            <div class="fw-semibold">${s.engin ? esc(s.engin.nom || '—') : '—'}</div>
          </div>
        </div>

        <!-- Colonne droite -->
        <div class="col-lg-6">
          <div class="d-flex flex-column gap-3">

            <div class="p-3 rounded-4 border" style="background: var(--card2); border-color: var(--line)!important;">
              <div class="fw-bold mb-2"><i class="bi bi-bar-chart"></i> Capacité & inscriptions</div>

              <div class="d-flex flex-wrap gap-2">
                ${badge('Capacité : ' + (s.capacite ?? '—'), 'bg-secondary')}
                ${badge('Inscrits : ' + (st.inscrits ?? 0), 'bg-success')}
                ${badge('Restantes : ' + (st.placesRestantes ?? 0), 'bg-warning text-dark')}
              </div>

              <div class="small text-muted mt-3">Tarif</div>
              <div class="fw-semibold">${money(s.montantCents || 0)}</div>

              <div class="small text-muted mt-3">Pièces obligatoires</div>
              ${pieces}
            </div>

          </div>
        </div>

        <!-- Stagiaires pleine largeur -->
        <div class="col-12">
          <div class="p-3 rounded-4 border" style="background: var(--card); border-color: var(--line)!important;">
            <div class="fw-bold mb-2"><i class="bi bi-people"></i> Stagiaires</div>
            ${list}
          </div>
        </div>

      </div>
    `;
  }


  // ---------------------------
  // FullCalendar init
  // ---------------------------
  const calendarEl = document.getElementById('calendar');
  const schedulerKey = {{ schedulerKey ? schedulerKey|json_encode|raw : '""' }};

  function getInitialView(){ return isMobile() ? 'timeGridDay' : 'resourceTimelineMonth'; }
  function getHeaderToolbar(){
    return isMobile()
      ? { left: 'prev,next today', center: 'title', right: 'timeGridDay,timeGridWeek' }
      : { left: 'prev,next today', center: 'title', right: 'resourceTimelineDay,resourceTimelineWeek,resourceTimelineMonth' };
  }
  function getResourceColumns(){
    return isTablet()
      ? [{ field: 'title', headerContent: 'Formateur', width: 230 }, { field: 'email', headerContent: 'Email', width: 220 }]
      : [{ field: 'title', headerContent: 'Formateur', width: 260 }, { field: 'email', headerContent: 'Email', width: 260 }, { field: 'qualifs', headerContent: 'Qualifs', width: 90 }, { field: 'sites', headerContent: 'Sites', width: 80 }];
  }
  function getResourceAreaWidth(){ return isTablet() ? '420px' : '560px'; }

  const calendar = new FullCalendar.Calendar(calendarEl, {
    schedulerLicenseKey: schedulerKey || 'CC-Attribution-NonCommercial-NoDerivatives',
    locale: 'fr',
    initialView: getInitialView(),
    headerToolbar: getHeaderToolbar(),

    height: 'auto',
    expandRows: true,
    nowIndicator: true,
    editable: false,
    selectable: false,
    stickyHeaderDates: true,

    resourceAreaWidth: getResourceAreaWidth(),
    resourceAreaColumns: getResourceColumns(),
    slotMinWidth: isTablet() ? 62 : 70,
    resourceOrder: 'title',

    // on gère les events via refreshAll()
    events: [],

    // ⚠️ FullCalendar peut appeler resources() très tôt => ici on NE touche PAS calendar (TDZ)
    resources: async function(fetchInfo, success){
      try{
        const range = getRangeFromFetchInfo(fetchInfo);
        const data = await loadData(range);
        success(data.resources);
      }catch(e){
        console.error(e);
        success([]);
      }
    },

    datesSet: function(){
      // changement de vue / navigation
      refetchDebounced();
    },

    eventClick: function(info){
      info.jsEvent.preventDefault();
      const p = info.event.extendedProps || {};
      if(!p.formateurId || !p.sessionId || !p.jourId || !modal) return;

      modalSub.textContent = '—';
      modalBody.innerHTML = `<div class="text-muted small">Chargement…</div>`;
      modal.show();

      const url = new URL(
        "{{ path('app_administrateur_planning_formateurs_event_details', { entite: entite.id, formateur: 0, session: 0, jour: 0 }) }}",
        window.location.origin
      );

      url.pathname = url.pathname.replace('/0/0/0',
        '/' + encodeURIComponent(p.formateurId) +
        '/' + encodeURIComponent(p.sessionId) +
        '/' + encodeURIComponent(p.jourId)
      );

      fetch(url.toString(), { headers: { 'Accept': 'application/json' } })
        .then(r => r.json())
        .then(data => {
          if(!data || !data.ok){
            modalBody.innerHTML = `<div class="alert alert-danger mb-0">Impossible de charger les détails.</div>`;
            return;
          }
          renderDetailsFormateur(data);
        })

        .catch(() => {
          modalBody.innerHTML = `<div class="alert alert-danger mb-0">Erreur réseau.</div>`;
        });
    }
  });

  // ---------------------------
  // Refresh global “safe”
  // ---------------------------
  async function refreshAll(){
    const active = document.getElementById('planningActive');
    active.replaceChildren(document.createTextNode('Filtres actifs : '));
    const filters = [['formationFilter', 'Formation'], ['siteFilter', 'Site'], ['statusFilter', 'Statut']];
    const labels = filters.flatMap(([id, label]) => {
      const select = document.getElementById(id);
      return Array.from(select.selectedOptions).filter(option => option.value).map(option => label + ' : ' + option.textContent.trim());
    });
    const period = document.getElementById('periodFilter').value;
    if (period) labels.unshift(period);
    if (!labels.length) active.append(document.createTextNode('Aucun'));
    labels.forEach(label => { const chip = document.createElement('span'); chip.textContent = label; active.append(chip); });
    // Range = forcedRange sinon activeStart/activeEnd
    const baseRange = forcedRange?.start && forcedRange?.end
      ? forcedRange
      : { start: calendar.view.activeStart, end: calendar.view.activeEnd };

    const range = getRangeFromFetchInfo(baseRange);

    // force recache si on veut vraiment recharger
    lastKey = null; lastPromise = null;

    let data = { resources: [], events: [] };
    try{
      data = await loadData(range);
    }catch(e){
      console.error('[planning formateurs] refreshAll error', e);
    }

    calendar.batchRendering(() => {
      // purge events
      calendar.removeAllEvents();
      calendar.getEventSources().forEach(s => s.remove());

      // recharge resources (FC rappelle resources())
      calendar.refetchResources();

      // ajoute events en une seule source
      if (data.events && data.events.length){
        calendar.addEventSource(data.events);
      }
    });

    $lastRefresh.textContent = 'Maj : ' + nowLabel();
  }

  // ---------------------------
  // Reset
  // ---------------------------
  $btnReset?.addEventListener('click', function(){
    tsFormation?.setValue('', true);
    tsSite?.setValue('', true);
    tsStatus?.setValue('', true);

    if ($formation) $formation.value = '';
    if ($site)      $site.value = '';
    if ($status)    $status.value = '';

    forcedRange = null;
    calendar.setOption('visibleRange', null);

    fp?.clear();
    calendar.today();
    refetchDebounced(80);
  });

  // ---------------------------
  // Resize adaptatif
  // ---------------------------
  let lastMode = isMobile() ? 'm' : (isTablet() ? 't' : 'd');
  window.addEventListener('resize', () => {
    const mode = isMobile() ? 'm' : (isTablet() ? 't' : 'd');
    if (mode === lastMode) return;
    lastMode = mode;

    calendar.setOption('headerToolbar', getHeaderToolbar());
    calendar.setOption('resourceAreaWidth', getResourceAreaWidth());
    calendar.setOption('resourceAreaColumns', getResourceColumns());
    calendar.setOption('slotMinWidth', isTablet() ? 62 : 70);

    calendar.changeView(isMobile() ? 'timeGridDay' : 'resourceTimelineMonth');
    refetchDebounced(120);
  });

  // ---------------------------
  // Init
  // ---------------------------
  initTomSelect();
  calendar.render();
  initPeriodPicker(calendar);

  $lastRefresh.textContent = 'Maj : ' + nowLabel();
  refetchDebounced(120);
})();
</script>


{% endblock %}
