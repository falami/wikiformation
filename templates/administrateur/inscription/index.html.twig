<script>
$(function () {
  const $filter = $('#inscriptionStatusFilter');

  function nowLabel(){
    const d = new Date();
    return d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
  }

  // ===================== KPI (endpoint) =====================
  async function loadKpis(){
    const status = $filter.val() || 'all';
    const search = table ? (table.search() || '') : '';

    const url = new URL("{{ path('app_administrateur_inscription_kpis', { entite: entite.id }) }}", window.location.origin);
    url.searchParams.set('statusFilter', status);
    url.searchParams.set('search', search);

    const res = await fetch(url.toString(), { headers: { 'Accept': 'application/json' }});
    if(!res.ok) return;

    const k = await res.json();

    $('#kpi-count').text(k.count ?? 0);
    $('#kpi-terminees').text(k.terminees ?? 0);
    $('#kpi-encours').text(k.encours ?? 0);

    const avg = (k.avgAssiduite === null || k.avgAssiduite === undefined)
      ? null
      : Number(k.avgAssiduite);

    $('#kpi-assiduite').text(avg === null ? '—' : (avg.toFixed(1).replace('.', ',') + '%'));

    // barres
    const total = Number(k.count || 0);
    const term  = Number(k.terminees || 0);
    const enc   = Number(k.encours || 0);

    $('#kpi-bar-count').css('width', total ? '100%' : '0%');
    $('#kpi-bar-terminees').css('width', total ? Math.round((term/total)*100) + '%' : '0%');
    $('#kpi-bar-encours').css('width', total ? Math.round((enc/total)*100) + '%' : '0%');
    $('#kpi-bar-assiduite').css('width', avg === null ? '0%' : Math.min(100, Math.round(avg)) + '%');

    $('#hero-last-refresh').text('Maj : ' + nowLabel());
  }

  // ===================== DATATABLE =====================
  const table = $('#tableauInscriptions').DataTable({
    serverSide:true,
    processing:true,
    autoWidth: false,
    scrollX: true,
    scrollCollapse: true,
    responsive: false,
    ajax: {
      url: "{{ path('app_administrateur_inscription_ajax', { entite: entite.id }) }}",
      type: "POST",
      data: function (d) {
        d.statusFilter = $filter.val() || 'all'; // important : doit être géré côté PHP
      }
    },

    dom:
      '<"dt-top d-flex flex-wrap gap-2 align-items-center justify-content-between"'
        + '<"dt-actions d-flex gap-2 align-items-center"B>'
        + '<"dt-search"f>'
      + '>'
      + 'rt'
      + '<"dt-bottom-internal d-flex flex-wrap gap-2 align-items-center justify-content-between"lip>',

    buttons: [
      { extend: 'copy',  title: 'Inscriptions', text: 'Copier' },
      { extend: 'csv',   title: 'Inscriptions', text: 'CSV' },
      { extend: 'excel', title: 'Inscriptions', text: 'Excel' },
      { extend: 'pdf',   title: 'Inscriptions', text: 'PDF' },
      { extend: 'print', title: 'Inscriptions', text: 'Imprimer' },
    ],

    lengthMenu: [[10,25,50,100,500],[10,25,50,100,500]],
    pageLength: 100,
    columns: [
      { data:'id', render: (id, type) => type === 'display' ? `<input type="checkbox" class="form-check-input me-2 js-inscription-select" value="${Number(id)}" aria-label="Sélectionner l'inscription ${Number(id)}">${Number(id)}` : id },
      { data:'session' },
      { data:'stagiaire' },
      { data:'status' },
      { data:'assiduite' },
      { data:'actions' }
    ],

    columnDefs: [
      { targets:5, className:'action-column text-end', orderable:false, searchable:false },
      { targets:[3,4,5], searchable:false },
      { targets:0, type:'num' }
    ],

    order: [[0,'desc']],
    language: { url:'https://cdn.datatables.net/plug-ins/2.2.2/i18n/fr-FR.json' },
    deferRender: true,

    initComplete: function(){
      // buttons DT => dropdown menu
      const api = this.api();
      const container = api.buttons().container();
      const $btns = $(container).find('button');

      $('#exportMenu').empty();
      $btns.each(function(){
        const $b = $(this);
        const label = $b.text().trim();

        const icon = label === 'Excel' ? 'bi-file-earmark-excel' :
                     label === 'PDF' ? 'bi-file-earmark-pdf' :
                     label === 'CSV' ? 'bi-filetype-csv' :
                     label === 'Imprimer' ? 'bi-printer' :
                     label === 'Copier' ? 'bi-clipboard' : 'bi-download';

        const $item = $(`
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2" href="#">
              <i class="bi ${icon}"></i> <span>${label}</span>
            </a>
          </li>
        `);

        $item.on('click', function(e){
          e.preventDefault();
          $b.trigger('click');
        });

        $('#exportMenu').append($item);
      });

      $(container).hide();

      // ✅ premier chargement KPI
      loadKpis();
    }
  });


  const selectedInscriptions = new Set();
  const batchModalElement = document.getElementById('inscriptionBatchModal');
  const batchModal = bootstrap.Modal.getOrCreateInstance(batchModalElement);
  const batchConfirm = document.getElementById('inscriptionBatchConfirm');
  let batchPending = null;
  let batchBusy = false;
  function updateInscriptionSelection() {
    const boxes = [...document.querySelectorAll('#tableauInscriptions .js-inscription-select')];
    boxes.forEach(box => box.checked = selectedInscriptions.has(Number(box.value)));
    const master = document.getElementById('selectInscriptionPage');
    master.checked = boxes.length > 0 && boxes.every(box => box.checked);
    master.indeterminate = boxes.some(box => box.checked) && !master.checked;
    document.getElementById('inscriptionSelectionCount').textContent = `${selectedInscriptions.size} inscription(s) sélectionnée(s)`;
    document.querySelectorAll('.js-inscription-batch').forEach(button => button.disabled = !selectedInscriptions.size);
  }
  table.on('draw.dt', () => { selectedInscriptions.clear(); updateInscriptionSelection(); });
  document.getElementById('selectInscriptionPage').addEventListener('change', event => {
    selectedInscriptions.clear();
    if (event.target.checked) document.querySelectorAll('#tableauInscriptions .js-inscription-select').forEach(box => selectedInscriptions.add(Number(box.value)));
    updateInscriptionSelection();
  });
  $('#tableauInscriptions').on('change', '.js-inscription-select', function () {
    if (this.checked) selectedInscriptions.add(Number(this.value)); else selectedInscriptions.delete(Number(this.value));
    updateInscriptionSelection();
  });
  document.querySelectorAll('.js-inscription-batch').forEach(button => button.addEventListener('click', () => {
    if (batchBusy || !selectedInscriptions.size) return;
    const action = button.dataset.action;
    const ids = [...selectedInscriptions];
    batchPending = {action, ids};
    document.getElementById('inscriptionBatchTitle').textContent = {status: 'Changer le statut', close: 'Clôturer les inscriptions', delete: 'Supprimer les inscriptions'}[action];
    document.getElementById('inscriptionBatchDescription').textContent = `${ids.length} inscription(s) concernée(s). ` + {
      status: 'Seul le statut sera modifié. Pour calculer l’assiduité et générer les attestations, utilisez « Clôturer ».',
      close: 'Les inscriptions seront marquées « Terminé ». Hors sous-traitance, l’assiduité et l’attestation seront mises à jour uniquement si toutes les présences sont renseignées. En sous-traitance : aucun calcul ni attestation automatique.',
      delete: 'Les inscriptions et leurs données liées seront supprimées définitivement. Cette action est irréversible.'
    }[action];
    document.getElementById('inscriptionBatchStatusField').hidden = action !== 'status';
    document.getElementById('inscriptionBatchStatus').value = '';
    document.getElementById('inscriptionBatchError').textContent = '';
    const list = document.getElementById('inscriptionBatchItems'); list.replaceChildren();
    table.rows().data().toArray().filter(row => ids.includes(Number(row.id))).forEach(row => {
      const li = document.createElement('li'); li.textContent = `${row.stagiaire} · ${row.session}`; list.append(li);
    });
    batchConfirm.className = action === 'delete' ? 'btn btn-danger' : 'btn btn-primary';
    batchConfirm.disabled = false;
    batchModal.show();
  }));
  batchModalElement.addEventListener('hide.bs.modal', event => { if (batchBusy) event.preventDefault(); });
  batchConfirm.addEventListener('click', async () => {
    if (batchBusy || !batchPending) return;
    const status = document.getElementById('inscriptionBatchStatus').value;
    if (batchPending.action === 'status' && !status) {
      document.getElementById('inscriptionBatchError').textContent = 'Choisissez le nouveau statut.'; return;
    }
    batchBusy = true; batchConfirm.disabled = true; batchConfirm.textContent = 'Traitement en cours…';
    try {
      const response = await fetch({{ path('app_administrateur_inscription_batch', {entite: entite.id})|json_encode|raw }}, {
        method: 'POST', credentials: 'same-origin', headers: {'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded'},
        body: new URLSearchParams({_token: batchModalElement.dataset.token, action: batchPending.action, ids: JSON.stringify(batchPending.ids), status})
      });
      const payload = response.headers.get('content-type')?.includes('application/json') ? await response.json() : null;
      if (!response.ok || !payload?.ok) throw new Error(payload?.message || 'Le résultat de l’action n’a pas pu être confirmé. Rechargez la liste pour vérifier les inscriptions.');
      document.getElementById('inscriptionBatchFeedback').textContent = `${payload.changed} inscription(s) ${batchPending.action === 'delete' ? 'supprimée(s)' : batchPending.action === 'close' ? 'clôturée(s)' : 'mise(s) à jour'}.`;
      batchBusy = false; batchModal.hide(); batchPending = null; selectedInscriptions.clear(); table.ajax.reload(null, false);
    } catch (error) { document.getElementById('inscriptionBatchError').textContent = error.message; }
    finally { batchBusy = false; batchConfirm.disabled = false; batchConfirm.textContent = 'Confirmer'; }
  });

  // ✅ Dropdown actions inscriptions : menu "flottant" hors du scroll DT
  (function enableInscriptionActionsFloatingDropdown(){
    document.addEventListener('show.bs.dropdown', function(e){
      if (e.target.closest?.('.wf-table-actions')) return; // Gestion commune des tableaux
      const toggle = e.target;
      if (!toggle.closest('.inscription-actions')) return;

      const dd = toggle.closest('.dropdown, .btn-group');
      if (!dd) return;

      const menu = dd.querySelector('.dropdown-menu');
      if (!menu) return;

      if (!menu.__originalParent) menu.__originalParent = dd;

      document.body.appendChild(menu);
      menu.classList.add('inscription-floating-dropdown');

      const rect = toggle.getBoundingClientRect();
      menu.style.position = 'absolute';
      menu.style.top = '0px';
      menu.style.left = '0px';
      menu.style.display = 'block';
      const menuRect = menu.getBoundingClientRect();

      const top = rect.bottom + window.scrollY + 6;
      let left = rect.right + window.scrollX - menuRect.width;

      left = Math.max(8, Math.min(left, window.scrollX + window.innerWidth - menuRect.width - 8));

      menu.style.top = `${top}px`;
      menu.style.left = `${left}px`;
    }, true);


    window.addEventListener('scroll', () => {
      document.querySelectorAll('.inscription-actions [aria-expanded="true"][data-bs-toggle="dropdown"]')
        .forEach(btn => btn.click());
    }, true);

    window.addEventListener('resize', () => {
      document.querySelectorAll('.inscription-actions [aria-expanded="true"][data-bs-toggle="dropdown"]')
        .forEach(btn => btn.click());
    }, true);


    document.addEventListener('hidden.bs.dropdown', function(e){
      if (e.target.closest?.('.wf-table-actions')) return; // Gestion commune des tableaux
      const toggle = e.target;
      if (!toggle.closest('.inscription-actions')) return;

      const dd = toggle.closest('.dropdown, .btn-group');
      if (!dd) return;

      document.querySelectorAll('body .inscription-floating-dropdown').forEach(menu => {
        if (menu.__originalParent === dd) {
          dd.appendChild(menu);
          menu.classList.remove('inscription-floating-dropdown');
          menu.style.position = '';
          menu.style.top = '';
          menu.style.left = '';
          menu.style.display = '';
        }
      });
    }, true);
  })();


  // ✅ à chaque draw (pagination / tri / recherche)
  table.on('draw.dt', function(){
    loadKpis();
  });

  // ✅ filtre statut
  $filter.on('change', function(){
    table.ajax.reload(null, true);
    loadKpis();
  });

  // ✅ reset
  $('#btnReset').on('click', function(){
    $filter.val('all');
    table.search('').draw();
    table.ajax.reload(null, true);
    loadKpis();
  });
});
</script>

{% endblock %}
