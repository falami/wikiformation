<div class="session-switch-card">
  <div>{{ form_label(field) }}{% if field.vars.help %}<div class="text-muted small" id="{{ field.vars.id }}_help">{{ field.vars.help }}</div>{% endif %}{{ form_errors(field) }}</div>
  {{ form_widget(field, {attr: {class: 'session-switch-input', role: 'switch', 'aria-describedby': field.vars.id ~ '_help'}}) }}
</div>
