{# ===== NOUVEAU STAGIAIRE (ULTRA) ===== #}
<div class="modal fade modal-ultra" id="modal-new-stagiaire" tabindex="-1" aria-hidden="true" aria-labelledby="new-stagiaire-title">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">

      <form id="form-new-stagiaire">
        <input type="hidden" name="_token" value="{{ csrf_token('session_stagiaire_new_' ~ entite.id) }}">
        <div class="modal-header">
          <h5 class="modal-title" id="new-stagiaire-title">
            <span class="ico"><i class="bi bi-person-plus"></i></span>
            Nouveau stagiaire
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>

        <div class="modal-body">
          <div class="ultra-hint mb-3">
            <i class="bi bi-shield-check"></i>
            <div>
              <div class="fw-semibold" style="color:var(--ink)">Création + association en 1 clic</div>
              <div>Si cette adresse e-mail existe déjà, son compte est sélectionné sans créer de doublon.</div>
            </div>
          </div>

          <div class="ultra-panel">
            <div class="row g-3">
              <div class="col-md-5">
                <label class="form-label">Civilité *</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-person-badge"></i></span>
                  <select name="civilite" class="form-select" required>
                    <option value="">— Choisir —</option>
                    <option value="Monsieur">Monsieur</option>
                    <option value="Madame">Madame</option>
                  </select>
                </div>
              </div>

              <div class="col-md-7">
                <label class="form-label">Téléphone</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-telephone"></i></span>
                  <input type="text" name="telephone" class="form-control" placeholder="06 12 34 56 78">
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label">Prénom *</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-person"></i></span>
                  <input type="text" name="prenom" class="form-control" required placeholder="Jean">
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label">Nom *</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-person"></i></span>
                  <input type="text" name="nom" class="form-control" required placeholder="Dupont">
                </div>
              </div>

              <div class="col-12">
                <label class="form-label">Email *</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-envelope"></i></span>
                  <input type="email" name="email" class="form-control" required placeholder="jean.dupont@mail.com">
                </div>
                <div class="form-text">Cet email servira d’identifiant et de contact.</div>
              </div>
              <div class="col-12">
                <label class="form-label" for="new-stagiaire-entreprise">Entreprise <span class="text-muted fw-normal">(facultatif)</span></label>
                <div class="d-flex align-items-start gap-2">
                  <div class="flex-grow-1" style="min-width:0">
                    <select name="entreprise" id="new-stagiaire-entreprise" class="form-select">
                      <option value="">Aucune / particulier</option>
                      {% for entreprise in participantEntreprises %}
                        <option value="{{ entreprise.id }}">{{ entreprise.raisonSociale }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  {% if is_granted('ENTREPRISE_MANAGE', entite) %}
                    <button type="button" class="btn btn-ultra-cancel" id="btn-new-participant-entreprise" title="Créer une entreprise" aria-label="Créer une entreprise"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                  {% endif %}
