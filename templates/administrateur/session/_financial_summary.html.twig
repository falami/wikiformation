<div class="session-finance">
  <div class="session-finance-source">Tarif de la session</div>
  <div class="session-finance-line"><span>{{ finance.global ? 'Forfait global HT' : 'Tarif HT / participant' }}</span><b>{{ (finance.sessionHt / 100)|number_format(2, ',', ' ') }} €</b></div>
  <div class="session-finance-line"><span>TVA {{ finance.sessionRate|number_format(2, ',', ' ') }} %</span><b>{{ (finance.sessionTax / 100)|number_format(2, ',', ' ') }} €</b></div>
  <div class="session-finance-line mb-3"><span>Tarif TTC</span><b>{{ (finance.sessionTtc / 100)|number_format(2, ',', ' ') }} €</b></div>
  <div class="session-finance-source">{{ finance.estimated ? 'Total estimé HT' : 'Total des conventions' }}</div>
  {% for currency, amount in finance.amounts %}
    {% set symbol = currency == 'EUR' ? '€' : currency %}
    <div class="session-finance-line session-finance-ht"><span>Montant HT</span><strong>{{ (amount.ht / 100)|number_format(2, ',', ' ') }} {{ symbol }}</strong></div>
    <div class="session-finance-line"><span>TVA</span><b>{{ (amount.tax / 100)|number_format(2, ',', ' ') }} {{ symbol }}</b></div>
    <div class="session-finance-line"><span>Montant TTC</span><b>{{ ((amount.ht + amount.tax) / 100)|number_format(2, ',', ' ') }} {{ symbol }}</b></div>
  {% else %}<div>Montants indisponibles</div>{% endfor %}
  {% if not finance.responsibleOnly %}
  <div class="session-finance-line session-finance-cost"><span>Formateurs HT</span><b>{{ finance.contracts ? (finance.trainerCost / 100)|number_format(2, ',', ' ') ~ ' €' : 'Non renseigné' }}</b></div>
  {% if finance.contracts %}
  <div class="session-finance-line"><span>TVA des contrats formateurs</span><b>{{ (finance.trainerTax / 100)|number_format(2, ',', ' ') }} €</b></div>
  <div class="session-finance-line"><span>Formateurs TTC</span><b>{{ (finance.trainerTtc / 100)|number_format(2, ',', ' ') }} €</b></div>
  {% endif %}
  <small>{{ finance.contracts }} contrat(s) · honoraires et frais de mission{% if finance.missingTrainers %} · {{ finance.missingTrainers }} formateur(s) sans contrat{% endif %}</small>
  <div class="session-finance-line session-finance-net {{ finance.remaining is not null and finance.remaining < 0 ? 'is-negative' : '' }}"><span>HT après formateurs</span><strong>{{ finance.remaining is not null ? (finance.remaining / 100)|number_format(2, ',', ' ') ~ ' €' : 'À compléter' }}</strong></div>
  {% endif %}
  {% if finance.estimated %}<small>Tarif × effectif · estimation</small>{% endif %}
  {% if finance.amounts|length > 1 or (finance.amounts|length == 1 and finance.amounts.EUR is not defined) %}<small>Solde non calculé entre devises différentes.</small>{% endif %}
</div>
