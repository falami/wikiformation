<div class="participant-conventions d-grid gap-2" data-participant-conventions>
  {% for document in documents %}
    <div class="rounded-3 border p-3" style="background:linear-gradient(120deg,#fffdf5,#f7f9fc)" data-convention-id="{{ document.id }}">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <a class="fw-semibold text-decoration-none" href="{{ path('app_administrateur_convention_show',{entite:entite.id,id:document.id}) }}" target="_blank" rel="noopener"><i class="bi bi-file-earmark-text me-1"></i>{{ document.number }} <i class="bi bi-box-arrow-up-right small"></i></a>
        <span class="badge {{ document.signed ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' }}">{{ document.signed ? 'Signée' : 'À signer' }}</span>
      </div>
      <div class="small mt-2"><i class="bi {{ document.company ? 'bi-building' : 'bi-person' }} me-1"></i><span class="text-muted">Prise en charge :</span> <strong>{{ document.payer }}</strong></div>
      <div class="d-flex justify-content-between flex-wrap gap-2 mt-2">
        <span class="small text-muted">{{ document.participants }} participant{{ document.participants > 1 ? 's' : '' }} couvert{{ document.participants > 1 ? 's' : '' }}</span>
        <strong>{{ document.amount is not null ? (document.amount / 100)|number_format(2, ',', ' ') ~ ' ' ~ (document.currency == 'EUR' ? '€' : document.currency) ~ ' TTC' : 'Montant indisponible' }}</strong>
      </div>
      <div class="small text-muted mt-1">{{ document.estimated ? 'Total estimé : tarif de la session × effectif de la convention.' : 'Montant total du devis rattaché, partagé entre les participants couverts.' }}</div>
    </div>
  {% else %}<div class="small text-muted py-2"><i class="bi bi-file-earmark me-1"></i>Aucune convention rattachée à ce stagiaire.</div>{% endfor %}
</div>
