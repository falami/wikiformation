{# templates/administrateur/formation/categorie/form.html.twig #}
{% extends 'base_admin.html.twig' %}

{% block title %}{{ modeEdition ? 'Modification' : 'Ajout' }} d'une catégorie{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
<link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">

<style>
:root{
  --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
  --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
  --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
  --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
  --ink:#0f2336; --muted:#6f8897; --line:#e6eef5;
}

.card{ border-radius:18px; border:1px solid rgba(15,35,54,.08); }
.card-header{ border-radius:18px 18px 0 0 !important; }
.section-title{ font-weight:800; letter-spacing:.2px; }
.bg-theme-tertiaire{ background: var(--theme-color-tertiaire) !important; }
.text-theme-secondaire{ color: var(--theme-color-secondaire) !important; }

/* Hero */
.hero{
  border-radius:22px;
  background:
    radial-gradient(800px 260px at 15% 0%, rgba(255,255,255,.18), transparent 60%),
    linear-gradient(135deg, rgba(35,51,66,.98), rgba(15,27,40,.98));
  color:#eaf6ff;
  box-shadow:0 18px 50px rgba(15,35,54,.18);
  border:1px solid rgba(255,255,255,.10);
}
.hero .badge-soft{
  background: rgba(255,193,7,.14);
  border: 1px solid rgba(255,193,7,.24);
  color: #ffe59a;
}

/* Upload zone (comme ta formation) */
.upload-zone{
  position: relative;
  background: #0f2230;
  border: 1.5px dashed rgba(255,193,7,.75);
  border-radius: 1rem;
  padding: 1.25rem;
  text-align: center;
  color: #cfe8f6;
  transition: .2s ease;
  cursor: pointer;
}
.upload-zone:hover{ box-shadow: 0 0 0 .25rem rgba(255,193,7,.14); }
.upload-zone.dragover{
  background: #102a3a;
  border-color: #ffd24d;
  box-shadow: 0 0 0 .25rem rgba(255,210,77,.18);
}
.upload-zone .hint{ font-size: .92rem; opacity: .86; }
.upload-zone .preview img{
  max-height: 220px;
  border-radius: .85rem;
  border: 1px solid rgba(255,255,255,.15);
}
.file-hidden{
  position:absolute !important;
  width:1px !important;
  height:1px !important;
  opacity:0 !important;
  pointer-events:none !important;
}


/* ===== Switch row (même design que session/form) ===== */
.soft-box{
  border-radius: 16px;
  border: 1px dashed rgba(15,35,54,.18);
  background: rgba(248,251,254,.75);
  padding: 1rem;
}

.switch-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap: 1rem;
  padding:.8rem .9rem;
  border-radius:14px;
  border:1px solid rgba(15,35,54,.08);
  background:#fff;
}

.switch-row + .switch-row{ margin-top:.65rem; }

.switch-row .title{
  font-weight:700;
  line-height:1.15;
}
.switch-row .desc{
  margin-top:.25rem;
  font-size:.85rem;
  color:#6b7280;
}

.switch-row .form-check.form-switch{ margin:0; }
.switch-row .form-check-input{ width:2.6em; height:1.35em; }
.switch-row .form-check-input:checked{
  background-color: var(--theme-color-secondaire);
  border-color: var(--theme-color-secondaire);
}

.category-editor {max-width:1280px;margin:0 auto;padding:16px 0 32px;}
.category-editor .hero {border-left:6px solid var(--theme-color-secondaire);box-shadow:0 12px 32px #23334214;padding:30px!important;}
.category-editor .hero h2 {font-weight:800;letter-spacing:-.7px;margin:10px 0!important;}
.category-editor .card {overflow:visible;box-shadow:0 8px 28px #23334208!important;border-color:#e3e9ef;}
.category-editor .card-header {padding:20px 24px;background:linear-gradient(110deg,#f7f9fc,#fffaf0)!important;color:#233342;border-bottom:1px solid #e6ebf1;}
.category-editor .card-body {padding:26px;}
.category-editor .form-control,.category-editor .ts-control {box-shadow:none!important;border-color:#dce3eb;border-radius:12px!important;}
.category-editor .ts-control {padding:15px!important;}
/* Keep the parent selector above the following image card without clipping its menu. */
.category-editor .card:focus-within {position:relative;z-index:2;}
.category-editor .ts-wrapper.dropdown-active {z-index:10;}
.category-editor .ts-dropdown {z-index:11;border:1px solid #dce3eb;border-radius:12px;box-shadow:0 12px 28px #23334220;overflow:hidden;}
.category-editor .ts-dropdown-content {max-height:260px;overflow-y:auto;}
.category-editor .ts-dropdown .option {padding:12px 16px;}
.category-editor .ts-dropdown .active {background:#fff8e4;color:#233342;}
.category-editor .form-control:focus {border-color:#b88c27;box-shadow:0 0 0 3px #ffc10720!important;}
.category-editor .soft-box {border:0;padding:0;background:transparent;}
.category-editor .switch-row {padding:20px;background:#f8fafc;}
.category-editor .upload-zone {padding:30px;background:#f8fafc;color:#40566b;border-color:#c6d2df;}
.category-editor .upload-zone.dragover {background:#fff8e4;border-color:#c59622;}
.category-editor .upload-zone:focus-visible {outline:3px solid #ffc107;outline-offset:3px;}
.category-editor .btn-gradient {background:#233342;color:white;border-radius:12px;padding:12px 22px;}
@media(max-width:576px){.category-editor .card-body{padding:18px}.category-editor .hero{padding:22px!important}}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
{% endblock %}

{% block body %}

  <div class="category-editor">
  {# HERO #}
  <div class="hero p-4 mb-4">
    <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
      <div>
        <div class="small opacity-75">
          <i class="bi bi-diagram-3 me-2 text-theme-secondaire"></i>
          CATALOGUE DE FORMATION
        </div>
        <h2 class="mb-1">{{ modeEdition ? 'Modifier' : 'Créer' }} une catégorie</h2>
        <div class="small opacity-75">Organisez vos formations et soignez leur présentation dans votre catalogue.</div>
      </div>

      <div class="d-flex gap-2 align-items-center">
        <span class="badge badge-soft px-3 py-2 rounded-pill">
          <i class="bi bi-building me-1"></i> {{ entite.nom ?? ('Entité #' ~ entite.id) }}
        </span>
      </div>
    </div>
  </div>

  {% include 'flagMessage.html.twig' %}

  {% set actionPath = modeEdition
    ? path('app_administrateur_formation_categorie_modifier', { entite: entite.id, id: categorie.id })
    : path('app_administrateur_formation_categorie_ajouter',  { entite: entite.id })
  %}

  {{ form_start(form, { action: actionPath, attr: { novalidate: 'novalidate' } }) }}
  {{ form_errors(form) }}

  {# INFOS #}
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-theme-tertiaire section-title">
      <i class="bi bi-info-circle text-theme-secondaire me-2"></i> Informations
    </div>
    <div class="card-body">
      <div class="row g-3">

        <div class="col-md-6">
          <div class="form-floating">
            {{ form_widget(form.nom, {'attr': {'class': 'form-control rounded-3 shadow-sm', 'placeholder': 'Nom', 'data-category-name': ''}}) }}
            <label for="{{ form.nom.vars.id }}">*Nom</label>
          </div>
          {{ form_errors(form.nom) }}
        </div>

        <div class="col-md-6">
          <div class="form-floating">
            {{ form_widget(form.slug, {'attr': {'class': 'form-control rounded-3 shadow-sm', 'placeholder': 'Slug', 'data-category-slug': '', 'maxlength': 140, 'spellcheck': 'false', 'aria-describedby': 'slug-help'}}) }}
            <label for="{{ form.slug.vars.id }}">Identifiant (slug)</label>
          </div>
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2">
            <small id="slug-help" class="text-muted">Généré depuis le nom. Vous pouvez le personnaliser.</small>
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" id="regenerate-slug"><i class="bi bi-arrow-clockwise me-1"></i>Depuis le nom</button>
          </div>
          {{ form_errors(form.slug) }}
        </div>
        <div class="col-12">
          <div class="soft-box">
            <div class="switch-row">
              <div class="flex-grow-1">
                <div class="title">
                  <i class="bi bi-house-door me-2 text-theme-secondaire"></i>
                  Afficher sur la page d’accueil
                </div>
                <div class="desc">
                  Présentez cette catégorie dans la galerie « Explorer par matière » de votre page d’accueil.
                </div>

                {# Si tu as un help Symfony, tu peux le garder ici #}
                {% if form.showOnHome.vars.help %}
                  <div class="form-text mt-2">{{ form.showOnHome.vars.help }}</div>
                {% endif %}
              </div>

              <div class="form-check form-switch">
                {{ form_widget(form.showOnHome, {
                  attr: { class: 'form-check-input' }
                }) }}
              </div>
            </div>
            {{ form_errors(form.showOnHome) }}
          </div>
        </div>



        <div class="col-12">
          <label class="form-label fw-semibold" for="{{ form.parent.vars.id }}">Catégorie parente</label>
          {{ form_widget(form.parent) }}
          <div class="form-text">
            Aucune pour une catégorie principale, ou choisissez une catégorie pour y rattacher une sous-catégorie.
          </div>
          {{ form_errors(form.parent) }}
        </div>

      </div>
    </div>
  </div>

  {# PHOTO #}
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-theme-tertiaire section-title">
      <i class="bi bi-image text-theme-secondaire me-2"></i> Photo de catégorie
    </div>
    <div class="card-body">
      <label class="form-label fw-semibold">Image</label>

      <div class="upload-zone" id="photo-zone" role="button" tabindex="0" aria-label="Choisir une image de catégorie" data-input-id="{{ form.photo.vars.id }}">
        <i class="fas fa-cloud-upload-alt fa-2x mb-2 d-block"></i>
        <div class="hint">Glissez une image ici ou cliquez pour choisir un fichier</div>

        {{ form_widget(form.photo, {'attr': {'class':'file-hidden'}}) }}

        <div class="preview mt-3 d-flex flex-column align-items-center gap-2">
          {% if categorie.photo %}
            <img class="img-fluid" src="{{ asset('uploads/photos/categorie/' ~ categorie.photo) }}" alt="Photo catégorie">
          {% else %}
            <img class="img-fluid d-none" alt="Aperçu">
          {% endif %}
        </div>

        <div class="small mt-2">
          Les images JPEG, PNG et WebP trop lourdes sont réduites automatiquement avant l’envoi. Recadrage final en 1200×600.
        </div>
      </div>

      {{ form_help(form.photo) }}
      {{ form_errors(form.photo) }}
    </div>
  </div>

  {# ACTIONS #}
  <div class="d-flex justify-content-end gap-2 mt-3">
    <a href="{{ path('app_administrateur_formation_categorie', { entite: entite.id }) }}" class="btn btn-secondary">
      <i class="fa fa-arrow-left me-1"></i> Retour
    </a>
    <button type="submit" class="btn btn-gradient">
      <i class="fa fa-check me-1"></i>{{ modeEdition ? 'Enregistrer les modifications' : 'Créer la catégorie' }}
    </button>
  </div>

  {{ form_end(form) }}
  </div>

<script>
document.addEventListener('DOMContentLoaded', () => {

  const name = document.querySelector('[data-category-name]');
  const slug = document.querySelector('[data-category-slug]');
  const slugify = value => value.toLowerCase().replace(/œ/g, 'oe').replace(/æ/g, 'ae').replace(/ß/g, 'ss').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 140);
  let automatic = !slug.value;
  const generate = () => { slug.value = slugify(name.value); };
  name.addEventListener('input', () => { if (automatic) generate(); });
  slug.addEventListener('input', () => { automatic = !slug.value; });
  document.getElementById('regenerate-slug').addEventListener('click', () => { automatic = true; generate(); slug.focus(); });
  if (automatic) generate();

  // TomSelect
  document.querySelectorAll('select.js-ts').forEach((sel) => {
    if (sel.tomselect || typeof TomSelect === 'undefined') return;
    new TomSelect(sel, {
      create:false,
      allowEmptyOption:true,
      plugins:['clear_button'],
      closeAfterSelect:true,
      placeholder: sel.dataset.tsPlaceholder || '— Sélectionner —'
    });
  });

  // Upload zone (drag&drop + preview)
  function initUploadZone(wrapperId){
    const zone = document.getElementById(wrapperId);
    if (!zone) return;

    const inputId = zone.dataset.inputId;
    const input = document.getElementById(inputId) || zone.querySelector('input[type="file"]');
    const previewImg = zone.querySelector('.preview img');

    const openPicker = () => {
      if (!input) return;
      if (typeof input.showPicker === 'function') input.showPicker();
      else input.click();
    };

    zone.addEventListener('click', (e) => {
      if (e.target === input || e.target.closest('button')) return;
      openPicker();
    });

    zone.addEventListener('keydown', e => { if (e.target === zone && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openPicker(); } });

    const status = document.createElement('p');
    status.className = 'small mt-2 mb-0 text-muted';
    status.setAttribute('role', 'status');
    zone.after(status);
    let generation = 0;
    let busy = false;
    let previewUrl = null;
    input.form.addEventListener('submit', event => {
      if (busy) { event.preventDefault(); status.textContent = 'Patientez : optimisation de l’image en cours…'; }
    });
    const encode = (canvas, quality) => new Promise((resolve, reject) => {
      canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error('Impossible de compresser cette image.')), 'image/webp', quality);
    });
    input.addEventListener('change', async () => {
      const current = ++generation;
      const file = input.files?.[0];
      if (!file) return;
      busy = true;
      input.setCustomValidity('Veuillez patienter pendant le traitement de l’image.');
      status.textContent = 'Vérification de l’image…';
      let sourceUrl;
      try {
        if (!['image/jpeg', 'image/png', 'image/webp', 'image/gif'].includes(file.type)) throw new Error('Choisissez une image JPEG, PNG, WebP ou GIF.');
        let result = file;
        if (file.size > 3900000) {
          if (file.type === 'image/gif') throw new Error('Ce GIF dépasse 4 Mo. Choisissez une version plus légère ou une image JPEG, PNG ou WebP pour la réduction automatique.');
          status.textContent = 'Réduction automatique de l’image…';
          sourceUrl = URL.createObjectURL(file);
          const img = new Image();
          img.src = sourceUrl;
          await img.decode();
          const canvas = document.createElement('canvas');
          const scale = Math.min(1, 2400 / Math.max(img.naturalWidth, img.naturalHeight));
          canvas.width = Math.max(1, Math.round(img.naturalWidth * scale));
          canvas.height = Math.max(1, Math.round(img.naturalHeight * scale));
          const ctx = canvas.getContext('2d');
          if (!ctx) throw new Error('La réduction est indisponible dans ce navigateur.');
          let blob;
          for (let attempt = 0; attempt < 8; attempt++) {
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            blob = await encode(canvas, Math.max(.65, .88 - attempt * .04));
            if (blob.size <= 3900000) break;
            canvas.width = Math.max(1, Math.round(canvas.width * .8));
            canvas.height = Math.max(1, Math.round(canvas.height * .8));
          }
          if (!blob || blob.size > 3900000) throw new Error('Cette image reste trop lourde. Choisissez une image plus petite.');
          result = new File([blob], file.name.replace(/\.[^.]+$/, '') + (blob.type === 'image/webp' ? '.webp' : '.png'), {type: blob.type});
        }
        if (current !== generation) return;
        const transfer = new DataTransfer();
        transfer.items.add(result);
        input.files = transfer.files;
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = URL.createObjectURL(result);
        previewImg.src = previewUrl;
        previewImg.classList.remove('d-none');
        const size = bytes => (bytes / 1000000).toLocaleString('fr-FR', {maximumFractionDigits: 2}) + ' Mo';
        status.textContent = result === file ? 'Image prête · ' + size(result.size) : 'Image optimisée : ' + size(file.size) + ' → ' + size(result.size) + '. Prête à enregistrer.';
        input.setCustomValidity('');
      } catch (error) {
        if (current !== generation) return;
        status.textContent = error instanceof Error ? error.message : 'Impossible de traiter cette image.';
        input.setCustomValidity(status.textContent);
      } finally {
        if (sourceUrl) URL.revokeObjectURL(sourceUrl);
        if (current === generation) busy = false;
      }
    });

    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
    zone.addEventListener('drop', e => {
      e.preventDefault();
      zone.classList.remove('dragover');
      if (!input) return;

      const dropped = e.dataTransfer?.files || [];
      if (!dropped.length) return;

      const dt = new DataTransfer();
      dt.items.add(dropped[0]);
      input.files = dt.files;
      input.dispatchEvent(new Event('change', { bubbles:true }));
    });
  }

  initUploadZone('photo-zone');
});
</script>
{% endblock %}
