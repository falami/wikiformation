.category-outline-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:32px 0 18px;color:#63798e}.category-outline-heading span{font-size:11px;letter-spacing:.15em;font-weight:800}.category-outline-heading h3{font-size:22px;font-weight:750;color:#213747;margin:6px 0 0}.category-outline-heading p{font-size:13px;margin:0}.category-outline-heading i{margin:0 8px;color:#b58a22}.category-tree{display:grid;gap:20px;margin-bottom:28px}.category-root{background:#fff;border:1px solid #dee7ed;border-radius:20px;box-shadow:0 7px 26px #23334208;overflow:hidden}.category-root>.category-row{background:linear-gradient(110deg,#f4f8fa,#fffaf0);border-top:3px solid var(--theme-color-secondaire,#ffc107);padding:22px 24px}.category-row{display:flex;align-items:center;gap:18px;padding:16px 20px;min-width:0}.category-picture{width:64px;height:64px;border-radius:15px;overflow:hidden;flex-shrink:0;background:#eaf0f4;color:#456278;display:grid;place-items:center;font-size:25px}.category-picture img{height:100%;width:100%;object-fit:cover}.category-copy{flex:1;min-width:0}.category-level{font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#927226}.category-copy h4{font-size:19px;font-weight:750;color:#203849;margin:5px 0;overflow-wrap:anywhere}.category-copy p{font-size:12px;color:#718397;margin:0;overflow-wrap:anywhere}.category-dot{margin:0 8px}.category-count{background:#fff;border:1px solid #e4eaf0;border-radius:8px;padding:7px 10px;font-size:12px;color:#587084}.category-actions{display:flex;gap:7px;flex-shrink:0}.category-actions form{margin:0}.category-actions a,.category-actions button{display:grid;place-items:center;width:36px;height:36px;background:#fff;border:1px solid #dfe7ed;border-radius:10px;color:#486074;text-decoration:none}.category-actions a:hover{background:#edf4f8}.category-actions .category-delete:hover{background:#fff0ef;color:#b73838;border-color:#f0c7c7}.category-actions :focus-visible{outline:3px solid #d9ad43;outline-offset:3px}.category-children{margin:8px 24px 20px 54px;border-left:1px solid #dce5ec;padding-left:22px}.category-child{position:relative}.category-child:before{content:'';position:absolute;width:22px;height:1px;background:#dce5ec;left:-22px;top:44px}.category-child>.category-row{border-bottom:1px solid #edf1f5}.category-child:last-child>.category-row{border-bottom:0}.category-child>.category-row:hover{background:#f8fafc;border-radius:12px}.category-child .category-picture{width:44px;height:44px;border-radius:11px;font-size:20px}.category-child .category-level{color:#7a8c9b}.category-child .category-copy h4{font-size:16px}.category-no-children{padding:0 24px 20px 106px;font-size:12px;color:#8493a2}.category-empty{padding:48px 20px;text-align:center;border:1px dashed #d7e1e9;background:#fff;border-radius:20px;color:#73879a}.category-empty>i{font-size:32px;color:#b78e30}.category-empty h3{font-size:20px;color:#233c50;margin:14px 0 8px}.category-node[hidden],.category-empty[hidden],.category-children[hidden]{display:none!important}.category-node.is-context>.category-row .category-level{color:#73879a}.category-node.is-context>.category-row{background:#f6f8fa}
@media(max-width:900px){.category-count{display:none}.category-outline-heading{align-items:start;flex-direction:column}.category-row,.category-root>.category-row{padding:16px;gap:12px}.category-children{margin-left:30px;margin-right:10px;padding-left:12px}.category-child:before{left:-12px;width:12px}.category-picture{width:48px;height:48px}.category-no-children{padding-left:16px}}
@media(max-width:540px){.category-picture{display:none}.category-copy h4{font-size:17px}.category-actions{gap:4px}.category-actions a,.category-actions button{width:32px;height:32px}.category-children{margin-left:15px}.category-copy p .category-dot,.category-slug{display:none}}
