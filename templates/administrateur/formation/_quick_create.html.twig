{% form_theme form 'bootstrap_5_layout.html.twig' %}
{{ form_start(form, {attr: {'data-quick-create-form': '', 'data-turbo': 'false'}}) }}
{{ form_errors(form) }}
{% if kind == 'categorie' %}<p class="text-muted">Choisissez une catégorie parente pour créer une sous-catégorie.</p>{% endif %}
{% if kind == 'formateur' %}<p class="text-muted">Sélectionnez un utilisateur existant ou renseignez une nouvelle personne. Son accès pourra être activé depuis la gestion des utilisateurs.</p>{% endif %}
{{ form_widget(form) }}
<div class="d-flex justify-content-end gap-2 mt-4">
<button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
<button type="submit" class="btn btn-warning">Créer et sélectionner</button>
</div>
{{ form_end(form) }}
