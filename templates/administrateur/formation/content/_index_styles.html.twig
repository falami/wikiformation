.curriculum-editor{--ce-ink:#233d50;--ce-muted:#738799;--ce-line:#e1e9ef;color:var(--ce-ink);padding-bottom:32px;max-width:1680px;margin:auto}.curriculum-hero{display:flex;justify-content:space-between;align-items:center;gap:28px;padding:34px 38px;border-radius:22px;background:radial-gradient(ellipse at top right,#42617266,transparent 65%),#1c3443;color:white;border:1px solid #385161;box-shadow:0 12px 30px #203d5010;margin-bottom:28px}.curriculum-eyebrow{font-size:10px;font-weight:750;letter-spacing:.16em;color:#7b91a2}.curriculum-hero .curriculum-eyebrow{color:#e9c66c}.curriculum-hero h1{font-size:clamp(25px,2.6vw,38px);font-weight:750;letter-spacing:-.04em;margin:10px 0;overflow-wrap:anywhere}.curriculum-hero p{color:#c0d0db;font-size:14px;margin:0 0 20px}.curriculum-context{display:inline-flex;gap:8px;align-items:center;font-size:12px;color:#d7e3ea}.curriculum-hero-actions{display:flex;flex-direction:column;align-items:stretch;gap:14px;flex-shrink:0}.curriculum-back{color:#d4e1ea;text-decoration:none;font-size:12px;text-align:center}.curriculum-back:hover{color:#fff}.curriculum-add{display:flex;align-items:center;justify-content:center;gap:10px;background:#f5c749;color:#243747;border:1px solid #f5c749;border-radius:12px;padding:13px 18px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 4px 14px #0000000d}.curriculum-add:hover{background:#ffda6b;color:#182f3f}.curriculum-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:30px 0 20px}.curriculum-toolbar h2{font-size:21px;font-weight:700;margin:7px 0;letter-spacing:-.025em}.curriculum-toolbar h2 span{display:inline-block;font-size:11px;font-weight:550;color:#667e90;background:#edf3f7;border:1px solid var(--ce-line);padding:5px 9px;border-radius:8px;vertical-align:middle;margin-left:10px}.curriculum-toolbar p{font-size:12px;color:var(--ce-muted);margin:0}.curriculum-toolbar p i{margin-right:7px}.curriculum-editor .tree,.curriculum-editor .child-list{list-style:none;padding:0}.curriculum-editor .tree{margin:0;display:grid;gap:20px}.curriculum-editor .node-card{background:#fff;border:1px solid var(--ce-line);border-radius:18px;box-shadow:0 6px 22px #203d5005;min-width:0}.curriculum-editor .node-header{display:flex;align-items:center;gap:14px;padding:22px 24px;color:var(--ce-ink)}.curriculum-editor .chapter-root>.node-header{background:linear-gradient(110deg,#f7f9fb,#fffdf6);border-radius:18px 18px 0 0;border-top:3px solid #e5bf5c}.curriculum-editor .drag{color:#a0afbb;cursor:grab;padding:8px 2px;flex-shrink:0}.curriculum-editor .drag:active{cursor:grabbing}.chapter-number{display:grid;place-items:center;min-width:42px;height:42px;padding:0 7px;border-radius:12px;background:#eaf0f5;color:#46667d;font-size:14px;font-weight:750;font-variant-numeric:tabular-nums}.chapter-copy{flex:1;min-width:0}.chapter-kind{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#8e773a;font-weight:700}.chapter-copy h3{font-size:17px;font-weight:650;letter-spacing:-.015em;margin:4px 0 8px;line-height:1.45;overflow-wrap:anywhere}.chapter-details{display:flex;align-items:center;flex-wrap:wrap;gap:14px;color:var(--ce-muted);font-size:11px}.chapter-details i{margin-right:4px}.chapter-details .chapter-draft{background:#fff3d6;color:#8e6719;padding:3px 8px;border-radius:5px;font-weight:600}.chapter-actions{display:flex;align-items:center;gap:7px;flex-shrink:0}.chapter-actions .btn{display:inline-grid;place-items:center;width:34px;height:34px;padding:0;border:1px solid #dfe7ed;border-radius:9px;background:white;color:#698092;font-size:12px}.chapter-actions .btn-outline-success{color:#427b69;background:#f0f8f5;border-color:#d6e9e0}.chapter-actions .btn:hover{background:#edf3f7;color:#264a61}.chapter-actions .btn-outline-danger:hover{background:#fff1f0;color:#ba4f47;border-color:#edcbc7}.curriculum-editor .child-list{margin:0 24px 18px 52px;border-left:1px solid #dae4eb;padding-left:20px}.curriculum-editor .child-list>.node-card{position:relative;border:0;border-bottom:1px solid #edf1f5;border-radius:0;box-shadow:none}.curriculum-editor .child-list>.node-card:last-child{border-bottom:0}.curriculum-editor .child-list>.node-card:before{content:'';position:absolute;left:-20px;top:39px;width:20px;height:1px;background:#dae4eb}.curriculum-editor .child-list .node-header{padding:16px 12px;gap:12px}.curriculum-editor .child-list .node-header:hover{background:#f8fafc;border-radius:12px}.curriculum-editor .child-list .chapter-number{min-width:35px;height:30px;font-size:11px;background:#f2f6f9;border-radius:7px}.curriculum-editor .child-list h3{font-size:14px;margin:0 0 6px;font-weight:600}.curriculum-editor .child-list .chapter-kind{display:none}.curriculum-editor .chapter-ghost{opacity:.35;background:#fff5d6}.curriculum-empty{text-align:center;padding:55px 24px;border:1px dashed #ccdbe5;border-radius:18px;background:#f8fafc;color:var(--ce-muted)}.curriculum-empty>i{font-size:34px;color:#b5984f}.curriculum-empty h3{color:var(--ce-ink);font-size:20px;margin:14px 0 8px}.curriculum-empty p{font-size:13px}.curriculum-editor a:focus-visible,.curriculum-editor button:focus-visible{outline:3px solid #e5bf5c;outline-offset:3px}#curriculum-status:not(:empty){padding:10px 14px;background:#f0f6f9;border-radius:8px;color:#42687e;font-size:12px;margin-bottom:15px}
@media(max-width:800px){.curriculum-hero{padding:26px;align-items:start;flex-direction:column}.curriculum-hero-actions{flex-direction:row;align-items:center;flex-wrap:wrap}.curriculum-toolbar{align-items:start;flex-direction:column;gap:5px}.curriculum-editor .node-header{padding:16px 12px;gap:9px}.curriculum-editor .child-list{margin-left:26px;margin-right:10px;padding-left:12px}.curriculum-editor .child-list>.node-card:before{left:-12px;width:12px}.chapter-copy h3{font-size:15px}.chapter-actions{gap:4px}.chapter-number{min-width:30px;height:32px}.chapter-details{gap:7px}}
@media(max-width:500px){.curriculum-editor .node-header{flex-wrap:wrap}.chapter-copy{flex-basis:65%}.chapter-actions{margin-left:auto}.curriculum-editor .child-list .node-header{gap:7px}.curriculum-toolbar h2 span{margin:7px 0 0}.curriculum-hero-actions{flex-direction:column;align-items:stretch;width:100%}}
