.chapter-editor{color:#263e50;max-width:1500px;margin:auto;padding-bottom:30px}.chapter-editor-hero{padding:30px 34px;background:linear-gradient(115deg,#1b3342,#305264);border-radius:22px;color:white;display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:28px}.editor-eyebrow{font-size:11px;font-weight:650;letter-spacing:.13em;color:#e4c470;text-transform:uppercase}.chapter-editor-hero h1{font-size:30px;letter-spacing:-.035em;font-weight:750;margin:10px 0}.chapter-editor-hero p{font-size:14px;color:#c1d1dc;margin:0}.chapter-editor-hero>a{color:#edf4f8;border:1px solid #6c8290;border-radius:10px;padding:11px 16px;text-decoration:none;font-size:12px;white-space:nowrap}.chapter-editor .card{border:1px solid #dfe7ee;border-radius:18px;box-shadow:0 5px 22px #23334205!important;overflow:visible}.chapter-editor .card-header{border-radius:18px 18px 0 0;background:#fafcfd!important;border-bottom:1px solid #e6edf2;padding:19px 24px;color:#2b4356!important;font-size:15px;font-weight:700}.chapter-editor .card-body{padding:26px}.chapter-field label{display:block;font-size:12px;font-weight:650;color:#536e83;margin-bottom:9px}.chapter-editor .form-control,.chapter-editor .form-select,.chapter-editor .ts-control{border:1px solid #dbe5ed!important;border-radius:10px!important;box-shadow:none!important;background:#fff!important;color:#263e50!important;min-height:48px;padding:12px 14px!important;font-size:14px}.chapter-editor .form-control:focus,.chapter-editor .ts-wrapper.focus .ts-control{border-color:#b49b54!important;box-shadow:0 0 0 3px #e6c36620!important}.chapter-editor .ts-wrapper{padding:0!important;border:0!important}.chapter-editor .ts-dropdown{border:1px solid #dce5ed;border-radius:12px;box-shadow:0 12px 30px #23334218;z-index:30;overflow:hidden}.chapter-editor .ts-dropdown .option{padding:11px 14px}.chapter-editor .ts-dropdown .active{background:#f3f7fa;color:#233d50}.chapter-editor .form-text{font-size:12px;line-height:1.6;color:#7b8e9e;margin-top:9px}.chapter-editor .row{--bs-gutter-x:24px;--bs-gutter-y:22px}.chapter-editor .chapter-publication{position:relative;padding:18px 70px 18px 18px;background:#f5f9fb;border:1px solid #e1eaf0;border-radius:12px;margin:0}.chapter-publication .form-check-input{float:none;position:absolute;right:20px;top:20px;width:42px;height:23px;margin:0;cursor:pointer;border-color:#cbd8e2}.chapter-publication .form-check-input:checked{background-color:#315e72;border-color:#315e72}.chapter-publication label{font-size:14px;font-weight:650;cursor:pointer}.chapter-savebar{padding:17px 20px;background:#fff;border:1px solid #e2e9ef;border-radius:14px;align-items:center}.chapter-savebar .btn{font-size:13px;font-weight:650;padding:11px 18px;border-radius:10px}.chapter-savebar .btn-gradient{background:#233f51;color:white;border:1px solid #233f51}.chapter-savebar .btn-secondary{background:#f4f7f9;color:#61788b;border:1px solid #dfe7ee}.chapter-editor #tree-card{margin-top:32px!important}.chapter-editor .node-card{background:#fff;border:1px solid #e1e9ef;border-radius:12px;padding:14px 16px}.chapter-editor .tree>.node>.node-card{border-top:3px solid #dabe74;background:linear-gradient(110deg,#f8fafc,#fff)}.chapter-editor .node-title{color:#2b4355;font-size:14px;font-weight:650;overflow-wrap:anywhere}.chapter-editor .node-left{flex-wrap:wrap;min-width:0;gap:10px}.chapter-editor .node-header{gap:16px}.chapter-editor .badge-soft{background:#edf3f7;border:1px solid #e0e8ef;color:#6d8496;font-size:10px;white-space:nowrap;padding:4px 8px;border-radius:6px}.chapter-editor .drag{color:#98aab8;padding:5px}.chapter-editor .child-list{border-left:1px solid #dce6ee;margin:15px 0 0 16px;padding-left:16px}.chapter-editor .child-list>.node{margin-top:8px}.chapter-editor .child-list .node-card{border:0;border-bottom:1px solid #e9eff4;border-radius:0;background:white;padding:13px 5px}.chapter-editor .node-actions{flex-shrink:0}.chapter-editor .node-actions .btn{display:grid;place-items:center;width:32px;height:32px;padding:0;border:1px solid #dde6ed;color:#637f93;border-radius:8px;background:#fff;font-size:12px}.chapter-editor .node-actions .btn:hover{background:#edf4f8;color:#244d63}.chapter-editor .node-actions .btn-outline-danger:hover{color:#bc4f49;background:#fff2f0;border-color:#edcdc8}.chapter-editor a:focus-visible,.chapter-editor button:focus-visible{outline:3px solid #dabe74;outline-offset:3px}
