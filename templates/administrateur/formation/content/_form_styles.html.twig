/* Editorial accents and a compact live preview. */
.chapter-editor-hero{position:relative;overflow:hidden;border:1px solid #365668;box-shadow:0 12px 35px #2037460d}.chapter-editor-hero:before{content:'';position:absolute;left:0;top:28px;bottom:28px;width:4px;background:#e6c36c;border-radius:0 4px 4px 0}.chapter-editor .card-header{display:flex;align-items:center;gap:8px;background:linear-gradient(100deg,#f8fafc,#fffdf7)!important;font-size:14px;padding:21px 26px}.chapter-editor .card-header>i{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:#fcf3d9;color:#a47e2b!important}.chapter-editor .chapter-field>label{font-size:11px;letter-spacing:.025em;margin-bottom:10px}.chapter-editor .chapter-field select{appearance:auto}.chapter-editor .chapter-field .ts-wrapper .ts-control{border:1px solid #dbe5ed!important;box-shadow:0 2px 4px #23334203!important;min-height:48px!important;padding-right:35px!important}.chapter-editor .chapter-field .ts-wrapper.single .ts-control:after{content:'';position:absolute;right:16px;top:19px;width:7px;height:7px;border-right:1.5px solid #71899c;border-bottom:1.5px solid #71899c;transform:rotate(45deg)}.chapter-editor .form-control{background:#fcfdfe!important}.chapter-slug-help{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:10px;font-size:11px;color:#7d8f9e}.chapter-slug-help button{flex-shrink:0;border:1px solid #dce6ee;border-radius:7px;background:white;padding:5px 8px;color:#4d6d83;font-size:11px}.chapter-slug-help button:hover{background:#fff7e2}.chapter-preview{height:100%;min-height:98px;background:linear-gradient(120deg,#f0f5f8,#fafcfd);border:1px solid #e0e9f0;border-radius:12px;padding:16px 18px;display:grid;grid-template-columns:1fr auto;gap:8px 14px;align-content:center}.chapter-preview .editor-eyebrow{grid-column:1/-1;font-size:9px;color:#7b91a2}.chapter-preview strong{font-size:14px;font-weight:650;overflow-wrap:anywhere}.chapter-preview>span:last-child{font-size:11px;color:#56788d;align-self:center;white-space:nowrap}.chapter-editor .chapter-publication{padding-left:20px!important}.chapter-editor .chapter-publication label{line-height:1.6}.chapter-editor .card{box-shadow:0 8px 28px #21394b06!important}.chapter-editor .chapter-savebar{border-top:2px solid #e2c779}
@media(max-width:540px){.chapter-slug-help{align-items:start;flex-direction:column}.chapter-preview{min-height:88px}}
