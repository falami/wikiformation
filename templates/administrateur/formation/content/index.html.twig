{# templates/administrateur/formation/content/index.html.twig #}
{% extends 'base_admin.html.twig' %}
{% block title %}Contenu pédagogique - {{ formation.titre }}{% endblock %}





{% block stylesheets %}
{{ parent() }}
<style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }


  <
  {% include 'administrateur/formation/content/_index_styles.html.twig' %}
  </style>
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/quality.css') }}">
{% endblock %}



{% block body %}

<div class="curriculum-editor">
  <header class="curriculum-hero">
    <div><span class="curriculum-eyebrow">CATALOGUE / PROGRAMME DE FORMATION</span>
      <h1>{{ formation.titre }}</h1>
      <p>Composez un parcours clair, chapitre après chapitre.</p>
      <span class="curriculum-context"><i class="bi bi-building"></i> {{ entite.nom }}</span>
    </div>
    <div class="curriculum-hero-actions">
      <a class="curriculum-back" href="{{ path('app_administrateur_formation_index', {entite: entite.id}) }}"><i class="bi bi-arrow-left"></i> Retour au catalogue</a>
      <a class="curriculum-add" href="{{ path('app_administrateur_formation_content_node_add', {entite: entite.id, formation: formation.id}) }}"><i class="bi bi-plus-lg"></i> Ajouter un chapitre</a>
    </div>
  </header>
  {% include 'flagMessage.html.twig' %}
  <div class="curriculum-toolbar">
    <div><span class="curriculum-eyebrow">CONTENU PÉDAGOGIQUE</span><h2>Structure du programme <span>{{ roots|length }} chapitre{{ roots|length > 1 ? 's' : '' }}</span></h2></div>
    <p><i class="fa fa-grip-vertical"></i> Glissez les poignées pour réorganiser</p>
  </div>
  <div id="curriculum-status" role="status" aria-live="polite"></div>

  {# 1) changer la signature du macro #}
{% macro renderNode(node, entite, formation, number) %}
  <li class="node-card {{ node.parent is null ? 'chapter-root' : 'chapter-child' }}" data-node-id="{{ node.id }}">
    <div class="node-header">
      <span class="drag" title="Déplacer le chapitre"><i class="fa fa-grip-vertical"></i></span>
      <span class="chapter-number">{{ number }}</span>
      <div class="chapter-copy">
        <span class="chapter-kind">{{ node.parent is null ? 'Chapitre' : 'Sous-chapitre' }}</span>
        <h3>{{ node.titre }}</h3>
        <div class="chapter-details">
          <span><i class="bi bi-clock"></i> {{ node.dureeMinutes is not null ? node.dureeMinutes ~ ' min' : 'Durée à renseigner' }}</span>
          {% if node.children|length %}<span><i class="bi bi-diagram-3"></i> {{ node.children|length }} sous-chapitre{{ node.children|length > 1 ? 's' : '' }}</span>{% endif %}
          {% if not node.isPublished %}<span class="chapter-draft">Brouillon</span>{% endif %}
        </div>
      </div>
      <div class="chapter-actions">
        <div class="add-btns d-inline-block">
          {# ✅ Sous-chapitre uniquement si node est un chapitre racine #}
          {% if node.parent is null %}
            <a class="btn btn-sm btn-outline-success"
              href="{{ path('app_administrateur_formation_content_node_add', {
                entite: entite.id,
                formation: formation.id,
                parentId: node.id,
                copyFromId: node.id
              }) }}"
              title="Ajouter un sous-chapitre" aria-label="Ajouter un sous-chapitre à {{ node.titre }}"
            >
              <i class="fa fa-plus"></i>
            </a>
          {% endif %}
        </div>

        <a class="btn btn-sm btn-outline-secondary"
          href="{{ path('app_administrateur_formation_content_node_edit', {entite: entite.id, formation: formation.id, node: node.id}) }}">
          <i class="fa fa-pen" aria-hidden="true"></i><span class="visually-hidden">Modifier {{ node.titre }}</span>
        </a>

        <form action="{{ path('app_administrateur_formation_content_node_delete', {entite: entite.id, formation: formation.id, node: node.id}) }}"
              method="post" class="d-inline">
          <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Supprimer ce chapitre ?')">
            <i class="fa fa-trash" aria-hidden="true"></i><span class="visually-hidden">Supprimer {{ node.titre }}</span>
          </button>
        </form>
      </div>
    </div>


    {% if node.children|length %}
      <ul class="child-list">
        {% for c in node.children %}
          {{ _self.renderNode(c, entite, formation, number ~ '.' ~ loop.index) }}
        {% endfor %}
      </ul>
    {% endif %}
  </li>
{% endmacro %}

{# 2) appels : passer entite et formation #}
<ul class="tree" id="tree-root" data-reorder-url="{{ path('app_administrateur_formation_content_node_reorder', {entite: entite.id, formation: formation.id}) }}">
  {% for r in roots %}
    {{ _self.renderNode(r, entite, formation, loop.index) }}
  {% else %}
    <li class="curriculum-empty"><i class="bi bi-journal-richtext"></i><h3>Le début d’un nouveau parcours</h3><p>Ajoutez votre premier chapitre pour structurer cette formation.</p></li>
  {% endfor %}
</ul>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function () {



  // Réordonnancement chapitres/sous-chapitres
  const tree = document.getElementById('tree-root');
  if (!tree) {
    // Rien à initialiser (section absente ou non rendue)
    return;
  }
  makeSortableRecursive(tree);

  function makeSortableRecursive(ul){
    if (!(ul instanceof HTMLElement)) return;
    new Sortable(ul, {
      group: 'nodes',
      animation: 150,
      handle: '.drag',
      fallbackOnBody: true,
      swapThreshold: 0.65,
      ghostClass: 'chapter-ghost',
      onEnd: sendOrder
    });

    // Ne cibler que les UL enfant qui portent la classe .child-list
    ul.querySelectorAll(':scope > li > .child-list').forEach(function(childList){
      if (childList instanceof HTMLElement) makeSortableRecursive(childList);
    });
  }

  async function sendOrder(){
    const payload = collectNodes(tree, null);
    const status = document.getElementById('curriculum-status');
    status.textContent = 'Enregistrement de l’ordre…';
    try {
    const response = await fetch(tree.dataset.reorderUrl, {
      method: 'POST',
      headers: {'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
      body: JSON.stringify(payload)
    });
    if (!response.ok) throw new Error('save');
    status.textContent = 'Ordre enregistré';
    renumber(tree, '');
    } catch (error) {
      status.textContent = 'L’ordre n’a pas pu être enregistré. Rechargez la page avant de réessayer.';
    }
  }

  function renumber(ul, prefix){
    [...ul.children].filter(li => li.matches('[data-node-id]')).forEach((li, index) => {
      const number = prefix + (index + 1);
      li.querySelector(':scope > .node-header > .chapter-number').textContent = number;
      const children = li.querySelector(':scope > .child-list');
      if (children) renumber(children, number + '.');
    });
  }

  function collectNodes(ul, parentId){
    const out = [];
    if (!(ul instanceof HTMLElement)) return out;
    [...ul.children].forEach((li, idx)=>{
      if (!li.matches('li[data-node-id]')) return;
      const id = parseInt(li.dataset.nodeId, 10);
      out.push({ id, position: idx, parentId });
      const child = li.querySelector(':scope > .child-list');
      if (child) out.push(...collectNodes(child, id));
    });
    return out;
  }

});
</script>

{% endblock %}
