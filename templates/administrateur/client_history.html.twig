{% extends 'base_admin.html.twig' %}
{% block title %}Échanges client · {{ document.numero }}{% endblock %}
{% block body %}
<div class="container py-4" style="max-width:1100px">
  <a class="btn btn-outline-secondary mb-4" href="{{ path(type == 'convention' ? 'app_administrateur_convention_show' : 'app_administrateur_' ~ type ~ '_show', {entite:entite.id,id:document.id}) }}">← Retour au document</a>
  <h1>Échanges avec le client</h1>
  <p class="text-muted">{{ document.numero }} · Historique des e-mails et informations enregistrés dans votre organisme.</p>
  <p class="small text-muted">Les réponses reçues dans votre messagerie externe ne sont pas synchronisées ici. Les échanges liés aux mêmes coordonnées peuvent concerner plusieurs dossiers.</p>
  {% for event in events %}
    {% set item = event.entry %}
    <article class="card shadow-sm mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2"><span class="badge bg-light text-dark">{{ event.mail ? 'E-mail' : item.channel.label }}</span><time class="text-muted small">{{ event.date|date('d/m/Y à H:i') }}</time></div>
        <h2 class="h5">{{ event.mail ? item.subject : item.title }}</h2>
        {% if event.mail %}
          <p class="small text-muted">À : {{ item.toEmail }} · {{ item.status == 'SENT' ? 'Envoyé' : (item.status == 'FAILED' ? 'Échec de l’envoi' : 'En attente') }}</p>
          {% if item.bodyHtmlSnapshot %}<details><summary class="text-primary">Lire le message</summary><div class="mt-3" style="white-space:pre-wrap;overflow-wrap:anywhere">{{ item.bodyHtmlSnapshot|striptags }}</div></details>{% else %}<p class="text-muted">Le contenu de cet ancien message n’a pas été archivé.</p>{% endif %}
        {% else %}<div style="white-space:pre-wrap;overflow-wrap:anywhere">{{ item.content }}</div>{% endif %}
      </div>
    </article>
  {% else %}<div class="alert alert-light border">Aucun échange enregistré pour ce client.</div>{% endfor %}
  <nav class="d-flex gap-3" aria-label="Pages de l’historique">
    {% if page > 1 %}<a class="btn btn-outline-secondary" href="{{ path('app_administrateur_client_history',{entite:entite.id,type:type,id:document.id,page:page-1}) }}">Précédent</a>{% endif %}
    {% if hasNext %}<a class="btn btn-outline-secondary" href="{{ path('app_administrateur_client_history',{entite:entite.id,type:type,id:document.id,page:page+1}) }}">Suivant</a>{% endif %}
  </nav>
</div>
{% endblock %}
