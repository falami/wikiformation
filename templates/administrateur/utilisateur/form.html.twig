  </div>

  {# important : garder le token CSRF #}
  {{ form_widget(form._token) }}
  {{ form_end(form, { render_rest: false }) }}

<div class="modal fade" id="new-company-modal" tabindex="-1" aria-labelledby="new-company-title" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 rounded-4 shadow-lg">
      <div class="modal-header p-4" style="background:#203b4a;color:white;border-radius:1rem 1rem 0 0">
        <div><div class="small mb-2" style="color:#e0b955">VOTRE RÉPERTOIRE ENTREPRISES</div><h2 class="modal-title h4 fw-bold" id="new-company-title"><i class="bi bi-building-add me-2"></i>Nouvelle entreprise</h2></div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body p-4">
        <p class="text-muted">Créez l’entreprise, puis poursuivez la fiche du stagiaire. Elle sera sélectionnée automatiquement.</p>
        {{ form_start(entrepriseForm, {attr: {id: 'new-company-form'}}) }}
        <div id="new-company-error" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
        <h3 class="h6 fw-bold mb-3">Identité de l’entreprise</h3>
        {{ form_row(entrepriseForm.raisonSociale) }}
        <div class="row g-3"><div class="col-md-6">{{ form_row(entrepriseForm.siret) }}</div><div class="col-md-6">{{ form_row(entrepriseForm.numeroTVA) }}</div></div>
        <h3 class="h6 fw-bold mt-4 mb-3">Contact et adresse <span class="text-muted fw-normal">· facultatif</span></h3>
        <div class="row g-3"><div class="col-md-6">{{ form_row(entrepriseForm.email) }}</div><div class="col-md-6">{{ form_row(entrepriseForm.emailFacturation) }}</div></div>
        <div data-company-google-notice class="small text-muted my-2">
          <button type="button" class="btn btn-sm btn-outline-primary" data-google-choice="allow">Activer les suggestions Google</button>
          <span class="d-block mt-1">Google reçoit votre adresse IP et les adresses recherchées. Votre choix est mémorisé pour ce navigateur.</span>
        </div>
        {{ form_row(entrepriseForm.adresse, {attr: {'data-google-inline': '', autocomplete: 'off'}}) }}
        <div class="row g-3"><div class="col-md-4">{{ form_row(entrepriseForm.codePostal) }}</div><div class="col-md-8">{{ form_row(entrepriseForm.ville) }}</div></div>
        {{ form_row(entrepriseForm.pays) }}
        {{ form_widget(entrepriseForm._token) }}
        {{ form_end(entrepriseForm, {render_rest: false}) }}
        <p class="small text-muted mb-0 mt-3">L’entreprise est enregistrée dès sa création. Enregistrez ensuite la fiche du stagiaire pour confirmer le rattachement.</p>
      </div>
      <div class="modal-footer px-4 py-3"><button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Annuler</button><button id="new-company-submit" type="submit" form="new-company-form" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check2 me-2"></i>Créer et sélectionner</button></div>
    </div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const modal = document.getElementById('new-company-modal');
  document.addEventListener('wiki:enable-google-maps', () => {
    modal.querySelector('[data-company-google-notice]').hidden = true;
  });
  const companyForm = document.getElementById('new-company-form');
  const submit = document.getElementById('new-company-submit');
  const error = document.getElementById('new-company-error');
  let busy = false;
  modal.addEventListener('shown.bs.modal', () => companyForm.querySelector('input:not([type="hidden"])')?.focus());
  modal.addEventListener('hide.bs.modal', event => { if (busy) event.preventDefault(); });
  companyForm.addEventListener('submit', async event => {
    event.preventDefault();
    if (busy) return;
    busy = true; submit.disabled = true;
    const original = submit.innerHTML; submit.textContent = 'Création en cours…';
    error.classList.add('d-none');
    try {
      const response = await fetch(companyForm.action, {method:'POST', body:new FormData(companyForm), headers:{'X-Requested-With':'XMLHttpRequest'}});
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.errors?.join(' ') || data.message || 'La création a échoué. Réessayez.');
      const primary = document.getElementById('{{ form.entreprisesAssociees.vars.id }}');
      if (primary.tomselect) {
        primary.tomselect.addOption({value:String(data.id), text:data.label});
        primary.tomselect.addItem(String(data.id));
      } else {
        primary.add(new Option(data.label, data.id, true, true));
        primary.dispatchEvent(new Event('change', {bubbles:true}));
      }
      document.getElementById('new-company-success').textContent = data.label + ' — entreprise sélectionnée.';
      companyForm.reset(); busy = false;
      bootstrap.Modal.getInstance(modal)?.hide();
      primary.tomselect?.focus();
    } catch (exception) {
      error.textContent = exception.message || 'Impossible de joindre le serveur. Réessayez.';
      error.classList.remove('d-none'); error.focus();
    } finally { busy = false; submit.disabled = false; submit.innerHTML = original; }
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  // ----- Flatpickr -----
  if (window.flatpickr && window.flatpickr.l10ns?.fr) {
    flatpickr.localize(flatpickr.l10ns.fr);
  }
  document.querySelectorAll('.js-flatpickr-date').forEach(el => {
    if (el._flatpickr) return;
    flatpickr(el, { locale: 'fr', dateFormat: 'd/m/Y', allowInput: true });
  });

  // ----- TomSelect helper -----
  function initTomSelectOn(el, opts){
    if (!el) return null;
    if (el.tomselect) return el.tomselect;

    return new TomSelect(el, Object.assign({
      dropdownParent: 'body',
      create: false,
      allowEmptyOption: true,
    }, opts || {}));
  }

  // ----- DOM -----
  const prenomEl = document.getElementById('{{ form.prenom.vars.id }}');
  const nomEl    = document.getElementById('{{ form.nom.vars.id }}');
  const emailEl  = document.getElementById('{{ form.email.vars.id }}');
  const telEl    = document.getElementById('{{ form.telephone.vars.id }}');
  const villeEl  = document.getElementById('{{ form.ville.vars.id }}');

  const ueRolesEl = document.getElementById('{{ form.ueRoles.vars.id }}');
  const entrepriseEl = document.getElementById('{{ form.entreprisesAssociees.vars.id }}');
  const verifiedEl = document.getElementById('{{ form.isVerified.vars.id }}');

  const formateurCard  = document.getElementById('formateur-card');
  const entrepriseCard = document.getElementById('entreprise-card');

  const $r = {
    nom: document.getElementById('resume-nom'),
    email: document.getElementById('resume-email'),
    tel: document.getElementById('resume-tel'),
    roles: document.getElementById('resume-roles'),
    entreprise: document.getElementById('resume-entreprise'),
    ville: document.getElementById('resume-ville'),
    verified: document.getElementById('resume-verified'),
    pill: document.getElementById('resume-valid-pill')
  };

  // ----- PHOTO -----
 const dropzone = document.getElementById('profileDropzone');
  const fileInput = document.getElementById('{{ form.photo.vars.id }}');
  const removeBtn = document.getElementById('profileRemoveBtn');
  const preview = document.getElementById('profilePreview');
  const removePhotoInput = document.getElementById('{{ form.removePhoto.vars.id }}');

  function renderPlaceholder() {
    preview.innerHTML = `
      <div class="profile-placeholder" id="profilePlaceholder">
        <i class="bi bi-person-circle"></i>
      </div>
    `;
  }

  function renderImage(src) {
    preview.innerHTML = `<img src="${src}" alt="Aperçu photo" class="profile-img" id="profilePreviewImg">`;
  }

  function updateRemoveButtonVisibility() {
    const hasCurrentPreview = preview.querySelector('img') !== null;
    removeBtn?.classList.toggle('d-none', !hasCurrentPreview);
  }

  const photoStatus = document.getElementById('profilePhotoStatus');
  const originalPhoto = preview.querySelector('img')?.getAttribute('src');
  let photoRead = 0;
  document.getElementById('profileBrowseBtn')?.addEventListener('click', () => fileInput.click());
  dropzone?.addEventListener('keydown', e => { if (e.target === dropzone && ['Enter', ' '].includes(e.key)) { e.preventDefault(); fileInput.click(); } });
  function handleImageFile(file) {
    const generation = ++photoRead;
    if (!file || !['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 8000000) {
      fileInput.value = '';
      if (originalPhoto && removePhotoInput.value !== '1') renderImage(originalPhoto); else renderPlaceholder();
      updateRemoveButtonVisibility();
      photoStatus.textContent = 'Choisissez une image JPG, PNG ou WebP de 8 Mo maximum.';
      return;
    }
    photoStatus.textContent = file.name + ' · Photo prête à enregistrer.';

    removePhotoInput.value = '0';

    const reader = new FileReader();
    reader.onload = function(e) {
      if (generation !== photoRead) return;
      renderImage(e.target.result);
      updateRemoveButtonVisibility();
    };
    reader.readAsDataURL(file);
  }

  dropzone?.addEventListener('click', (e) => {
    if (
      e.target === fileInput || e.target.closest('#profileRemoveBtn') ||
      e.target.closest('label[for="profileInput"]')
    ) {
      return;
    }
    fileInput?.click();
  });

  fileInput?.addEventListener('change', function() {
    const file = this.files?.[0];
    if (file) {
      handleImageFile(file);
    }
  });

  removeBtn?.addEventListener('click', function() {
    ++photoRead;
    fileInput.value = '';
    photoStatus.textContent = 'La photo sera supprimée après enregistrement.';
    removePhotoInput.value = '1';
    renderPlaceholder();
    updateRemoveButtonVisibility();
  });

  dropzone?.addEventListener('dragover', function(e) {
    e.preventDefault();
    dropzone.classList.add('dragover');
  });

  dropzone?.addEventListener('dragleave', function() {
    dropzone.classList.remove('dragover');
  });

  dropzone?.addEventListener('drop', function(e) {
    e.preventDefault();
    dropzone.classList.remove('dragover');

    if (e.dataTransfer?.files?.length !== 1) { photoStatus.textContent = 'Déposez une seule photo à la fois.'; return; }
    const file = e.dataTransfer?.files?.[0];
    if (file) {
      const dt = new DataTransfer();
      dt.items.add(file);
      fileInput.files = dt.files;
      handleImageFile(file);
    }
  });

  updateRemoveButtonVisibility();

  // Init TomSelect
  const rolesTS = initTomSelectOn(ueRolesEl, {
    plugins: ['remove_button'],
    maxItems: null,
  });

  const entrepriseTS = initTomSelectOn(entrepriseEl, {
    plugins: ['remove_button'], maxItems: null, closeAfterSelect: false,
  });

  // Tous les select multiples du bloc formateur
  document.querySelectorAll('#formateur-card select[multiple]').forEach(select => {
      initTomSelectOn(select, {
          plugins: ['remove_button'],
          maxItems: null,
          closeAfterSelect: false,
          hideSelected: true,
          ...(select.hasAttribute('data-trainer-expertise') ? {
        create: true,
        maxItems: 40,
        maxOptions: 100,
        createFilter: input => input.trim().length > 0 && input.length <= 255 && !/[\x00-\x1F\x7F]/.test(input),
        render: {
          option_create: (data, escape) => '<div class="create">Ajouter « ' + escape(data.input) + ' »</div>',
          no_results: () => '<div class="no-results">Aucune spécialité correspondante. Vous pouvez ajouter la vôtre.</div>'
        }
          } : {}),
      });
  });

  function getSelectedTenantRoles(){
    if (!ueRolesEl) return [];
    if (ueRolesEl.tomselect) return ueRolesEl.tomselect.items || [];
    return Array.from(ueRolesEl.selectedOptions).map(o => o.value);
  }

  function getSelectedTenantRoleLabels(){
    if (!ueRolesEl) return [];
    if (ueRolesEl.tomselect) {
      return (ueRolesEl.tomselect.items || [])
        .map(v => ueRolesEl.tomselect.options[v]?.text)
        .filter(Boolean);
    }
    return Array.from(ueRolesEl.selectedOptions).map(o => o.textContent.trim());
  }

  function refreshBlocks(){
    const roles = getSelectedTenantRoles();

    const hasFormateur  = roles.includes('TENANT_FORMATEUR');
    const hasEntreprise = roles.includes('TENANT_ENTREPRISE') || roles.includes('TENANT_OF');

    formateurCard?.classList.toggle('d-none', !hasFormateur);
    entrepriseCard?.classList.toggle('d-none', !hasEntreprise);

    if (hasFormateur) {
      document.querySelectorAll('#formateur-card select').forEach(s => s.tomselect?.refreshOptions(false));
    }
    if (hasEntreprise) {
      document.querySelectorAll('#entreprise-card select').forEach(s => s.tomselect?.refreshOptions(false));
    }
  }

  function selectedText(selectEl){
    if (!selectEl) return '';
    if (selectEl.tomselect) {
      const items = selectEl.tomselect.items || [];
      return items.map(v => (selectEl.tomselect.options[v]?.text || '')).filter(Boolean).join(', ');
    }
    return Array.from(selectEl.selectedOptions).map(o => o.textContent.trim()).join(', ');
  }

  function refreshResume(){
    const fullName = `${(prenomEl?.value||'').trim()} ${(nomEl?.value||'').trim()}`.trim();
    $r.nom && ($r.nom.textContent = fullName || '-');
    $r.email && ($r.email.textContent = (emailEl?.value||'').trim() || '-');
    $r.tel && ($r.tel.textContent = (telEl?.value||'').trim() || '-');
    $r.ville && ($r.ville.textContent = (villeEl?.value||'').trim() || '-');

    const rolesTxt = getSelectedTenantRoleLabels().join(', ');
    $r.roles && ($r.roles.textContent = rolesTxt || '-');

    const entTxt = Array.from(entrepriseEl?.selectedOptions || []).map(option => option.text).join(', ');
    $r.entreprise && ($r.entreprise.textContent = entTxt || '-');

    $r.verified && ($r.verified.textContent = verifiedEl?.checked ? 'Oui' : 'Non');

    const ok =
      !!((prenomEl?.value||'').trim()) &&
      !!((nomEl?.value||'').trim()) &&
      !!((emailEl?.value||'').trim()) &&
      getSelectedTenantRoles().length > 0;

    if ($r.pill) {
      $r.pill.textContent = ok ? '✅ Complet' : '⚠️ Incomplet';
      $r.pill.style.background = ok ? 'rgba(25,135,84,.15)' : 'rgba(255,193,7,.15)';
      $r.pill.style.borderColor = ok ? 'rgba(25,135,84,.35)' : 'rgba(255,193,7,.35)';
      $r.pill.style.color = 'var(--ink)';
    }
  }

  rolesTS?.on('change', () => { refreshBlocks(); refreshResume(); });
  entrepriseTS?.on('change', refreshResume);

  [prenomEl, nomEl, emailEl, telEl, villeEl].forEach(el => {
    el?.addEventListener('input', refreshResume);
    el?.addEventListener('change', refreshResume);
  });
  verifiedEl?.addEventListener('change', refreshResume);

  refreshBlocks();
  refreshResume();
});
</script>





</div>
