{% extends 'base.html.twig' %}
{% block title %}E-mail #{{ log.id }} — {{ u.prenom }} {{ u.nom|upper }}{% endblock %}
{% block body_attributes %}class="mail-archive-page"{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  <style>:root { --mail-primary: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }}; --mail-accent: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }}; }</style>
  <link rel="stylesheet" href="{{ asset('dist/css/email-archive.css') }}">
{% endblock %}
{% block body %}
<main class="mail-archive">
  <header class="mail-heading">
    <div class="mail-heading-icon"><i class="bi bi-envelope-paper" aria-hidden="true"></i></div>
    <div class="mail-heading-copy">
      <p class="mail-eyebrow">Correspondance · {{ entite.nom }}</p>
      <h1>{{ log.subject|default('E-mail sans objet', true) }}</h1>
      <p class="mail-subtitle">Copie archivée de votre message</p>
    </div>
    <span class="mail-reference">Archive #{{ log.id }}</span>
  </header>

  <section class="mail-metadata" aria-label="Informations de l’envoi">
    <div class="mail-meta"><span class="mail-label"><i class="bi bi-person" aria-hidden="true"></i> Contact</span><strong>{{ u.prenom }} {{ u.nom }}</strong></div>
    <div class="mail-meta"><span class="mail-label"><i class="bi bi-clock" aria-hidden="true"></i> Date d’envoi</span><strong>{{ log.sentAt is defined and log.sentAt ? log.sentAt|date('d/m/Y à H:i') : 'Non renseignée' }}</strong></div>
    <div class="mail-meta"><span class="mail-label"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Modèle</span><strong>{{ log.template is defined and log.template ? log.template.name|default(log.template.code|default('Non renseigné')) : 'Non renseigné' }}</strong></div>
  </section>

  {% if log.errorMessage is defined and log.errorMessage %}
    <div class="mail-error" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><div><strong>Une erreur a été enregistrée</strong><p>{{ log.errorMessage }}</p></div></div>
  {% endif %}

  <section class="mail-preview" aria-labelledby="mail-preview-title">
    <div class="mail-preview-heading"><h2 id="mail-preview-title"><i class="bi bi-envelope-open" aria-hidden="true"></i> Aperçu du message</h2><span><i class="bi bi-shield-check" aria-hidden="true"></i> Lecture seule</span></div>
    <div class="mail-notice"><i class="bi bi-info-circle" aria-hidden="true"></i><p>Contenu conservé lors de l’envoi. Les pièces jointes et les images intégrées ne sont pas archivées ici ; les contenus externes sont désactivés. Le logo est affiché depuis le fichier actuel de l’organisme.</p></div>
    {% if log.bodyHtmlSnapshot is defined and log.bodyHtmlSnapshot %}
      <iframe class="mail-frame" title="Copie du mail archivé" sandbox="" referrerpolicy="no-referrer" srcdoc="{{ ('<meta http-equiv="Content-Security-Policy" content="default-src &#39;none&#39;; style-src &#39;unsafe-inline&#39;; img-src data:;">' ~ previewHtml)|e('html_attr') }}"></iframe>
    {% else %}
      <div class="mail-empty"><i class="bi bi-envelope-slash" aria-hidden="true"></i><h3>Aucun aperçu disponible</h3><p>Le contenu de cet envoi n’a pas été archivé. Il ne peut pas être reconstitué à partir du modèle actuel.</p></div>
    {% endif %}
  </section>

  <div class="mail-details">
    {% if log.bodyTextSnapshot is defined and log.bodyTextSnapshot %}
      <details><summary>Version texte du message</summary><pre>{{ log.bodyTextSnapshot }}</pre></details>
    {% endif %}
    <details><summary>Informations techniques de l’envoi</summary><dl><dt>Clé d’idempotence</dt><dd><code>{{ log.idemKey|default('Non renseignée', true) }}</code></dd></dl></details>
  </div>
</main>
{% endblock %}
