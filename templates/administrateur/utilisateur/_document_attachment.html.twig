<div class="ut-attachment {{ represented ? 'ut-attachment--company' : '' }}">
  <span class="ut-attachment-icon"><i class="bi {{ company ? 'bi-buildings' : (direct ? 'bi-person' : 'bi-mortarboard') }}" aria-hidden="true"></i></span>
  <div><strong>{{ company ? company.raisonSociale : (direct ? 'À son nom' : 'Inscription à une formation') }}</strong>
    <small>{% if represented %}Représentant de cette société{% if direct %} · Également destinataire{% endif %}{% elseif direct %}Destinataire du document{% else %}Rattaché par une inscription{% endif %}</small>
  </div>
</div>
