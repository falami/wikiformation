{% block money_widget %}
  <div class="input-group input-euro quote-money">
    {% set attr = attr|merge({class: (attr.class|default('form-control') ~ ' text-end')|trim, inputmode: 'decimal'}) %}
    {{ block('form_widget_simple') }}
    <span class="input-group-text euro-suffix">€</span>
  </div>
{% endblock %}
