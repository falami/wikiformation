{% extends 'base_admin.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}Préparer la convention · {{ devis.numero }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="{{ asset('dist/vendors/flatpickr/flatpickr.min.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/devis-convention.css') }}?v=3">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

      --bg:#f5f7fb;
      --panel:#fff;
      --ink:#0f172a;
      --muted:#64748b;
      --stroke: rgba(15, 23, 42, .10);
      --shadow: 0 18px 55px rgba(15, 23, 42, .10);
      --radius:18px;
    }



    .hero{
      border-radius: 22px;
      position: relative;
      overflow: hidden;
      color: #fff;

      /* Ombre douce premium */
      box-shadow: 0 18px 50px rgba(0,0,0,.14);

      /* Fond piloté par les couleurs de l'entité */
      background:
        /* halo clair (tertiaire) */
        radial-gradient(1200px 420px at 12% -10%,
          color-mix(in srgb, var(--theme-color-tertiaire) 35%, transparent),
          transparent 58%
        ),
        /* halo accent (secondaire) */
        radial-gradient(900px 380px at 92% 0%,
          color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent),
          transparent 60%
        ),
        /* voile subtil (quaternaire) pour la profondeur */
        radial-gradient(700px 260px at 55% 115%,
          color-mix(in srgb, var(--theme-color-quaternaire) 18%, transparent),
          transparent 62%
        ),
        /* dégradé principal (principal -> plus clair) */
        linear-gradient(135deg,
          color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
          color-mix(in srgb, var(--theme-color-principal) 70%, #fff 30%)
        );
    }

    /* léger glass highlight */
    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0) 55%);
      opacity:.85;
    }

    /* barre accent = secondaire (et glow basé sur secondaire) */
    .hero .accent{
      width: 12px;
      border-radius: 999px;
      background: var(--theme-color-secondaire);
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
    }
    /* ===== Chips HERO (comme Sessions) ===== */
    .hero .chip{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      padding:.32rem .7rem;
      border-radius:999px;
      background: rgba(255,255,255,.10);
      border: 1px solid rgba(255,255,255,.14);
      backdrop-filter: blur(6px);
      font-size:.82rem;
      color: rgba(255,255,255,.92);
      white-space: nowrap;
    }
    .hero .chip i{ color: var(--theme-color-secondaire); }

    .hero .chip--pill{
      background: color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
      border-color: color-mix(in srgb, var(--theme-color-secondaire) 28%, rgba(255,255,255,.14));
      color:#fff;
    }

    .hero .subtitle{ opacity:.86; }
    .hero .btn{ border-radius:14px; font-weight:800; }
    .btn-outline-theme{
      border-color: rgba(255,255,255,.35);
      color:#fff;
    }
    .btn-outline-theme:hover{
      background: rgba(255,255,255,.10);
      border-color: rgba(255,255,255,.55);
      color:#fff;
    }

    .cardx{
      background: var(--panel);
      border: 1px solid var(--stroke);
      border-radius: var(--radius);
      box-shadow: 0 10px 28px rgba(15,23,42,.08);
      overflow:visible;
    }
    .cardx-h{
      padding: .95rem 1.05rem;
      display:flex; align-items:center; justify-content:space-between; gap:1rem;
      background: linear-gradient(180deg, rgba(0,0,0,.015), transparent);
      border-bottom: 1px solid var(--stroke);
    }
    .cardx-title{
      margin:0; font-weight:800; letter-spacing:-.01em; color: var(--ink);
      display:flex; align-items:center; gap:.6rem;
    }
    .chip{
      font-size:.78rem; padding:.25rem .55rem; border-radius:999px;
      background: color-mix(in srgb, var(--theme-color-principal) 10%, transparent);
      border: 1px solid color-mix(in srgb, var(--theme-color-principal) 18%, var(--stroke));
      color: var(--muted);
      white-space:nowrap;
    }

    label.form-label{ font-weight: 700; color: var(--ink); }
    .form-text, .text-muted, .small{ color: var(--muted) !important; }
    .form-control, .form-select{
      border-radius: 14px;
      border: 1px solid var(--stroke);
      padding: .65rem .85rem;
    }
    .form-control:focus, .form-select:focus{
      border-color: color-mix(in srgb, var(--theme-color-principal) 55%, var(--stroke));
      box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--theme-color-principal) 18%, transparent);
    }


    @media (max-width:768px){
      .hero{ border-radius:16px; }
    }
  </style>
{% endblock %}


{% block body %}
{% set clientLabel = devis.entrepriseDestinataire ? devis.entrepriseDestinataire.raisonSociale : devis.destinataire.prenom ~ ' ' ~ devis.destinataire.nom %}
{% set routeParams = {entite: entite.id, id: devis.id} %}
<div class="cv-workspace" id="convention-workspace"
     data-submitted="{{ form.vars.submitted ? '1' : '0' }}"
     style="--cv-brand: {{ entite.couleurPrincipal|default('#233342') }}; --cv-accent: {{ entite.couleurSecondaire|default('#e9bd58') }}"
     data-catalogue-title="{{ devis.formation ? devis.formation.titre : '' }}" data-catalogue-duration="{{ devis.formation and devis.formation.duree ? devis.formation.duree ~ (devis.formation.duree > 1 ? ' jours' : ' jour') : '' }}"
     data-individual="{{ devis.destinataire ? '1' : '0' }}" data-individual-id="{{ devis.destinataire ? devis.destinataire.id : '' }}" data-create-session="{{ createSession ? '1' : '0' }}">
  <nav class="cv-breadcrumb" aria-label="Fil d’Ariane">
    <a href="{{ path('app_administrateur_devis_index', {entite: entite.id}) }}">Devis</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
    <a href="{{ path('app_administrateur_devis_show', routeParams) }}">{{ devis.numero }}</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
    <span>Nouvelle convention</span>
  </nav>

  {% for type in ['success', 'warning', 'danger', 'info'] %}
    {% for message in app.flashes(type) %}<div class="alert alert-{{ type }}" role="alert">{{ message }}</div>{% endfor %}
  {% endfor %}
  <div class="cv-notification" id="cv-notification" role="status" aria-live="polite" hidden></div>

  <header class="cv-hero">
    <div class="cv-hero-content">
      <div class="cv-eyebrow"><span></span> DOSSIER DE FORMATION</div>
      <h1>Préparer la convention<span class="cv-heading-dot">.</span></h1>
      <p>Rassemblez la session, les participants et les mentions du document dans un seul dossier.</p>
      <div class="cv-hero-meta">
        <span><i class="bi bi-file-earmark-text" aria-hidden="true"></i>{{ devis.numero }}</span>
        <span><i class="bi bi-building" aria-hidden="true"></i>{{ clientLabel }}</span>
      </div>
    </div>
    <div class="cv-hero-amount">
      <span>Montant du devis</span>
      <strong>{{ (devis.montantTtcCents / 100)|number_format(2, ',', ' ') }} <small>{{ devis.devise == 'EUR' ? '€' : devis.devise }}</small></strong>
      <span class="cv-hero-amount-caption">TTC · Conditions du devis conservées</span>
    </div>
  </header>

  <div class="cv-context-bar">
    <div><i class="bi bi-book" aria-hidden="true"></i><span>Formation du devis<strong>{{ devis.formation ? devis.formation.titre : 'À définir avec la session' }}</strong></span></div>
    <div><i class="bi bi-building-check" aria-hidden="true"></i><span>Organisme<strong>{{ entite.nom }}</strong></span></div>
    <span class="cv-context-status"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Document à vérifier avant signature</span>
  </div>

  <div class="cv-progress" aria-label="Étapes de préparation">
    <span class="is-active" data-step="session"><b>01</b> Session de formation <i class="bi bi-check2" aria-hidden="true"></i></span>
    <span data-step="participants"><b>02</b> Participants <i class="bi bi-check2" aria-hidden="true"></i></span>
    <span data-step="ready"><b>03</b> Convention <i class="bi bi-check2" aria-hidden="true"></i></span>
  </div>

  {{ form_start(form, {attr: {id: 'cv-convention-form', 'data-turbo': 'false'}}) }}
  {{ form_errors(form) }}
  <div class="cv-layout">
    <main class="cv-main">
      <section class="cv-panel" id="cv-session-section" aria-labelledby="cv-session-title">
        <div class="cv-panel-heading">
          <div class="cv-section-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></div>
          <div><span class="cv-section-kicker">ÉTAPE 01</span><h2 id="cv-session-title">La session de formation</h2></div>
          {% if not createSession and is_granted('SESSION_MANAGE', entite) %}
            <a href="{{ path('app_administrateur_devis_convention', routeParams|merge({mode: 'new'})) }}"
               class="cv-button cv-button-soft cv-heading-action" data-quick-create="session"
               data-url="{{ path('app_administrateur_devis_convention_quick_create', routeParams|merge({kind: 'session'})) }}">
              <i class="bi bi-plus-lg" aria-hidden="true"></i> Nouvelle session
            </a>
          {% endif %}
        </div>
        <div class="cv-panel-body">
          {% if createSession %}
            <div class="cv-inline-note mb-3"><i class="bi bi-info-circle" aria-hidden="true"></i><span>La session sera créée en même temps que la convention.</span></div>
            {{ form_row(form.formation) }}
            <div class="cv-label-action"><span></span>
              {% if is_granted('SITE_MANAGE', entite) %}<button type="button" class="cv-text-button" data-quick-create="site" data-url="{{ path('app_administrateur_devis_convention_quick_create', routeParams|merge({kind: 'site'})) }}"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nouveau site</button>{% endif %}
            </div>
            {{ form_row(form.site) }}
            {{ form_row(form.capacite) }}
            <div class="cv-slots-title">Dates & horaires <span>Heure locale</span></div>
            {{ form_errors(form.jours) }}
            {% set nextSlotIndex = 0 %}
            {% for jour in form.jours %}{% set nextSlotIndex = max(nextSlotIndex, jour.vars.name + 1) %}{% endfor %}
            <div data-collection data-prototype="{{ form_widget(form.jours.vars.prototype)|e('html_attr') }}" data-index="{{ nextSlotIndex }}">
              {% for jour in form.jours %}
                <div class="cv-slot" data-slot>{{ form_widget(jour) }}<button type="button" class="cv-slot-remove" data-remove-slot aria-label="Retirer ce créneau"><i class="bi bi-trash3" aria-hidden="true"></i></button></div>
              {% endfor %}
            </div>
            {% do form.jours.setRendered %}
            <button type="button" class="cv-button cv-button-soft" data-add-slot><i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter un créneau</button>
            <a class="cv-text-button ms-2" href="{{ path('app_administrateur_devis_convention', routeParams) }}">Choisir une session existante</a>
          {% else %}
            <div class="cv-section-intro"><p class="cv-section-description">Recherchez par formation, numéro ou date. Toutes les sessions non annulées avec une formation du catalogue sont accessibles.</p><span class="cv-library-count" id="cv-session-count"></span></div>
            {{ form_row(form.session, {label: 'Session de formation', attr: {'data-placeholder': 'Rechercher une formation, une session, une date…'}}) }}
            <div class="cv-formation-confirmation" id="cv-training-confirmation">
              <div><i class="bi bi-info-circle" aria-hidden="true"></i><strong>Une autre formation pour cette convention</strong></div>
              <p>Le devis porte sur « {{ devis.formation ? devis.formation.titre : 'Formation à définir' }} ». Vérifiez le programme et les montants avant de poursuivre avec une autre formation. Le devis reste inchangé.</p>
              {{ form_row(form.confirmerFormationDifferente) }}
            </div>
            <div class="cv-session-detail" id="cv-session-detail" hidden>
              <div class="cv-selected-session"><span id="cv-session-code" class="cv-code"></span><strong id="cv-session-title-value"></strong><span class="cv-session-selected"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Sélectionnée</span></div>
              <div class="cv-session-facts">
                <div><i class="bi bi-calendar3" aria-hidden="true"></i><span>Dates<strong id="cv-session-dates">—</strong></span></div>
                <div><i class="bi bi-geo-alt" aria-hidden="true"></i><span>Lieu<strong id="cv-session-site">—</strong></span></div>
                <div><i class="bi bi-people" aria-hidden="true"></i><span>Disponibilité<strong id="cv-session-capacity">—</strong></span></div>
              </div>
            </div>
            <div class="cv-empty-session" id="cv-session-empty"><i class="bi bi-calendar-plus" aria-hidden="true"></i><span>Choisissez une session pour retrouver ici son calendrier et son lieu.</span></div>
          {% endif %}
        </div>
      </section>

      <section class="cv-panel" aria-labelledby="cv-document-details-title">
        <div class="cv-panel-heading">
          <div class="cv-section-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></div>
          <div><span class="cv-section-kicker">VOTRE DOCUMENT</span><h2 id="cv-document-details-title">Personnaliser la formation</h2></div>
          <button type="button" class="cv-text-button cv-heading-action" id="cv-reset-training"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reprendre la session</button>
        </div>
        <div class="cv-panel-body">
          <p class="cv-section-description">Adaptez l’intitulé, les indices d’habilitation et la durée demandés par votre client.</p>
          {{ form_row(form.intituleFormation) }}
          {{ form_row(form.dureeFormation) }}
          <p class="cv-field-hint"><i class="bi bi-info-circle" aria-hidden="true"></i> Ces mentions sont propres à cette convention. La fiche formation et le programme du catalogue restent inchangés.</p>
        </div>
      </section>

      <section class="cv-panel" aria-labelledby="cv-participants-title">
        <div class="cv-panel-heading">
          <div class="cv-section-icon"><i class="bi bi-people" aria-hidden="true"></i></div>
          <div><span class="cv-section-kicker">ÉTAPE 02</span><h2 id="cv-participants-title">Les participants <span class="cv-count" data-participant-count>{{ devis.destinataire ? 1 : 0 }}</span></h2></div>
          {% if form.stagiaires is defined and is_granted('UTILISATEUR_MANAGE', entite) %}
            <button type="button" class="cv-button cv-button-soft cv-heading-action" data-quick-create="client"
                    data-url="{{ path('app_administrateur_devis_convention_quick_create', routeParams|merge({kind: 'client'})) }}"><i class="bi bi-person-plus" aria-hidden="true"></i> Nouveau client</button>
          {% endif %}
        </div>
        <div class="cv-panel-body">
          {% if form.stagiaires is defined %}
            <p class="cv-section-description">Pour <strong>{{ clientLabel }}</strong>, renseignez les clients connus, les noms seuls ou simplement l’effectif prévu.</p>
            {{ form_row(form.stagiaires, {label: 'Rechercher des clients', help: false}) }}
            <div id="cv-participant-list" class="cv-participant-list" aria-live="polite"></div>
            <div class="cv-participant-empty" id="cv-participant-empty"><div class="cv-empty-avatars"><span><i class="bi bi-person" aria-hidden="true"></i></span><span><i class="bi bi-plus" aria-hidden="true"></i></span></div><strong>La liste n’est pas encore complète ?</strong><p>Vous pouvez préparer la convention avec les informations disponibles ci-dessous.</p></div>
            <div class="cv-provisional-participants">
              <div class="cv-provisional-heading"><i class="bi bi-person-lines-fill" aria-hidden="true"></i><strong>Compléter les participants sans e-mail</strong><span>Facultatif</span></div>
              {{ form_row(form.participantsLibres) }}
              {{ form_row(form.effectifPrevisionnel) }}
              <p class="cv-field-hint" id="cv-roster-status" aria-live="polite"></p>
            </div>
          {% else %}
            <div class="cv-person-row"><span class="cv-avatar">{{ devis.destinataire.prenom|slice(0,1) }}{{ devis.destinataire.nom|slice(0,1) }}</span><span class="cv-person-info"><strong>{{ clientLabel }}</strong><span>{{ devis.destinataire.email }}</span></span><span class="cv-person-badge">Destinataire du devis</span></div>
          {% endif %}
          <div class="cv-inline-note mt-3"><i class="bi bi-link-45deg" aria-hidden="true"></i><span>Les clients sélectionnés seront inscrits à la session si nécessaire. Les noms libres et les places sans nom figurent sur le document ; leurs fiches et inscriptions pourront être complétées ensuite.</span></div>
          <div class="cv-capacity-warning" id="cv-capacity-warning" role="alert" hidden></div>
        </div>
      </section>

      <section class="cv-panel" aria-labelledby="cv-conditions-title">
        <div class="cv-panel-heading">
          <div class="cv-section-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></div>
          <div><span class="cv-section-kicker">POUR FINALISER</span><h2 id="cv-conditions-title">Les conditions financières</h2></div><span class="cv-optional">Facultatif</span>
        </div>
        <div class="cv-panel-body">
          {{ form_row(form.conditionsFinancieres, {label: 'Modalités de règlement et de prise en charge', help: false, attr: {rows: 4, placeholder: 'Ex. : acompte de 30 % à la signature, solde à 30 jours. Prise en charge par l’entreprise…'}}) }}
          <p class="cv-field-hint"><i class="bi bi-info-circle" aria-hidden="true"></i> Ces précisions apparaîtront sur le document, avec les montants du devis.</p>
        </div>
      </section>
    </main>

    <aside class="cv-summary" aria-labelledby="cv-summary-title">
      <div class="cv-summary-head"><span class="cv-section-kicker">VOTRE DOCUMENT</span><span class="cv-draft-badge"><span></span> En préparation</span></div>
      <div class="cv-document-icon"><i class="bi bi-file-earmark-richtext" aria-hidden="true"></i><span><i class="bi bi-check2" aria-hidden="true"></i></span></div>
      <h2 id="cv-summary-title">Convention de formation</h2>
      <p class="cv-summary-subtitle">{{ devis.destinataire ? 'Convention individuelle' : 'Convention entreprise' }}</p>
      <div class="cv-summary-training"><strong id="cv-summary-training-title">{{ form.intituleFormation.vars.value ?: 'Intitulé de la formation' }}</strong><span id="cv-summary-training-duration">{{ form.dureeFormation.vars.value }}</span></div>
      <div class="cv-summary-client"><span>ÉTABLIE POUR</span><strong>{{ clientLabel }}</strong><small>À partir du devis {{ devis.numero }}</small></div>
      <div class="cv-summary-lines">
        <div><span><i class="bi bi-calendar2-week" aria-hidden="true"></i>Session</span><strong id="cv-summary-session">{{ createSession ? 'Nouvelle session' : 'À sélectionner' }}</strong></div>
        <div><span><i class="bi bi-people" aria-hidden="true"></i>Participants</span><strong id="cv-summary-participants">{{ devis.destinataire ? '1 stagiaire' : 'À sélectionner' }}</strong></div>
        <div><span>Montant HT</span><strong>{{ (devis.montantHtCents / 100)|number_format(2, ',', ' ') }} {{ devis.devise == 'EUR' ? '€' : devis.devise }}</strong></div>
        <div><span>TVA</span><strong>{{ (devis.montantTvaCents / 100)|number_format(2, ',', ' ') }} {{ devis.devise == 'EUR' ? '€' : devis.devise }}</strong></div>
      </div>
      <div class="cv-summary-total"><span>Total du devis <small>TTC</small></span><strong>{{ (devis.montantTtcCents / 100)|number_format(2, ',', ' ') }} <small>{{ devis.devise == 'EUR' ? '€' : devis.devise }}</small></strong></div>
      <div class="cv-readiness" id="cv-readiness"><i class="bi bi-circle" aria-hidden="true"></i><span>Complétez la session et les participants.</span></div>
      <div class="cv-checklist" aria-label="Éléments du dossier">
        <div data-check="session"><i class="bi bi-circle" aria-hidden="true"></i><span>Session et lieu sélectionnés</span></div>
        <div data-check="participants"><i class="bi bi-circle" aria-hidden="true"></i><span>Participants ou effectif renseignés</span></div>
        <div data-check="training"><i class="bi bi-circle" aria-hidden="true"></i><span>Intitulé de la convention renseigné</span></div>
      </div>
      <button type="submit" class="cv-button cv-button-primary cv-submit" id="cv-submit"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> {{ createSession ? 'Créer la session et la convention' : 'Créer la convention' }} <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
      <p class="cv-summary-footnote"><i class="bi bi-shield-check" aria-hidden="true"></i> Vous pourrez vérifier le document avant signature.</p>
      <a href="{{ path('app_administrateur_devis_show', routeParams) }}" class="cv-summary-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> Revenir au devis</a>
    </aside>
  </div>
  {{ form_end(form) }}
</div>

<div class="modal fade cv-modal" id="cv-create-modal" tabindex="-1" aria-labelledby="cv-modal-title" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><div class="cv-modal-icon"><i class="bi bi-plus-lg" aria-hidden="true"></i></div><div><div class="cv-section-kicker">COMPLÉTER VOTRE DOSSIER</div><h2 class="modal-title" id="cv-modal-title">Nouvelle session</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button></div>
      <div class="modal-body"><button type="button" id="cv-modal-back" class="cv-text-button mb-3" hidden><i class="bi bi-arrow-left" aria-hidden="true"></i> Revenir à la session</button><div id="cv-modal-content" aria-live="polite"></div></div>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js" defer></script>
  <script src="{{ asset('dist/vendors/flatpickr/flatpickr.min.js') }}" defer></script>
  <script src="{{ asset('dist/js/devis-convention.js') }}?v=3" defer></script>
{% endblock %}
