{# templates/administrateur/finance/dashboard.html.twig #}
{% extends 'base_admin.html.twig' %}

{% block title %}Dashboard Financier{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

      --bg:#f5f7fb; --panel:#fff; --ink:#0f172a; --muted:#64748b;
      --stroke: rgba(15, 23, 42, .10); --shadow: 0 18px 55px rgba(15, 23, 42, .10);
      --radius:18px;
    }


    .hero{
      border-radius: 22px;
      position: relative;
      overflow: hidden;
      color: #fff;

      /* Ombre douce premium */
      box-shadow: 0 18px 50px rgba(0,0,0,.14);

      /* Fond piloté par les couleurs de l'entité */
      background:
        /* halo clair (tertiaire) */
        radial-gradient(1200px 420px at 12% -10%,
          color-mix(in srgb, var(--theme-color-tertiaire) 35%, transparent),
          transparent 58%
        ),
        /* halo accent (secondaire) */
        radial-gradient(900px 380px at 92% 0%,
          color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent),
          transparent 60%
        ),
        /* voile subtil (quaternaire) pour la profondeur */
        radial-gradient(700px 260px at 55% 115%,
          color-mix(in srgb, var(--theme-color-quaternaire) 18%, transparent),
          transparent 62%
        ),
        /* dégradé principal (principal -> plus clair) */
        linear-gradient(135deg,
          color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
          color-mix(in srgb, var(--theme-color-principal) 70%, #fff 30%)
        );
    }

    /* léger glass highlight */
    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0) 55%);
      opacity:.85;
    }

    /* barre accent = secondaire (et glow basé sur secondaire) */
    .hero .accent{
      width: 12px;
      border-radius: 999px;
      background: var(--theme-color-secondaire);
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
    }

    /* ===== Chips HERO (comme Sessions) ===== */
    .hero .chip{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      padding:.32rem .7rem;
      border-radius:999px;
      background: rgba(255,255,255,.10);
      border: 1px solid rgba(255,255,255,.14);
      font-size:.82rem;
      color: rgba(255,255,255,.92);
      backdrop-filter: blur(6px);
      white-space: nowrap;
    }
    .hero .chip i{ color: var(--theme-color-secondaire); }

    /* chip highlight */
    .hero .chip--pill{
      background: color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
      border-color: color-mix(in srgb, var(--theme-color-secondaire) 28%, rgba(255,255,255,.14));
      color:#fff;
    }

    .hero .btn{
      border-radius:14px;
      font-weight:800;
    }
    .meta-chip{ display:inline-flex; align-items:center; gap:.45rem; padding:.35rem .65rem; border-radius:999px; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.14); font-size:.82rem; white-space:nowrap; }
    .btn-outline-theme{ border-color: rgba(255,255,255,.35); color:#fff; }
    .btn-outline-theme:hover{ background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.55); color:#fff; }

    .cardx{ background: var(--panel); border: 1px solid var(--stroke); border-radius: var(--radius); box-shadow: 0 10px 28px rgba(15,23,42,.08); overflow:visible; }
    .cardx-h{ padding: .95rem 1.05rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; background: linear-gradient(180deg, rgba(0,0,0,.015), transparent); border-bottom: 1px solid var(--stroke); }
    .cardx-title{ margin:0; font-weight:800; letter-spacing:-.01em; color: var(--ink); display:flex; align-items:center; gap:.6rem; }
    .chip{ font-size:.78rem; padding:.25rem .55rem; border-radius:999px; background: color-mix(in srgb, var(--theme-color-principal) 10%, transparent); border: 1px solid color-mix(in srgb, var(--theme-color-principal) 18%, var(--stroke)); color: var(--muted); white-space:nowrap; }

    /* ================= KPI ULTRA PREMIUM ================= */
    .kpi-section{
      position: relative;
      overflow: hidden;
    }

    .kpi-section .cardx-h{
      background:
        linear-gradient(180deg, rgba(255,255,255,.72), rgba(255,255,255,.32)),
        linear-gradient(90deg,
          color-mix(in srgb, var(--theme-color-principal) 8%, #fff),
          color-mix(in srgb, var(--theme-color-secondaire) 8%, #fff)
        );
      backdrop-filter: blur(8px);
    }

    .kpi-grid{
      display:grid;
      grid-template-columns: repeat(12, minmax(0,1fr));
      gap: 16px;
    }

    .kpi{
      --kpi-accent: var(--theme-color-principal);
      --kpi-accent-soft: color-mix(in srgb, var(--kpi-accent) 14%, #fff);
      --kpi-accent-line: color-mix(in srgb, var(--kpi-accent) 24%, var(--stroke));

      position: relative;
      grid-column: span 3;
      padding: 16px;
      border-radius: 22px;
      border: 1px solid rgba(255,255,255,.55);
      background:
        linear-gradient(180deg, rgba(255,255,255,.95), rgba(255,255,255,.88)),
        radial-gradient(220px 90px at 100% 0%, color-mix(in srgb, var(--kpi-accent) 10%, transparent), transparent 70%);
      box-shadow:
        0 14px 34px rgba(15,23,42,.08),
        inset 0 1px 0 rgba(255,255,255,.75);
      overflow: hidden;
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

    .kpi::before{
      content:"";
      position:absolute;
      inset:0 auto 0 0;
      width: 5px;
      border-radius: 999px;
      background: linear-gradient(180deg, var(--kpi-accent), color-mix(in srgb, var(--kpi-accent) 55%, #fff));
      opacity: .95;
    }

    .kpi::after{
      content:"";
      position:absolute;
      top:-30%;
      right:-10%;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      background: radial-gradient(circle, color-mix(in srgb, var(--kpi-accent) 14%, transparent), transparent 68%);
      pointer-events:none;
    }

    .kpi:hover{
      transform: translateY(-2px);
      border-color: var(--kpi-accent-line);
      box-shadow:
        0 18px 40px rgba(15,23,42,.12),
        0 0 0 1px color-mix(in srgb, var(--kpi-accent) 10%, transparent),
        inset 0 1px 0 rgba(255,255,255,.85);
    }

    .kpi-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:.8rem;
      margin-bottom: 1rem;
    }

    .kpi-meta{
      min-width: 0;
    }

    .kpi .label{
      margin:0;
      color: var(--muted);
      font-size: .78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
      line-height: 1.25;
    }

    .kpi-badge{
      display:inline-flex;
      align-items:center;
      gap:.35rem;
      margin-top: .4rem;
      padding: .28rem .58rem;
      border-radius: 999px;
      font-size: .72rem;
      font-weight: 800;
      color: color-mix(in srgb, var(--kpi-accent) 68%, #111);
      background: var(--kpi-accent-soft);
      border: 1px solid color-mix(in srgb, var(--kpi-accent) 16%, transparent);
      white-space: nowrap;
    }

    .kpi-icon{
      flex: 0 0 auto;
      width: 44px;
      height: 44px;
      border-radius: 16px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      font-size: 1.05rem;
      color: #fff;
      background:
        linear-gradient(135deg,
          color-mix(in srgb, var(--kpi-accent) 88%, #fff 12%),
          color-mix(in srgb, var(--kpi-accent) 62%, #000 12%)
        );
      box-shadow:
        0 10px 24px color-mix(in srgb, var(--kpi-accent) 28%, transparent),
        inset 0 1px 0 rgba(255,255,255,.35);
    }

    .kpi-body{
      display:flex;
      flex-direction:column;
      gap:.45rem;
    }

    .kpi .value{
      margin:0;
      font-size: clamp(1.35rem, 1.1rem + .8vw, 2rem);
      line-height: 1;
      font-weight: 900;
      letter-spacing: -.03em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }

    .kpi .sub{
      margin:0;
      color: var(--muted);
      font-size: .84rem;
      line-height: 1.4;
      min-height: 2.2em;
    }

    .kpi .sub strong{
      color: var(--ink);
      font-weight: 900;
    }

    .kpi-foot{
      margin-top: .8rem;
      padding-top: .8rem;
      border-top: 1px dashed color-mix(in srgb, var(--kpi-accent) 18%, var(--stroke));
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.75rem;
    }

    .kpi-trend{
      display:inline-flex;
      align-items:center;
      gap:.4rem;
      font-size: .75rem;
      font-weight: 800;
      color: color-mix(in srgb, var(--kpi-accent) 65%, #0f172a);
    }

    .kpi-hint{
      font-size: .73rem;
      color: var(--muted);
      white-space: nowrap;
    }

    /* Variantes couleurs */
    .kpi--gold{ --kpi-accent: #d4a017; }
    .kpi--emerald{ --kpi-accent: #0f9f6e; }
    .kpi--blue{ --kpi-accent: #2563eb; }
    .kpi--violet{ --kpi-accent: #7c3aed; }
    .kpi--rose{ --kpi-accent: #e11d48; }
    .kpi--orange{ --kpi-accent: #f97316; }
    .kpi--slate{ --kpi-accent: #475569; }
    .kpi--danger{ --kpi-accent: #dc3545; }

    /* Variante hero spéciale CA */
    .kpi--hero{
      background:
        linear-gradient(135deg,
          color-mix(in srgb, var(--kpi-accent) 10%, #fff 90%),
          rgba(255,255,255,.96)
        );
      border-color: color-mix(in srgb, var(--kpi-accent) 20%, rgba(255,255,255,.65));
      box-shadow:
        0 18px 40px rgba(15,23,42,.10),
        0 0 0 1px color-mix(in srgb, var(--kpi-accent) 10%, transparent),
        inset 0 1px 0 rgba(255,255,255,.9);
    }

    .kpi--hero .value{
      font-size: clamp(1.55rem, 1.2rem + 1vw, 2.25rem);
    }

    /* Responsive */
    @media (max-width: 1399px){
      .kpi{ grid-column: span 4; }
    }
    @media (max-width: 991px){
      .kpi{ grid-column: span 6; }
    }
    @media (max-width: 768px){
      .kpi-grid{ gap: 12px; }
      .kpi{
        grid-column: span 12;
        border-radius: 18px;
        padding: 14px;
      }
      .kpi-icon{
        width: 40px;
        height: 40px;
        border-radius: 14px;
      }
    }

    @media (max-width: 1200px){ .kpi{ grid-column: span 4; } }
    @media (max-width: 768px){ .kpi{ grid-column: span 12; } .hero{ border-radius:16px; } }

    .nav-pills .nav-link{
      border-radius: 999px;
      border: 1px solid var(--stroke);
      color: var(--ink);
      font-weight: 800;
      background: color-mix(in srgb, var(--panel) 85%, transparent);
    }
    .nav-pills .nav-link.active{
      background: color-mix(in srgb, var(--theme-color-principal) 85%, #0000);
      border-color: color-mix(in srgb, var(--theme-color-principal) 50%, var(--stroke));
      color: #fff;
    }

    .chart-box{ height: 360px; }
    .chart-box.sm{ height: 340px; }  /* ✅ plus gros */

    @media (max-width: 768px){
      .chart-box{ height: 340px; }
      .chart-box.sm{ height: 320px; } /* ✅ garde grand sur mobile */
    }


    /* DataTables polish */
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select{
      border-radius: 999px !important;
      border: 1px solid var(--stroke) !important;
      background: var(--panel) !important;
      color: var(--ink) !important;
      padding: .35rem .75rem !important;
      box-shadow: none !important;
      outline: none !important;
    }
    .dataTables_wrapper .dataTables_paginate .pagination .page-link{
      border-radius: 999px !important;
      border:1px solid var(--stroke) !important;
      color: var(--ink) !important;
      background: var(--panel) !important;
    }
    .dataTables_wrapper .dataTables_paginate .pagination .active .page-link{
      background: color-mix(in srgb, var(--theme-color-principal) 14%, var(--panel)) !important;
      border-color: color-mix(in srgb, var(--theme-color-principal) 35%, var(--stroke)) !important;
      font-weight: 900;
    }
    .money{ font-variant-numeric: tabular-nums; font-weight: 900; white-space: nowrap; }
    .badge-soft{
      border:1px solid var(--stroke);
      background: color-mix(in srgb, var(--theme-color-secondaire) 16%, var(--panel));
      color: var(--ink);
      border-radius: 999px;
      padding: .35rem .6rem;
      font-weight: 800;
      font-size:.78rem;
      white-space: nowrap;
    }

    #fYear{
      border-radius: 999px;
      border: 1px solid var(--stroke);
      background: var(--panel);
      color: var(--ink);
      font-weight: 800;
    }


    /* ===== Filtres : version compacte ===== */
    .filters-compact .row{ --bs-gutter-y: .6rem; --bs-gutter-x: .75rem; }

    .filters-compact .form-label{
      font-size: .78rem;
      margin-bottom: .15rem;
      color: var(--muted);
      font-weight: 800;
    }

    .filters-compact .form-control,
    .filters-compact .form-select{
      padding: .34rem .65rem;
      min-height: 34px;
      border-radius: 12px;
      font-size: .9rem;
    }

    .filters-compact .btn{
      padding: .32rem .6rem;
      border-radius: 12px;
    }

    .filters-compact .btn-group .btn{
      padding: .28rem .55rem;
    }

    .filters-compact .input-inline{
      display:flex;
      align-items:center;
      gap:.5rem;
    }

    .filters-compact .input-inline .form-label{
      margin: 0;
      white-space: nowrap;
      font-size: .78rem;
    }

    /* TomSelect compact */
    .filters-compact .ts-control{
      min-height: 34px !important;
      padding: .18rem .55rem !important;
      border-radius: 12px !important;
    }
    .filters-compact .ts-control .item,
    .filters-compact .ts-control input{
      font-size: .9rem !important;
    }
    .filters-compact .ts-dropdown .option{
      padding: .35rem .6rem !important;
      font-size: .9rem !important;
    }

    /* Flatpickr input compact (utilise ton #fRange) */
    .filters-compact #fRange{
      min-height: 34px;
    }



    /* --- Filtres avancés repliables --- */
    .filters-advanced{
      overflow: hidden;
      transition: max-height .22s ease, opacity .18s ease;
      max-height: 1200px;
      opacity: 1;
    }

    .filters-collapsed .filters-advanced{
      max-height: 0;
      opacity: 0;
      pointer-events: none;
      margin-top: 0 !important;
    }

    .filters-collapsed .cardx-h .chip{
      opacity: .9;
    }

    /* petit bonus : bouton toggle plus “chip” */
    #btnToggleFilters{
      border-radius: 999px;
      border: 1px solid var(--stroke);
      background: color-mix(in srgb, var(--panel) 85%, transparent);
    }


    /* Liste scrollable (comme Dépenses) */
    .dropdown-list{
      border-radius: 12px;
      border: 1px solid var(--stroke);
      background: color-mix(in srgb, var(--panel) 92%, transparent);
      padding: .25rem;
      max-height: 280px;
      overflow: auto;
    }






    /* Actions datatables */
  .dt-actions{
    white-space: nowrap;
  }
  .dt-actions .btn{
    border-radius: 12px;
    padding: .28rem .46rem;
    line-height: 1;
  }
  .dt-actions .btn i{ font-size: 1rem; }
  .dt-actions .btn.btn-light{
    border: 1px solid var(--stroke);
    background: color-mix(in srgb, var(--panel) 92%, transparent);
  }
  .dt-actions .btn.btn-light:hover{
    background: color-mix(in srgb, var(--theme-color-principal) 10%, var(--panel));
  }
  .dt-actions .btn-danger-soft{
    border: 1px solid color-mix(in srgb, #dc3545 35%, var(--stroke));
    background: color-mix(in srgb, #dc3545 10%, var(--panel));
    color: #b4232c;
  }
  .dt-actions .btn-danger-soft:hover{
    background: color-mix(in srgb, #dc3545 16%, var(--panel));
  }

    /* =========================================================
       FINANCE DASHBOARD — EXECUTIVE PREMIUM UI
       Couche visuelle 2026, sans dépendance JS supplémentaire
       ========================================================= */
    :root{
      --fin-bg: #f4f6f9;
      --fin-surface: rgba(255,255,255,.92);
      --fin-surface-solid: #ffffff;
      --fin-ink: #101828;
      --fin-muted: #667085;
      --fin-border: rgba(16,24,40,.075);
      --fin-border-strong: rgba(16,24,40,.12);
      --fin-shadow-xs: 0 1px 2px rgba(16,24,40,.04);
      --fin-shadow-sm: 0 5px 16px rgba(16,24,40,.055);
      --fin-shadow-md: 0 14px 40px rgba(16,24,40,.08);
      --fin-shadow-lg: 0 24px 65px rgba(16,24,40,.12);
      --fin-radius-sm: 12px;
      --fin-radius-md: 18px;
      --fin-radius-lg: 26px;
      --fin-positive: #079455;
      --fin-negative: #d92d20;
      --fin-warning: #dc8a00;
    }

    /* donne de l'air au dashboard sans imposer la structure du base_admin */
    .hero, .filter-panel, .kpi-section, #financeTabs, .tab-content{
      max-width: 100%;
    }

    .min-w-0{min-width:0;}

    /* ---------- HERO ---------- */
    .hero.finance-hero{
      min-height: 218px;
      padding: 1.65rem 1.75rem !important;
      border-radius: 28px;
      border: 1px solid rgba(255,255,255,.18);
      box-shadow: 0 28px 70px rgba(15,23,42,.18), inset 0 1px 0 rgba(255,255,255,.12);
      isolation: isolate;
      background:
        radial-gradient(900px 360px at 84% -10%, color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent), transparent 62%),
        radial-gradient(650px 300px at 8% 115%, rgba(255,255,255,.11), transparent 66%),
        linear-gradient(128deg,
          color-mix(in srgb, var(--theme-color-principal) 91%, #0b1220 9%) 0%,
          color-mix(in srgb, var(--theme-color-principal) 73%, #09111e 27%) 58%,
          color-mix(in srgb, var(--theme-color-principal) 78%, var(--theme-color-secondaire) 22%) 125%);
    }
    .finance-hero::before{
      content:"";
      position:absolute;
      width:440px;height:440px;
      right:-210px;bottom:-330px;
      border:1px solid rgba(255,255,255,.10);
      border-radius:50%;
      box-shadow:0 0 0 46px rgba(255,255,255,.025),0 0 0 92px rgba(255,255,255,.018);
      z-index:-1;
    }
    .finance-hero::after{
      background: linear-gradient(110deg, rgba(255,255,255,.11), transparent 38%, rgba(255,255,255,.035));
      opacity: 1;
      z-index:-1;
    }
    .finance-hero .accent{ width:5px; min-height:100%; box-shadow:none; opacity:.95; }
    .finance-hero__eyebrow{
      display:inline-flex;align-items:center;gap:.45rem;
      padding:.34rem .64rem;border-radius:999px;
      border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.08);
      color:rgba(255,255,255,.82);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
      backdrop-filter:blur(12px);
    }
    .finance-hero__title{font-size:clamp(1.65rem,2.5vw,2.55rem);font-weight:900;letter-spacing:-.04em;line-height:1.05;margin:.9rem 0 .55rem;}
    .finance-hero__subtitle{max-width:720px;color:rgba(255,255,255,.72);font-size:.95rem;line-height:1.6;}
    .finance-hero__actions{display:flex;align-items:center;gap:.65rem;flex-wrap:wrap;}
    .finance-hero__refresh{
      min-height:42px;padding:.55rem .85rem !important;border:1px solid rgba(255,255,255,.25) !important;
      background:rgba(255,255,255,.94) !important;color:#111827 !important;box-shadow:0 10px 28px rgba(0,0,0,.12);
    }
    .finance-hero__refresh:hover{transform:translateY(-1px);background:#fff !important;}
    .finance-hero__meta{
      display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;margin-top:1.1rem;max-width:780px;
    }
    .finance-meta{
      display:flex;gap:.7rem;align-items:center;min-width:0;padding:.68rem .78rem;border-radius:16px;
      border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.075);backdrop-filter:blur(12px);
    }
    .finance-meta__icon{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:rgba(255,255,255,.10);color:var(--theme-color-secondaire);flex:0 0 auto;}
    .finance-meta__label{display:block;font-size:.66rem;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.55);font-weight:800;}
    .finance-meta__value{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:.82rem;color:#fff;font-weight:800;}

    /* ---------- CARDS / SECTIONS ---------- */
    .cardx{
      border:1px solid var(--fin-border) !important;
      border-radius:var(--fin-radius-lg) !important;
      background:var(--fin-surface-solid) !important;
      box-shadow:var(--fin-shadow-sm) !important;
    }
    .cardx-h{
      min-height:64px;padding:1rem 1.2rem !important;
      border-bottom:1px solid var(--fin-border) !important;
      background:linear-gradient(180deg,rgba(248,250,252,.92),rgba(255,255,255,.97)) !important;
    }
    .cardx-title{font-size:.96rem !important;font-weight:850 !important;letter-spacing:-.015em !important;color:var(--fin-ink) !important;}
    .cardx-title > i{
      width:34px;height:34px;display:inline-grid;place-items:center;border-radius:11px;
      color:color-mix(in srgb,var(--theme-color-principal) 84%,#000) !important;
      background:color-mix(in srgb,var(--theme-color-principal) 8%,#fff);
      border:1px solid color-mix(in srgb,var(--theme-color-principal) 10%,transparent);
    }
    .cardx .chip:not(.hero .chip){
      background:#f8fafc;border:1px solid var(--fin-border);color:#667085;font-weight:750;
    }

    /* ---------- FILTERS ---------- */
    .filter-panel{position:relative;overflow:visible !important;box-shadow:var(--fin-shadow-md) !important;}
    .filter-panel::before{content:"";position:absolute;left:22px;right:22px;top:-1px;height:2px;background:linear-gradient(90deg,var(--theme-color-secondaire),color-mix(in srgb,var(--theme-color-secondaire) 20%,transparent),transparent);border-radius:99px;}
    .filters-compact{padding:1.05rem 1.2rem 1.2rem !important;}
    .filters-compact .form-label{font-size:.7rem !important;text-transform:uppercase;letter-spacing:.055em;color:#667085 !important;margin-bottom:.38rem !important;}
    .filters-compact .form-control,.filters-compact .form-select,.filters-compact .ts-control{
      min-height:42px !important;border-radius:13px !important;border:1px solid #e4e7ec !important;background:#fff !important;
      box-shadow:0 1px 2px rgba(16,24,40,.03) !important;transition:border-color .18s ease,box-shadow .18s ease,background .18s ease;
    }
    .filters-compact .form-control:focus,.filters-compact .form-select:focus,.filters-compact .ts-control.focus{
      border-color:color-mix(in srgb,var(--theme-color-principal) 46%,#d0d5dd) !important;
      box-shadow:0 0 0 4px color-mix(in srgb,var(--theme-color-principal) 8%,transparent) !important;
    }
    #btnToggleFilters{min-height:36px;padding:.4rem .72rem;background:#fff !important;box-shadow:var(--fin-shadow-xs);}
    #btnApply{min-height:42px;padding:.55rem 1rem;border:0;border-radius:13px !important;box-shadow:0 8px 20px color-mix(in srgb,var(--theme-color-principal) 18%,transparent);}
    #btnReset{min-height:42px;padding:.55rem .9rem;border:1px solid #e4e7ec;background:#fff;border-radius:13px !important;}
    .dropdown-menu{border:1px solid var(--fin-border) !important;border-radius:16px !important;box-shadow:var(--fin-shadow-lg) !important;}
    .dropdown-list{border-color:#eaecf0 !important;background:#fafafa !important;border-radius:12px !important;}

    /* ---------- KPI ---------- */
    .kpi-section{box-shadow:var(--fin-shadow-md) !important;overflow:hidden !important;}
    .kpi-section .cardx-h{background:#fff !important;}
    .kpi-grid{gap:14px !important;}
    .kpi{
      padding:18px !important;border-radius:20px !important;border:1px solid #eaecf0 !important;background:#fff !important;
      box-shadow:0 1px 3px rgba(16,24,40,.04),0 8px 22px rgba(16,24,40,.035) !important;
      min-height:188px;isolation:isolate;
    }
    .kpi::before{width:3px !important;top:18px !important;bottom:18px !important;left:0 !important;border-radius:0 9px 9px 0 !important;}
    .kpi::after{width:145px !important;height:145px !important;top:-68px !important;right:-68px !important;opacity:.75;}
    .kpi:hover{transform:translateY(-3px) !important;box-shadow:0 16px 36px rgba(16,24,40,.09) !important;}
    .kpi-head{margin-bottom:1.15rem !important;}
    .kpi-icon{width:42px !important;height:42px !important;border-radius:13px !important;font-size:1rem !important;box-shadow:0 8px 18px color-mix(in srgb,var(--kpi-accent) 20%,transparent) !important;}
    .kpi .label{font-size:.68rem !important;letter-spacing:.075em !important;color:#667085 !important;}
    .kpi-badge{margin-top:.5rem !important;padding:.28rem .52rem !important;font-size:.67rem !important;background:color-mix(in srgb,var(--kpi-accent) 7%,#fff) !important;border-color:color-mix(in srgb,var(--kpi-accent) 12%,#eaecf0) !important;}
    .kpi .value{font-size:clamp(1.38rem,1.15rem + .72vw,2rem) !important;color:#101828 !important;letter-spacing:-.045em !important;}
    .kpi--hero .value{font-size:clamp(1.55rem,1.25rem + .9vw,2.25rem) !important;}
    .kpi .sub{font-size:.78rem !important;color:#667085 !important;min-height:auto !important;}
    .kpi-foot{margin-top:auto !important;padding-top:.75rem !important;border-top:1px solid #f0f2f5 !important;}
    .kpi-trend,.kpi-hint{font-size:.68rem !important;}
    .kpi--hero{background:linear-gradient(145deg,color-mix(in srgb,var(--kpi-accent) 4%,#fff),#fff 62%) !important;border-color:color-mix(in srgb,var(--kpi-accent) 18%,#eaecf0) !important;}

    /* ---------- NAV ---------- */
    .finance-nav-shell{position:sticky;top:8px;z-index:20;margin-bottom:1rem;padding:.38rem;border:1px solid var(--fin-border);border-radius:18px;background:rgba(255,255,255,.88);backdrop-filter:blur(18px);box-shadow:var(--fin-shadow-sm);overflow-x:auto;scrollbar-width:none;}
    .finance-nav-shell::-webkit-scrollbar{display:none;}
    #financeTabs{flex-wrap:nowrap !important;min-width:max-content;gap:.25rem !important;margin:0 !important;}
    #financeTabs .nav-link{border:0 !important;background:transparent !important;color:#667085 !important;border-radius:13px !important;padding:.6rem .85rem !important;font-size:.8rem;font-weight:800 !important;box-shadow:none !important;}
    #financeTabs .nav-link:hover{color:#101828 !important;background:#f2f4f7 !important;}
    #financeTabs .nav-link.active{color:#fff !important;background:var(--theme-color-principal) !important;box-shadow:0 6px 16px color-mix(in srgb,var(--theme-color-principal) 24%,transparent) !important;}

    /* ---------- CHARTS ---------- */
    #tab-all .cardx{height:100%;box-shadow:var(--fin-shadow-md) !important;}
    .chart-box{height:390px !important;position:relative;}
    .chart-box.sm{height:350px !important;}
    .chart-box canvas{filter:saturate(.92);}
    .tab-content{padding-bottom:1.25rem;}

    /* ---------- DATATABLES ---------- */
    .table-responsive{border:1px solid #eaecf0;border-radius:16px;overflow:auto;background:#fff;}
    table.dataTable{margin-top:0 !important;margin-bottom:0 !important;}
    table.dataTable thead th{background:#f8fafc !important;color:#475467 !important;font-size:.68rem;text-transform:uppercase;letter-spacing:.055em;font-weight:850 !important;border-bottom:1px solid #eaecf0 !important;padding:.78rem .85rem !important;white-space:nowrap;}
    table.dataTable tbody td{padding:.76rem .85rem !important;border-color:#f0f2f5 !important;color:#344054;font-size:.84rem;vertical-align:middle;}
    table.dataTable tbody tr:hover>*{background:#fafbfc !important;box-shadow:none !important;}
    .dataTables_wrapper .row:first-child,.dataTables_wrapper .row:last-child{padding:.55rem .2rem;align-items:center;}
    .dataTables_wrapper .dataTables_filter input,.dataTables_wrapper .dataTables_length select{min-height:36px;border-radius:10px !important;border-color:#e4e7ec !important;background:#fff !important;}
    .dataTables_wrapper .dataTables_info{font-size:.76rem;color:#667085;padding-top:.75rem !important;}
    .dataTables_wrapper .page-link{min-width:34px;height:34px;display:grid;place-items:center;padding:0 !important;font-size:.76rem;}
    .money{font-weight:850 !important;color:#101828;}
    code{font-size:.72rem;color:#475467;background:#f2f4f7;border-radius:7px;padding:.18rem .32rem;}

    /* ---------- FEEDBACK / LOADING ---------- */
    #btnRefresh:disabled,#btnApply:disabled{opacity:.65;cursor:wait;}
    .dashboard-loading .kpi .value{color:transparent !important;position:relative;overflow:hidden;border-radius:8px;}
    .dashboard-loading .kpi .value::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#f2f4f7 20%,#e4e7ec 36%,#f2f4f7 52%);background-size:220% 100%;animation:financeShimmer 1.25s linear infinite;}
    @keyframes financeShimmer{to{background-position:-220% 0}}

    /* ---------- RESPONSIVE ---------- */
    @media (max-width:1199px){
      .finance-hero__meta{grid-template-columns:repeat(2,minmax(0,1fr));}
      .kpi{grid-column:span 6 !important;}
    }
    @media (max-width:767.98px){
      .hero.finance-hero{padding:1.2rem !important;border-radius:20px;min-height:auto;}
      .finance-hero .accent{display:none;}
      .finance-hero__title{font-size:1.65rem;}
      .finance-hero__subtitle{font-size:.86rem;}
      .finance-hero__meta{grid-template-columns:1fr;gap:.45rem;}
      .finance-meta{padding:.58rem .68rem;border-radius:13px;}
      .finance-hero__actions{width:100%;}
      .finance-hero__refresh{width:100%;justify-content:center;}
      .cardx,.kpi-section{border-radius:18px !important;}
      .cardx-h{min-height:58px;padding:.82rem .9rem !important;}
      .cardx-title{font-size:.88rem !important;}
      .cardx-title>i{width:30px;height:30px;border-radius:10px;}
      .filters-compact{padding:.9rem !important;}
      .filters-compact .input-inline{align-items:stretch !important;}
      .filters-compact .btn-group{max-width:100%;overflow-x:auto;}
      #fYear{width:100% !important;}
      .kpi-grid{display:grid !important;grid-template-columns:1fr !important;gap:10px !important;}
      .kpi{grid-column:1 / -1 !important;min-height:0 !important;padding:14px !important;border-radius:16px !important;}
      .kpi-head{margin-bottom:.75rem !important;}
      .kpi-foot{display:none !important;}
      .kpi .value{font-size:1.52rem !important;overflow-wrap:anywhere;}
      .chart-box,.chart-box.sm{height:300px !important;}
      .finance-nav-shell{top:4px;border-radius:14px;margin-left:-2px;margin-right:-2px;}
      #financeTabs .nav-link{padding:.52rem .72rem !important;font-size:.75rem;}
      .table-responsive{border-radius:13px;max-width:100%;}
      table.dataTable{min-width:780px;}
      .dataTables_wrapper{max-width:100%;overflow:hidden;}
      .dataTables_wrapper .row:first-child>div{width:100%;margin-bottom:.35rem;}
      .dataTables_wrapper .dataTables_filter{text-align:left !important;}
      .dataTables_wrapper .dataTables_filter input{width:calc(100% - 70px);max-width:260px;}
    }
    @media (max-width:420px){
      .finance-hero__eyebrow{font-size:.63rem;}
      .finance-hero__title{font-size:1.48rem;}
      .kpi-icon{width:38px !important;height:38px !important;}
      .kpi-badge{white-space:normal !important;}
    }


  </style>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://npmcdn.com/flatpickr/dist/l10n/fr.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
{% endblock %}

{% block body %}


  {# ===== HERO EXECUTIVE ===== #}
  <div class="hero finance-hero mb-4 d-flex gap-3">
    <div class="accent"></div>

    <div class="flex-grow-1 position-relative">
      <div class="d-flex align-items-start justify-content-between gap-4 flex-wrap">
        <div class="flex-grow-1">
          <span class="finance-hero__eyebrow">
            <i class="bi bi-shield-check"></i> Centre de pilotage financier
          </span>

          <h1 class="finance-hero__title">Dashboard financier</h1>
          <div class="finance-hero__subtitle">
            Une lecture claire de votre activité : facturation, encaissements, dépenses, rentabilité et pipeline commercial.
          </div>

          <div class="finance-hero__meta">
            <div class="finance-meta">
              <span class="finance-meta__icon"><i class="bi bi-building"></i></span>
              <span class="min-w-0">
                <span class="finance-meta__label">Entité</span>
                <span class="finance-meta__value">{{ entite.nom }}</span>
              </span>
            </div>
            <div class="finance-meta">
              <span class="finance-meta__icon"><i class="bi bi-calendar3"></i></span>
              <span class="min-w-0">
                <span class="finance-meta__label">Période initiale</span>
                <span class="finance-meta__value">{{ start|date('d/m/Y') }} → {{ end|date('d/m/Y') }}</span>
              </span>
            </div>
            <div class="finance-meta">
              <span class="finance-meta__icon"><i class="bi bi-lightning-charge"></i></span>
              <span class="min-w-0">
                <span class="finance-meta__label">Données</span>
                <span class="finance-meta__value">Synchronisées à la demande</span>
              </span>
            </div>
          </div>
        </div>

        <div class="finance-hero__actions">
          <button class="btn btn-light btn-sm fw-semibold finance-hero__refresh" id="btnRefresh">
            <i class="bi bi-arrow-repeat me-1"></i> Actualiser les données
          </button>
        </div>
      </div>
    </div>
  </div>

  {# ===== FILTRES ===== #}
  <div class="cardx filter-panel mb-4">
    <div class="cardx-h">
      <h5 class="cardx-title"><i class="bi bi-funnel-fill text-warning"></i> Filtres</h5>

      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-light btn-sm" id="btnToggleFilters">
          <i class="bi bi-sliders"></i>
          <span>Plus de filtres</span>
        </button>
        <span class="chip">Global</span>
      </div>
    </div>

    <div class="p-3 filters-compact">
      <div class="row g-3 align-items-end">

        <div class="col-lg-6">
          <div class="input-inline flex-wrap">
            <label class="form-label">Année</label>

            <div class="btn-group btn-group-sm" role="group" aria-label="Raccourcis année">
              <button type="button" class="btn btn-light" id="btnYearNow">
                <i class="bi bi-calendar-event"></i> Année
              </button>
              <button type="button" class="btn btn-light" id="btnYearPrev1">N-1</button>
              <button type="button" class="btn btn-light" id="btnYearPrev2">N-2</button>
            </div>

            <select class="form-select form-select-sm w-auto" id="fYear" style="min-width:110px"></select>
          </div>
        </div>

        <div class="col-lg-6">
          <label class="form-label">Période</label>
          <input class="form-control" id="fRange" placeholder="Période" />
          <input type="hidden" id="fStart" value="{{ start }}">
          <input type="hidden" id="fEnd" value="{{ end }}">
        </div>

        <div id="filtersAdvanced" class="filters-advanced">

          <div class="row g-3 align-items-end">
            {# ✅ Catégorie (multi) - version “chip dropdown” comme Dépenses #}
            <div class="col-md-4 col-lg-3">
              <label class="form-label">Catégorie</label>

              <div class="chip w-100 d-flex align-items-center justify-content-between" style="gap:.5rem;">
                <span class="d-flex align-items-center gap-2">
                  <i class="bi bi-tags"></i>
                  <span id="fCatSelectedCount">Toutes</span>
                </span>

                <button class="btn btn-sm btn-light dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        style="border-radius:999px;">
                  Choisir
                </button>

                <div class="dropdown-menu p-2" style="min-width:340px;">
                  <input type="text" class="form-control form-control-sm mb-2"
                        placeholder="Rechercher..." data-filter="fcat">

                  <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-check-all="fcat">Tout</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-uncheck-all="fcat">Aucun</button>
                  </div>

                  <div id="fCatList" class="dropdown-list">
                    {% for c in categories %}
                      <label class="dropdown-item d-flex align-items-center gap-2" style="white-space:normal;">
                        <input class="form-check-input m-0 f-filter-cat" type="checkbox" value="{{ c.id }}">
                        <span>{{ c.libelle }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>


            {# ✅ Fournisseur (multi) - version “chip dropdown” comme Dépenses #}
            <div class="col-md-4 col-lg-3">
              <label class="form-label">Fournisseur</label>

              <div class="chip w-100 d-flex align-items-center justify-content-between" style="gap:.5rem;">
                <span class="d-flex align-items-center gap-2">
                  <i class="bi bi-truck"></i>
                  <span id="fFourSelectedCount">Tous</span>
                </span>

                <button class="btn btn-sm btn-light dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        style="border-radius:999px;">
                  Choisir
                </button>

                <div class="dropdown-menu p-2" style="min-width:340px;">
                  <input type="text" class="form-control form-control-sm mb-2"
                        placeholder="Rechercher..." data-filter="ffour">

                  <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-check-all="ffour">Tout</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-uncheck-all="ffour">Aucun</button>
                  </div>

                  <div id="fFourList" class="dropdown-list">
                    {% for f in fournisseurs %}
                      <label class="dropdown-item d-flex align-items-center gap-2" style="white-space:normal;">
                        <input class="form-check-input m-0 f-filter-four" type="checkbox" value="{{ f.id }}">
                        {# optionnel: pastille couleur si tu l’as #}
                        {% if f.couleurHex %}
                          <span style="display:inline-block;width:10px;height:10px;border-radius:999px;background:{{ f.couleurHex }};"></span>
                        {% endif %}
                        <span>{{ f.nom }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>


            <div class="col-md-4 col-lg-2">
              <label class="form-label">Devise</label>
              <select class="form-select" id="fDevise">
                <option value="">Toutes</option>
                <option value="EUR">EUR</option>
              </select>
            </div>

            <div class="col-md-4 col-lg-2">
              <label class="form-label">TVA</label>
              <select class="form-select" id="fTvaOnly">
                <option value="all">Toutes</option>
                <option value="deductible">Déductibles</option>
                <option value="nodeductible">Non déductibles</option>
              </select>
            </div>

            <div class="col-md-4 col-lg-3">
              <label class="form-label">Statut facture</label>
              <select class="form-select" id="fFactureStatus">
                <option value="">Tous</option>
                {% for s in factureStatuses %}<option value="{{ s.value }}">{{ s.label()|capitalize }}</option>{% endfor %}
              </select>
            </div>

            <div class="col-md-4 col-lg-2">
              <label class="form-label">Statut devis</label>
              <select class="form-select" id="fDevisStatus">
                <option value="">Tous</option>
                {% for s in devisStatuses %}<option value="{{ s.value }}">{{ s.label()|capitalize }}</option>{% endfor %}
              </select>
            </div>

            <div class="col-md-4 col-lg-2">
              <label class="form-label">Mode paiement</label>
              <select class="form-select" id="fPayMode">
                <option value="">Tous</option>
                {% for m in modePaiements %}<option value="{{ m.value }}">{{ m.label() }}</option>{% endfor %}
              </select>
            </div>
          </div>
        </div>

        <div class="col-12 d-flex gap-2">
          <button class="btn btn-gradient fw-semibold" id="btnApply"><i class="bi bi-check2"></i> Appliquer</button>
          <button class="btn btn-light" id="btnReset">Réinitialiser</button>
        </div>

      </div>
    </div>

  </div>

  <div class="cardx mb-4 kpi-section">
    <div class="cardx-h">
      <h5 class="cardx-title">
        <i class="bi bi-bank2 text-warning"></i>
        Comptabilité
      </h5>
      <span class="chip">Vue globale</span>
    </div>

    <div class="p-3 p-md-4">
      <div class="kpi-grid">

        <div class="kpi kpi--violet">
          <div class="kpi-head">
            <div class="kpi-meta">
              <p class="label">Devis (pipeline TTC)</p>
              <span class="kpi-badge"><i class="bi bi-file-earmark-text"></i> Pipeline</span>
            </div>
            <div class="kpi-icon"><i class="bi bi-journal-text"></i></div>
          </div>
          <div class="kpi-body">
            <div class="value" id="kpiDevisTtc">-</div>
            <div class="sub" id="kpiDevisCount">-</div>
          </div>
          <div class="kpi-foot">
            <span class="kpi-trend"><i class="bi bi-bar-chart-line"></i> Prospection</span>
            <span class="kpi-hint">TTC</span>
          </div>
        </div>

        <div class="kpi kpi--blue">
          <div class="kpi-head">
            <div class="kpi-meta">
              <p class="label">Factures émises</p>
              <span class="kpi-badge"><i class="bi bi-receipt"></i> Production</span>
            </div>
            <div class="kpi-icon"><i class="bi bi-receipt-cutoff"></i></div>
          </div>
          <div class="kpi-body">
            <div class="value" id="kpiFacTtc">-</div>
            <div class="sub" id="kpiFacCount">-</div>
          </div>
          <div class="kpi-foot">
            <span class="kpi-trend"><i class="bi bi-check2-square"></i> Facturation</span>
            <span class="kpi-hint">TTC</span>
          </div>
        </div>

        <div class="kpi kpi--emerald">
          <div class="kpi-head">
            <div class="kpi-meta">
              <p class="label">Paiements encaissés</p>
              <span class="kpi-badge"><i class="bi bi-cash-stack"></i> Trésorerie</span>
            </div>
            <div class="kpi-icon"><i class="bi bi-cash-coin"></i></div>
          </div>
          <div class="kpi-body">
            <div class="value" id="kpiPayTotal">-</div>
            <div class="sub" id="kpiPayCount">-</div>
          </div>
          <div class="kpi-foot">
            <span class="kpi-trend"><i class="bi bi-arrow-down-circle"></i> Encaissement</span>
            <span class="kpi-hint">TTC</span>
          </div>
        </div>

        <div class="kpi kpi--orange">
          <div class="kpi-head">
            <div class="kpi-meta">
              <p class="label">Avoirs</p>
              <span class="kpi-badge"><i class="bi bi-arrow-counterclockwise"></i> Correctif</span>
