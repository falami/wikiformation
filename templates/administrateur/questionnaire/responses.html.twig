{% extends 'base_admin.html.twig' %}
{% block title %}Réponses · {{ title }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/satisfaction-responses.css') }}">{% endblock %}
{% block body %}
<div class="sr-page">
<header class="sr-hero"><div><p class="sr-eyebrow">VOS QUESTIONNAIRES · LES RÉPONSES</p><h1>{{ title }}</h1><p>Explorez les retours et retrouvez chaque questionnaire rempli.</p></div><a class="sr-back" href="{{ path(indexRoute, {entite: entite.id}) }}">← Questionnaires</a></header>
<div class="sr-stats"><div><span>Questionnaires remplis</span><strong>{{ total }}</strong></div><div><span>Type de questionnaire</span><strong>{{ label }}</strong></div><div><span>Consultation</span><strong>Chaque retour compte</strong><small>Retrouvez le détail par personne</small></div></div>
<section class="sr-panel"><header class="sr-panel-head"><div><p class="sr-eyebrow">RÉPONSES INDIVIDUELLES</p><h2>Les retours en détail</h2></div><form method="get" class="sr-search"><label class="visually-hidden" for="response-search">Stagiaire ou code de session</label><input id="response-search" name="q" value="{{ search }}" placeholder="Stagiaire, code de session…"><button>Rechercher</button>{% if search %}<a href="{{ path('app_administrateur_questionnaire_responses', {entite: entite.id, kind: kind, id: id}) }}">Effacer</a>{% endif %}</form></header>
<div class="sr-table-wrap"><table class="sr-table"><thead><tr><th>{{ kind == 'formateur' ? 'Formateur' : 'Stagiaire' }}</th><th>Session</th><th>Complété le</th><th>{{ kind == 'positionnement' ? 'Niveau suggéré' : (kind == 'niveau' ? 'Score' : 'Note globale') }}</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
{% for row in rows %}<tr><td><strong>{{ row.name }}</strong><small>{{ row.email }}</small></td><td>{{ row.session }}{% if row.phase %}<small>{{ row.phase == 'pre' ? 'Diagnostic initial · PRE' : 'Évaluation finale · POST' }}</small>{% endif %}</td><td>{{ row.date|date('d/m/Y') }}<small>{{ row.date|date('H:i') }}</small></td><td><span class="sr-score">{{ row.score }}</span></td><td><a class="sr-open" href="{{ row.url }}">Voir les réponses →<span class="visually-hidden"> de {{ row.name }}</span></a></td></tr>
{% else %}<tr><td colspan="5" class="sr-empty"><i class="bi bi-chat-square-text" aria-hidden="true"></i><h3>Aucune réponse à afficher</h3><p>{{ search ? 'Essayez un autre nom ou code de session.' : 'Les questionnaires complétés apparaîtront ici.' }}</p></td></tr>{% endfor %}
</tbody></table></div><footer class="sr-pagination"><span>{{ count }} résultat(s) · Page {{ page }} / {{ pages }}</span><nav aria-label="Pagination des réponses">{% if page > 1 %}<a href="{{ path('app_administrateur_questionnaire_responses', {entite: entite.id, kind: kind, id: id, q: search, page: page - 1}) }}">← Précédente</a>{% endif %}{% if page < pages %}<a href="{{ path('app_administrateur_questionnaire_responses', {entite: entite.id, kind: kind, id: id, q: search, page: page + 1}) }}">Suivante →</a>{% endif %}</nav></footer></section></div>
{% endblock %}
