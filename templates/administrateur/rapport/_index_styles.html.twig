<style>
.report-hub{--report-ink:#233e4c;--report-muted:#6f8092;--report-line:#e5ebf0;color:var(--report-ink)}
.report-hub .report-hero{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:28px 32px;margin-bottom:24px;border-radius:22px;background:linear-gradient(115deg,#1c3541,#304e5b);color:#fff;box-shadow:0 10px 28px #2037440d;position:relative;overflow:hidden}
.report-hub .report-hero:before{content:"";position:absolute;left:0;top:28px;bottom:28px;width:4px;background:#dfbc68;border-radius:0 4px 4px 0}
.report-hub .report-eyebrow{font-size:11px;letter-spacing:1.8px;font-weight:700;color:#e2c47f;display:flex;gap:9px;align-items:center;margin-bottom:10px}
.report-hub .report-hero h1{font-size:clamp(24px,2.3vw,34px);font-weight:750;letter-spacing:-1px;margin:0 0 8px;color:#fff}
.report-hub .report-hero p{margin:0;color:#cedae0;font-size:14px}
.report-hub .report-back{display:inline-flex;align-items:center;gap:9px;white-space:nowrap;padding:10px 16px;border:1px solid #ffffff40;border-radius:10px;color:#fff;text-decoration:none;font-size:13px;font-weight:600;transition:background .2s}
.report-hub .report-back:hover{background:#ffffff15}
.report-hub .report-panel{background:#fff;border:1px solid var(--report-line);border-radius:20px;box-shadow:0 8px 28px #23334206;overflow:hidden}
.report-hub .report-filters{display:flex;align-items:center;gap:20px;padding:20px 24px;border-bottom:1px solid var(--report-line);background:#fbfcfd}
.report-hub .report-filters label{margin:0;font-size:13px;white-space:nowrap}
.report-hub .report-filter-controls{display:flex;gap:10px;align-items:center;flex:1}
.report-hub .form-select{max-width:340px;min-height:42px;border:1px solid #dce4eb;border-radius:10px;color:var(--report-ink);font-size:14px;box-shadow:none}
.report-hub .report-filter-button{border:1px solid #e8c66e;background:#f8d778;color:#453815;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:700;display:flex;gap:8px;align-items:center}
.report-hub .report-filter-button:hover{background:#efca62}
.report-hub .report-list-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:24px}
.report-hub .report-list-heading h2{font-size:17px;font-weight:700;letter-spacing:-.3px;margin:0 0 5px}
.report-hub .report-list-heading p{font-size:13px;color:var(--report-muted);margin:0}
.report-hub .report-count{font-size:12px;color:#526b7a;background:#f0f5f7;padding:7px 11px;border-radius:8px;white-space:nowrap}
.report-hub .report-table{color:var(--report-ink);border-color:var(--report-line)}
.report-hub .report-table thead th{background:#f7f9fb;color:#728395;font-size:10px;text-transform:uppercase;letter-spacing:1px;font-weight:700;padding:14px 18px!important;white-space:nowrap;border-bottom:1px solid var(--report-line)}
.report-hub .report-table td{padding:18px!important;font-size:13px;border-color:var(--report-line)}
.report-hub .report-table td:first-child,.report-hub .report-table th:first-child{padding-left:24px!important}
.report-hub .report-table td:last-child{text-align:right;padding-right:24px!important}
.report-hub .report-table strong{font-weight:700;display:block;margin-bottom:4px}
.report-hub .report-badge{display:inline-block;border-radius:6px;padding:5px 9px;font-size:11px;font-weight:650;white-space:nowrap}
.report-hub .report-danger{background:#fcebea;color:#b43e39}.report-hub .report-warning{background:#fff3d5;color:#926514}.report-hub .report-neutral{background:#edf3f7;color:#526d80}.report-hub .report-success{background:#e8f5ee;color:#287752}
.report-hub .report-open{display:inline-flex;gap:12px;align-items:center;padding:8px 12px;border:1px solid #dce5eb;border-radius:9px;color:var(--report-ink);font-weight:600;text-decoration:none;white-space:nowrap}
.report-hub .report-open:hover{background:#f1f6f8;border-color:#a6bbc8}
.report-hub .report-empty{text-align:center;padding:22px 12px 28px}
.report-hub .report-empty-icon{display:inline-grid;place-items:center;width:48px;height:48px;background:#f3f7f8;color:#6c8a99;border:1px solid #e4ecef;border-radius:15px;font-size:22px;margin-bottom:14px}
.report-hub .report-empty h3{font-size:16px;font-weight:650;margin:0 0 8px}
.report-hub .report-empty p{font-size:13px;color:var(--report-muted);margin:0 auto 12px;max-width:430px;line-height:1.6}
.report-hub .report-empty a{font-size:13px;font-weight:600;color:#456a7d;text-underline-offset:4px}
.report-hub .report-pagination{display:flex;justify-content:flex-end;align-items:center;gap:16px;padding:14px 24px;color:var(--report-muted);font-size:12px;background:#fbfcfd}
.report-hub .report-pagination a{color:var(--report-ink);font-weight:600;text-underline-offset:4px}
.report-hub a:focus-visible,.report-hub button:focus-visible,.report-hub select:focus-visible{outline:3px solid #c39836;outline-offset:3px}
@media(max-width:767px){.report-hub .report-hero{padding:22px;align-items:flex-start;flex-direction:column;gap:16px;border-radius:16px}.report-hub .report-filters{padding:16px;align-items:stretch;flex-direction:column;gap:8px}.report-hub .form-select{min-width:0;max-width:none}.report-hub .report-list-heading{padding:18px 16px;flex-wrap:wrap}.report-hub .report-table{min-width:760px}.report-hub .report-table:has(.report-empty){min-width:0}.report-hub .report-table:has(.report-empty) thead{display:none}.report-hub .report-empty{padding:18px 0}.report-hub .report-pagination{padding:14px 16px}}
</style>
