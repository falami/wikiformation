{% extends 'formateur/rapport/show.html.twig' %}
{% block title %}Rapports formateurs · Suivi{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  {% include 'administrateur/rapport/_index_styles.html.twig' %}
{% endblock %}
{% block body %}
<div class="container-fluid py-4 report-hub">
  <header class="report-hero">
    <div>
      <div class="report-eyebrow"><i class="bi bi-journal-check" aria-hidden="true"></i> FORMATEURS · SUIVI QUALITÉ</div>
      <h1>Rapports des formateurs</h1>
      <p>Priorisez les signalements et suivez les actions réalisées.</p>
    </div>
    <a class="report-back" href="{{ path('app_administrateur_dashboard_index', {entite:entite.id}) }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Tableau de bord</a>
  </header>
  <section class="report-panel" aria-label="Liste des rapports">
  <form method="get" class="report-filters">
    <label for="report-status" class="form-label fw-semibold">Statut de traitement</label>
    <div class="report-filter-controls"><select name="statut" id="report-status" class="form-select">
      <option value="open" {{ statut == 'open' ? 'selected' : '' }}>À traiter et en cours</option>
      <option value="all" {{ statut == 'all' ? 'selected' : '' }}>Tous les rapports</option>
      {% for label,value in statuts %}<option value="{{ value }}" {{ statut == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
    </select><button class="report-filter-button"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrer</button></div>
  </form>
  <div class="report-list-heading"><div><h2>Suivi des signalements</h2><p>Les rapports les plus importants apparaissent en premier.</p></div><span class="report-count">{{ rapports|length }} rapport{{ rapports|length != 1 ? 's' : '' }} sur cette page</span></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0 report-table">
    <thead><tr><th class="p-3">Rapport / Session</th><th>Formateur</th><th>Importance</th><th>Statut</th><th>Soumis le</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>{% for r in rapports %}<tr>
      <td class="p-3"><strong>#{{ r.id }} · {{ r.session.code|default('—') }}</strong><div class="small text-muted">{{ r.session.formation.titre|default('Formation') }}</div></td>
      <td>{{ r.formateur.utilisateur.prenom|default('') }} {{ r.formateur.utilisateur.nom|default('—') }}</td>
      <td><span class="report-badge {{ r.importance == 'urgent' ? 'report-danger' : (r.importance == 'high' ? 'report-warning' : 'report-neutral') }}">{{ r.importanceLabel }}</span></td>
      <td><span class="report-badge {{ r.statutTraitement in ['resolved','closed'] ? 'report-success' : 'report-neutral' }}">{{ r.statutTraitementLabel }}</span></td>
      <td class="small">{{ r.submittedAt|date('d/m/Y H:i') }}</td>
      <td><a class="report-open" href="{{ path('app_administrateur_rapport_edit', {entite:entite.id,id:r.id}) }}">Ouvrir <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></td>
    </tr>{% else %}<tr><td colspan="6"><div class="report-empty"><span class="report-empty-icon"><i class="bi bi-journal-check" aria-hidden="true"></i></span><h3>Aucun rapport pour ce statut</h3><p>Les retours de vos formateurs apparaîtront ici pour être consultés et traités.</p>{% if statut != 'all' %}<a href="{{ path('app_administrateur_rapport_index', {entite:entite.id,statut:'all'}) }}">Voir tous les rapports <i class="bi bi-arrow-right" aria-hidden="true"></i></a>{% endif %}</div></td></tr>{% endfor %}</tbody>
  </table></div>
  <nav class="report-pagination" aria-label="Pagination rapports">
    {% if page > 1 %}<a href="{{ path('app_administrateur_rapport_index', {entite:entite.id,statut:statut,page:page-1}) }}">Précédent</a>{% endif %}
    <span>Page {{ page }}</span>
    {% if hasNext %}<a href="{{ path('app_administrateur_rapport_index', {entite:entite.id,statut:statut,page:page+1}) }}">Suivant</a>{% endif %}
  </nav>
  </section>
</div>
{% endblock %}
