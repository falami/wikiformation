{% extends 'formateur/rapport/show.html.twig' %}
{% block title %}Rapports formateurs · Suivi{% endblock %}
{% block body %}
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center gap-3 mb-4 flex-wrap">
    <div><h1 class="h2 fw-bold">Rapports des formateurs</h1><p class="text-muted">Priorisez les signalements et suivez les actions réalisées.</p></div>
    <a class="btn btn-outline-secondary" href="{{ path('app_administrateur_dashboard_index', {entite:entite.id}) }}">Tableau de bord</a>
  </div>
  <form method="get" class="card card-body mb-4">
    <label for="report-status" class="form-label fw-semibold">Statut de traitement</label>
    <div class="d-flex gap-2"><select name="statut" id="report-status" class="form-select" style="max-width:320px">
      <option value="open" {{ statut == 'open' ? 'selected' : '' }}>À traiter et en cours</option>
      <option value="all" {{ statut == 'all' ? 'selected' : '' }}>Tous les rapports</option>
      {% for label,value in statuts %}<option value="{{ value }}" {{ statut == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
    </select><button class="btn btn-primary">Filtrer</button></div>
  </form>
  <div class="card overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th class="p-3">Rapport / Session</th><th>Formateur</th><th>Importance</th><th>Statut</th><th>Soumis le</th><th></th></tr></thead>
    <tbody>{% for r in rapports %}<tr>
      <td class="p-3"><strong>#{{ r.id }} · {{ r.session.code|default('—') }}</strong><div class="small text-muted">{{ r.session.formation.titre|default('Formation') }}</div></td>
      <td>{{ r.formateur.utilisateur.prenom|default('') }} {{ r.formateur.utilisateur.nom|default('—') }}</td>
      <td><span class="badge {{ r.importance == 'urgent' ? 'text-bg-danger' : (r.importance == 'high' ? 'text-bg-warning' : 'text-bg-info') }}">{{ r.importanceLabel }}</span></td>
      <td><span class="badge {{ r.statutTraitement in ['resolved','closed'] ? 'text-bg-success' : 'text-bg-secondary' }}">{{ r.statutTraitementLabel }}</span></td>
      <td class="small">{{ r.submittedAt|date('d/m/Y H:i') }}</td>
      <td><a class="btn btn-outline-primary btn-sm" href="{{ path('app_administrateur_rapport_edit', {entite:entite.id,id:r.id}) }}">Consulter / traiter</a></td>
    </tr>{% else %}<tr><td colspan="6" class="text-center text-muted p-5">Aucun rapport pour ce statut.</td></tr>{% endfor %}</tbody>
  </table></div></div>
  <nav class="d-flex gap-3 justify-content-end mt-3" aria-label="Pagination rapports">
    {% if page > 1 %}<a href="{{ path('app_administrateur_rapport_index', {entite:entite.id,statut:statut,page:page-1}) }}">Précédent</a>{% endif %}
    <span>Page {{ page }}</span>
    {% if hasNext %}<a href="{{ path('app_administrateur_rapport_index', {entite:entite.id,statut:statut,page:page+1}) }}">Suivant</a>{% endif %}
  </nav>
</div>
{% endblock %}
