<div class="convention-references">
  <strong class="convention-reference-number">{{ c.numero ?: '—' }}</strong>
  {% if quote or invoice %}
    <div class="convention-related-documents">
      {% if quote %}
        <a href="{{ path('app_administrateur_devis_show', {entite: entite.id, id: quote.id}) }}">
          <span class="convention-document-label"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Devis</span>
          <span class="convention-reference-number">{{ quote.numero }}</span>
        </a>
      {% endif %}
      {% if invoice %}
        <a href="{{ path('app_administrateur_facture_show', {entite: entite.id, id: invoice.id}) }}">
          <span class="convention-document-label"><i class="bi bi-receipt" aria-hidden="true"></i> Facture</span>
          <span class="convention-reference-number">{{ invoice.numero }}</span>
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>
