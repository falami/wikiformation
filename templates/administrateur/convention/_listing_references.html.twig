<div>{{ c.numero ?: '—' }}</div>
{% if quote or invoice %}
  <div class="d-flex flex-column align-items-start gap-1 mt-2 small" style="font-size:.72rem;line-height:1.5">
    {% if quote %}
      <a class="text-decoration-none" href="{{ path('app_administrateur_devis_show', {entite: entite.id, id: quote.id}) }}"><i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>Devis {{ quote.numero }}</a>
    {% endif %}
    {% if invoice %}
      <a class="text-decoration-none" href="{{ path('app_administrateur_facture_show', {entite: entite.id, id: invoice.id}) }}"><i class="bi bi-receipt me-1" aria-hidden="true"></i>Facture {{ invoice.numero }}</a>
    {% endif %}
  </div>
{% endif %}
