{% if is_granted('ENTITE_FACTURE_MANAGE', entite) %}
<form method="post" action="{{ path('app_administrateur_convention_invoice_draft', {entite: entite.id, id: c.id}) }}" class="d-inline">
  <input type="hidden" name="_token" value="{{ csrf_token('convention_invoice_draft_' ~ c.id) }}">
  <button type="submit" class="{{ dropdown|default(false) ? 'dropdown-item' : 'btn btn-warning btn-sm fw-semibold' }}" title="Créer ou reprendre le brouillon, puis vérifier avant émission">
    <i class="bi bi-receipt me-2" aria-hidden="true"></i>Préparer la facture
  </button>
</form>
{% endif %}
