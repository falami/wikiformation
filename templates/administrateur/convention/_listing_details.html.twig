{% set count = c.inscriptions|length %}
<div style="min-width:155px">
  <div class="fw-semibold"><i class="bi bi-people me-1" aria-hidden="true"></i>{{ count }} stagiaire{{ count > 1 ? 's' : '' }} rattaché{{ count > 1 ? 's' : '' }}</div>
  {% if c.montantHtCents is not null %}<div class="small mt-1">{{ (c.montantHtCents / 100)|number_format(2, ',', ' ') }} € HT</div>{% endif %}
  {% if c.dateCreation %}<div class="small text-muted mt-1">Créée le {{ c.dateCreation|date('d/m/Y', 'Europe/Paris') }}</div>{% endif %}
</div>
