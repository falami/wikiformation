<div class="modal fade modal-ultra" id="modal-new-stagiaire" tabindex="-1" aria-hidden="true" aria-labelledby="new-stagiaire-title">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">

      <form id="form-new-stagiaire">
        <input type="hidden" name="_token" value="{{ csrf_token('session_stagiaire_new_' ~ entite.id) }}">
        <div class="modal-header">
          <h5 class="modal-title" id="new-stagiaire-title">
            <span class="ico"><i class="bi bi-person-plus"></i></span>
            Nouveau stagiaire
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>

        <div class="modal-body">
          <div class="ultra-hint mb-3">
            <i class="bi bi-shield-check"></i>
            <div>
              <div class="fw-semibold" style="color:var(--ink)">Un participant, sans quitter la convention</div>
              <div>Si cette adresse e-mail existe déjà, son compte est sélectionné sans créer de doublon.</div>
            </div>
          </div>

          <div class="ultra-panel">
            <div class="row g-3">
              <div class="col-md-5">
                <label class="form-label" for="conv-new-civilite">Civilité *</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-person-badge"></i></span>
                  <select id="conv-new-civilite" name="civilite" class="form-select" required>
                    <option value="">— Choisir —</option>
                    <option value="Monsieur">Monsieur</option>
                    <option value="Madame">Madame</option>
                  </select>
                </div>
              </div>

              <div class="col-md-7">
                <label class="form-label" for="conv-new-telephone">Téléphone</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-telephone"></i></span>
                  <input type="text" id="conv-new-telephone" name="telephone" class="form-control" placeholder="06 12 34 56 78">
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label" for="conv-new-prenom">Prénom *</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-person"></i></span>
                  <input type="text" id="conv-new-prenom" name="prenom" class="form-control" required placeholder="Jean">
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label" for="conv-new-nom">Nom *</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-person"></i></span>
                  <input type="text" id="conv-new-nom" name="nom" class="form-control" required placeholder="Dupont">
                </div>
              </div>

              <div class="col-12">
                <label class="form-label" for="conv-new-email">Email *</label>
                <div class="ultra-field">
                  <span class="fi"><i class="bi bi-envelope"></i></span>
                  <input type="email" id="conv-new-email" name="email" class="form-control" required placeholder="jean.dupont@mail.com">
                </div>
                <div class="form-text">Cet email servira d’identifiant et de contact.</div>
              </div>
              <div class="col-12"><input type="hidden" name="entreprise" id="new-stagiaire-entreprise"><div class="ultra-hint"><i class="bi bi-building"></i><div>Entreprise de la convention : <strong id="new-stagiaire-company-label"></strong><div>Le participant sera sélectionné ici. Enregistrez ensuite la convention pour confirmer son rattachement.</div></div></div></div>
            </div>

            <div class="alert alert-danger d-none mt-3 mb-0" id="new-stagiaire-error" role="alert"></div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-ultra-cancel" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i> Annuler
          </button>

          <button type="submit" class="btn btn-ultra-primary">
            <i class="fa fa-save me-1"></i> Créer et sélectionner
          </button>
        </div>
      </form>

    </div>
  </div>
</div>
