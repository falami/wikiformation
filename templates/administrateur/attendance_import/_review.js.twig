(() => {
'use strict';
const root=document.getElementById('paper-import'); if(!root)return;
const canvas=document.getElementById('paper-canvas'),ctx=canvas.getContext('2d'),page=document.getElementById('paper-page'),target=document.getElementById('paper-target'),hint=document.getElementById('paper-hint'),save=document.getElementById('paper-save');
const texts=JSON.parse(document.getElementById('paper-import-texts').textContent), selections=[];
const fields=['x','y','w','h'].map(k=>document.getElementById('rect-'+k));
let img=null, rect=null, start=null, generation=0;
const normalize=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
function paint(){if(!img)return;ctx.clearRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,0,0);if(rect){ctx.strokeStyle='#bc5d2e';ctx.lineWidth=3;ctx.strokeRect(rect[0]*canvas.width,rect[1]*canvas.height,rect[2]*canvas.width,rect[3]*canvas.height);}}
function load(){const status=document.getElementById('paper-preview-status');status.textContent='Chargement de l’aperçu…';const url=root.dataset.pageUrl.replace('/999','/'+page.value);document.getElementById('paper-page-link').href=url;const current=++generation;img=null;rect=null;ctx.clearRect(0,0,canvas.width,canvas.height);fields.forEach(f=>f.value=0);const image=new Image();image.onload=()=>{if(current!==generation)return;status.textContent='Page '+page.value+' : encadrez une signature pour la sélectionner.';img=image;canvas.width=image.width;canvas.height=image.height;paint();};image.onerror=()=>{if(current!==generation)return;status.textContent='Impossible de charger l’aperçu. Essayez le lien « Ouvrir la page du document séparément ».';};image.src=url;
const text=texts[Number(page.value)-1]||'';document.getElementById('paper-ocr').textContent=text||'Texte non reconnu. Vérifiez directement le document et choisissez le créneau.';
const norm=normalize(text).replace(/\b(\d{1,2})\s*[/.\-]\s*(\d{1,2})\s*[/.\-]\s*(\d{4})\b/g,(_,d,m,y)=>d.padStart(2,'0')+'/'+m.padStart(2,'0')+'/'+y);let count=0;
for(const o of target.options){if(!o.value)continue;if(!o.dataset.label)o.dataset.label=o.textContent;const name=o.dataset.name.split(/\s+/).filter(Boolean);const date=o.dataset.date;const matches=name.length>1&&name.every(n=>norm.includes(normalize(n)))&&norm.includes(date);o.textContent=(matches?'À vérifier · ':'')+o.dataset.label;if(matches)count++;}
hint.textContent=text?(count+' correspondance(s) possible(s) repérée(s). Vérifiez les signatures sur la page.'):'Reconnaissance du texte indisponible : la sélection visuelle reste disponible.';}
function point(e){const b=canvas.getBoundingClientRect();return [Math.max(0,Math.min(1,(e.clientX-b.left)/b.width)),Math.max(0,Math.min(1,(e.clientY-b.top)/b.height))];}
canvas.addEventListener('pointerdown',e=>{if(!img)return;start=point(e);canvas.setPointerCapture(e.pointerId);});
canvas.addEventListener('pointermove',e=>{if(!start)return;const p=point(e);rect=[Math.min(start[0],p[0]),Math.min(start[1],p[1]),Math.abs(p[0]-start[0]),Math.abs(p[1]-start[1])];fields.forEach((f,i)=>f.value=(rect[i]*100).toFixed(1));paint();});
canvas.addEventListener('pointerup',()=>start=null);canvas.addEventListener('pointercancel',()=>start=null);
fields.forEach(f=>f.addEventListener('input',()=>{rect=fields.map(f=>Number(f.value)/100);paint();}));
function refresh(){const list=document.getElementById('paper-selection-list');list.replaceChildren();selections.forEach((s,i)=>{const box=document.createElement('div');box.className='border rounded p-2 mb-2';const label=document.createElement('div');label.textContent=s.label+' · page '+s.page;const preview=document.createElement('img');preview.src=s.preview;preview.alt='Signature sélectionnée';preview.style='max-width:100%;max-height:90px;display:block';const remove=document.createElement('button');remove.type='button';remove.className='btn btn-sm btn-outline-danger mt-2';remove.textContent='Retirer';remove.onclick=()=>{selections.splice(i,1);refresh();};box.append(label,preview,remove);list.append(box);});document.getElementById('paper-selections').value=JSON.stringify(selections.map(({target,page,rect})=>({target,page,rect})));save.disabled=!selections.length;save.textContent='Valider les émargements ('+selections.length+')';}
document.getElementById('paper-add').onclick=()=>{if(!img||!target.value||!rect||rect[2]<.005||rect[3]<.005||rect[0]+rect[2]>1||rect[1]+rect[3]>1){hint.textContent='Choisissez un créneau et encadrez sa signature.';return;}if(selections.length>=100||selections.some(s=>s.target===target.value)){hint.textContent='Créneau déjà sélectionné ou limite de 100 signatures atteinte.';return;}const cropped=document.createElement('canvas');cropped.width=Math.max(1,Math.round(rect[2]*img.width));cropped.height=Math.max(1,Math.round(rect[3]*img.height));cropped.getContext('2d').drawImage(img,rect[0]*img.width,rect[1]*img.height,rect[2]*img.width,rect[3]*img.height,0,0,cropped.width,cropped.height);selections.push({target:target.value,page:Number(page.value),rect:[...rect],label:target.selectedOptions[0].dataset.label,preview:cropped.toDataURL()});rect=null;paint();refresh();hint.textContent='Signature ajoutée à la liste. Vérifiez les autres créneaux avant de valider.';};
page.addEventListener('change',load);document.getElementById('paper-confirm').addEventListener('submit',()=>{save.disabled=true;save.textContent='Enregistrement…';});load();
})();
