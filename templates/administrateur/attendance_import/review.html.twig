{% extends 'base_admin.html.twig' %}
{% block title %}Vérifier les émargements · {{ session.code }}{% endblock %}
{% block stylesheets %}
{{ parent() }}
<style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }


  </style>
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
{% endblock %}
{% block body %}
<div class="container-fluid py-4">
<a class="btn btn-outline-secondary mb-3" href="{{ path('app_admin_attendance_import_index',{entite:entite.id}) }}">← Imports d’émargements</a>
<h1 class="h3">Vérifier les signatures · {{ session.code }}</h1><p class="text-muted">{{ manifest.name }} · {{ manifest.pages }} page(s). Choisissez un créneau puis encadrez sa signature sur le document. Les créneaux déjà renseignés sont exclus.</p>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<div id="paper-import" data-page-url="{{ path('app_admin_attendance_import_document',{entite:entite.id,token:token,page:999}) }}">
<script type="application/json" id="paper-import-texts">{{ manifest.texts|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
<div class="row g-4"><div class="col-lg-8"><div class="card rounded-4 p-3"><div class="d-flex gap-3 align-items-center mb-3"><label for="paper-page">Page</label><select class="form-select w-auto" id="paper-page">{% for p in 1..manifest.pages %}<option value="{{ p }}">{{ p }} / {{ manifest.pages }}</option>{% endfor %}</select><a class="ms-auto" href="{{ path('app_admin_attendance_import_document',{entite:entite.id,token:token,page:0}) }}">Télécharger l’original</a></div>
<p id="paper-preview-status" class="small text-muted" role="status">Chargement de l’aperçu…</p>
<a id="paper-page-link" class="small mb-2" target="_blank" rel="noopener" href="{{ path('app_admin_attendance_import_document',{entite:entite.id,token:token,page:1}) }}">Ouvrir la page du document séparément</a>
<noscript><div class="alert alert-warning">Activez JavaScript pour afficher l’aperçu et sélectionner les signatures.</div></noscript>
<canvas id="paper-canvas" style="width:100%;height:auto;touch-action:none;cursor:crosshair" aria-label="Document : encadrez la signature avec la souris ou au toucher"></canvas>
<p class="small text-muted mt-2">Autre méthode : saisissez la zone en pourcentage de la page.</p><div class="row g-2">{% for key,label in {x:'Gauche',y:'Haut',w:'Largeur',h:'Hauteur'} %}<div class="col-3"><label class="small" for="rect-{{ key }}">{{ label }} (%)</label><input class="form-control form-control-sm" type="number" min="0" max="100" step="0.1" id="rect-{{ key }}" value="0"></div>{% endfor %}</div>
<details class="mt-3"><summary>Texte reconnu sur cette page</summary><pre id="paper-ocr" class="small text-wrap mt-2"></pre></details></div></div>
<div class="col-lg-4"><form method="post" class="card rounded-4 p-4" id="paper-confirm"><input type="hidden" name="_token" value="{{ csrf_token('attendance_import_' ~ token) }}"><input type="hidden" name="selections" id="paper-selections" value="[]">
<h2 class="h5">Correspondances à valider</h2><p id="paper-hint" class="small text-muted" role="status"></p>
<label for="paper-target" class="form-label">Stagiaire, date et demi-journée</label><select id="paper-target" class="form-select mb-3"><option value="">Choisir un créneau manquant</option>{% for target,row in rows %}<option value="{{ target }}" data-name="{{ row.ins.stagiaire.prenom }} {{ row.ins.stagiaire.nom }}" data-date="{{ row.period.date|date('d/m/Y') }}">{{ row.ins.stagiaire.prenom }} {{ row.ins.stagiaire.nom }} · {{ row.period.date|date('d/m/Y') }} · {{ row.period.label }}</option>{% endfor %}</select>
<button class="btn btn-outline-primary mb-3" id="paper-add" type="button">Ajouter cette signature</button><div id="paper-selection-list" aria-live="polite"></div>
<label class="d-flex gap-2 my-3"><input type="checkbox" name="confirm" value="1" required><span>J’ai vérifié chaque signature, le stagiaire, la date et la demi-journée sur le document original.</span></label><button class="btn btn-warning" id="paper-save" disabled>Valider les émargements (0)</button>
<p class="small text-muted mt-3 mb-0">Les signatures sont enregistrées comme issues d’un document papier, avec leur page source et votre validation. L’analyse ne vérifie pas l’identité du signataire.</p></form></div></div></div></div>
{% endblock %}
{% block javascripts_bottom %}{{ parent() }}<script>{% include 'administrateur/attendance_import/_review.js.twig' %}</script>{% endblock %}
