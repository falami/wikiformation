{% extends 'base_admin.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}{{ record.id ? 'Suivi' : 'Nouvelle fiche' }} · Registre qualité{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}"><link rel="stylesheet" href="{{ asset('dist/css/quality.css') }}"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">{% endblock %}
{% block body %}<div class="container-fluid py-4 quality-workspace">
<a class="d-inline-block mb-3" href="{{ path('app_administrateur_quality_records', {entite: entite.id}) }}">← Registre qualité</a>
<header class="quality-heading mb-4"><div><span class="quality-kicker">{{ entite.nom }} · Traçabilité</span><h1>{{ record.id ? record.title : 'Nouvelle fiche qualité' }}</h1><p>Des faits documentés, des actions suivies et une conclusion vérifiable.</p></div></header>
{{ form_start(form) }}{{ form_errors(form) }}<div class="quality-card quality-form p-4"><div class="row g-4">{% for field in form %}{% if field.vars.name not in ['_token', '_version'] %}<div class="{{ field.vars.name in ['description','actions','evidence','conclusion'] ? 'col-12' : 'col-12 col-lg-6' }}">{{ form_row(field) }}</div>{% endif %}{% endfor %}</div><div class="d-flex gap-3 justify-content-end mt-4"><a class="btn btn-outline-dark" href="{{ path('app_administrateur_quality_records', {entite: entite.id}) }}">Retour</a><button class="btn btn-dark" type="submit">Enregistrer la fiche</button></div></div>{{ form_end(form) }}
{% if history %}<section class="quality-card mt-4"><header><h2>Historique des versions enregistrées</h2></header><div class="p-4">{% for event in history %}<details class="border-bottom py-3"><summary>Version {{ event.payload.version }} · {{ event.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }} · {{ event.actor ? event.actor.prenom ~ ' ' ~ event.actor.nom : 'Utilisateur archivé' }}</summary><dl class="row mt-3">{% for key, label in {title: 'Objet', kind: 'Catégorie', occurredAt: 'Date du constat', owner: 'Responsable', dueAt: 'Échéance', status: 'Statut', description: 'Constat', actions: 'Actions', evidence: 'Preuves', conclusion: 'Conclusion'} %}<dt class="col-md-3">{{ label }}</dt><dd class="col-md-9">{{ event.payload[key]|default('—')|nl2br }}</dd>{% endfor %}</dl></details>{% endfor %}</div></section>{% endif %}
</div>{% endblock %}
{% block javascripts_bottom %}{{ parent() }}<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script><script src="https://cdn.jsdelivr.net/npm/flatpickr"></script><script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script><script defer src="{{ asset('dist/js/quality.js') }}"></script>{% endblock %}
