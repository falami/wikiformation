{% extends 'base_admin.html.twig' %}
{% block title %}Registre qualité · {{ entite.nom }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/style.css') }}"><link rel="stylesheet" href="{{ asset('dist/css/quality.css') }}">{% endblock %}
{% block body %}<div class="container-fluid py-4 quality-workspace">
<a href="{{ path('app_administrateur_quality_index', {entite: entite.id}) }}" class="d-inline-block mb-3">← Qualité & conformité</a>
<header class="quality-heading mb-4"><div><span class="quality-kicker">{{ entite.nom }} · Amélioration continue</span><h1>Registre qualité</h1><p>Réclamations, veille, difficultés et actions : consignez les faits, les suites données et leurs preuves.</p></div><a class="btn btn-light" href="{{ path('app_administrateur_quality_record_new', {entite: entite.id}) }}"><i class="bi bi-plus-lg me-2"></i>Nouvelle fiche</a></header>
{% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
<div class="quality-card p-4"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Objet / catégorie</th><th>Responsable</th><th>Échéance</th><th>Statut</th><th>Dernière mise à jour</th><th>Action</th></tr></thead><tbody>{% for record in records %}<tr><td><strong>{{ record.title }}</strong><small class="d-block text-muted">{{ record.kindLabel }}</small></td><td>{{ record.owner }}</td><td>{{ record.dueAt ? record.dueAt|date('d/m/Y') : 'Non fixée' }}</td><td><span class="badge {{ record.status == 'closed' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-dark' }}">{{ record.statusLabel }}</span></td><td>{{ record.updatedAt|date('d/m/Y H:i', 'Europe/Paris') }}</td><td><a href="{{ path('app_administrateur_quality_record_edit', {entite: entite.id, id: record.id}) }}" class="btn btn-outline-dark btn-sm">Ouvrir<span class="visually-hidden"> {{ record.title }}</span></a></td></tr>{% else %}<tr><td colspan="6" class="py-5 text-center text-muted">Aucune fiche. Enregistrez une première réclamation, une veille ou une action d’amélioration.</td></tr>{% endfor %}</tbody></table></div></div>
<p class="small text-muted mt-3">La clôture d’une fiche nécessite des actions, des références de preuves et une conclusion. Elle ne constitue pas une validation par un auditeur.</p>
</div>{% endblock %}
