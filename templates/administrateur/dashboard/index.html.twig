{# templates/administrateur/dashboard/index.html.twig #}
{% extends 'base_admin.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

      --dash-bg:#f5f7fa;
      --dash-panel:#ffffff;
      --dash-ink:#101828;
      --dash-muted:#667085;
      --dash-line:#eaecf0;
      --dash-soft:#f8fafc;
      --dash-success:#067647;
      --dash-success-bg:#ecfdf3;
      --dash-warning:#b54708;
      --dash-warning-bg:#fffaeb;
      --dash-danger:#b42318;
      --dash-danger-bg:#fef3f2;
      --dash-blue:#175cd3;
      --dash-blue-bg:#eff8ff;
      --dash-shadow:0 16px 44px rgba(16,24,40,.07);
      --dash-shadow-hover:0 20px 52px rgba(16,24,40,.11);
      --dash-radius:22px;
    }

    /* =========================
       BASE / TYPOGRAPHIE
       ========================= */
    .of-dashboard{
      color:var(--dash-ink);
      padding-bottom:2rem;
    }
    .of-dashboard *{box-sizing:border-box;}
    .of-dashboard .text-muted{color:var(--dash-muted)!important;}
    .section-eyebrow{
      display:inline-flex;
      align-items:center;
      gap:.45rem;
      font-size:.68rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.09em;
      color:var(--dash-muted);
      margin-bottom:.3rem;
    }
    .section-title{
      margin:0;
      font-size:1.12rem;
      font-weight:850;
      letter-spacing:-.02em;
      color:var(--dash-ink);
    }
    .section-subtitle{
      margin-top:.2rem;
      color:var(--dash-muted);
      font-size:.82rem;
      line-height:1.5;
    }

    /* =========================
       HERO DIRECTION
       ========================= */
    .of-hero{
      position:relative;
      overflow:hidden;
      border-radius:28px;
      padding:1.55rem 1.65rem;
      color:#fff;
      box-shadow:0 24px 60px rgba(15,23,42,.18);
      background:
        radial-gradient(900px 380px at 85% -20%,
          color-mix(in srgb,var(--theme-color-secondaire) 34%,transparent),
          transparent 62%),
        radial-gradient(700px 320px at -10% 110%,
          rgba(255,255,255,.12),
          transparent 62%),
        linear-gradient(135deg,
          color-mix(in srgb,var(--theme-color-principal) 94%,#000 6%),
          color-mix(in srgb,var(--theme-color-principal) 72%,#fff 28%));
    }
    .of-hero::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background:linear-gradient(180deg,rgba(255,255,255,.09),transparent 42%);
    }
    .of-hero__content{position:relative;z-index:1;}
    .of-hero__eyebrow{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      padding:.34rem .7rem;
      border-radius:999px;
      background:rgba(255,255,255,.11);
      border:1px solid rgba(255,255,255,.16);
      backdrop-filter:blur(8px);
      font-size:.7rem;
      text-transform:uppercase;
      letter-spacing:.08em;
      font-weight:800;
      color:rgba(255,255,255,.9);
    }
    .of-hero__eyebrow i{color:var(--theme-color-secondaire);}
    .of-hero h1{
      margin:.8rem 0 .35rem;
      font-size:clamp(1.65rem,2vw,2.25rem);
      line-height:1.08;
      font-weight:900;
      letter-spacing:-.04em;
    }
    .of-hero__lead{
      max-width:760px;
      font-size:.92rem;
      line-height:1.6;
      color:rgba(255,255,255,.76);
    }
    .of-hero__meta{
      margin-top:1.15rem;
      display:flex;
      flex-wrap:wrap;
      gap:.55rem;
    }
    .of-hero__chip{
      display:inline-flex;
      align-items:center;
      gap:.45rem;
      padding:.42rem .72rem;
      border-radius:999px;
      background:rgba(255,255,255,.10);
      border:1px solid rgba(255,255,255,.13);
      color:rgba(255,255,255,.9);
      font-size:.76rem;
      font-weight:700;
    }
    .of-hero__chip i{color:var(--theme-color-secondaire);}
    .of-hero__refresh{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.5rem;
      min-height:42px;
      padding:.58rem .95rem;
      border:0;
      border-radius:13px;
      background:#fff;
      color:var(--theme-color-principal);
      font-size:.8rem;
      font-weight:850;
      box-shadow:0 10px 24px rgba(0,0,0,.14);
    }
    .of-hero__refresh:hover{transform:translateY(-1px);background:#f8fafc;}

    /* =========================
       FILTRES
       ========================= */
    .filterbar{
      position:relative;
      z-index:5;
      margin-top:1rem;
      background:rgba(255,255,255,.97);
      border:1px solid var(--dash-line);
      border-radius:20px;
      box-shadow:var(--dash-shadow);
      overflow:visible;
    }
    .filterbar__top{
      padding:.9rem 1rem;
      display:flex;
      align-items:center;
      gap:.75rem;
      border-bottom:1px solid var(--dash-line);
    }
    .filterbar__title{font-size:.9rem;font-weight:850;}
    .filterbar__hint{font-size:.73rem;color:var(--dash-muted);margin-top:.08rem;}
    .filterbar__body{padding:.9rem 1rem 1rem;}
    .filtergrid{
      display:grid;
      grid-template-columns:repeat(12,minmax(0,1fr));
      gap:.75rem;
      align-items:end;
    }
    .fcol-formation{grid-column:span 3;}
    .fcol-formateur{grid-column:span 3;}
    .fcol-sessionstatus{grid-column:span 2;}
    .fcol-insstatus{grid-column:span 2;}
    .fcol-period{grid-column:span 2;}
    .filter-control .form-label{
      margin:0 0 .3rem;
      font-size:.66rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.075em;
      color:var(--dash-muted);
    }
    .filterbox{
      min-height:44px;
      padding:.32rem .52rem;
      border:1px solid #dfe3e8;
      border-radius:13px;
      background:#fff;
      transition:.16s ease;
    }
    .filterbox:focus-within{
      border-color:color-mix(in srgb,var(--theme-color-principal) 45%,#dfe3e8);
      box-shadow:0 0 0 3px color-mix(in srgb,var(--theme-color-principal) 9%,transparent);
    }
    .filterrow{display:flex;align-items:center;gap:.5rem;}
    .filter-icon{
      width:31px;height:31px;
      display:grid;place-items:center;
      flex:0 0 auto;
      border-radius:9px;
      background:#f2f4f7;
      color:#475467;
      font-size:.78rem;
    }
    .filterbox .form-select,.filterbox .form-control{
      min-width:0;
      border:0!important;
      box-shadow:none!important;
      background:transparent!important;
      padding:.15rem 0!important;
      font-size:.78rem!important;
    }
    .ts-dropdown{z-index:3000!important;}
    .ts-control{border:0!important;box-shadow:none!important;padding:.2rem 0!important;min-height:auto!important;}

    /* =========================
       STRUCTURE PANELS
       ========================= */
    .of-section{margin-top:1.15rem;}
    .of-section-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:1rem;
      margin-bottom:.7rem;
    }
    .of-panel{
      height:100%;
      background:var(--dash-panel);
      border:1px solid var(--dash-line);
      border-radius:var(--dash-radius);
      box-shadow:var(--dash-shadow);
      overflow:hidden;
    }
    .of-panel__head{
      min-height:64px;
      padding:.95rem 1.05rem;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.8rem;
      border-bottom:1px solid var(--dash-line);
      background:linear-gradient(180deg,#fff,#fdfdfd);
    }
    .of-panel__title{
      display:flex;
      align-items:center;
      gap:.7rem;
      margin:0;
      font-size:.9rem;
      font-weight:850;
      color:var(--dash-ink);
    }
    .of-panel__icon{
      width:34px;height:34px;
      display:grid;place-items:center;
      border-radius:10px;
      background:#f2f4f7;
      border:1px solid #e4e7ec;
      color:#475467;
    }
    .of-panel__body{padding:1rem;}
    .of-panel__count{
      display:inline-flex;
      align-items:center;
      min-height:28px;
      padding:.25rem .55rem;
      border-radius:999px;
      border:1px solid var(--dash-line);
      background:#fff;
      color:var(--dash-muted);
      font-size:.7rem;
      font-weight:800;
    }

    /* =========================
       KPI DIRECTION
       ========================= */
    .direction-grid{
      display:grid;
      grid-template-columns:repeat(12,minmax(0,1fr));
      gap:.8rem;
    }
    .metric{
      grid-column:span 3;
      position:relative;
      min-height:145px;
      padding:1rem;
      overflow:hidden;
      background:#fff;
      border:1px solid var(--dash-line);
      border-radius:18px;
      box-shadow:0 10px 30px rgba(16,24,40,.05);
      transition:.16s ease;
    }
    .metric:hover{transform:translateY(-2px);box-shadow:var(--dash-shadow-hover);}
    .metric::after{
      content:"";
      position:absolute;
      width:120px;height:120px;
      right:-50px;top:-55px;
      border-radius:50%;
      background:var(--metric-soft,#f2f4f7);
      opacity:.75;
    }
    .metric__top{display:flex;justify-content:space-between;align-items:flex-start;gap:.7rem;position:relative;z-index:1;}
    .metric__icon{
      width:40px;height:40px;
      display:grid;place-items:center;
      border-radius:12px;
      background:var(--metric-soft,#f2f4f7);
      color:var(--metric-color,#475467);
      font-size:.95rem;
    }
    .metric__badge{
      padding:.24rem .5rem;
      border-radius:999px;
      background:#f8fafc;
      border:1px solid var(--dash-line);
      color:var(--dash-muted);
      font-size:.65rem;
      font-weight:800;
    }
    .metric__label{
      margin-top:.9rem;
      color:var(--dash-muted);
      font-size:.69rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.065em;
    }
    .metric__value{
      margin-top:.22rem;
      font-size:1.72rem;
      line-height:1.05;
      font-weight:900;
      letter-spacing:-.035em;
      color:var(--dash-ink);
      font-variant-numeric:tabular-nums;
    }
    .metric__sub{margin-top:.36rem;font-size:.73rem;line-height:1.4;color:var(--dash-muted);}
    .metric--blue{--metric-color:#175cd3;--metric-soft:#eff8ff;}
    .metric--green{--metric-color:#067647;--metric-soft:#ecfdf3;}
    .metric--gold{--metric-color:#b54708;--metric-soft:#fffaeb;}
    .metric--violet{--metric-color:#6941c6;--metric-soft:#f4f3ff;}

    /* =========================
       ACTIONS PRIORITAIRES
       ========================= */
    .action-card{
      height:100%;
      min-height:144px;
      padding:1rem;
      border-radius:18px;
      border:1px solid var(--dash-line);
      background:#fff;
      box-shadow:0 10px 28px rgba(16,24,40,.05);
    }
    .action-card__row{display:flex;align-items:flex-start;justify-content:space-between;gap:.8rem;}
    .action-card__icon{
      width:38px;height:38px;
      display:grid;place-items:center;
      border-radius:11px;
      flex:0 0 auto;
    }
    .action-card--warn .action-card__icon{background:var(--dash-warning-bg);color:var(--dash-warning);}
    .action-card--danger .action-card__icon{background:var(--dash-danger-bg);color:var(--dash-danger);}
    .action-card--blue .action-card__icon{background:var(--dash-blue-bg);color:var(--dash-blue);}
    .action-card__count{
      font-size:1.5rem;
      line-height:1;
      font-weight:900;
      letter-spacing:-.03em;
      color:var(--dash-ink);
    }
    .action-card__label{margin-top:.72rem;font-size:.78rem;font-weight:850;color:var(--dash-ink);}
    .action-card__hint{margin-top:.25rem;font-size:.7rem;color:var(--dash-muted);line-height:1.45;}

    /* =========================
       FINANCE
       ========================= */
    .finance-card{
      position:relative;
      overflow:hidden;
      padding:1.15rem;
      border-radius:20px;
      border:1px solid var(--dash-line);
      background:
        radial-gradient(500px 180px at 100% 0%,color-mix(in srgb,var(--theme-color-secondaire) 9%,transparent),transparent 70%),
        #fff;
      box-shadow:var(--dash-shadow);
    }
    .finance-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:.75rem;
      margin-top:1rem;
    }
    .finance-stat{
      padding:.8rem .9rem;
      border-radius:14px;
      background:#f8fafc;
      border:1px solid #eef1f4;
    }
    .finance-stat__label{
      font-size:.64rem;
      text-transform:uppercase;
      letter-spacing:.075em;
      font-weight:800;
      color:var(--dash-muted);
    }
    .finance-stat__value{
      margin-top:.22rem;
      font-size:1.22rem;
      font-weight:900;
      letter-spacing:-.03em;
      font-variant-numeric:tabular-nums;
    }
    .finance-progress{
      height:8px;
      margin-top:.95rem;
      border-radius:999px;
      background:#eaecf0;
      overflow:hidden;
    }
    .finance-progress>span{
      display:block;
      height:100%;
      width:0;
      border-radius:inherit;
      background:linear-gradient(90deg,var(--theme-color-principal),color-mix(in srgb,var(--theme-color-principal) 55%,var(--theme-color-secondaire)));
      transition:width .35s ease;
    }

    /* =========================
       LISTES ALERTES
       ========================= */
    .mini-list{
      list-style:none;
      padding:0;
      margin:0;
      display:flex;
      flex-direction:column;
      gap:.55rem;
    }
    .mini-item{
      padding:.72rem;
      display:flex;
      align-items:flex-start;
      gap:.65rem;
      border:1px solid var(--dash-line);
      border-radius:13px;
      background:#fff;
    }
    .mini-item:hover{background:#fcfcfd;}
    .badge-pro{
      display:inline-flex;
      align-items:center;
      gap:.3rem;
      padding:.24rem .48rem;
      border-radius:999px;
      border:1px solid var(--dash-line);
      font-size:.67rem;
      line-height:1.2;
      font-weight:800;
    }
    .badge-pro--warn{background:var(--dash-warning-bg);border-color:#fedf89;color:var(--dash-warning);}
    .badge-pro--danger{background:var(--dash-danger-bg);border-color:#fecdca;color:var(--dash-danger);}
    .badge-pro--ok{background:var(--dash-success-bg);border-color:#abefc6;color:var(--dash-success);}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;}

    .em-acc .accordion-item{border:1px solid var(--dash-line);border-radius:13px!important;overflow:hidden;}
    .em-acc .accordion-button{padding:.7rem .8rem;font-size:.76rem;font-weight:800;background:#fff;}
    .em-acc .accordion-button:not(.collapsed){box-shadow:none;background:#f8fafc;color:var(--dash-ink);}
    .em-acc .accordion-body{padding:.7rem;background:#f8fafc;}
    .em-row{display:flex;gap:.55rem;align-items:flex-start;padding:.55rem .6rem;border-radius:10px;}
    .em-row+.em-row{margin-top:.4rem;}
    .em-meta{font-size:.68rem;color:var(--dash-muted);}

    /* =========================
       TABLES
       ========================= */
    .table-pro{
      background:#fff;
      border:1px solid var(--dash-line);
      border-radius:20px;
      box-shadow:var(--dash-shadow);
      overflow:hidden;
    }
    .table-pro__head{
      min-height:64px;
      padding:.85rem 1rem;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.8rem;
      border-bottom:1px solid var(--dash-line);
      background:#fff;
    }
    .table-pro__title{
      margin:0;
      display:flex;
      align-items:center;
      gap:.55rem;
      flex-wrap:wrap;
      font-size:.88rem;
      font-weight:850;
      color:var(--dash-ink);
    }
    .table-pro__count{
      padding:.22rem .48rem;
      border-radius:999px;
      background:#f8fafc;
      border:1px solid var(--dash-line);
      color:var(--dash-muted);
      font-size:.65rem;
      font-weight:800;
    }
    .table-pro__tools{display:flex;align-items:center;gap:.45rem;}
    .table-pro__search{position:relative;min-width:220px;}
    .table-pro__search i{
      position:absolute;left:.65rem;top:50%;transform:translateY(-50%);
      color:#98a2b3;font-size:.75rem;
    }
    .table-pro__search input{
      min-height:36px;
      padding-left:1.95rem;
      border-radius:10px;
      border-color:#dfe3e8;
      font-size:.75rem;
    }
    .table-pro__body{padding:0;}
    .table-pro__table{margin:0!important;}
    .table-pro__table thead th{
      padding:.68rem .72rem!important;
      background:#f8fafc!important;
      color:#475467!important;
      border-bottom:1px solid var(--dash-line)!important;
      font-size:.64rem!important;
      text-transform:uppercase;
      letter-spacing:.07em;
      font-weight:850!important;
      white-space:nowrap;
    }
    .table-pro__table tbody td{
      padding:.72rem!important;
      border-color:#f0f2f5!important;
      font-size:.75rem;
      color:#344054;
      vertical-align:middle;
    }
    .table-pro__table tbody tr:hover>*{background:#fcfcfd!important;}
    .table-pro__foot{
      min-height:50px;
      padding:.7rem 1rem;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.8rem;
      border-top:1px solid var(--dash-line);
      background:#fff;
    }

    /* DataTables 1/2 */
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_length,
    .dt-container .dt-search,
    .dt-container .dt-length{display:none!important;}
    .dataTables_wrapper .dataTables_paginate .paginate_button,
    .dt-container .dt-paging .dt-paging-button{
      min-width:32px;
      height:32px;
      border:1px solid var(--dash-line)!important;
      border-radius:9px!important;
      background:#fff!important;
      color:#475467!important;
      font-size:.7rem!important;
      padding:0 .45rem!important;
      margin:0 .12rem!important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dt-container .dt-paging .dt-paging-button.current{
      background:#f2f4f7!important;
      color:var(--dash-ink)!important;
      font-weight:850!important;
    }
    .dt-container .dt-info,.dataTables_info{font-size:.7rem;color:var(--dash-muted)!important;}
    div.dt-processing{display:none!important;}

    /* =========================
       CHARTS
       ========================= */
    .chart-wrap{height:300px;position:relative;}
    .chart-wrap--wide{height:320px;}
    canvas{max-height:none!important;}

    /* =========================
       MODAL PIECE
       ========================= */
    #pieceModal .modal-dialog{max-width:980px;}
    #pieceModal .preview-wrap{height:52vh;max-height:520px;min-height:260px;}

    /* =========================
       LOADING
       ========================= */
    #btnRefresh:disabled{opacity:.65;cursor:wait;}
    .dashboard-loading .metric__value,
    .dashboard-loading .finance-stat__value{
      color:transparent!important;
      position:relative;
      overflow:hidden;
      border-radius:7px;
    }
    .dashboard-loading .metric__value::after,
    .dashboard-loading .finance-stat__value::after{
      content:"";position:absolute;inset:0;
      background:linear-gradient(90deg,#f2f4f7 20%,#e4e7ec 36%,#f2f4f7 52%);
      background-size:220% 100%;
      animation:ofShimmer 1.2s linear infinite;
    }
    @keyframes ofShimmer{to{background-position:-220% 0}}

    /* =========================
       RESPONSIVE
       ========================= */
    @media(max-width:1199px){
      .fcol-formation,.fcol-formateur{grid-column:span 6;}
      .fcol-sessionstatus,.fcol-insstatus{grid-column:span 3;}
      .fcol-period{grid-column:span 6;}
      .metric{grid-column:span 6;}
      .finance-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
    }
    @media(max-width:767.98px){
      .of-hero{padding:1.15rem;border-radius:20px;}
      .of-hero__lead{font-size:.82rem;}
      .of-hero__refresh{width:100%;}
      .filtergrid{gap:.6rem;}
      .fcol-formation,.fcol-formateur,.fcol-sessionstatus,.fcol-insstatus,.fcol-period{grid-column:1/-1;}
      .metric{grid-column:1/-1;min-height:128px;}
      .finance-grid{grid-template-columns:1fr;}
      .of-section-head{align-items:flex-start;flex-direction:column;}
      .table-pro__head{align-items:stretch;flex-direction:column;}
      .table-pro__tools{width:100%;}
      .table-pro__search{min-width:0;flex:1;}
      .table-pro__foot{align-items:flex-start;flex-direction:column;}
      .chart-wrap,.chart-wrap--wide{height:280px;}
      #pieceModal .modal-dialog{max-width:95vw;margin:.75rem auto;}
      #pieceModal .preview-wrap{height:42vh;max-height:420px;min-height:220px;}
    }

    /* =========================
       V3 — POLISH PREMIUM
       ========================= */
    .of-dashboard{
      max-width:1600px;
      margin:0 auto;
    }

    .of-section{
      position:relative;
      isolation:isolate;
      clear:both;
    }

    .of-panel,
    .table-pro,
    .finance-card,
    .action-card,
    .metric{
      backdrop-filter:saturate(120%);
    }

    .of-panel{
      min-width:0;
    }

    .of-panel__body,
    .table-pro__body{
      min-width:0;
      overflow:hidden;
    }

    .chart-wrap{
      width:100%;
      min-width:0;
      overflow:hidden;
      border-radius:16px;
      background:
        linear-gradient(180deg,#fff,#fcfcfd);
    }

    .chart-wrap canvas{
      display:block!important;
      width:100%!important;
      max-width:100%!important;
    }

    .table-pro{
      border-color:#e6e9ee;
      box-shadow:
        0 1px 2px rgba(16,24,40,.02),
        0 14px 42px rgba(16,24,40,.055);
    }

    .table-pro__head{
      background:
        radial-gradient(420px 120px at 100% 0%,
          color-mix(in srgb,var(--theme-color-principal) 5%,transparent),
          transparent 72%),
        #fff;
    }

    .table-pro__table tbody td:first-child{
      font-weight:750;
      color:#1d2939;
    }

    .table-pro__table tbody tr{
      transition:background .14s ease;
    }

    .table-pro__table tbody tr:hover td{
      background:#f9fafb!important;
    }

    .metric{
      border-color:#e7eaf0;
      box-shadow:
        0 1px 2px rgba(16,24,40,.02),
        0 12px 34px rgba(16,24,40,.045);
    }

    .metric__value{
      font-size:1.82rem;
    }

    .action-card{
      border-color:#e7eaf0;
      box-shadow:
        0 1px 2px rgba(16,24,40,.02),
        0 12px 30px rgba(16,24,40,.045);
    }

    .finance-card{
      border-color:#e5e9ef;
      box-shadow:
        0 1px 2px rgba(16,24,40,.025),
        0 16px 44px rgba(16,24,40,.06);
    }

    .finance-stat{
      background:#fff;
      border-color:#e8ebf0;
      box-shadow:0 4px 14px rgba(16,24,40,.025);
    }

    .section-title{
      font-size:1.18rem;
    }

    .section-subtitle{
      max-width:760px;
    }

    /* La conformité détaillée reste dans son propre flux et ne peut plus recouvrir l'analyse */
    #tblDocsMissing,
    #tblUnsigned{
      width:100%!important;
      table-layout:auto;
    }

    @media (min-width:1200px){
      .chart-wrap{height:320px;}
      .chart-wrap--wide{height:340px;}
    }

  </style>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
{% endblock %}

{% block body %}
<div class="of-dashboard">

  {# ================= HERO ================= #}
  <section class="of-hero">
    <div class="of-hero__content">
      <div class="d-flex align-items-start justify-content-between gap-4 flex-wrap">
        <div class="flex-grow-1">
          <span class="of-hero__eyebrow">
            <i class="bi bi-mortarboard-fill"></i>
            Pilotage organisme de formation
          </span>

          <h1>Votre activité formation, en un coup d'œil</h1>
          <div class="of-hero__lead">
            Suivez l'activité pédagogique, les dossiers stagiaires, les émargements et les encaissements
            depuis une seule vue de pilotage.
          </div>

          <div class="of-hero__meta">
            <span class="of-hero__chip"><i class="bi bi-building"></i>{{ entite.nom }}</span>
            <span class="of-hero__chip"><i class="bi bi-shield-check"></i>Suivi conformité</span>
            <span class="of-hero__chip"><i class="bi bi-clock-history"></i><span id="hero-last-refresh">—</span></span>
          </div>
        </div>

        <button class="of-hero__refresh" id="btnRefresh" type="button">
          <i class="bi bi-arrow-repeat"></i>
          Actualiser les données
        </button>
      </div>
    </div>
  </section>

  {# ================= FILTRES ================= #}
  <div class="filterbar">
    <div class="filterbar__top">
      <div class="filter-icon"><i class="bi bi-sliders2"></i></div>
      <div>
        <div class="filterbar__title">Périmètre d'analyse</div>
        <div class="filterbar__hint">Filtrez l'activité par formation, formateur, statut ou période.</div>
      </div>
      <div class="ms-auto">
        <button class="btn btn-sm btn-outline-secondary fw-semibold" id="btnReset" type="button">
          <i class="bi bi-arrow-counterclockwise me-1"></i> Réinitialiser
        </button>
      </div>
    </div>

    <div class="filterbar__body">
      <div class="filtergrid">
        <div class="filter-control fcol-formation">
          <div class="form-label">Formation</div>
          <div class="filterbox"><div class="filterrow">
            <div class="filter-icon"><i class="bi bi-journal-bookmark"></i></div>
            <select id="formationFilter" class="form-select form-select-sm">
              <option value="all">Toutes</option>
            </select>
          </div></div>
        </div>

        <div class="filter-control fcol-formateur">
          <div class="form-label">Formateur</div>
          <div class="filterbox"><div class="filterrow">
            <div class="filter-icon"><i class="bi bi-person-badge"></i></div>
            <select id="formateurFilter" class="form-select form-select-sm">
              <option value="all">Tous</option>
            </select>
          </div></div>
        </div>

        <div class="filter-control fcol-sessionstatus">
          <div class="form-label">Statut session</div>
          <div class="filterbox"><div class="filterrow">
            <div class="filter-icon"><i class="bi bi-flag"></i></div>
            <select id="sessionStatusFilter" class="form-select form-select-sm">
              <option value="all">Tous</option>
              <option value="draft">Brouillon</option>
              <option value="published">Publié</option>
              <option value="full">Complet</option>
              <option value="canceled">Annulé</option>
              <option value="done">Terminée</option>
            </select>
          </div></div>
        </div>

        <div class="filter-control fcol-insstatus">
          <div class="form-label">Statut inscription</div>
          <div class="filterbox"><div class="filterrow">
            <div class="filter-icon"><i class="bi bi-person-check"></i></div>
            <select id="inscriptionStatusFilter" class="form-select form-select-sm">
              <option value="all">Tous</option>
              <option value="preinscrit">Préinscrit</option>
              <option value="confirme">Confirmé</option>
              <option value="en_cours">En cours</option>
              <option value="termine">Terminé</option>
              <option value="annule">Annulé</option>
              <option value="absent">Absent</option>
            </select>
          </div></div>
        </div>

        <div class="filter-control fcol-period">
          <div class="form-label">Période</div>
          <div class="filterbox"><div class="filterrow">
            <div class="filter-icon"><i class="bi bi-calendar3"></i></div>
            <input type="text" id="dateRange" class="form-control form-control-sm" placeholder="Choisir une période">
            <input type="hidden" id="dateFrom">
            <input type="hidden" id="dateTo">
          </div></div>
        </div>
      </div>
    </div>
  </div>

  {# ================= VUE DIRECTION ================= #}
