            <span class="of-panel__count">Top formations</span>
          </div>
          <div class="of-panel__body"><div class="chart-wrap chart-wrap--wide"><canvas id="chartSessionsFormation"></canvas></div></div>
        </div>
      </div>
    </div>
  </section>

  {# ================= CONFORMITE DETAILLEE ================= #}
  <section class="of-section">
    <div class="of-section-head">
      <div>
        <div class="section-eyebrow"><i class="bi bi-shield-check"></i> Conformité opérationnelle</div>
        <h2 class="section-title">Détails à régulariser</h2>
        <div class="section-subtitle">Les dossiers et émargements qui nécessitent une intervention.</div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <span class="of-panel__count">Sessions total : <strong class="ms-1" id="kpi-sessions">—</strong></span>
        <span class="of-panel__count">Terminées : <strong class="ms-1" id="kpi-past">—</strong></span>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-12 col-xl-6">
        <div class="table-pro h-100">
          <div class="table-pro__head">
            <h3 class="table-pro__title">
              <i class="bi bi-folder-x"></i> Dossiers incomplets
              <span class="table-pro__count" id="tblDocsMissingCount">—</span>
            </h3>
            <div class="table-pro__tools">
              <div class="table-pro__search">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control form-control-sm" placeholder="Rechercher..." data-plain-search="#tblDocsMissing">
              </div>
            </div>
          </div>
          <div class="table-pro__body">
            <div class="table-responsive">
              <table class="table table-sm table-pro__table w-100" id="tblDocsMissing">
                <thead><tr><th>Session</th><th>Stagiaire</th><th>Manquants</th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
          </div>
          <div class="table-pro__foot">
            <div class="text-muted small" id="tblDocsMissingInfo">—</div>
            <div class="text-muted small">Top 20</div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-6">
        <div class="table-pro h-100">
          <div class="table-pro__head">
            <h3 class="table-pro__title">
              <i class="bi bi-pen"></i> Émargements à régulariser
              <span class="table-pro__count" id="tblUnsignedCount">—</span>
            </h3>
            <div class="table-pro__tools">
              <div class="table-pro__search">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control form-control-sm" placeholder="Rechercher..." data-plain-search="#tblUnsigned">
              </div>
            </div>
          </div>
          <div class="table-pro__body">
            <div class="table-responsive">
              <table class="table table-sm table-pro__table w-100" id="tblUnsigned">
                <thead><tr><th>Session</th><th>Personne</th><th>Date</th><th>Période</th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
          </div>
          <div class="table-pro__foot">
            <div class="text-muted small" id="tblUnsignedInfo">—</div>
            <div class="text-muted small">Top 20</div>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>

<script>

  window.CSRF_VALIDATE_PIECE = "{{ csrf_token('validate_piece') }}";

