            <span class="of-panel__count">Trésorerie</span>
          </div>
          <div class="of-panel__body"><div class="chart-wrap"><canvas id="chartCash"></canvas></div></div>
        </div>
      </div>

      <div class="col-12">
        <div class="of-panel">
          <div class="of-panel__head">
            <h3 class="of-panel__title">
              <span class="of-panel__icon"><i class="bi bi-bar-chart"></i></span>
              Sessions par formation
