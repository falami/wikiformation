              <i class="bi bi-list-ul"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end p-2">
              <button class="dropdown-item" data-dt-length="10" data-dt="#dtSessionsAvenir">10 lignes</button>
              <button class="dropdown-item" data-dt-length="25" data-dt="#dtSessionsAvenir">25 lignes</button>
              <button class="dropdown-item" data-dt-length="50" data-dt="#dtSessionsAvenir">50 lignes</button>
            </div>
          </div>
        </div>
      </div>

      <div class="table-pro__body">
        <div class="table-responsive">
          <table class="table table-sm table-pro__table w-100" id="dtSessionsAvenir">
            <thead>
              <tr>
                <th>Code</th>
                <th>Formation</th>
                <th>Dates</th>
                <th>Statut</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>

      <div class="table-pro__foot">
        <div class="text-muted small" data-dt-info="#dtSessionsAvenir">—</div>
        <div data-dt-pager="#dtSessionsAvenir"></div>
      </div>
    </div>
  </section>

  {# ================= ANALYSES ================= #}
  <section class="of-section">
    <div class="of-section-head">
      <div>
        <div class="section-eyebrow"><i class="bi bi-graph-up"></i> Analyse</div>
        <h2 class="section-title">Tendances de l'activité</h2>
        <div class="section-subtitle">Répartition des inscriptions, encaissements mensuels et formations les plus actives.</div>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-12 col-xl-5">
        <div class="of-panel">
          <div class="of-panel__head">
            <h3 class="of-panel__title">
              <span class="of-panel__icon"><i class="bi bi-people"></i></span>
              Inscriptions par statut
