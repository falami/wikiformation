      <div class="finance-grid">
        <div class="finance-stat">
          <div class="finance-stat__label">Chiffre d'affaires facturé</div>
          <div class="finance-stat__value" id="kpi-facture">—</div>
        </div>
        <div class="finance-stat">
          <div class="finance-stat__label">Encaissements</div>
          <div class="finance-stat__value" id="kpi-encaisse">—</div>
        </div>
        <div class="finance-stat">
          <div class="finance-stat__label">Reste à encaisser</div>
          <div class="finance-stat__value" id="kpi-reste">—</div>
        </div>
        <div class="finance-stat">
          <div class="finance-stat__label">Taux d'encaissement</div>
          <div class="finance-stat__value" id="kpi-encaisse-rate">—</div>
        </div>
      </div>
      <div class="finance-progress" aria-hidden="true"><span id="finance-progress-bar"></span></div>
    </div>
  </section>

  {# ================= ACTIVITE ================= #}
  <section class="of-section">
    <div class="of-section-head">
      <div>
        <div class="section-eyebrow"><i class="bi bi-calendar-check"></i> Pilotage opérationnel</div>
        <h2 class="section-title">Prochaines sessions à préparer</h2>
        <div class="section-subtitle">Votre planning opérationnel immédiat, sans surcharge d'information.</div>
      </div>
      <span class="of-panel__count">Planning à venir</span>
    </div>

    <div class="table-pro">
      <div class="table-pro__head">
        <div>
          <h3 class="table-pro__title">
            <span class="of-panel__icon"><i class="bi bi-calendar-week"></i></span>
