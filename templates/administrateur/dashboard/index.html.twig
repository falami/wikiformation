  function bindPlainSearch(){

    document.querySelectorAll('[data-plain-search]').forEach(input=>{

      const sel = input.getAttribute('data-plain-search');

      const table = sel ? document.querySelector(sel) : null;

      if (!table) return;



      input.addEventListener('input', ()=>{

        const q = (input.value || '').toLowerCase();

        const rows = table.querySelectorAll('tbody tr');

        rows.forEach(tr=>{

          const txt = (tr.innerText || '').toLowerCase();

          tr.style.display = txt.includes(q) ? '' : 'none';

        });

      });

    });

  }



  /* =========================
     DataTables tools (premium wrapper)
  ========================= */

  function getDataTableApi(table){
    if (!table) return null;

    // Notre dashboard ne possède actuellement qu'une DataTable.
    // On renvoie directement l'instance créée par initDataTables().
    if (table.id === 'dtSessionsAvenir' && dtAvenir) {
      return dtAvenir;
    }

    // Fallback robuste si d'autres DataTables sont ajoutées plus tard.
    if (
      window.jQuery &&
      window.jQuery.fn &&
      window.jQuery.fn.dataTable &&
      window.jQuery.fn.dataTable.isDataTable(table)
    ) {
      return window.jQuery(table).DataTable();
    }

    return null;
  }


  function bindTableProTools(){

    // Recherche personnalisée
    document.querySelectorAll('[data-dt-search]').forEach(input=>{
      const sel = input.getAttribute('data-dt-search');
      const table = sel ? document.querySelector(sel) : null;
      if (!table) return;

      input.addEventListener('input', ()=>{
        const dt = getDataTableApi(table);
        if (!dt) return;

        dt.search(input.value || '').draw();
      });
    });


    // Nombre de lignes
    document.querySelectorAll('[data-dt-length]').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        const len = Number(btn.getAttribute('data-dt-length') || 10);
        const sel = btn.getAttribute('data-dt') || '';
        const table = sel ? document.querySelector(sel) : null;
        if (!table) return;

        const dt = getDataTableApi(table);
        if (!dt) return;

        dt.page.len(len).draw();
      });
    });


    // Compteur / informations de pagination
    document.querySelectorAll('[data-dt-info]').forEach(el=>{
      const sel = el.getAttribute('data-dt-info');
      const table = sel ? document.querySelector(sel) : null;
      if (!table) return;

      const dt = getDataTableApi(table);
      if (!dt) return;

      const refreshInfo = ()=>{
        const info = dt.page.info();

        if (!info) return;

        if (info.recordsDisplay === 0) {
          el.textContent = 'Aucun résultat';
        } else {
          el.textContent =
            `Affichage ${info.start + 1} → ${info.end} sur ${info.recordsDisplay}`;
        }

        const countEl = document.getElementById('dtAvenirCount');
        if (countEl) {
          countEl.textContent = `${info.recordsDisplay} résultat(s)`;
        }
      };

      // DataTables 2 : on utilise l'API DataTables et non un event DOM "draw.dt"
      dt.on('draw', refreshInfo);

      // Le premier draw peut être asynchrone (langue + AJAX)
      dt.on('init', refreshInfo);

      refreshInfo();
    });


    // Déplace la pagination DataTables dans notre footer premium.
    document.querySelectorAll('[data-dt-pager]').forEach(el=>{
      const sel = el.getAttribute('data-dt-pager');
      const table = sel ? document.querySelector(sel) : null;
      if (!table) return;

      const dt = getDataTableApi(table);
      if (!dt) return;

      const movePager = ()=>{
        // DataTables 2
        const container =
          table.closest('.dt-container') ||
          table.closest('.dataTables_wrapper');

        if (!container) return;

        const paginate =
          container.querySelector('.dt-paging') ||
          container.querySelector('.dataTables_paginate');

        if (!paginate || paginate.parentElement === el) return;

        el.innerHTML = '';
        el.appendChild(paginate);
      };

      dt.on('draw', movePager);
      dt.on('init', movePager);

      // Laisse DataTables terminer la construction de son DOM.
      setTimeout(movePager, 0);
    });
  }



