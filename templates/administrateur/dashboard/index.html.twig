            <span class="of-panel__count">Répartition</span>
          </div>
          <div class="of-panel__body"><div class="chart-wrap"><canvas id="chartInscriptions"></canvas></div></div>
        </div>
      </div>

      <div class="col-12 col-xl-7">
        <div class="of-panel">
          <div class="of-panel__head">
            <h3 class="of-panel__title">
              <span class="of-panel__icon"><i class="bi bi-currency-euro"></i></span>
