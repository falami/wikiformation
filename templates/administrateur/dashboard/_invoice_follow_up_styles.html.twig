.invoice-hub__icon{display:grid;place-items:center;flex-shrink:0;width:38px;height:38px;border:1px solid #e4e9ec;border-radius:14px;background:#f4f7f8;font-size:21px;color:#436272}
.invoice-hub .invoice-hub__eyebrow{display:block;margin:0 0 6px;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#82909b}
.invoice-hub .invoice-hub__header h2{margin:0;font-size:18px;font-weight:700;letter-spacing:-.5px;line-height:1.3;color:var(--ih-ink)}
