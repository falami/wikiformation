<style>
#invoice-follow-up.invoice-hub{--ih-ink:#223442;--ih-muted:#6c7a88;--ih-line:#e6ebef;border:1px solid var(--ih-line);border-radius:22px;overflow:hidden;background:#fff;box-shadow:0 8px 30px #20344308;color:var(--ih-ink)}
