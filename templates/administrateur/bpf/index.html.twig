{% extends 'base_admin.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Préparation BPF · {{ end|date('Y') }}{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }


  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="{{ asset('dist/vendors/flatpickr/flatpickr.min.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/bpf.css') }}?v=3">
{% endblock %}
{% block body %}
<div class="bpf-workspace">
  <header class="bpf-heading">
    <div><div class="bpf-eyebrow">{{ entite.nom }} · Déclaration annuelle</div><h1>Bilan pédagogique et financier</h1><p>Préparez votre déclaration, rapprochez vos justificatifs et contrôlez les totaux.</p><div class="bpf-tags"><span>Cerfa 10443*17</span><span>Notice 50199#17</span><span>Préparation interne · Non transmis</span></div></div>
    <a class="btn btn-light" href="https://www.monactiviteformation.emploi.gouv.fr/mon-activite-formation/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-2"></i>Accéder à MAF</a>
  </header>
  {% include 'flagMessage.html.twig' %}
  <section class="bpf-period">
    <div class="bpf-period-heading">
      <div><div class="bpf-eyebrow">Période de déclaration</div><h2>Votre exercice comptable</h2></div>
      <div class="bpf-year-navigation" aria-label="Changer d’exercice">
        <button type="button" class="btn btn-light" data-bpf-shift="-1" aria-label="Exercice précédent"><i class="bi bi-chevron-left"></i></button>
        <label class="visually-hidden" for="bpf-year">Année civile</label>
        <select id="bpf-year" class="form-select">
          <option value="">Période personnalisée</option>
          {% set currentYear = 'now'|date('Y', 'Europe/Paris') %}
          {% for year in range(min(start|date('Y'), currentYear - 10), max(end|date('Y'), currentYear + 2)) %}
            <option value="{{ year }}" {{ start|date('m-d') == '01-01' and end|date('m-d') == '12-31' and start|date('Y') == year and end|date('Y') == year ? 'selected' : '' }}>Année {{ year }}</option>
          {% endfor %}
        </select>
        <button type="button" class="btn btn-light" data-bpf-shift="1" aria-label="Exercice suivant"><i class="bi bi-chevron-right"></i></button>
        <button type="button" class="btn btn-outline-secondary" data-bpf-current="{{ currentYear }}">Année en cours</button>
      </div>
    </div>
    <form method="get" class="bpf-period-form">
      <div><label class="form-label" for="bpf-start">Début de l’exercice</label><input id="bpf-start" name="start" type="date" required class="form-control" value="{{ start|date('Y-m-d') }}"></div>
      <div><label class="form-label" for="bpf-end">Fin de l’exercice</label><input id="bpf-end" name="end" type="date" required class="form-control" value="{{ end|date('Y-m-d') }}"></div>
      <button class="btn btn-dark" type="submit"><i class="bi bi-arrow-right-circle me-2"></i>Préparer cet exercice</button>
    </form>
    <div class="small text-muted mt-3">Choisissez le dernier exercice comptable clos, même s’il ne correspond pas à l’année civile. La préparation est conservée séparément pour chaque période.</div>
    {% if history %}<div class="bpf-history mt-3"><span class="small text-muted">Dossiers enregistrés</span>{% for item in history %}<a href="{{ path('app_administrateur_bpf_index', {entite: entite.id, start: item.startDate|date('Y-m-d'), end: item.endDate|date('Y-m-d')}) }}">{{ item.startDate|date('d/m/Y') }} — {{ item.endDate|date('d/m/Y') }}</a>{% endfor %}</div>{% endif %}
  </section>
  <div class="bpf-layout">
    <aside class="bpf-sidebar"><div class="bpf-eyebrow">Votre dossier</div><nav aria-label="Cadres du BPF"><a href="#bpf-generation"><i class="bi bi-magic"></i>Génération automatique</a>{% for code, section in sections %}<a href="#bpf-{{ code }}"><span>{{ code }}</span>{{ section.title|split(' · ')|first }}</a>{% endfor %}<a href="#bpf-controls"><i class="bi bi-check2-square"></i>Contrôles</a><a href="#bpf-sources"><i class="bi bi-journal-text"></i>Données de rapprochement</a></nav><div class="bpf-reference"><a href="{{ officialUrl }}" target="_blank" rel="noopener">Formulaire officiel ↗</a><a href="{{ noticeUrl }}" target="_blank" rel="noopener">Consulter la notice ↗</a><small>Références vérifiées le 08/10/2026.</small></div></aside>
    <main>
      <div class="bpf-guidance"><i class="bi bi-info-circle"></i><div><strong>Une préparation à vérifier avant le dépôt</strong><p>Les rubriques sont préremplies à partir de la plateforme sur la période choisie. Les zéros calculés signifient qu’aucune donnée classée n’a été trouvée ; consultez les éléments restant à traiter avant le dépôt. Vos corrections sont conservées lors d’une nouvelle génération.</p></div></div>
      {{ form_start(form, {attr: {'data-bpf-form': '', 'novalidate': 'novalidate'}}) }}
      {{ form_errors(form) }}
      <section class="bpf-card" id="bpf-generation"><header><div class="bpf-letter"><i class="bi bi-magic"></i></div><div><h2>Votre BPF, à partir de vos données</h2><p>Factures et avoirs HT, charges classées, présences documentées et intervenants de l’exercice.</p></div></header><div class="bpf-card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><strong>{{ generation.baseline|length }} valeurs proposées</strong><div class="small text-muted">Calcul du {{ generation.at|date('d/m/Y à H:i', 'Europe/Paris') }} · {{ generation.evidence|length }} éléments de rapprochement</div></div><button type="submit" name="bpf_action" value="generate" class="btn btn-dark"><i class="bi bi-arrow-repeat me-2"></i>Générer et enregistrer mon BPF</button></div>
        <p class="small text-muted">Le calcul actualise les valeurs automatiques et complète les cases vides. Les valeurs que vous avez corrigées restent prioritaires. Les heures sans preuve de présence et les pièces non classées sont signalées dans les contrôles.</p>
        {% if generation.incompleteSections|default([]) %}<div class="alert alert-warning mb-3"><strong>Calcul partiel · Cadres {{ generation.incompleteSections|join(', ') }}</strong><br>Ces cadres contiennent des données manquantes ou non classées. Les valeurs connues sont conservées ; les cases vides ne doivent pas être assimilées à une absence d’activité.</div>{% endif %}
        {% if classifications %}<details class="bpf-classifications"><summary><strong>Correspondances BPF · {{ classifications|length }} paramètres</strong><span class="d-block small text-muted mt-1">À renseigner seulement si nécessaire, puis cliquez sur « Générer et enregistrer ». Les choix sont réutilisés pour les prochains exercices.</span></summary><div class="row g-3 mt-2">{% for key, spec in classifications %}<div class="col-12 col-xl-6">{{ form_row(attribute(form, key)) }}</div>{% endfor %}</div></details>{% endif %}
        {% if generation.evidence %}<details class="mt-3"><summary>Voir les pièces et présences prises en compte</summary><div class="table-responsive mt-3"><table class="table small"><thead><tr><th>Source</th><th>Référence</th><th>Prise en compte</th></tr></thead><tbody>{% for row in generation.evidence %}<tr><td>{{ row.kind }}</td><td>{{ row.label }}</td><td>{{ row.detail }}</td></tr>{% endfor %}</tbody></table></div></details>{% endif %}
      </div></section>
      {% for code, section in sections %}
        <section class="bpf-card" id="bpf-{{ code }}" data-bpf-section="{{ code }}">
          <header><div class="bpf-letter">{{ code }}</div><div><h2>{{ section.title }}</h2><p>{{ section.help }}</p></div></header>
          <div class="bpf-card-body">
            {% if section.rows is defined %}
              <div class="table-responsive"><table class="table bpf-grid"><thead><tr><th scope="col">{{ code == 'F4' ? 'Spécialité / code NSF' : 'Catégorie' }}</th><th scope="col">{{ code == 'E' ? 'Personnes' : 'Stagiaires / apprentis' }}</th><th scope="col">{{ code == 'E' ? 'Heures dispensées' : 'Heures suivies' }}</th></tr></thead><tbody>
                {% for key, label in section.rows %}<tr><th scope="row"><span>{{ label }}</span>{% if code == 'F4' and key != 'f4_other' %}<div class="bpf-nsf">{{ form_row(attribute(form, key ~ '_code'), {label: 'Code NSF'}) }}{{ form_row(attribute(form, key ~ '_label'), {label: 'Libellé de spécialité'}) }}</div>{% endif %}</th><td>{{ form_widget(attribute(form, key ~ '_count'), {attr: {'aria-label': label ~ ' · Effectif'}}) }}{{ form_errors(attribute(form, key ~ '_count')) }}</td><td>{{ form_widget(attribute(form, key ~ '_hours'), {attr: {'aria-label': label ~ ' · Heures'}}) }}{{ form_errors(attribute(form, key ~ '_hours')) }}</td></tr>{% endfor %}
                {% if code in ['F1','F3','F4'] %}<tr class="bpf-total"><th>Total {{ code }}</th><td><output data-bpf-total="{{ code|lower }}_count">{{ attribute(totals, code|lower ~ '_count') ?? 'À compléter' }}</output></td><td><output data-bpf-total="{{ code|lower }}_hours">{{ attribute(totals, code|lower ~ '_hours') ?? 'À compléter' }}</output></td></tr>{% endif %}
              </tbody></table></div>
            {% else %}
              <div class="{{ code in ['C','D'] ? 'bpf-money-fields' : 'row g-3' }}">
                {% for key, spec in section.fields %}<div class="{{ code in ['C','D'] ? 'bpf-money-row' : 'col-12 col-md-6' }}">{{ form_row(attribute(form, key)) }}</div>{% endfor %}
              </div>
            {% endif %}
            {% if code == 'G' %}
              <div class="mt-4 p-3 rounded border bg-light">
                <strong>Sessions en sous-traitance reçue</strong>
                <p class="small text-muted mt-2">Le champ « Sous-traitance : Oui » affecte automatiquement la session au cadre G, hors cadres F. Les heures suivies sont des heures-stagiaires : 7 heures suivies par 3 stagiaires donnent 21 heures. Les heures planifiées ci-dessous servent au rapprochement.</p>
                <div class="table-responsive"><table class="table small"><thead><tr><th>Session / formation</th><th class="text-end">Heures planifiées dans la période</th></tr></thead><tbody>
                {% set subcontractTotal = 0 %}
                {% for item in source.sessions|filter(item => item.subcontract) %}
                  {% set subcontractTotal = subcontractTotal + item.minutes_total %}
                  <tr><td><strong>{{ item.code }}</strong><br>{{ item.formation_titre }}</td><td class="text-end">{{ (item.minutes_total / 60)|number_format(2, ',', ' ') }} h</td></tr>
                {% else %}<tr><td colspan="2">Aucune session en sous-traitance sur cette période.</td></tr>{% endfor %}
                </tbody><tfoot><tr><th>Total des heures de sessions</th><th class="text-end">{{ (subcontractTotal / 60)|number_format(2, ',', ' ') }} h</th></tr></tfoot></table></div>
                {% for row in generation.evidence|default([])|filter(row => row.kind == 'Sous-traitance reçue · G') %}<p class="small mb-2"><strong>{{ row.label }}</strong><br>{{ row.detail }}</p>{% endfor %}
                <a href="#bpf-generation" class="btn btn-outline-dark btn-sm">Confirmer les présences et recalculer</a>
                <p class="small text-muted mt-2 mb-0">Dans « Correspondances BPF », confirmez la présence complète selon les justificatifs du donneur d’ordre, puis générez le BPF. Les valeurs corrigées manuellement restent prioritaires.</p>
              </div>
            {% endif %}
            {% if code == 'C' %}<div class="bpf-financial-totals"><div><span>Ligne 2 · Organismes gestionnaires</span><strong><output data-bpf-total="c_2">{{ totals.c_2 ?? 'À compléter' }}</output> € HT</strong></div><div><span>Total des produits · Lignes 1 à 11</span><strong><output data-bpf-total="c_total">{{ totals.c_total ?? 'À compléter' }}</output> € HT</strong></div></div>{% endif %}
            {% if code not in ['A','B','H'] %}<button type="button" class="btn btn-sm btn-outline-secondary mt-3" data-bpf-zero>Renseigner les cases numériques vides à zéro</button>{% endif %}
          </div>
        </section>
      {% endfor %}
      <section class="bpf-card" id="bpf-controls"><header><div class="bpf-letter"><i class="bi bi-check2-square"></i></div><div><h2>Contrôles de préparation</h2><p>Les contrôles portent sur les valeurs enregistrées. Ils ne constituent pas une validation par l’administration.</p></div></header><div class="bpf-card-body">
        {% if missingFields %}
          <div class="alert alert-warning"><strong>{{ missingFields|length }} case(s) à compléter</strong><ul class="mb-0 mt-2">
          {% for key, field in missingFields %}<li><a data-bpf-field-link href="#{{ attribute(form, key).vars.id }}">Cadre {{ field.section }} · {{ field.label }}</a></li>{% endfor %}
          </ul><p class="small mt-2 mb-0">Cliquez sur un libellé pour accéder à la case. Saisissez 0 uniquement pour une rubrique numérique sans activité.</p></div>
        {% endif %}
        {% set warnings = controlNotices.warnings|filter(issue => 'champ(s) à renseigner' not in issue) %}
        {% if warnings %}<ul class="bpf-issues">{% for issue in warnings %}{% set target = warningTargets[issue] %}<li>
          {% if target.inscription is defined %}<a href="{{ path('app_administrateur_inscription_show', {entite: entite.id, id: target.inscription}) }}#presences-papier">{{ issue }}</a>
          {% else %}<a data-bpf-field-link href="#{{ target.field is defined ? attribute(form, target.field).vars.id : 'bpf-' ~ target.section }}">{{ issue }}</a>{% endif %}
          {% if target.compare is defined %} <a data-bpf-field-link class="small" href="#bpf-{{ target.compare }}">Comparer avec {{ target.compare }}</a>{% endif %}
        </li>{% endfor %}</ul>{% elseif not missingFields %}<div class="alert alert-success">Aucune case obligatoire manquante ni incohérence arithmétique détectée. Vérifiez les justificatifs avant le dépôt.</div>{% endif %}
        {% if controlNotices.information %}<div class="alert alert-info mt-3"><strong>Informations et points de vérification</strong><ul class="mb-0 mt-2">{% for notice in controlNotices.information %}<li>{{ notice }}</li>{% endfor %}</ul></div>{% endif %}
        {{ form_row(form.notes) }}
      </div></section>
      <div class="bpf-save"><div><strong data-bpf-save-status>{{ draft ? 'Préparation enregistrée' : 'Préparation non enregistrée' }}</strong><small>{% if draft %}{{ draft.updatedAt|date('d/m/Y à H:i', 'Europe/Paris') }} · Version {{ draft.version }}{% if draft.updatedBy %} · {{ draft.updatedBy.prenom }} {{ draft.updatedBy.nom }}{% endif %}{% else %}Enregistrez pour conserver les valeurs et exporter le dossier.{% endif %}</small></div><div class="d-flex flex-wrap gap-2">{% if draft %}<a class="btn btn-outline-dark" data-bpf-export href="{{ path('app_administrateur_bpf_pdf', {entite: entite.id, start: start|date('Y-m-d'), end: end|date('Y-m-d')}) }}">Exporter la version enregistrée</a>{% endif %}<button type="submit" class="btn btn-dark"><i class="bi bi-check2 me-2"></i>Enregistrer la préparation</button></div></div>
      {{ form_end(form) }}
      {% if versions %}<section class="bpf-card mt-4"><header><div class="bpf-letter"><i class="bi bi-clock-history"></i></div><div><h2>Historique des préparations</h2><p>Les 30 dernières versions conservées de cet exercice. Chaque export reprend les valeurs, correspondances et justificatifs enregistrés à cette date.</p></div></header><div class="bpf-card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Version</th><th>Enregistrement</th><th>Auteur</th><th>Export</th></tr></thead><tbody>{% for item in versions %}<tr><td>{{ item.payload.version }}</td><td>{{ item.payload.updatedAt|date('d/m/Y à H:i', 'Europe/Paris') }}</td><td>{{ item.payload.author|default('—') }}</td><td><a class="btn btn-outline-dark btn-sm" href="{{ path('app_administrateur_bpf_pdf', {entite: entite.id, start: start|date('Y-m-d'), end: end|date('Y-m-d'), revision: item.id}) }}">Exporter la version {{ item.payload.version }}</a></td></tr>{% endfor %}</tbody></table></div><p class="small text-muted mb-0">Historique constitué à partir de l’activation de cette fonction. Les versions antérieures écrasées ne peuvent pas être reconstituées. Ces exports ne sont pas des accusés de dépôt MAF.</p></div></section>{% endif %}
      <section class="bpf-card mt-4" id="bpf-sources"><header><div class="bpf-letter"><i class="bi bi-journal-text"></i></div><div><h2>Données de rapprochement</h2><p>Vue globale de l’exercice, à rapprocher du détail de génération ci-dessus. Les pièces non classées restent signalées.</p></div></header><div class="bpf-card-body">
        <div class="bpf-source-grid"><div><span>Factures non annulées · EUR · HT brut</span><strong>{{ (source.produits.htCents / 100)|number_format(2, ',', ' ') }} €</strong></div><div><span>Avoirs émis · TTC</span><strong>{{ (source.creditsTtcCents / 100)|number_format(2, ',', ' ') }} €</strong></div><div><span>Inscriptions à rapprocher · Hors sous-traitance reçue</span><strong>{{ source.split.direct.count }}</strong></div><div><span>Inscriptions à rapprocher · Sous-traitance reçue (G)</span><strong>{{ source.split.subcontract.count }}</strong></div></div>
        <p class="small text-muted mt-3">La facturation est regroupée par date d’émission. Vérifiez les avoirs HT, les produits constatés d’avance, les factures à établir, les devises et les activités hors formation dans votre comptabilité. Les contrats formateurs ne sont pas assimilés aux charges du cadre D.</p>
        <p class="small text-muted">Les heures ci-dessous sont celles du planning, pauses déduites, sur les créneaux terminés de l’exercice. Elles ne prouvent pas les heures suivies. Les sessions annulées ou en brouillon et les préinscriptions sont exclues des repères. Contrôlez les présences, abandons et dossiers annulés ayant eu une activité avant annulation.</p>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Session / formation</th><th>Périmètre</th><th class="text-end">Heures planifiées passées</th></tr></thead><tbody>{% for item in source.sessions %}<tr><td><strong>{{ item.code }}</strong><br><span class="small text-muted">{{ item.formation_titre }}</span></td><td>{{ item.subcontract ? 'Sous-traitance reçue · G' : 'À ventiler dans F' }}</td><td class="text-end">{{ (item.minutes_total / 60)|number_format(2, ',', ' ') }} h</td></tr>{% else %}<tr><td colspan="3" class="text-muted">Aucun créneau éligible dans la période. Cela ne signifie pas que l’organisme n’a pas eu d’activité.</td></tr>{% endfor %}</tbody></table></div>
      </div></section>
    </main>
  </div>
</div>
{% endblock %}
{% block javascripts_bottom %}{{ parent() }}<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script><script src="{{ asset('dist/vendors/flatpickr/flatpickr.min.js') }}"></script><script defer src="{{ asset('dist/js/bpf.js') }}?v=3"></script>{% endblock %}
