  const $manualAmounts = document.getElementById('{{ form.amountsManual.vars.id }}');
  let expenseSubmitting = false;
  function preserveAmounts(){ return $manualAmounts?.checked || $ttc?.form?.dataset.applyingReceipt === '1'; }

  // Live calc
  function recalcFromTtc(){
    if (preserveAmounts()) return;
    const taux = parseFloat($taux?.value || '0') || 0;
    const ttc  = window.WikiExpenseInputs.toCents($ttc?.value || 0) / 100;
    if (!($ht && $tva && $ttc)) return;
    if (!Number.isFinite(ttc) || ttc <= 0) return;

    if (taux <= 0.0001){
      $ht.value  = formatMoneyFR(ttc);
      $tva.value = formatMoneyFR(0);
      return;
    }
    const htCents = Math.round(Math.round(ttc * 100) / (1 + taux / 100));
    const ht = htCents / 100;
    const tv = (Math.round(ttc * 100) - htCents) / 100;

    $ht.value  = formatMoneyFR(ht);
    $tva.value = formatMoneyFR(tv);
  }

  function recalcFromHt(){
    if (preserveAmounts()) return;
    const taux = parseFloat($taux?.value || '0') || 0;
    const ht   = parseNumberFR($ht?.value || 0);
    if (!($ht && $tva && $ttc)) return;
    if (!Number.isFinite(ht) || ht <= 0) return;

    const htCents = Math.round(ht * 100);
    const tv = Math.round(htCents * taux / 100) / 100;
    const ttc = (htCents + Math.round(tv * 100)) / 100;

    $tva.value = formatMoneyFR(tv);
    $ttc.value = formatMoneyFR(ttc);
  }

  // Resume + validation
  function isFilled(v){ return !!String(v || '').trim(); }

  function refreshResume(){
    const ht  = parseNumberFR($ht?.value || 0);
    const tv  = parseNumberFR($tva?.value || 0);
    const ttc = parseNumberFR($ttc?.value || 0);

    if ($resume.libelle){
      const v = ($libelle?.value || '').trim();
      $resume.libelle.textContent = v ? (v.length > 42 ? (v.slice(0, 42) + '…') : v) : '—';
    }

    if ($resume.categorie)  $resume.categorie.textContent = getSelectedText($cat) || '—';
    if ($resume.fournisseur)$resume.fournisseur.textContent = getSelectedText($four) || '—';
    if ($resume.payeur)     $resume.payeur.textContent = getSelectedText($payeur) || '—';
    if ($resume.date)       $resume.date.textContent = isFilled($date?.value) ? $date.value.trim() : '—';
    if ($resume.devise)     $resume.devise.textContent = getSelectedText($devise) || '—';

    const manualAmounts = !!$manualAmounts?.checked;
    if ($resume.taux) $resume.taux.textContent = manualAmounts ? 'TVA du justificatif' : (parseFloat($taux?.value || '0') || 0).toString().replace('.', ',') + ' %';
    const rateLabel = document.getElementById('resume-rate-label');
    if (rateLabel) rateLabel.textContent = manualAmounts ? 'Calcul TVA' : 'Taux TVA';
    const calcMode = document.getElementById('expenseCalcMode');
    if (calcMode) calcMode.textContent = manualAmounts ? 'Montants du justificatif' : 'Auto';
    document.getElementById('expenseTaxRateField')?.classList.toggle('d-none', manualAmounts);
    document.getElementById('expenseAutoCalc')?.classList.toggle('d-none', manualAmounts);
    const htHelp = document.getElementById('expenseHtHelp');
    if (htHelp) htHelp.textContent = manualAmounts ? 'Montant HT relevé sur le justificatif.' : 'Montant HT, le TTC sera automatiquement calculé.';
    const amountsHelp = document.getElementById('expenseAmountsHelp');
    if (amountsHelp) amountsHelp.textContent = manualAmounts
      ? 'Vérifiez HT, TVA et TTC sur le justificatif. Aucun montant ne sera recalculé automatiquement : HT + TVA doit être égal au TTC.'
      : 'Saisissez le TTC et choisissez le taux de TVA pour calculer automatiquement le HT et la TVA.';
    if ($resume.deductible) $resume.deductible.textContent = ($ded && $ded.checked) ? 'Oui' : 'Non';

    if ($resume.ht)  $resume.ht.textContent  = (ht  > 0) ? (formatMoneyFR(ht)  + ' €') : '—';
    if ($resume.tva) $resume.tva.textContent = (tv  > 0) ? (formatMoneyFR(tv)  + ' €') : '—';
    if ($resume.ttc) $resume.ttc.textContent = (ttc > 0) ? (formatMoneyFR(ttc) + ' €') : '—';

    


    const pct = parseNumberFR($pct?.value ?? 0);
    const pctClamped = Math.max(0, Math.min(100, pct));
    const isDed = ($ded && $ded.checked);

    const tvaded = isDed ? (tv * (pctClamped / 100)) : 0;

    if ($resume.pct) $resume.pct.textContent = isDed ? (formatMoneyFR(pctClamped).replace(',00','') + ' %') : '—';
    if ($resume.tvaded) $resume.tvaded.textContent = (tvaded > 0) ? (formatMoneyFR(tvaded) + ' €') : '—';


    if ($resume.proof){
      const f = $file?.files && $file.files[0] ? $file.files[0] : null;
      $resume.proof.textContent = f ? 'Sélectionné' : '—';
    }

    if ($pct) {
      $pct.disabled = !isDed;
    }

    [$ht, $tva, $ttc].forEach(input => {
      if (!input) return;
      const cents = window.WikiExpenseInputs.toCents(input.value);
      input.setCustomValidity(Number.isFinite(cents) && cents >= 0 ? '' : 'Saisissez un montant positif avec au maximum deux décimales.');
    });
    const totalsValid = Number.isFinite(ttc) && ttc > 0 && ht >= 0 && tv >= 0 &&
      Math.round(ht * 100) + Math.round(tv * 100) === Math.round(ttc * 100);
    if ($ttc && !$ttc.validationMessage && !totalsValid) $ttc.setCustomValidity('Vérifiez les montants : HT + TVA doit être égal au TTC, qui doit être positif.');
    const ok =
      isFilled($libelle?.value) &&
      isFilled($date?.value) &&
      isFilled($devise?.value) &&
      ttc > 0 && ht >= 0 && tv >= 0 &&
      Math.round(ht * 100) + Math.round(tv * 100) === Math.round(ttc * 100);


    if ($resume.pill){
      if (ok){
        $resume.pill.textContent = '✅ Complet';
        $resume.pill.style.background = 'rgba(25,135,84,.15)';
        $resume.pill.style.borderColor = 'rgba(25,135,84,.35)';
        $resume.pill.style.color = 'var(--ink)';
      } else {
        $resume.pill.textContent = '⚠️ Incomplet';
        $resume.pill.style.background = 'rgba(255,193,7,.15)';
        $resume.pill.style.borderColor = 'rgba(255,193,7,.35)';
        $resume.pill.style.color = 'var(--ink)';
      }
    }

    // disable submit buttons if incomplete
    document.querySelectorAll('button[type="submit"]').forEach(b => { if (b.form === $ttc?.form) b.disabled = !ok || expenseSubmitting; });
  }

  $manualAmounts?.addEventListener('change', () => {
    if (!$manualAmounts.checked) recalcFromTtc();
    refreshResume();
  });
  $ttc?.form?.addEventListener('submit', event => {
    if (expenseSubmitting) { event.preventDefault(); return; }
    refreshResume();
    if (!$ttc.form.checkValidity()) { event.preventDefault(); $ttc.form.reportValidity(); return; }
    expenseSubmitting = true;
    refreshResume();
