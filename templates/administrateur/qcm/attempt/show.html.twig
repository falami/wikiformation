{% extends 'base_admin.html.twig' %}
{% block title %}Résultats du questionnaire{% endblock %}
{% block stylesheets %}
{{ parent() }}
<style>
.qcm-results{max-width:1250px;margin:auto;padding:32px 16px;color:#233342}.qcm-results .result-hero{background:#233342;color:white;border-left:6px solid #ffc107;padding:32px;border-radius:22px;margin-bottom:24px}.qcm-results .result-card{background:white;border:1px solid #e2e8f0;border-radius:18px;padding:24px;margin-bottom:18px}.qcm-results .score{font-size:2.5rem;font-weight:800}.qcm-results .answer-option{padding:12px 16px;border:1px solid #e2e8f0;border-radius:10px;margin-top:8px;display:flex;justify-content:space-between;gap:16px}.qcm-results .answer-correct{background:#edf9f3;border-color:#b5ddc7}.qcm-results .answer-wrong{background:#fff1f2;border-color:#fecdd3}
</style>
{% endblock %}
{% block body %}
<div class="qcm-results">
<a class="btn btn-outline-secondary mb-3" href="{{ path('app_administrateur_qcm_assignment_index', {entite:entite.id}) }}">← Retour aux affectations</a>
<header class="result-hero"><div class="small mb-2">{{ session.code }} · {{ phase.value == 'pre' ? 'Diagnostic initial · PRE' : 'Évaluation finale · POST' }}</div><h1 class="h3 fw-bold">{{ qcm.titre }}</h1><p class="mb-0">{{ stagiaire.prenom }} {{ stagiaire.nom }} · {{ session.formation ? session.formation.titre : 'Formation' }}</p></header>
<div class="row g-3">
<div class="col-md-4"><section class="result-card h-100"><div class="text-muted">Taux de réussite</div><div class="score">{{ attempt.submittedAt and attempt.maxPoints > 0 ? (attempt.scorePercent|number_format(1, ',', ' ') ~ ' %') : '—' }}</div><div>{{ attempt.submittedAt ? (attempt.scorePoints ~ ' / ' ~ attempt.maxPoints ~ ' points') : 'Tentative non soumise' }}</div></section></div>
<div class="col-md-8"><section class="result-card h-100"><h2 class="h6 fw-bold">{{ assignment.status.label }}</h2><p class="small text-muted">{% if phase.value == 'pre' %}Le test PRE mesure le niveau initial : « Soumis » signifie que les réponses sont enregistrées. Il n’est pas soumis à la validation de progression du POST.{% else %}La validation vérifie la progression par rapport au PRE. Elle ne correspond pas à un seuil de réussite.{% endif %}</p><div class="small">Début : {{ attempt.startedAt|date('d/m/Y H:i') }}<br>Soumis : {{ attempt.submittedAt ? attempt.submittedAt|date('d/m/Y H:i') : 'En attente' }}</div></section></div>
</div>
<h2 class="h4 fw-bold mt-4 mb-3">Détail des réponses</h2>
<p class="text-muted small">Les bonnes réponses sont indiquées en vert. Les questions à choix multiples peuvent attribuer des points partiels. Le score ci-dessus est celui enregistré lors de la soumission ; le corrigé ci-dessous utilise le modèle actuel.</p>
{% for question in qcm.questions %}
{% set answer = attempt.answers|filter(a => a.question.id == question.id)|first %}
{% set selected = answer ? answer.selectedOptionIds : [] %}
<section class="result-card"><div class="d-flex justify-content-between gap-3"><h3 class="h6 fw-bold">{{ loop.index }}. {{ question.enonce }}</h3><span class="small text-muted text-nowrap">{{ question.pointsMax }} point(s)</span></div>
{% for option in question.options %}
<div class="answer-option {{ option.correct ? 'answer-correct' : (option.id in selected ? 'answer-wrong' : '') }}"><span>{{ option.label }}</span><span class="small text-nowrap">{{ option.id in selected ? '✓ Choisie' : '' }}{{ option.correct ? ' · Bonne réponse' : '' }}</span></div>
{% endfor %}
{% if selected is empty %}<p class="small text-muted mt-3 mb-0">Aucune réponse enregistrée.</p>{% endif %}
</section>
{% else %}<div class="result-card">Aucune question disponible.</div>{% endfor %}
</div>
{% endblock %}
