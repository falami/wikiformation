{% extends 'base_admin.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/style-table.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">
  <link rel="stylesheet" href="https://cdn.datatables.net/v/bs5/dt-2.2.2/datatables.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">

  <style>
    .qcm-filters .form-label{font-size:.75rem;letter-spacing:.04em;color:#64748b!important;}
    .qcm-filters .form-select,.qcm-filters .form-control,.qcm-filters .ts-control{min-height:46px;border:1px solid #dce3eb;border-radius:12px;background:#fff;padding:12px;}
    .qcm-filters{background:#f8fafc!important;border:1px solid #e2e8f0;box-shadow:none!important;}
    .qcm-filters{padding:0!important;background:#fff!important;overflow:visible;border-radius:22px;box-shadow:0 8px 30px #23334206!important;}
    .qcm-filter-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 28px;border-bottom:1px solid #edf0f4;}
    .qcm-filter-heading-title{display:flex;align-items:center;gap:14px;}
    .qcm-filter-icon{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:#fff7dd;color:#967218;font-size:20px;flex-shrink:0;}
    .qcm-filter-heading h2{font-size:1.1rem;font-weight:750;color:#233342;margin:0 0 5px;}
    .qcm-filter-heading p{font-size:.85rem;color:#7b8898;margin:0;}
    .qcm-filter-reset{border:1px solid #e2e8f0;border-radius:10px;padding:10px 14px;background:white;color:#526477;font-size:.82rem;font-weight:600;white-space:nowrap;transition:background .15s;}
    .qcm-filter-reset:hover{background:#f4f6f9;color:#233342;}
    .qcm-filter-grid{display:grid;grid-template-columns:2fr 1.6fr 1fr 1.2fr 1.4fr;gap:16px;padding:24px 28px;align-items:start;}
    .qcm-filter-grid label{display:block;font-size:.75rem;font-weight:650;color:#64748b;margin-bottom:9px;}
    .qcm-filter-grid .form-control,.qcm-filter-grid .form-select,.qcm-filter-grid .ts-control{height:48px;min-height:48px;font-size:.85rem;padding:12px 14px;border-radius:11px;background-color:#fafbfd;}
    .qcm-filter-grid .ts-wrapper{padding:0;border:0;}
    .qcm-filter-grid .form-select{padding-right:30px;}
    .qcm-filter-grid input:focus,.qcm-filter-grid select:focus{border-color:#b19a54;box-shadow:0 0 0 3px #ffc10718;background-color:#fff;}
    .qcm-search-input{position:relative;}.qcm-search-input>i{position:absolute;left:15px;top:14px;color:#8997a7;}.qcm-search-input input.form-control{padding-left:40px;}
    .qcm-filter-footer{display:flex;align-items:start;justify-content:space-between;gap:20px;padding:14px 28px;background:#f8fafc;border-top:1px solid #edf0f4;border-radius:0 0 22px 22px;color:#7b8898;font-size:.78rem;}
    .qcm-filter-footer details{max-width:650px;text-align:right;}.qcm-filter-footer summary{cursor:pointer;}.qcm-filter-footer details p{margin:12px 0 0;text-align:left;line-height:1.6;}
    @media(max-width:1200px){.qcm-filter-grid{grid-template-columns:repeat(4,minmax(0,1fr));}.qcm-search-field{grid-column:1/-1;}}
    @media(max-width:600px){.qcm-filter-grid{grid-template-columns:1fr 1fr;padding:20px;}.qcm-filter-heading{padding:20px;align-items:start;flex-direction:column;}.qcm-filter-footer{padding:14px 20px;flex-direction:column;}.qcm-filter-footer details{text-align:left;}}
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }


    .hero{
      border-radius: 22px;
      position: relative;
      overflow: hidden;
      color: #fff;

      /* Ombre douce premium */
      box-shadow: 0 18px 50px rgba(0,0,0,.14);

      /* Fond piloté par les couleurs de l'entité */
      background:
        /* halo clair (tertiaire) */
        radial-gradient(1200px 420px at 12% -10%,
          color-mix(in srgb, var(--theme-color-tertiaire) 35%, transparent),
          transparent 58%
        ),
        /* halo accent (secondaire) */
        radial-gradient(900px 380px at 92% 0%,
          color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent),
          transparent 60%
        ),
        /* voile subtil (quaternaire) pour la profondeur */
        radial-gradient(700px 260px at 55% 115%,
          color-mix(in srgb, var(--theme-color-quaternaire) 18%, transparent),
          transparent 62%
        ),
        /* dégradé principal (principal -> plus clair) */
        linear-gradient(135deg,
          color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
          color-mix(in srgb, var(--theme-color-principal) 70%, #fff 30%)
        );
    }

    /* léger glass highlight */
    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0) 55%);
      opacity:.85;
    }

    /* barre accent = secondaire (et glow basé sur secondaire) */
    .hero .accent{
      width: 12px;
      border-radius: 999px;
      background: var(--theme-color-secondaire);
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
    }
    /* chips façon session */
    .hero .meta-chip{
      display:inline-flex; align-items:center; gap:.45rem;
      padding:.28rem .65rem;
      border-radius:999px;
      font-size:.82rem;
      background: rgba(255,255,255,.10);
      border:1px solid rgba(255,255,255,.14);
      color: rgba(255,255,255,.92);
      white-space: nowrap;
    }
    .hero .meta-chip i{ color: var(--theme-color-secondaire); }

    .hero .btn{
      border-radius: 14px;
      font-weight: 800;
    }
    .hero .btn-outline-theme{
      border-color: rgba(255,255,255,.35);
      color:#fff;
    }
    .hero .btn-outline-theme:hover{
      background: rgba(255,255,255,.10);
      border-color: rgba(255,255,255,.55);
      color:#fff;
    }

    /* bouton outline du hero */
    .hero .btn-outline-hero{
      border-color: rgba(255,255,255,.35);
      color:#fff;
    }
    .hero .btn-outline-hero:hover{
      background: rgba(255,255,255,.10);
      border-color: rgba(255,255,255,.55);
      color:#fff;
    }

    .filterbar{
      background:#fff;
      border-radius:18px;
      border:1px solid rgba(0,0,0,.06);
      box-shadow:0 10px 24px rgba(0,0,0,.05);
    }

    .table-card{
      background:#fff;
      border-radius:18px;
      border:1px solid rgba(0,0,0,.06);
      box-shadow:0 12px 30px rgba(0,0,0,.06);
      overflow:visible;
    }

    table.dataTable thead th{
      background:#f7f8fa!important;
      font-size:.78rem;
      text-transform:uppercase;
      letter-spacing:.05em;
      color:rgba(0,0,0,.55);
    }
    table.dataTable td{ vertical-align: middle; }

    /* ✅ Colonne actions compacte + hover reveal */
    #dt th.action-column,
    #dt td.action-column{
      width: 90px !important;
      max-width: 90px !important;
      min-width: 90px !important;
      padding-left: .25rem !important;
      padding-right: .25rem !important;
      white-space: nowrap !important;
      overflow: visible !important;
    }

    #dt{ table-layout: fixed !important; width: 100% !important; }

    #dt td.action-column .btn-group{
      opacity: 0;
      visibility: hidden;
      transform: translateY(2px);
      pointer-events: none;
      transition: opacity .15s ease, transform .15s ease, visibility .15s ease;
    }

    #dt tbody tr:hover td.action-column .btn-group,
    #dt td.action-column:focus-within .btn-group{
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    @media (hover: none){
      #dt td.action-column .btn-group{
        opacity: 1;
        visibility: visible;
        transform: none;
        pointer-events: auto;
      }
    }

    /* TomSelect confort */
    .ts-control{ min-height: calc(1.5em + .75rem + 2px); }

    /* =========================
      ✅ Actions split (style devis)
      ========================= */
    .qcm-actions .btn{ padding: .32rem .55rem; }

    .qcm-actions .qcm-main{
      background: rgba(255,255,255,.85);
      border-color: rgba(0,0,0,.12);
      box-shadow: 0 10px 22px rgba(0,0,0,.06);
    }
    .qcm-actions .qcm-main:hover{
      box-shadow: 0 14px 28px rgba(0,0,0,.10);
      border-color: rgba(0,0,0,.18);
    }

    .qcm-actions .qcm-split{
      padding-left: .55rem;
      padding-right: .55rem;
      border-color: rgba(0,0,0,.12);
      background: rgba(255,255,255,.85);
    }

    .qcm-actions .qcm-menu{
      border-radius: 16px;
      border: 1px solid rgba(0,0,0,.10);
      box-shadow: 0 18px 46px rgba(0,0,0,.18);
      padding: .55rem;
      background: radial-gradient(900px 220px at 10% 0%, rgba(255,193,7,.10), transparent 55%), #fff;
      overflow: hidden;
    }
    .qcm-actions .qcm-menu .dropdown-item{
      border-radius: 12px;
      padding: .50rem .60rem;
      margin: .10rem 0;
      border: 1px solid transparent;
    }
    .qcm-actions .qcm-menu .dropdown-item:hover{
      background: rgba(255,193,7,.10);
      border-color: rgba(255,193,7,.22);
    }

    .qcm-actions.btn-group .qcm-main{
      border-top-right-radius: 0 !important;
      border-bottom-right-radius: 0 !important;
    }
    .qcm-actions.btn-group .qcm-split{
      border-top-left-radius: 0 !important;
      border-bottom-left-radius: 0 !important;
      margin-left: -1px;
      position: relative;
    }
    .qcm-actions.btn-group .qcm-split:before{
      content:"";
      position:absolute;
      left:0; top:20%; bottom:20%;
      width:1px;
      background: rgba(0,0,0,.10);
    }

    body .qcm-floating-dropdown{ z-index: 20000 !important; }

    /* ✅ ne pas masquer quand dropdown ouvert */
    #dt td.action-column .qcm-actions{
      opacity: 1 !important;
      visibility: visible !important;
    }
    #dt td.action-column .qcm-actions:focus-within{
      opacity: 1 !important;
      visibility: visible !important;
    }
  </style>
{% endblock %}

{% block body %}


  <div class="hero p-3 mb-4 d-flex gap-3">
    <div class="accent"></div>

    <div class="flex-grow-1">
      <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
        <div>
          <h2 class="m-0 fw-bold">
            <i class="bi bi-ui-checks me-2" style="color:var(--theme-color-secondaire)"></i>
            {{ title }}
          </h2>

          <div class="opacity-75 mt-1">
            Affecte 2 QCM par stagiaire : <strong>PRE</strong> (début) + <strong>POST</strong> (fin).
            <span class="ms-2"><strong>{{ entite.nom }}</strong></span>
          </div>

          <div class="d-flex gap-2 flex-wrap mt-3">
            <span class="meta-chip"><i class="bi bi-ui-checks"></i> QCM</span>
            <span class="meta-chip"><i class="bi bi-diagram-3"></i> Affectations</span>
            <span class="meta-chip"><i class="bi bi-building"></i> {{ entite.nom }}</span>
            <span class="meta-chip"><i class="bi bi-clock-history"></i> <span id="hero-last-refresh">—</span></span>
          </div>
        </div>

        <div class="d-flex gap-2">
          <a class="btn btn-outline-hero btn-sm fw-semibold"
            href="{{ path('app_administrateur_qcm_index', { entite: entite.id }) }}">
            <i class="bi bi-arrow-left me-1"></i> QCM
          </a>

          <button type="button" class="btn btn-light btn-sm fw-semibold"
                  onclick="document.getElementById('bulkSession')?.scrollIntoView({behavior:'smooth', block:'center'})">
            <i class="bi bi-magic me-1"></i> Affectation rapide
          </button>
        </div>
      </div>
    </div>
  </div>

  {% include 'flagMessage.html.twig' %}

  {# ✅ Affectation rapide (premium card) #}
  <div class="table-card p-3 mb-3">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="fw-bold"><i class="bi bi-magic"></i> Affectation rapide</div>
      <div class="text-muted small">crée les assignments manquants (anti-doublon)</div>
    </div>

    <div class="row g-2 align-items-end">
      <div class="col-12 col-md-4">
        <label class="form-label small text-muted fw-bold">Session</label>
        <select id="bulkSession" class="form-select form-select-sm js-tomselect" data-placeholder="— Choisir —">
          <option value="">— Choisir —</option>
          {% for s in sessions %}
            <option value="{{ s.id }}">
              {{ s.code is defined and s.code ? s.code : ('Session #'~s.id) }}
              {% if s.formation is defined and s.formation %} - {{ s.formation.titre }}{% else %} - {{ s.formationIntituleLibre }}{% endif %}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="col-12 col-md-4">
        <label class="form-label small text-muted fw-bold">QCM PRE</label>
        <select id="bulkQcmPre" class="form-select form-select-sm js-tomselect" data-placeholder="— Choisir —">
          <option value="">— Choisir —</option>
          {% for q in qcms %}
            <option value="{{ q.id }}">{{ q.titre }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="col-12 col-md-4">
        <label class="form-label small text-muted fw-bold">QCM POST</label>
        <select id="bulkQcmPost" class="form-select form-select-sm js-tomselect" data-placeholder="— Choisir —">
          <option value="">— Choisir —</option>
          {% for q in qcms %}
            <option value="{{ q.id }}">{{ q.titre }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="col-12 d-flex justify-content-end">
        <button id="btnBulkAssign" class="btn btn-gradient btn-sm fw-semibold">
          <i class="bi bi-send-check"></i> Affecter PRE + POST
        </button>
      </div>
    </div>
  </div>

  {# ✅ Filtres (premium filterbar) #}
  <section class="filterbar qcm-filters mb-4" data-list-filters="dt" aria-labelledby="qcm-filter-title">
    <div class="qcm-filter-heading">
      <div class="qcm-filter-heading-title"><span class="qcm-filter-icon"><i class="bi bi-sliders2"></i></span><div><h2 id="qcm-filter-title">Rechercher une affectation</h2><p>Retrouvez un participant, une session ou un questionnaire.</p></div></div>
      <button id="btnReset" class="qcm-filter-reset" type="button"><i class="bi bi-arrow-counterclockwise"></i> Effacer les filtres</button>
    </div>
    <div class="qcm-filter-grid">
      <div class="qcm-search-field"><label for="qcmSearch">Recherche globale</label><div class="qcm-search-input"><i class="bi bi-search" aria-hidden="true"></i><input id="qcmSearch" data-list-search type="search" class="form-control" placeholder="Nom, e-mail, questionnaire…" autocomplete="off"></div></div>
      <div><label for="sessionFilter">Session</label><select data-wf-single id="sessionFilter" class="form-select js-tomselect"><option value="all">Toutes les sessions</option>{% for s in sessions %}<option value="{{ s.id }}">{{ s.code ?: ('Session #' ~ s.id) }}</option>{% endfor %}</select></div>
      <div><label for="phaseFilter">Phase</label><select data-wf-single id="phaseFilter" class="form-select"><option value="all">Toutes les phases</option><option value="pre">PRE · Début</option><option value="post">POST · Fin</option></select></div>
      <div><label for="statusFilter">Statut</label><select data-wf-single id="statusFilter" class="form-select"><option value="all">Tous les statuts</option><option value="assigned">Assigné</option><option value="started">En cours</option><option value="submitted">Soumis</option><option value="review_required">À relire</option><option value="validated">Validé</option></select></div>
      <div><label for="stagiaireFilter">Stagiaire</label><input id="stagiaireFilter" class="form-control" placeholder="Nom ou e-mail"></div>
    </div>
    <div class="qcm-filter-footer"><span id="qcmFilterSummary" aria-live="polite">Aucun filtre actif</span><details><summary><i class="bi bi-info-circle"></i> Comprendre les statuts</summary><p>PRE : diagnostic initial soumis. POST : validé si le score ne régresse pas par rapport au PRE ; sinon, à relire. La validation ne correspond pas à un seuil de réussite.</p></details></div>
  </section>

  {# ✅ Table (premium table-card) #}
  <div class="table-card p-2">
    <div class="d-flex flex-wrap align-items-center gap-2 p-3 bg-light rounded-4 mb-3">
      <label class="me-2"><input type="checkbox" id="selectQcmPage" class="form-check-input me-2">Sélectionner la page</label>
      <span id="qcmSelectionCount" class="small text-muted me-auto" aria-live="polite">0 sélectionnée</span>
      <button type="button" class="btn btn-outline-primary btn-sm" id="batchAttempt" disabled>Créer les tentatives</button>
      <button type="button" class="btn btn-outline-danger btn-sm" id="batchRemove" disabled>Retirer les affectations</button>
    </div>
    <div id="qcmBatchFeedback" role="status" class="px-3 mb-2"></div>
    <table id="dt" class="table table-hover align-middle mb-0 w-100">
      <thead>
        <tr>
          <th>#</th>
          <th>Stagiaire</th>
          <th>Email</th>
          <th>Session</th>
          <th>QCM</th>
          <th>Phase</th>
          <th>Statut</th>
          <th>Assigné</th>
          <th>Soumis</th>
          <th>Taux de réussite</th><th class="action-column text-end">Actions</th>
        </tr>
      </thead>
    </table>
  </div>

<div class="modal fade" id="qcmBatchModal" data-token="{{ csrf_token('qcm_batch_' ~ entite.id) }}" tabindex="-1" aria-labelledby="qcmBatchTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content rounded-4 border-0 shadow">
    <div class="modal-header"><h2 class="modal-title h5 fw-bold" id="qcmBatchTitle"></h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Fermer"></button></div>
    <div class="modal-body p-4">
      <p id="qcmBatchDescription"></p>
      <ul id="qcmBatchItems" class="bg-light rounded-3 p-4" style="max-height:240px;overflow:auto"></ul>
      <div id="qcmBatchWarning" class="alert alert-warning" hidden>Des tentatives existent déjà. Leurs réponses et résultats seront également supprimés. Cette action est irréversible.</div>
      <div id="qcmBatchError" class="text-danger" role="alert"></div>
    </div>
    <div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Annuler</button><button class="btn btn-danger" type="button" id="qcmBatchConfirm">Confirmer</button></div>
  </div></div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.datatables.net/v/bs5/dt-2.2.2/datatables.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>

  <script>
    (function(){
      const ajaxUrl = "{{ path('app_administrateur_qcm_assignment_ajax', { entite: entite.id }) }}";
      const assignUrlTpl = "{{ path('app_administrateur_qcm_assignment_assign_session', { entite: entite.id, session: 0 }) }}";
      let dt = null;

      function initTomSelect(){
        document.querySelectorAll('select.js-tomselect').forEach((el)=>{
          if (el.tomselect) return;
          new TomSelect(el, {
            plugins: ['clear_button'],
            create: false,
            allowEmptyOption: true,
            maxItems: 1,
            placeholder: el.dataset.placeholder || 'Rechercher…',
            render: { no_results: () => '<div class="px-2 py-1 text-muted">Aucun résultat</div>' }
          });
        });
      }

      function init(){
        if (dt) return;
        initTomSelect();

        // init hero clock au chargement
        (() => {
          const el = document.getElementById('hero-last-refresh');
          if (!el) return;
          const d = new Date();
          el.textContent = 'Maj : ' + d.toLocaleDateString('fr-FR') + ' ' +
            d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
        })();

        const table = document.querySelector('#dt');
        if (!table) return;

        if (!dt) {
          dt = new DataTable('#dt', {
            serverSide: true,
            processing: true,
            searching: true,
            pageLength: 25,
            autoWidth: false,
            scrollX: true,
            order: [[0,'desc']],
            ajax: {
              url: ajaxUrl,
              type: 'POST',
              data: function(d){
                d.sessionFilter   = document.getElementById('sessionFilter')?.value || 'all';
                d.phaseFilter     = document.getElementById('phaseFilter')?.value || 'all';
                d.statusFilter    = document.getElementById('statusFilter')?.value || 'all';
                d.stagiaireFilter = document.getElementById('stagiaireFilter')?.value || '';
              }
            },
            columns: [
              { data: 'id', width:'100px', render: (value, type, row) => type === 'display' ? `<input type="checkbox" class="form-check-input js-qcm-select me-2" value="${Number(row.assignmentId)}" aria-label="Sélectionner l’affectation ${Number(row.assignmentId)}">${value}` : value },
              { data: 'stagiaire' },
              { data: 'email' },
              { data: 'session' },
              { data: 'qcm' },
              { data: 'phase', orderable:false, searchable:false },
              { data: 'status', orderable:false, searchable:false },
              { data: 'assignedAt' },
              { data: 'submittedAt' },
              { data: 'result', orderable:false, searchable:false, className:'text-center' },
              { data: 'actions', orderable:false, searchable:false, className:'action-column text-end' },
            ],
            columnDefs: [
              { targets: [0,5,6,7,8], className: 'text-center' },
              { targets: 10, className: 'action-column text-end' }
            ],
            language: { url: "https://cdn.datatables.net/plug-ins/2.2.2/i18n/fr-FR.json" }
          });
        }

        (function enableQcmFloatingDropdown(){
          document.addEventListener('show.bs.dropdown', function(e){
      if (e.target.closest?.('.wf-table-actions')) return; // Gestion commune des tableaux
            const toggle = e.target;
            if (!toggle.closest('.qcm-actions')) return;

            const group = toggle.closest('.btn-group');
            const menu = group?.querySelector('.dropdown-menu');
            if (!menu) return;

            if (!menu.__originalParent) menu.__originalParent = group;

            document.body.appendChild(menu);
            menu.classList.add('qcm-floating-dropdown');

            const rect = toggle.getBoundingClientRect();
            menu.style.position = 'absolute';
            menu.style.top = '0px';
            menu.style.left = '0px';
            menu.style.display = 'block';

            const menuRect = menu.getBoundingClientRect();
            const top = rect.bottom + window.scrollY + 6;
            let left = (rect.right + window.scrollX - menuRect.width);

            left = Math.max(8, Math.min(left, window.scrollX + window.innerWidth - menuRect.width - 8));

            menu.style.top = `${top}px`;
            menu.style.left = `${left}px`;
          }, true);

          document.addEventListener('hidden.bs.dropdown', function(e){
      if (e.target.closest?.('.wf-table-actions')) return; // Gestion commune des tableaux
            const toggle = e.target;
            if (!toggle.closest('.qcm-actions')) return;

            document.querySelectorAll('body .qcm-floating-dropdown').forEach(menu => {
              if (menu.__originalParent) {
                menu.__originalParent.appendChild(menu);
                menu.classList.remove('qcm-floating-dropdown');
                menu.style.position = '';
                menu.style.top = '';
                menu.style.left = '';
                menu.style.display = '';
              }
            });
          }, true);
        })();

        function updateFilterSummary(){
          const count = ['sessionFilter','phaseFilter','statusFilter'].filter(id => document.getElementById(id).value !== 'all').length
            + Number(!!document.getElementById('stagiaireFilter').value.trim()) + Number(!!document.getElementById('qcmSearch').value.trim());
          document.getElementById('qcmFilterSummary').textContent = count ? `${count} filtre${count > 1 ? 's' : ''} actif${count > 1 ? 's' : ''}` : 'Aucun filtre actif';
        }
        const refresh = ()=> { updateFilterSummary(); dt.ajax.reload(null, true); };
        const oldRefresh = refresh;
        const refreshWithHero = ()=>{
          const el = document.getElementById('hero-last-refresh');
          if(el){
            const d = new Date();
            el.textContent = 'Maj : ' + d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
          }
          oldRefresh();
        };

        ['sessionFilter','phaseFilter','statusFilter'].forEach(id=>{
          document.getElementById(id)?.addEventListener('change', refreshWithHero);
        });

        let searchTimer;
        document.getElementById('qcmSearch').addEventListener('input', e => {
          clearTimeout(searchTimer);
          const value = e.target.value;
          updateFilterSummary();
          searchTimer = setTimeout(() => dt.search(value).draw(), 250);
        });
        let t;
        document.getElementById('stagiaireFilter')?.addEventListener('input', ()=>{
          clearTimeout(t);
          t = setTimeout(refreshWithHero, 250);
        });

        document.getElementById('btnReset')?.addEventListener('click', ()=>{
          clearTimeout(t);
          clearTimeout(searchTimer);
          document.getElementById('qcmSearch').value = '';
          dt.search('');
          document.getElementById('sessionFilter').value = 'all';
          document.getElementById('phaseFilter').value = 'all';
          document.getElementById('statusFilter').value = 'all';
          document.getElementById('stagiaireFilter').value = '';

          document.getElementById('sessionFilter')?.tomselect?.setValue('all', true);
          document.getElementById('phaseFilter')?.tomselect?.setValue('all', true);
          document.getElementById('statusFilter')?.tomselect?.setValue('all', true);

          refreshWithHero();
        });

        async function postForm(url, body){
          const r = await fetch(url, {
            method: 'POST',
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams(body),
            credentials: 'same-origin'
          });

          const ct = r.headers.get('content-type') || '';
          const payload = ct.includes('application/json') ? await r.json() : { ok:false, message: await r.text() };

          if (!r.ok || payload?.ok === false) throw new Error(payload?.message || `Erreur (${r.status})`);
          return payload;
        }

        document.getElementById('btnBulkAssign')?.addEventListener('click', async (e)=>{
          e.preventDefault();

          const sid  = document.getElementById('bulkSession')?.value || '';
          const pre  = document.getElementById('bulkQcmPre')?.value || '';
          const post = document.getElementById('bulkQcmPost')?.value || '';

          if (!sid || !pre || !post) {
            alert('Choisis une session + un QCM PRE + un QCM POST.');
            return;
          }
          if (!confirm('Créer les affectations manquantes PRE + POST pour tous les inscrits ?')) return;

          const url = assignUrlTpl.replace('/0', '/'+sid);
          try{
            const payload = await postForm(url, { qcmPreId: pre, qcmPostId: post });
            alert(`OK — ${payload.created} affectation(s) créée(s).`);
            refreshWithHero();
          }catch(err){
            console.error(err);
            alert(err?.message || 'Action impossible');
          }
        });

        const selected = new Set();
        const modalEl = document.getElementById('qcmBatchModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        const confirmButton = document.getElementById('qcmBatchConfirm');
        let pending = null;
        let busy = false;
        const plain = value => { const doc = new DOMParser().parseFromString(value || '', 'text/html'); return doc.body.textContent || ''; };
        function updateSelection() {
          const boxes = [...document.querySelectorAll('#dt .js-qcm-select')];
          boxes.forEach(box => box.checked = selected.has(Number(box.value)));
          const all = document.getElementById('selectQcmPage');
          all.checked = boxes.length > 0 && boxes.every(box => box.checked);
          all.indeterminate = boxes.some(box => box.checked) && !all.checked;
          document.getElementById('qcmSelectionCount').textContent = `${selected.size} affectation(s) sélectionnée(s)`;
          document.getElementById('batchAttempt').disabled = !selected.size;
          document.getElementById('batchRemove').disabled = !selected.size;
        }
        dt.on('draw', () => { selected.clear(); updateSelection(); });
        document.getElementById('selectQcmPage').addEventListener('change', e => {
          selected.clear();
          if (e.target.checked) document.querySelectorAll('#dt .js-qcm-select').forEach(box => selected.add(Number(box.value)));
          updateSelection();
        });
        document.addEventListener('change', e => {
          if (!e.target.matches('.js-qcm-select')) return;
          const id = Number(e.target.value);
          if (e.target.checked) selected.add(id); else selected.delete(id);
          updateSelection();
        });
        function openBatch(action, ids) {
          if (busy || !ids.length) return;
          const rows = dt.rows().data().toArray().filter(row => ids.includes(Number(row.assignmentId)));
          if (rows.length !== ids.length) return;
          pending = {action, ids};
          const removing = action === 'remove';
          document.getElementById('qcmBatchTitle').textContent = removing ? 'Retirer les affectations' : 'Créer les tentatives';
          document.getElementById('qcmBatchDescription').textContent = removing
            ? `${ids.length} affectation(s) seront retirées. Les modèles restent disponibles et ces affectations ne seront pas recréées automatiquement.`
            : `${ids.length} affectation(s) sélectionnée(s). Seules les tentatives absentes seront créées ; les tentatives existantes seront conservées.`;
          const list = document.getElementById('qcmBatchItems'); list.replaceChildren();
          rows.forEach(row => { const li = document.createElement('li'); li.textContent = `${plain(row.stagiaire)} · ${plain(row.qcm)} · ${plain(row.phase)} · Session ${plain(row.session)}`; list.append(li); });
          document.getElementById('qcmBatchWarning').hidden = !removing || !rows.some(row => row.hasAttempt);
          document.getElementById('qcmBatchError').textContent = '';
          confirmButton.className = removing ? 'btn btn-danger' : 'btn btn-primary';
          confirmButton.textContent = removing ? 'Confirmer le retrait' : 'Créer les tentatives';
          confirmButton.disabled = false;
          modal.show();
        }
        document.getElementById('batchAttempt').addEventListener('click', () => openBatch('attempt', [...selected]));
        document.getElementById('batchRemove').addEventListener('click', () => openBatch('remove', [...selected]));
        document.addEventListener('click', e => {
          const button = e.target.closest('.js-remove-assignment, .js-force-attempt');
          if (!button) return;
          e.preventDefault();
          openBatch(button.matches('.js-remove-assignment') ? 'remove' : 'attempt', [Number(button.dataset.id)]);
        }, true);
        modalEl.addEventListener('hide.bs.modal', e => { if (busy) e.preventDefault(); });
        confirmButton.addEventListener('click', async () => {
          if (!pending || busy) return;
          busy = true; confirmButton.disabled = true;
          try {
            const result = await postForm({{ path('app_administrateur_qcm_assignment_batch', {entite: entite.id})|json_encode|raw }}, {
              _token: modalEl.dataset.token, action: pending.action, ids: JSON.stringify(pending.ids)
            });
            document.getElementById('qcmBatchFeedback').textContent = `${result.changed} ${pending.action === 'remove' ? 'affectation(s) retirée(s)' : 'tentative(s) créée(s)'}.`;
            busy = false; modal.hide(); pending = null; selected.clear(); refreshWithHero();
          } catch (error) {
            document.getElementById('qcmBatchError').textContent = 'Action impossible. Rechargez la liste puis réessayez.';
          } finally { busy = false; confirmButton.disabled = false; }
        });

      }

      document.addEventListener('DOMContentLoaded', init);
      document.addEventListener('turbo:load', init);
    })();
  </script>
{% endblock %}
