{% if rating and rating.votes > 0 %}<div class="learner-rating" title="{{ description|default('Moyenne des appréciations stagiaires soumises') }}"><div class="learner-rating-line"><span class="learner-stars" aria-hidden="true"><span>★★★★★</span><span class="learner-stars-fill" style="width:{{ rating.average * 10 }}%">★★★★★</span></span><strong>{{ rating.average|number_format(1,',',' ') }}<small>/10</small></strong></div><span class="learner-votes">{{ rating.votes }} avis stagiaire{{ rating.votes > 1 ? 's' : '' }}</span></div>{% else %}<span class="learner-votes">Pas encore d’avis</span>{% endif %}
