{% extends 'base_admin.html.twig' %}
{% block title %}Nouvelle affectation de satisfaction{% endblock %}
{% block body %}
<div class="container py-4" style="max-width:1000px">
  <a class="btn btn-outline-secondary mb-4" href="{{ path('app_administrateur_satisfaction_assignment_index', {entite: entite.id}) }}"><i class="bi bi-arrow-left"></i> Affectations de satisfaction</a>
  <div class="rounded-4 p-4 mb-4 text-white" style="background:linear-gradient(120deg,#233342,#52616a);border-left:6px solid #ffc107">
    <h1 class="h3">Nouvelle affectation</h1>
    <p class="mb-0">Attribuez un questionnaire de satisfaction aux stagiaires de vos sessions.</p>
  </div>
  <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
    {{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="mb-4">{{ form_row(form.template) }}</div>
    <div class="mb-4">{{ form_row(form.inscriptions) }}</div>
    <div class="mb-4">{{ form_row(form.required) }}</div>
    <p class="text-muted small">Les affectations existantes et leurs réponses sont conservées. Cette action n’envoie pas d’e-mail.</p>
    <div class="d-flex justify-content-end gap-2">
      <a class="btn btn-outline-secondary" href="{{ path('app_administrateur_satisfaction_assignment_index', {entite: entite.id}) }}">Annuler</a>
      <button class="btn btn-warning fw-semibold" type="submit"><i class="bi bi-plus-circle me-1"></i> Créer les affectations</button>
    </div>
    {{ form_end(form) }}
  </div></div>
</div>
{% endblock %}
