{% extends 'base_admin.html.twig' %}
{% block title %}Aperçu — {{ template.titre }}{% endblock %}
{% block stylesheets %}
{{ parent() }}
{% include 'satisfaction/_survey_style.html.twig' %}
{% endblock %}
{% block javascripts %}{{ parent() }}
  <script src="{{ asset('dist/js/survey-rating.js') }}" defer></script>
{% endblock %}
{% block body %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% set questionCount = 0 %}
{% for chapter in template.chapters %}{% set questionCount = questionCount + chapter.questions|length %}{% endfor %}
<main class="sr-survey">
<a class="sr-back" href="{{ path('app_administrateur_satisfaction_template_index', {entite: entite.id}) }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Bibliothèque des questionnaires</a>
<header class="entity-hero sr-hero">
<div><span class="sr-eyebrow">Votre expérience compte</span><h1>{{ template.titre }}</h1><p>Un moment pour partager votre ressenti et contribuer à la qualité de nos formations.</p></div>
<div class="sr-hero-symbol" aria-hidden="true"><i class="bi bi-chat-square-heart"></i></div>
</header>
<div class="sr-toolbar"><div class="sr-meta"><span><i class="bi bi-list-check" aria-hidden="true"></i> {{ questionCount }} question{{ questionCount > 1 ? 's' : '' }}</span><span>{{ template.chapters|length }} rubrique{{ template.chapters|length > 1 ? 's' : '' }}</span><span>{{ entite.nom }}</span></div><a class="sr-edit" href="{{ path('app_administrateur_satisfaction_template_edit', {entite: entite.id, id: template.id}) }}"><i class="bi bi-pencil" aria-hidden="true"></i> Modifier le questionnaire</a></div>
<div class="sr-notice"><i class="bi bi-eye" aria-hidden="true"></i><div><strong>Aperçu interactif</strong><p>Essayez le questionnaire comme un stagiaire. Aucune réponse ni affectation n’est enregistrée.</p></div></div>
{% for chapter in template.chapters %}
<section class="sr-chapter" aria-labelledby="preview-chapter-{{ chapter.id }}">
<div class="sr-chapter-head"><span class="sr-chapter-number">{{ '%02d'|format(loop.index) }}</span><div><small>VOTRE RETOUR D’EXPÉRIENCE</small><h2 id="preview-chapter-{{ chapter.id }}">{{ chapter.titre }}</h2></div></div>
{% for question in chapter.questions %}
{% set field = 'q_' ~ question.id %}
{% if attribute(form, field) is defined %}
<div class="preview-question"><div class="sr-question-meta">Question {{ '%02d'|format(loop.index) }}</div>
{% if question.type.value in ['scale', 'stars'] %}
{% include 'satisfaction/_rating.html.twig' with {field: attribute(form, field)} only %}
{% else %}{{ form_row(attribute(form, field)) }}{% endif %}
</div>
{% endif %}
{% else %}<p class="p-4 text-muted">Aucune question dans ce chapitre.</p>{% endfor %}
</section>
{% else %}<p class="sr-notice">Ce questionnaire ne contient pas encore de chapitre.</p>{% endfor %}
<p class="sr-end"><i class="bi bi-check2-circle" aria-hidden="true"></i> Fin de l’aperçu · Aucune réponse n’est transmise.</p>
</main>
{% endblock %}
