{% extends 'base_admin.html.twig' %}
{% import 'administrateur/satisfaction/template/_editor_fields.html.twig' as editor %}
{% set trainerEditor = trainerEditor|default(false) %}
{% set editorIndexRoute = trainerEditor ? 'app_administrateur_formateur_satisfaction_template_index' : 'app_administrateur_satisfaction_template_index' %}
{% block title %}{{ template.id ? 'Modifier le questionnaire' : 'Nouveau questionnaire' }} — {{ trainerEditor ? 'Satisfaction formateur' : 'Satisfaction' }}{% endblock %}


{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }
  </style>
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
  <link rel="stylesheet" href="{{ asset('dist/css/satisfaction-editor.css') }}?v=1">
{% endblock %}

{% block body %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% set questionCount = 0 %}
{% set requiredCount = 0 %}
{% for chapter in form.chapters %}
  {% set questionCount = questionCount + chapter.questions|length %}
  {% for question in chapter.questions %}
    {% if question.required.vars.checked %}{% set requiredCount = requiredCount + 1 %}{% endif %}
  {% endfor %}
{% endfor %}
<div class="satisfaction-editor">
  <nav class="se-breadcrumb" aria-label="Fil d’Ariane">
    <a href="{{ path(editorIndexRoute, {entite: entite.id}) }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> {{ trainerEditor ? 'Questionnaires formateurs' : 'Questionnaires de satisfaction' }}</a>
    <span aria-hidden="true">/</span><span>{{ template.id ? 'Modifier' : 'Créer' }}</span>
  </nav>
  <header class="se-hero">
    <div class="se-hero-main">
      <div class="se-eyebrow"><span></span> {{ trainerEditor ? 'L’EXPÉRIENCE DE VOS FORMATEURS' : 'L’EXPÉRIENCE DE VOS STAGIAIRES' }}</div>
      <h1>Éditeur de questionnaire<span>.</span></h1>
      <p>{{ trainerEditor ? 'Des retours de terrain pour faire progresser vos formations.' : 'Des questions bien pensées. Des retours qui font progresser vos formations.' }}</p>
      <div class="se-hero-meta"><span><i class="bi bi-building" aria-hidden="true"></i> {{ entite.nom }}</span><span class="se-status" id="editorStatus">{{ form.isActive.vars.checked ? 'Actif' : 'Inactif' }}</span></div>
    </div>
    <div class="se-hero-side">
      <div class="se-hero-icon" aria-hidden="true"><i class="bi bi-ui-checks"></i></div>
      <button type="submit" form="tplForm" class="btn se-btn-gold"><i class="bi bi-check2" aria-hidden="true"></i> Enregistrer le questionnaire</button>
      <span class="se-hero-caption">Votre modèle, prêt pour vos prochaines sessions.</span>
    </div>
  </header>
  <div class="se-overview" aria-label="Composition du questionnaire">
    <div><strong data-chapter-count>{{ form.chapters|length }}</strong><span>Chapitres</span></div>
    <div><strong data-question-count>{{ questionCount }}</strong><span>Questions</span></div>
    <div><strong data-required-count>{{ requiredCount }}</strong><span>Obligatoires</span></div>
    <p><i class="bi bi-pencil-square" aria-hidden="true"></i> {{ template.id ? 'Personnalisez votre questionnaire existant' : 'Créez un modèle adapté à vos formations' }}</p>
  </div>
  {% include 'flagMessage.html.twig' %}
  {{ form_start(form, {attr: {id: 'tplForm', novalidate: 'novalidate'}}) }}
  {{ form_errors(form) }}
  <div class="se-workspace">
    <aside class="se-sidebar" aria-label="Paramètres du questionnaire">
      <section class="se-panel se-settings">
        <div class="se-panel-heading"><span class="se-step">01</span><div><span class="se-overline">LES ESSENTIELS</span><h2>Paramètres</h2></div><i class="bi bi-sliders2" aria-hidden="true"></i></div>
        <div class="se-panel-body">
          {{ form_row(form.titre, {label: 'Nom du questionnaire', attr: {class: 'form-control', placeholder: 'Ex. Évaluation de fin de formation'}}) }}
          {% if form.formations is defined %}
            <details class="se-formations">
              <summary><span class="se-summary-icon"><i class="bi bi-mortarboard" aria-hidden="true"></i></span><span><strong>Formations concernées</strong><small id="formationCount">{{ form.formations.vars.value|length ? form.formations.vars.value|length ~ ' formation(s) sélectionnée(s)' : 'Toutes les formations' }}</small></span><i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
              <div class="se-formations-content">
                {{ form_row(form.formations, {label: 'Sélectionner les formations', help: 'Sans sélection, ce questionnaire s’applique à toutes vos formations.', attr: {class: 'form-select js-tomselect', multiple: 'multiple'}}) }}
              </div>
            </details>
          {% endif %}
          {% if form.isActive is defined %}
            <div class="se-activation">
              <div><label for="{{ form.isActive.vars.id }}">Questionnaire actif</label><p>Disponible pour vos sessions de formation.</p></div>
              <div class="form-check form-switch">{{ form_widget(form.isActive, {label: false, attr: {class: 'form-check-input'}}) }}</div>
            </div>
            {{ form_errors(form.isActive) }}
          {% endif %}
        </div>
      </section>
      <section class="se-panel se-outline-panel">
        <div class="se-outline-heading"><h2><i class="bi bi-list-nested" aria-hidden="true"></i> Dans ce questionnaire</h2><span data-chapter-count>{{ form.chapters|length }}</span></div>
        <ol id="chapterOutline" class="se-outline">
          {% for c in form.chapters %}<li><a href="#chapter-{{ c.vars.name }}"><span>{{ '%02d'|format(loop.index) }}</span><span>{{ c.titre.vars.value ?: 'Nouveau chapitre' }}</span></a></li>{% endfor %}
        </ol>
      </section>
      <div class="se-tip"><i class="bi bi-lightbulb" aria-hidden="true"></i><div><strong>Un retour de qualité commence par une question claire.</strong><p>Privilégiez des intitulés courts et une seule idée par question.</p></div></div>
    </aside>
    <main class="se-canvas" aria-label="Contenu du questionnaire">
      <div class="se-canvas-heading"><div><span class="se-overline">02 / LE CONTENU</span><h2>Chapitres & questions</h2><p>Organisez votre questionnaire dans l’ordre de votre choix.</p></div><button type="button" class="btn se-btn-dark" id="btnAddChapter"><i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter un chapitre</button></div>
      <div class="se-reorder-hint"><i class="bi bi-grip-vertical" aria-hidden="true"></i> Déplacez les poignées pour réorganiser les chapitres et les questions.</div>
      {{ form_errors(form.chapters) }}
      {% set questionProto = editor.question(form.chapters.vars.prototype.questions.vars.prototype) %}
      {% set chapterProto = editor.chapter(form.chapters.vars.prototype, questionProto, true) %}
      {% set nextChapterIndex = 0 %}
      {% for c in form.chapters %}{% set nextChapterIndex = max(nextChapterIndex, c.vars.name + 1) %}{% endfor %}
      <div id="chapters" data-index="{{ nextChapterIndex }}" data-prototype="{{ chapterProto|e('html_attr') }}">
        {% for c in form.chapters %}{{ editor.chapter(c, questionProto, false, loop.index) }}{% endfor %}
      </div>
      <div class="se-empty" id="chaptersEmpty" {{ form.chapters|length ? 'hidden' }}><i class="bi bi-journal-plus" aria-hidden="true"></i><h3>Tout commence par un chapitre.</h3><p>Ajoutez votre premier chapitre, puis composez vos questions.</p></div>
    </main>
  </div>
  <div class="se-savebar"><div><i class="bi bi-check2-circle" aria-hidden="true"></i><span id="editorSaveState" role="status">Aucune modification en cours</span></div><div class="se-save-actions"><a href="{{ path(editorIndexRoute, {entite: entite.id}) }}" class="btn se-btn-quiet">Retour à la liste</a><button type="submit" class="btn se-btn-gold"><i class="bi bi-check2" aria-hidden="true"></i> Enregistrer</button></div></div>
  <div hidden>{{ form_rest(form) }}</div>
  {{ form_end(form, {render_rest: false}) }}
</div>
{% endblock %}
{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
  <script src="{{ asset('dist/js/satisfaction-editor.js') }}?v=2" defer></script>
{% endblock %}
