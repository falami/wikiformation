{% extends 'base_admin.html.twig' %}
{% block title %}Réponses · {{ template.titre }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/satisfaction-responses.css') }}">{% endblock %}
{% block body %}
<div class="sr-page">
<header class="sr-hero"><div><p class="sr-eyebrow">LA VOIX DE VOS STAGIAIRES</p><h1>{{ template.titre }}</h1><p>Explorez les retours et retrouvez chaque questionnaire rempli.</p></div><a class="sr-back" href="{{ path('app_administrateur_satisfaction_template_index', {entite: entite.id}) }}">← Questionnaires</a></header>
<div class="sr-stats"><div><span>Questionnaires remplis</span><strong>{{ stats.total }}</strong></div><div><span>Satisfaction globale</span><strong>{{ stats.average is not null ? stats.average|number_format(1, ',', ' ') ~ ' / 10' : '—' }}</strong></div><div><span>Consultation</span><strong>Réponse par réponse</strong><small>Notes, choix et commentaires</small></div></div>
<section class="sr-panel"><header class="sr-panel-head"><div><p class="sr-eyebrow">RÉPONSES INDIVIDUELLES</p><h2>Les retours en détail</h2></div><form method="get" class="sr-search"><label class="visually-hidden" for="response-search">Stagiaire ou code de session</label><input id="response-search" name="q" value="{{ search }}" placeholder="Stagiaire, code de session…"><button>Rechercher</button>{% if search %}<a href="{{ path('app_administrateur_satisfaction_attempt_responses', {entite: entite.id, template: template.id}) }}">Effacer</a>{% endif %}</form></header>
<div class="sr-table-wrap"><table class="sr-table"><thead><tr><th>Stagiaire</th><th>Session</th><th>Complété le</th><th>Note globale</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
{% for a in attempts %}{% set ass = a.assignment %}{% set person = ass.stagiaire %}<tr><td><strong>{{ person ? person.prenom ~ ' ' ~ person.nom : ass.participantAccess.displayName|default('Participant') }}</strong>{% if person %}<small>{{ person.email }}</small>{% endif %}</td><td>{{ ass.session.code }}<small>{{ ass.session.formation.titre|default('Formation sans intitulé') }}</small></td><td>{{ a.submittedAt|date('d/m/Y') }}<small>{{ a.submittedAt|date('H:i') }}</small></td><td><span class="sr-score">{{ a.noteGlobale is not null ? a.noteGlobale ~ ' / 10' : '—' }}</span></td><td><a class="sr-open" href="{{ path('app_administrateur_satisfaction_attempt_show', {entite: entite.id, attempt: a.id}) }}">Voir les réponses →<span class="visually-hidden"> de {{ person ? person.prenom ~ ' ' ~ person.nom : ass.participantAccess.displayName|default('Participant') }}</span></a></td></tr>
{% else %}<tr><td colspan="5" class="sr-empty"><i class="bi bi-chat-square-text" aria-hidden="true"></i><h3>Aucune réponse à afficher</h3><p>{{ search ? 'Essayez un autre nom ou code de session.' : 'Les questionnaires complétés apparaîtront ici.' }}</p></td></tr>{% endfor %}
</tbody></table></div><footer class="sr-pagination"><span>{{ count }} résultat(s) · Page {{ page }} / {{ pages }}</span><nav aria-label="Pagination des réponses">{% if page > 1 %}<a href="{{ path('app_administrateur_satisfaction_attempt_responses', {entite: entite.id, template: template.id, q: search, page: page - 1}) }}">← Précédente</a>{% endif %}{% if page < pages %}<a href="{{ path('app_administrateur_satisfaction_attempt_responses', {entite: entite.id, template: template.id, q: search, page: page + 1}) }}">Suivante →</a>{% endif %}</nav></footer></section></div>
{% endblock %}
