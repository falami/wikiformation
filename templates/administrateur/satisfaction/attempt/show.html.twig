{% extends 'base_admin.html.twig' %}
{% block title %}Questionnaire rempli · {{ template.titre|default('Satisfaction') }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/satisfaction-responses.css') }}">{% endblock %}
{% block body %}
{% set answers = attempt.answers %}
<div class="sr-page">
<header class="sr-hero"><div><p class="sr-eyebrow">SATISFACTION · QUESTIONNAIRE INDIVIDUEL</p><h1>{{ stagiaire ? stagiaire.prenom ~ ' ' ~ stagiaire.nom : assignment.participantAccess.displayName|default('Participant') }}</h1><p>{{ template.titre|default('Questionnaire') }} · {{ session.code }}</p><div class="sr-chips"><span>{{ session.formation.titre|default('Formation') }}</span><span>{{ attempt.submittedAt ? 'Complété le ' ~ attempt.submittedAt|date('d/m/Y à H:i') : 'Questionnaire en cours' }}</span></div></div>{% if template %}<a class="sr-back" href="{{ path('app_administrateur_satisfaction_attempt_responses', {entite: entite.id, template: template.id}) }}">← Toutes les réponses</a>{% endif %}</header>
<div class="sr-metrics">{% for label, value in {'Globale': attempt.noteGlobale, 'Formateur': attempt.noteFormateur, 'Organisme': attempt.noteOrganisme, 'Contenu': attempt.noteContenu, 'Site': attempt.noteSite, 'Recommandation': attempt.recommendationScore} %}<div><span>{{ label }}</span><strong>{{ value is not null ? value ~ ' / 10' : '—' }}</strong></div>{% endfor %}</div>
<div class="sr-panel-head"><div><p class="sr-eyebrow">LE QUESTIONNAIRE REMPLI</p><h2>Notes & commentaires</h2></div><span class="sr-readonly">Consultation uniquement</span></div>
{% set known = [] %}
{% for chapter in template.chapters|default([]) %}<section class="sr-panel sr-chapter"><header class="sr-panel-head"><h2><span class="sr-number">{{ loop.index < 10 ? '0' : '' }}{{ loop.index }}</span>{{ chapter.titre }}</h2></header>
{% for question in chapter.questions %}{% set known = known|merge([question.id]) %}{% set value = answers[question.id]|default(null) %}{# Do not use default() for false/zero answers. #}{% if answers[question.id] is defined %}{% set value = answers[question.id] %}{% endif %}
<article class="sr-answer"><h3>{{ question.libelle }}</h3><div class="sr-answer-value">{% if value is null or value is same as('') or value is same as([]) %}<span class="sr-muted">Non renseigné</span>{% elseif question.type.value == 'yes_no' %}{{ value ? 'Oui' : 'Non' }}{% elseif question.type.value in ['stars', 'scale'] %}<span class="sr-score">{{ value }} / {{ question.type.value == 'stars' ? question.maxStars|default(5) : 10 }}</span>{% else %}{% set values = value is iterable ? value : [value] %}{% for item in values %}{% set label = question.type.value == 'multi_formations' ? formationLabels[item]|default('Formation indisponible') : item %}{% for choice in question.choices|default([]) %}{% if choice is iterable and choice.value|default(null) is same as(item) %}{% set label = choice.label|default(item) %}{% endif %}{% endfor %}<div class="sr-text">{{ label is iterable ? label|join(', ') : label }}</div>{% endfor %}{% endif %}</div></article>
{% else %}<p class="sr-empty">Aucune question dans cette rubrique.</p>{% endfor %}</section>{% endfor %}
{% for key, value in answers %}{% if key not in known %}<section class="sr-panel sr-answer"><h3>Réponse conservée · question {{ key }}</h3><p class="sr-muted">Le libellé de cette question n’est plus disponible dans le modèle actuel.</p><div class="sr-text">{{ value is iterable ? value|join(', ') : value }}</div></section>{% endif %}{% endfor %}
<p class="sr-muted">Les réponses sont celles enregistrées par le participant. Les intitulés proviennent du modèle actuel du questionnaire.</p>
</div>{% endblock %}
