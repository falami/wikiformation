<style>
 .invoice-detail{--ink:#203746;--stroke:#e0e8ef;--panel:#fff;--r:20px;--shadow:0 8px 28px #20374605;max-width:1700px;margin:auto;padding-bottom:24px;color:var(--ink)}
 .invoice-detail-nav{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:4px 0 24px;font-size:13px}
 .invoice-detail-nav>a{display:flex;gap:10px;align-items:center;color:#61788b;text-decoration:none;font-weight:600}
 .invoice-detail-nav .btn{border-color:transparent;background:transparent;color:#61788b}
 .invoice-detail-nav .btn:hover{background:#edf2f6}
 .invoice-detail .hero{background:linear-gradient(115deg,#172e3d,#284954);border:1px solid #ffffff1a;border-top:3px solid color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 78%, #18212b);border-radius:24px;padding:34px 36px!important;box-shadow:0 12px 30px #1c354512;color:#fff;overflow:hidden}
 .invoice-detail .hero::after,.invoice-detail .hero .accent{display:none}
 .invoice-detail .invoice-eyebrow{font-size:10px;font-weight:750;text-transform:uppercase;letter-spacing:.19em;color:var(--theme-color-secondaire, #ffc107);margin-bottom:14px}
 .invoice-detail h1{font-size:clamp(23px,2.25vw,36px);letter-spacing:-.035em;line-height:1.25;overflow-wrap:anywhere}
 .invoice-detail h1>i{display:none}
 .invoice-detail .hero .opacity-75{margin-top:12px!important;font-size:15px;color:#d9e4eb;opacity:1!important}
 .invoice-detail .hero .chip{background:#ffffff09;border:1px solid #ffffff24;border-radius:8px;font-size:12px;padding:7px 11px;font-weight:500;box-shadow:none}
 .invoice-detail .hero .chip i{color:var(--theme-color-secondaire, #ffc107)}
 .invoice-detail .invoice-detail-actions{flex-wrap:wrap;justify-content:flex-end;max-width:430px;align-self:center}
 .invoice-detail .btn{min-height:42px;display:inline-flex;align-items:center;justify-content:center;gap:6px;border-radius:10px;font-size:13px;font-weight:600!important;padding:10px 15px;box-shadow:none;transition:background .15s,border-color .15s}
 .invoice-detail .hero .btn{border-radius:10px}
 .invoice-detail .hero .btn-outline-light{border-color:#ffffff38;color:#e2ebf1;background:transparent}
 .invoice-detail .hero .btn-outline-light:hover{background:#ffffff12}
 .invoice-detail .hero .btn-light{background:#fff;border-color:#fff;color:#203746}
 .invoice-detail .hero .btn-warning{background:var(--theme-color-secondaire, #ffc107);border-color:var(--theme-color-secondaire, #ffc107);color:#243746}
 .invoice-detail .hero .btn-warning:hover{background:color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 30%, white);border-color:color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 30%, white)}
 .invoice-detail a:focus-visible,.invoice-detail button:focus-visible{outline:3px solid color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 78%, #18212b);outline-offset:3px}
 .invoice-detail .invoice-metrics{margin-bottom:28px!important}
 .invoice-detail .kpi{height:100%;border-radius:16px;padding:23px 20px;gap:15px;box-shadow:0 3px 14px #20374603}
 .invoice-detail .kpi .ico{width:40px;height:40px;flex-shrink:0;border:0;background:#f1f5f8;border-radius:12px;color:#6b8294}
 .invoice-detail .kpi .ico i{font-size:20px!important}
 .invoice-detail .kpi .label{font-size:11px;font-weight:650;letter-spacing:.045em;text-transform:uppercase;color:#728598;margin-bottom:7px}
 .invoice-detail .kpi .val{font-size:clamp(21px,1.8vw,29px);font-weight:700;letter-spacing:-.035em;line-height:1.25}
 .invoice-detail .kpi .sub{font-size:12px;margin-top:6px;color:#7b8d9c}
 .invoice-detail .invoice-metrics>div:last-child .kpi{background:color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 5%, white);border-color:var(--theme-color-secondaire, #ffc107)}
 .invoice-detail .invoice-metrics>div:last-child .ico{background:color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 17%, white);color:color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 61%, #18212b)}
 .invoice-detail .panel-hd{padding:21px 24px;background:#fff}
 .invoice-detail .panel-title{font-size:16px;font-weight:700;letter-spacing:-.025em}
 .invoice-detail .panel-title i{width:34px;height:34px;background:#f3f6f9;border:0;border-radius:9px;font-size:17px;color:#6b8294}
 .invoice-detail .panel-bd{padding:24px}
 .invoice-detail .badge-soft{font-size:11px;font-weight:600;border-radius:7px;padding:5px 9px}
 .invoice-detail .table-responsive.p-3{padding:0!important}
 .invoice-detail .table-premium thead th{font-size:10px;padding:15px 20px;letter-spacing:.08em;background:#f5f8fb!important;color:#718599}
 .invoice-detail .table-premium tbody td{padding:19px 20px;font-size:13px;line-height:1.65;color:#314b5c;border-color:#edf1f5}
 .invoice-detail .table-premium tbody tr:hover>*{background:#f8fafc!important}
 .invoice-detail .table-premium .fw-bold{font-weight:600!important}
 .invoice-detail .info{border-radius:12px;background:#f8fafc;border-color:#e9eef3;padding:15px}
 .invoice-detail .info .k{font-size:11px;color:#73879a;margin-bottom:7px}
 .invoice-detail .info .v{font-size:14px;font-weight:650;line-height:1.5;overflow-wrap:anywhere}
 .invoice-detail .sticky-actions .btn{box-shadow:none;border-radius:10px}
 @media(max-width:1200px){.invoice-detail .invoice-detail-actions{max-width:none;justify-content:flex-start;margin-top:12px}.invoice-detail .kpi{padding:20px 16px}}
 @media(max-width:650px){.invoice-detail .hero{padding:25px 22px!important;border-radius:18px}.invoice-detail-nav{align-items:flex-start;flex-direction:column;gap:10px}.invoice-detail-nav .btn{padding-left:0}.invoice-detail .invoice-detail-actions{display:grid!important;grid-template-columns:1fr;width:100%}.invoice-detail .invoice-detail-actions .btn{width:100%}.invoice-detail .panel-hd,.invoice-detail .panel-bd{padding:18px}.invoice-detail .sticky-actions{bottom:12px}.invoice-detail .info-grid{grid-template-columns:1fr 1fr}}
 @media(prefers-reduced-motion:reduce){.invoice-detail .btn{transition:none}}
</style>
