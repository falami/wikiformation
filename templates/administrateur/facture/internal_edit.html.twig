{% extends 'base_admin.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block title %}Suivi interne · {{ facture.numero }}{% endblock %}
{% block stylesheets %}
{{ parent() }}
<style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }


  </style>
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">
{% endblock %}
{% block body %}
<div class="container py-4" style="max-width:1000px">
  <a class="btn btn-outline-secondary mb-4" href="{{ path('app_administrateur_facture_index', {entite: entite.id}) }}">← Toutes les factures</a>
  <div class="rounded-4 p-4 mb-4 text-white" style="background:#243746;border-left:6px solid #ffc107">
    <h1 class="h3">Suivi interne · {{ facture.numero }}</h1>
    <p class="mb-0">Gérez les inscriptions, votre note et les rappels associés à cette facture.</p>
  </div>
  <div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4">
    <p class="text-muted">Ces réglages concernent votre suivi. Le PDF émis, les montants et les mentions de la facture restent conservés.</p>
    {{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.note) }}
    <h2 class="h5 mt-4">Inscriptions de la facture</h2>
    {{ form_row(form.inscriptions) }}
    <div class="mt-3 p-3 rounded border bg-light">
      <label for="invoice-session-selection" class="form-label fw-semibold">Ajouter toutes les inscriptions d’une session</label>
      <div class="row g-2">
        <div class="col-md-9"><select id="invoice-session-selection" class="form-select"><option value="">Rechercher une session ou une formation…</option></select></div>
        <div class="col-md-3"><button type="button" id="invoice-add-session" class="btn btn-warning w-100" disabled>Ajouter la session</button></div>
      </div>
      <div class="form-text" id="invoice-session-feedback" role="status" aria-live="polite">Les inscriptions déjà sélectionnées seront conservées. Vous pourrez retirer chaque stagiaire individuellement.</div>
    </div>
    <h2 class="h5 mt-4">Renouvellement et relances</h2>
    {{ form_widget(form.followUp) }}
    <div class="d-flex justify-content-end mt-4"><button class="btn btn-warning" type="submit">Enregistrer le suivi</button></div>
    {{ form_end(form) }}
  </div></div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const select = document.querySelector('[data-invoice-enrollments]');
  if (select && !select.tomselect && typeof TomSelect !== 'undefined') {
    new TomSelect(select, {
      plugins: ['remove_button'],
      maxItems: null,
      placeholder: 'Formation, session ou stagiaire…',
      hideSelected: true,
      render: {no_results: function () { return '<div class="no-results">Aucune inscription trouvée</div>'; }}
    });
  }
  const sessionSelect = document.getElementById('invoice-session-selection');
  const button = document.getElementById('invoice-add-session');
  const groups = new Map();
  Array.from(select?.options || []).forEach(option => {
    const id = option.dataset.sessionId;
    if (!id || !option.value || option.disabled) return;
    if (!groups.has(id)) groups.set(id, {label: option.dataset.sessionLabel, ids: []});
    groups.get(id).ids.push(option.value);
  });
  groups.forEach((group, id) => sessionSelect.add(new Option(`${group.label} · ${group.ids.length} inscription(s)`, id)));
  if (typeof TomSelect !== 'undefined') new TomSelect(sessionSelect, {create: false, maxItems: 1});
  sessionSelect.addEventListener('change', () => { button.disabled = !groups.has(sessionSelect.value); });
  button.addEventListener('click', () => {
    const group = groups.get(sessionSelect.value);
    if (!group) return;
    const previous = Array.from(select.selectedOptions, option => option.value);
    const ids = [...new Set([...previous, ...group.ids])];
    if (select.tomselect) select.tomselect.setValue(ids);
    else {
      Array.from(select.options).forEach(option => { option.selected = ids.includes(option.value); });
      select.dispatchEvent(new Event('change', {bubbles: true}));
    }
    document.getElementById('invoice-session-feedback').textContent = `${ids.length - previous.length} inscription(s) ajoutée(s) · ${ids.length} sélectionnée(s). Cliquez sur « Enregistrer le suivi » pour conserver ces changements.`;
  });
});
</script>
{% endblock %}
