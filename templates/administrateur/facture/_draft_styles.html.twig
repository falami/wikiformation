kspace .iw-amount{font-size:34px;font-weight:750;letter-spacing:-.04em;margin:12px 0 4px;font-variant-numeric:tabular-nums}.invoice-workspace .iw-confirm{display:flex;gap:11px;padding:17px;background:#f5f8fb;border-radius:11px;font-size:13px;line-height:1.6;margin:22px 0 16px;cursor:pointer}.invoice-workspace .iw-confirm input{width:19px;height:19px;margin-top:2px;flex-shrink:0;accent-color:#274a56}.invoice-workspace .iw-full{width:100%}.invoice-workspace .iw-empty{padding:58px 24px;text-align:center}.invoice-workspace .iw-empty>i{font-size:35px;color:color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 69%, #18212b);display:block;margin-bottom:18px}.invoice-workspace .iw-empty p{max-width:510px;margin:12px auto 24px;color:var(--iw-muted);line-height:1.75}.invoice-workspace .iw-row-title{font-weight:700;display:block;margin-bottom:6px}.invoice-workspace .iw-pagination{padding:18px 24px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--iw-border);gap:12px;flex-wrap:wrap}.invoice-workspace .iw-terms p{font-size:13px;line-height:1.8;margin:0 0 9px;overflow-wrap:anywhere}.invoice-workspace .iw-history{margin:0;padding-left:20px;color:var(--iw-muted);font-size:12px;line-height:1.8}
