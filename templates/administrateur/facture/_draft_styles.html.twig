<style>
  .invoice-workspace{--iw-ink:#203746;--iw-muted:#64788b;--iw-border:#dfe7ee;--iw-gold:color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 78%, #18212b);--iw-bg:#f5f7fb;color:var(--iw-ink);max-width:1700px;margin:0 auto;padding-bottom:24px}
  .invoice-workspace a{color:inherit}.invoice-workspace .iw-hero{background:linear-gradient(120deg,#172c3b,#25434b);border-top:3px solid var(--iw-gold);border-radius:24px;padding:32px 36px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:24px;box-shadow:0 14px 35px #2138480c}
  .invoice-workspace .iw-eyebrow{color:var(--theme-color-secondaire, #ffc107);font-size:11px;font-weight:800;letter-spacing:.19em;text-transform:uppercase;margin-bottom:12px}.invoice-workspace h1{font-size:clamp(25px,2.3vw,36px);font-weight:750;letter-spacing:-.035em;margin:0 0 10px}.invoice-workspace .iw-hero p{color:#d3dfe6;max-width:760px;margin:0;line-height:1.6}
  .invoice-workspace .iw-actions{display:flex;gap:10px;flex-wrap:wrap}.invoice-workspace .iw-btn{border:1px solid #cdd8e1;border-radius:11px;min-height:44px;padding:11px 17px;display:inline-flex;justify-content:center;align-items:center;gap:9px;text-decoration:none;font-size:14px;line-height:1.45;font-weight:650;background:#fff;color:var(--iw-ink);cursor:pointer;transition:background .15s,box-shadow .15s}
  .invoice-workspace .iw-btn:hover{background:#f3f6f9;box-shadow:0 3px 10px #2037460a}.invoice-workspace .iw-btn:focus-visible{outline:3px solid color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 78%, #18212b);outline-offset:3px}.invoice-workspace .iw-btn-primary{background:var(--theme-color-secondaire, #ffc107);border-color:var(--theme-color-secondaire, #ffc107);color:#253747}.invoice-workspace .iw-btn-primary:hover{background:color-mix(in srgb, var(--theme-color-secondaire, #ffc107) 31%, white)}.invoice-workspace .iw-btn:disabled{cursor:not-allowed;opacity:.55}.invoice-workspace .iw-btn-quiet{background:transparent;color:inherit;border-color:currentColor}.invoice-workspace .iw-btn-danger{color:#a52f3d}
