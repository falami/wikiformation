<form method="post" action="{{ path('app_administrateur_facture_send', {entite: entite.id, id: f.id}) }}"
      data-invoice-send data-number="{{ f.numero ?: ('#' ~ f.id) }}"
      data-recipient="{{ f.entrepriseDestinataire ? (f.entrepriseDestinataire.emailFacturation ?: f.entrepriseDestinataire.email) : f.destinataire.email|default('') }}"
      data-preview="{{ path('app_administrateur_facture_pdf', {entite: entite.id, id: f.id}) }}">
  <input type="hidden" name="_token" value="{{ csrf_token('facture_send_' ~ f.id) }}">
  <button type="submit" class="{{ buttonClass }}" {{ st == 'canceled' ? 'disabled' : '' }}>
    <i class="bi bi-send me-1"></i> Envoyer la facture
  </button>
</form>
