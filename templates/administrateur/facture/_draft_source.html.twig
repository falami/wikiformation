{% if draft is defined and draft and draft.sourceConvention %}
<div class="alert alert-info" role="note">
  Brouillon issu de la convention <strong>{{ draft.sourceConvention.numero }}</strong>.
  Les données ont été copiées à sa création : vérifiez le destinataire, les inscriptions et les montants avant émission.
  {% if is_granted('CONVENTION_MANAGE', entite) %}<a href="{{ path('app_administrateur_convention_show', {entite: entite.id, id: draft.sourceConvention.id}) }}">Consulter la convention</a>{% endif %}
</div>
{% endif %}
