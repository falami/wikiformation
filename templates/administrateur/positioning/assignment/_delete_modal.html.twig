<style>
#positioningDeleteModal .modal-dialog{max-width:520px}
#positioningDeleteModal .modal-content{border:1px solid #e2e8ef;border-radius:24px;overflow:hidden;box-shadow:0 28px 90px #152b4040;color:#233747}
#positioningDeleteModal .pd-heading{padding:28px;background:linear-gradient(125deg,#203343,#304957);color:white;border-top:3px solid #d4af61;position:relative}
#positioningDeleteModal .pd-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#ffffff12;color:#efcd83;font-size:23px;margin-bottom:18px;border:1px solid #ffffff24}
#positioningDeleteModal .pd-eyebrow{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#efcd83;font-weight:700}
#positioningDeleteModal h2{font-size:24px;font-weight:750;margin:8px 0 0;letter-spacing:-.5px}
#positioningDeleteModal .btn-close{position:absolute;right:24px;top:25px}
#positioningDeleteModal .modal-body{padding:26px 28px}
#positioningDeleteModal .pd-context{border:1px solid #e3e9ef;background:#f7f9fb;border-radius:15px;padding:18px;margin-bottom:20px}
#positioningDeleteModal .pd-context small{display:block;color:#728393;font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:5px}
#positioningDeleteModal .pd-context strong{display:block;overflow-wrap:anywhere;font-size:15px}
#positioningDeleteModal .pd-context strong+small{margin-top:16px}
#positioningDeleteModal .pd-warning{display:flex;align-items:flex-start;gap:10px;font-size:13px;line-height:1.7;color:#79524b;margin:0}
#positioningDeleteModal .pd-warning i{color:#b8594d}
#positioningDeleteModal .modal-footer{padding:0 28px 28px;border:0;gap:12px;flex-wrap:wrap}
#positioningDeleteModal .modal-footer .btn{flex:1;margin:0;min-height:46px;border-radius:12px;font-size:14px;font-weight:650}
#positioningDeleteModal .pd-cancel{background:white;border:1px solid #dbe3ea;color:#32495b}
#positioningDeleteModal .pd-confirm{background:#ae433e;color:white;border:1px solid #ae433e;box-shadow:0 5px 12px #ae433e20}
#positioningDeleteModal .pd-confirm:hover{background:#91342f}
#positioningDeleteModal .btn:focus-visible{outline:3px solid #d4af61;outline-offset:3px}
@media(max-width:575px){ #positioningDeleteModal .modal-dialog{margin:16px}#positioningDeleteModal .pd-heading,#positioningDeleteModal .modal-body{padding:22px}#positioningDeleteModal .modal-footer{padding:0 22px 22px}}
</style>
<div class="modal fade" id="positioningDeleteModal" tabindex="-1" aria-labelledby="positioningDeleteTitle" aria-describedby="positioningDeleteDescription" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="pd-heading">
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
      <div class="pd-icon"><i class="bi bi-trash3" aria-hidden="true"></i></div>
      <div class="pd-eyebrow">Questionnaire de positionnement</div>
      <h2 id="positioningDeleteTitle">Supprimer cette affectation ?</h2>
    </div>
    <div class="modal-body">
      <div class="pd-context"><small>Stagiaire</small><strong data-delete-student></strong><small>Questionnaire</small><strong data-delete-questionnaire></strong></div>
      <p class="pd-warning" id="positioningDeleteDescription"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>Cette affectation sera supprimée définitivement. Vérifiez le stagiaire et le questionnaire avant de confirmer.</span></p>
    </div>
    <div class="modal-footer"><button type="button" class="btn pd-cancel" data-bs-dismiss="modal">Annuler</button><button type="button" class="btn pd-confirm" data-delete-confirm><i class="bi bi-trash3 me-2" aria-hidden="true"></i>Supprimer l’affectation</button></div>
  </div></div>
</div>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const element = document.getElementById('positioningDeleteModal');
  const modal = new bootstrap.Modal(element);
  const confirmButton = element.querySelector('[data-delete-confirm]');
  let pendingForm = null;
  let trigger = null;
  let submitting = false;
  document.addEventListener('submit', event => {
    const form = event.target;
    if (!form.matches('form[data-positioning-delete]')) return;
    event.preventDefault();
    if (submitting) return;
    pendingForm = form;
    trigger = event.submitter || document.activeElement;
    element.querySelector('[data-delete-student]').textContent = form.dataset.student || 'Stagiaire non renseigné';
    element.querySelector('[data-delete-questionnaire]').textContent = form.dataset.questionnaire || 'Questionnaire non renseigné';
    modal.show();
  });
  element.addEventListener('shown.bs.modal', () => element.querySelector('.pd-cancel').focus());
  element.addEventListener('hidden.bs.modal', () => {
    pendingForm = null;
    if (trigger?.isConnected) trigger.focus();
    trigger = null;
  });
  confirmButton.addEventListener('click', () => {
    if (!pendingForm || submitting) return;
    submitting = true;
    confirmButton.disabled = true;
    confirmButton.textContent = 'Suppression en cours…';
    HTMLFormElement.prototype.submit.call(pendingForm);
  });
});
</script>
