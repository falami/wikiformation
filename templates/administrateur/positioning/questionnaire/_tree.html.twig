{% macro chapter(ch, q, entite, number) %}
        <section class="chapter" data-id="{{ ch.id }}" id="chapter-{{ ch.id }}">
          <div class="se-chapter-heading">
            <div class="se-chapter-identity"><span class="drag-handle drag-handle-chapter" title="Déplacer le chapitre"><i class="bi bi-grip-vertical" aria-hidden="true"></i></span><span class="se-chapter-number pos-badge">{{ number }}</span><div><span class="se-overline">{{ ch.parent ? 'SOUS-CHAPITRE' : 'CHAPITRE' }}</span><h3>{{ ch.title }}</h3>{% if ch.parent %}<div class="pe-parent">Sous-chapitre de {{ ch.parent.title }}</div>{% endif %}</div></div>
            <div class="se-chapter-actions"><span class="se-count">{{ ch.items|length }} compétence{{ ch.items|length > 1 ? 's' }}</span><button type="button" class="se-icon-button js-toggle-chapter" aria-label="Replier le chapitre" aria-expanded="true" aria-controls="chapter-body-{{ ch.id }}"><i class="bi bi-chevron-up" aria-hidden="true"></i></button><a class="se-icon-button" title="Modifier le chapitre" aria-label="Modifier le chapitre" href="{{ path('app_administrateur_positioning_chapter_edit', {entite: entite.id, questionnaire: q.id, id: ch.id}) }}"><i class="bi bi-pencil" aria-hidden="true"></i></a><form method="post" class="d-inline" action="{{ path('app_administrateur_positioning_chapter_delete', {entite: entite.id, questionnaire: q.id, id: ch.id}) }}" onsubmit="return confirm('Supprimer ce chapitre, ses sous-chapitres et toutes leurs compétences ?');"><input type="hidden" name="_token" value="{{ csrf_token('del_ch_' ~ ch.id) }}"><button class="se-icon-button se-remove" title="Supprimer le chapitre" aria-label="Supprimer le chapitre"><i class="bi bi-trash3" aria-hidden="true"></i></button></form></div>
          </div>
          <div class="chapter-body" id="chapter-body-{{ ch.id }}">
            <div class="items-sortable" data-chapter-id="{{ ch.id }}" data-reorder-url="{{ path('app_administrateur_positioning_questionnaire_item_reorder', {entite: entite.id, questionnaire: q.id, chapter: ch.id}) }}">
              {% for it in ch.items %}
              <article class="item pe-item" data-id="{{ it.id }}"><span class="drag-handle drag-handle-item" title="Déplacer la compétence"><i class="bi bi-grip-vertical" aria-hidden="true"></i></span><div class="pe-item-content"><div class="pe-item-meta"><span class="se-overline">COMPÉTENCE <span class="pos-badge">{{ '%02d'|format(loop.index) }}</span></span><span class="pe-level">Niveau {{ it.level }}</span></div><p>{{ it.label|nl2br }}</p></div><div class="pe-item-actions"><a class="se-icon-button" title="Modifier la compétence" aria-label="Modifier la compétence" href="{{ path('app_administrateur_positioning_item_edit', {entite: entite.id, questionnaire: q.id, chapter: ch.id, id: it.id}) }}"><i class="bi bi-pencil" aria-hidden="true"></i></a><form method="post" action="{{ path('app_administrateur_positioning_item_delete', {entite: entite.id, questionnaire: q.id, chapter: ch.id, id: it.id}) }}" onsubmit="return confirm('Supprimer cette compétence ?');"><input type="hidden" name="_token" value="{{ csrf_token('del_it_' ~ it.id) }}"><button class="se-icon-button se-remove" title="Supprimer la compétence" aria-label="Supprimer la compétence"><i class="bi bi-trash3" aria-hidden="true"></i></button></form></div></article>
                      {% else %}<div class="questions-empty"><span>Ajoutez une compétence à évaluer dans « {{ ch.title }} ».</span></div>{% endfor %}
            </div>
            <a class="btn se-add-question" href="{{ path('app_administrateur_positioning_item_new', {entite: entite.id, questionnaire: q.id, chapter: ch.id}) }}"><span>+</span> Ajouter une compétence</a>
            <a class="btn se-btn-quiet pe-add-child" href="{{ path('app_administrateur_positioning_chapter_new', {entite: entite.id, questionnaire: q.id, parent: ch.id}) }}"><i class="bi bi-diagram-3" aria-hidden="true"></i> Ajouter un sous-chapitre à « {{ ch.title }} »</a>
            <div class="pe-children" data-reorder-url="{{ path('app_administrateur_positioning_questionnaire_chapter_reorder', {entite: entite.id, questionnaire: q.id}) }}">
              {% for child in ch.children %}
                {{ _self.chapter(child, q, entite, number ~ '.' ~ loop.index) }}
              {% endfor %}
            </div>
          </div>
        </section>
{% endmacro %}
