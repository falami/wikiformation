{# templates/administrateur/positioning/questionnaire/show.html.twig #}
{% extends 'base_admin.html.twig' %}
{% block title %}Questionnaire — {{ q.title }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }

    .questionnaire-detail{--ink:#243e50;--muted:#738594;--line:#e4ebef;color:var(--ink);padding-bottom:48px;max-width:1700px;margin:auto}
    .questionnaire-detail .p-hero{position:relative;border-radius:24px;background:radial-gradient(ellipse at 100% 0%,#44616666,transparent 60%),linear-gradient(120deg,#182e3c,#294957);color:#fff;padding:34px!important;overflow:hidden;box-shadow:0 14px 36px #18303e12}
    .questionnaire-detail .eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#dfbd70;margin-bottom:18px}
    .questionnaire-detail .p-hero h1{font-size:clamp(28px,3vw,44px);font-weight:700;letter-spacing:-.045em;line-height:1.15;margin-bottom:12px;overflow-wrap:anywhere}
    .questionnaire-detail .hero-description{color:#c5d3da;font-size:14px;line-height:1.7;max-width:620px}
    .questionnaire-detail .hero-meta{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:24px;padding-top:20px;border-top:1px solid #ffffff1c;font-size:12px;color:#beced7}
    .questionnaire-detail .hero-meta span{display:inline-flex;align-items:center;gap:8px}
    .questionnaire-detail .hero-meta i{color:#dfbd70}
    .questionnaire-detail .hero-actions{display:flex;gap:10px;flex-wrap:wrap}
    .questionnaire-detail .hero-actions .btn{padding:11px 17px;border-radius:10px;font-size:13px;font-weight:650;transition:background .2s,transform .2s}
    .questionnaire-detail .hero-actions .btn:hover{transform:translateY(-1px)}
    .questionnaire-detail .btn-return{background:#ffffff09;border:1px solid #ffffff30;color:#e1e9ed}
    .questionnaire-detail .btn-return:hover{background:#ffffff18;color:#fff}
    .questionnaire-detail .btn-edit{background:#e8c575;border:1px solid #e8c575;color:#243642}
    .questionnaire-detail .btn-edit:hover{background:#f2d48f}
    .questionnaire-detail .cardx{height:100%;background:#fff;border-radius:20px;border:1px solid var(--line);box-shadow:0 6px 24px #243c4d04;overflow:hidden}
    .questionnaire-detail .cardx-h{padding:20px 24px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .questionnaire-detail .cardx-h h2{font-size:15px;font-weight:650;margin:0;letter-spacing:-.02em}
    .questionnaire-detail .cardx-h h2 i{color:#9a7d44;margin-right:8px}
    .questionnaire-detail .detail-body{padding:24px}
    .questionnaire-detail .muted{color:var(--muted);font-size:12px;margin-bottom:7px}
    .questionnaire-detail .detail-value{font-size:14px;font-weight:600;overflow-wrap:anywhere}
    .questionnaire-detail .chip-soft{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:11px;font-weight:650}
    .questionnaire-detail .chip-soft.ok{background:#eaf5ef;color:#28795a;border:1px solid #d2e9dc}
    .questionnaire-detail .chip-soft.no{background:#f1f4f6;color:#677b89;border:1px solid var(--line)}
    .questionnaire-detail .metrics{display:grid;grid-template-columns:1fr 1fr;gap:24px}
    .questionnaire-detail .metric + .metric{border-left:1px solid var(--line);padding-left:24px}
    .questionnaire-detail .metric strong{display:block;font-size:34px;line-height:1.1;font-weight:650;letter-spacing:-.05em;font-variant-numeric:tabular-nums}
    .questionnaire-detail .metric span{display:block;margin-top:8px;font-size:12px;color:var(--muted)}
    .questionnaire-detail .list-wrap{overflow:auto}
    .questionnaire-detail .grid-table{width:100%;border-collapse:separate;border-spacing:0;min-width:620px}
    .questionnaire-detail .grid-table th{background:#fff;border-bottom:1px solid var(--line);font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);padding:16px 24px;text-align:center;white-space:nowrap;font-weight:650}
    .questionnaire-detail .grid-table th:first-child{text-align:left;width:70%}
    .questionnaire-detail .grid-table td{border-bottom:1px solid #edf1f4;padding:16px 24px;vertical-align:middle;font-size:13px;background:#fff}
    .questionnaire-detail .grid-table tbody tr:not(.row-chapter):hover td{background:#fafcfd}
    .questionnaire-detail .grid-table tbody tr:last-child td{border-bottom:0}
    .questionnaire-detail .row-chapter td{background:#f2f6f8;padding:16px 24px;border-bottom:1px solid #e1e9ee}
    .questionnaire-detail .chapter-title{display:flex;align-items:center;gap:12px;font-size:14px;font-weight:650;letter-spacing:-.015em}
    .questionnaire-detail .chapter-number{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:32px;height:32px;background:#263f50;color:#e7c77f;border-radius:9px;font-size:12px;font-variant-numeric:tabular-nums}
    .questionnaire-detail .badge-mini{color:#7b8c99;font-size:11px;white-space:nowrap;font-weight:500}
    .questionnaire-detail .item-label{font-weight:500;line-height:1.6;padding-left:44px}
    .questionnaire-detail .item-position{color:#91a0aa;font-variant-numeric:tabular-nums}
    .questionnaire-detail .level-badge{display:inline-flex;align-items:center;justify-content:center;min-width:30px;height:27px;border-radius:7px;background:#edf3f7;color:#48697e;font-size:12px;font-weight:600}
    .questionnaire-detail .item-id{color:#91a0aa;font-size:11px;font-variant-numeric:tabular-nums}
    .questionnaire-detail .section-caption{font-size:12px;color:var(--muted)}
    .questionnaire-detail a:focus-visible{outline:3px solid #d9b76b;outline-offset:4px}
    @media(max-width:767px){.questionnaire-detail .p-hero{padding:24px!important;border-radius:18px}.questionnaire-detail .hero-actions{width:100%}.questionnaire-detail .hero-actions .btn{flex:1}.questionnaire-detail .cardx-h,.questionnaire-detail .detail-body{padding:18px}.questionnaire-detail .grid-table td,.questionnaire-detail .grid-table th{padding:14px 16px}.questionnaire-detail .item-label{padding-left:0}}
    @media(prefers-reduced-motion:reduce){.questionnaire-detail .hero-actions .btn{transition:none;transform:none!important}}
  </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-3 questionnaire-detail">

  <div class="p-hero p-4 mb-4">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
      <div class="flex-grow-1">
        <div class="eyebrow">Évaluation des compétences · Positionnement</div>
        <h1>{{ q.title }}</h1>
        <p class="hero-description mb-0">Un parcours structuré pour situer les acquis et identifier les compétences à développer.</p>
        <div class="hero-meta">
          <span><i class="bi bi-building" aria-hidden="true"></i> {{ entite.nom }}</span>
          <span><i class="bi bi-journal-text" aria-hidden="true"></i> Questionnaire n° {{ q.id }}</span>
          <span><i class="bi bi-calendar3" aria-hidden="true"></i> Créé le {{ q.createdAt ? q.createdAt|date('d/m/Y à H:i') : '—' }}</span>
        </div>
      </div>

      <div class="hero-actions">
        <a class="btn btn-return"
           href="{{ path('app_administrateur_positioning_questionnaire_index', {entite: entite.id}) }}">
          <i class="bi bi-arrow-left"></i> Retour
        </a>

        <a class="btn btn-edit"
           href="{{ path('app_administrateur_positioning_questionnaire_edit', {entite: entite.id, id: q.id}) }}">
          <i class="bi bi-pencil"></i> Modifier
        </a>
      </div>
    </div>
  </div>

  {% include 'flagMessage.html.twig' %}

  <div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
      <div class="cardx">
        <div class="cardx-h">
          <h2><i class="bi bi-info-circle" aria-hidden="true"></i> À propos du questionnaire</h2>
          {% if q.isPublished %}
            <span class="chip-soft ok"><i class="bi bi-broadcast-pin"></i> Publié</span>
          {% else %}
            <span class="chip-soft no"><i class="bi bi-eye-slash"></i> Non publié</span>
          {% endif %}
        </div>
        <div class="detail-body">
          <div class="row g-2">
            <div class="col-12 col-md-6">
              <div class="muted small">Logiciel</div>
              <div class="detail-value">{{ q.software ?: '—' }}</div>
            </div>
            <div class="col-12 col-md-6">
              <div class="muted small">Créé par</div>
              <div class="detail-value">
                {{ q.createur ? (q.createur.nomComplet|default(q.createur.email|default('—'))) : '—' }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="cardx">
        <div class="cardx-h">
          <h2><i class="bi bi-collection" aria-hidden="true"></i> Le parcours en chiffres</h2>
        </div>
        <div class="detail-body">
          {% set chapCount = chapters|length %}
          {% set itemCount = 0 %}
          {% for ch in chapters %}{% set itemCount = itemCount + (ch.items|length) %}{% endfor %}

          <div class="metrics">
            <div class="metric"><strong>{{ chapCount }}</strong><span>{{ chapCount > 1 ? 'Chapitres' : 'Chapitre' }}</span></div>
            <div class="metric"><strong>{{ itemCount }}</strong><span>{{ itemCount > 1 ? 'Compétences à évaluer' : 'Compétence à évaluer' }}</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="cardx">
    <div class="cardx-h">
      <h2><i class="bi bi-diagram-3" aria-hidden="true"></i> Détail du parcours</h2>
      <div class="section-caption">{{ chapCount }} chapitre{{ chapCount > 1 ? 's' : '' }} · {{ itemCount }} compétence{{ itemCount > 1 ? 's' : '' }}</div>
    </div>

    <div class="list-wrap">
      <table class="grid-table">
        <thead>
          <tr>
            <th scope="col">Compétence</th>
            <th scope="col">Ordre</th>
            <th scope="col">Niveau</th>
            <th scope="col">Référence</th>
          </tr>
        </thead>
        <tbody>
        {% if chapters|length == 0 %}
          <tr>
            <td colspan="4" class="text-center text-muted py-4">Aucun chapitre.</td>
          </tr>
        {% else %}
          {% for ch in chapters %}
            <tr class="row-chapter">
              <td colspan="4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <div class="chapter-title">
                    <span class="chapter-number">{{ loop.index < 10 ? '0' : '' }}{{ loop.index }}</span>
                    {{ ch.title }}
                    <span class="badge-mini">{{ ch.items|length }} compétence{{ ch.items|length > 1 ? 's' : '' }}</span>
                  </div>
                  <span class="badge-mini">Position : {{ ch.position }}</span>
                </div>
              </td>
            </tr>

            {% if ch.items|length == 0 %}
              <tr>
                <td class="text-muted">— Aucun item —</td>
                <td class="text-center">—</td>
                <td class="text-center">—</td>
                <td class="text-center">—</td>
              </tr>
            {% else %}
              {% for it in ch.items %}
                <tr>
                  <td>
                    <div class="item-label">{{ it.label }}</div>
                  </td>
                  <td class="text-center item-position">{{ it.position }}</td>
                  <td class="text-center"><span class="level-badge">{{ it.level }}</span></td>
                  <td class="text-center item-id">#{{ it.id }}</td>
                </tr>
              {% endfor %}
            {% endif %}
          {% endfor %}
        {% endif %}
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}
