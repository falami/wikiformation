{% extends 'base_admin.html.twig' %}
{% block title %}{{ is_edit ? 'Modifier' : 'Créer' }} un questionnaire — Positionnement{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }
  </style>
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/satisfaction-editor.css') }}?v=2">
  <link rel="stylesheet" href="{{ asset('dist/css/positioning-editor.css') }}?v=20261027-2">
{% endblock %}
{% block body %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% set itemCount = 0 %}
{% for chapter in q.chapters %}{% set itemCount = itemCount + chapter.items|length %}{% endfor %}
{% set indexUrl = path('app_administrateur_positioning_questionnaire_index', {entite: entite.id}) %}
<div class="satisfaction-editor positioning-editor">
  <nav class="se-breadcrumb" aria-label="Fil d’Ariane"><a href="{{ indexUrl }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Questionnaires de positionnement</a><span aria-hidden="true">/</span><span>{{ is_edit ? 'Modifier' : 'Créer' }}</span></nav>
  <header class="se-hero">
    <div class="se-hero-main">
      <div class="se-eyebrow"><span></span> LE POINT DE DÉPART DE VOS STAGIAIRES</div>
      <h1>Éditeur de questionnaire<span>.</span></h1>
      <p>Identifiez les acquis. Construisez un parcours adapté à chaque stagiaire.</p>
      <div class="se-hero-meta"><span><i class="bi bi-building" aria-hidden="true"></i> {{ entite.nom }}</span><span class="se-status {{ not form.isPublished.vars.checked ? 'is-inactive' }}" id="positioningStatus">{{ form.isPublished.vars.checked ? 'Publié' : 'Brouillon' }}</span></div>
    </div>
    <div class="se-hero-side"><div class="se-hero-icon" aria-hidden="true"><i class="bi bi-ui-checks-grid"></i></div><button type="submit" form="positioningForm" class="btn se-btn-gold"><i class="bi bi-check2" aria-hidden="true"></i> Enregistrer le questionnaire</button><span class="se-hero-caption">Un positionnement clair, une formation mieux ciblée.</span></div>
  </header>
  <div class="se-overview" aria-label="Composition du questionnaire"><div><strong>{{ q.chapters|length }}</strong><span>Chapitres</span></div><div><strong>{{ itemCount }}</strong><span>Compétences</span></div><p><i class="bi bi-pencil-square" aria-hidden="true"></i> {{ is_edit ? 'Personnalisez votre questionnaire existant' : 'Préparez votre prochain parcours de formation' }}</p></div>
  {% include 'flagMessage.html.twig' %}
  <div class="se-workspace">
    <aside class="se-sidebar" aria-label="Paramètres du questionnaire">
      <section class="se-panel">
        <div class="se-panel-heading"><span class="se-step">01</span><div><span class="se-overline">LES ESSENTIELS</span><h2>Paramètres</h2></div><i class="bi bi-sliders2" aria-hidden="true"></i></div>
        <div class="se-panel-body">
          {{ form_start(form, {attr: {id: 'positioningForm'}}) }}
          {{ form_errors(form) }}
          {{ form_row(form.title, {label: 'Nom du questionnaire', attr: {placeholder: 'Ex. Positionnement Outlook'}}) }}
          {{ form_row(form.software, {label: 'Logiciel concerné', help: 'Facultatif, pour les formations liées à un logiciel.', attr: {placeholder: 'Ex. Outlook'}}) }}
          <div class="se-activation"><div><label for="{{ form.isPublished.vars.id }}">Questionnaire publié</label><p>Disponible dans le module de positionnement.</p></div><div class="form-check form-switch">{{ form_widget(form.isPublished, {label: false, attr: {class: 'form-check-input'}}) }}</div></div>
          {{ form_errors(form.isPublished) }}
          {{ form_end(form) }}
        </div>
      </section>
      {% if q.chapters|length %}
      <section class="se-panel se-outline-panel"><div class="se-outline-heading"><h2><i class="bi bi-list-nested" aria-hidden="true"></i> Dans ce questionnaire</h2><span>{{ q.chapters|length }}</span></div><ol class="se-outline" id="positioningOutline">{% for ch in q.chapters %}<li><a href="#chapter-{{ ch.id }}"><span>{{ '%02d'|format(loop.index) }}</span><span>{{ ch.title }}</span></a></li>{% endfor %}</ol></section>
      {% endif %}
      <div class="se-tip"><i class="bi bi-lightbulb" aria-hidden="true"></i><div><strong>Une compétence, une action concrète.</strong><p>Utilisez des verbes précis et adaptez le niveau à votre public.</p></div></div>
      {% if is_edit %}<a class="btn se-btn-quiet pe-new" href="{{ path('app_administrateur_positioning_questionnaire_new', {entite: entite.id}) }}"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nouveau questionnaire</a>{% endif %}
    </aside>
    <main class="se-canvas" aria-label="Contenu du questionnaire">
      <div class="se-canvas-heading"><div><span class="se-overline">02 / LE CONTENU</span><h2>Chapitres & compétences</h2><p>Un chapitre regroupe un thème. Un sous-chapitre précise ce thème. Une compétence décrit ce que le stagiaire sait faire.</p></div>{% if is_edit %}<a class="btn se-btn-dark" href="{{ path('app_administrateur_positioning_chapter_new', {entite: entite.id, questionnaire: q.id}) }}"><i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter un chapitre</a>{% endif %}</div>
      {% if is_edit %}
      <div class="se-reorder-hint"><i class="bi bi-grip-vertical" aria-hidden="true"></i> Déplacez les poignées pour réordonner les éléments d’un même niveau. L’ordre est enregistré automatiquement.</div>
      <div id="positioningOrderState" role="status" class="pe-order-state"></div>
      <div id="chapters-sortable" data-csrf="{{ csrf_token('reorder_positioning') }}" data-reorder-url="{{ path('app_administrateur_positioning_questionnaire_chapter_reorder', {entite: entite.id, questionnaire: q.id}) }}">
{% import 'administrateur/positioning/questionnaire/_tree.html.twig' as tree %}
      {% for ch in q.chapters|filter(ch => ch.parent is null) %}
        {{ tree.chapter(ch, q, entite, loop.index) }}
      {% else %}<div class="se-empty"><h3>Votre premier thème à évaluer</h3><p>Créez un chapitre, par exemple « Utiliser un ordinateur », puis ajoutez les compétences à évaluer.</p></div>{% endfor %}
      </div>
      {% else %}<div class="se-empty pe-create"><i class="bi bi-journal-plus" aria-hidden="true"></i><h3>Préparons votre questionnaire.</h3><p>Enregistrez ses paramètres pour ajouter vos chapitres et compétences.</p></div>{% endif %}
    </main>
  </div>
  <div class="se-savebar"><div><i class="bi bi-check2-circle" aria-hidden="true"></i><span id="editorSaveState" role="status">Aucune modification</span></div><div class="se-save-actions"><a href="{{ indexUrl }}" class="btn se-btn-quiet">Retour à la liste</a><button type="submit" form="positioningForm" class="btn se-btn-gold"><i class="bi bi-check2" aria-hidden="true"></i> Enregistrer</button></div></div>
</div>
{% endblock %}
{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
  <script src="{{ asset('dist/js/positioning-editor.js') }}?v=20261027-2" defer></script>
{% endblock %}
