{% extends 'base_admin.html.twig' %}
{% block title %}{{ is_edit ? 'Modifier' : 'Créer' }} un chapitre{% endblock %}
{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('dist/css/satisfaction-editor.css') }}">
<link rel="stylesheet" href="{{ asset('dist/css/positioning-editor.css') }}?v=20261027-2">
{% endblock %}
{% block body %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% set back = path('app_administrateur_positioning_questionnaire_edit', {entite: entite.id, id: questionnaire.id}) %}
<div class="satisfaction-editor positioning-editor pe-chapter-form">
<nav class="se-breadcrumb"><a href="{{ back }}">← Retour au questionnaire</a></nav>
<header class="se-canvas-heading"><div><span class="se-overline">{{ questionnaire.title }}</span><h1>{{ is_edit ? 'Modifier' : 'Ajouter' }} {{ chapter.parent ? 'un sous-chapitre' : 'un chapitre' }}</h1><p>Un thème clair, puis les compétences que vous souhaitez évaluer.</p></div></header>
{% include 'flagMessage.html.twig' %}
<section class="se-panel"><div class="se-panel-body">
{{ form_start(form) }}
{{ form_errors(form) }}
{{ form_row(form.title, {attr: {placeholder: 'Ex. Utiliser un ordinateur', autofocus: true}}) }}
{{ form_row(form.parent) }}
<div class="pe-guide"><strong>Comment organiser votre questionnaire ?</strong><p>Chapitre : Utiliser un ordinateur<br>↳ Sous-chapitre (facultatif) : Naviguer sur Internet<br>↳ Compétence à évaluer : Effectuer une recherche en ligne</p></div>
<div class="se-save-actions"><a class="btn se-btn-quiet" href="{{ back }}">Annuler</a><button class="btn se-btn-gold" type="submit">{{ is_edit ? 'Enregistrer les modifications' : 'Créer et revenir au questionnaire' }}</button></div>
{{ form_end(form) }}
</div></section>
</div>
{% endblock %}
