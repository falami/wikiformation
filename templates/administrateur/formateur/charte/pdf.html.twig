<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>@page{margin:55px 48px 65px}body{font-family:DejaVu Sans,sans-serif;color:#243c49;font-size:10px;line-height:1.6}header{border-bottom:3px solid #c6a362;padding-bottom:22px;margin-bottom:25px}.eyebrow{font-size:8px;letter-spacing:2px;color:#937036;text-transform:uppercase}h1{font-size:25px;line-height:1.25;margin:10px 0}h2{font-size:13px;margin:24px 0 10px;page-break-after:avoid;color:#203c49}h3{font-size:11px;page-break-after:avoid;margin:17px 0 8px}p{page-break-inside:avoid;white-space:pre-line;margin:0 0 12px}.meta{color:#718291;font-size:9px}.signature{border:1px solid #dac79f;background:#fffdf7;padding:20px;margin-top:25px;page-break-inside:avoid}.hash{font-size:7px;word-wrap:break-word;font-family:DejaVu Sans Mono,monospace}.footer{position:fixed;bottom:-40px;font-size:8px;color:#7c8c96;border-top:1px solid #dfe7ed;width:100%;padding-top:10px}</style></head><body><div class="footer">{{ v.issuer.name|default(v.charter.entite.nom) }} · Charte qualité · Version {{ v.number }}</div><header><div class="eyebrow">{{ v.issuer.name|default(v.charter.entite.nom) }} · Engagements professionnels</div><h1>{{ v.title }}</h1><div class="meta">Version {{ v.number }} · Application : {{ v.effectiveAt ? v.effectiveAt|date('d/m/Y') : 'À définir' }} · {{ v.publishedAt ? 'Publiée le ' ~ v.publishedAt|date('d/m/Y') : 'BROUILLON — non publié' }}</div></header>{% for chapter in v.chapters %}{% set n=loop.index %}<h2>{{ n }}. {{ chapter.title }}</h2><p>{{ chapter.body }}</p>{% for sub in chapter.children %}<h3>{{ n }}.{{ loop.index }} {{ sub.title }}</h3><p>{{ sub.body }}</p>{% endfor %}{% endfor %}{% if s and s.signedAt %}<div class="signature"><div class="eyebrow">Engagement du formateur</div><h2>Signée par {{ s.evidence.name }}</h2><p>{{ s.evidence.consent }}</p><p>Le {{ s.signedAt|date('d/m/Y à H:i:s') }} · Compte {{ s.evidence.userId }} : {{ s.evidence.email }}</p><p class="meta">{{ s.evidence.method }}</p><div class="hash">Empreinte SHA-256 du texte :<br>{{ s.evidence.digest }}</div></div>{% elseif v.digest %}<div class="hash">Empreinte SHA-256 du texte : {{ v.digest }}</div>{% endif %}</body></html>
