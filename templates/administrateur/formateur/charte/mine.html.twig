{% extends 'administrateur/formateur/charte/base.html.twig' %}
{% block charter %}<header class="charter-hero"><div><div class="charter-eyebrow">Mon espace professionnel</div><h1>Mes chartes qualité</h1><p>Vos engagements, leurs évolutions et vos exemplaires signés restent accessibles à tout moment.</p></div><a class="btn btn-light" href="{{ path('app_formateur_contrats',{entite:entite.id}) }}">Mes contrats d’intervention</a></header>
{% for item in items %}{% set s=item.signature %}<section class="charter-panel"><div class="charter-actions justify-content-between"><div><span class="charter-eyebrow text-secondary">Version {{ s.version.number }} · Application {{ s.version.effectiveAt|date('d/m/Y') }}</span><h2 class="mt-2">{{ s.version.title }}</h2><span class="charter-badge {{ s.signedAt ? 'signed' : 'pending' }}">{{ s.signedAt ? 'Signée le ' ~ s.signedAt|date('d/m/Y') : (item.current ? 'Votre signature est attendue' : 'Remplacée par une nouvelle version') }}</span></div><div class="charter-actions"><a class="btn btn-charter" href="{{ path('app_charter_sign',{entite:entite.id,id:s.id}) }}">{{ s.signedAt or not item.current ? 'Consulter' : 'Lire et signer' }}</a>{% if s.signedAt %}<a class="btn btn-outline-secondary" href="{{ path('app_charter_signed_pdf',{entite:entite.id,id:s.id}) }}">Télécharger mon exemplaire</a>{% endif %}</div></div></section>{% else %}<section class="charter-panel text-center py-5"><h2>Aucune charte demandée pour le moment</h2><p class="charter-muted">Les documents transmis par votre organisme apparaîtront ici.</p></section>{% endfor %}{% endblock %}
