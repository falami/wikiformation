{% extends 'base_admin.html.twig' %}
{% block title %}Questionnaire rempli · {{ template.titre|default('Satisfaction') }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('dist/css/satisfaction-responses.css') }}">{% endblock %}
{% block body %}
{% set answers = attempt.answers %}
<div class="sr-page">
<header class="sr-hero"><div><p class="sr-eyebrow">SATISFACTION FORMATEUR · RETOUR D’EXPÉRIENCE</p><h1>{{ formateur ? formateur.prenom ~ ' ' ~ formateur.nom : 'Formateur' }}</h1><p>{{ template.titre|default('Questionnaire') }} · {{ session.code }}</p><div class="sr-chips"><span>{{ session.formation.titre|default('Formation') }}</span><span>{{ attempt.submittedAt ? 'Complété le ' ~ attempt.submittedAt|date('d/m/Y à H:i') : 'Questionnaire en cours' }}</span></div></div>{% if template %}<a class="sr-back" href="{{ path('app_administrateur_questionnaire_responses', {entite: entite.id, kind: 'formateur', id: template.id}) }}">← Toutes les réponses</a>{% endif %}</header>
<div class="sr-metrics">{% for label, value in {'Globale': attempt.noteGlobale, 'Recommandation': attempt.recommendationScore} %}<div><span>{{ label }}</span><strong>{{ value is not null ? value : '—' }}</strong></div>{% endfor %}</div>
<div class="sr-panel-head"><div><p class="sr-eyebrow">LE QUESTIONNAIRE REMPLI</p><h2>Notes & commentaires</h2></div><span class="sr-readonly">Consultation uniquement</span></div>
{% include 'administrateur/questionnaire/_answers.html.twig' with {trainerQuestionnaire: true} %}
{% if attempt.objectiveEvaluations|length %}<section class="sr-panel sr-chapter"><header class="sr-panel-head"><h2>Acquisition des objectifs par stagiaire</h2></header>{% for evaluation in attempt.objectiveEvaluations %}<article class="sr-answer"><p class="sr-eyebrow">{{ evaluation.stagiaire.prenom }} {{ evaluation.stagiaire.nom }}</p><h3>{{ evaluation.objective.label }}</h3><span class="sr-score">{{ evaluation.level ? evaluation.level.label : 'Non renseigné' }}</span>{% if evaluation.comment %}<p class="sr-text mt-3">{{ evaluation.comment }}</p>{% endif %}</article>{% endfor %}</section>{% endif %}
<p class="sr-muted">Les réponses sont celles enregistrées par le participant. Les intitulés proviennent du modèle actuel du questionnaire.</p>
</div>{% endblock %}
