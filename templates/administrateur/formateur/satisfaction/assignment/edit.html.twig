{% extends 'formateur/rapport/show.html.twig' %}
{% block title %}Modifier l’affectation formateur{% endblock %}
{% block body %}
<div class="container py-4" style="max-width:850px">
  <a href="{{ path('app_administrateur_formateur_satisfaction_assignment_index', {entite:entite.id}) }}" class="btn btn-outline-secondary mb-3">← Retour aux affectations</a>
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
      <h1 class="h3 fw-bold">Modifier l’affectation</h1>
      <p class="text-muted">{{ assignment.session.code }} · {{ assignment.template.titre|default('Questionnaire formateur') }}</p>
      <p>Choisissez le formateur qui doit compléter ce questionnaire. La session et le questionnaire restent associés à cette affectation.</p>
      {% form_theme form 'bootstrap_5_layout.html.twig' %}
      {{ form_start(form) }}
      {{ form_row(form.formateur) }}
      <p class="small text-muted">Ce changement concerne le destinataire du questionnaire. Les intervenants de la session se modifient dans la fiche session. La période d’accès au questionnaire reste inchangée.</p>
      <button class="btn btn-warning" type="submit">Enregistrer l’affectation</button>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}
