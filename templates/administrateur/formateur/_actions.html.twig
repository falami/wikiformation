{# templates/administrateur/formateur/_actions.html.twig #}

<div class="btn-group btn-group-sm formateur-actions" role="group">

  <a class="btn btn-light" title="Voir le CV, les compétences et diplômes" href="{{ path('app_admin_trainer_cv',{entite:entite.id,id:formateur.id}) }}"><i class="bi bi-person-vcard me-1"></i>CV</a>
  {# ✅ Split dropdown #}
  <button type="button"
          class="btn btn-light dropdown-toggle dropdown-toggle-split formateur-split"
          data-bs-toggle="dropdown" aria-expanded="false">
    <span class="visually-hidden">Actions</span>
  </button>

  <ul class="dropdown-menu dropdown-menu-end formateur-menu">

    <li>
      <a class="dropdown-item d-flex align-items-center"
         href="{{ path('app_administrateur_formateur_modifier', { entite: entite.id, id: formateur.id }) }}">
        <i class="bi bi-pencil me-2"></i>
      </a>
    </li>

    {# (optionnel) si tu as une page show #}
    {#
    <li>
      <a class="dropdown-item d-flex align-items-center"
         href="{{ path('app_administrateur_formateur_show', { entite: entite.id, id: formateur.id }) }}">
        <i class="bi bi-eye me-2"></i> Ouvrir
      </a>
    </li>
    #}

    <li><hr class="dropdown-divider"></li>

    <li>
      <form method="post" action="{{ path('app_administrateur_formateur_supprimer', { entite: entite.id, id: formateur.id }) }}" onsubmit="return confirm('Confirmer la suppression ?');">
          <input type="hidden" name="_token" value="{{ csrf_token('delete_formateur_' ~ formateur.id) }}">
          <button type="submit" class="dropdown-item d-flex align-items-center text-danger" title="Supprimer"><i class="bi bi-trash me-2" aria-hidden="true"></i>Supprimer</button>
        </form>
    </li>

  </ul>
</div>
