{% extends 'base_admin.html.twig' %}
{% block title %}Contrat {{ contrat.numero }}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/formulaire.css') }}">

  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};

      --bg:#f5f7fb;
      --panel:#fff;
      --ink:#0f172a;
      --muted:#64748b;
      --stroke: rgba(15, 23, 42, .10);
      --shadow: 0 18px 55px rgba(15, 23, 42, .10);
      --radius:18px;
    }



    .hero{
      border-radius: 22px;
      position: relative;
      overflow: hidden;
      color: #fff;

      /* Ombre douce premium */
      box-shadow: 0 18px 50px rgba(0,0,0,.14);

      /* Fond piloté par les couleurs de l'entité */
      background:
        /* halo clair (tertiaire) */
        radial-gradient(1200px 420px at 12% -10%,
          color-mix(in srgb, var(--theme-color-tertiaire) 35%, transparent),
          transparent 58%
        ),
        /* halo accent (secondaire) */
        radial-gradient(900px 380px at 92% 0%,
          color-mix(in srgb, var(--theme-color-secondaire) 32%, transparent),
          transparent 60%
        ),
        /* voile subtil (quaternaire) pour la profondeur */
        radial-gradient(700px 260px at 55% 115%,
          color-mix(in srgb, var(--theme-color-quaternaire) 18%, transparent),
          transparent 62%
        ),
        /* dégradé principal (principal -> plus clair) */
        linear-gradient(135deg,
          color-mix(in srgb, var(--theme-color-principal) 92%, #000 8%),
          color-mix(in srgb, var(--theme-color-principal) 70%, #fff 30%)
        );
    }

    /* léger glass highlight */
    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0) 55%);
      opacity:.85;
    }

    /* barre accent = secondaire (et glow basé sur secondaire) */
    .hero .accent{
      width: 12px;
      border-radius: 999px;
      background: var(--theme-color-secondaire);
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
    }
    /* ===== Chips HERO (comme Sessions) ===== */
    .hero .chip{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      padding:.32rem .7rem;
      border-radius:999px;
      background: rgba(255,255,255,.10);
      border: 1px solid rgba(255,255,255,.14);
      backdrop-filter: blur(6px);
      font-size:.82rem;
      color: rgba(255,255,255,.92);
      white-space: nowrap;
    }
    .hero .chip i{ color: var(--theme-color-secondaire); }

    .hero .chip--pill{
      background: color-mix(in srgb, var(--theme-color-secondaire) 18%, transparent);
      border-color: color-mix(in srgb, var(--theme-color-secondaire) 28%, rgba(255,255,255,.14));
      color:#fff;
    }

    .hero .subtitle{ opacity:.86; }
    .hero .btn{ border-radius:14px; font-weight:800; }
    .btn-outline-theme{
      border-color: rgba(255,255,255,.35);
      color:#fff;
    }
    .btn-outline-theme:hover{
      background: rgba(255,255,255,.10);
      border-color: rgba(255,255,255,.55);
      color:#fff;
    }

    .cardx{
      background: var(--panel);
      border: 1px solid var(--stroke);
      border-radius: var(--radius);
      box-shadow: 0 10px 28px rgba(15,23,42,.08);
      overflow:visible;
    }
    .cardx-h{
      padding: .95rem 1.05rem;
      display:flex; align-items:center; justify-content:space-between; gap:1rem;
      background: linear-gradient(180deg, rgba(0,0,0,.015), transparent);
      border-bottom: 1px solid var(--stroke);
    }
    .cardx-title{
      margin:0; font-weight:800; letter-spacing:-.01em; color: var(--ink);
      display:flex; align-items:center; gap:.6rem;
    }
    .chip{
      font-size:.78rem; padding:.25rem .55rem; border-radius:999px;
      background: color-mix(in srgb, var(--theme-color-principal) 10%, transparent);
      border: 1px solid color-mix(in srgb, var(--theme-color-principal) 18%, var(--stroke));
      color: var(--muted);
      white-space:nowrap;
    }

    label.form-label{ font-weight: 700; color: var(--ink); }
    .form-text, .text-muted, .small{ color: var(--muted) !important; }
    .form-control, .form-select{
      border-radius: 14px;
      border: 1px solid var(--stroke);
      padding: .65rem .85rem;
    }
    .form-control:focus, .form-select:focus{
      border-color: color-mix(in srgb, var(--theme-color-principal) 55%, var(--stroke));
      box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--theme-color-principal) 18%, transparent);
    }


    @media (max-width:768px){
      .hero{ border-radius:16px; }
    }
    .contract-stat { padding:1.25rem; height:100%; }
    .contract-stat strong { display:block; margin:.35rem 0; font-size:1.35rem; color:var(--ink); }
    .contract-stat i { color:var(--theme-color-secondaire); margin-right:.45rem; }
    .contract-timeline { border-left:2px solid var(--stroke); padding-left:1.35rem; margin-left:.45rem; }
    .contract-version { position:relative; padding:1.1rem 0; }
    .contract-version::before { content:''; position:absolute; left:-1.77rem; top:1.4rem; width:12px; height:12px; border-radius:50%; background:var(--theme-color-principal); box-shadow:0 0 0 4px #fff; }
    .contract-version + .contract-version { border-top:1px solid var(--stroke); }
    .contract-workspace .btn { border-radius:12px; }
    .contract-workspace .cardx-h { flex-wrap:wrap; }
    .contract-workspace .hero .flex-grow-1 { min-width:0; }
    .contract-workspace section { scroll-margin-top:100px; }
    .contract-workspace .hero h1 { overflow-wrap:anywhere; }
  </style>
{% endblock %}


{% block body %}
<div class="container-fluid py-4 contract-workspace">
  <a class="btn btn-outline-secondary mb-3" href="{{ path('app_administrateur_formateurs_contrats_list', {entite: entite.id}) }}"><i class="bi bi-arrow-left me-1"></i> Tous les contrats de {{ entite.nom }}</a>
  {% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
  <div class="hero p-4 mb-4">
    <div class="d-flex gap-3"><div class="accent flex-shrink-0"></div><div class="flex-grow-1">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div><div class="text-uppercase subtitle mb-2">Contrat formateur · {{ entite.nom }}</div><h1 class="h3 fw-bold">{{ contrat.numero }}</h1><p class="subtitle mb-3">{{ contrat.formateur.utilisateur.prenom }} {{ contrat.formateur.utilisateur.nom }} · {{ contrat.session.formationLabel }}</p><div class="d-flex flex-wrap gap-2"><span class="chip"><i class="bi bi-layers"></i> Version {{ contrat.versionNumero }}</span><span class="chip chip--pill">{{ contrat.status.label }}</span><a class="chip text-decoration-none" href="#historique-versions"><i class="bi bi-clock-history"></i> {{ revisions|length }} version(s) conservée(s)</a></div></div>
      <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-theme" href="{{ path('app_administrateur_session_show', {entite: entite.id, id: contrat.session.id}) }}">Voir la session</a>
        {% if contrat.status.value == 'BROUILLON' and not frozen %}<a class="btn btn-light" href="{{ path('app_administrateur_formateurs_contrats_edit', {entite: entite.id, id: contrat.id}) }}"><i class="bi bi-pencil-square me-1"></i> Modifier</a>{% endif %}
        {% if contrat.status.value != 'BROUILLON' or frozen %}<a class="btn btn-light" href="#nouvelle-version"><i class="bi bi-pencil-square me-1"></i> Créer une nouvelle version</a>{% endif %}
        {% if not frozen or stored_pdf_available %}<a class="btn btn-warning" href="{{ path('app_administrateur_formateurs_contrats_pdf', {entite: entite.id, id: contrat.id, download: 1}) }}"><i class="bi bi-download me-1"></i> Télécharger le PDF</a>{% endif %}
      </div>
    </div>
    </div></div>
  </div>
  <div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="cardx contract-stat"><div class="text-muted"><i class="bi bi-calendar-week"></i> Session</div><strong>{{ contrat.session.code }}</strong><div class="small">{{ contrat.session.site.nom|default('Lieu à préciser') }}</div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="cardx contract-stat"><div class="text-muted"><i class="bi bi-cash-stack"></i> Honoraires et frais HT</div><strong>{{ ((contrat.montantPrevuCents + contrat.fraisMissionCents) / 100)|number_format(2, ',', ' ') }} €</strong><div class="small">Dont frais : {{ (contrat.fraisMissionCents / 100)|number_format(2, ',', ' ') }} €</div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="cardx contract-stat"><div class="text-muted"><i class="bi bi-people"></i> Effectif prévu de la session</div><strong>{{ effectif }} stagiaire(s)</strong><div class="small">Effectif des conventions prioritaire</div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="cardx contract-stat"><div class="text-muted"><i class="bi bi-pen"></i> Signature du formateur</div><strong>{{ contrat.signatureAt ? contrat.signatureAt|date('d/m/Y') : 'En attente' }}</strong><div class="small">Créé le {{ contrat.dateCreation|date('d/m/Y') }}</div></div></div>
  </div>
  {% if frozen %}
    <div class="alert {{ stored_pdf_available ? 'alert-info' : 'alert-warning' }}">{% if stored_pdf_available %}Le document conservé est affiché ci-dessous. Il reste inchangé si le planning de la session évolue.{% else %}Le PDF original de ce contrat est introuvable. Restaurez le document conservé pour le consulter ; un contrat signé ne peut pas être régénéré.{% endif %}</div>
  {% else %}
    <div class="card rounded-4 mb-4"><div class="card-body p-4"><h2 class="h5">Créneaux attribués à ce formateur</h2><p class="text-muted">{{ contrat.session.nombreHeuresPourFormateur(contrat.formateur)|number_format(2, ',', ' ') }} heures de formation hors pauses. Ces horaires sont repris dans le PDF.</p><ul class="mb-0">{% for jour in contrat.session.joursPourFormateur(contrat.formateur) %}<li>{{ jour.dateDebut|date('d/m/Y') }} · {{ jour.dateDebut|date('H:i') }}–{{ jour.dateFin|date('H:i') }} · {{ jour.dureeFormationHeures|number_format(2, ',', ' ') }} h{% if jour.pauseEffectiveMinutes > 0 %} (pause de {{ jour.pauseEffectiveMinutes }} min déduite){% endif %}</li>{% else %}<li>Aucun créneau attribué. Complétez le planning de la session.</li>{% endfor %}</ul></div></div>
  {% endif %}
  {% if contrat.status.value != 'BROUILLON' or frozen %}
    <section id="nouvelle-version" class="cardx mb-4"><div class="card-body p-4">
      <h2 class="h5">Créer une nouvelle version</h2>
      <p class="text-muted">Le document actuel sera conservé avec son statut et ses signatures. La nouvelle version sera un brouillon à faire signer de nouveau.</p>
      <form method="post" action="{{ path('app_administrateur_formateurs_contrats_revise', {entite: entite.id, id: contrat.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('revise_contrat_' ~ contrat.id) }}">
        <input type="hidden" name="versionAttendue" value="{{ contrat.lockVersion }}">
        <label class="form-label" for="revision-motif">Motif de la révision</label>
        <textarea name="motif" id="revision-motif" class="form-control mb-3" required maxlength="1000" rows="2" placeholder="Ex. : ajustement des honoraires ou des conditions de mission"></textarea>
        <button class="btn btn-warning fw-semibold" type="submit"><i class="bi bi-plus-lg me-1"></i> Conserver la version {{ contrat.versionNumero }} et préparer la suivante</button>
      </form>
    </div></section>
  {% endif %}
  <section id="historique-versions" class="cardx mb-4"><div class="cardx-h"><h2 class="h5 cardx-title"><i class="bi bi-clock-history text-warning"></i> Historique des versions</h2><span class="chip">Traçabilité du document</span></div><div class="card-body p-4">
    <p class="small text-muted">Version actuelle : {{ contrat.versionNumero }} · {{ contrat.status.label }}. Chaque modification conserve le document précédent.</p>
    {% set statusLabels = {'BROUILLON': 'Brouillon', 'ENVOYE': 'Envoyé', 'SIGNE': 'Signé', 'ARCHIVE': 'Archivé', 'RESILIE': 'Résilié'} %}
    <div class="contract-timeline">
    {% for revision in revisions %}
      <article class="contract-version">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div><strong>Version {{ revision.numero }}</strong> <span class="badge text-bg-light border">{{ statusLabels[revision.donnees.status]|default(revision.donnees.status) }}</span><div class="small text-muted">Remplacée le {{ revision.archiveLe|date('d/m/Y à H:i') }} par {{ revision.auteurNom }}</div></div>
          <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener" href="{{ path('app_administrateur_formateurs_contrats_revision_pdf', {entite: entite.id, id: contrat.id, revision: revision.id}) }}">Consulter le PDF conservé</a>
        </div>
        <p class="mt-2 mb-1">{{ revision.motif }}</p>
        <div class="small text-muted">{{ revision.donnees.formateur }} · {{ revision.donnees.sessionCode }} · {{ revision.donnees.heures|number_format(2, ',', ' ') }} h · {{ revision.donnees.effectif }} stagiaire(s) · {{ ((revision.donnees.montantPrevuCents + revision.donnees.fraisMissionCents) / 100)|number_format(2, ',', ' ') }} € HT{% if revision.donnees.signatureAt %} · Signée le {{ revision.donnees.signatureAt|date('d/m/Y à H:i') }}{% endif %}</div>
      </article>
    {% else %}<div class="contract-version text-muted">Aucune version antérieure. L’historique sera alimenté à la prochaine modification.</div>{% endfor %}
    </div>
  </div></section>
  {% if not frozen or stored_pdf_available %}<iframe class="w-100 border rounded-4 bg-white" style="height: 80vh; min-height: 600px" title="PDF du contrat {{ contrat.numero }}" src="{{ path('app_administrateur_formateurs_contrats_pdf', {entite: entite.id, id: contrat.id}) }}"></iframe>{% endif %}
</div>
{% endblock %}
