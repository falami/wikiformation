{# templates/administrateur/formateur/contrat/_actions.html.twig #}

<div class="contract-actions d-flex gap-1 justify-content-end">

  {# Modifier seulement si brouillon #}
  {% if status == 'BROUILLON' and not c.signatureAt and not c.signatureDataUrl %}
    <a href="{{ path('app_administrateur_formateurs_contrats_edit', { entite: entite.id, id: c.id }) }}"
       class="btn btn-warning btn-sm"
       data-bs-toggle="tooltip"
       data-bs-title="Modifier">
      <i class="bi bi-pencil"></i>
    </a>
  {% endif %}

  {# Voir comme formateur #}
  <a href="{{ path('app_administrateur_formateurs_contrats_show', { entite: entite.id, id: c.id }) }}"
     class="btn btn-primary btn-sm"
     data-bs-toggle="tooltip"
     title="Consulter le contrat" aria-label="Consulter le contrat">
    <i class="bi bi-eye"></i>
  </a>

  {# PDF #}
    <a href="{{ path('app_administrateur_formateurs_contrats_pdf', {entite: entite.id, id: c.id, download: 1}) }}" target="_blank" rel="noopener"
       class="btn btn-dark btn-sm"
       data-bs-toggle="tooltip"
       title="Télécharger le PDF" aria-label="Télécharger le PDF">
      <i class="bi bi-file-earmark-pdf"></i>
    </a>

  {# ✅ Supprimer (ouvre #deleteModal) #}
  {% if status == 'BROUILLON' and not c.signatureAt and not c.signatureDataUrl %}
    <button type="button"
            class="btn btn-danger btn-sm delete-btn"
            data-bs-toggle="modal"
            data-bs-target="#deleteModal"
            data-url="{{ path('app_administrateur_formateurs_contrats_supprimer', { entite: entite.id, id: c.id }) }}"
            data-token="{{ csrf_token('delete_contrat_formateur_' ~ c.id) }}"
            data-bs-title="Supprimer">
      <i class="bi bi-trash"></i>
    </button>
  {% endif %}

</div>
