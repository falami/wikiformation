{% set editable = status == 'BROUILLON' and not c.signatureAt and not c.signatureDataUrl and not c.signatureOrganismeAt %}
<div class="btn-group btn-group-sm contract-actions" role="group" aria-label="Actions du contrat {{ c.numero }}">
  <a href="{{ path('app_administrateur_formateurs_contrats_show', { entite: entite.id, id: c.id }) }}"
     class="btn btn-light" title="Consulter le contrat" aria-label="Consulter le contrat">
    <i class="bi bi-eye" aria-hidden="true"></i>
  </a>
  <button type="button" class="btn btn-light dropdown-toggle dropdown-toggle-split"
          data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions du contrat {{ c.numero }}"></button>
  <ul class="dropdown-menu dropdown-menu-end">
    {% if editable %}
      <li><a class="dropdown-item" href="{{ path('app_administrateur_formateurs_contrats_edit', { entite: entite.id, id: c.id }) }}">
        <i class="bi bi-pencil me-2" aria-hidden="true"></i> Modifier
      </a></li>
    {% endif %}
    <li><a class="dropdown-item" href="{{ path('app_administrateur_formateurs_contrats_show', { entite: entite.id, id: c.id }) }}#historique-versions">
      <i class="bi bi-clock-history me-2" aria-hidden="true"></i> Suivi des versions
    </a></li>
    <li><a class="dropdown-item" href="{{ path('app_administrateur_formateurs_contrats_pdf', { entite: entite.id, id: c.id, download: 1 }) }}" target="_blank" rel="noopener">
      <i class="bi bi-file-earmark-pdf me-2" aria-hidden="true"></i> Télécharger le PDF
    </a></li>
    {% if editable %}
      <li><hr class="dropdown-divider"></li>
      <li><button type="button" class="dropdown-item text-danger delete-btn" data-bs-toggle="modal" data-bs-target="#deleteModal"
                  data-url="{{ path('app_administrateur_formateurs_contrats_supprimer', { entite: entite.id, id: c.id }) }}"
                  data-token="{{ csrf_token('delete_contrat_formateur_' ~ c.id) }}">
        <i class="bi bi-trash me-2" aria-hidden="true"></i> Supprimer
      </button></li>
    {% endif %}
  </ul>
</div>
