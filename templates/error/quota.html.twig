{% extends 'error/layout.html.twig' %}
{% block title %}Capacité de votre abonnement · WikiFormation{% endblock %}
{% block code %}↗{% endblock %}
{% block panel %}
  <span class="eyebrow">VOTRE ABONNEMENT</span>
  <h2 id="auth-title">Votre activité grandit.</h2>
  <p class="form-description" role="alert">{{ message }}</p>
  <p class="form-description">Cet ajout dépasse la capacité de votre offre. Consultez les offres pour disposer de plus de places.</p>
  <a class="verify-button" href="{{ path('app_public_pricing') }}">Découvrir les offres <span aria-hidden="true">↗</span></a>
  <a class="cancel-link" href="{{ path('app_workspace') }}">Revenir à mon espace</a>
{% endblock %}
