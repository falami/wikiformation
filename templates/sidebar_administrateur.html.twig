{# One navigation tree for every screen size; visibility remains controlled by entity permissions. #}
<aside id="workspaceSidebar" class="sidebar wn-sidebar" aria-label="Navigation de votre organisme"
       data-storage-key="workspace-navigation:{{ app.user.id }}:{{ entite.id }}" tabindex="-1">
  <div class="wn-brand">
    <a class="wn-brand-link" href="{{ path('app_workspace') }}" aria-label="{{ entite.nom }} — changer d’organisme">
      <span class="wn-brand-logo">
        {% if entite.logo|default('') %}
          <img src="{{ asset('uploads/photos/entite/logo/') }}{{ entite.logo }}" alt="Logo {{ entite.nom }}" width="64" height="64">
        {% else %}
          <span class="wn-brand-monogram" aria-hidden="true">{{ entite.nom|first|upper }}</span>
        {% endif %}
      </span>
      <span class="wn-brand-copy"><span class="wn-brand-eyebrow">Votre organisme</span><strong>{{ entite.nom }}</strong></span>
    </a>
    <button type="button" class="wn-close" data-navigation-dismiss aria-label="Fermer le menu">
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
  </div>
  <div class="wn-nav-search-wrap">
    <div class="wn-nav-search">
      <i class="bi bi-search" aria-hidden="true"></i>
      <label class="visually-hidden" for="workspaceNavSearch">Rechercher une rubrique du menu</label>
      <input id="workspaceNavSearch" type="search" placeholder="Rechercher une rubrique…" autocomplete="off" spellcheck="false" aria-controls="workspaceNavTree">
      <button type="button" data-navigation-clear aria-label="Effacer la recherche" hidden><i class="bi bi-x" aria-hidden="true"></i></button>
    </div>
    <p id="workspaceNavStatus" class="visually-hidden" role="status" aria-live="polite"></p>
  </div>
  <div id="workspaceNavScroll" class="wn-scroll">
