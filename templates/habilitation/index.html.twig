{% extends 'habilitation/layout.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }

 
  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/preferences.css') }}">
{% endblock %}
{% block content %}
{% if isAdmin and sync.incomplete %}<div class="alert alert-warning">{{ sync.incomplete }} inscription(s) commencée(s) nécessitent une affectation manuelle : vérifiez l’entreprise du stagiaire et le formateur de la session.</div>{% endif %}
{% if sessionId %}<p>Évaluations de la session sélectionnée · <a href="{{ path('app_habilitation_index', {entite: entite.id}) }}">Toutes les sessions</a></p>{% endif %}
<header class="hab-hero"><div><div class="hab-eyebrow">ÉVALUATION & HABILITATION</div><h1>Des compétences évaluées.<br>Des décisions tracées.</h1><p>De l’avis du formateur au titre délivré par l’employeur, retrouvez chaque dossier et ses documents.</p></div>{% if canCreate %}<a class="hab-btn gold" href="{{ path('app_habilitation_assign', {entite: entite.id}) }}"><i class="bi bi-plus-lg"></i> Affecter une évaluation</a>{% endif %}</header>
<div class="hab-steps"><span><b>01</b> Modèle de formation</span><span><b>02</b> Avis du formateur</span><span><b>03</b> Décision de l’entreprise</span><span><b>04</b> Titre du stagiaire</span></div>
<section class="hab-panel"><div class="hab-heading"><div><h2>Dossiers d’habilitation</h2><p>Les documents signés restent consultables dans chaque dossier.</p></div><form method="get" class="hab-search"><input type="hidden" name="session" value="{{ sessionId }}"><input name="q" aria-label="Rechercher" placeholder="Stagiaire, entreprise, session…" value="{{ q }}"><button class="hab-btn">Rechercher</button></form></div>
{% if isAdmin %}<form id="hab-bulk-selection" method="post" action="{{ path('app_habilitation_bulk_assign',{entite:entite.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('habilitation_bulk') }}"><div class="hab-actions" style="justify-content:flex-start;margin-bottom:16px"><button class="hab-btn gold" id="hab-bulk-button" disabled>Modifier la sélection (0)</button><small>La case d’en-tête sélectionne les dossiers de cette page.</small></div></form>{% endif %}
<div class="hab-table-wrap"><table class="hab-table"><thead><tr>{% if isAdmin %}<th style="width:44px"><input type="checkbox" id="hab-select-all" aria-label="Sélectionner tous les dossiers de cette page" style="width:20px;height:20px"></th>{% endif %}<th>Stagiaire / session</th><th>Entreprise</th><th>Suivi</th><th>Actions</th></tr></thead><tbody>{% for d in dossiers %}<tr>{% if isAdmin %}<td><input type="checkbox" name="ids[]" value="{{ d.id }}" form="hab-bulk-selection" class="hab-select-row" aria-label="Sélectionner {{ d.inscription.stagiaire.prenom }} {{ d.inscription.stagiaire.nom }}" style="width:20px;height:20px"></td>{% endif %}<td><strong>{{ d.inscription.stagiaire.prenom }} {{ d.inscription.stagiaire.nom }}</strong><small>{{ d.inscription.session.code }} · {{ d.inscription.session.formationLabel }}</small></td><td>{{ d.entreprise.raisonSociale }}</td><td>{% include 'habilitation/_badge.html.twig' %}<small>{% for f in d.formateurs %}{{ f.prenom }} {{ f.nom }}{{ not loop.last ? ", " }}{% endfor %}</small></td><td><a class="hab-btn" href="{{ path('app_habilitation_show', {entite: entite.id, id: d.id}) }}">Ouvrir <i class="bi bi-arrow-up-right"></i></a>{% if isAdmin %} <a class="hab-btn" href="{{ path('app_habilitation_reassign', {entite: entite.id, id: d.id}) }}">Modifier l’affectation</a>{% endif %}{% if d.avisToken %} <a class="hab-btn" href="{{ path('app_habilitation_attestation', {entite: entite.id, id: d.id, token: d.avisToken}) }}">Attestation PDF</a>{% else %}<small class="text-muted">Attestation disponible après validation et signature du formateur.</small>{% endif %}</td></tr>{% else %}<tr><td colspan="{{ isAdmin ? 5 : 4 }}"><div class="hab-empty"><i class="bi bi-lightning-charge"></i><h3>Aucun dossier à afficher</h3><p>{% if canCreate %}Choisissez une inscription et le modèle d’habilitation de sa formation pour démarrer.{% else %}Les dossiers apparaîtront ici lorsqu’ils seront disponibles pour votre espace.{% endif %}</p></div></td></tr>{% endfor %}</tbody></table></div>
<div class="hab-actions">{% if page > 1 %}<a class="hab-btn" href="{{ path('app_habilitation_index', {entite: entite.id, page: page - 1, q: q, session: sessionId}) }}">Précédent</a>{% endif %}<span>Page {{ page }}</span>{% if more %}<a class="hab-btn" href="{{ path('app_habilitation_index', {entite: entite.id, page: page + 1, q: q, session: sessionId}) }}">Suivant</a>{% endif %}</div></section>
{% endblock %}

{% block javascripts %}{{ parent() }}{% if isAdmin %}<script src="{{ asset('dist/js/habilitation-bulk.js') }}" defer></script>{% endif %}{% endblock %}
