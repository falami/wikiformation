<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><title>Titre d’habilitation électrique - {{ snapshot.identity.trainee }}</title>
<style>
@page{margin:32px 40px 44px}
body{font-family:"DejaVu Sans",sans-serif;font-size:9px;line-height:1.35;color:#203744}
*{box-sizing:border-box}table{width:100%;border-collapse:collapse;table-layout:fixed}td{vertical-align:top;word-wrap:break-word}p{margin:4px 0}
.masthead{margin-bottom:12px;table-layout:auto}.masthead td{vertical-align:middle}.logo-cell{width:108px}.logo{max-width:82px;max-height:58px}.company-name{font-size:17px;line-height:1.2;font-weight:bold;margin-bottom:5px}.company-address{font-size:8px;color:#627381;white-space:pre-line}.document-type{width:112px;text-align:right;font-size:7px;letter-spacing:1.1px;color:#627381}
.hero{background:#1b3443;color:#fff;border-left:5px solid #d1ac5d;padding:10px 17px;margin-bottom:10px}.eyebrow{font-size:7px;letter-spacing:1.6px;text-transform:uppercase;color:#e6ca8b}.hero h1{font-size:24px;line-height:1.15;font-weight:bold;margin:3px 0 5px}.hero p{color:#dce4e9;font-size:9px}
.holder{background:#f2f5f6;padding:7px 13px;border-bottom:2px solid #d1ac5d}.holder-name{font-size:17px;font-weight:bold;margin-top:2px}.label{font-size:7px;letter-spacing:.8px;text-transform:uppercase;color:#6a7c88}.section-title{font-size:11px;margin:10px 0 5px;page-break-after:avoid}.section-title span{font-size:9px;color:#a88335;margin-right:9px}.meta td{padding:6px 10px;border-bottom:1px solid #e0e6ea;width:50%}.value{font-size:9px;font-weight:bold;margin-top:3px}.small{font-size:8px;color:#627381}.free{white-space:pre-wrap;word-wrap:break-word}
.operation{margin:0 0 10px}.operation-title{background:#edf2f4;border-left:3px solid #c7a45a;padding:5px 10px;font-size:9px;font-weight:bold;page-break-after:avoid}.operation-group{font-size:7px;color:#627381;text-transform:uppercase;letter-spacing:.5px;font-weight:normal}.scope td{border-bottom:1px solid #e5e9ec;padding:4px 10px}.scope-label{width:36%;font-size:8px;color:#627381;background:#fafbfc}.scope-value{font-size:9px}.notice{padding:7px 11px;border-left:3px solid #d1ac5d;background:#faf6ec;font-size:8px;margin:8px 0}.archive{border:1px solid #b36e2b;color:#80501e;padding:9px 12px;margin-bottom:12px;font-size:8px}.signature-block{page-break-inside:avoid;margin-top:12px;border-top:2px solid #203744;padding-top:8px}.signature td{width:50%;padding-right:16px}.signature img{max-width:170px;max-height:44px;margin:3px 0}.holder-signature{height:40px;border-bottom:1px solid #bac7d0;margin-top:7px}.trace{border-top:1px solid #e0e6ea;padding-top:6px;margin-top:8px;font-size:6.8px;color:#627381;word-wrap:break-word}.reference{font-family:"DejaVu Sans Mono",monospace;font-size:6.5px}.restrictions{margin-bottom:10px}.continuation{font-size:8px;color:#627381}
</style>
{# The employer issues the title. The training organisation is deliberately not the footer issuer. #}
<meta name="wf-document-footer" content="{{ {name:companyBrand.name,reference:'Titre - Réf. '~revision.token}|json_encode|e('html_attr') }}">
</head><body>
<table class="masthead"><tr>{% if companyBrand.logoDataUri %}<td class="logo-cell"><img class="logo" src="{{ companyBrand.logoDataUri }}" alt="Logo de l’entreprise"></td>{% endif %}<td><div class="company-name">{{ companyBrand.name }}</div><div class="company-address">{{ companyBrand.address|default('') }}</div>{% if companyBrand.siret|default('') %}<div class="small">SIRET {{ companyBrand.siret }}</div>{% endif %}</td><td class="document-type">DÉCISION DE<br>L’EMPLOYEUR<br><br>{{ revision.createdAt|date('d/m/Y', 'Europe/Paris') }}</td></tr></table>
<div class="hero"><div class="eyebrow">Habilitation électrique · Titre personnel</div><h1>Titre d’habilitation électrique</h1><p>Opérations autorisées et périmètre confié au titulaire</p></div>
{% if archived or inactive %}<div class="archive"><b>VERSION ARCHIVÉE{{ inactive ? ' · DOSSIER DÉSACTIVÉ' }}</b><br>Document conservé pour l’historique. Il ne constitue pas le titre actuellement délivré.</div>{% endif %}
<div class="holder"><div class="label">Titulaire de l’habilitation</div><div class="holder-name">{{ snapshot.identity.trainee }}</div><div>{{ snapshot.data.function|default('') }}</div></div>
<h2 class="section-title"><span>01</span> Affectation et validité</h2>
<table class="meta"><tr><td colspan="2"><div class="label">Service, site ou chantier d’affectation</div><div class="value free">{{ snapshot.data.assignment|default('') }}</div></td></tr><tr><td><div class="label">Date de délivrance</div><div class="value">{{ snapshot.data.issuedAt|default('') ? snapshot.data.issuedAt|date('d/m/Y') : 'Non renseignée' }}</div></td><td><div class="label">Fin de validité</div><div class="value">{{ snapshot.data.validUntil|default('') ? snapshot.data.validUntil|date('d/m/Y') : 'Non renseignée' }}</div></td></tr></table>
<h2 class="section-title"><span>02</span> Habilitations délivrées</h2>
<p class="continuation">L’employeur autorise le titulaire à réaliser les opérations précisées ci-dessous, dans le périmètre retenu à partir de l’avis favorable du formateur.</p>
{% for section in snapshot.schema.sections %}{% for row in section.rows %}{% set answer = snapshot.data.rows[row.id]|default({}) %}
<div class="operation"><div class="operation-title"><div class="operation-group">{{ section.title }}</div>{{ row.title }}</div><table class="scope">{% for field in row.fields %}{% set value = answer[field.id]|default(field.type == 'checkbox' ? [] : '') %}{% if value %}<tr><td class="scope-label">{{ field.label }}</td><td class="scope-value free">{{ field.type == 'checkbox' ? value|join(' · ') : value }}</td></tr>{% endif %}{% endfor %}</table></div>
{% endfor %}{% endfor %}
{% for key,label in {restrictions:'Restrictions et recommandations du formateur',observations:'Observations du formateur',additionalDocument:'Documents complémentaires du formateur'} %}{% if snapshot.trainerReference[key]|default('') %}<h2 class="section-title">{{ label }}</h2><div class="restrictions free">{{ snapshot.trainerReference[key] }}</div>{% endif %}{% endfor %}
{% for key,label in {restrictions:'Restrictions et consignes de l’employeur',observations:'Observations',additionalDocument:'Documents complémentaires'} %}{% if snapshot.data[key]|default('') %}<h2 class="section-title">{{ label }}</h2><div class="restrictions free">{{ snapshot.data[key] }}</div>{% endif %}{% endfor %}
<div class="notice"><b>Conditions d’utilisation</b><br>Ce titre est personnel. Il s’applique uniquement aux opérations et au périmètre indiqués, dans le respect des consignes de sécurité et des instructions de l’employeur. Il ne permet pas d’entreprendre une opération de sa propre initiative et ne couvre pas les travaux sous tension.</div>
<div class="signature-block"><table class="signature"><tr><td><div class="label">Délivré par le représentant de l’employeur</div><div class="value">{{ snapshot.signer }}</div><div>{{ snapshot.data.signerFunction|default('') }}</div><p class="small">Fait{% if snapshot.data.place|default('') %} à {{ snapshot.data.place }}{% endif %}, le {{ revision.createdAt|date('d/m/Y', 'Europe/Paris') }}.</p><img src="{{ snapshot.signature }}" alt="Signature du représentant de l’employeur"></td><td><div class="label">Prise de connaissance par le titulaire</div><div class="value">{{ snapshot.identity.trainee }}</div><div class="small">Date et signature après remise du titre</div><div class="holder-signature"></div></td></tr></table>
<div class="trace"><b>Traçabilité de la décision</b><br>Formation : {{ snapshot.identity.formation }} · Session : {{ snapshot.identity.session }}<br>Organisme de formation : {{ snapshot.identity.organisme }}<br>{% if snapshot.avisToken|default('') %}Avis post-formation de référence : <span class="reference">{{ snapshot.avisToken }}</span><br>{% endif %}Décision signée le {{ revision.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }} · Référence : <span class="reference">{{ revision.token }}</span></div></div>
</body></html>
