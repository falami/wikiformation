{% extends 'base_admin.html.twig' %}



{% block title %}Habilitations électriques{% endblock %}

{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css"><link rel="stylesheet" href="{{ asset('dist/vendors/flatpickr/flatpickr.min.css') }}"><link rel="stylesheet" href="{{ asset('dist/css/style.css') }}"><link rel="stylesheet" href="{{ asset('dist/css/habilitation.css') }}">{% endblock %}
{% block body %}<div class="hab" data-enhanced-form>
{% if enterpriseContext|default(false) %}{% include 'entreprise/_company_selector.html.twig' %}{% endif %}
<nav class="hab-nav" aria-label="Habilitations">
{% if enterpriseContext|default(false) %}
  <a href="{{ returnDocumentsUrl }}"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> Documents · Avis & titres</a><span>{{ entreprise.raisonSociale }}</span>
{% elseif studentContext|default(false) %}
  <a href="{{ path('app_habilitation_student_index', {entite:entite.id}) }}">Mes habilitations</a><span>Avis post-formation et titres signés</span>
{% elseif trainerContext|default(false) %}
  <a href="{{ path('app_habilitation_trainer_index', {entite: entite.id}) }}">Habilitations · Espace formateur</a><span>Évaluations et avis post-formation</span>
{% else %}
  <a href="{{ path('app_habilitation_index', {entite: entite.id}) }}"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> Habilitations électriques</a>{% if isAdmin %}<a href="{{ path('app_habilitation_attestations', {entite: entite.id}) }}">Avis post-formation</a><a href="{{ path('app_habilitation_templates', {entite: entite.id}) }}">Bibliothèque de modèles</a>{% endif %}<span>{{ entite.nom }}</span>
{% endif %}
</nav>
{% include 'flagMessage.html.twig' %}{% block content %}{% endblock %}
</div>{% endblock %}

{% block javascripts %}{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js" defer></script>
<script src="{{ asset('dist/vendors/flatpickr/flatpickr.min.js') }}" defer></script>
<script src="{{ asset('dist/js/enhanced-forms.js') }}" defer></script>
{% endblock %}
