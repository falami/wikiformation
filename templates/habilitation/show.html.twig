{% extends 'habilitation/layout.html.twig' %}
{% block stylesheets %}
  {{ parent() }}
  <style>
    :root{
      --theme-color-principal: {{ themeColorPrimaire|default(entite.couleurPrincipal|default('#233342')) }};
      --theme-color-secondaire: {{ themeColorSecondaire|default(entite.couleurSecondaire|default('#ffc107')) }};
      --theme-color-tertiaire: {{ themeColorTertiaire|default(entite.couleurTertiaire|default('#F0F0F0')) }};
      --theme-color-quaternaire: {{ couleurQuaternaire|default(entite.couleurQuaternaire|default('#000000')) }};
    }

    .hab .hab-company-return{display:inline-flex;align-items:center;gap:9px;color:#5b7183;font-size:13px;font-weight:650;margin:0 0 20px}
    .hab .hab-company-intro{border:1px solid #dbe7ee;border-radius:18px;padding:24px;background:linear-gradient(125deg,#f4f8fb,#fff);margin-bottom:22px}
    .hab .hab-company-intro h2{font-size:21px}
    .hab .hab-company-intro p{margin-bottom:0;font-size:14px}
    .hab .hab-company-intro .hab-eyebrow{color:#96742d}
    .hab .hab-reference{margin-top:12px;padding:12px 14px;border:1px solid #e1e9ee;background:#fff;border-radius:9px;color:#607589;font-size:12px;line-height:1.7}
    .hab .hab-reference>strong{display:block;color:#405e72;font-size:11px;letter-spacing:.03em;margin-bottom:3px}
    .hab .hab-reference p{font-size:12px;white-space:pre-wrap;margin:6px 0 0}
    .hab .hab-reference summary{cursor:pointer;font-weight:650;color:#405e72}
    .hab .hab-reference summary:focus-visible{outline:3px solid #d9b65b;outline-offset:4px}
    .hab .hab-copy-legend{display:flex;align-items:center;flex-wrap:wrap;gap:10px;font-size:12px;color:#647b8d;margin-top:16px}
    .hab .hab-copy-legend .hab-badge{font-size:11px}
    .hab .hab-company-card{border-top:3px solid #d9b65b}
    .hab .hab-company-mark{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:#f8f0da;color:#9d7832;font-weight:700;font-size:21px;margin-bottom:18px}
    .hab .hab-company-card address{font-style:normal;color:#6b7f8e;font-size:13px;line-height:1.8;margin:0}
    .hab .hab-company-card .hab-download{font-size:13px}
    .hab .hab-check.unavailable{opacity:1;color:#81909e}
    .hab .hab-check.unavailable input{opacity:.5}
    @media(max-width:700px){.hab .hab-company-intro{padding:20px}.hab .hab-steps>a{white-space:normal}.hab .hab-company-return{line-height:1.6}}
  </style>

  <link rel="stylesheet" href="{{ asset('dist/css/style.css') }}">
  <link rel="stylesheet" href="{{ asset('dist/css/preferences.css') }}">
{% endblock %}
{% block content %}
{% set enterpriseContext = enterpriseContext|default(false) %}
{% set editorRoute = showRoute|default('app_habilitation_show') %}
{% set editorParams = showRouteParams|default({entite: entite.id, id: dossier.id}) %}
{% set trainerReference = trainerReference|default(dossier.trainerData) %}
{% if enterpriseContext %}<a class="hab-company-return" href="{{ returnDocumentsUrl }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Documents de {{ entreprise.raisonSociale }} · Avis & titres</a>{% endif %}
<header class="hab-hero"><div><div class="hab-eyebrow">DOSSIER #{{ dossier.id }} · {{ dossier.inscription.session.code }}</div><h1>{{ dossier.inscription.stagiaire.prenom }} {{ dossier.inscription.stagiaire.nom }}</h1><p>{{ dossier.inscription.session.formationLabel }}<br>{{ dossier.entreprise.raisonSociale }}</p>{% include 'habilitation/_badge.html.twig' with {d: dossier} %}</div><div class="hab-hero-aside"><small>FORMATEURS AFFECTÉS</small><strong>{% for f in dossier.formateurs %}{{ f.prenom }} {{ f.nom }}{{ not loop.last ? ", " }}{% endfor %}</strong><small>{{ dossier.template.titre }}</small></div></header>
<div class="hab-steps"><a class="{{ stage == 'avis' ? 'selected' }}" {% if stage == 'avis' %}aria-current="step"{% endif %} href="{{ path(editorRoute, editorParams|merge({stage: 'avis'})) }}"><b>01</b> Avis post-formation {{ dossier.avisToken ? '✓' }}</a>{% if rights.admin or rights.company or (rights.student and dossier.titreToken) %}<a class="{{ stage == 'titre' ? 'selected' }}" {% if stage == 'titre' %}aria-current="step"{% endif %} href="{{ path(editorRoute, editorParams|merge({stage: 'titre'})) }}"><b>02</b> Titre de l’employeur {{ dossier.titreToken ? '✓' }}</a>{% endif %}</div>
{% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
<div class="hab-layout"><main>
{% if not editable %}
<div class="hab-note"><i class="bi bi-lock" aria-hidden="true"></i><div><strong>Consultation uniquement</strong><br>Vous ne pouvez pas modifier ce document. Le titre est établi par le représentant désigné de l’entreprise.</div></div>
{% endif %}
{% if stage == 'titre' and dossier.avisToken and editable %}
<section class="hab-company-intro" aria-labelledby="employer-copy-title">
  <div class="hab-eyebrow">VOTRE DÉCISION · UN DOCUMENT DISTINCT</div>
  <h2 id="employer-copy-title">Établissez le titre de votre salarié.</h2>
  <p>À la première ouverture, les cases favorables cochées par le formateur sont reprises dans cette copie. Vous pouvez conserver ces choix, en retirer ou sélectionner un niveau inférieur parmi les propositions autorisées. Les choix qui dépassent l’avis sont verrouillés.</p>
  <p>L’avis signé du formateur reste inchangé. Complétez l’affectation, la validité et vos éventuelles restrictions, puis signez votre titre.</p>
  <div class="hab-copy-legend"><span class="hab-badge published"><i class="bi bi-check2-square" aria-hidden="true"></i> Choix du formateur repris</span><span><i class="bi bi-lock" aria-hidden="true"></i> Niveau équivalent ou inférieur uniquement</span></div>
</section>
{% elseif enterpriseContext and stage == 'avis' %}
<div class="hab-note"><i class="bi bi-lock" aria-hidden="true"></i><div><strong>L’avis du formateur est consultable en lecture seule.</strong><br>Pour établir votre propre document, ouvrez l’étape « Titre de l’employeur ».</div></div>
{% endif %}
<div class="hab-note"><i class="bi bi-info-circle"></i>{% if stage == 'avis' %}L’avis post-formation décrit les compétences évaluées. Il ne vaut pas habilitation : la décision finale appartient à l’employeur.{% else %}L’employeur définit le périmètre final, les restrictions et la validité. Les choix disponibles restent dans les limites de l’avis favorable du formateur.{% endif %}</div>
{% if stage == 'titre' and not dossier.avisToken %}<section class="hab-panel hab-empty"><h2>En attente de l’avis signé</h2><p>Le formateur doit terminer son évaluation avant la décision de l’entreprise.</p></section>{% else %}
<form method="post" id="hab-evaluation"><input type="hidden" name="_token" value="{{ csrf_token('habilitation_' ~ dossier.id) }}"><input type="hidden" name="version" value="{{ dossier.version }}"><fieldset {{ not editable ? 'disabled' }}>
<section class="hab-panel"><div class="hab-heading"><div><div class="hab-eyebrow">IDENTITÉ & PÉRIMÈTRE</div><h2>{{ stage == 'avis' ? 'Avis post-formation' : 'Titre d’habilitation électrique' }}</h2></div><span class="hab-icon"><i class="bi bi-person-vcard"></i></span></div><div class="hab-grid">
{% set fields = {function:'Fonction du salarié', assignment:'Affectation · service / chantier', issuedAt:'Date de délivrance', validUntil:'Date de fin de validité', signerFunction:'Fonction du signataire', place:'Lieu de signature'} %}
{% for key,label in fields %}<div><label for="hab-{{ key }}">{{ label }}{{ stage == 'avis' and key == 'validUntil' ? ' (si applicable)' }}</label><input id="hab-{{ key }}" name="data[{{ key }}]" type="{{ key in ['issuedAt','validUntil'] ? 'date' : 'text' }}" value="{{ data[key]|default('') }}" maxlength="4000"></div>{% endfor %}</div></section>
{% for section in displaySchema.sections %}
<section class="hab-panel">
  <div class="hab-heading"><div><div class="hab-eyebrow">SECTION {{ loop.index }}</div><h2>{{ section.title }}</h2></div></div>
  {% for row in section.rows %}
    {% set answer = data.rows[row.id]|default({}) %}
    {% set reference = trainerReference.rows[row.id]|default({}) %}
    <article class="hab-eval-row">
      <div class="hab-heading">
        <h3>{{ row.title }}</h3>
        {% if stage == 'avis' %}
          <div><label for="verdict-{{ row.id }}">Avis du formateur</label><select id="verdict-{{ row.id }}" name="data[rows][{{ row.id }}][verdict]">{% for value,label in {not_evaluated:'Non évalué', favorable:'Favorable', unfavorable:'Défavorable'} %}<option value="{{ value }}" {{ answer.verdict|default('not_evaluated') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div>
        {% else %}
          <span class="hab-badge {{ reference.verdict|default('') == 'favorable' ? 'published' : 'muted' }}">Avis du formateur : {{ reference.verdict|default('') == 'favorable' ? 'favorable' : (reference.verdict|default('') == 'unfavorable' ? 'défavorable' : 'non évalué') }}</span>
        {% endif %}
      </div>
      <div class="hab-answer-grid">
        {% for field in row.fields %}
          <div class="hab-answer">
            <label for="answer-{{ row.id }}-{{ field.id }}">{{ field.label }}</label>
            {% if field.type == 'checkbox' %}
              <div id="answer-{{ row.id }}-{{ field.id }}" class="hab-checks" role="group" aria-label="{{ field.label }}" {% if stage == 'titre' %}aria-describedby="reference-{{ row.id }}-{{ field.id }}"{% endif %}>
                {% for option in field.options %}
                  {% set allowedChoices = employerChoices[row.id][field.id] is defined ? employerChoices[row.id][field.id] : (reference.verdict|default('') == 'favorable' ? reference[field.id]|default([]) : []) %}
                  {% set allowed = stage == 'avis' or option in allowedChoices %}
                  <label class="hab-check {{ not allowed ? 'unavailable' }}"><input type="checkbox" name="data[rows][{{ row.id }}][{{ field.id }}][]" value="{{ option }}" {{ allowed and option in answer[field.id]|default([]) ? 'checked' }} {{ not allowed ? 'disabled' }}><span>{{ option }}{% if not allowed %}<span class="visually-hidden"> — non autorisé par l’avis du formateur</span>{% endif %}</span></label>
                {% endfor %}
              </div>
              {% if stage == 'titre' and field.id == 'symbols' %}
                {% set permitted = employerChoices[row.id][field.id]|default([]) %}
                {% set lowerChoices = permitted|filter(choice => choice not in reference[field.id]|default([])) %}
                <div class="hab-reference"><strong>Choix autorisés pour le titre</strong>{{ permitted is not empty ? permitted|join(' · ') : 'Aucun symbole autorisé pour cette ligne.' }}<br><strong>Choix inférieurs proposés</strong>{{ lowerChoices is not empty ? lowerChoices|join(' · ') : 'Aucun autre choix inférieur défini pour cette ligne du questionnaire.' }}</div>
              {% endif %}
              {% if stage == 'titre' %}<div class="hab-reference" id="reference-{{ row.id }}-{{ field.id }}"><strong><i class="bi bi-shield-check" aria-hidden="true"></i> Périmètre favorable du formateur</strong>{{ reference.verdict|default('') == 'favorable' and reference[field.id]|default([]) is not empty ? reference[field.id]|join(' · ') : 'Aucun choix autorisé pour cette rubrique.' }}</div>{% endif %}
            {% else %}
              <textarea id="answer-{{ row.id }}-{{ field.id }}" name="data[rows][{{ row.id }}][{{ field.id }}]" maxlength="600" rows="3" {% if stage == 'titre' %}readonly aria-describedby="reference-{{ row.id }}-{{ field.id }}"{% endif %}>{{ stage == 'titre' ? reference[field.id]|default('') : answer[field.id]|default('') }}</textarea>
              {% if stage == 'titre' %}<small id="reference-{{ row.id }}-{{ field.id }}"><i class="bi bi-lock" aria-hidden="true"></i> Périmètre de l’avis signé conservé. Ajoutez vos précisions dans les observations et restrictions ci-dessous.</small>{% endif %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </article>
  {% endfor %}
</section>
{% endfor %}
<section class="hab-panel"><h2>Observations et restrictions</h2>{% for key,label in {observations:'Observations · connaissances et compétences', restrictions:'Autorisations, interdictions et recommandations', additionalDocument:'Document complémentaire (préciser la référence, ou « Aucun »)'} %}<label for="hab-{{ key }}">{{ label }}</label><textarea id="hab-{{ key }}" name="data[{{ key }}]" maxlength="4000" rows="3">{{ data[key]|default('') }}</textarea>{% if stage == 'titre' and trainerReference[key]|default('') is not empty %}<details class="hab-reference"><summary>Texte de l’avis signé du formateur</summary><p>{{ trainerReference[key] }}</p></details>{% endif %}{% endfor %}</section>
{% if editable and canSign %}<section class="hab-panel"><div class="hab-eyebrow">VALIDATION PERSONNELLE</div><h2>Signer {{ stage == 'avis' ? 'l’avis' : 'le titre' }}</h2><p>{{ app.user.prenom }} {{ app.user.nom }} · {{ stage == 'avis' ? 'Formateur' : 'Représentant de l’entreprise' }}</p><label for="hab-signature">Dessinez votre signature</label><canvas id="hab-signature" width="1000" height="260" aria-label="Zone de signature"></canvas><button type="button" class="hab-btn" id="hab-clear">Effacer</button><div class="hab-upload" id="hab-signature-drop">
  <input id="hab-signature-file" type="file" accept="image/png,image/jpeg" hidden>
  <div class="hab-upload-empty" id="hab-upload-empty">
    <span class="hab-upload-icon"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i></span>
    <div><strong>Importez votre signature</strong><p>Glissez votre image ici ou sélectionnez-la sur votre appareil.</p><small>PNG ou JPEG · 500 Ko maximum</small></div>
    <button type="button" class="hab-btn" id="hab-upload-choose"><i class="bi bi-image" aria-hidden="true"></i> Parcourir les images</button>
  </div>
  <div class="hab-upload-preview" id="hab-upload-result" hidden>
    <div class="hab-upload-thumbnail"><img id="hab-signature-preview" alt="Aperçu de la signature importée" hidden></div>
    <div class="hab-upload-info"><span class="hab-badge published"><i class="bi bi-check-circle" aria-hidden="true"></i> Image prête</span><strong id="hab-upload-name"></strong><small id="hab-upload-size"></small></div>
    <div class="hab-upload-actions"><button type="button" class="hab-btn" id="hab-upload-replace">Remplacer</button><button type="button" class="hab-btn" id="hab-upload-remove"><i class="bi bi-trash3" aria-hidden="true"></i> Retirer</button></div>
  </div>
  <span class="visually-hidden" id="hab-upload-status" role="status" aria-live="polite"></span>
</div><input type="hidden" name="signature" id="hab-signature-data"><p id="hab-signature-error" role="alert"></p><label class="hab-check"><input type="checkbox" name="confirm" value="1"> Je confirme les informations de ce document et le signe en mon nom.</label></section>{% endif %}
</fieldset><input type="hidden" name="_complete" value="1">{% if editable %}<div class="hab-savebar"><button class="hab-btn" name="action" value="save">Enregistrer le brouillon</button>{% if canSign %}<button class="hab-btn gold" name="action" value="sign">{{ stage == 'avis' ? 'Valider et signer l’évaluation' : 'Signer et publier le titre' }}</button>{% else %}<small>La signature sera réalisée par {{ stage == 'avis' ? 'le formateur affecté' : 'l’entreprise' }}.</small>{% endif %}</div>{% endif %}</form>{% endif %}
</main><aside>
{% if stage == 'titre' %}
<section class="hab-panel hab-company-card">
  <div class="hab-company-mark" aria-hidden="true">{{ dossier.entreprise.raisonSociale|slice(0,1)|upper }}</div>
  <div class="hab-eyebrow">ENTREPRISE ÉMETTRICE</div>
  <h2>{{ dossier.entreprise.raisonSociale }}</h2>
  <address>{{ dossier.entreprise.adresse }}{% if dossier.entreprise.complement %}<br>{{ dossier.entreprise.complement }}{% endif %}<br>{{ dossier.entreprise.codePostal }} {{ dossier.entreprise.ville }}{% if dossier.entreprise.pays %}<br>{{ dossier.entreprise.pays }}{% endif %}</address>
  <p class="small">Le titre sera établi au nom de cette entreprise et conservera l’identité de son signataire.</p>
</section>
{% endif %}
<section class="hab-panel">
  <div class="hab-eyebrow">DOCUMENTS & TRAÇABILITÉ</div>
  <h2>Vos documents</h2>
  {% if dossier.avisToken %}
    {% set currentAvisUrl = enterpriseContext ? avisPdfUrl : path('app_habilitation_attestation', {entite: entite.id, id: dossier.id, token: dossier.avisToken}) %}
    <a class="hab-btn mb-3 w-100" href="{{ currentAvisUrl }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Télécharger l’avis post-formation</a>
  {% endif %}
  {% if dossier.titreToken %}
    {% set currentTitreUrl = enterpriseContext ? titrePdfUrl : path('app_habilitation_pdf', {entite: entite.id, id: dossier.id, token: dossier.titreToken}) %}
    {% if currentTitreUrl %}<a class="hab-btn gold mb-3 w-100" href="{{ currentTitreUrl }}"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Télécharger le titre</a>{% endif %}
  {% elseif stage == 'titre' %}<p class="small">Le PDF du titre sera disponible après votre signature.</p>{% endif %}
  <h3>Historique du dossier</h3>
  <p>Chaque validation conserve les informations et la signature de son auteur.</p>
  <div class="hab-timeline">
    {% for r in revisions %}
      <article>
        <strong>{{ {transmit:'Transmission à l’entreprise', avis:'Avis signé', titre:'Titre signé', edit_avis:'Avis modifié', edit_titre:'Titre modifié', assign:'Dossier créé', reassign:'Réaffectation', disable:'Désactivation', enable:'Réactivation', delete:'Suppression (archive)'}[r.kind]|default(r.kind) }}</strong>
        <small>{{ r.createdAt|date('d/m/Y à H:i') }} · {{ r.actor.prenom }} {{ r.actor.nom }}</small>
        {% if r.snapshot.reason is defined %}<p>{{ r.snapshot.reason }}</p>{% endif %}
        {% if r.kind in ['avis','titre'] %}
          {% set current = r.token in [dossier.avisToken, dossier.titreToken] %}
          <span class="hab-badge {{ current ? 'published' : 'muted' }}">{{ current ? 'Version actuelle' : 'Version archivée' }}</span>
          {% if enterpriseContext %}
            {% set revisionUrl = current ? (r.kind == 'avis' ? avisPdfUrl : titrePdfUrl) : null %}
            {% if revisionUrl %}<a class="hab-download" href="{{ revisionUrl }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Télécharger {{ r.kind == 'avis' ? 'l’avis' : 'le titre' }}</a>{% endif %}
          {% else %}
            <a class="hab-download" href="{{ path('app_habilitation_pdf', {entite: entite.id, id: dossier.id, token: r.token}) }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Télécharger le PDF</a>
            {% if r.kind == 'avis' %}<a class="hab-download" href="{{ path('app_habilitation_attestation', {entite: entite.id, id: dossier.id, token: r.token}) }}">Avis post-formation · cette version</a>{% endif %}
          {% endif %}
        {% endif %}
      </article>
    {% else %}<p>Aucun document signé à cette étape.</p>{% endfor %}
  </div>
</section>
{% if isAdmin and dossier.state == 'pending_admin' and dossier.active and not dossier.deleted %}<section class="hab-panel"><h2>Transmettre à l’entreprise</h2><p>L’évaluation a été validée par le formateur. Rendez-la disponible à l’entreprise après votre contrôle.</p><form method="post" action="{{ path('app_habilitation_transmit', {entite: entite.id, id: dossier.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('habilitation_' ~ dossier.id) }}"><input type="hidden" name="version" value="{{ dossier.version }}"><button class="hab-btn gold">Transmettre à l’entreprise</button></form></section>{% endif %}
{% if isAdmin %}<section class="hab-panel"><h2>Administration</h2><a class="hab-btn" href="{{ path('app_habilitation_reassign', {entite: entite.id, id: dossier.id}) }}">Changer l’affectation</a><p class="mt-3">La désactivation suspend l’accès. La suppression retire le dossier des espaces utilisateurs et conserve une archive administrative.</p><form method="post" action="{{ path('app_habilitation_state', {entite: entite.id, id: dossier.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('habilitation_' ~ dossier.id) }}"><input type="hidden" name="version" value="{{ dossier.version }}"><label for="hab-reason">Motif</label><textarea id="hab-reason" name="reason" required maxlength="1000" rows="2"></textarea><div class="hab-actions">{% if dossier.active and not dossier.deleted %}<button class="hab-btn" name="action" value="disable">Désactiver</button><button class="hab-btn danger" name="action" value="delete">Supprimer</button>{% else %}<button class="hab-btn" name="action" value="enable">Restaurer / réactiver</button>{% endif %}</div></form></section>{% endif %}</aside></div>
<script src="{{ asset('dist/js/habilitation-signature.js') }}" defer></script>{% endblock %}
