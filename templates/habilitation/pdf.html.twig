<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>
@page{margin:30px 34px 38px}body{font-family:'DejaVu Sans',sans-serif;font-size:9px;color:#233342}h1{font-size:23px;margin:9px 0}p{margin:4px 0}h2,h3{page-break-after:avoid}h2{font-size:13px;margin:10px 0 5px}h3{font-size:11px;margin:8px 0 5px}.hero{border-left:6px solid #e6ad25;padding:8px 18px;background:#eef2f6}.label{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:#667085}.muted{color:#667085}table{width:100%;border-collapse:collapse;table-layout:fixed}td,th{border:1px solid #dce2e9;padding:7px;vertical-align:top;word-wrap:break-word}th{background:#f0f3f7;text-align:left;font-size:8px}.meta td{border:0;padding:4px 0}.section{page-break-inside:avoid}.signature{height:50px;max-width:220px}.note{background:#fff7df;padding:10px;margin:12px 0}.footer{position:fixed;bottom:-24px;font-size:7px;color:#667085}.free{white-space:pre-wrap;word-wrap:break-word}.signed{border-top:2px solid #233342;margin-top:10px;padding-top:7px}
</style></head><body><div class="footer">{{ snapshot.identity.organisme }} · Référence {{ revision.token }} · Signé le {{ revision.createdAt|date('d/m/Y H:i') }}</div>
<div class="hero"><div class="label">{{ snapshot.identity.organisme }} · {{ snapshot.identity.session }}</div><h1>{{ revision.kind == 'avis' ? 'Avis post-formation' : 'Titre d’habilitation électrique' }}</h1><div>HABILITATION ÉLECTRIQUE · {{ snapshot.identity.formation }}</div></div>
{% if archived or inactive %}<div class="note"><strong>{{ inactive ? 'DOSSIER DÉSACTIVÉ — ' }}VERSION ARCHIVÉE</strong> · Document conservé pour l’historique, ne constituant pas le titre actuellement délivré.</div>{% endif %}
<table class="meta"><tr><td><b>Stagiaire / salarié</b><br>{{ snapshot.identity.trainee }}</td><td><b>Entreprise</b><br>{{ snapshot.identity.company }}</td><td><b>Formateur</b><br>{{ snapshot.identity.trainer }}</td></tr><tr><td><b>Fonction</b><br>{{ snapshot.data.function ?: '—' }}</td><td><b>Affectation</b><br>{{ snapshot.data.assignment ?: '—' }}</td><td><b>Dates de formation</b><br>{{ snapshot.identity.dates|join(' / ') }}</td></tr><tr><td><b>Délivrance</b><br>{{ snapshot.data.issuedAt ? snapshot.data.issuedAt|date('d/m/Y') : '—' }}</td><td><b>Fin de validité</b><br>{{ snapshot.data.validUntil ? snapshot.data.validUntil|date('d/m/Y') : 'Non précisée' }}</td><td><b>Lieu</b><br>{{ snapshot.data.place ?: '—' }}</td></tr></table>
<div class="note">{% if revision.kind == 'avis' %}Au vu des connaissances théoriques évaluées et des compétences pratiques observées, le formateur émet l’avis ci-dessous. Cet avis ne vaut pas habilitation. L’habilitation électrique relève de la responsabilité de l’employeur.{% else %}L’employeur définit ci-dessous les opérations confiées au titulaire et leur périmètre. Ce titre est personnel et ne permet pas d’entreprendre des opérations de sa propre initiative. Ce modèle ne couvre pas les travaux sous tension.{% endif %}</div>
{% for section in snapshot.schema.sections %}<h2>{{ section.title }}</h2>{% set notEvaluated = [] %}{% for row in section.rows %}{% set answer = snapshot.data.rows[row.id] %}<div class="section">{% if revision.kind == 'avis' and answer.verdict == 'not_evaluated' %}{% set notEvaluated = notEvaluated|merge([row.title]) %}{% else %}<h3>{{ row.title }}{% if revision.kind == 'avis' %} · {{ {favorable:'Avis favorable', unfavorable:'Avis défavorable', not_evaluated:'Non évalué'}[answer.verdict] }}{% endif %}</h3><table><thead><tr>{% for field in row.fields %}<th>{{ field.label }}</th>{% endfor %}</tr></thead><tbody><tr>{% for field in row.fields %}<td class="free">{% if field.type == 'checkbox' %}{{ answer[field.id]|join(', ') ?: '—' }}{% else %}{{ answer[field.id] ?: '—' }}{% endif %}</td>{% endfor %}</tr></tbody></table>{% endif %}</div>{% endfor %}{% if notEvaluated %}<p class="muted">Non évalué : {{ notEvaluated|join('; ') }}.</p>{% endif %}{% endfor %}
{% for key,label in {observations:'Observations', restrictions:'Autorisations, interdictions et recommandations', additionalDocument:'Document complémentaire'} %}{% if snapshot.data[key] %}<h2>{{ label }}</h2><div class="free">{{ snapshot.data[key] }}</div>{% endif %}{% endfor %}
<div class="signed section"><table class="meta"><tr><td><b>{{ revision.kind == 'avis' ? 'Le formateur' : 'Le représentant de l’employeur' }}</b><br>{{ snapshot.signer }} · {{ snapshot.data.signerFunction }}<br>Signature recueillie le {{ revision.createdAt|date('d/m/Y à H:i') }}<br><img class="signature" src="{{ snapshot.signature }}"></td>{% if revision.kind == 'titre' %}<td><b>Le titulaire : {{ snapshot.identity.trainee }}</b><br>Prise de connaissance · signature du titulaire après remise :<br><br><br>________________________________</td>{% endif %}</tr></table></div>
</body></html>
