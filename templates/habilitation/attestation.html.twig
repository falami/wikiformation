<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><title>Attestation électrique - {{ snapshot.identity.trainee }}</title><style>
@page{margin:32px 40px 50px}body{font-family:"DejaVu Sans",sans-serif;font-size:9px;color:#233342;line-height:1.45}*{box-sizing:border-box}table{width:100%;border-collapse:collapse}td{vertical-align:top}p{margin:6px 0}.brand td{vertical-align:middle;padding-bottom:16px}.brand-logo{width:110px}.brand-logo img{max-width:94px;max-height:72px}.brand-name{font-size:15px;font-weight:bold;color:{{ brand.primary }}}.small{font-size:8px;color:#647482}.eyebrow{font-size:8px;letter-spacing:1.8px;text-transform:uppercase}.hero{background:{{ brand.primary }};color:white;border-left:6px solid {{ brand.accent }};padding:17px 20px;margin-bottom:15px}.hero h1{font-size:24px;line-height:1.15;margin:6px 0}.hero p{font-size:10px;margin:0}.ref{text-align:right;font-size:8px;color:#647482}h2{font-size:11px;margin:15px 0 7px;color:{{ brand.primary }};page-break-after:avoid}h2 .num{color:{{ brand.accent }};margin-right:8px}.person{background:#f1f4f6;border-bottom:2px solid {{ brand.accent }};padding:12px 15px}.person-name{font-size:17px;font-weight:bold;color:{{ brand.primary }}}.meta{margin:7px 0 10px}.meta td{padding:7px 10px;border-bottom:1px solid #e3e8ec;width:50%}.label{font-size:7px;text-transform:uppercase;letter-spacing:.7px;color:#647482;display:block;margin-bottom:3px}.value{font-weight:bold;font-size:9px}.result{page-break-inside:avoid;border:1px solid #dce3e8;margin-bottom:7px}.result-title{padding:5px 10px;background:#f1f4f6;font-weight:bold;font-size:9px;border-left:3px solid {{ brand.accent }}}.result-body{padding:4px 10px}.result-body p{margin:1px 0}.free{white-space:pre-wrap;word-wrap:break-word}.notice{border-left:3px solid {{ brand.accent }};background:#f5f6f7;padding:9px 12px;font-size:8px;margin-top:12px}.closing{page-break-inside:avoid}.signature{margin-top:12px;border-top:1px solid #dce3e8;padding-top:10px}.signature td{width:50%}.signature img{max-width:175px;max-height:58px}.footer{position:fixed;bottom:-28px;left:0;right:0;border-top:1px solid #dce3e8;padding-top:7px;font-size:6.5px;color:#647482}.archive{border:1px solid #b36e2b;padding:8px;margin-bottom:10px}.intro{margin:10px 0;color:#526271}.section-note{font-size:8px;color:#647482}
</style></head><body>
<div class="footer">{{ snapshot.identity.organisme }} · {{ snapshot.identity.session }}<br>Référence du document : {{ revision.token }}</div>
<table class="brand"><tr>{% if brand.logo %}<td class="brand-logo"><img src="{{ brand.logo }}" alt="Logo de {{ snapshot.identity.organisme }}"></td>{% endif %}<td><div class="brand-name">{{ snapshot.identity.organisme }}</div><div class="small">{{ snapshot.identity.organismeAddress|default('') }}{% if snapshot.identity.organismeDeclaration|default('') %}<br>Déclaration d’activité : {{ snapshot.identity.organismeDeclaration }}{% endif %}</div></td><td class="ref">ATTESTATION DE FORMATION<br><b>{{ revision.createdAt|date('d/m/Y', 'Europe/Paris') }}</b></td></tr></table>
<div class="hero"><div class="eyebrow">Habilitation électrique</div><h1>Avis post-formation</h1><p>Évaluation des connaissances et des compétences</p></div>
{% if archived or inactive %}<div class="archive"><b>VERSION ARCHIVÉE{{ inactive ? ' · DOSSIER DÉSACTIVÉ' }}</b><br>Document conservé pour l’historique.</div>{% endif %}
<div class="person"><span class="label">Stagiaire bénéficiaire</span><div class="person-name">{{ snapshot.identity.trainee }}</div><div>{{ snapshot.identity.company }}</div></div>
<h2><span class="num">01</span> Parcours de formation</h2>
<table class="meta"><tr><td colspan="2"><span class="label">Formation suivie</span><span class="value">{{ snapshot.identity.formation }}</span><br><span class="small">Session {{ snapshot.identity.session }}</span></td></tr><tr><td><span class="label">Dates de formation</span>{% for date in snapshot.identity.dates %}{{ date }}<br>{% endfor %}</td><td><span class="label">Durée de formation</span>{% if snapshot.identity.durationHours is defined %}<span class="value">{{ snapshot.identity.durationHours|number_format(2, ',', ' ') }} heures</span>{% else %}Non conservée dans cette ancienne version{% endif %}</td></tr><tr><td><span class="label">Formateurs affectés</span>{{ snapshot.identity.trainer }}</td><td><span class="label">Évaluation validée par</span>{{ snapshot.signer }}</td></tr></table>
<h2><span class="num">02</span> Résultats de l’évaluation</h2>
<p class="intro">Au vu des connaissances théoriques évaluées et des compétences pratiques observées, le formateur a émis les avis suivants.</p>
{% for verdict,label in {favorable:'Avis favorables', unfavorable:'Avis défavorables', not_evaluated:'Éléments non évalués'} %}
{% set matching = [] %}{% for section in snapshot.schema.sections %}{% for row in section.rows %}{% if snapshot.data.rows[row.id].verdict|default('not_evaluated') == verdict %}{% set matching = matching|merge([{section:section.title, row:row}]) %}{% endif %}{% endfor %}{% endfor %}
{% if matching %}{% if verdict == 'not_evaluated' %}<p class="section-note">{{ matching|length }} rubrique(s) du questionnaire non évaluée(s). Le détail figure dans l’avis complet.</p>{% else %}<h2>{{ label }}</h2>{% for item in matching %}{% set answer = snapshot.data.rows[item.row.id]|default({}) %}
<div class="result"><div class="result-title">{{ item.section }} · {{ item.row.title }}</div><div class="result-body">{% for field in item.row.fields %}{% set value = answer[field.id]|default('') %}{% if value %}<p class="free"><b>{{ field.label }} :</b> {{ field.type == 'checkbox' ? value|join(', ') : value }}</p>{% endif %}{% endfor %}</div></div>
{% endfor %}{% endif %}{% endif %}{% endfor %}
{% for key,label in {observations:'Observations', restrictions:'Restrictions et recommandations', additionalDocument:'Document complémentaire'} %}{% if snapshot.data[key]|default('') %}<h2>{{ label }}</h2><div class="free">{{ snapshot.data[key] }}</div>{% endif %}{% endfor %}
<div class="closing"><div class="notice"><b>Portée de l’avis</b><br>Cet avis ne vaut pas habilitation. L’habilitation électrique relève de la responsabilité de l’employeur.</div>
<table class="signature"><tr><td><span class="label">Validation du formateur</span><b>{{ snapshot.signer }}</b>{% if snapshot.data.signerFunction|default('') %}<br>{{ snapshot.data.signerFunction }}{% endif %}<p>Fait{% if snapshot.data.place|default('') %} à {{ snapshot.data.place }}{% endif %}, le {{ revision.createdAt|date('d/m/Y', 'Europe/Paris') }}.</p></td><td><span class="label">Signature du formateur évaluateur</span><img src="{{ snapshot.signature }}" alt="Signature du formateur"></td></tr></table></div>
</body></html>
