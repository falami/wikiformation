# --- Symfony on Apache: clean redirects + security + front controller ---

DirectoryIndex index.php

# Evite le content-negociation sur extensions
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>

    RewriteEngine On

    # ---------------------------------------------------------
    # 1) Redirections du domaine de production uniquement
    # ---------------------------------------------------------

    # www.wikiformation.fr -> https://wikiformation.fr
    RewriteCond %{HTTP_HOST} ^www\.wikiformation\.fr$ [NC]
    RewriteRule ^ https://wikiformation.fr%{REQUEST_URI} [R=301,L]

    # http://wikiformation.fr -> https://wikiformation.fr
    RewriteCond %{HTTP_HOST} ^wikiformation\.fr$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://wikiformation.fr%{REQUEST_URI} [R=301,L]

    # ---------------------------------------------------------
    # 2) Profiler
    # ---------------------------------------------------------

    RewriteRule ^_profiler/ - [R=404,L]

    # Conserve Authorization
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # /index.php/... -> /...
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^index\.php(?:/(.*)|$) /$1 [R=301,L]

    # Personal dossier and attendance evidence must use authenticated controllers.
    # Keep this before the existing-file shortcut, including for legacy files.
    RewriteRule ^uploads/(pieces|session/pieces)(/|$) - [R=404,L,NC]

    # Never execute uploaded PHP or other server-side scripts, whatever their directory.
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|cgi|pl|shtml)(\.|/|$) - [R=404,L,NC]

    # Distributed assets are static only, including any legacy source files.
    RewriteRule ^dist/.*\.(php[0-9]?|phtml|phar|cgi|pl|shtml)(\.|/|$) - [R=404,L,NC]

    # Existing links remain usable, but confidential files require application authorization.
    RewriteRule ^uploads/(emargements|proofs|depense|signatures/organisme|tampons/organisme|entreprise/docs|pdf|devis|conventions|elearning)/ /index.php [L,NC]

    # Assets existants
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Symfony
    RewriteRule ^ /index.php [L]

</IfModule>
